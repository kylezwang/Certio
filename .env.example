# Copy to .env and fill in the values you actually use.
# Never commit .env.

# Local SQL Server (docker-compose). Must meet SQL Server password rules.
SQL_PASSWORD=YourStrong!Passw0rd
USE_AZURE_SQL=false
USE_REDIS=false

# Optional Azure SQL. Leave blank for local Docker SQL.
DB_PASSWORD=
AZURE_SQL_CONNECTION_STRING=
ConnectionStrings__DefaultConnection=

# Shared secret between the web app and the AI service. Not an OpenAI key.
AI_API_KEY=change-me

# Model providers. The AI service reads these from the environment.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_VERSION=2024-02-15-preview

ASPNETCORE_ENVIRONMENT=Development

# Maps
GOOGLE_MAPS_API_KEY=

# Gmail / Outlook mail (ASP.NET env binding)
EmailIntegration__Gmail__ClientId=
EmailIntegration__Gmail__ClientSecret=
EmailIntegration__Gmail__RedirectUri=http://localhost:5092/signin-gmail
EmailIntegration__Outlook__ClientId=
EmailIntegration__Outlook__ClientSecret=
EmailIntegration__Outlook__RedirectUri=http://localhost:5092/signin-outlook
EmailIntegration__WebhookSecret=

# Google Drive / OneDrive
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5092/signin-google-drive
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REDIRECT_URI=http://localhost:5092/signin-onedrive
DOCUMENT_WEBHOOK_SECRET=

# Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@example.com
Security__TwoFactorEmail__FromEmail=notifications@example.com
Security__TwoFactorEmail__FromName=Notal
Security__TwoFactorEmail__Provider=smtp

# Calendar OAuth
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5092/signin-google-calendar
OUTLOOK_CALENDAR_CLIENT_ID=
OUTLOOK_CALENDAR_CLIENT_SECRET=
OUTLOOK_CALENDAR_REDIRECT_URI=http://localhost:5092/signin-outlook-calendar
