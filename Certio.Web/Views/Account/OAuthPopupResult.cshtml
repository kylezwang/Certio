@model Certio.Web.Controllers.AccountController.OAuthPopupResult
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Authentication</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
        }
        .container {
            text-align: center;
            padding: 2rem;
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            max-width: 400px;
        }
        .success-icon {
            width: 64px;
            height: 64px;
            background: linear-gradient(135deg, #10b981, #059669);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
        }
        .error-icon {
            width: 64px;
            height: 64px;
            background: linear-gradient(135deg, #ef4444, #dc2626);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
        }
        .success-icon svg, .error-icon svg {
            color: white;
            width: 32px;
            height: 32px;
        }
        h2 {
            color: #1f2937;
            margin-bottom: 0.5rem;
        }
        p {
            color: #6b7280;
            margin-bottom: 1.5rem;
        }
        .spinner {
            width: 24px;
            height: 24px;
            border: 3px solid #e5e7eb;
            border-top-color: #3d1019;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin: 0 auto;
        }
        @@keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <div class="container">
        @if (Model.Success)
        {
            <div class="success-icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            @if (Model.NeedsRegistration)
            {
                <h2>Almost there!</h2>
                <p>Please complete your registration to continue.</p>
            }
            else
            {
                <h2>Success!</h2>
                <p>You've been signed in. Redirecting...</p>
            }
            <div class="spinner"></div>
        }
        else
        {
            <div class="error-icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </div>
            <h2>Authentication Failed</h2>
            <p>@(Model.Error ?? "An error occurred during authentication.")</p>
        }
    </div>

    <script>
        (function() {
            const result = {
                success: @Html.Raw(Model.Success.ToString().ToLower()),
                error: @Html.Raw(Model.Error != null ? $"\"{Model.Error}\"" : "null"),
                redirectUrl: @Html.Raw(Model.RedirectUrl != null ? $"\"{Model.RedirectUrl}\"" : "null"),
                email: @Html.Raw(Model.Email != null ? $"\"{Model.Email}\"" : "null"),
                firstName: @Html.Raw(Model.FirstName != null ? $"\"{Model.FirstName}\"" : "null"),
                lastName: @Html.Raw(Model.LastName != null ? $"\"{Model.LastName}\"" : "null"),
                provider: @Html.Raw(Model.Provider != null ? $"\"{Model.Provider}\"" : "null"),
                needsRegistration: @Html.Raw(Model.NeedsRegistration.ToString().ToLower())
            };

            // Send result to parent window
            if (window.opener) {
                try {
                    window.opener.postMessage({
                        type: 'OAUTH_LOGIN_RESULT',
                        ...result
                    }, window.location.origin);
                } catch (e) {
                    console.error('Error posting message to parent:', e);
                }
            }

            // Close popup or redirect after a delay
            setTimeout(function() {
                if (result.success) {
                    if (result.needsRegistration && result.redirectUrl) {
                        // For registration, redirect the parent and close popup
                        if (window.opener) {
                            window.opener.location.href = result.redirectUrl;
                        }
                        window.close();
                    } else if (result.redirectUrl) {
                        // For successful login, redirect parent and close popup
                        if (window.opener) {
                            window.opener.location.href = result.redirectUrl;
                        }
                        window.close();
                    }
                } else {
                    // On error, just close after a moment
                    setTimeout(function() { window.close(); }, 2000);
                }
            }, 1500);
        })();
    </script>
</body>
</html>

