@{
    ViewData["Title"] = "Email Connection";
    Layout = null;
    var success = ViewData["success"] as bool? ?? false;
    var provider = ViewData["provider"] as string ?? "Email";
    var emailAddress = ViewData["emailAddress"] as string;
    var error = ViewData["error"] as string;
    var errorDescription = ViewData["errorDescription"] as string;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            background: url('/images/Notal_Video_Background.png') center center / cover no-repeat;
            padding: 20px;
        }
        .container {
            background: white;
            border-radius: 12px;
            padding: 40px;
            max-width: 400px;
            width: 100%;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            text-align: center;
        }
        .icon {
            font-size: 64px;
            margin-bottom: 20px;
        }
        .success .icon {
            color: #10b981;
        }
        .error .icon {
            color: #ef4444;
        }
        h1 {
            margin: 0 0 10px 0;
            font-size: 24px;
            color: #1f2937;
        }
        p {
            margin: 10px 0;
            color: #6b7280;
            font-size: 14px;
        }
        .message {
            margin-top: 20px;
            padding: 12px;
            border-radius: 6px;
            font-size: 13px;
        }
        .success .message {
            background: #d1fae5;
            color: #065f46;
        }
        .error .message {
            background: #fee2e2;
            color: #991b1b;
        }
        .spinner {
            border: 3px solid #f3f4f6;
            border-top: 3px solid #667eea;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin: 20px auto;
        }
        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <div class="container @(success ? "success" : "error")">
        @if (success)
        {
            <div class="icon">✓</div>
            <h1>Email Connected!</h1>
            <p>Your @provider account has been successfully connected.</p>
            @if (!string.IsNullOrEmpty(emailAddress))
            {
                <div class="message">
                    <strong>@emailAddress</strong>
                </div>
            }
            <p style="margin-top: 20px; font-size: 12px; color: #9ca3af;">
                Please close this window and refresh the page...
            </p>
        }
        else
        {
            <div class="icon">✗</div>
            <h1>Connection Failed</h1>
            <p>We couldn't connect your @provider account.</p>
            @if (!string.IsNullOrEmpty(errorDescription))
            {
                <div class="message">
                    @errorDescription
                </div>
            }
            else if (!string.IsNullOrEmpty(error))
            {
                <div class="message">
                    Error: @error
                </div>
            }
            <p style="margin-top: 20px; font-size: 12px; color: #9ca3af;">
                You can close this window and try again.
            </p>
        }
    </div>

    <script>
        // Notify parent window and close popup
        if (window.opener) {
            if (@Json.Serialize(success)) {
                window.opener.postMessage({
                    type: 'email-oauth-success',
                    provider: '@Html.Raw(provider)',
                    emailAddress: '@Html.Raw(emailAddress ?? "")'
                }, window.location.origin);
            } else {
                const errorDesc = @Html.Raw(errorDescription != null ? Json.Serialize(errorDescription) : "null");
                const error = @Html.Raw(error != null ? Json.Serialize(error) : "null");
                window.opener.postMessage({
                    type: 'email-oauth-error',
                    provider: '@Html.Raw(provider)',
                    error: error,
                    errorDescription: errorDesc
                }, window.location.origin);
            }
            
            // Close popup after a short delay
            setTimeout(() => {
                window.close();
            }, @(success ? "2000" : "3000"));
        } else {
            // If not a popup, redirect to communications page
            setTimeout(() => {
                window.location.href = '/Client/1/Communications';
            }, 2000);
        }
    </script>
</body>
</html>

