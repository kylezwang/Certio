<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Notal</title>
    <link rel="icon" type="image/png" href="~/images/Notal_Logo.png" />
    <link rel="shortcut icon" type="image/png" href="~/images/Notal_Logo.png" />
    <link rel="apple-touch-icon" href="~/images/Notal_Logo.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Katibeh&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Certio.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        /* Global Navbar Styles */
        .global-navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 6vw;
            height: 100vh;
            background-color: #3d1019;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            box-shadow: 2px 0 5px rgba(0,0,0,0.1);
        }

        .global-navbar .navbar-brand {
            color: white;
            font-family: 'Katibeh', sans-serif;
            font-size: 2.3rem;
            font-weight: bold;
            text-align: center;
            padding: 0.5rem 0rem 1rem 0rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            text-decoration: none;
            margin-right: 0 !important;
            letter-spacing: 0.05rem;
        }

        .global-navbar .navbar-brand:hover {
            color: white;
            text-decoration: none;
        }

        .global-navbar .nav {
            flex: 1;
            padding-bottom: 1rem;
        }

        .global-navbar .nav-item {
            margin: 0.25rem 0;
        }

        .global-navbar .global-nav-link {
            color: white;
            padding: 0.75rem 0.25rem;
            text-decoration: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
            text-align: center;
        }


        .global-navbar .global-nav-link i {
            width: 24px;
            text-align: center;
            font-size: 1.2rem;
        }

        .global-navbar .global-nav-link span {
            font-size: 0.75rem;
            font-weight: 500;
            line-height: 1.2;
        }

        /* Main content area adjustment */
        .main-content-wrapper {
            margin-left: 6vw;
            min-height: 100vh;
        }

        /* Mobile responsive */
        @@media (max-width: 768px) {
            .global-navbar {
                width: 100%;
                height: auto;
                position: relative;
                flex-direction: row;
                overflow-x: auto;
            }

            .global-navbar .navbar-brand {
                font-size: 1.5rem;
                padding: 1rem;
                border-bottom: none;
                border-right: 1px solid rgba(255,255,255,0.1);
                white-space: nowrap;
                margin-right: 0 !important;
            }

            .global-navbar .nav {
                flex-direction: row;
                padding: 0;
                overflow-x: auto;
            }

            .global-navbar .nav-item {
                margin: 0;
                flex-shrink: 0;
            }

            .global-navbar .global-nav-link {
                padding: 1rem 0.75rem;
                flex-direction: column;
                text-align: center;
                min-width: 80px;
                gap: 0.5rem;
                margin: 0;
                width: auto;
            }

            .global-navbar .global-nav-link i {
                font-size: 1.2rem;
                width: 24px;
            }

            .global-navbar .global-nav-link span {
                font-size: 0.75rem;
                line-height: 1.2;
            }

            .main-content-wrapper {
                margin-left: 0;
            }
        }

        /* Ensure content doesn't get hidden behind navbar */
        body {
            margin: 0;
            padding: 0;
        }

        /* Clients Popup Styles */
        .clients-popup {
            position: fixed;
            top: 0;
            left: 6vw;
            width: 320px;
            height: 100vh;
            background-color: #ffffff;
            box-shadow: 2px 0 8px rgba(0, 0, 0, 0.15);
            z-index: 999;
            transform: translateX(-100%);
            transition: transform 0.3s ease;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .clients-popup.show {
            transform: translateX(0);
        }

        .clients-popup-header {
            background-color: rgba(11, 54, 94, 0.05);
            color: black;
            padding: 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .clients-popup-title {
            font-size: 1.25rem;
            font-weight: 600;
            margin: 0;
        }

        .clients-popup-close {
            background: none;
            border: none;
            color: black;
            font-size: 1.5rem;
            cursor: pointer;
            padding: 0;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .clients-popup-close:hover {
            background-color: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
        }

        .clients-popup-content {
            padding: 0;
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .clients-scrollable-area {
            flex: 1;
            overflow-y: auto;
        }

        .clients-section-header {
            padding: 0.5rem 0.9rem;
            border-bottom: 1px solid #e5e7eb;
        }

        .clients-section-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: #1f2937;
            margin: 0 0 0.5rem 0;
        }

        .clients-list {
            padding: 0.5rem 0.5rem;
        }

        .client-item {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #f3f4f6;
            cursor: pointer;
            transition: background-color 0.2s ease, border-radius 0.2s ease;
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 0.75rem;
        }

        .client-item-content {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            flex: 1;
            min-width: 0;
        }

        .client-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #69848C;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.875rem;
            font-weight: 600;
            flex-shrink: 0;
        }

        .firm-avatar {
            width: 2.25rem;
            height: 2.25rem;
            border-radius: 7px;
            background: linear-gradient(135deg, #a32b43, #3d1019);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .client-item:hover,
        .client-item.active {
            background-color: #eef1f3;
            border-radius: 12px;
        }

        .client-item:last-child {
            border-bottom: none;
        }

        .client-name {
            font-weight: 600;
            color: #1f2937;
            font-size: 0.95rem;
            margin: 0;
        }

        .client-company {
            color: #6b7280;
            font-size: 0.875rem;
            margin: 0;
        }

        .client-status {
            color: #6b7280;
            font-size: 0.8rem;
            margin: 0;
        }

        /* Join Code Section Styles */
        .join-code-section {
            background-color: #f8fafc;
            border-top: 1px solid #e5e7eb;
            padding: 1rem;
            margin-top: auto;
        }

        .join-code-title {
            font-size: 1rem;
            font-weight: 600;
            color: #1f2937;
            margin: 0 0 0.75rem 0;
        }

        .join-code-form {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .join-code-input {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: 0.875rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
            box-sizing: border-box;
        }

        .join-code-input:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        .join-code-button {
            background-color: #3b82f6;
            color: white;
            border: none;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        .join-code-button:hover {
            background-color: #2563eb;
        }

        .join-code-button:disabled {
            background-color: #9ca3af;
            cursor: not-allowed;
        }

        .join-code-message {
            font-size: 0.8rem;
            margin-top: 0.5rem;
            padding: 0.5rem;
            border-radius: 4px;
        }

        .join-code-message.success {
            background-color: #d1fae5;
            color: #065f46;
            border: 1px solid #a7f3d0;
        }

        .join-code-message.error {
            background-color: #fee2e2;
            color: #991b1b;
            border: 1px solid #fca5a5;
        }

        /* Global Nav Button Hover and Selected States - Unified Styling */
        .global-navbar .global-nav-link {
            position: relative;
            margin: 0.25rem 0.5rem;
            border-radius: 8px;
            width: calc(100% - 1rem);
        }

        .global-navbar .global-nav-link:hover,
        .global-navbar .global-nav-link.active {
            background-color: rgba(255,255,255,0.15);
            color: white;
        }

        .global-navbar .global-nav-link:hover i,
        .global-navbar .global-nav-link:hover span,
        .global-navbar .global-nav-link.active i,
        .global-navbar .global-nav-link.active span {
            color: white;
        }

        /* Mobile responsive for clients popup */
        @@media (max-width: 768px) {
            .clients-popup {
                left: 0;
                width: 100%;
                transform: translateX(-100%);
            }

            .clients-popup.show {
                transform: translateX(0);
            }
        }
    </style>
</head>
<body class="@ViewData["BodyClass"]">
    <!-- Application Context for JavaScript -->
    <div id="appContext" 
         data-current-user-id="@ViewBag.CurrentUserId" 
         data-current-user-name="@ViewBag.CurrentUserName"
         style="display: none;"></div>
    
    <!-- Global Navbar -->
    <nav class="global-navbar">
        <a class="navbar-brand" href="/">
            Notal
        </a>
        
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="global-nav-link" href="#" id="myFirmLink" title="My Firm">
                    <i class="fa-solid fa-building-columns" id="myFirmIcon"></i>
                    <span id="myFirmLabel">My Firm</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="global-nav-link clients-button" href="#" title="Clients" id="clientsButton">
                    <i class="fas fa-users"></i>
                    <span>Clients</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="global-nav-link" href="#" id="calendarLink" title="Calendar">
                    <i class="fas fa-calendar"></i>
                    <span>Calendar</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="global-nav-link" href="#" id="billingLink" title="Billing">
                    <i class="fa-regular fa-credit-card"></i>
                    <span>Billing</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="global-nav-link" href="#" id="historyLink" title="History">
                    <i class="fas fa-clock"></i>
                    <span>History</span>
                </a>
            </li>
        </ul>
    </nav>

    <!-- Main Content Wrapper -->
    <div class="main-content-wrapper">
        @RenderBody()
    </div>

    <!-- Clients Popup -->
    <div class="clients-popup" id="clientsPopup">
        <div class="clients-popup-header">
            <h3 class="clients-popup-title">Clients</h3>
            <button class="clients-popup-close" id="clientsPopupClose">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="clients-popup-content">
            <div class="clients-scrollable-area">
                <div class="clients-section-header">
                    <a href="#" id="viewAllClientsLink" class="text-decoration-none" style="display: block;">
                        <div class="card border-0" style="background-color: #f8f9fa; padding: 0.75rem; border-radius: 8px; cursor: pointer; transition: background-color 0.2s ease;" onmouseover="this.style.backgroundColor='#e9ecef'" onmouseout="this.style.backgroundColor='#f8f9fa'">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="fas fa-users" style="color: #3d1019; font-size: 0.875rem;"></i>
                                <div style="min-width: 0; flex: 1; margin-top: 0;">
                                    <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.875rem;">
                                        View All Clients & Contacts
                                    </h6>
                                </div>
                            </div>
                            <!-- Firm Identifier Container -->
                            <div class="card border-0" style="background-color: white; padding: 0.5rem; border-radius: 6px; box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="matter-icon-badge-small" style="
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 4px;
                                        background: linear-gradient(135deg, #a32b43, #3d1019);
                                        color: white;
                                        display: flex;
                                        align-items: center;
                                        justify-content: center;
                                        font-size: 0.75rem;
                                        flex-shrink: 0;
                                    " id="firmBadgeIcon">
                                        <i class="fas fa-building-columns"></i>
                                    </div>
                                    <div style="min-width: 0; flex: 1; margin-top: 0;">
                                        <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" id="firmBadgeName">
                                            Loading Firm...
                                        </h6>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="clients-list" id="clientsList">
                    <!-- Client items will be populated by JavaScript -->
                </div>
            </div>
            </div>
        </div>
    </div>
        </div>
    </div>

    <!-- Firms Popup -->
    <div class="clients-popup" id="firmsPopup">
        <div class="clients-popup-header">
            <h3 class="clients-popup-title">My Organizations</h3>
            <button class="clients-popup-close" id="firmsPopupClose">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="clients-popup-content">
            <div class="clients-scrollable-area">
                <div class="clients-list" id="firmsList">
                    <!-- Firm items will be populated by JavaScript -->
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js" defer></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>

    <script defer>
        // Clients and Firms Popup Functionality - deferred to not block page load
        window.addEventListener('load', function() {
            const clientsButton = document.getElementById('clientsButton');
            const clientsPopup = document.getElementById('clientsPopup');
            const clientsPopupClose = document.getElementById('clientsPopupClose');
            const clientsList = document.getElementById('clientsList');
            
            const myFirmLink = document.getElementById('myFirmLink');
            const firmsPopup = document.getElementById('firmsPopup');
            const firmsPopupClose = document.getElementById('firmsPopupClose');
            const firmsList = document.getElementById('firmsList');

            const calendarLink = document.getElementById('calendarLink');
            const billingLink = document.getElementById('billingLink');
            const historyLink = document.getElementById('historyLink');

            // Helper to get initials
            function getInitials(name) {
                if (!name) return 'LF';
                const parts = name.trim().split(' ');
                if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();
                return (parts[0][0] + parts[1][0]).toUpperCase();
            }

            // Initialize My Firm link
            initializeMyFirmLink();
            
            // Update My Firm icon and label based on organization type
            updateMyFirmDisplay();
            
            // Initialize Calendar link
            initializeCalendarLink();
            
            // Initialize Billing link
            initializeBillingLink();
            
            // Initialize History link
            initializeHistoryLink();

            // Initialize Clients link
            initializeClientsLink();
            
            // Immediately check active state synchronously if meta tag is available
            (function() {
                const orgTypeMeta = document.querySelector('meta[name="organization-type"]');
                if (orgTypeMeta) {
                    const orgType = orgTypeMeta.getAttribute('content');
                    if (orgType && orgType !== 'LawFirm') {
                        // We're viewing client-scoped data - make Clients button active immediately
                        clientsButton.classList.add('active');
                        myFirmLink.classList.remove('active');
                    }
                }
            })();

            // --- My Firm Functionality ---

            function initializeMyFirmLink() {
                myFirmLink.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (firmsPopup.classList.contains('show')) {
                        hideFirmsPopup();
                    } else {
                        if (clientsPopup.classList.contains('show')) hideClientsPopup();
                        showFirmsPopup();
                    }
                });

                firmsPopupClose.addEventListener('click', hideFirmsPopup);

                // Update active state based on URL
                updateMyFirmActiveState();
            }
            
            function updateMyFirmDisplay() {
                // Check if we have organization type info from meta tag or fetch from API
                const orgTypeMeta = document.querySelector('meta[name="organization-type"]');
                if (orgTypeMeta) {
                    const orgType = orgTypeMeta.getAttribute('content');
                    setMyFirmIconAndLabel(orgType);
                } else {
                    // Fallback: try to fetch from API
                    fetch('/Client/List', { credentials: 'include' })
                        .then(res => res.json())
                        .then(result => {
                            if (result.success && result.myFirms && result.myFirms.length > 0) {
                                // Get the first (primary or active) firm's organization type
                                const firm = result.myFirms[0];
                                if (firm.organizationType) {
                                    setMyFirmIconAndLabel(firm.organizationType);
                                }
                            }
                        })
                        .catch(err => console.error('Error updating My Firm display:', err));
                }
            }
            
            function setMyFirmIconAndLabel(orgType) {
                const myFirmIcon = document.getElementById('myFirmIcon');
                const myFirmLabel = document.getElementById('myFirmLabel');
                const myFirmLink = document.getElementById('myFirmLink');
                
                if (!myFirmIcon || !myFirmLabel) return;
                
                const orgTypeLower = String(orgType || '').toLowerCase();
                if (orgTypeLower === 'eventplanner' || orgTypeLower === '4') {
                    // EventPlanner organization
                    myFirmIcon.className = 'fa-solid fa-clipboard-list';
                    myFirmLabel.textContent = 'My Org';
                    myFirmLink.title = 'My Organization';
                } else if (orgTypeLower === 'lawfirm' || orgTypeLower === '1') {
                    // LawFirm organization
                    myFirmIcon.className = 'fa-solid fa-building-columns';
                    myFirmLabel.textContent = 'My Firm';
                    myFirmLink.title = 'My Firm';
                } else {
                    // Default/Client organization
                    myFirmIcon.className = 'fa-solid fa-building';
                    myFirmLabel.textContent = 'My Org';
                    myFirmLink.title = 'My Organization';
                }
            }

            async function showFirmsPopup() {
                firmsPopup.classList.add('show');
                myFirmLink.classList.add('active');
                await populateFirmsList();
            }

            function hideFirmsPopup() {
                firmsPopup.classList.remove('show');
                updateMyFirmActiveState();
            }

            async function populateFirmsList() {
                firmsList.innerHTML = '<div class="client-item"><p class="client-status">Loading...</p></div>';
                try {
                    // Pass current active firm ID to highlight it
                    const storedFirmId = localStorage.getItem('activeFirmId');
                    let url = '/Client/List';
                    if (storedFirmId) url += `?firmOrgId=${storedFirmId}`;

                    const response = await fetch(url, { credentials: 'include' });
                    const result = await response.json();
                    
                    firmsList.innerHTML = '';
                    
                    if (result.success && result.myFirms && result.myFirms.length > 0) {
                        const activeFirmId = result.activeFirmId;
                        
                        // Update localStorage with the confirmed active firm ID from backend
                        if (activeFirmId) {
                            localStorage.setItem('activeFirmId', activeFirmId);
                        }

                        result.myFirms.forEach(firm => {
                            const firmItem = document.createElement('div');
                            const isActive = firm.organizationId === activeFirmId;
                            firmItem.className = isActive ? 'client-item active' : 'client-item';
                            
                            // Role is already formatted by server (RoleDisplayHelper)
                            const displayRole = firm.role || 'Member';
                            
                            // Determine icon based on organization type (matching setMyFirmIconAndLabel logic)
                            let iconClass = 'fa-solid fa-building-columns'; // Default for LawFirm
                            const orgType = String(firm.organizationType || '').toLowerCase();
                            if (orgType === 'eventplanner' || orgType === '4') {
                                iconClass = 'fa-solid fa-clipboard-list';
                            }
                            
                            firmItem.innerHTML = `
                                <div class="firm-avatar"><i class="${iconClass}"></i></div>
                                <div class="client-item-content">
                                    <h5 class="client-name">${firm.organizationName}</h5>
                                    <p class="client-status">${displayRole} ${firm.isPrimary ? '• Primary' : ''}</p>
                                </div>
                            `;
                            
                            firmItem.addEventListener('click', () => {
                                // Set active firm context
                                localStorage.setItem('activeFirmId', firm.organizationId);
                                // Navigate to dashboard
                                window.location.href = `/Client/${firm.organizationId}/Dashboard`;
                            });
                            
                            firmsList.appendChild(firmItem);
                        });
                    } else {
                        firmsList.innerHTML = '<div class="client-item"><p class="client-status">No firm memberships found.</p></div>';
                    }
                } catch (error) {
                    console.error('Error loading firms:', error);
                    firmsList.innerHTML = '<div class="client-item"><p class="client-status">Error loading firms.</p></div>';
                }
            }

            async function updateMyFirmActiveState() {
                // Check if current URL path matches a firm organization ID but is NOT Calendar/Billing/History
                
                const currentPath = window.location.pathname;
                // If we are on a client-scoped page, My Firm is NOT active
                const orgTypeMeta = document.querySelector('meta[name="organization-type"]');
                if (orgTypeMeta) {
                    const orgType = orgTypeMeta.getAttribute('content');
                    if (orgType && orgType !== 'LawFirm') {
                        myFirmLink.classList.remove('active');
                        return;
                    }
                }

                // If we are on Calendar, Billing, History, those have their own active states
                if (currentPath.includes('/Calendar') || currentPath.includes('/Billing') || currentPath.includes('/History')) {
                    myFirmLink.classList.remove('active');
                    return;
                }

                // If we are on Dashboard or other firm pages
                const urlMatch = currentPath.match(/^\/Client\/(\d+)/);
                if (urlMatch) {
                    // We are in some client/firm context. 
                    // If it's a LawFirm (checked above via meta or if we assume /Dashboard is firm), make it active.
                    if (!firmsPopup.classList.contains('show')) {
                         myFirmLink.classList.add('active');
                    }
                }
            }

            // --- Other Links (Calendar, Billing, History) ---
            // These should also respect the active firm context

            async function initializeCalendarLink() {
                // Use activeFirmId from localStorage if available
                const storedFirmId = localStorage.getItem('activeFirmId');
                if (storedFirmId) {
                    calendarLink.href = `/Client/${storedFirmId}/Calendar`;
                    updateCalendarActiveState(storedFirmId);
                } else {
                    // Fallback to fetch if no stored ID
                    try {
                        const response = await fetch('/Client/List', { credentials: 'include' });
                        const result = await response.json();
                        if (result.success && result.activeFirmId) {
                            calendarLink.href = `/Client/${result.activeFirmId}/Calendar`;
                            updateCalendarActiveState(result.activeFirmId);
                        }
                    } catch (e) {
                        calendarLink.href = '#';
                    }
                }
            }

            function updateCalendarActiveState(firmOrgId) {
                const currentPath = window.location.pathname;
                if (currentPath.includes(`/Client/${firmOrgId}/Calendar`)) {
                    calendarLink.classList.add('active');
                    myFirmLink.classList.remove('active');
                } else {
                    calendarLink.classList.remove('active');
                }
            }

            async function initializeBillingLink() {
                const storedFirmId = localStorage.getItem('activeFirmId');
                if (storedFirmId) {
                    billingLink.href = `/Client/${storedFirmId}/Billing`;
                    updateBillingActiveState(storedFirmId);
                } else {
                    try {
                        const response = await fetch('/Client/List', { credentials: 'include' });
                        const result = await response.json();
                        if (result.success && result.activeFirmId) {
                            billingLink.href = `/Client/${result.activeFirmId}/Billing`;
                            updateBillingActiveState(result.activeFirmId);
                        }
                    } catch (e) {
                        billingLink.href = '#';
                    }
                }
            }

            function updateBillingActiveState(firmOrgId) {
                const currentPath = window.location.pathname;
                if (currentPath.includes(`/Client/${firmOrgId}/Billing`)) {
                    billingLink.classList.add('active');
                    myFirmLink.classList.remove('active');
                } else {
                    billingLink.classList.remove('active');
                }
            }

            async function initializeHistoryLink() {
                const storedFirmId = localStorage.getItem('activeFirmId');
                if (storedFirmId) {
                    historyLink.href = `/Client/${storedFirmId}/History`;
                    updateHistoryActiveState(storedFirmId);
                } else {
                    try {
                        const response = await fetch('/Client/List', { credentials: 'include' });
                        const result = await response.json();
                        if (result.success && result.activeFirmId) {
                            historyLink.href = `/Client/${result.activeFirmId}/History`;
                            updateHistoryActiveState(result.activeFirmId);
                        } else {
                            historyLink.href = '#';
                        }
                    } catch (e) {
                        historyLink.href = '#';
                    }
                }
            }

            function updateHistoryActiveState(firmOrgId) {
                const currentPath = window.location.pathname;
                if (currentPath.includes(`/Client/${firmOrgId}/History`)) {
                    historyLink.classList.add('active');
                    myFirmLink.classList.remove('active');
                } else {
                    historyLink.classList.remove('active');
                }
            }

            // --- Clients Functionality ---

            function initializeClientsLink() {
                clientsButton.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (clientsPopup.classList.contains('show')) {
                        hideClientsPopup();
                    } else {
                        if (firmsPopup.classList.contains('show')) hideFirmsPopup();
                        showClientsPopup();
                    }
                });

                clientsPopupClose.addEventListener('click', hideClientsPopup);

                // Close popup when clicking outside (handles both popups)
                document.addEventListener('click', function(e) {
                    if (!clientsPopup.contains(e.target) && !clientsButton.contains(e.target) &&
                        !firmsPopup.contains(e.target) && !myFirmLink.contains(e.target)) {
                        hideClientsPopup();
                        hideFirmsPopup();
                    }
                });

                // Close popup on escape key
                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') {
                        if (clientsPopup.classList.contains('show')) hideClientsPopup();
                        if (firmsPopup.classList.contains('show')) hideFirmsPopup();
                    }
                });

                // Initial check for active state
                updateClientsActiveState();
            }

            async function showClientsPopup() {
                clientsPopup.classList.add('show');
                clientsButton.classList.add('active');
                await populateClientsList();
            }

            function hideClientsPopup() {
                clientsPopup.classList.remove('show');
                updateClientsActiveState();
            }

            async function updateClientsActiveState() {
                const currentPath = window.location.pathname;
                const clientsPathPattern = /^\/Client\/\d+\/Clients/;
                
                if (clientsPathPattern.test(currentPath)) {
                    clientsButton.classList.add('active');
                    myFirmLink.classList.remove('active');
                    return;
                }
                
                const orgTypeMeta = document.querySelector('meta[name="organization-type"]');
                if (orgTypeMeta) {
                    const orgType = orgTypeMeta.getAttribute('content');
                    if (orgType && orgType !== 'LawFirm') {
                        clientsButton.classList.add('active');
                        myFirmLink.classList.remove('active');
                        return;
                    }
                }

                if (!clientsPopup.classList.contains('show')) {
                    clientsButton.classList.remove('active');
                }
            }

            // Helper function to get last opened client organization ID from localStorage
            function getLastOpenedClientOrgId() {
                try {
                    return localStorage.getItem('lastOpenedClientOrgId');
                } catch (e) {
                    return null;
                }
            }

            // Helper function to set last opened client organization ID in localStorage
            function setLastOpenedClientOrgId(orgId) {
                try {
                    if (orgId && !isNaN(orgId)) {
                        localStorage.setItem('lastOpenedClientOrgId', orgId.toString());
                    }
                } catch (e) {
                    // Ignore localStorage errors
                }
            }

            // Helper function to get current scoped client organization ID
            function getCurrentClientOrgId() {
                const currentPath = window.location.pathname;
                
                const orgTypeMeta = document.querySelector('meta[name="organization-type"]');
                if (orgTypeMeta) {
                    const orgType = orgTypeMeta.getAttribute('content');
                    if (orgType && orgType !== 'LawFirm') {
                        const urlMatch = currentPath.match(/^\/Client\/(\d+)/);
                        if (urlMatch) {
                            return parseInt(urlMatch[1]);
                        }
                    }
                }
                return null;
            }

            async function populateClientsList() {
                clientsList.innerHTML = '';
                try {
                    const storedFirmId = localStorage.getItem('activeFirmId');
                    const lastOpenedOrgId = getLastOpenedClientOrgId();
                    
                    let url = '/Client/List';
                    const params = new URLSearchParams();
                    if (storedFirmId) params.append('firmOrgId', storedFirmId);
                    if (lastOpenedOrgId) params.append('lastOpenedOrgId', lastOpenedOrgId);
                    
                    if (params.toString()) url += `?${params.toString()}`;

                    const response = await fetch(url, { credentials: 'include' });
                    const result = await response.json();
                    
                    if (!result.success) {
                        clientsList.innerHTML = `<div class="client-item"><p class="client-status">${result.message || 'Unable to load clients.'}</p></div>`;
                        return;
                    }

                    // Update Firm Badge in "View All Clients" button
                    const firmBadgeIcon = document.getElementById('firmBadgeIcon');
                    const firmBadgeName = document.getElementById('firmBadgeName');
                    const viewAllClientsLink = document.getElementById('viewAllClientsLink');
                    
                    if (result.activeFirmId && result.myFirms) {
                        const activeFirm = result.myFirms.find(f => f.organizationId === result.activeFirmId);
                        if (activeFirm) {
                            // Update icon based on organization type (matching setMyFirmIconAndLabel logic)
                            if (firmBadgeIcon) {
                                const iconElement = firmBadgeIcon.querySelector('i');
                                if (iconElement) {
                                    const orgType = String(activeFirm.organizationType || '').toLowerCase();
                                    if (orgType === 'eventplanner' || orgType === '4') {
                                        iconElement.className = 'fa-solid fa-clipboard-list';
                                    } else {
                                        iconElement.className = 'fa-solid fa-building-columns';
                                    }
                                }
                            }
                            if (firmBadgeName) firmBadgeName.textContent = activeFirm.organizationName;
                            if (viewAllClientsLink) viewAllClientsLink.href = `/Client/${activeFirm.organizationId}/Clients`;
                            
                            // Store the confirmed active firm ID
                            localStorage.setItem('activeFirmId', result.activeFirmId);
                        }
                    }

                    // Filter: Only show confirmed client organizations (not LawFirm, not pending)
                    // Also filter by active firm if needed (backend should have handled this, but we can double check)
                    const orgs = (result.organizations || []).filter(o => 
                        o.organizationType !== 'LawFirm' && 
                        o.isConfirmed === true
                    );

                    if (orgs.length === 0) {
                        clientsList.innerHTML = `<div class="client-item"><p class="client-status">No clients found for this firm.</p></div>`;
                        return;
                    }
                    
                    const currentOrgId = getCurrentClientOrgId();
                    let isCurrentOrgClient = false;
                    if (currentOrgId) {
                        const currentOrg = orgs.find(o => o.organizationId === currentOrgId);
                        isCurrentOrgClient = currentOrg !== undefined;
                    }
                    
                    orgs.forEach(o => {
                        const ownerName = o.displayOwnerName || `${o.ownerFirstName} ${o.ownerLastName}`.trim();
                        const clientItem = document.createElement('div');
                        const isActive = isCurrentOrgClient && o.organizationId === currentOrgId;
                        clientItem.className = isActive ? 'client-item active' : 'client-item';
                        
                        // Only External Contacts orgs should have #aaaaaa avatar color and use pending icon
                        const avatarColor = o.isExternalContacts ? '#aaaaaa' : '#69848C';
                        const avatarStyle = `style="background: ${avatarColor};"`;
                        
                        // For External Contacts, use the pending invitation icon instead of initials
                        const avatarContent = o.isExternalContacts 
                            ? '<i class="fas fa-user-clock" style="font-size: 1rem;"></i>'
                            : getInitials(ownerName);
                        
                        clientItem.innerHTML = `
                            <div class="client-avatar" ${avatarStyle}>${avatarContent}</div>
                            <div class="client-item-content">
                                <h5 class="client-name">${ownerName}</h5>
                                <p class="client-company">${o.organizationName}</p>
                                <p class="client-status">${o.isPrimary ? 'Primary' : (o.isPersonal ? 'Personal' : 'Active')}</p>
                            </div>
                        `;
                        clientItem.addEventListener('click', () => {
                            setLastOpenedClientOrgId(o.organizationId);
                            // External Contacts should navigate to Clients list within the active firm context
                            if (o.isExternalContacts) {
                                const activeFirmId = localStorage.getItem('activeFirmId');
                                if (activeFirmId) {
                                    window.location.href = `/Client/${activeFirmId}/Clients`;
                                } else {
                                    // Fallback: try to use the current page's org ID if available
                                    const currentOrgId = document.querySelector('[data-organization-id]')?.getAttribute('data-organization-id');
                                    window.location.href = currentOrgId ? `/Client/${currentOrgId}/Clients` : '/';
                                }
                            } else {
                            window.location.href = `/Client/${o.organizationId}/Dashboard`;
                            }
                        });
                        clientsList.appendChild(clientItem);
                    });

                } catch (e) {
                    console.error('Error loading clients:', e);
                    clientsList.innerHTML = `<div class="client-item"><p class="client-status">Error loading clients.</p></div>`;
                }
            }

            // Show clients popup
            function showClientsPopup() {
                clientsPopup.classList.add('show');
                clientsButton.classList.add('active');
                populateClientsList();
            }

            // Hide clients popup
            async function hideClientsPopup() {
                clientsPopup.classList.remove('show');
                // Only remove active if not on Clients page and not on client-scoped page
                const currentPath = window.location.pathname;
                const clientsPathPattern = /^\/Client\/\d+\/Clients/;
                
                // Quick check: use meta tag if available (synchronous, no delay)
                const orgTypeMeta = document.querySelector('meta[name="organization-type"]');
                if (orgTypeMeta) {
                    const orgType = orgTypeMeta.getAttribute('content');
                    if (orgType && orgType !== 'LawFirm') {
                        // We're viewing client-scoped data - keep Clients button active
                        clientsButton.classList.add('active');
                        return;
                    }
                }
                
                // Check if we're on a client-scoped page (not firm-scoped)
                try {
                    const response = await fetch('/Client/List', { credentials: 'include' });
                    const result = await response.json();
                    
                    if (result.success && result.organizations) {
                        // Extract orgId from current URL path
                        const urlMatch = currentPath.match(/^\/Client\/(\d+)/);
                        if (urlMatch) {
                            const currentOrgId = parseInt(urlMatch[1]);
                            
                            // Check if current orgId is a client organization (not the firm)
                            const clientOrg = result.organizations.find(org => 
                                org.organizationId === currentOrgId && 
                                org.organizationType !== 'LawFirm'
                            );
                            
                            if (clientOrg) {
                                // We're viewing client-scoped data - keep Clients button active
                                clientsButton.classList.add('active');
                                return;
                            }
                        }
                    }
                } catch (error) {
                    console.error('Error checking client organization:', error);
                }
                
                // If not on Clients page and not on client-scoped page, remove active
                if (!clientsPathPattern.test(currentPath)) {
                    clientsButton.classList.remove('active');
                }
            }

        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>