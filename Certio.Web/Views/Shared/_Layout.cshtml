<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Certio AI Legal Assistant</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Righteous&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Certio.Web.styles.css" asp-append-version="true" />
    <style>
        /* Global Navbar Styles */
        .global-navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 6vw;
            height: 100vh;
            background-color: #0b365e;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            box-shadow: 2px 0 5px rgba(0,0,0,0.1);
        }

        .global-navbar .navbar-brand {
            color: white;
            font-family: 'Righteous', sans-serif;
            font-size: 1.4rem;
            font-weight: bold;
            text-align: center;
            padding: 1.3rem 0.25rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            text-decoration: none;
            margin-right: 0 !important;
        }

        .global-navbar .navbar-brand:hover {
            color: white;
            text-decoration: none;
        }

        .global-navbar .nav {
            flex: 1;
            padding-bottom: 1rem;
        }

        .global-navbar .nav-item {
            margin: 0.25rem 0;
        }

        .global-navbar .nav-link {
            color: white;
            padding: 0.75rem 0.25rem;
            text-decoration: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.2s ease;
            border-radius: 0;
            text-align: center;
        }

        .global-navbar .nav-link:hover {
            background-color: rgba(255,255,255,0.1);
            color: white;
        }

        .global-navbar .nav-link:hover i {
            color: white;
        }

        .global-navbar .nav-link.active {
            background-color: rgba(255,255,255,0.2);
            color: white;
        }

        .global-navbar .nav-link.active i {
            color: white;
        }

        .global-navbar .nav-link i {
            width: 24px;
            text-align: center;
            font-size: 1.2rem;
        }

        .global-navbar .nav-link span {
            font-size: 0.75rem;
            font-weight: 500;
            line-height: 1.2;
        }

        /* Main content area adjustment */
        .main-content-wrapper {
            margin-left: 6vw;
            min-height: 100vh;
        }

        /* Mobile responsive */
        @@media (max-width: 768px) {
            .global-navbar {
                width: 100%;
                height: auto;
                position: relative;
                flex-direction: row;
                overflow-x: auto;
            }

            .global-navbar .navbar-brand {
                font-size: 1.5rem;
                padding: 1rem;
                border-bottom: none;
                border-right: 1px solid rgba(255,255,255,0.1);
                white-space: nowrap;
                margin-right: 0 !important;
            }

            .global-navbar .nav {
                flex-direction: row;
                padding: 0;
                overflow-x: auto;
            }

            .global-navbar .nav-item {
                margin: 0;
                flex-shrink: 0;
            }

            .global-navbar .nav-link {
                padding: 1rem 0.75rem;
                flex-direction: column;
                text-align: center;
                min-width: 80px;
                gap: 0.5rem;
            }

            .global-navbar .nav-link i {
                font-size: 1.2rem;
                width: 24px;
            }

            .global-navbar .nav-link span {
                font-size: 0.75rem;
                line-height: 1.2;
            }

            .main-content-wrapper {
                margin-left: 0;
            }
        }

        /* Ensure content doesn't get hidden behind navbar */
        body {
            margin: 0;
            padding: 0;
        }
    </style>
</head>
<body class="@ViewData["BodyClass"]">
    <!-- Global Navbar -->
    <nav class="global-navbar">
        <a class="navbar-brand" href="/">
            Certio
        </a>
        
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" href="#" title="Account">
                    <i class="fas fa-user"></i>
                    <span>Account</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#" title="Dashboard">
                    <i class="fas fa-tachometer-alt"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#" title="Clients">
                    <i class="fas fa-book"></i>
                    <span>Clients</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#" title="Groups">
                    <i class="fas fa-users"></i>
                    <span>Groups</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#" title="Calendar">
                    <i class="fas fa-calendar"></i>
                    <span>Calendar</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#" title="Inbox">
                    <i class="fas fa-envelope"></i>
                    <span>Inbox</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#" title="History">
                    <i class="fas fa-clock"></i>
                    <span>History</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#" title="Search">
                    <i class="fas fa-search"></i>
                    <span>Search</span>
                </a>
            </li>
        </ul>
    </nav>

    <!-- Main Content Wrapper -->
    <div class="main-content-wrapper">
        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>