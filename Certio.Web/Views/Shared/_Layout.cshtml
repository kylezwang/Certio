<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Notal AI Legal Assistant</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Katibeh&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Certio.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        /* Global Navbar Styles */
        .global-navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 6vw;
            height: 100vh;
            background-color: #3d1019;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            box-shadow: 2px 0 5px rgba(0,0,0,0.1);
        }

        .global-navbar .navbar-brand {
            color: white;
            font-family: 'Katibeh', sans-serif;
            font-size: 2.3rem;
            font-weight: bold;
            text-align: center;
            padding: 0.5rem 0rem 1rem 0rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            text-decoration: none;
            margin-right: 0 !important;
        }

        .global-navbar .navbar-brand:hover {
            color: white;
            text-decoration: none;
        }

        .global-navbar .nav {
            flex: 1;
            padding-bottom: 1rem;
        }

        .global-navbar .nav-item {
            margin: 0.25rem 0;
        }

        .global-navbar .global-nav-link {
            color: white;
            padding: 0.75rem 0.25rem;
            text-decoration: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
            text-align: center;
        }


        .global-navbar .global-nav-link i {
            width: 24px;
            text-align: center;
            font-size: 1.2rem;
        }

        .global-navbar .global-nav-link span {
            font-size: 0.75rem;
            font-weight: 500;
            line-height: 1.2;
        }

        /* Main content area adjustment */
        .main-content-wrapper {
            margin-left: 6vw;
            min-height: 100vh;
        }

        /* Mobile responsive */
        @@media (max-width: 768px) {
            .global-navbar {
                width: 100%;
                height: auto;
                position: relative;
                flex-direction: row;
                overflow-x: auto;
            }

            .global-navbar .navbar-brand {
                font-size: 1.5rem;
                padding: 1rem;
                border-bottom: none;
                border-right: 1px solid rgba(255,255,255,0.1);
                white-space: nowrap;
                margin-right: 0 !important;
            }

            .global-navbar .nav {
                flex-direction: row;
                padding: 0;
                overflow-x: auto;
            }

            .global-navbar .nav-item {
                margin: 0;
                flex-shrink: 0;
            }

            .global-navbar .global-nav-link {
                padding: 1rem 0.75rem;
                flex-direction: column;
                text-align: center;
                min-width: 80px;
                gap: 0.5rem;
                margin: 0;
                width: auto;
            }

            .global-navbar .global-nav-link i {
                font-size: 1.2rem;
                width: 24px;
            }

            .global-navbar .global-nav-link span {
                font-size: 0.75rem;
                line-height: 1.2;
            }

            .main-content-wrapper {
                margin-left: 0;
            }
        }

        /* Ensure content doesn't get hidden behind navbar */
        body {
            margin: 0;
            padding: 0;
        }

        /* Clients Popup Styles */
        .clients-popup {
            position: fixed;
            top: 0;
            left: 6vw;
            width: 320px;
            height: 100vh;
            background-color: #ffffff;
            box-shadow: 2px 0 8px rgba(0, 0, 0, 0.15);
            z-index: 999;
            transform: translateX(-100%);
            transition: transform 0.3s ease;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .clients-popup.show {
            transform: translateX(0);
        }

        .clients-popup-header {
            background-color: rgba(11, 54, 94, 0.05);
            color: black;
            padding: 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .clients-popup-title {
            font-size: 1.25rem;
            font-weight: 600;
            margin: 0;
        }

        .clients-popup-close {
            background: none;
            border: none;
            color: black;
            font-size: 1.5rem;
            cursor: pointer;
            padding: 0;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .clients-popup-close:hover {
            background-color: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
        }

        .clients-popup-content {
            padding: 0;
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .clients-scrollable-area {
            flex: 1;
            overflow-y: auto;
        }

        .clients-section-header {
            padding: 1rem 1rem 0.5rem 1rem;
            border-bottom: 1px solid #e5e7eb;
        }

        .clients-section-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: #1f2937;
            margin: 0 0 0.5rem 0;
        }

        .clients-list {
            padding: 0.5rem 0;
        }

        .client-item {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #f3f4f6;
            cursor: pointer;
            transition: background-color 0.2s ease;
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .client-item:hover {
            background-color: #f9fafb;
        }

        .client-item:last-child {
            border-bottom: none;
        }

        .client-name {
            font-weight: 600;
            color: #1f2937;
            font-size: 0.95rem;
            margin: 0;
        }

        .client-company {
            color: #6b7280;
            font-size: 0.875rem;
            margin: 0;
        }

        .client-status {
            color: #6b7280;
            font-size: 0.8rem;
            margin: 0;
        }

        /* Join Code Section Styles */
        .join-code-section {
            background-color: #f8fafc;
            border-top: 1px solid #e5e7eb;
            padding: 1rem;
            margin-top: auto;
        }

        .join-code-title {
            font-size: 1rem;
            font-weight: 600;
            color: #1f2937;
            margin: 0 0 0.75rem 0;
        }

        .join-code-form {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .join-code-input {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: 0.875rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
            box-sizing: border-box;
        }

        .join-code-input:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        .join-code-button {
            background-color: #3b82f6;
            color: white;
            border: none;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        .join-code-button:hover {
            background-color: #2563eb;
        }

        .join-code-button:disabled {
            background-color: #9ca3af;
            cursor: not-allowed;
        }

        .join-code-message {
            font-size: 0.8rem;
            margin-top: 0.5rem;
            padding: 0.5rem;
            border-radius: 4px;
        }

        .join-code-message.success {
            background-color: #d1fae5;
            color: #065f46;
            border: 1px solid #a7f3d0;
        }

        .join-code-message.error {
            background-color: #fee2e2;
            color: #991b1b;
            border: 1px solid #fca5a5;
        }

        /* Global Nav Button Hover and Selected States - Unified Styling */
        .global-navbar .global-nav-link {
            position: relative;
            margin: 0.25rem 0.5rem;
            border-radius: 8px;
            width: calc(100% - 1rem);
        }

        .global-navbar .global-nav-link:hover,
        .global-navbar .global-nav-link.active {
            background-color: rgba(255,255,255,0.15);
            color: white;
        }

        .global-navbar .global-nav-link:hover i,
        .global-navbar .global-nav-link:hover span,
        .global-navbar .global-nav-link.active i,
        .global-navbar .global-nav-link.active span {
            color: white;
        }

        /* Mobile responsive for clients popup */
        @@media (max-width: 768px) {
            .clients-popup {
                left: 0;
                width: 100%;
                transform: translateX(-100%);
            }

            .clients-popup.show {
                transform: translateX(0);
            }
        }
    </style>
</head>
<body class="@ViewData["BodyClass"]">
    <!-- Global Navbar -->
    <nav class="global-navbar">
        <a class="navbar-brand" href="/">
            Notal
        </a>
        
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="global-nav-link" href="#" id="myFirmLink" title="My Firm">
                    <i class="fa-solid fa-building-columns"></i>
                    <span>My Firm</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="global-nav-link clients-button" href="#" title="Clients" id="clientsButton">
                    <i class="fas fa-users"></i>
                    <span>Clients</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="global-nav-link" href="#" id="calendarLink" title="Calendar">
                    <i class="fas fa-calendar"></i>
                    <span>Calendar</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="global-nav-link" href="#" title="Billing">
                    <i class="fa-regular fa-credit-card"></i>
                    <span>Billing</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="global-nav-link" href="#" title="History">
                    <i class="fas fa-clock"></i>
                    <span>History</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="global-nav-link" href="#" title="Search">
                    <i class="fas fa-search"></i>
                    <span>Search</span>
                </a>
            </li>
        </ul>
    </nav>

    <!-- Main Content Wrapper -->
    <div class="main-content-wrapper">
        @RenderBody()
    </div>

    <!-- Clients Popup -->
    <div class="clients-popup" id="clientsPopup">
        <div class="clients-popup-header">
            <h3 class="clients-popup-title">Clients</h3>
            <button class="clients-popup-close" id="clientsPopupClose">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="clients-popup-content">
            <div class="clients-scrollable-area">
                <div class="clients-section-header">
                    <h4 class="clients-section-title">All Clients</h4>
                </div>
                <div class="clients-list" id="clientsList">
                    <!-- Client items will be populated by JavaScript -->
                </div>
            </div>
            <div class="join-code-section">
                <h4 class="join-code-title">Apply Join Code</h4>
                <form class="join-code-form" id="joinCodeForm">
                    <input type="text" 
                           class="join-code-input" 
                           id="joinCodeInput" 
                           placeholder="Enter join code..."
                           maxlength="20">
                    <button type="submit" class="join-code-button" id="joinCodeButton">
                        Apply Code
                    </button>
                    <div class="join-code-message" id="joinCodeMessage" style="display: none;"></div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js" defer></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>

    <script defer>
        // Clients Popup Functionality - deferred to not block page load
        window.addEventListener('load', function() {
            const clientsButton = document.getElementById('clientsButton');
            const clientsPopup = document.getElementById('clientsPopup');
            const clientsPopupClose = document.getElementById('clientsPopupClose');
            const clientsList = document.getElementById('clientsList');
            const myFirmLink = document.getElementById('myFirmLink');
            const calendarLink = document.getElementById('calendarLink');

            // Initialize My Firm link
            initializeMyFirmLink();
            
            // Initialize Calendar link with same logic
            initializeCalendarLink();

            // Function to initialize My Firm link - defer to not block page load
            async function initializeMyFirmLink() {
                // Defer to idle time to not block page load
                if ('requestIdleCallback' in window) {
                    requestIdleCallback(doFetch);
                } else {
                    setTimeout(doFetch, 100);
                }
                
                async function doFetch() {
                    try {
                        const response = await fetch('/Client/List', { credentials: 'include' });
                        const result = await response.json();
                        
                        if (result.success && result.organizations) {
                            // Find the user's firm organization (LawFirm type)
                            const firmOrg = result.organizations.find(org => 
                                org.organizationType === 'LawFirm'
                            );
                            
                            if (firmOrg) {
                                myFirmLink.href = `/Client/${firmOrg.organizationId}/Dashboard`;
                                
                                // Check if current URL is in the law firm organization and add active class
                                updateMyFirmActiveState(firmOrg.organizationId);
                            } else {
                                // If no firm organization found, redirect to Global/Dashboard
                                myFirmLink.href = '/Global/Dashboard';
                            }
                        } else {
                            // Fallback to Global Dashboard if unable to fetch organizations
                            myFirmLink.href = '/Global/Dashboard';
                        }
                    } catch (error) {
                        console.error('Error initializing My Firm link:', error);
                        // Fallback to Global Dashboard on error
                        myFirmLink.href = '/Global/Dashboard';
                    }
                }
            }

            // Function to update My Firm button active state based on current URL
            function updateMyFirmActiveState(firmOrgId) {
                // Check if current URL path matches the firm organization ID but is NOT the Calendar page
                const currentPath = window.location.pathname;
                const isFirmPath = new RegExp(`^/Client/${firmOrgId}/`).test(currentPath);
                const isCalendarPath = new RegExp(`^/Client/${firmOrgId}/Calendar`).test(currentPath);

                if (isFirmPath && !isCalendarPath) {
                    myFirmLink.classList.add('active');
                } else {
                    myFirmLink.classList.remove('active');
                }
            }

            // Function to initialize Calendar link - defer to not block page load
            async function initializeCalendarLink() {
                // Defer to idle time to not block page load
                if ('requestIdleCallback' in window) {
                    requestIdleCallback(doFetch);
                } else {
                    setTimeout(doFetch, 100);
                }
                
                async function doFetch() {
                    try {
                        const response = await fetch('/Client/List', { credentials: 'include' });
                        const result = await response.json();
                        
                        if (result.success && result.organizations) {
                            // Find the user's firm organization (LawFirm type)
                            const firmOrg = result.organizations.find(org => 
                                org.organizationType === 'LawFirm'
                            );
                            
                            if (firmOrg) {
                                calendarLink.href = `/Client/${firmOrg.organizationId}/Calendar`;
                                
                                // Check if current URL is the calendar page and add active class
                                updateCalendarActiveState(firmOrg.organizationId);
                            } else {
                                // If no firm organization found, default to #
                                calendarLink.href = '#';
                            }
                        } else {
                            // Fallback on error
                            calendarLink.href = '#';
                        }
                    } catch (error) {
                        console.error('Error initializing Calendar link:', error);
                        // Fallback on error
                        calendarLink.href = '#';
                    }
                }
            }

            // Function to update Calendar button active state based on current URL
            function updateCalendarActiveState(firmOrgId) {
                const currentPath = window.location.pathname;
                const calendarPathPattern = new RegExp(`^/Client/${firmOrgId}/Calendar`);
                
                if (calendarPathPattern.test(currentPath)) {
                    calendarLink.classList.add('active');
                    // Ensure My Firm is not marked active when Calendar is active
                    myFirmLink.classList.remove('active');
                } else {
                    calendarLink.classList.remove('active');
                }
            }

            // Populate clients list
            async function populateClientsList() {
                clientsList.innerHTML = '';
                try {
                    const response = await fetch('/Client/List', { credentials: 'include' });
                    const result = await response.json();
                    if (!result.success) {
                        const msg = document.createElement('div');
                        msg.className = 'client-item';
                        msg.innerHTML = `<p class="client-status">${result.message || 'Unable to load clients.'}</p>`;
                        clientsList.appendChild(msg);
                        return;
                    }
                    const orgs = (result.organizations || []).filter(o => o.organizationType !== 'LawFirm');
                    if (orgs.length === 0) {
                        const empty = document.createElement('div');
                        empty.className = 'client-item';
                        empty.innerHTML = `<p class="client-status">No clients yet. Use a join code below to add one.</p>`;
                        clientsList.appendChild(empty);
                        return;
                    }
                    orgs.forEach(o => {
                        const ownerName = `${o.ownerFirstName} ${o.ownerLastName}`.trim();
                        const clientItem = document.createElement('div');
                        clientItem.className = 'client-item';
                        clientItem.innerHTML = `
                            <h5 class="client-name">${ownerName}</h5>
                            <p class="client-company">${o.organizationName}</p>
                            <p class="client-status">${o.isPrimary ? 'Primary' : (o.isPersonal ? 'Personal' : 'Active')}</p>
                        `;
                        clientItem.addEventListener('click', () => {
                            window.location.href = `/Client/${o.organizationId}/Dashboard`;
                        });
                        clientsList.appendChild(clientItem);
                    });
                } catch (e) {
                    const err = document.createElement('div');
                    err.className = 'client-item';
                    err.innerHTML = `<p class="client-status">Error loading clients.</p>`;
                    clientsList.appendChild(err);
                }
            }

            // Show clients popup
            function showClientsPopup() {
                clientsPopup.classList.add('show');
                clientsButton.classList.add('active');
                populateClientsList();
            }

            // Hide clients popup
            function hideClientsPopup() {
                clientsPopup.classList.remove('show');
                clientsButton.classList.remove('active');
            }

            // Event listeners
            clientsButton.addEventListener('click', function(e) {
                e.preventDefault();
                if (clientsPopup.classList.contains('show')) {
                    hideClientsPopup();
                } else {
                    showClientsPopup();
                }
            });

            clientsPopupClose.addEventListener('click', function() {
                hideClientsPopup();
            });

            // Close popup when clicking outside
            document.addEventListener('click', function(e) {
                if (!clientsPopup.contains(e.target) && !clientsButton.contains(e.target)) {
                    hideClientsPopup();
                }
            });

            // Close popup on escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && clientsPopup.classList.contains('show')) {
                    hideClientsPopup();
                }
            });

            // Join Code Functionality
            const joinCodeForm = document.getElementById('joinCodeForm');
            const joinCodeInput = document.getElementById('joinCodeInput');
            const joinCodeButton = document.getElementById('joinCodeButton');
            const joinCodeMessage = document.getElementById('joinCodeMessage');

            function showJoinCodeMessage(message, isError = false) {
                joinCodeMessage.textContent = message;
                joinCodeMessage.className = `join-code-message ${isError ? 'error' : 'success'}`;
                joinCodeMessage.style.display = 'block';
                
                // Hide message after 5 seconds
                setTimeout(() => {
                    joinCodeMessage.style.display = 'none';
                }, 5000);
            }

            function setJoinCodeLoading(loading) {
                joinCodeButton.disabled = loading;
                joinCodeButton.textContent = loading ? 'Applying...' : 'Apply Code';
            }

            joinCodeForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                
                const code = joinCodeInput.value.trim();
                if (!code) {
                    showJoinCodeMessage('Please enter a join code.', true);
                    return;
                }

                setJoinCodeLoading(true);
                joinCodeMessage.style.display = 'none';

                try {
                    const response = await fetch('/Home/ApplyJoinCode', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: JSON.stringify({ joinCode: code })
                    });

                    const result = await response.json();
                    
                    if (result.success) {
                        showJoinCodeMessage(result.message || 'Successfully applied join code!');
                        joinCodeInput.value = '';
                        // Optionally refresh the clients list or redirect
                        if (result.redirectUrl) {
                            window.location.href = result.redirectUrl;
                        }
                    } else {
                        showJoinCodeMessage(result.message || 'Failed to apply join code.', true);
                    }
                } catch (error) {
                    console.error('Error applying join code:', error);
                    showJoinCodeMessage('An error occurred while applying the join code.', true);
                } finally {
                    setJoinCodeLoading(false);
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>