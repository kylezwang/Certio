        // Function to center search bar and action buttons within their respective areas
        function centerSearchBar(skipActionButtons = false, skipTransition = false) {
            const searchContainer = document.getElementById('headerSearchContainer');
            const actionButtonsContainer = document.getElementById('actionButtonsContainer');
            const profileAvatar = document.querySelector('.user-profile-avatar');
            const mainContentWrapper = document.querySelector('.client-main-content-wrapper');
            const pageHeader = document.querySelector('.page-header');
            
            if (!mainContentWrapper || !pageHeader) return;
            
            const mainContentRect = mainContentWrapper.getBoundingClientRect();
            const pageHeaderRect = pageHeader.getBoundingClientRect();
            
            // Temporarily disable transitions if skipTransition is true (for initial positioning)
            if (skipTransition) {
                if (searchContainer) {
                    searchContainer.style.transition = 'none';
                }
                if (actionButtonsContainer) {
                    actionButtonsContainer.style.transition = 'none';
                }
            }
            
            // Center search bar within main content area
            if (searchContainer) {
                const mainContentCenter = mainContentRect.left + (mainContentRect.width / 2);
                searchContainer.style.left = mainContentCenter + 'px';
                searchContainer.style.transform = 'translateX(-50%)';
            }
            
            // Only recalculate action buttons position if not skipped
            if (!skipActionButtons && actionButtonsContainer) {
                const activeSidebar = localStorage.getItem('activeSidebar');
                
                // If sidebars are hidden, restore saved position instead of recalculating
                // This prevents the buttons from moving when navigating between pages
                if (activeSidebar === 'none') {
                    const savedPosition = localStorage.getItem('actionButtonsPosition');
                    if (savedPosition) {
                        actionButtonsContainer.style.left = savedPosition + 'px';
                        actionButtonsContainer.style.right = 'auto';
                        actionButtonsContainer.style.transform = 'none';
                        return; // Don't recalculate - use saved position
                    }
                }
                
                // Center action buttons in the space between main content right edge and profile avatar
                const rightSpaceLeft = mainContentRect.right;
                let rightSpaceRight = pageHeaderRect.right;
                
                
                
                // Calculate the exact center of the available space
                const availableWidth = rightSpaceRight - rightSpaceLeft;
                const buttonWidth = actionButtonsContainer.offsetWidth;
                
                // Calculate true center point
                const centerPoint = rightSpaceLeft + (availableWidth / 2);
                const leftPosition = centerPoint - (buttonWidth / 2);
                
                actionButtonsContainer.style.left = leftPosition + 'px';
                actionButtonsContainer.style.right = 'auto';
                actionButtonsContainer.style.transform = 'none';
                
                // Always save the calculated position (whether sidebar is visible or not)
                // This ensures we have a position to restore when sidebars are hidden
                localStorage.setItem('actionButtonsPosition', leftPosition);
            }
            
            // Re-enable transitions after positioning (if they were disabled)
            if (skipTransition) {
                // Force a reflow to ensure the position is applied before re-enabling transitions
                if (searchContainer) {
                    searchContainer.offsetHeight; // Trigger reflow
                    searchContainer.style.transition = 'left 0.3s ease, transform 0.3s ease';
                }
                if (actionButtonsContainer) {
                    actionButtonsContainer.offsetHeight; // Trigger reflow
                    actionButtonsContainer.style.transition = 'left 0.3s ease, right 0.3s ease';
                }
            }
        }
        
        // Make functions available globally
        window.showAIChatPanel = showAIChatPanel;
        window.showCommsSidebar = showCommsSidebar;
        window.hideBothSidebars = hideBothSidebars;
        window.updateNotalLogo = updateNotalLogo;
        window.centerSearchBar = centerSearchBar;
        
        // Check for saved dark mode preference and apply it on page load
        const isDarkMode = localStorage.getItem('darkMode') === 'true';
        if (isDarkMode) {
            document.body.classList.add('dark-mode');
        }

        // Communications page check - if on communications page, hide the floating toggle button
        const currentAction = '@ViewContext.RouteData.Values["action"]?.ToString()';
        if (currentAction === 'Communications') {
            const commsToggleBtn = document.getElementById('commsToggleBtn');
            if (commsToggleBtn) {
                commsToggleBtn.style.display = 'none';
            }
            if (commsSidebarPanel) {
                commsSidebarPanel.style.display = 'none';
            }
        }

        // Calendar day selection for global dashboard sidebar
        const calendarDays = document.querySelectorAll('.global-dashboard-sidebar .calendar-day');
        if (calendarDays && calendarDays.length > 0) {
            function clearSelected() {
                document.querySelectorAll('.global-dashboard-sidebar .calendar-day.selected').forEach(function (el) {
                    el.classList.remove('selected');
                });
                // When a selection is made, remove the automatic "today" highlight
                document.querySelectorAll('.global-dashboard-sidebar .calendar-day.today').forEach(function (el) {
                    el.classList.remove('today');
                });
            }

            function selectSidebarDayByNumber(dayNumber) {
                const candidates = Array.from(document.querySelectorAll('.global-dashboard-sidebar .calendar-day'));
                const target = candidates.find(el => (el.textContent || '').trim() === String(dayNumber));
                if (target) {
                    clearSelected();
                    target.classList.add('selected');
                }
            }

            calendarDays.forEach(function (dayEl) {
                dayEl.addEventListener('click', function () {
                    clearSelected();
                    this.classList.add('selected');
                    const dayText = (this.textContent || '').trim();
                    const dayNum = parseInt(dayText, 10);
                    // Broadcast to other calendars (main content)
                    window.dispatchEvent(new CustomEvent('calendarDaySelected', { detail: { day: dayNum } }));
                    // Optional: Navigate/update main view as needed
                });
            });

            // Listen for external selection events (from main-content calendar)
            window.addEventListener('calendarDaySelected', function (e) {
                if (!e || !e.detail || !e.detail.day) return;
                selectSidebarDayByNumber(e.detail.day);
            });
        }
    });
</script>
} @* End if HideChatPanel for scripts *@

@await RenderSectionAsync("Scripts", required: false)