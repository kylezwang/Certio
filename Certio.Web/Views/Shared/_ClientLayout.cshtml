        // Simple toggle button update - no dynamic positioning
        function updateToggleButtonArrow() {
            if (!timerToggleBtn) return;
            
            if (isTimerVisible) {
                // Timer is showing - button should show << (hide/collapse)
                timerToggleBtn.innerHTML = '<i class="fas fa-angles-left" style="font-size: 0.875rem;"></i>';
                timerToggleBtn.style.marginTop = '';
