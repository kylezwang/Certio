    <!-- Desktop Client Sidebar -->
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();
        var isGlobalDashboard = controller == "Global" || controller == "Calendar" || controller == "History";
    }
    <div class="d-none d-xl-block @(isGlobalDashboard ? "global-dashboard-sidebar" : "client-sidebar")">
        
        <!-- Navigation -->
        @if (isGlobalDashboard)
        {
            <!-- Global Dashboard Sidebar Content -->
            <div class="global-dashboard-content">
                <!-- Upcoming Deadlines Card (for Calendar page only) -->
                @if (controller == "Calendar")
                {
                    <div class="card mb-3 border-0">
                        <div class="card-body p-3">
                            <h5 class="card-title fw-bold mb-3">Upcoming Deadlines</h5>
                            <div id="upcomingDeadlinesList">
                                <p class="text-muted small mb-2">Loading deadlines...</p>
                            </div>
                        </div>
                    </div>
                }
                
                <!-- Calendar Card -->
                <div class="card mb-3 border-0">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="card-title fw-bold mb-0">@DateTime.Now.ToString("MMMM yyyy")</h5>
                        </div>
                        
                        <div class="calendar-grid">
                            <div class="calendar-header">
                                <div class="calendar-day-header">S</div>
                                <div class="calendar-day-header">M</div>
                                <div class="calendar-day-header">T</div>
                                <div class="calendar-day-header">W</div>
                                <div class="calendar-day-header">T</div>
                                <div class="calendar-day-header">F</div>
                                <div class="calendar-day-header">S</div>
                            </div>
                            
                            <div class="calendar-body">
                                @{
                                    var currentDate = DateTime.Now;
                                    var firstDay = new DateTime(currentDate.Year, currentDate.Month, 1);
                                    var startDay = firstDay.AddDays(-(int)firstDay.DayOfWeek);
                                    var today = DateTime.Today;
                                }
                                
                                @for (int week = 0; week < 6; week++)
                                {
                                    <div class="calendar-week">
                                        @for (int day = 0; day < 7; day++)
                                        {
                                            var date = startDay.AddDays(week * 7 + day);
                                            var isCurrentMonth = date.Month == currentDate.Month;
                                            var isToday = date.Date == today;
                                            
                                            <div class="calendar-day @(isCurrentMonth ? "current-month" : "other-month") @(isToday ? "today" : "")" data-date="@date.ToString("yyyy-MM-dd")">
                                                @date.Day
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Activity Card / Custom Sidebar Card -->
                @if (IsSectionDefined("GlobalSidebarFinalCard"))
                {
                    @RenderSection("GlobalSidebarFinalCard", required: false)
                }
                else
                {
                    <!-- Default: Recent Activity Card -->
                    <div class="card border-0">
                        <div class="card-body p-3">
                            <h5 class="card-title fw-bold mb-2">Recent Activity</h5>
                            <p class="text-muted small mb-2">Recent Files</p>
                            
                            <div class="recent-files-list">
                                <div class="recent-file-item d-flex align-items-center mb-2">
                                    <div class="file-icon me-3">
                                        <i class="fas fa-file-pdf text-danger"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-1 fw-semibold">Project_Spec_v3.pdf</h6>
                                        <p class="text-muted small mb-0">2h ago</p>
                                    </div>
                                </div>
                                <div class="recent-file-item d-flex align-items-center mb-2">
                                    <div class="file-icon me-3">
                                        <i class="fas fa-file-alt text-primary"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-1 fw-semibold">Design_System.fig</h6>
                                        <p class="text-muted small mb-0">4h ago</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Client Sidebar Navigation -->
            <nav class="nav flex-column">
                <div class="nav-item">
                    <a href="/Client/@ViewBag.OrganizationId/Dashboard" 
                       class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
                        <i class="fas fa-tachometer-alt"></i>
                        <span>Dashboard</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a href="/Client/@ViewBag.OrganizationId/Matter" 
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Matter" || (ViewContext.RouteData.Values["controller"]?.ToString() == "Client" && ViewContext.RouteData.Values["action"]?.ToString() == "Matter") ? "active" : "")">
                        <i class="fas fa-briefcase"></i>
                        <span>Matters</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a href="/Client/@ViewBag.OrganizationId/Tasks" 
                       class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Tasks" ? "active" : "")">
                        <i class="fa-solid fa-bars-progress"></i>
                        <span>Tasks</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a href="/Client/@ViewBag.OrganizationId/Communications" 
                       class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Communications" ? "active" : "")">
                        <i class="fas fa-comments"></i>
                        <span>Communications</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a href="/Client/@ViewBag.OrganizationId/Documents" 
                       class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Documents" ? "active" : "")">
                        <i class="fas fa-file-alt"></i>
                        <span>Documents</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a href="/Client/@ViewBag.OrganizationId/Teams" 
                       class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Teams" ? "active" : "")">
                        <i class="fa-solid fa-user-group"></i>
                        <span>Teams</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a href="/Client/@ViewBag.OrganizationId/Settings" 
                       class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")">
                        <i class="fas fa-cog"></i>
                        <span>Firm Settings</span>
                    </a>
                </div>
            </nav>

            <!-- Logout Button -->
            <div class="logout-section">
                <form asp-controller="Home" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="logout-button">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Logout</span>
                    </button>
                </form>
            </div>
        }
        
