        // Update timer matter card based on current page
        function updateTimerMatterCard() {
            const timerMatterIcon = document.getElementById('timerMatterIcon');
            const timerMatterTitle = document.getElementById('timerMatterTitle');
            
            if (!timerMatterIcon || !timerMatterTitle) return;
            
            // Check if we're on a Matter Details page
            const pathname = window.location.pathname;
            const matterDetailsMatch = pathname.match(/\/Matter\/Details\/(\d+)/);
            
            if (matterDetailsMatch) {
                // We're on a matter details page - try to get the matter info
                let matterTitle = null;
                let matterAbbrev = null;
                
                // First, try to get the title from the h1 with class "matter-title"
                const matterTitleElement = document.querySelector('.matter-title');
                if (matterTitleElement) {
                    matterTitle = matterTitleElement.textContent.trim();
                }
                
                // Fallback: try to get from meta tag
                if (!matterTitle) {
                    const titleMeta = document.querySelector('meta[name="matter-id"]');
                    if (titleMeta) {
                        // Try to find the title in the page's ViewData
                        const pageTitle = document.title;
                        if (pageTitle) {
                            matterTitle = pageTitle.replace(' - Notal', '').trim();
                        }
                    }
                }
                
                // Fallback: try to get from matter-details-container data attribute
                if (!matterTitle) {
                    const detailsContainer = document.querySelector('.matter-details-container');
                    if (detailsContainer && detailsContainer.hasAttribute('data-matter-title')) {
                        matterTitle = detailsContainer.getAttribute('data-matter-title');
                    }
                }
                
                // Fallback: try to get from matter-icon-badge (which has the abbreviation) and task cards
                if (!matterTitle) {
                    const taskCard = document.querySelector('[data-matter-title]');
                    if (taskCard) {
                        matterTitle = taskCard.getAttribute('data-matter-title');
                    }
                }
                
                // If we found a matter title, update the card
                if (matterTitle) {
                    // Generate abbreviation from title (first letter of first two words)
                    const words = matterTitle.split(/[\s-]+/).filter(w => w.length > 0);
                    if (words.length >= 2) {
                        matterAbbrev = (words[0][0] + words[1][0]).toUpperCase();
                    } else if (words.length === 1) {
                        matterAbbrev = words[0].substring(0, 2).toUpperCase();
                    } else {
                        matterAbbrev = 'M';
                    }
                    
                    // Check if we can get abbreviation from existing matter-icon-badge
                    const matterIconBadge = document.querySelector('.matter-icon-badge');
                    if (matterIconBadge) {
                        const badgeText = matterIconBadge.textContent.trim();
                        if (badgeText && badgeText.length <= 3) {
                            matterAbbrev = badgeText;
                        }
                    }
                    
                    // Update icon to show abbreviation
                    timerMatterIcon.innerHTML = matterAbbrev || 'M';
                    timerMatterIcon.style.background = 'linear-gradient(135deg, #3d1019, #3d1019)';
                    timerMatterIcon.style.fontSize = '0.75rem';
                    
                    // Update title
                    timerMatterTitle.textContent = matterTitle;
                    timerMatterTitle.style.color = '#1a202c';
                    timerMatterTitle.className = 'mb-0 fw-bold text-dark';
                } else {
                    // Reset to default state
                    resetTimerMatterCard();
                }
            } else {
                // Not on a matter details page - reset to default
                resetTimerMatterCard();
            }
        }
        
