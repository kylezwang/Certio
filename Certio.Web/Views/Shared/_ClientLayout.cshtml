    <!-- Floating Timer Overlay (Hidden on Billing Page) -->
    @if (controller != "Billing")
    {
    <div id="floatingTimerOverlay" style="
        position: fixed;
        z-index: 9999;
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        transition: none;
        cursor: move;
    ">
        <!-- Timer Card -->
        <div id="timerCard" style="
            background: white;
            border-radius: 12px;
            padding: 0.5rem 0.75rem;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            transition: all 0.3s ease;
            cursor: move;
            min-width: 260px;
            max-width: 260px;
        ">
            <!-- Timer Display and Controls -->
            <div style="display: flex; align-items: center; gap: 0.5rem; justify-content: space-between;">
                <div id="timerDisplay" style="
                    font-family: 'SF Mono', 'Consolas', 'Monaco', monospace;
                    font-size: 1.33rem;
                    font-weight: 600;
                    color: #1f2937;
                    flex-shrink: 0;
                    white-space: nowrap;
                    letter-spacing: 0.1em;
                ">
                    00:00:00
                </div>
                <div style="display: flex; gap: 0.375rem; flex-wrap: nowrap; flex-shrink: 0;">
                    <button id="timerStartBtn" class="timer-btn timer-start-btn" style="
                        background: #c7b7a3;
                        color: white;
                        border: none;
                        border-radius: 6px;
                        padding: 0.3rem 0.625rem;
                        font-size: 0.8rem;
                        font-weight: 600;
                        cursor: pointer !important;
                        display: flex;
                        align-items: center;
                        gap: 0.25rem;
                        transition: all 0.2s ease;
                        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
                    ">
                        <i class="fas fa-play" style="font-size: 0.65rem;"></i>
                        Start
                    </button>
                    <button id="timerStopBtn" class="timer-btn" style="
                        background: linear-gradient(135deg, #ef4444, #dc2626);
                        color: white;
                        border: none;
                        border-radius: 6px;
                        padding: 0.3rem 0.625rem;
                        font-size: 0.8rem;
                        font-weight: 600;
                        cursor: pointer !important;
                        display: none;
                        align-items: center;
                        gap: 0.25rem;
                        transition: all 0.2s ease;
                    ">
                        <i class="fas fa-stop" style="font-size: 0.65rem;"></i>
                        Stop
                    </button>
                    <button id="timerResetBtn" class="timer-btn" style="
                        background: #f3f4f6;
                        color: #6b7280;
                        border: none;
                        border-radius: 6px;
                        padding: 0.3rem 0.5rem;
                        font-size: 0.8rem;
                        font-weight: 600;
                        cursor: pointer !important;
                        display: flex;
                        align-items: center;
                        gap: 0.25rem;
                        transition: all 0.2s ease;
                    ">
                        <i class="fas fa-redo" style="font-size: 0.65rem;"></i>
                        Reset
                    </button>
                </div>
            </div>
            
            
            <!-- Currently Working On Section -->
            <div style="display: flex; flex-direction: column; gap: 0.1rem;">
                <!-- Matter Preview Card (borderless) -->
                <div class="card border-0" id="timerMatterCard" style="background-color: #f8f9fa; padding: 0.75rem; border-radius: 8px;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <div id="timerMatterIcon" style="
                            width: 32px;
                            height: 32px;
                            border-radius: 6px;
                            background: #6b7280;
                            color: white;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            font-size: 0.75rem;
                            font-weight: 700;
                            flex-shrink: 0;
                        ">
                            <i class="fa-solid fa-building-columns"></i>
                        </div>
                        <div style="min-width: 0; flex: 1; margin-top: 0;">
                            <h6 id="timerMatterTitle" class="mb-0 fw-semibold" style="
                                font-size: 0.875rem;
                                white-space: nowrap;
                                overflow: hidden;
                                text-overflow: ellipsis;
                                color: #6b7280;
                            ">
                                Select a Matter
                            </h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Hide/Show Toggle Button -->
        <button id="timerToggleBtn" style="
            background: white;
            border: none;
            border-radius: 8px;
            padding: 0.5rem 0.5rem;
            cursor: pointer !important;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            color: #6b7280;
        " title="Hide Timer">
            <i class="fas fa-angles-left" style="font-size: 0.875rem;"></i>
        </button>
    </div>
    }
    
    <!-- Inline script to apply saved timer position immediately to prevent flash -->
    <script>
        (function() {
            const overlay = document.getElementById('floatingTimerOverlay');
            if (overlay) {
                const savedPosition = localStorage.getItem('timerPosition');
                if (savedPosition) {
                    // Restore saved manual position from previous drag
                    const position = JSON.parse(savedPosition);
                    overlay.style.left = position.left;
                    overlay.style.top = position.top;
                } else {
                    // Default position: centered within combined navbar width (6vw + 14vw = 20vw)
                    overlay.style.left = '10vw'; // Center of combined navbar area
                    overlay.style.bottom = '1.5rem';
                    overlay.style.transform = 'translateX(-50%)'; // Center the timer itself
                }
            }
        })();
    </script>

