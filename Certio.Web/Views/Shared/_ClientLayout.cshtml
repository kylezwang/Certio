@* Only load AI chat scripts if chat panel is not hidden *@
@if (ViewData["HideChatPanel"] as bool? != true)
{
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js" defer></script>
<script src="~/js/chat.js" defer></script>

<script>
    // Initialize conversations on all pages
    document.addEventListener('DOMContentLoaded', function() {
        
        // Initialize simple sidebar toggle
        const toggleBtn = document.getElementById('toggleSidebar');
        if (toggleBtn) {
            toggleBtn.addEventListener('click', function() {
                document.body.classList.toggle('sidebar-hidden');
                
                // Save state to localStorage only if manually toggled
                const isHidden = document.body.classList.contains('sidebar-hidden');
                localStorage.setItem('sidebarHidden', isHidden);
                localStorage.setItem('sidebarHiddenManual', 'true');
            });
            
            // Restore saved state only if it was manually toggled
            const wasManuallyHidden = localStorage.getItem('sidebarHiddenManual') === 'true';
            if (wasManuallyHidden && localStorage.getItem('sidebarHidden') === 'true') {
                document.body.classList.add('sidebar-hidden');
            }
        }
        
        // AI Chat Toggle
        const aiToggle = document.getElementById('aiToggle');
        const aiToggleIcon = document.getElementById('aiToggleIcon');
        
        // Check for saved AI chat preference or default to visible
        const isChatHidden = localStorage.getItem('chatHidden') === 'true';
        if (isChatHidden) {
            document.body.classList.add('chat-hidden');
            if (aiToggleIcon) {
                aiToggleIcon.classList.remove('fa-robot');
                aiToggleIcon.classList.add('fa-eye-slash');
            }
        }
        
        // Toggle AI chat panel
        if (aiToggle) {
            aiToggle.addEventListener('click', function() {
                document.body.classList.toggle('chat-hidden');
                const isHidden = document.body.classList.contains('chat-hidden');
                localStorage.setItem('chatHidden', isHidden);
                
                // Update icon
                if (aiToggleIcon) {
                    if (isHidden) {
                        aiToggleIcon.classList.remove('fa-robot');
                        aiToggleIcon.classList.add('fa-eye-slash');
                    } else {
                        aiToggleIcon.classList.remove('fa-eye-slash');
                        aiToggleIcon.classList.add('fa-robot');
                    }
                }
            });
        }
        
        // Notifications Toggle
        const notificationsBtn = document.getElementById('notificationsBtn');
        if (notificationsBtn) {
            // Check for saved notifications preference or default to visible
            const isNotificationsHidden = localStorage.getItem('notificationsHidden') === 'true';
            if (isNotificationsHidden) {
                const icon = notificationsBtn.querySelector('i');
                icon.classList.remove('fa-bell');
                icon.classList.add('fa-bell-slash');
                notificationsBtn.title = 'Hide Notifications';
            }
            
            notificationsBtn.addEventListener('click', function() {
                const icon = this.querySelector('i');
                const isHidden = icon.classList.contains('fa-bell-slash');
                
                if (isHidden) {
                    // Show notifications
                    icon.classList.remove('fa-bell-slash');
                    icon.classList.add('fa-bell');
                    this.title = 'Show Notifications';
                    localStorage.setItem('notificationsHidden', 'false');
                } else {
                    // Hide notifications
                    icon.classList.remove('fa-bell');
                    icon.classList.add('fa-bell-slash');
                    this.title = 'Hide Notifications';
                    localStorage.setItem('notificationsHidden', 'true');
                }
            });
        }
        
        // Dark Mode Toggle
        const darkModeToggle = document.getElementById('darkModeToggle');
        const darkModeIcon = document.getElementById('darkModeIcon');
        
        // Always show moon icon
        if (darkModeIcon) {
            darkModeIcon.classList.remove('fa-sun');
            if (!darkModeIcon.classList.contains('fa-moon')) {
                darkModeIcon.classList.add('fa-moon');
            }
        }
        
        // Check for saved dark mode preference or default to light mode
        const isDarkMode = localStorage.getItem('darkMode') === 'true';
        if (isDarkMode) {
            document.body.classList.add('dark-mode');
        }
        
        // Toggle dark mode
        if (darkModeToggle) {
            darkModeToggle.addEventListener('click', function() {
                document.body.classList.toggle('dark-mode');
                localStorage.setItem('darkMode', document.body.classList.contains('dark-mode') ? 'true' : 'false');
            });
        }

        // Communications button handling
        const communicationsBtn = document.getElementById('communicationsBtn');
        if (communicationsBtn) {
            // Check if we're on the communications page and set active state
            const currentAction = '@ViewContext.RouteData.Values["action"]?.ToString()';
            if (currentAction === 'Communications') {
                communicationsBtn.classList.add('active');
            }
            
            // Handle communications button click
            communicationsBtn.addEventListener('click', function() {
                // Navigate to communications page
                const orgId = '@ViewBag.OrganizationId';
                window.location.href = `/Client/${orgId}/Communications`;
            });
        }

        // Calendar day selection for global dashboard sidebar
        const calendarDays = document.querySelectorAll('.global-dashboard-sidebar .calendar-day');
        if (calendarDays && calendarDays.length > 0) {
            function clearSelected() {
                document.querySelectorAll('.global-dashboard-sidebar .calendar-day.selected').forEach(function (el) {
                    el.classList.remove('selected');
                });
                // When a selection is made, remove the automatic "today" highlight
                document.querySelectorAll('.global-dashboard-sidebar .calendar-day.today').forEach(function (el) {
                    el.classList.remove('today');
                });
            }

            function selectSidebarDayByNumber(dayNumber) {
                const candidates = Array.from(document.querySelectorAll('.global-dashboard-sidebar .calendar-day'));
                const target = candidates.find(el => (el.textContent || '').trim() === String(dayNumber));
                if (target) {
                    clearSelected();
                    target.classList.add('selected');
                }
            }

            calendarDays.forEach(function (dayEl) {
                dayEl.addEventListener('click', function () {
                    clearSelected();
                    this.classList.add('selected');
                    const dayText = (this.textContent || '').trim();
                    const dayNum = parseInt(dayText, 10);
                    // Broadcast to other calendars (main content)
                    window.dispatchEvent(new CustomEvent('calendarDaySelected', { detail: { day: dayNum } }));
                    // Optional: Navigate/update main view as needed
                });
            });

            // Listen for external selection events (from main-content calendar)
            window.addEventListener('calendarDaySelected', function (e) {
                if (!e || !e.detail || !e.detail.day) return;
                selectSidebarDayByNumber(e.detail.day);
            });
        }
    });
</script>
} @* End if HideChatPanel for scripts *@

@await RenderSectionAsync("Scripts", required: false)