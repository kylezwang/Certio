@* Only load AI chat scripts if chat panel is not hidden *@
@if (ViewData["HideChatPanel"] as bool? != true)
{
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js" defer></script>
<script src="~/js/chat.js" defer></script>

<script>
        // Initialize conversations on all pages
        document.addEventListener('DOMContentLoaded', function() {
            
            // Profile dropdown functionality
            const userProfileAvatar = document.getElementById('userProfileAvatar');
            const profileDropdown = document.getElementById('profileDropdown');
            
            if (userProfileAvatar && profileDropdown) {
                // Toggle dropdown when clicking avatar
                userProfileAvatar.addEventListener('click', function(e) {
                    e.stopPropagation();
                    profileDropdown.classList.toggle('show');
                });
                
                // Close dropdown when clicking outside
                document.addEventListener('click', function(e) {
                    if (!userProfileAvatar.contains(e.target)) {
                        profileDropdown.classList.remove('show');
                    }
                });
                
                // Close dropdown when clicking a menu item
                const dropdownItems = profileDropdown.querySelectorAll('.profile-dropdown-item');
                dropdownItems.forEach(item => {
                    item.addEventListener('click', function() {
                        profileDropdown.classList.remove('show');
                    });
                });
            }
            
            // Sticky Last Message on Scroll - with hysteresis to prevent jitter
            const chatMessages = document.getElementById('chatMessages');
            if (chatMessages) {
                let lastScrollTop = 0;
                let scrollTimeout = null;
                let isCurrentlyScrollingUp = false;
                let scrollThrottle = null;
                
                chatMessages.addEventListener('scroll', function() {
                    // Throttle scroll events to prevent rapid firing
                    if (scrollThrottle) return;
                    scrollThrottle = setTimeout(() => { scrollThrottle = null; }, 50);
                    
                    const currentScrollTop = chatMessages.scrollTop;
                    const scrollHeight = chatMessages.scrollHeight;
                    const clientHeight = chatMessages.clientHeight;
                    const distanceFromBottom = scrollHeight - currentScrollTop - clientHeight;
                    
                    // Check if scrolling up and not at the bottom
                    const scrollDelta = currentScrollTop - lastScrollTop;
                    
                    // Add hysteresis: different thresholds for switching on vs off
                    // When turning ON scrolling-up: must scroll up at least 10px AND be at least 50px from bottom
                    // When turning OFF scrolling-up: must scroll down at least 15px OR be within 30px of bottom
                    const shouldTurnOn = scrollDelta < -10 && distanceFromBottom > 50;
                    const shouldTurnOff = scrollDelta > 15 || distanceFromBottom < 30;
                    
                    // Only update class if there's a significant direction change
                    if (shouldTurnOn && !isCurrentlyScrollingUp) {
                        isCurrentlyScrollingUp = true;
                        chatMessages.classList.add('scrolling-up');
                    } else if (shouldTurnOff && isCurrentlyScrollingUp) {
                        isCurrentlyScrollingUp = false;
                        chatMessages.classList.remove('scrolling-up');
                    }
                    
                    lastScrollTop = currentScrollTop;
                    
                    // Clear timeout if it exists
                    if (scrollTimeout) {
                        clearTimeout(scrollTimeout);
                    }
                    
                    // Remove class after scrolling stops
                    scrollTimeout = setTimeout(() => {
                        if (distanceFromBottom < 30) {
                            isCurrentlyScrollingUp = false;
                            chatMessages.classList.remove('scrolling-up');
                        }
                    }, 150);
                });
            }
            
            // Enhanced Chat Input Functionality
            const messageInput = document.getElementById('messageInput');
            const sendButton = document.getElementById('sendButton');
            const charCounter = document.getElementById('charCounter');
            const attachFileBtn = document.getElementById('attachFileBtn');
            const fileInput = document.getElementById('fileInput');
            const attachmentPreview = document.getElementById('attachmentPreview');
            const removeAttachment = document.getElementById('removeAttachment');
            const emojiBtn = document.getElementById('emojiBtn');
            const micBtn = document.getElementById('micBtn');
            const codeBtn = document.getElementById('codeBtn');
            
            if (messageInput) {
                // Auto-resize textarea
                messageInput.addEventListener('input', function() {
                    this.style.height = 'auto';
                    this.style.height = Math.min(this.scrollHeight, 120) + 'px';
                    
                    // Update character counter
                    const length = this.value.length;
                    if (charCounter) {
                        charCounter.textContent = length + ' / 2000';
                        charCounter.classList.remove('warning', 'limit');
                        if (length >= 1800) {
                            charCounter.classList.add('warning');
                        }
                        if (length >= 1950) {
                            charCounter.classList.add('limit');
                        }
                    }
                    
                    // Enable/disable send button
                    if (sendButton) {
                        sendButton.disabled = this.value.trim().length === 0;
                    }
                });
                
                // Handle Enter key (Shift+Enter for new line)
                messageInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        if (this.value.trim().length > 0 && sendButton) {
                            sendButton.click();
                        }
                    }
                });
                
                // Initialize send button state
                if (sendButton) {
                    sendButton.disabled = true;
                }
            }
            
            // File attachment functionality
            if (attachFileBtn && fileInput) {
                attachFileBtn.addEventListener('click', function() {
                    fileInput.click();
                });
                
                fileInput.addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    if (file) {
                        // Show attachment preview
                        const fileName = file.name;
                        const fileSize = (file.size / (1024 * 1024)).toFixed(2) + ' MB';
                        
                        if (attachmentPreview) {
                            const attachmentName = document.getElementById('attachmentName');
                            const attachmentSize = document.getElementById('attachmentSize');
                            
                            if (attachmentName) attachmentName.textContent = fileName;
                            if (attachmentSize) attachmentSize.textContent = fileSize;
                            
                            attachmentPreview.classList.add('active');
                            attachFileBtn.classList.add('active');
                        }
                    }
                });
            }
            
            // Remove attachment
            if (removeAttachment && fileInput && attachmentPreview) {
                removeAttachment.addEventListener('click', function() {
                    fileInput.value = '';
                    attachmentPreview.classList.remove('active');
                    if (attachFileBtn) {
                        attachFileBtn.classList.remove('active');
                    }
                });
            }
            
            // Emoji button (placeholder for future emoji picker)
            if (emojiBtn) {
                emojiBtn.addEventListener('click', function() {
                    // Toggle active state
                    this.classList.toggle('active');
                    // TODO: Implement emoji picker
                    console.log('Emoji picker coming soon!');
                });
            }
            
            // Microphone button (placeholder for voice recording)
            if (micBtn) {
                micBtn.addEventListener('click', function() {
                    // Toggle active state
                    this.classList.toggle('active');
                    // TODO: Implement voice recording
                    console.log('Voice recording coming soon!');
                });
            }
            
            // Code button (insert code block)
            if (codeBtn && messageInput) {
                codeBtn.addEventListener('click', function() {
                    const cursorPos = messageInput.selectionStart;
                    const textBefore = messageInput.value.substring(0, cursorPos);
                    const textAfter = messageInput.value.substring(cursorPos);
                    
                    messageInput.value = textBefore + '```\n\n```' + textAfter;
                    messageInput.focus();
                    messageInput.selectionStart = messageInput.selectionEnd = cursorPos + 4;
                    
                    // Trigger input event to update character counter
                    messageInput.dispatchEvent(new Event('input'));
                });
            }
            
            // Initialize Timer
        let timerInterval = null;
        let timerSeconds = 0;
        let isRunning = false;
        let timerStartTime = null; // Track when timer started
        
        const timerDisplay = document.getElementById('timerDisplay');
        const timerStartBtn = document.getElementById('timerStartBtn');
        const timerStopBtn = document.getElementById('timerStopBtn');
        const timerResetBtn = document.getElementById('timerResetBtn');
        const timerCard = document.getElementById('timerCard');
        
        // Restore timer state from localStorage
        function restoreTimerState() {
            const savedTimerState = localStorage.getItem('timerState');
            if (savedTimerState) {
                try {
                    const state = JSON.parse(savedTimerState);
                    timerSeconds = state.seconds || 0;
                    
                    if (state.isRunning && state.startTime) {
                        // Calculate elapsed time since page was left
                        const now = Date.now();
                        const elapsedSinceStart = Math.floor((now - state.startTime) / 1000);
                        timerSeconds = state.secondsAtStart + elapsedSinceStart;
                        
                        // Restart the timer
                        isRunning = true;
                        if (timerStartBtn) timerStartBtn.style.display = 'none';
                        if (timerStopBtn) timerStopBtn.style.display = 'flex';
                        timerStartTime = state.startTime;
                        
                        timerInterval = setInterval(() => {
                            timerSeconds++;
                            updateTimerDisplay();
                            saveTimerState();
                        }, 1000);
                    }
                    
                    updateTimerDisplay();
                } catch (e) {
                    console.error('Error restoring timer state:', e);
                }
            }
        }
        
        // Save timer state to localStorage
        function saveTimerState() {
            const state = {
                seconds: timerSeconds,
                isRunning: isRunning,
                startTime: timerStartTime,
                secondsAtStart: isRunning ? (timerSeconds - Math.floor((Date.now() - timerStartTime) / 1000)) : timerSeconds
            };
            localStorage.setItem('timerState', JSON.stringify(state));
        }
        
        // Add hover effects to timer buttons
        const timerButtons = document.querySelectorAll('.timer-btn');
        timerButtons.forEach(btn => {
            const isStartBtn = btn.classList.contains('timer-start-btn');
            
            btn.addEventListener('mouseenter', function() {
                this.style.transform = 'scale(1.05)';
                if (isStartBtn) {
                    this.style.background = '#6d2932';
                } else {
                    this.style.filter = 'brightness(1.1)';
                }
            });
            btn.addEventListener('mouseleave', function() {
                this.style.transform = 'scale(1)';
                if (isStartBtn) {
                    this.style.background = '#c7b7a3';
                } else {
                    this.style.filter = 'brightness(1)';
                }
            });
        });
        
        function updateTimerDisplay() {
            const hours = Math.floor(timerSeconds / 3600);
            const minutes = Math.floor((timerSeconds % 3600) / 60);
            const seconds = timerSeconds % 60;
            
            if (timerDisplay) {
                // Update floating timer to match billing page format
                timerDisplay.textContent = 
                    String(hours).padStart(2, '0') + ':' + 
                    String(minutes).padStart(2, '0') + ':' + 
                    String(seconds).padStart(2, '0');
            }
        }
        
        function startTimer() {
            if (!isRunning) {
                isRunning = true;
                timerStartTime = Date.now();
                if (timerStartBtn) timerStartBtn.style.display = 'none';
                if (timerStopBtn) timerStopBtn.style.display = 'flex';
                
                saveTimerState();
                
                timerInterval = setInterval(() => {
                    timerSeconds++;
                    updateTimerDisplay();
                    saveTimerState();
                }, 1000);
            }
        }
        
        function stopTimer() {
            if (isRunning) {
                isRunning = false;
                timerStartTime = null;
                clearInterval(timerInterval);
                if (timerStartBtn) timerStartBtn.style.display = 'flex';
                if (timerStopBtn) timerStopBtn.style.display = 'none';
                saveTimerState();
            }
        }
        
        function resetTimer() {
            stopTimer();
            timerSeconds = 0;
            timerStartTime = null;
            updateTimerDisplay();
            if (timerCard) timerCard.style.boxShadow = '0 2px 12px rgba(0, 0, 0, 0.35)';
            saveTimerState();
        }
        
        // Session Manager Integration for Billing Page - MUST BE BEFORE restoreTimerState()
        const isBillingPage = window.location.pathname.includes('/Billing');
        const sessionManagerCard = document.getElementById('sessionManagerCard');
        const sessionTimerDisplay = document.getElementById('sessionTimerDisplay');
        const sessionStartBtn = document.getElementById('sessionStartBtn');
        const sessionStopBtn = document.getElementById('sessionStopBtn');
        const sessionResetBtn = document.getElementById('sessionResetBtn');
        
        // Set up billing page timer sync BEFORE restoring timer state
        if (isBillingPage && sessionManagerCard && sessionTimerDisplay) {
            // Hide the floating timer on Billing page
            const floatingTimerEl = document.getElementById('floatingTimerOverlay');
            if (floatingTimerEl) {
                floatingTimerEl.style.display = 'none';
            }
            
            // Function to sync timer display to session manager
            function syncSessionTimer() {
                const hours = Math.floor(timerSeconds / 3600);
                const minutes = Math.floor((timerSeconds % 3600) / 60);
                const seconds = timerSeconds % 60;
                
                // Update the session timer display with formatted time
                sessionTimerDisplay.textContent = 
                    String(hours).padStart(2, '0') + ':' + 
                    String(minutes).padStart(2, '0') + ':' + 
                    String(seconds).padStart(2, '0');
            }
            
            // Override updateTimerDisplay to also update session manager
            const originalUpdateTimerDisplay = updateTimerDisplay;
            updateTimerDisplay = function() {
                originalUpdateTimerDisplay();
                syncSessionTimer();
            };
            
            // Override startTimer to also update session buttons
            const originalStartTimer = startTimer;
            startTimer = function() {
                originalStartTimer();
                if (sessionStartBtn) sessionStartBtn.style.display = 'none';
                if (sessionStopBtn) sessionStopBtn.style.display = 'flex';
            };
            
            // Override stopTimer to also update session buttons
            const originalStopTimer = stopTimer;
            stopTimer = function() {
                originalStopTimer();
                if (sessionStartBtn) sessionStartBtn.style.display = 'flex';
                if (sessionStopBtn) sessionStopBtn.style.display = 'none';
            };
            
            // Override resetTimer to also reset session manager
            const originalResetTimer = resetTimer;
            resetTimer = function() {
                originalStopTimer();
                timerSeconds = 0;
                timerStartTime = null;
                updateTimerDisplay();
                syncSessionTimer();
                saveTimerState();
                if (timerCard) timerCard.style.boxShadow = '0 2px 12px rgba(0, 0, 0, 0.35)';
            };
            
            // Connect session buttons to timer functions
            if (sessionStartBtn) {
                sessionStartBtn.addEventListener('click', startTimer);
            }
            if (sessionStopBtn) {
                sessionStopBtn.addEventListener('click', stopTimer);
            }
            if (sessionResetBtn) {
                sessionResetBtn.addEventListener('click', resetTimer);
            }
            
            // Initialize collapsible section for Recent Sessions
            const collapsibleSections = sessionManagerCard.querySelectorAll('.collapsible-section');
            collapsibleSections.forEach(section => {
                const header = section.querySelector('.collapsible-header');
                const content = section.querySelector('.session-section-content');
                
                if (!header || !content) return;
                
                function expandSection() {
                    section.classList.add('expanded');
                    section.classList.remove('hover-disabled');
                    content.style.display = 'block';
                    const icon = header.querySelector('.collapse-icon');
                    if (icon) icon.style.transform = 'rotate(180deg)';
                }
                
                function collapseSection() {
                    section.classList.remove('expanded');
                    section.classList.add('hover-disabled');
                    content.style.display = 'none';
                    const icon = header.querySelector('.collapse-icon');
                    if (icon) icon.style.transform = 'rotate(0deg)';
                }
                
                // Click to toggle
                header.onclick = function() {
                    if (section.classList.contains('expanded')) {
                        collapseSection();
                    } else {
                        expandSection();
                    }
                };
                
                // Hover behavior
                let hoverTimeout;
                section.onmouseenter = function() {
