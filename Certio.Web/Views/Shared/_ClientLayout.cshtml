<!-- New Conversation Modal -->
<div class="modal fade" id="newConversationModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Start New Conversation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" id="createConversationForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input type="text" class="form-control" id="title" name="title" required>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea class="form-control" id="description" name="description" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Start Conversation</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- AI Clarity Modal -->
<div class="modal fade" id="clarityModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-question-circle"></i> Legal Language Clarity</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="clarityText" class="form-label">Text to Explain</label>
                    <textarea class="form-control" id="clarityText" rows="4" placeholder="Paste legal text or complex language here..."></textarea>
                </div>
                <div id="clarityResult" style="display: none;">
                    <h6>Simplified Explanation:</h6>
                    <div class="alert alert-info" id="clarityExplanation"></div>
                    <h6>Key Terms:</h6>
                    <div id="clarityKeyTerms"></div>
                    <h6>Implications:</h6>
                    <div id="clarityImplications"></div>
                    <h6>Risk Level:</h6>
                    <span id="clarityRiskLevel" class="badge"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="requestClarity">Get Clarity</button>
            </div>
        </div>
    </div>
</div>

<!-- AI Suggestions Modal -->
<div class="modal fade" id="suggestionsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-lightbulb"></i> AI Reply Suggestions</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="suggestionsContent">
                    <div class="text-center">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading suggestions...</span>
                        </div>
                        <p>AI is analyzing the conversation and generating suggestions...</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success" id="useSuggestion" style="display: none;">Use This Suggestion</button>
            </div>
        </div>
    </div>
</div>

<script src="~/js/signalr/dist/browser/signalr.js"></script>
<script src="~/js/chat.js"></script>

<script>
    // Initialize conversations on all pages
    document.addEventListener('DOMContentLoaded', function() {
        // Load conversations for the global chat panel
        loadConversationsForPanel();
        
        // Initialize simple sidebar toggle
        const toggleBtn = document.getElementById('toggleSidebar');
        if (toggleBtn) {
            toggleBtn.addEventListener('click', function() {
                document.body.classList.toggle('sidebar-hidden');
                
                // Save state to localStorage
                const isHidden = document.body.classList.contains('sidebar-hidden');
                localStorage.setItem('sidebarHidden', isHidden);
            });
            
            // Restore saved state
            if (localStorage.getItem('sidebarHidden') === 'true') {
                document.body.classList.add('sidebar-hidden');
            }
        }
    });
</script>

@await RenderSectionAsync("Scripts", required: false)