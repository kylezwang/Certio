        // Make timer draggable
        if (floatingTimerOverlay) {
            let isDragging = false;
            let currentX;
            let currentY;
            let initialX;
            let initialY;
            let xOffset = 0;
            let yOffset = 0;
            
            // Restore saved position from localStorage or convert initial bottom/left to top/left
            const savedPosition = localStorage.getItem('timerPosition');
            if (savedPosition) {
                const position = JSON.parse(savedPosition);
                xOffset = position.xOffset;
                yOffset = position.yOffset;
                
                // Clear ALL positioning properties first to avoid conflicts
                floatingTimerOverlay.style.bottom = '';
                floatingTimerOverlay.style.right = '';
                floatingTimerOverlay.style.transform = '';
                
                // Apply saved position
                floatingTimerOverlay.style.left = position.left;
                floatingTimerOverlay.style.top = position.top;
            } else {
                // Convert initial bottom/center positioning to top/left
                const rect = floatingTimerOverlay.getBoundingClientRect();
                xOffset = rect.left;
                yOffset = rect.top;
                
                floatingTimerOverlay.style.bottom = '';
                floatingTimerOverlay.style.right = '';
                floatingTimerOverlay.style.transform = ''; // Clear transform
                floatingTimerOverlay.style.left = xOffset + 'px';
                floatingTimerOverlay.style.top = yOffset + 'px';
            }
            
            // Mouse/Touch event handlers
            floatingTimerOverlay.addEventListener('mousedown', dragStart);
            floatingTimerOverlay.addEventListener('touchstart', dragStart);
            document.addEventListener('mousemove', drag);
            document.addEventListener('touchmove', drag);
            document.addEventListener('mouseup', dragEnd);
            document.addEventListener('touchend', dragEnd);
            
            function dragStart(e) {
                // Don't drag when clicking on buttons
                if (e.target.tagName === 'BUTTON' || e.target.tagName === 'I') {
                    return;
                }
                
                if (e.type === 'touchstart') {
                    initialX = e.touches[0].clientX - xOffset;
                    initialY = e.touches[0].clientY - yOffset;
                } else {
                    initialX = e.clientX - xOffset;
                    initialY = e.clientY - yOffset;
                }
                
                isDragging = true;
                floatingTimerOverlay.style.transition = 'none';
                
                // Clear right/bottom positioning when starting drag to prevent conflicts
                floatingTimerOverlay.style.right = '';
                floatingTimerOverlay.style.bottom = '';
            }
            
            function drag(e) {
                if (isDragging) {
                    e.preventDefault();
                    
                    if (e.type === 'touchmove') {
                        currentX = e.touches[0].clientX - initialX;
                        currentY = e.touches[0].clientY - initialY;
                    } else {
                        currentX = e.clientX - initialX;
                        currentY = e.clientY - initialY;
                    }
                    
                    xOffset = currentX;
                    yOffset = currentY;
                    
                    // Get viewport dimensions
                    const viewportWidth = window.innerWidth;
                    const viewportHeight = window.innerHeight;
                    const timerWidth = floatingTimerOverlay.offsetWidth;
                    const timerHeight = floatingTimerOverlay.offsetHeight;
                    
                    // Constrain to viewport bounds
                    let newLeft = currentX;
                    let newTop = currentY;
                    
                    // Keep within viewport
                    if (newLeft < 0) newLeft = 0;
                    if (newTop < 0) newTop = 0;
                    if (newLeft + timerWidth > viewportWidth) newLeft = viewportWidth - timerWidth;
                    if (newTop + timerHeight > viewportHeight) newTop = viewportHeight - timerHeight;
                    
                    // Update position
                    floatingTimerOverlay.style.left = newLeft + 'px';
                    floatingTimerOverlay.style.top = newTop + 'px';
                    floatingTimerOverlay.style.bottom = 'auto';
                    floatingTimerOverlay.style.right = 'auto';
                    
                    // Update offsets to match constrained position
                    xOffset = newLeft;
                    yOffset = newTop;
                }
            }
            
            function dragEnd(e) {
                if (isDragging) {
                    isDragging = false;
                    
                    // Save position to localStorage
                    const position = {
                        left: floatingTimerOverlay.style.left,
                        top: floatingTimerOverlay.style.top,
                        xOffset: xOffset,
                        yOffset: yOffset
                    };
                    localStorage.setItem('timerPosition', JSON.stringify(position));
                }
            }
        }
        
