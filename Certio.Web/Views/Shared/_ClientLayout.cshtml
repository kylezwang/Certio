@* Only load AI chat scripts if chat panel is not hidden *@
@if (ViewData["HideChatPanel"] as bool? != true)
{
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js" defer></script>
<script src="~/js/chat.js" defer></script>

<script>
        // Initialize conversations on all pages
        document.addEventListener('DOMContentLoaded', function() {
            
            // Profile dropdown functionality
            const userProfileAvatar = document.getElementById('userProfileAvatar');
            const profileDropdown = document.getElementById('profileDropdown');
            
            if (userProfileAvatar && profileDropdown) {
                // Toggle dropdown when clicking avatar
                userProfileAvatar.addEventListener('click', function(e) {
                    e.stopPropagation();
                    profileDropdown.classList.toggle('show');
                });
                
                // Close dropdown when clicking outside
                document.addEventListener('click', function(e) {
                    if (!userProfileAvatar.contains(e.target)) {
                        profileDropdown.classList.remove('show');
                    }
                });
                
                // Close dropdown when clicking a menu item
                const dropdownItems = profileDropdown.querySelectorAll('.profile-dropdown-item');
                dropdownItems.forEach(item => {
                    item.addEventListener('click', function() {
                        profileDropdown.classList.remove('show');
                    });
                });
            }
            
            // Initialize Timer
        let timerInterval = null;
        let timerSeconds = 0;
        let isRunning = false;
        
        const timerDisplay = document.getElementById('timerDisplay');
        const timerStartBtn = document.getElementById('timerStartBtn');
        const timerStopBtn = document.getElementById('timerStopBtn');
        const timerResetBtn = document.getElementById('timerResetBtn');
        const timerCard = document.getElementById('timerCard');
        
        // Add hover effects to timer buttons
        const timerButtons = document.querySelectorAll('.timer-btn');
        timerButtons.forEach(btn => {
            const isStartBtn = btn.classList.contains('timer-start-btn');
            
            btn.addEventListener('mouseenter', function() {
                this.style.transform = 'scale(1.05)';
                if (isStartBtn) {
                    this.style.background = '#6d2932';
                } else {
                    this.style.filter = 'brightness(1.1)';
                }
            });
            btn.addEventListener('mouseleave', function() {
                this.style.transform = 'scale(1)';
                if (isStartBtn) {
                    this.style.background = '#c7b7a3';
                } else {
                    this.style.filter = 'brightness(1)';
                }
            });
        });
        
        function updateTimerDisplay() {
            const hours = Math.floor(timerSeconds / 3600);
            const minutes = Math.floor((timerSeconds % 3600) / 60);
            const seconds = timerSeconds % 60;
            
            timerDisplay.textContent = 
                String(hours).padStart(2, '0') + ' : ' + 
                String(minutes).padStart(2, '0') + ' : ' + 
                String(seconds).padStart(2, '0');
        }
        
        function startTimer() {
            if (!isRunning) {
                isRunning = true;
                timerStartBtn.style.display = 'none';
                timerStopBtn.style.display = 'flex';
                
                timerInterval = setInterval(() => {
                    timerSeconds++;
                    updateTimerDisplay();
                }, 1000);
            }
        }
        
        function stopTimer() {
            if (isRunning) {
                isRunning = false;
                clearInterval(timerInterval);
                timerStartBtn.style.display = 'flex';
                timerStopBtn.style.display = 'none';
            }
        }
        
        function resetTimer() {
            stopTimer();
            timerSeconds = 0;
            updateTimerDisplay();
            timerCard.style.boxShadow = '0 4px 12px rgba(0, 0, 0, 0.1)';
        }
        
        if (timerStartBtn) timerStartBtn.addEventListener('click', startTimer);
        if (timerStopBtn) timerStopBtn.addEventListener('click', stopTimer);
        if (timerResetBtn) timerResetBtn.addEventListener('click', resetTimer);
        
        // Initialize simple sidebar toggle
        const toggleBtn = document.getElementById('toggleSidebar');
        if (toggleBtn) {
            toggleBtn.addEventListener('click', function() {
                document.body.classList.toggle('sidebar-hidden');
                
                // Save state to localStorage only if manually toggled
                const isHidden = document.body.classList.contains('sidebar-hidden');
                localStorage.setItem('sidebarHidden', isHidden);
                localStorage.setItem('sidebarHiddenManual', 'true');
            });
            
            // Restore saved state only if it was manually toggled
            const wasManuallyHidden = localStorage.getItem('sidebarHiddenManual') === 'true';
            if (wasManuallyHidden && localStorage.getItem('sidebarHidden') === 'true') {
                document.body.classList.add('sidebar-hidden');
            }
        }
        
        // AI Chat and Communications Sidebar Toggle
        const aiToggle = document.getElementById('aiToggle');
        const communicationsBtn = document.getElementById('communicationsBtn');
        const chatPanel = document.getElementById('chatPanel');
        const commsSidebarPanel = document.getElementById('commsSidebarPanel');
        
        // Function to show AI chat panel
        function showAIChatPanel() {
            // Show AI chat panel
            document.body.classList.remove('chat-hidden');
            document.body.classList.remove('no-sidebars');
            
            // Hide communications panel
            if (commsSidebarPanel) {
                commsSidebarPanel.style.display = 'none';
            }
            
            // Restore resize handle and sizing for AI chat
            const savedWidth = localStorage.getItem('chatPanelWidth') || '320';
            const chatPanel = document.getElementById('chatPanel');
            const resizeHandle = document.getElementById('resizeHandle');
            const mainContentWrapper = document.querySelector('.client-main-content-wrapper');
            const pageHeader = document.querySelector('.page-header');
            
            if (chatPanel) {
                chatPanel.style.width = savedWidth + 'px';
            }
            
            if (resizeHandle) {
                resizeHandle.style.right = savedWidth + 'px';
                resizeHandle.style.display = 'block';
                resizeHandle.style.zIndex = '999'; // Ensure it's on top of everything
            }
            
            if (mainContentWrapper) {
                mainContentWrapper.style.right = savedWidth + 'px';
            }
            
            // Update button states
            if (aiToggle) {
                aiToggle.classList.add('active');
            }
            if (communicationsBtn) {
                communicationsBtn.classList.remove('active');
            }
            
            // Update resize handle target
            window.currentSidebarTarget = 'ai';
            
            localStorage.setItem('activeSidebar', 'ai');
        }
        
        // Function to show communications sidebar
        function showCommsSidebar() {
            // Hide AI chat panel
            document.body.classList.add('chat-hidden');
            document.body.classList.remove('no-sidebars');
            
            // Show communications panel
            if (commsSidebarPanel) {
                commsSidebarPanel.style.display = 'flex';
                
                // Apply saved width to communications panel
                const savedWidth = localStorage.getItem('chatPanelWidth') || '320';
                commsSidebarPanel.style.width = savedWidth + 'px';
                
                // Position resize handle for communications panel
                const resizeHandle = document.getElementById('resizeHandle');
                if (resizeHandle) {
                    resizeHandle.style.right = savedWidth + 'px';
                    resizeHandle.style.display = 'block';
                    resizeHandle.style.zIndex = '999'; // Ensure it's on top of everything
                }
                
                // Adjust main content wrapper to make space for sidebar
                const mainContentWrapper = document.querySelector('.client-main-content-wrapper');
                if (mainContentWrapper) {
                    mainContentWrapper.style.right = savedWidth + 'px';
                }
                
                // Load channels if not already loaded
                if (typeof window.commsSidebar !== 'undefined') {
                    window.commsSidebar.open();
                }
            }
            
            // Update button states
            if (communicationsBtn) {
                communicationsBtn.classList.add('active');
            }
            if (aiToggle) {
                aiToggle.classList.remove('active');
            }
            
            // Update resize handle target
            window.currentSidebarTarget = 'comms';
            
            localStorage.setItem('activeSidebar', 'comms');
        }
        
        // Function to hide both sidebars
        function hideBothSidebars() {
            document.body.classList.add('chat-hidden');
            document.body.classList.add('no-sidebars');
            
            if (commsSidebarPanel) {
                commsSidebarPanel.style.display = 'none';
            }
            
            // Hide resize handle
            const resizeHandle = document.getElementById('resizeHandle');
            if (resizeHandle) {
                resizeHandle.style.display = 'none';
            }
            
            // Reset main content wrapper to expand
            const mainContentWrapper = document.querySelector('.client-main-content-wrapper');
            if (mainContentWrapper) {
                mainContentWrapper.style.right = '1rem';
            }
            
            if (aiToggle) {
                aiToggle.classList.remove('active');
            }
            if (communicationsBtn) {
                communicationsBtn.classList.remove('active');
            }
            
            window.currentSidebarTarget = 'none';
            localStorage.setItem('activeSidebar', 'none');
        }
        
        // Initialize communications sidebar on page load
        if (typeof initializeCommsSidebar === 'function') {
            initializeCommsSidebar();
        }
        
        // Check for saved sidebar preference
        const activeSidebar = localStorage.getItem('activeSidebar') || 'ai';
        if (activeSidebar === 'ai') {
            showAIChatPanel();
        } else if (activeSidebar === 'comms') {
            showCommsSidebar();
        } else {
            hideBothSidebars();
        }
        
        // AI Toggle button - toggle between AI chat and hidden
        if (aiToggle) {
            aiToggle.addEventListener('click', function() {
                const currentActive = localStorage.getItem('activeSidebar');
                if (currentActive === 'ai') {
                    hideBothSidebars();
                } else {
                    showAIChatPanel();
                }
            });
        }
        
        // Communications button - toggle between communications and hidden
        if (communicationsBtn) {
            communicationsBtn.addEventListener('click', function() {
                const currentActive = localStorage.getItem('activeSidebar');
                if (currentActive === 'comms') {
                    hideBothSidebars();
                } else {
                    showCommsSidebar();
                }
            });
        }
        
        // Make functions available globally
        window.showAIChatPanel = showAIChatPanel;
        window.showCommsSidebar = showCommsSidebar;
        window.hideBothSidebars = hideBothSidebars;
        
        // Notifications Toggle
        const notificationsBtn = document.getElementById('notificationsBtn');
        if (notificationsBtn) {
            // Check for saved notifications preference or default to visible
            const isNotificationsHidden = localStorage.getItem('notificationsHidden') === 'true';
            if (isNotificationsHidden) {
                const icon = notificationsBtn.querySelector('i');
                icon.classList.remove('fa-bell');
                icon.classList.add('fa-bell-slash');
                notificationsBtn.title = 'Hide Notifications';
            }
            
            notificationsBtn.addEventListener('click', function() {
                const icon = this.querySelector('i');
                const isHidden = icon.classList.contains('fa-bell-slash');
                
                if (isHidden) {
                    // Show notifications
                    icon.classList.remove('fa-bell-slash');
                    icon.classList.add('fa-bell');
                    this.title = 'Show Notifications';
                    localStorage.setItem('notificationsHidden', 'false');
                } else {
                    // Hide notifications
                    icon.classList.remove('fa-bell');
                    icon.classList.add('fa-bell-slash');
                    this.title = 'Hide Notifications';
                    localStorage.setItem('notificationsHidden', 'true');
                }
            });
        }
        
        // Dark Mode Toggle
        const darkModeToggle = document.getElementById('darkModeToggle');
        const darkModeIcon = document.getElementById('darkModeIcon');
        
        // Always show moon icon
        if (darkModeIcon) {
            darkModeIcon.classList.remove('fa-sun');
            if (!darkModeIcon.classList.contains('fa-moon')) {
                darkModeIcon.classList.add('fa-moon');
            }
        }
        
        // Check for saved dark mode preference or default to light mode
        const isDarkMode = localStorage.getItem('darkMode') === 'true';
        if (isDarkMode) {
            document.body.classList.add('dark-mode');
        }
        
        // Toggle dark mode
        if (darkModeToggle) {
            darkModeToggle.addEventListener('click', function() {
                document.body.classList.toggle('dark-mode');
                localStorage.setItem('darkMode', document.body.classList.contains('dark-mode') ? 'true' : 'false');
            });
        }

        // Communications page check - if on communications page, hide the floating toggle button
        const currentAction = '@ViewContext.RouteData.Values["action"]?.ToString()';
        if (currentAction === 'Communications') {
            const commsToggleBtn = document.getElementById('commsToggleBtn');
            if (commsToggleBtn) {
                commsToggleBtn.style.display = 'none';
            }
            if (commsSidebarPanel) {
                commsSidebarPanel.style.display = 'none';
            }
        }

        // Calendar day selection for global dashboard sidebar
        const calendarDays = document.querySelectorAll('.global-dashboard-sidebar .calendar-day');
        if (calendarDays && calendarDays.length > 0) {
            function clearSelected() {
                document.querySelectorAll('.global-dashboard-sidebar .calendar-day.selected').forEach(function (el) {
                    el.classList.remove('selected');
                });
                // When a selection is made, remove the automatic "today" highlight
                document.querySelectorAll('.global-dashboard-sidebar .calendar-day.today').forEach(function (el) {
                    el.classList.remove('today');
                });
            }

            function selectSidebarDayByNumber(dayNumber) {
                const candidates = Array.from(document.querySelectorAll('.global-dashboard-sidebar .calendar-day'));
                const target = candidates.find(el => (el.textContent || '').trim() === String(dayNumber));
                if (target) {
                    clearSelected();
                    target.classList.add('selected');
                }
            }

            calendarDays.forEach(function (dayEl) {
                dayEl.addEventListener('click', function () {
                    clearSelected();
                    this.classList.add('selected');
                    const dayText = (this.textContent || '').trim();
                    const dayNum = parseInt(dayText, 10);
                    // Broadcast to other calendars (main content)
                    window.dispatchEvent(new CustomEvent('calendarDaySelected', { detail: { day: dayNum } }));
                    // Optional: Navigate/update main view as needed
                });
            });

            // Listen for external selection events (from main-content calendar)
            window.addEventListener('calendarDaySelected', function (e) {
                if (!e || !e.detail || !e.detail.day) return;
                selectSidebarDayByNumber(e.detail.day);
            });
        }
    });
</script>
} @* End if HideChatPanel for scripts *@

@await RenderSectionAsync("Scripts", required: false)