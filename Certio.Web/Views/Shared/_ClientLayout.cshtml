                        </div>
                    </div>
                    <!-- Menu Items -->
                    <div class="profile-dropdown-menu">
                        <a href="/Client/@ViewBag.OrganizationId/AccountSettings#account" class="profile-dropdown-item">
                            <i class="fas fa-user"></i>
                            <span>Account</span>
                        </a>
                        <a href="/Client/@ViewBag.OrganizationId/AccountSettings#security" class="profile-dropdown-item">
                            <i class="fas fa-shield-halved"></i>
                            <span>Security</span>
                        </a>
                        <a href="/Client/@ViewBag.OrganizationId/AccountSettings#notifications" class="profile-dropdown-item">
