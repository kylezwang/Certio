@{
    Layout = null;
    var success = ViewData["success"] as bool? ?? false;
    var provider = ViewData["Provider"] as string ?? "External Provider";
    var connectedAccount = ViewData["Email"] as string;
    var error = ViewData["error"] as string;
    var errorDescription = ViewData["errorDescription"] as string;
    var orgId = ViewData["orgId"] as int?;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Calendar Connection</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            background: url('/images/Notal_Video_Background.png') center center / cover no-repeat;
            padding: 20px;
        }
        .container {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 12px;
            padding: 40px;
            max-width: 420px;
            width: 100%;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
            text-align: center;
        }
        .icon {
            font-size: 64px;
            margin-bottom: 20px;
        }
        .success .icon {
            color: #10b981;
        }
        .error .icon {
            color: #ef4444;
        }
        h1 {
            margin: 0 0 12px 0;
            font-size: 26px;
            color: #1f2937;
        }
        p {
            margin: 10px 0;
            color: #6b7280;
            font-size: 14px;
        }
        .message {
            margin-top: 18px;
            padding: 12px;
            border-radius: 6px;
            font-size: 13px;
        }
        .success .message {
            background: #d1fae5;
            color: #065f46;
        }
        .error .message {
            background: #fee2e2;
            color: #991b1b;
        }
    </style>
</head>
<body>
    <div class="container @(success ? "success" : "error")">
        @if (success)
        {
            <div class="icon">✓</div>
            <h1>Integration Connected</h1>
            <p>Your @provider connection is ready for calendar synchronization.</p>
            @if (!string.IsNullOrWhiteSpace(connectedAccount))
            {
                <div class="message">
                    <strong>@connectedAccount</strong>
                </div>
            }
            <p style="margin-top: 18px; font-size: 12px; color: #9ca3af;">Please close this window and refresh the page.</p>
        }
        else
        {
            <div class="icon">✗</div>
            <h1>Connection Failed</h1>
            <p>We couldn't connect @provider.</p>
            @if (!string.IsNullOrWhiteSpace(errorDescription))
            {
                <div class="message">
                    @errorDescription
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="message">
                    Error: @error
                </div>
            }
            <p style="margin-top: 18px; font-size: 12px; color: #9ca3af;">You can close this window and try again.</p>
        }
    </div>

    <script>
        (function () {
            const payload = {
                type: @(success ? "'calendar-oauth-success'" : "'calendar-oauth-error'"),
                provider: '@Html.Raw(provider)',
                success: @Json.Serialize(success),
                error: @Html.Raw(error != null ? Json.Serialize(error) : "null"),
                errorDescription: @Html.Raw(errorDescription != null ? Json.Serialize(errorDescription) : "null"),
                orgId: @Html.Raw(orgId.HasValue ? Json.Serialize(orgId.Value.ToString()) : "null")
            };

            if (window.opener) {
                window.opener.postMessage(payload, window.location.origin);
                setTimeout(() => {
                    window.close();
                    // If window.close() is blocked, at least hide the content
                    if (!window.closed) {
                        document.body.style.display = 'none';
                    }
                }, @(success ? "2000" : "3000"));
            } else {
                // Fallback if no opener
                setTimeout(() => window.close(), @(success ? "2000" : "3000"));
            }
        })();
    </script>
</body>
</html>

