<!-- Calendar Event Details Modal -->
<div class="task-details-modal" id="calendarEventModal" style="display: none; border-radius: 12px;">
    

    <div class="modal-dialog" style="margin-top: 3rem; margin-bottom: 1.5rem;">
        <div class="task-details-content">
            <!-- Matter Selector Header (positioned above modal) -->
            <div class="event-modal-matter-header">
                <div class="event-matter-selector-container">
                    <button class="event-matter-selector-btn" id="eventMatterSelectorBtn">
                        <i class="fas fa-folder"></i>
                        <span class="event-matter-selector-text" id="eventMatterSelectorText">Select a Matter</span>
                        <i class="fas fa-chevron-down event-matter-selector-arrow"></i>
                    </button>
                </div>
            </div>

            <!-- Modal Header -->
            <div class="task-details-header">
                <div class="task-details-header-left">
                </div>
                <div class="task-details-header-middle">
                </div>
                <div class="task-details-header-right">
                    <button class="btn btn-sm btn-link task-header-btn" id="headerNotifyBtn" title="Notifications">
                        <i class="fas fa-bell"></i>
                    </button>
                    <button class="btn btn-sm btn-link task-header-btn" id="headerDeleteBtn" title="Delete Event" style="display: none;">
                        <i class="fas fa-trash text-danger"></i>
                    </button>
                    <button class="btn btn-sm btn-link task-header-btn">
                        <i class="fas fa-ellipsis-h"></i>
                    </button>
                <button type="button" class="btn-close" id="closeEventModal" aria-label="Close"></button>
                </div>
            </div>

            <!-- Event Title -->
            <div class="task-details-title-section">
                <div class="task-title-container">
                    <i class="fas fa-calendar task-title-icon" id="eventTitleIcon" style="color: #3d1019;"></i>
                    <h2 class="task-title" contenteditable="true" data-placeholder="Enter event title..." id="eventTitleInput"></h2>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="task-details-body">
                <!-- Left Panel -->
                <div class="task-details-left">
                    <!-- Date & Time Section -->
                    <div class="task-section" id="dates-section" style="padding: 0rem 0.5rem;">
                        <div class="task-section-header">
                            <h6 class="task-section-title">
                                <i class="fa-solid fa-calendar-day"></i> Date & Time
                            </h6>
                        </div>
                        <div class="task-section-content">
                            <!-- All Day Event Checkbox -->
                            <div class="mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="eventAllDayCheck">
                                    <label class="form-check-label fw-semibold" for="eventAllDayCheck" style="font-size: 0.875rem;">
                                        All Day Event
                                    </label>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold status-priority-label" style="font-size: 0.875rem;">
                                        <i class="fa-solid fa-calendar-day me-2" style="color: #3d1019;"></i>
                                        Start
                                    </label>
                                    <input type="datetime-local" class="form-control dates-field" style="font-size: 0.875rem;" id="eventStartInput" required />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold status-priority-label" style="font-size: 0.875rem;">
                                        <i class="fa-solid fa-calendar-day me-2" style="color: #3d1019; transform: scaleX(-1);"></i>
                                        End
                                    </label>
                                    <input type="datetime-local" class="form-control dates-field" style="font-size: 0.875rem;" id="eventEndInput" required />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Attendees -->
                    <div class="task-meta-section" style="padding: 0.5rem 1rem;">
                        <div class="task-members">
                            <span class="task-meta-label"><i class="fa-solid fa-user"></i> Attendees</span>
                            <div class="task-assignees-container" id="eventAttendeesList">
                                <!-- Attendees will be dynamically rendered here -->
                            </div>
                            <button class="btn btn-sm btn-outline-secondary add-member-btn" id="addAttendeeBtn">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Location Section -->
                    <div class="task-section collapsible-section" id="location-section" style="margin-bottom: 0;">
                        <div class="task-section-header collapsible-header" style="cursor: pointer;">
                            <h6 class="task-section-title">
                                <i class="fas fa-map-marker-alt"></i> Location
                            </h6>
                            <i class="fas fa-chevron-down collapse-icon"></i>
                        </div>
                        <div class="task-section-content" style="display: none;">
                            <div class="location-container">
                                <!-- Location Search with Autocomplete -->
                                <div class="location-search">
                                    <div class="search-input-group">
                                        <input type="text" class="form-control location-search-input" 
                                               placeholder="Start typing a location..." 
                                               id="eventLocationSearchInput"
                                               autocomplete="off">
                                        <div class="search-loading-indicator" id="eventSearchLoadingIndicator" style="display: none;">
                                            <i class="fas fa-spinner fa-spin"></i>
                                        </div>
                                    </div>
                                    <!-- Autocomplete Dropdown -->
                                    <div class="autocomplete-dropdown" id="eventAutocompleteDropdown" style="display: none;">
                                        <ul class="autocomplete-list" id="eventAutocompleteList">
                                            <!-- Suggestions will be populated here -->
                                        </ul>
                                    </div>
                                </div>
                                
                                <!-- Selected Location Display -->
                                <div class="location-display" id="eventLocationDisplay" style="display: none;">
                                    <div class="location-info">
                                        <h6 class="location-name" id="eventLocationName"></h6>
                                        <p class="location-address" id="eventLocationAddress"></p>
                                    </div>
                                    <div class="location-actions">
                                        <button class="btn btn-sm btn-link p-0" title="Get directions" id="eventGetDirectionsBtn">
                                            <i class="fas fa-route"></i>
                                        </button>
                                        <button class="btn btn-sm btn-link text-danger p-0" title="Remove location" id="eventRemoveLocationBtn">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                                
                                <!-- Google Maps Container -->
                                <div class="map-container" id="eventMapContainer">
                                    <div class="map-placeholder">
                                        <i class="fas fa-map-marked-alt" style="font-size: 3rem; color: #d1d5db;"></i>
                                        <p class="text-muted mt-2">No location selected</p>
                                        <small class="text-muted">Search for a location to display it on the map</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Description Section -->
                    <div class="task-section collapsible-section">
                        <div class="task-section-header collapsible-header" style="cursor: pointer;">
                            <h6 class="task-section-title">
                                <i class="fas fa-align-left" style="transform: scaleY(-1);"></i> Description
                            </h6>
                            <i class="fas fa-chevron-down collapse-icon"></i>
                        </div>
                        <div class="task-section-content" style="display: none;">
                            <textarea class="form-control task-description-textarea" rows="4" placeholder="Add a description for this event..." style="font-size: 0.875rem;" id="eventDescriptionInput"></textarea>
                        </div>
                    </div>

                    <!-- Event Type & Color Section -->
                    <div class="task-section collapsible-section" id="color-section">
                        <div class="task-section-header collapsible-header" style="cursor: pointer;">
                            <h6 class="task-section-title">
                                <i class="fas fa-palette"></i> Event Type & Color
                            </h6>
                            <i class="fas fa-chevron-down collapse-icon"></i>
                        </div>
                        <div class="task-section-content" style="display: none;">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold status-priority-label" style="font-size: 0.875rem;">
                                        <i class="fas fa-tag me-2" style="color: #3d1019;"></i>
                                        Event Type
                                    </label>
                                    <select class="form-select" style="font-size: 0.875rem;" id="eventTypeField">
                                <option value="Meeting">Meeting</option>
                                <option value="Deadline">Deadline</option>
                                <option value="CourtDate">Court Date</option>
                                <option value="Consultation">Consultation</option>
                                <option value="Conference">Conference</option>
                                <option value="Filing">Filing</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold status-priority-label" style="font-size: 0.875rem;">
                                        <i class="fas fa-palette me-2" style="color: #3d1019;"></i>
                                        Color
                                    </label>
                                    <div class="event-color-picker" id="eventColorPicker">
                                        <div class="color-option" data-color="blue" style="background: #2563eb;" title="Blue"></div>
                                        <div class="color-option" data-color="purple" style="background: #8b5cf6;" title="Purple"></div>
                                        <div class="color-option" data-color="red" style="background: #ef4444;" title="Red"></div>
                                        <div class="color-option" data-color="green" style="background: #10b981;" title="Green"></div>
                                        <div class="color-option" data-color="orange" style="background: #f59e0b;" title="Orange"></div>
                                        <div class="color-option" data-color="gray" style="background: #6b7280;" title="Gray"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Event Details Section -->
                    <div class="task-section collapsible-section">
                        <div class="task-section-header collapsible-header" style="cursor: pointer;">
                            <h6 class="task-section-title">
                                <i class="fas fa-info-circle"></i> Event Details
                            </h6>
                            <i class="fas fa-chevron-down collapse-icon"></i>
                        </div>
                        <div class="task-section-content" style="display: none;">
                            <div class="event-metadata">
                                <div class="metadata-item">
                                    <span class="metadata-label">Created:</span>
                                    <span class="metadata-value" id="eventCreatedDate">--</span>
                    </div>
                                <div class="metadata-item">
                                    <span class="metadata-label">Created by:</span>
                                    <span class="metadata-value" id="eventCreatedBy">--</span>
                    </div>
                                <div class="metadata-item">
                                    <span class="metadata-label">Last modified:</span>
                                    <span class="metadata-value" id="eventModifiedDate">--</span>
                        </div>
                                <div class="metadata-item">
                                    <span class="metadata-label">Modified by:</span>
                                    <span class="metadata-value" id="eventModifiedBy">--</span>
                        </div>
                    </div>
                    </div>
            </div>

                </div>
            </div>

            <!-- Fixed Footer -->
            <div class="event-modal-footer">
                <button class="btn btn-link more-options-btn" id="moreOptionsBtn" type="button">
                    More options
                </button>
                <button class="btn btn-primary save-btn" id="saveEventBtn" type="button">
                    Save
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Matter Selector Popup -->
<div class="event-matter-popup" id="eventMatterPopup" style="display: none;">
    <div class="event-matter-popup-inner">
        <div class="event-matter-popup-title">Select a Matter</div>
        <div class="event-matter-popup-list" id="eventMatterPopupList">
            <!-- "Select a Matter" Option -->
            <button type="button" class="event-matter-item" data-matter-id="" title="Select a Matter">
                <i class="fas fa-folder-open"></i>
                <span class="event-matter-item-text">Select a Matter</span>
            </button>
            <!-- Matters will be populated dynamically -->
        </div>
    </div>
</div>


<style>
