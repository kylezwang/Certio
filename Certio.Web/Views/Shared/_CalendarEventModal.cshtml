    /* Input field styling for event modal only (excluding matter dropdown) */
    #calendarEventModal .task-details-content input[type="text"],
    #calendarEventModal .task-details-content input[type="datetime-local"],
    #calendarEventModal .task-details-content input[type="date"],
    #calendarEventModal .task-details-content textarea.form-control,
