<!-- Calendar Filters Card for Sidebar -->
<div class="card border-0">
    <div class="card-body p-3">
        <h5 class="card-title fw-bold mb-3">Calendar Filters</h5>
        
        <!-- My Calendars Section -->
        <div class="calendar-section mb-3">
            <h6 class="calendar-section-title fw-semibold mb-2">My Calendars</h6>
            <div class="calendar-checkboxes">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" value="" id="userCalendar" checked>
                    <label class="form-check-label" for="userCalendar">
                        <span id="userCalendarName">Loading...</span>
                    </label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" value="" id="primaryOrgCalendar" checked>
                    <label class="form-check-label" for="primaryOrgCalendar">
                        <span id="primaryOrgName">Loading...</span>
                    </label>
                </div>
            </div>
        </div>

        <!-- Client Calendars Section -->
        <div class="calendar-section">
            <h6 class="calendar-section-title fw-semibold mb-2">Client Calendars</h6>
            <div class="calendar-checkboxes" id="clientCalendarsList">
                <!-- Client calendar checkboxes will be populated by JavaScript -->
                <div class="text-muted small">Loading client calendars...</div>
            </div>
        </div>
    </div>
</div>

<style>
    .calendar-section {
        padding: 0.25rem 0;
    }

    .calendar-section-title {
        color: #1f2937;
        font-size: 0.9rem;
        border-bottom: 1px solid #e5e7eb;
        padding-bottom: 0.25rem;
    }

    .calendar-checkboxes {
        padding-left: 0.25rem;
    }

    .calendar-checkboxes .form-check {
        padding-left: 1.5rem;
        margin-bottom: 0.5rem;
    }

    .calendar-checkboxes .form-check-input {
        width: 1.1rem;
        height: 1.1rem;
        margin-top: 0.125rem;
        cursor: pointer;
    }

    .calendar-checkboxes .form-check-label {
        cursor: pointer;
        font-size: 0.85rem;
        color: #374151;
        margin-left: 0.25rem;
    }

    .calendar-checkboxes .form-check-input:checked {
        background-color: #3b82f6;
        border-color: #3b82f6;
    }

    .calendar-checkboxes .form-check-input:focus {
        border-color: #60a5fa;
        box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.25);
    }

    /* Empty state styling */
    .calendar-checkboxes .text-muted {
        padding: 0.25rem 0;
        font-size: 0.8rem;
    }
</style>

<script>
    // Initialize calendar filters when DOM is ready
    (function() {
        if (typeof window.calendarFiltersInitialized !== 'undefined') {
            return; // Already initialized
        }
        window.calendarFiltersInitialized = true;

        document.addEventListener('DOMContentLoaded', async function () {
            // Fetch current user info
            await loadUserCalendarInfo();
            
            // Fetch and populate client calendars
            await loadClientCalendars();
        });

        async function loadUserCalendarInfo() {
            try {
                // Fetch user information
                const response = await fetch('/Client/List', { credentials: 'include' });
                const result = await response.json();
                
                if (result.success && result.organizations) {
                    // Get user's primary organization (LawFirm type)
                    const primaryOrg = result.organizations.find(org => 
                        org.organizationType === 'LawFirm' && org.isPrimary
                    );
                    
                    if (primaryOrg) {
                        // Set primary organization name
                        const primaryOrgNameEl = document.getElementById('primaryOrgName');
                        if (primaryOrgNameEl) {
                            primaryOrgNameEl.textContent = primaryOrg.organizationName;
                        }
                        
                        // Set user name (owner of primary org)
                        const userName = `${primaryOrg.ownerFirstName} ${primaryOrg.ownerLastName}`.trim();
                        if (userName) {
                            const userCalendarNameEl = document.getElementById('userCalendarName');
                            if (userCalendarNameEl) {
                                userCalendarNameEl.textContent = userName;
                            }
                        }
                    } else {
                        // Fallback if no primary org found
                        setDefaultCalendarNames();
                    }
                } else {
                    // Fallback on error
                    setDefaultCalendarNames();
                }
            } catch (error) {
                console.error('Error loading user calendar info:', error);
                // Fallback on error
                setDefaultCalendarNames();
            }
        }

        function setDefaultCalendarNames() {
            const primaryOrgNameEl = document.getElementById('primaryOrgName');
            if (primaryOrgNameEl) {
                primaryOrgNameEl.textContent = 'My Organization';
            }
            const userCalendarNameEl = document.getElementById('userCalendarName');
            if (userCalendarNameEl) {
                userCalendarNameEl.textContent = 'My Calendar';
            }
        }

        async function loadClientCalendars() {
            const clientCalendarsList = document.getElementById('clientCalendarsList');
            if (!clientCalendarsList) return;
            
            clientCalendarsList.innerHTML = '';
            
            try {
                const response = await fetch('/Client/List', { credentials: 'include' });
                const result = await response.json();
                
                if (!result.success) {
                    clientCalendarsList.innerHTML = '<div class="text-muted small">Unable to load client calendars.</div>';
                    return;
                }
                
                // Filter for non-LawFirm organizations (client organizations)
                const clientOrgs = (result.organizations || []).filter(o => o.organizationType !== 'LawFirm');
                
                if (clientOrgs.length === 0) {
                    clientCalendarsList.innerHTML = '<div class="text-muted small">No client calendars available.</div>';
                    return;
                }
                
                // Create checkbox for each client organization
                clientOrgs.forEach((org, index) => {
                    const ownerName = `${org.ownerFirstName} ${org.ownerLastName}`.trim();
                    const displayName = ownerName ? `${ownerName} (${org.organizationName})` : org.organizationName;
                    
                    const checkboxDiv = document.createElement('div');
                    checkboxDiv.className = 'form-check mb-2';
                    checkboxDiv.innerHTML = `
                        <input class="form-check-input client-calendar-checkbox" 
                               type="checkbox" 
                               value="${org.organizationId}" 
                               id="clientCalendar${index}" 
                               checked>
                        <label class="form-check-label" for="clientCalendar${index}">
                            ${displayName}
                        </label>
                    `;
                    clientCalendarsList.appendChild(checkboxDiv);
                });
                
                // Add event listeners for calendar filtering
                setupCalendarFiltering();
            } catch (error) {
                console.error('Error loading client calendars:', error);
                clientCalendarsList.innerHTML = '<div class="text-muted small">Error loading client calendars.</div>';
            }
        }

        function setupCalendarFiltering() {
            // Get all calendar checkboxes
            const userCalendar = document.getElementById('userCalendar');
            const primaryOrgCalendar = document.getElementById('primaryOrgCalendar');
            const clientCalendars = document.querySelectorAll('.client-calendar-checkbox');
            
            // Add change event listeners
            if (userCalendar) {
                userCalendar.addEventListener('change', function() {
                    filterCalendar();
                });
            }
            
            if (primaryOrgCalendar) {
                primaryOrgCalendar.addEventListener('change', function() {
                    filterCalendar();
                });
            }
            
            clientCalendars.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    filterCalendar();
                });
            });
        }

        function filterCalendar() {
            // Get all selected calendars
            const selectedCalendars = [];
            
            const userCalendar = document.getElementById('userCalendar');
            if (userCalendar && userCalendar.checked) {
                selectedCalendars.push('user');
            }
            
            const primaryOrgCalendar = document.getElementById('primaryOrgCalendar');
            if (primaryOrgCalendar && primaryOrgCalendar.checked) {
                selectedCalendars.push('primary-org');
            }
            
            document.querySelectorAll('.client-calendar-checkbox:checked').forEach(checkbox => {
                selectedCalendars.push(checkbox.value);
            });
            
            console.log('Selected calendars:', selectedCalendars);
            
            // Dispatch custom event for calendar filtering
            window.dispatchEvent(new CustomEvent('calendarFiltersChanged', { 
                detail: { selectedCalendars } 
            }));
            
            // TODO: Implement actual calendar filtering logic here
            // This will filter the calendar view based on selected calendars
        }
    })();
</script>

