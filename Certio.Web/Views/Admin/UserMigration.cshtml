@model Certio.Web.Controllers.UserMigrationViewModel
@{
    ViewData["Title"] = "User Migration";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-users-cog me-2"></i>
                        User Migration Dashboard
                    </h3>
                    <p class="text-muted mb-0">Fix broken account states by migrating Identity users to custom User system</p>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["MigrationResult"] != null)
                    {
                        <div class="alert alert-info alert-dismissible fade show" role="alert">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Migration Details:</strong>
                            <pre class="mt-2 mb-0">@TempData["MigrationResult"]</pre>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Status Overview -->
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <div class="card bg-primary text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h4 class="mb-0">@Model.TotalIdentityUsers</h4>
                                            <p class="mb-0">Identity Users</p>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fas fa-user-shield fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-success text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h4 class="mb-0">@Model.TotalCustomUsers</h4>
                                            <p class="mb-0">Custom Users</p>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fas fa-users fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card @(Model.UsersNeedingMigration.Any() ? "bg-warning" : "bg-success") text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h4 class="mb-0">@Model.UsersNeedingMigration.Count</h4>
                                            <p class="mb-0">Need Migration</p>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fas fa-exclamation-triangle fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (Model.MigrationComplete)
                    {
                        <div class="alert alert-success text-center">
                            <i class="fas fa-check-circle fa-3x mb-3"></i>
                            <h4>Migration Complete!</h4>
                            <p class="mb-0">All Identity users have been successfully migrated to the custom User system.</p>
                        </div>
                    }
                    else
                    {
                        <!-- Migration Actions -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5 class="card-title mb-0">
                                            <i class="fas fa-tools me-2"></i>
                                            Migration Actions
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <h6>Bulk Migration</h6>
                                                <p class="text-muted">Migrate all Identity users without custom User records</p>
                                                <form asp-action="MigrateAllUsers" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-primary" 
                                                            onclick="return confirm('Are you sure you want to migrate all users? This action cannot be undone.')">
                                                        <i class="fas fa-download me-2"></i>
                                                        Migrate All Users (@Model.UsersNeedingMigration.Count)
                                                    </button>
                                                </form>
                                            </div>
                                            <div class="col-md-6">
                                                <h6>Individual Migration</h6>
                                                <p class="text-muted">Migrate a specific user by email address</p>
                                                <form asp-action="MigrateUser" method="post" class="d-inline-flex">
                                                    <input type="email" name="email" class="form-control me-2" 
                                                           placeholder="Enter email address" required>
                                                    <button type="submit" class="btn btn-outline-primary">
                                                        <i class="fas fa-user-plus me-2"></i>
                                                        Migrate User
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Users Needing Migration -->
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title mb-0">
                                    <i class="fas fa-list me-2"></i>
                                    Users Needing Migration (@Model.UsersNeedingMigration.Count)
                                </h5>
                            </div>
                            <div class="card-body">
                                @if (Model.UsersNeedingMigration.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-hover">
                                            <thead>
                                                <tr>
                                                    <th>Email</th>
                                                    <th>Username</th>
                                                    <th>Created</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var user in Model.UsersNeedingMigration)
                                                {
                                                    <tr>
                                                        <td>
                                                            <i class="fas fa-envelope me-2"></i>
                                                            @user.Email
                                                        </td>
                                                        <td>@user.UserName</td>
                                                        <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                                        <td>
                                                            <form asp-action="MigrateUser" method="post" class="d-inline">
                                                                <input type="hidden" name="email" value="@user.Email">
                                                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                                                    <i class="fas fa-user-plus me-1"></i>
                                                                    Migrate
                                                                </button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-4">
                                        <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                                        <h5>No users need migration</h5>
                                        <p class="text-muted">All Identity users have corresponding custom User records.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Information Panel -->
                    <div class="card mt-4">
                        <div class="card-header">
                            <h5 class="card-title mb-0">
                                <i class="fas fa-info-circle me-2"></i>
                                About User Migration
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <h6>What This Fixes</h6>
                                    <ul class="list-unstyled">
                                        <li><i class="fas fa-check text-success me-2"></i>Broken account states</li>
                                        <li><i class="fas fa-check text-success me-2"></i>Missing profile information</li>
                                        <li><i class="fas fa-check text-success me-2"></i>Access to user-specific features</li>
                                        <li><i class="fas fa-check text-success me-2"></i>Project and team assignments</li>
                                    </ul>
                                </div>
                                <div class="col-md-6">
                                    <h6>What Gets Created</h6>
                                    <ul class="list-unstyled">
                                        <li><i class="fas fa-user me-2 text-primary"></i>Basic profile information</li>
                                        <li><i class="fas fa-tag me-2 text-primary"></i>Appropriate user type</li>
                                        <li><i class="fas fa-palette me-2 text-primary"></i>Random avatar color</li>
                                        <li><i class="fas fa-clock me-2 text-primary"></i>Creation timestamps</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-refresh page every 30 seconds to show updated status
        setTimeout(function() {
            location.reload();
        }, 30000);
    </script>
}
