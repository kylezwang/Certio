@{
    ViewData["Title"] = "Billing & Time Tracking";
    Layout = "_ClientLayout";
    ViewData["BodyClass"] = "billing-page";
}

<meta name="organization-id" content="@ViewBag.OrganizationId" />

<div class="billing-container" style="padding: 1rem;">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="display-6 fw-bold text-dark mb-2">Billing</h1>
            <p class="lead text-muted">Manage and track your time entries, expenses, invoices, and trusts.</p>
        </div>
        <button class="btn btn-primary d-flex align-items-center gap-2" id="newTimeEntryBtn">
            <i class="fas fa-plus"></i>
            New Time Entry
        </button>
    </div>

    <!-- Search and Filters -->
    <div class="row mb-4">
        <div class="col-md-8">
            <div class="search-container">
                <i class="fas fa-search"></i>
                <input type="text" class="form-control" placeholder="Search billing..." />
            </div>
        </div>
        <div class="col-md-4">
            <div class="filter-buttons">
                <div class="dropdown d-inline-block me-2">
                    <button class="filter-button dropdown-toggle" type="button" id="billingFilterBtn" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-filter"></i>
                        <span id="billingFilterLabel">All Records</span>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="billingFilterBtn">
                        <li><a class="dropdown-item billing-filter-option" href="#" data-filter="all">All Records</a></li>
                        <li><a class="dropdown-item billing-filter-option" href="#" data-filter="time-entries">Time Entries</a></li>
                        <li><a class="dropdown-item billing-filter-option" href="#" data-filter="expenses">Expenses</a></li>
                        <li><a class="dropdown-item billing-filter-option" href="#" data-filter="invoices">Invoices</a></li>
                        <li><a class="dropdown-item billing-filter-option" href="#" data-filter="trusts">Trust Activity</a></li>
                    </ul>
                </div>
                <div class="dropdown d-inline-block">
                    <button class="filter-button dropdown-toggle" type="button" id="billingDateFilterBtn" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-calendar"></i>
                        <span id="billingDateFilterLabel">Last 30 Days</span>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="billingDateFilterBtn">
                        <li><a class="dropdown-item billing-date-option" href="#" data-date-range="last-30-days">Last 30 Days</a></li>
                        <li><a class="dropdown-item billing-date-option" href="#" data-date-range="last-90-days">Last 90 Days</a></li>
                        <li><a class="dropdown-item billing-date-option" href="#" data-date-range="this-year">This Year</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item billing-date-option" href="#" data-date-range="all-time">All Time</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab Navigation -->
    <nav class="matter-tabs bg-white border-bottom border-top">
        <div class="row">
            <div class="d-flex gap-1">
                <a href="#overview" class="matter-tab-link active" data-tab="overview">
                    <i class="fas fa-chart-line"></i>
                    <span>Overview</span>
                </a>
                <a href="#time-entries" class="matter-tab-link" data-tab="time-entries">
                    <i class="fas fa-stopwatch"></i>
                    <span>Time Entries</span>
                </a>
                <a href="#expenses" class="matter-tab-link" data-tab="expenses">
                    <i class="fas fa-receipt"></i>
                    <span>Expenses</span>
                </a>
                <a href="#invoices" class="matter-tab-link" data-tab="invoices">
                    <i class="fas fa-file-invoice"></i>
                    <span>Invoices</span>
                </a>
                <a href="#trusts" class="matter-tab-link" data-tab="trusts">
                    <i class="fas fa-hand-holding-usd"></i>
                    <span>Trusts</span>
                </a>
            </div>
        </div>
    </nav>

    <!-- Tab Content Container -->
    <div class="matter-content-container" style="padding: 0;">
        <!-- Time Entries Tab -->
        <div id="tab-time-entries" class="tab-content-section active">
            <!-- Content will be loaded via AJAX when tab is first accessed -->
        </div>

        <!-- Expenses Tab -->
        <div id="tab-expenses" class="tab-content-section" style="display: none;">
            <div class="container-fluid px-4 py-4">
                <div class="text-center py-5">
                    <i class="fas fa-receipt text-muted mb-3" style="font-size: 3rem;"></i>
                    <h4 class="text-dark mb-2">Expenses</h4>
                    <p class="text-muted">Track and manage expenses for your matters.</p>
                    <p class="text-muted small">(To be implemented)</p>
                </div>
            </div>
        </div>

        <!-- Invoices Tab -->
        <div id="tab-invoices" class="tab-content-section" style="display: none;">
            <div class="container-fluid px-4 py-4">
                <div class="text-center py-5">
                    <i class="fas fa-file-invoice text-muted mb-3" style="font-size: 3rem;"></i>
                    <h4 class="text-dark mb-2">Invoices</h4>
                    <p class="text-muted">View and manage your invoices.</p>
                    <p class="text-muted small">(To be implemented)</p>
                </div>
            </div>
        </div>

        <!-- Trusts Tab -->
        <div id="tab-trusts" class="tab-content-section" style="display: none;">
            <div class="container-fluid px-4 py-4">
                <div class="text-center py-5">
                    <i class="fas fa-briefcase text-muted mb-3" style="font-size: 3rem;"></i>
                    <h4 class="text-dark mb-2">Trusts</h4>
                    <p class="text-muted">View trust account information and transactions.</p>
                    <p class="text-muted small">(To be implemented)</p>
                </div>
            </div>
        </div>

        <!-- Overview Tab -->
        <div id="tab-overview" class="tab-content-section" style="display: none;">
            <!-- Content will be loaded via AJAX when tab is first accessed -->
        </div>
    </div>
</div>

@section GlobalSidebarFinalCard {
    <partial name="_BillingFilters" />
}

@section Scripts {
    <script src="~/js/billing.js"></script>
}