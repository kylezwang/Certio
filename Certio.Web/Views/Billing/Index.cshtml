@{
    ViewData["Title"] = "Billing & Time Tracking";
    Layout = "_ClientLayout";
    ViewData["BodyClass"] = "billing-page";
}

<meta name="organization-id" content="@ViewBag.OrganizationId" />

<div class="billing-container" style="padding: 1rem;">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="display-6 fw-bold text-dark mb-2">Billing</h1>
            <p class="lead text-muted">Manage and track your time entries, expenses, invoices, and trusts.</p>
        </div>
        <button class="btn btn-primary d-flex align-items-center gap-2" id="newTimeEntryBtn">
            <i class="fas fa-plus"></i>
            New Time Entry
        </button>
    </div>

    <!-- Search and Filters -->
    <div class="row mb-4">
        <div class="col-md-8">
            <div class="search-container">
                <i class="fas fa-search"></i>
                <input type="text" class="form-control" placeholder="Search billing..." />
            </div>
        </div>
        <div class="col-md-4">
            <div class="filter-buttons">
                <button class="filter-button">
                    <i class="fas fa-filter"></i>
                    Filter
                </button>
                <button class="filter-button">
                    <i class="fas fa-calendar"></i>
                    Date Range
                </button>
            </div>
        </div>
    </div>
    
    <!-- Stats Cards -->
    <div class="row mb-3" style="--bs-gutter-x: 1rem;">
        <div class="col-md-3 mb-3">
            <div class="card h-100 border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="p-3 rounded-3 me-3" style="background-color: #6b72801C !important;">
                            <i class="fas fa-clock text-secondary fs-4"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold text-dark mb-0">142.5</h3>
                            <p class="text-muted mb-1 small">Billable Hours</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3 mb-3">
            <div class="card h-100 border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="p-3 bg-success bg-opacity-10 rounded-3 me-3">
                            <i class="fas fa-dollar-sign text-success fs-4"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold text-dark mb-0">$71,250</h3>
                            <p class="text-muted mb-1 small">Revenue</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3 mb-3">
            <div class="card h-100 border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="p-3 bg-warning bg-opacity-10 rounded-3 me-3">
                            <i class="fas fa-file-invoice text-warning fs-4"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold text-dark mb-0">8</h3>
                            <p class="text-muted mb-1 small">Pending Invoices</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3 mb-3">
            <div class="card h-100 border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="p-3 icon-bg-primary rounded-3 me-3">
                            <i class="fas fa-chart-line text-primary fs-4"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold text-dark mb-0">$28,500</h3>
                            <p class="text-muted mb-1 small">Outstanding</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab Navigation -->
    <nav class="matter-tabs bg-white border-bottom">
        <div class="row">
            <div class="d-flex gap-1">
                <a href="#time-entries" class="matter-tab-link active" data-tab="time-entries">
                    <i class="fas fa-clock"></i>
                    <span>Time Entries</span>
                </a>
                <a href="#expenses" class="matter-tab-link" data-tab="expenses">
                    <i class="fas fa-receipt"></i>
                    <span>Expenses</span>
                </a>
                <a href="#invoices" class="matter-tab-link" data-tab="invoices">
                    <i class="fas fa-file-invoice"></i>
                    <span>Invoices</span>
                </a>
                <a href="#trusts" class="matter-tab-link" data-tab="trusts">
                    <i class="fas fa-briefcase"></i>
                    <span>Trusts</span>
                </a>
                <a href="#reports" class="matter-tab-link" data-tab="reports">
                    <i class="fas fa-chart-bar"></i>
                    <span>Reports</span>
                </a>
            </div>
        </div>
    </nav>

    <!-- Tab Content Container -->
    <div class="matter-content-container" style="padding: 0;">
        <!-- Time Entries Tab -->
        <div id="tab-time-entries" class="tab-content-section active">
            <!-- Content will be loaded via AJAX when tab is first accessed -->
        </div>

        <!-- Expenses Tab -->
        <div id="tab-expenses" class="tab-content-section" style="display: none;">
            <div class="container-fluid px-4 py-4">
                <div class="text-center py-5">
                    <i class="fas fa-receipt text-muted mb-3" style="font-size: 3rem;"></i>
                    <h4 class="text-dark mb-2">Expenses</h4>
                    <p class="text-muted">Track and manage expenses for your matters.</p>
                    <p class="text-muted small">(To be implemented)</p>
                </div>
            </div>
        </div>

        <!-- Invoices Tab -->
        <div id="tab-invoices" class="tab-content-section" style="display: none;">
            <div class="container-fluid px-4 py-4">
                <div class="text-center py-5">
                    <i class="fas fa-file-invoice text-muted mb-3" style="font-size: 3rem;"></i>
                    <h4 class="text-dark mb-2">Invoices</h4>
                    <p class="text-muted">View and manage your invoices.</p>
                    <p class="text-muted small">(To be implemented)</p>
                </div>
            </div>
        </div>

        <!-- Trusts Tab -->
        <div id="tab-trusts" class="tab-content-section" style="display: none;">
            <div class="container-fluid px-4 py-4">
                <div class="text-center py-5">
                    <i class="fas fa-briefcase text-muted mb-3" style="font-size: 3rem;"></i>
                    <h4 class="text-dark mb-2">Trusts</h4>
                    <p class="text-muted">View trust account information and transactions.</p>
                    <p class="text-muted small">(To be implemented)</p>
                </div>
            </div>
        </div>

        <!-- Reports Tab -->
        <div id="tab-reports" class="tab-content-section" style="display: none;">
            <div class="container-fluid px-4 py-4">
                <div class="text-center py-5">
                    <i class="fas fa-chart-bar text-muted mb-3" style="font-size: 3rem;"></i>
                    <h4 class="text-dark mb-2">Reports</h4>
                    <p class="text-muted">Generate billing and time tracking reports.</p>
                    <p class="text-muted small">(To be implemented)</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section GlobalSidebarFinalCard {
    <partial name="_BillingFilters" />
}

@section Scripts {
    <script src="~/js/billing.js"></script>
}