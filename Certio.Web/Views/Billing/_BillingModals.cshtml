<!-- Retainer Modal -->
<div class="task-details-modal billing-modal" id="retainerModal" style="display: none;">
    <div class="modal-dialog">
        <div class="task-details-content">
            <!-- Header -->
            <div class="task-details-header">
                <div class="task-details-header-left">
                    <div class="billing-modal-icon">
                        <i class="fas fa-hand-holding-usd"></i>
                    </div>
                </div>
                <div class="task-details-header-middle">
                    <h5 class="billing-modal-title">New Retainer</h5>
                </div>
                <div class="task-details-header-right">
                    <button type="button" class="btn task-header-btn billing-modal-close" data-close-modal aria-label="Close">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>

            <!-- Body -->
            <div class="task-details-body billing-modal-body">
                <div class="billing-form-content">
                    <input type="hidden" id="retainerId" data-billing-id />
                    <!-- Event/Matter Selection -->
                    <div class="billing-field">
                        <label class="billing-field-label">
                            <i class="fas fa-folder"></i> @matterLabel
                        </label>
                        <select class="form-select billing-select billing-matter-select" id="retainerMatter">
                            <option value="">Select @matterLabel...</option>
                        </select>
                    </div>

                    <!-- Client + Status Row -->
                    <div class="billing-field-row">
                        <div class="billing-field">
                            <label class="billing-field-label">
                                <i class="fas fa-building"></i> Client
                            </label>
                            <div class="billing-assignee-row">
                                <div class="billing-assignees-container" id="retainerClientsContainer">
                                </div>
                                <button class="btn btn-sm add-member-btn billing-add-client-btn" id="addRetainerClientBtn" data-modal="retainerModal">
                                    <i class="fas fa-plus"></i>
                                </button>
                                <input type="hidden" id="retainerClient" />
                            </div>
                        </div>
                        <div class="billing-field">
                            <label class="billing-field-label">
                                <i class="fas fa-tag"></i> Status
                            </label>
                            <select class="form-select billing-select" id="retainerStatus">
                                <option value="0" selected>Active</option>
                                <option value="1">Depleted</option>
                                <option value="2">Overdrawn</option>
                                <option value="3">Closed</option>
                            </select>
                        </div>
                    </div>

                    <!-- Initial Amount -->
                    <div class="billing-field">
                        <label class="billing-field-label">
                            <i class="fas fa-dollar-sign"></i> Initial Amount
                        </label>
                        <input type="number" class="form-control billing-input" id="retainerAmount" step="0.01" min="0" placeholder="0.00" />
                    </div>

                    <!-- Notes -->
                    <div class="billing-field">
                        <label class="billing-field-label">
                            <i class="fas fa-sticky-note"></i> Notes
                        </label>
                        <textarea class="form-control billing-textarea" id="retainerNotes" rows="3" placeholder="Add notes about this retainer..."></textarea>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="billing-modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-close-modal>Cancel</button>
                <button type="button" class="btn btn-primary" id="saveRetainerBtn">
                    <i class="fas fa-save"></i> Create Retainer
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Billing Modal Overrides - Extends task-details-modal.css */
    
    /* Override modal positioning to match task-details-modal but be narrower */
    .billing-modal.task-details-modal {
        /* Inherit positioning from task-details-modal.css */
    }
    
    /* Make billing modals narrower */
    .billing-modal.task-details-modal .modal-dialog {
        width: 32rem;
        max-width: 90%;
    }
    
    /* Ensure billing modal also respects sidebar/chat hidden states - inherits from task-details-modal.css */
    
    /* Header icon styling */
    .billing-modal-icon {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background: linear-gradient(135deg, #3d1019 0%, #5a1a26 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1rem;
    }
    
    .billing-modal-title {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 600;
        color: #1e293b;
    }
    
    /* Meta section styling - like tasks */
    .billing-meta-section {
        padding: 0.75rem 2rem;
        border-bottom: 1px solid #e5e7eb;
    }
    
    /* Body styling */
    .billing-modal .billing-modal-body {
        flex-direction: column;
        padding: 1.25rem 2rem;
    }
    
    .billing-form-content {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        width: 100%;
    }
    
    /* Field styling */
    .billing-field {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }
    
    .billing-field-row {
        display: flex;
        gap: 1rem;
    }
    
    .billing-field-row .billing-field {
        flex: 1;
    }
    
    .billing-field-label {
        font-size: 0.8125rem;
        font-weight: 600;
        color: #374151;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .billing-field-label i {
        color: #3d1019;
        width: 14px;
        font-size: 0.75rem;
    }
    
    .billing-modal .billing-input,
    .billing-modal .billing-select,
    .billing-modal .billing-textarea {
        font-size: 0.875rem;
        border-radius: 6px;
        border: 1px solid #d1d5db;
        padding: 0.5rem 0.75rem;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    
    .billing-modal .billing-input:focus,
    .billing-modal .billing-select:focus,
    .billing-modal .billing-textarea:focus {
        outline: none;
        border-color: #3d1019;
        box-shadow: 0 0 0 2px rgba(61, 16, 25, 0.1);
    }
    
    .billing-textarea {
        resize: vertical;
        min-height: 70px;
    }
    
    .billing-checkbox-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        color: #374151;
        cursor: pointer;
    }
    
    .billing-checkbox-label .form-check-input:checked {
        background-color: #3d1019;
        border-color: #3d1019;
    }
    
    /* Footer styling */
    .billing-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        padding: 1rem 2rem;
        border-top: 1px solid #e5e7eb;
        background: #f9fafb;
        border-radius: 0 0 16px 16px;
    }
    
    .billing-modal-footer .btn {
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.5rem 1rem;
        border-radius: 6px;
    }
    
    .billing-modal-footer .btn-primary {
        background: linear-gradient(135deg, #3d1019 0%, #5a1a26 100%);
        border: none;
    }
    
    .billing-modal-footer .btn-primary:hover {
        background: linear-gradient(135deg, #4a1320 0%, #6a2030 100%);
    }
    
    /* Billing assignee row - layout for assignee field in body */
    .billing-assignee-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 38px;
        padding: 0.25rem 0;
    }
    
    /* Billing assignee button - ensure circular like task modal */
    .billing-modal .billing-add-assignee-btn.add-member-btn,
    .billing-modal .billing-add-client-btn.add-member-btn {
        width: 32px;
        height: 32px;
        min-width: 32px;
        min-height: 32px;
        padding: 0;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px dashed #d1d5db;
        background: transparent;
        color: #6b7280;
