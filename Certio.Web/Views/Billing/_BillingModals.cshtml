@{
    // Get organization entity for custom terminology
    var orgType = ViewBag.OrganizationType as Certio.Domain.Organizations.OrganizationType? ?? Certio.Domain.Organizations.OrganizationType.Client;
    var orgEntity = ViewBag.OrganizationEntity as Certio.Domain.Organizations.Organization;
    var matterLabel = orgEntity != null 
        ? Certio.Web.Helpers.RoleDisplayHelper.GetMatterTerminology(orgEntity) 
        : Certio.Web.Helpers.RoleDisplayHelper.GetMatterTerminology(orgType);
}

<!-- Time Entry Modal - Uses same structure as task-details-modal -->
<div class="task-details-modal billing-modal" id="timeEntryModal" style="display: none;">
    <div class="modal-dialog">
        <div class="task-details-content">
            <!-- Header -->
            <div class="task-details-header">
                <div class="task-details-header-left">
                    <div class="billing-modal-icon">
                        <i class="fas fa-stopwatch"></i>
                    </div>
                </div>
                <div class="task-details-header-middle">
                    <h5 class="billing-modal-title">New Time Entry</h5>
                </div>
                <div class="task-details-header-right">
                    <button type="button" class="btn task-header-btn billing-modal-close" data-close-modal aria-label="Close">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>

            <!-- Body -->
            <div class="task-details-body billing-modal-body">
                <div class="billing-form-content">
                    <input type="hidden" id="timeEntryId" data-billing-id />
                    <!-- Event/Matter Selection -->
                    <div class="billing-field">
                        <label class="billing-field-label">
                            <i class="fas fa-folder"></i> @matterLabel
                        </label>
                        <select class="form-select billing-select billing-matter-select" id="timeEntryMatter">
                            <option value="">Select @matterLabel...</option>
                        </select>
                    </div>

                    <!-- Client + Assignee Row (side by side) -->
                    <div class="billing-field-row">
                        <div class="billing-field">
                            <label class="billing-field-label">
                                <i class="fas fa-building"></i> Client
                            </label>
                            <div class="billing-assignee-row">
                                <div class="billing-assignees-container" id="timeEntryClientsContainer">
                                    <!-- Client selection will be dynamically rendered here -->
                                </div>
                                <button class="btn btn-sm add-member-btn billing-add-client-btn" id="addTimeEntryClientBtn" data-modal="timeEntryModal">
                                    <i class="fas fa-plus"></i>
                                </button>
                                <input type="hidden" id="timeEntryClient" />
                            </div>
                        </div>
                        <div class="billing-field">
                            <label class="billing-field-label">
                                <i class="fas fa-user"></i> Assignee
                            </label>
                            <div class="billing-assignee-row">
                                <div class="billing-assignees-container" id="timeEntryAssigneesContainer">
                                    <!-- Assignees will be dynamically rendered here -->
                                </div>
                                <button class="btn btn-sm add-member-btn billing-add-assignee-btn" id="addTimeEntryAssigneeBtn" data-modal="timeEntryModal">
                                    <i class="fas fa-plus"></i>
                                </button>
                                <input type="hidden" id="timeEntryAssignee" />
                            </div>
                        </div>
                    </div>

                    <!-- Date -->
                    <div class="billing-field">
                        <label class="billing-field-label">
                            <i class="fas fa-calendar"></i> Date
                        </label>
                        <input type="date" class="form-control billing-input" id="timeEntryDate" />
                    </div>

                    <!-- Hours and Rate Row -->
                    <div class="billing-field-row">
                        <div class="billing-field">
                            <label class="billing-field-label">
                                <i class="fas fa-clock"></i> Hours
                            </label>
                            <input type="number" class="form-control billing-input" id="timeEntryHours" step="0.25" min="0" placeholder="0.00" />
                        </div>
                        <div class="billing-field">
                            <label class="billing-field-label">
                                <i class="fas fa-dollar-sign"></i> Rate (per hour)
                            </label>
                            <input type="number" class="form-control billing-input" id="timeEntryRate" step="0.01" min="0" placeholder="0.00" />
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="billing-field">
                        <label class="billing-field-label">
                            <i class="fas fa-align-left"></i> Description
                        </label>
                        <textarea class="form-control billing-textarea" id="timeEntryDescription" rows="3" placeholder="Describe the work performed..."></textarea>
                    </div>

                    <!-- Status -->
                    <div class="billing-field">
                        <label class="billing-field-label">
                            <i class="fas fa-tag"></i> Status
                        </label>
                        <select class="form-select billing-select" id="timeEntryStatus">
                            <option value="0" selected>Needs Review</option>
                            <option value="1">Approved</option>
                            <option value="2">Billed</option>
                            <option value="3">Paid</option>
                        </select>
                    </div>

                    <!-- Billable Checkbox -->
                    <div class="billing-field">
                        <label class="billing-checkbox-label">
                            <input type="checkbox" class="form-check-input billing-checkbox" id="timeEntryBillable" checked>
                            <span>Billable to client</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="billing-modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-close-modal>Cancel</button>
                <button type="button" class="btn btn-primary" id="saveTimeEntryBtn">
                    <i class="fas fa-save"></i> Save Time Entry
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Expense Modal -->
<div class="task-details-modal billing-modal" id="expenseModal" style="display: none;">
    <div class="modal-dialog">
        <div class="task-details-content">
            <!-- Header -->
            <div class="task-details-header">
                <div class="task-details-header-left">
                    <div class="billing-modal-icon">
                        <i class="fas fa-receipt"></i>
                    </div>
                </div>
                <div class="task-details-header-middle">
                    <h5 class="billing-modal-title">New Expense</h5>
                </div>
                <div class="task-details-header-right">
                    <button type="button" class="btn task-header-btn billing-modal-close" data-close-modal aria-label="Close">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>

            <!-- Body -->
            <div class="task-details-body billing-modal-body">
                <div class="billing-form-content">
                    <input type="hidden" id="expenseId" data-billing-id />
                    <!-- Event/Matter Selection -->
                    <div class="billing-field">
                        <label class="billing-field-label">
                            <i class="fas fa-folder"></i> @matterLabel
                        </label>
                        <select class="form-select billing-select billing-matter-select" id="expenseMatter">
                            <option value="">Select @matterLabel...</option>
                        </select>
                    </div>

                    <!-- Client + Assignee Row (side by side) -->
                    <div class="billing-field-row">
                        <div class="billing-field">
                            <label class="billing-field-label">
                                <i class="fas fa-building"></i> Client
                            </label>
                            <div class="billing-assignee-row">
                                <div class="billing-assignees-container" id="expenseClientsContainer">
                                </div>
                                <button class="btn btn-sm add-member-btn billing-add-client-btn" id="addExpenseClientBtn" data-modal="expenseModal">
                                    <i class="fas fa-plus"></i>
                                </button>
                                <input type="hidden" id="expenseClient" />
                            </div>
                        </div>
                        <div class="billing-field">
                            <label class="billing-field-label">
                                <i class="fas fa-user"></i> Assignee
                            </label>
                            <div class="billing-assignee-row">
                                <div class="billing-assignees-container" id="expenseAssigneesContainer">
                                </div>
                                <button class="btn btn-sm add-member-btn billing-add-assignee-btn" id="addExpenseAssigneeBtn" data-modal="expenseModal">
                                    <i class="fas fa-plus"></i>
                                </button>
                                <input type="hidden" id="expenseAssignee" />
                            </div>
                        </div>
                    </div>

                    <!-- Date and Category Row -->
                    <div class="billing-field-row">
                        <div class="billing-field">
                            <label class="billing-field-label">
                                <i class="fas fa-calendar"></i> Date
                            </label>
                            <input type="date" class="form-control billing-input" id="expenseDate" />
                        </div>
                        <div class="billing-field">
                            <label class="billing-field-label">
                                <i class="fas fa-tag"></i> Category
                            </label>
                            <select class="form-select billing-select billing-category-select" id="expenseCategory">
                                <option value="">Select Category...</option>
                            </select>
                        </div>
                    </div>

                    <!-- Amount -->
                    <div class="billing-field">
                        <label class="billing-field-label">
                            <i class="fas fa-dollar-sign"></i> Amount
                        </label>
                        <input type="number" class="form-control billing-input" id="expenseAmount" step="0.01" min="0" placeholder="0.00" />
                    </div>

                    <!-- Description -->
                    <div class="billing-field">
                        <label class="billing-field-label">
                            <i class="fas fa-align-left"></i> Description
                        </label>
                        <textarea class="form-control billing-textarea" id="expenseDescription" rows="3" placeholder="Describe the expense..."></textarea>
                    </div>

                    <!-- Status -->
                    <div class="billing-field">
                        <label class="billing-field-label">
                            <i class="fas fa-tag"></i> Status
                        </label>
                        <select class="form-select billing-select" id="expenseStatus">
                            <option value="0" selected>Unbilled</option>
                            <option value="1">Billed</option>
                            <option value="2">Paid</option>
                        </select>
                    </div>

                    <!-- Billable Checkbox -->
                    <div class="billing-field">
                        <label class="billing-checkbox-label">
                            <input type="checkbox" class="form-check-input billing-checkbox" id="expenseBillable" checked>
                            <span>Billable to client</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="billing-modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-close-modal>Cancel</button>
                <button type="button" class="btn btn-primary" id="saveExpenseBtn">
                    <i class="fas fa-save"></i> Save Expense
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Invoice Modal -->
<div class="task-details-modal billing-modal" id="invoiceModal" style="display: none;">
    <div class="modal-dialog">
        <div class="task-details-content">
            <!-- Header -->
            <div class="task-details-header">
                <div class="task-details-header-left">
                    <div class="billing-modal-icon">
                        <i class="fas fa-file-invoice"></i>
                    </div>
                </div>
                <div class="task-details-header-middle">
                    <h5 class="billing-modal-title">New Invoice</h5>
                </div>
                <div class="task-details-header-right">
                    <button type="button" class="btn task-header-btn billing-modal-close" data-close-modal aria-label="Close">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>

            <!-- Body -->
            <div class="task-details-body billing-modal-body">
                <div class="billing-form-content">
                    <input type="hidden" id="invoiceId" data-billing-id />
                    <!-- Event/Matter Selection -->
                    <div class="billing-field">
                        <label class="billing-field-label">
                            <i class="fas fa-folder"></i> @matterLabel
                        </label>
                        <select class="form-select billing-select billing-matter-select" id="invoiceMatter">
                            <option value="">Select @matterLabel...</option>
                        </select>
                    </div>

                    <!-- Client + Status Row -->
                    <div class="billing-field-row">
                        <div class="billing-field">
                            <label class="billing-field-label">
                                <i class="fas fa-building"></i> Client
                            </label>
                            <div class="billing-assignee-row">
                                <div class="billing-assignees-container" id="invoiceClientsContainer">
                                </div>
                                <button class="btn btn-sm add-member-btn billing-add-client-btn" id="addInvoiceClientBtn" data-modal="invoiceModal">
                                    <i class="fas fa-plus"></i>
                                </button>
                                <input type="hidden" id="invoiceClient" />
                            </div>
                        </div>
                        <div class="billing-field">
                            <label class="billing-field-label">
                                <i class="fas fa-tag"></i> Status
                            </label>
                            <select class="form-select billing-select" id="invoiceStatus">
                                <option value="0" selected>Draft</option>
                                <option value="1">Pending</option>
                                <option value="4">Partially Paid</option>
                                <option value="2">Paid</option>
                                <option value="5">Cancelled</option>
                                <option value="6">Refunded</option>
                            </select>
                        </div>
                    </div>

                    <!-- Date Row -->
                    <div class="billing-field-row">
                        <div class="billing-field">
                            <label class="billing-field-label">
                                <i class="fas fa-calendar"></i> Invoice Date
                            </label>
                            <input type="date" class="form-control billing-input" id="invoiceDate" />
                        </div>
                        <div class="billing-field">
                            <label class="billing-field-label">
                                <i class="fas fa-calendar-alt"></i> Due Date
                            </label>
                            <input type="date" class="form-control billing-input" id="invoiceDueDate" />
                        </div>
                    </div>

                    <!-- Tax Amount -->
                    <div class="billing-field">
                        <label class="billing-field-label">
                            <i class="fas fa-percentage"></i> Tax Amount
                        </label>
                        <input type="number" class="form-control billing-input" id="invoiceTax" step="0.01" min="0" placeholder="0.00" />
                    </div>

                    <!-- Notes -->
                    <div class="billing-field">
                        <label class="billing-field-label">
                            <i class="fas fa-sticky-note"></i> Notes
                        </label>
                        <textarea class="form-control billing-textarea" id="invoiceNotes" rows="2" placeholder="Add notes for the client..."></textarea>
                    </div>

                    <!-- Terms -->
                    <div class="billing-field">
                        <label class="billing-field-label">
                            <i class="fas fa-file-contract"></i> Terms
                        </label>
                        <textarea class="form-control billing-textarea" id="invoiceTerms" rows="2" placeholder="Payment terms..."></textarea>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="billing-modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-close-modal>Cancel</button>
                <button type="button" class="btn btn-primary" id="saveInvoiceBtn">
                    <i class="fas fa-save"></i> Create Invoice
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Subscription Management Modal -->
