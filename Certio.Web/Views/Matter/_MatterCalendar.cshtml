                               style="margin-top: 0.75rem;">
                        <label class="form-check-label" for="attendee_user_${user.id}" style="cursor: pointer; font-size: 0.875rem;">
                            <strong>${user.name}${user.id === currentUserId ? ' (You)' : ''}</strong>
                            ${user.email ? `<small class="text-muted d-block" style="font-size: 0.75rem;">${user.email}</small>` : ''}
                        </label>
                    </div>
                `).join('');
                
                // Add checkbox event listeners
                availableUsersList.querySelectorAll('.user-checkbox').forEach(checkbox => {
                    checkbox.addEventListener('change', function() {
                        const userId = parseInt(this.value);
                        const user = state.allUsers.find(u => u.id === userId);
                        
                        if (this.checked) {
                            if (!selectedUsers.some(a => a.userId === userId)) {
                                selectedUsers.push({
                                    userId: userId,
                                    name: user.name,
                                    initials: user.initials,
                                    attendeeType: 'Required'
                                });
                            }
                        } else {
                            // Don't allow removing current user
                            if (userId === currentUserId) {
                                this.checked = true;
                                return;
                            }
                            const index = selectedUsers.findIndex(a => a.userId === userId);
                            if (index > -1) {
                                selectedUsers.splice(index, 1);
                            }
                        }
                        updateSelectedDisplay();
                    });
                });
            }
            
            function updateSelectedDisplay() {
                if (selectedUsers.length === 0) {
                    selectedUsersList.innerHTML = '<p class="text-muted mb-0" style="font-size: 0.75rem;">No attendees selected yet.</p>';
                } else {
                    selectedUsersList.innerHTML = selectedUsers.map(attendee => `
                        <span class="badge bg-primary me-1 mb-1" style="font-size: 0.75rem;">
                            ${attendee.name}${attendee.userId === currentUserId ? ' (You)' : ''}
                            ${attendee.userId !== currentUserId ? `<i class="fas fa-times ms-1" style="cursor: pointer;" data-user-id="${attendee.userId}"></i>` : ''}
                        </span>
                    `).join('');
                    
                    // Add remove handlers (except for current user)
                    selectedUsersList.querySelectorAll('.fa-times').forEach(icon => {
                        icon.addEventListener('click', function() {
                            const userId = parseInt(this.dataset.userId);
                            if (userId === currentUserId) return; // Don't allow removing current user
                            
                            const index = selectedUsers.findIndex(a => a.userId === userId);
                            if (index > -1) {
                                selectedUsers.splice(index, 1);
                                console.log('Removed user from selectedUsers:', selectedUsers);
                            }
                            const checkbox = availableUsersList.querySelector(`#attendee_user_${userId}`);
                            if (checkbox) checkbox.checked = false;
                            updateSelectedDisplay();
                        });
                    });
                }
            }
            
            // Initialize display
            // Ensure users are loaded before showing popup
            if (!state.allUsers || state.allUsers.length === 0) {
                await loadUsers();
            }
            
            renderUsers();
            updateSelectedDisplay();
            
            // Search functionality
            searchInput.addEventListener('input', function() {
                renderUsers(this.value);
            });
            
            // Handle Done button
            popup.querySelector('#attendeeDone').addEventListener('click', function() {
                state.eventAttendees = [...selectedUsers];
                renderAttendees();
                popup.remove();
                document.removeEventListener('click', outsideClickHandler);
            });
            
            // Handle Cancel button
            popup.querySelector('#attendeeCancel').addEventListener('click', function() {
                popup.remove();
                document.removeEventListener('click', outsideClickHandler);
            });
            
            // Close on outside click
            const outsideClickHandler = function(e) {
                if (!popup.contains(e.target) && e.target !== addAttendeeBtn) {
                    popup.remove();
                    document.removeEventListener('click', outsideClickHandler);
                }
            };
            
            // Add click handler after a short delay to avoid immediate closing
            setTimeout(() => {
                document.addEventListener('click', outsideClickHandler);
            }, 100);
        }

        // Render attendees as avatars
        function renderAttendees() {
            console.log('renderAttendees called, state.eventAttendees:', state.eventAttendees);
            const container = document.getElementById('eventAttendeesList');
            
            if (!container) {
                console.error('eventAttendeesList container not found');
                return;
            }
            
            if (state.eventAttendees.length === 0) {
                console.log('No attendees to render, clearing container');
                container.innerHTML = '';
                return;
            }
            
            console.log('Rendering', state.eventAttendees.length, 'attendees');
            container.innerHTML = '';
            state.eventAttendees.forEach((attendee, index) => {
                console.log('Rendering attendee:', attendee);
                const avatarEl = document.createElement('div');
                avatarEl.classList.add('assignee-avatar');
                const isCurrentUser = attendee.userId === currentUserId;
                avatarEl.title = `${attendee.name}${isCurrentUser ? ' (You)' : ''} (${attendee.attendeeType || 'Required'})`;
                avatarEl.innerHTML = `
                    ${attendee.initials || attendee.name.substring(0, 2).toUpperCase()}
                    ${!isCurrentUser ? `<span class="remove-assignee" data-index="${index}"><i class="fas fa-times"></i></span>` : ''}
                `;
                
                // Remove attendee handler (only if not current user)
                if (!isCurrentUser) {
                    const removeBtn = avatarEl.querySelector('.remove-assignee');
                    if (removeBtn) {
                        removeBtn.addEventListener('click', function(e) {
                            e.stopPropagation();
                            state.eventAttendees.splice(index, 1);
                            renderAttendees();
                        });
                    }
                }
                
                container.appendChild(avatarEl);
            });
        }

        // Helper function to convert Date to local ISO string
        function toLocalISOString(date) {
            const offset = date.getTimezoneOffset();
            const localDate = new Date(date.getTime() - offset * 60 * 1000);
            return localDate.toISOString();
        }

        // Event Location Search functionality
        let eventPlacesSessionToken = null;
        let currentEventLocationData = null;
        let eventLocationSearchInitialized = false;

        // Initialize Google Places Autocomplete for Event modal
        function initializeEventLocationSearch() {
            console.log('Initializing event location search...');
            
            // Prevent multiple initializations
            if (eventLocationSearchInitialized) {
                console.log('Event location search already initialized');
                return;
            }
            
            const searchInput = document.getElementById('eventLocationSearchInput');
            
            if (!searchInput) {
                console.error('Event location search input not found');
                return;
            }
            
            if (!window.google || !google.maps.places) {
                console.warn('Google Maps API not loaded yet for events, retrying...');
                setTimeout(initializeEventLocationSearch, 1000);
                return;
            }

            console.log('Google Maps API is ready for events, setting up location search');
            eventLocationSearchInitialized = true;
            searchInput.disabled = false;
            searchInput.placeholder = 'Start typing a location...';

            // Handle typing and show custom dropdown
            let typingTimeout = null;
            searchInput.addEventListener('input', function() {
                clearTimeout(typingTimeout);
                const query = this.value.trim();
                console.log('Event location search input:', query);
                
                if (query.length > 2) {
                    if (!eventPlacesSessionToken || query.length === 3) {
                        eventPlacesSessionToken = new google.maps.places.AutocompleteSessionToken();
                    }
                    typingTimeout = setTimeout(() => {
                        console.log('Triggering autocomplete for event:', query);
                        showEventAutocomplete(query);
                    }, 300);
                } else {
                    hideEventAutocompleteDropdown();
                }
            });

            // Handle keyboard navigation
            searchInput.addEventListener('keydown', handleEventKeyboardNavigation);

            // Click outside to close dropdown
            document.addEventListener('click', function(e) {
                if (!e.target.closest('#eventLocationSearchInput') && !e.target.closest('#eventAutocompleteDropdown')) {
                    hideEventAutocompleteDropdown();
                }
            });

            // Initialize event location action buttons
            initializeEventLocationActions();
        }

        // Show event autocomplete dropdown
        function showEventAutocomplete(query) {
            const dropdown = document.getElementById('eventAutocompleteDropdown');
            const list = document.getElementById('eventAutocompleteList');
            const loadingIndicator = document.getElementById('eventSearchLoadingIndicator');
            
            if (!dropdown || !list || !query) {
                console.warn('Missing event autocomplete elements or empty query');
                return;
            }

            loadingIndicator.style.display = 'block';

            // Use Places API to get suggestions
            const service = new google.maps.places.AutocompleteService();
            
            service.getPlacePredictions({
                input: query,
                types: ['establishment', 'geocode'],
                sessionToken: eventPlacesSessionToken
            }, function(predictions, status) {
                loadingIndicator.style.display = 'none';
                
                if (status === google.maps.places.PlacesServiceStatus.OK && predictions) {
                    populateEventAutocompleteDropdown(predictions);
                    showEventAutocompleteDropdown();
                } else if (status === google.maps.places.PlacesServiceStatus.REQUEST_DENIED) {
                    console.error('Places API request denied for events.');
                    hideEventAutocompleteDropdown();
                } else {
                    console.log('No predictions or error for events. Status:', status);
                    hideEventAutocompleteDropdown();
                }
            });
        }

        // Populate event autocomplete dropdown
        function populateEventAutocompleteDropdown(predictions) {
            const list = document.getElementById('eventAutocompleteList');
            if (!list) return;

            list.innerHTML = '';
            
            predictions.slice(0, 5).forEach((prediction) => {
                const item = document.createElement('li');
                item.className = 'autocomplete-item';
                item.dataset.placeId = prediction.place_id;
                item.dataset.prediction = prediction.description;
                
                // Extract primary and secondary text
                const description = prediction.description;
                const commaIndex = description.indexOf(', ');
                const primaryText = commaIndex > -1 ? description.substring(0, commaIndex) : description;
                const secondaryText = commaIndex > -1 ? description.substring(commaIndex + 2) : '';
                
                item.innerHTML = `
                    <div class="autocomplete-icon">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <div class="autocomplete-text">
                        <div class="autocomplete-primary-text">${primaryText}</div>
                        ${secondaryText ? `<div class="autocomplete-secondary-text">${secondaryText}</div>` : ''}
                    </div>
                `;
                
                // Handle click selection
                item.addEventListener('click', function() {
                    selectEventLocationFromDropdown(prediction);
                });
                
                // Handle keyboard navigation
                item.addEventListener('mouseenter', function() {
                    clearActiveEventAutocompleteItem();
                    this.classList.add('active');
                });
                
                list.appendChild(item);
            });
        }

        // Handle autocomplete selection from dropdown
        function selectEventLocationFromDropdown(prediction) {
            const searchInput = document.getElementById('eventLocationSearchInput');
            searchInput.value = prediction.description;
            
            // Get place details
            const service = new google.maps.places.PlacesService(document.createElement('div'));
            service.getDetails({
                placeId: prediction.place_id,
                fields: ['name', 'formatted_address', 'geometry'],
                sessionToken: eventPlacesSessionToken
            }, function(place, status) {
                hideEventAutocompleteDropdown();
                
                if (status === google.maps.places.PlacesServiceStatus.OK) {
                    displayEventLocationFromPlace(place);
                    eventPlacesSessionToken = null; // reset after successful selection
                } else {
                    console.error('Could not load event location details');
                }
            });
        }

        // Display event location from Google Place object
        function displayEventLocationFromPlace(place) {
            const locationDisplay = document.getElementById('eventLocationDisplay');
            const locationName = document.getElementById('eventLocationName');
            const locationAddress = document.getElementById('eventLocationAddress');

            // Update location info
            locationName.textContent = place.name || 'Selected Location';
            locationAddress.textContent = place.formatted_address;

            // Show location display
            locationDisplay.style.display = 'flex';

            // Store the full location data globally for saving
            currentEventLocationData = {
                name: place.name || 'Selected Location',
                address: place.formatted_address,
                formatted_address: place.formatted_address,
                place_id: place.place_id,
                geometry: {
                    location: {
                        lat: place.geometry.location.lat(),
                        lng: place.geometry.location.lng()
                    }
                }
            };

            // Load embedded map
            loadEventEmbeddedMap(place.geometry.location, place.name || 'Location', place.formatted_address);
        }

        // Load embedded Google Map for event
        function loadEventEmbeddedMap(location, name, address) {
            const mapContainer = document.getElementById('eventMapContainer');
            
            // Create map URL for embedded display
            const locationStr = location.lat() + ',' + location.lng();
            const encodedName = encodeURIComponent(name);
            const encodedAddress = encodeURIComponent(address);
            
            const mapUrl = `https://maps.google.com/maps?q=${encodedName}|${encodedAddress}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
            
            // Create iframe for embedded map
            mapContainer.innerHTML = `
                <iframe 
                    class="embedded-map loaded"
                    src="${mapUrl}"
                    frameborder="0"
                    allowfullscreen>
                </iframe>
            `;
        }

        // Load embedded map from stored location data (for existing events)
        function loadEventEmbeddedMapFromData(location, name, address) {
            const mapContainer = document.getElementById('eventMapContainer');
            
            if (!mapContainer) return;
            
            // Create map URL for embedded display
            const locationStr = location.lat + ',' + location.lng;
            const encodedName = encodeURIComponent(name);
            const encodedAddress = encodeURIComponent(address);
            
            const mapUrl = `https://maps.google.com/maps?q=${encodedName}|${encodedAddress}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
            
            // Create iframe for embedded map
            mapContainer.innerHTML = `
                <iframe 
                    class="embedded-map loaded"
                    src="${mapUrl}"
                    frameborder="0"
                    allowfullscreen>
                </iframe>
            `;
        }

        // Initialize event location action buttons
        function initializeEventLocationActions() {
            // Remove location button
            const removeLocationBtn = document.getElementById('eventRemoveLocationBtn');
            if (removeLocationBtn) {
                removeLocationBtn.addEventListener('click', function() {
                    removeEventLocation();
                });
            }

            // Get directions button
            const directionsBtn = document.getElementById('eventGetDirectionsBtn');
            if (directionsBtn) {
                directionsBtn.addEventListener('click', function() {
                    const locationName = document.getElementById('eventLocationName')?.textContent;
                    const locationAddress = document.getElementById('eventLocationAddress')?.textContent;
                    
                    if (locationName && locationAddress) {
                        const searchQuery = encodeURIComponent(`${locationName}, ${locationAddress}`);
                        window.open(`https://www.google.com/maps/dir/?api=1&destination=${searchQuery}`, '_blank');
                    }
                });
            }
        }

        // Remove event location
        function removeEventLocation() {
            const locationDisplay = document.getElementById('eventLocationDisplay');
            const mapContainer = document.getElementById('eventMapContainer');
            const searchInput = document.getElementById('eventLocationSearchInput');
            
            // Hide location display
            if (locationDisplay) locationDisplay.style.display = 'none';
            
            // Reset map container
            if (mapContainer) {
                mapContainer.innerHTML = `
                    <div class="map-placeholder">
                        <i class="fas fa-map-marked-alt" style="font-size: 3rem; color: #d1d5db;"></i>
                        <p class="text-muted mt-2">No location selected</p>
                        <small class="text-muted">Search for a location to display it on the map</small>
                    </div>
                `;
            }
            
            // Clear search input
            if (searchInput) searchInput.value = '';
            
            // Clear location data
            currentEventLocationData = null;
        }

        // Handle keyboard navigation in event autocomplete
        function handleEventKeyboardNavigation(e) {
            const dropdown = document.getElementById('eventAutocompleteDropdown');
            const list = document.getElementById('eventAutocompleteList');
            
            if (!dropdown || !list || dropdown.style.display === 'none') return;

            const items = list.querySelectorAll('.autocomplete-item');
            const activeItem = list.querySelector('.autocomplete-item.active');
            let nextActiveIndex = -1;

            switch (e.key) {
                case 'ArrowDown':
                    e.preventDefault();
                    nextActiveIndex = activeItem ? Array.from(items).indexOf(activeItem) + 1 : 0;
                    break;
                case 'ArrowUp':
                    e.preventDefault();
                    nextActiveIndex = activeItem ? Array.from(items).indexOf(activeItem) - 1 : items.length - 1;
                    break;
                case 'Enter':
                    e.preventDefault();
                    if (activeItem) {
                        activeItem.click();
                    }
                    return;
                case 'Escape':
                    e.preventDefault();
                    hideEventAutocompleteDropdown();
                    return;
                default:
                    return;
            }

            if (nextActiveIndex >= 0 && nextActiveIndex < items.length) {
                clearActiveEventAutocompleteItem();
                items[nextActiveIndex].classList.add('active');
            }
        }

        // Clear active event autocomplete item
        function clearActiveEventAutocompleteItem() {
            const activeItem = document.querySelector('#eventAutocompleteList .autocomplete-item.active');
            if (activeItem) {
                activeItem.classList.remove('active');
            }
        }

        // Show event autocomplete dropdown
        function showEventAutocompleteDropdown() {
            const dropdown = document.getElementById('eventAutocompleteDropdown');
            if (dropdown) {
                dropdown.style.display = 'block';
            }
        }

        // Hide event autocomplete dropdown
        function hideEventAutocompleteDropdown() {
            const dropdown = document.getElementById('eventAutocompleteDropdown');
            if (dropdown) {
                dropdown.style.display = 'none';
            }
            clearActiveEventAutocompleteItem();
        }

        // Get event location data for saving
        function getEventLocationData() {
            const locationDisplay = document.getElementById('eventLocationDisplay');
            const locationName = document.getElementById('eventLocationName');
            const locationAddress = document.getElementById('eventLocationAddress');
            
            // Check if location is selected
            if (locationDisplay && locationDisplay.style.display !== 'none' && locationName && locationAddress) {
                return {
                    name: locationName.textContent || '',
                    address: locationAddress.textContent || '',
                    formatted_address: locationAddress.textContent || '',
                    place_id: currentEventLocationData?.place_id || null,
                    geometry: currentEventLocationData?.geometry || null
                };
            }
            
            return null;
        }

        // Set event location data (for loading existing events)
        function setEventLocationData(locationData) {
            if (!locationData) return;
            
            const locationDisplay = document.getElementById('eventLocationDisplay');
            const locationName = document.getElementById('eventLocationName');
            const locationAddress = document.getElementById('eventLocationAddress');
            const locationInput = document.getElementById('eventLocationSearchInput');
            
            if (locationDisplay && locationName && locationAddress) {
                locationName.textContent = locationData.name || '';
                locationAddress.textContent = locationData.address || locationData.formatted_address || '';
                locationDisplay.style.display = 'flex';
                
                // Store the location data globally for map display
                currentEventLocationData = locationData;
                
                // Load the map if we have coordinates
                if (locationData.geometry && locationData.geometry.location) {
                    loadEventEmbeddedMapFromData(locationData.geometry.location, locationData.name, locationData.address || locationData.formatted_address);
                }
                
                // Update the search input
                if (locationInput) {
                    locationInput.value = locationData.name || '';
                }
            }
        }

        // Clear event location (for modal reset)
        function clearEventLocation() {
            const locationInput = document.getElementById('eventLocationSearchInput');
            const locationDisplay = document.getElementById('eventLocationDisplay');
            const mapContainer = document.getElementById('eventMapContainer');
            
            if (locationInput) locationInput.value = '';
            if (locationDisplay) locationDisplay.style.display = 'none';
            if (mapContainer) {
                mapContainer.innerHTML = `
                    <div class="map-placeholder">
                        <i class="fas fa-map-marked-alt" style="font-size: 3rem; color: #d1d5db;"></i>
                        <p class="text-muted mt-2">No location selected</p>
                        <small class="text-muted">Search for a location to display it on the map</small>
                    </div>
                `;
            }
            
            currentEventLocationData = null;
        }

        // Make functions globally available
        window.initializeEventLocationSearch = initializeEventLocationSearch;
        window.getEventLocationData = getEventLocationData;
        window.setEventLocationData = setEventLocationData;
        window.clearEventLocation = clearEventLocation;

        // Try to initialize on DOM ready if Google Maps is already loaded
        if (window.google && google.maps && google.maps.places) {
            initializeEventLocationSearch();
        }
        
        console.log('MatterCalendar: Scripts initialized successfully');
    })(); // End of IIFE
</script>

@if (ViewBag.GoogleMapsEnabled == true && !string.IsNullOrEmpty(ViewBag.GoogleMapsApiKey))
{
    <script>
        // Google Maps initialization callback must be defined before async load
        window.initGoogleMapsCalendar = function() {
            try {
                console.log('Google Maps API loaded successfully for Calendar');
                window.googleMapsReady = true;
                setTimeout(function() {
                    if (typeof initializeEventLocationSearch === 'function') {
                        initializeEventLocationSearch();
                    } else {
                        console.warn('initializeEventLocationSearch function not found');
                    }
                }, 100);
            } catch (err) {
                console.error('Error in initGoogleMapsCalendar:', err);
            }
        }
    </script>
    <script src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey&libraries=places&callback=initGoogleMapsCalendar" async defer></script>
}
