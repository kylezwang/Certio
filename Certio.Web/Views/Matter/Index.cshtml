@model Certio.Web.ViewModels.MattersViewModel
@{
    ViewData["Title"] = "Matters";
    Layout = "_ClientLayout";
}

<div class="matters-container">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="display-6 fw-bold text-dark mb-2">Matters</h1>
            <p class="lead text-muted">Manage and track your legal matters</p>
        </div>
        <a href="/Client/@ViewBag.OrganizationId/Matter/Create" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="fas fa-plus"></i>
            New Matter
        </a>
    </div>

    <!-- Search and Filters -->
    <div class="row mb-4">
        <div class="col-md-8">
            <div class="search-container">
                <i class="fas fa-search"></i>
                <input type="text" class="form-control" placeholder="Search matters..." />
            </div>
        </div>
        <div class="col-md-4">
            <div class="filter-buttons">
                <button class="filter-button">
                    <i class="fas fa-filter"></i>
                    Filter
                </button>
                <button class="filter-button">
                    <i class="fas fa-calendar"></i>
                    Date Range
                </button>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card h-100  border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="p-3 icon-bg-primary rounded-3 me-3">
                            <i class="fas fa-play-circle text-primary fs-4"></i>
                        </div>
                        <div>
                            <p class="text-muted mb-1 small">Active Matters</p>
                            <h3 class="fw-bold text-dark mb-0">@Model.ActiveMattersCount</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3 mb-3">
            <div class="card h-100  border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="p-3 bg-warning bg-opacity-10 rounded-3 me-3">
                            <i class="fas fa-exclamation-circle text-warning fs-4"></i>
                        </div>
                        <div>
                            <p class="text-muted mb-1 small">In Review</p>
                            <h3 class="fw-bold text-dark mb-0">@Model.InReviewMattersCount</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3 mb-3">
            <div class="card h-100  border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="p-3 bg-success bg-opacity-10 rounded-3 me-3">
                            <i class="fas fa-check-circle text-success fs-4"></i>
                        </div>
                        <div>
                            <p class="mb-1 small"">Completed</p>
                            <h3 class="fw-bold mb-0">@Model.CompletedMattersCount</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3 mb-3">
            <div class="card h-100  border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="p-3 bg-info bg-opacity-10 rounded-3 me-3">
                            <i class="fas fa-users text-info fs-4"></i>
                        </div>
                        <div>
                            <p class="text-muted mb-1 small">Team Members</p>
                            <h3 class="fw-bold text-dark mb-0">@Model.TeamMembersCount</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Matters Grid -->
    <div class="row">
        @foreach (var matter in Model.Matters)
        {
            <div class="col-lg-6 mb-4">
                <div class="card h-100  border-0 matter-card" style="padding-top: 0.5rem;">
                    <div class="card-header bg-transparent border-0 pb-0">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="d-flex align-items-start flex-grow-1">
                                <div class="me-3">
                                    <i class="fas fa-gavel fs-4" style="color: rgba(11, 54, 94, 0.7);"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="card-title fw-bold mb-2" style="color: #0b365e;">@matter.Title</h5>
                                    <p class="card-text text-muted small">@matter.Description</p>
                                </div>
                            </div>
                            <span class="badge @GetPriorityClass(matter.Priority)">@matter.Priority</span>
                        </div>
                    </div>
                    <div class="card-body pt-2">
                        <!-- Status and PracticeArea -->
                        <div class="d-flex align-items-baseline gap-2 mb-3">
                            <i class="@GetStatusIcon(matter.Status)"></i>
                            <span class="badge @GetStatusClass(matter.Status)">@matter.Status</span>
                            <span class="badge bg-secondary">@matter.PracticeArea</span>
                        </div>

                        <!-- Progress -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small">Progress</span>
                                <span class="fw-medium small">@matter.TasksCompleted/@matter.TotalTasks tasks</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-gradient-primary" 
                                     style="width: @(matter.TotalTasks > 0 ? (double)matter.TasksCompleted / matter.TotalTasks * 100 : 0)%"></div>
                            </div>
                        </div>

                        <!-- Meta Info -->
                        <div class="d-flex justify-content-between align-items-center text-muted small mb-3">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-calendar me-1"></i>
                                <span>Due @(matter.DueDate?.ToString("MMM dd, yyyy") ?? "No due date")</span>
                            </div>
                            <div class="d-flex align-items-center">
                                <i class="fas fa-users me-1"></i>
                                <span>@matter.Assignments.Count assignees</span>
                            </div>
                        </div>

                        <!-- Assignees -->
                        <div class="d-flex align-items-center">
                            <span class="text-muted small me-2">Team:</span>
                            <div class="d-flex">
                                @{
                                    var assignees = matter.Assignments.Take(3).ToList();
                                }
                                @for (int i = 0; i < assignees.Count; i++)
                                {
                                    <div class="assignee-avatar me-1">
                                        @GetInitials(assignees[i].User.FirstName + " " + assignees[i].User.LastName)
                                    </div>
                                }
                                @if (matter.Assignments.Count > 3)
                                {
                                    <div class="assignee-avatar me-1 bg-muted text-muted">
                                        +@(matter.Assignments.Count - 3)
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@functions {
    string GetPriorityClass(string priority)
    {
        return priority switch
        {
            "High" => "bg-danger text-white",
            "Medium" => "bg-primary text-white",
            "Low" => "bg-secondary text-white",
            _ => "bg-secondary text-white"
        };
    }

    string GetStatusClass(string status)
    {
        return status switch
        {
            "Completed" => "bg-success text-white",
            "In Progress" => "bg-primary text-white",
            "Review" => "bg-warning text-dark",
            "Planning" => "bg-secondary text-white",
            _ => "bg-secondary text-white"
        };
    }

    string GetStatusIcon(string status)
    {
        return status switch
        {
            "Completed" => "fas fa-check-circle text-success",
            "In Progress" => "fas fa-play-circle text-primary",
            "Review" => "fas fa-exclamation-circle text-warning",
            "Planning" => "fas fa-clock text-muted",
            _ => "fas fa-clock text-muted"
        };
    }

    string GetInitials(string name)
    {
        var parts = name.Split(' ');
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}" : name.Substring(0, Math.Min(2, name.Length));
    }
}

<style>
    .matters-container {
        max-width: 100%;
        margin: 0 auto;
        padding: 0;
    }

    .matter-card {
        transition: all 0.3s ease;
        border-radius: 12px;
    }

    .matter-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.1) !important;
    }

    .assignee-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0b365e, #0b365e);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 600;
        border: 2px solid white;
    }

    .bg-gradient-primary {
        background: linear-gradient(135deg, #0b365e, #0b365e) !important;
    }

    .card {
        border-radius: 12px;
    }

    .badge {
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .progress {
        border-radius: 4px;
        background-color: #e9ecef;
    }

    .progress-bar {
        border-radius: 4px;
    }
</style>
