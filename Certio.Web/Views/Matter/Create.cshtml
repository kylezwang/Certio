                                                                    <h6 class="fw-bold text-dark mb-1">Basic Information</h6>
                                                                    <p class="text-muted mb-0 small">Essential matter details</p>
                                                                </div>
                                                            </div>
                                                            <div class="snapshot-content">
                                                                <div class="mb-2">
                                                                    <strong>Title:</strong> <span class="text-muted">@(string.IsNullOrEmpty(Model.Title) ? "Not specified" : Model.Title)</span>
                                                                </div>
                                                                <div class="mb-2">
                                                                    <strong>Description:</strong> <span class="text-muted">@(string.IsNullOrEmpty(Model.Description) ? "Not specified" : Model.Description)</span>
                                                                </div>
                                                                <div class="mb-2">
                                                                    <strong>Practice Area:</strong> <span class="text-muted">@(string.IsNullOrEmpty(Model.PracticeArea) ? "Not specified" : Model.PracticeArea)</span>
                                                                </div>
                                                                <div class="mb-0">
                                                                    <strong>Matter Type:</strong> <span class="text-muted">@(string.IsNullOrEmpty(Model.MatterType) ? "Not specified" : Model.MatterType)</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Page 2 Snapshot -->
                                                <div class="snapshot-card">
                                                    <div class="card matter-card" style="border: none;">
                                                        <div class="card-body p-4">
                                                            <div class="d-flex align-items-center mb-3">
                                                                <i class="fas fa-cog fs-4 me-3" style="color: #0b365e;"></i>
