                                                                </div>
                                                            </div>
                                                            <div class="snapshot-content">
                                                                <div class="mb-2">
                                                                    <strong>Status:</strong> <span class="text-muted">@(string.IsNullOrEmpty(Model.Status) ? "Not specified" : Model.Status)</span>
                                                                </div>
                                                                <div class="mb-2">
                                                                    <strong>Priority:</strong> <span class="text-muted">@(string.IsNullOrEmpty(Model.Priority) ? "Not specified" : Model.Priority)</span>
                                                                </div>
                                                                <div class="mb-2">
                                                                    <strong>Start Date:</strong> <span class="text-muted">@(Model.StartDate?.ToString("MMM dd, yyyy") ?? "Not specified")</span>
                                                                </div>
                                                                <div class="mb-2">
                                                                    <strong>Due Date:</strong> <span class="text-muted">@(Model.DueDate?.ToString("MMM dd, yyyy") ?? "Not specified")</span>
                                                                </div>
                                                                <div class="mb-0">
                                                                    <strong>Pending Date:</strong> <span class="text-muted">@(Model.PendingDate?.ToString("MMM dd, yyyy") ?? "Not specified")</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Page 3 Snapshot -->
                                                <div class="snapshot-card">
                                                    <div class="card matter-card" style="border: none;">
                                                        <div class="card-body p-4">
                                                            <div class="d-flex align-items-center mb-3">
                                                                <i class="fas fa-building-columns fs-4 me-3" style="color: #0b365e;"></i>
                                                                <div>
                                                                    <h6 class="fw-bold text-dark mb-1">Firm & Contacts</h6>
                                                                    <p class="text-muted mb-0 small">Team assignments and contacts</p>
                                                                </div>
                                                            </div>
                                                            <div class="snapshot-content">
                                                                @{
                                                                    var originatingAttorney = Model.FirmAssignments.FirstOrDefault(fa => fa.AssignmentType == "OriginatingAttorney");
                                                                    var responsibleAttorney = Model.FirmAssignments.FirstOrDefault(fa => fa.AssignmentType == "ResponsibleAttorney");
                                                                    var responsibleStaff = Model.FirmAssignments.FirstOrDefault(fa => fa.AssignmentType == "ResponsibleStaff");
                                                                }
                                                                <div class="mb-2">
                                                                    <strong>Originating Attorney:</strong> <span class="text-muted">@(originatingAttorney != null ? Model.OrgMembers.FirstOrDefault(m => m.Id == originatingAttorney.UserId)?.Name ?? "Not specified" : "Not specified")</span>
                                                                </div>
                                                                <div class="mb-2">
                                                                    <strong>Responsible Attorney:</strong> <span class="text-muted">@(responsibleAttorney != null ? Model.OrgMembers.FirstOrDefault(m => m.Id == responsibleAttorney.UserId)?.Name ?? "Not specified" : "Not specified")</span>
                                                                </div>
                                                                <div class="mb-2">
                                                                    <strong>Responsible Staff:</strong> <span class="text-muted">@(responsibleStaff != null ? Model.OrgMembers.FirstOrDefault(m => m.Id == responsibleStaff.UserId)?.Name ?? "Not specified" : "Not specified")</span>
                                                                </div>
                                                                <div class="mb-0">
