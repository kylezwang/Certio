</style>

@functions {
    string GetPriorityClass(string priority)
    {
        return priority switch
        {
            "High" => "",
            "Medium" => "",
            "Low" => "",
            "Critical" => "",
            _ => ""
        };
    }
    
    string GetPriorityStyles(string priority)
    {
        return priority switch
        {
            "Critical" => "color: #dc3545; background-color: #f5b7b1;",
            "High" => "color: #fd7e14; background-color: #ffeaa7;",
            "Medium" => "color: #0d6efd; background-color: #cfe2ff;",
            "Low" => "color: #6c757d; background-color: #e9ecef;",
            _ => "color: #0d6efd; background-color: #cfe2ff;"
        };
    }

    string GetStatusClass(string status)
    {
        return status switch
        {
            "Completed" => "bg-success text-white",
            "In Progress" => "bg-primary text-white",
            "Review" => "bg-warning text-dark",
            "Planning" => "bg-secondary text-white",
            "On Hold" => "bg-secondary text-white",
            _ => "bg-secondary text-white"
        };
    }

    string GetStatusIcon(string status)
    {
        return status switch
        {
            "Completed" => "fas fa-check-circle text-success",
            "In Progress" => "fas fa-play-circle text-primary",
            "Review" => "fas fa-exclamation-circle text-warning",
            "Planning" => "fas fa-clock text-muted",
            "On Hold" => "fas fa-pause-circle text-muted",
            _ => "fas fa-clock text-muted"
        };
    }
}

@section Scripts {
    <script>
        // Real-time preview updates
        document.addEventListener('DOMContentLoaded', function() {
            const orgMembers = @Html.Raw(Json.Serialize(Model.OrgMembers));
            const initialRelevantContacts = @Html.Raw(Json.Serialize(Model.RelevantContacts));
            // Store current values to maintain state across steps
            let currentValues = {
                title: @Html.Raw(Json.Serialize(Model.Title ?? "")),
                description: @Html.Raw(Json.Serialize(Model.Description ?? "")),
                category: @Html.Raw(Json.Serialize(Model.PracticeArea ?? "")),
                matterType: @Html.Raw(Json.Serialize(Model.MatterType ?? "")),
                status: @Html.Raw(Json.Serialize(Model.Status ?? "")),
                priority: @Html.Raw(Json.Serialize(Model.Priority ?? "")),
                dueDate: @Html.Raw(Json.Serialize(Model.DueDate?.ToString("yyyy-MM-dd") ?? "")),
                startDate: @Html.Raw(Json.Serialize(Model.StartDate?.ToString("yyyy-MM-dd") ?? "")),
                pendingDate: @Html.Raw(Json.Serialize(Model.PendingDate?.ToString("yyyy-MM-dd") ?? "")),
                statuteOfLimitationsDate: @Html.Raw(Json.Serialize(Model.StatuteOfLimitationsDate?.ToString("yyyy-MM-dd") ?? "")),
                firmAssignments: @Html.Raw(Json.Serialize(Model.FirmAssignments.Select(fa => new { 
                    AssignmentType = fa.AssignmentType, 
                    UserId = fa.UserId?.ToString() ?? "", 
                    Role = fa.Role ?? "" 
                })))
            };
            
            const previewTitle = document.querySelector('.card-title');
            const previewDescription = document.querySelector('.card-text');
            const previewPracticeArea = document.querySelector('.category-badge');
            const previewStatus = document.querySelector('.status-badge');
            const previewPriority = document.querySelector('.card-header .badge');
            const previewDueDate = document.querySelector('.due-date-text');
            const previewAssigneesCount = document.querySelector('.assignees-count-text');
            const teamAvatars = document.querySelector('.team-avatars');
            
            function updatePreview() {
                // Update title
                if (previewTitle) {
                    previewTitle.textContent = currentValues.title || 'Your Matter Title';
                }
                
                // Update description
                if (previewDescription) {
                    previewDescription.textContent = currentValues.description || 'Matter description will appear here...';
                }
                
                // Update category
                if (previewPracticeArea) {
                    previewPracticeArea.textContent = currentValues.category || 'PracticeArea';
                }
                
                // Update status
                updateStatusBadge(currentValues.status || 'Planning');
                
                // Update priority
                updatePriorityBadge(currentValues.priority || 'Medium');
                
                // Update due date
                updateDueDate(currentValues.dueDate);
                
                // Update team avatar and assignees count
                updateTeamAvatarAndAssignees();
            }
            
            function updateValue(fieldName, value) {
                currentValues[fieldName] = value;
                updatePreview();
            }
            
            function clearCurrentStepData(step) {
                if (step === 2) {
                    // Clear Step 2 data when going back from Step 2 to Step 1
                    currentValues.status = '';
                    currentValues.priority = '';
                    currentValues.dueDate = '';
                    currentValues.startDate = '';
                    currentValues.pendingDate = '';
                    currentValues.statuteOfLimitationsDate = '';
                } else if (step === 3) {
                    // Clear Step 3 data when going back from Step 3 to Step 2
                    currentValues.firmAssignments = [];
                    currentValues.clientId = '';
                    currentValues.teamId = '';
                }
                updatePreview();
            }
            
            function updateStatusBadge(status) {
                if (!previewStatus) return;
                
                previewStatus.textContent = status;
                previewStatus.className = 'badge ' + getStatusClass(status) + ' status-badge';
                
                // Also update the status icon - target the icon in the status/category row
                const statusIcon = document.querySelector('.card-body .d-flex.align-items-baseline i');
                if (statusIcon) {
                    statusIcon.className = getStatusIcon(status);
                }
            }
            
            function updatePriorityBadge(priority) {
                if (!previewPriority) return;
                
                previewPriority.textContent = priority;
                previewPriority.setAttribute('style', previewPriority.getAttribute('style').replace(/color:[^;]*; background-color:[^;]*;/, '') + ' ' + getPriorityClass(priority));
            }
            
            function updateDueDate(dueDate) {
                if (!previewDueDate) return;
                
                if (dueDate) {
                    const date = new Date(dueDate);
                    const formattedDate = date.toLocaleDateString('en-US', { 
                        year: 'numeric', 
                        month: 'short', 
                        day: '2-digit' 
                    });
                    previewDueDate.textContent = `Due ${formattedDate}`;
                } else {
                    previewDueDate.textContent = 'No due date set';
                }
            }
            
            function getInitials(fullName) {
                if (!fullName) return '?';
                const parts = fullName.trim().split(/\s+/);
                if (parts.length === 1) return parts[0].charAt(0).toUpperCase();
                return (parts[0].charAt(0) + parts[parts.length - 1].charAt(0)).toUpperCase();
            }

            function findMemberById(id) {
                if (!id) return null;
                return orgMembers.find(m => String(m.id) === String(id)) || null;
            }

            function countRelevantContactsSelected() {
                // If on step 3, read from DOM; otherwise use initial model data
                const container = document.getElementById('relevant-contacts-container');
                if (container) {
                    const selects = container.querySelectorAll('select.contact-select');
                    let cnt = 0;
                    selects.forEach(s => { if (s.value && s.value.trim() !== '') cnt++; });
                    return cnt;
                }
                if (Array.isArray(initialRelevantContacts)) {
                    return initialRelevantContacts.filter(rc => rc && rc.userId).length;
                }
                return 0;
            }

            function updateTeamAvatarAndAssignees() {
                // Render avatars for: ResponsibleAttorney, OriginatingAttorney, ResponsibleStaff, plus each selected relevant contact
                if (teamAvatars) {
                    teamAvatars.innerHTML = '';

                    const addedIds = new Set();
                    const avatars = [];

                    // Role members first (preserve order)
                    const roleIds = currentValues.firmAssignments
                        .filter(fa => fa.UserId && String(fa.UserId).trim() !== '')
                        .map(fa => fa.UserId);

                    roleIds.forEach(id => {
                        const key = String(id);
                        if (addedIds.has(key)) return;
                        const m = findMemberById(id);
                        if (!m) return;
                        addedIds.add(key);
                        const el = document.createElement('div');
                        el.className = 'assignee-avatar me-1';
                        el.textContent = getInitials(m.name);
                        avatars.push(el);
                    });

                    // Then contacts, skipping any already added
                    const container = document.getElementById('relevant-contacts-container');
                    if (container) {
                        const selects = container.querySelectorAll('select.contact-select');
                        selects.forEach(s => {
                            const id = s.value;
                            const key = String(id || '');
                            if (!id || key.trim() === '' || addedIds.has(key)) return;
                            const m = findMemberById(id);
                            if (!m) return;
                            addedIds.add(key);
                            const el = document.createElement('div');
                            el.className = 'assignee-avatar me-1';
                            el.textContent = getInitials(m.name);
                            avatars.push(el);
                        });
                    } else if (Array.isArray(initialRelevantContacts)) {
                        initialRelevantContacts.forEach(rc => {
                            if (!rc || !rc.userId) return;
                            const key = String(rc.userId);
                            if (addedIds.has(key)) return;
                            const m = findMemberById(rc.userId);
                            if (!m) return;
                            addedIds.add(key);
                            const el = document.createElement('div');
                            el.className = 'assignee-avatar me-1';
                            el.textContent = getInitials(m.name);
                            avatars.push(el);
                        });
                    }

                    // If none selected, show placeholder +0
                    if (avatars.length === 0) {
                        const placeholder = document.createElement('div');
                        placeholder.className = 'assignee-avatar me-1 bg-muted text-muted';
                        placeholder.style.width = '24px';
                        placeholder.style.height = '24px';
                        placeholder.style.fontSize = '0.6rem';
                        placeholder.textContent = '+0';
                        teamAvatars.appendChild(placeholder);
                    } else {
                        avatars.forEach(a => teamAvatars.appendChild(a));
                    }
                }

                // Count distinct assignees: firm assignments plus relevant contacts
                const allIds = [];
                currentValues.firmAssignments
                    .forEach(fa => { if (fa.UserId && String(fa.UserId).trim() !== '') allIds.push(String(fa.UserId)); });
                const container = document.getElementById('relevant-contacts-container');
                if (container) {
                    const selects = container.querySelectorAll('select.contact-select');
                    selects.forEach(s => { if (s.value && s.value.trim() !== '') allIds.push(String(s.value)); });
                } else if (Array.isArray(initialRelevantContacts)) {
                    initialRelevantContacts.forEach(rc => { if (rc && rc.userId) allIds.push(String(rc.userId)); });
                }
                const totalAssignees = Array.from(new Set(allIds)).length;

                if (previewAssigneesCount) {
                    previewAssigneesCount.textContent = totalAssignees === 1 ? '1 assignee' : `${totalAssignees} assignees`;
                }
            }
            
            function getStatusClass(status) {
                switch(status) {
                    case 'Completed': return 'bg-success text-white';
                    case 'In Progress': return 'bg-primary text-white';
                    case 'Review': return 'bg-warning text-dark';
                    case 'Planning': return 'bg-secondary text-white';
                    case 'On Hold': return 'bg-secondary text-white';
                    default: return 'bg-secondary text-white';
                }
            }
            
            function getPriorityClass(priority) {
                switch(priority) {
                    case 'Critical': return 'color: #dc3545; background-color: #f5b7b1;';
                    case 'High': return 'color: #fd7e14; background-color: #ffeaa7;';
                    case 'Medium': return 'color: #0d6efd; background-color: #cfe2ff;';
                    case 'Low': return 'color: #6c757d; background-color: #e9ecef;';
                    default: return 'color: #0d6efd; background-color: #cfe2ff;';
                }
            }
            
            function getStatusIcon(status) {
                switch(status) {
                    case 'Completed': return 'fas fa-check-circle text-success';
                    case 'In Progress': return 'fas fa-play-circle text-primary';
                    case 'Review': return 'fas fa-exclamation-circle text-warning';
                    case 'Planning': return 'fas fa-clock text-muted';
                    case 'On Hold': return 'fas fa-pause-circle text-muted';
                    default: return 'fas fa-clock text-muted';
                }
            }
            
            // Initialize preview with current values
            updatePreview();
            
            // Add event listeners for current step fields
            const titleInput = document.querySelector('input[name="Title"]');
            const descriptionInput = document.querySelector('textarea[name="Description"]');
            const categorySelect = document.querySelector('select[name="PracticeArea"]');
            const matterTypeSelect = document.querySelector('select[name="MatterType"]');
            const statusSelect = document.querySelector('select[name="Status"]');
            const prioritySelect = document.querySelector('select[name="Priority"]');
            const dueDateInput = document.querySelector('input[name="DueDate"]');
            const startDateInput = document.querySelector('input[name="StartDate"]');
            const pendingDateInput = document.querySelector('input[name="PendingDate"]');
            const statuteOfLimitationsDateInput = document.querySelector('input[name="StatuteOfLimitationsDate"]');
            const firmAssignmentSelects = document.querySelectorAll('select.firm-assignment-select');
            const clientSelect = document.querySelector('select[name="ClientId"]');
            const teamSelect = document.querySelector('select[name="TeamId"]');
            
            if (titleInput) {
                titleInput.addEventListener('input', function() {
                    updateValue('title', this.value);
                });
            }
            
            if (descriptionInput) {
                descriptionInput.addEventListener('input', function() {
                    updateValue('description', this.value);
                });
            }
            
            if (categorySelect) {
                categorySelect.addEventListener('change', function() {
                    updateValue('category', this.value);
                });
            }
            
            if (matterTypeSelect) {
                matterTypeSelect.addEventListener('change', function() {
                    updateValue('matterType', this.value);
                });
            }
            
            if (statusSelect) {
                statusSelect.addEventListener('change', function() {
                    updateValue('status', this.value);
                });
            }
            
            if (prioritySelect) {
                prioritySelect.addEventListener('change', function() {
                    updateValue('priority', this.value);
                });
            }
            
            if (dueDateInput) {
                dueDateInput.addEventListener('change', function() {
                    updateValue('dueDate', this.value);
                });
            }
            
            if (startDateInput) {
                startDateInput.addEventListener('change', function() {
                    updateValue('startDate', this.value);
                });
            }
            
            if (pendingDateInput) {
                pendingDateInput.addEventListener('change', function() {
                    updateValue('pendingDate', this.value);
                });
            }
            
            if (statuteOfLimitationsDateInput) {
                statuteOfLimitationsDateInput.addEventListener('change', function() {
                    updateValue('statuteOfLimitationsDate', this.value);
                });
            }
            
            firmAssignmentSelects.forEach(select => {
                select.addEventListener('change', function() {
                    const assignmentType = this.getAttribute('data-assignment-type');
                    const roleMap = {
                        'ResponsibleAttorney': 'Responsible Attorney',
                        'ResponsibleStaff': 'Responsible Staff',
                        'OriginatingAttorney': 'Originating Attorney'
                    };
                    const role = roleMap[assignmentType] || '';
                    
                    const existingAssignment = currentValues.firmAssignments.find(fa => fa.AssignmentType === assignmentType);
                    if (existingAssignment) {
                        existingAssignment.UserId = this.value;
                        existingAssignment.Role = role;
                    } else {
                        currentValues.firmAssignments.push({
                            AssignmentType: assignmentType,
                            UserId: this.value,
                            Role: role,
                            IsNotifyRecipient: true
                        });
                    }
                    
                    // Update the hidden Role field
                    const roleInput = this.parentElement.querySelector('input[name*="Role"]');
                    if (roleInput) {
                        roleInput.value = role;
                    }
                    
                    updatePreview();
                });
            });
            
            if (clientSelect) {
                clientSelect.addEventListener('change', function() {
                    updateValue('clientId', this.value);
                });
            }
            
            if (teamSelect) {
                teamSelect.addEventListener('change', function() {
                    updateValue('teamId', this.value);
                });
            }
            
            // If on step 3, also update preview when relevant contacts change
            if (@Model.Step === 3) {
                document.addEventListener('change', function(e) {
                    if (e.target && e.target.matches('select.contact-select')) {
                        updateTeamAvatarAndAssignees();
                    }
                });
            }
            
            // Back button now posts with action=previous; client-side handler removed
        });

        // Relevant Contacts Management
        if (@Model.Step === 3) {
            let contactIndex = @Model.RelevantContacts.Count > 0 ? @Model.RelevantContacts.Count : 1;
            
            // Add contact functionality
            document.getElementById('add-contact-btn')?.addEventListener('click', function() {
                const container = document.getElementById('relevant-contacts-container');
                const orgMembers = @Html.Raw(Json.Serialize(Model.OrgMembers));
                
                const newRow = document.createElement('div');
                newRow.className = 'relevant-contact-row mb-3';
                newRow.setAttribute('data-index', contactIndex);
                
                let optionsHtml = '<option value="">What\'s the contact\'s name?</option>';
                orgMembers.forEach(member => {
                    optionsHtml += `<option value="${member.id}">${member.name} (${member.email})</option>`;
                });
                
                newRow.innerHTML = `
                    <div class="container-fluid px-0">
                        <div class="d-flex gap-2 align-items-end">
                            <div class="flex-grow-1 flex-shrink-1" style="flex-basis: 0;">
                                <label class="form-label fw-bold text-dark">Contact</label>
                                <select name="RelevantContacts[${contactIndex}].UserId" class="form-select contact-select" data-index="${contactIndex}">
                                    ${optionsHtml}
                                </select>
                            </div>
                            <div class="flex-grow-1 flex-shrink-1" style="flex-basis: 0;">
                                <label class="form-label fw-bold text-dark">Involvement</label>
                                <input name="RelevantContacts[${contactIndex}].Involvement" class="form-control" placeholder="e.g., Decision maker, Billing contact" />
                            </div>
                            <div class="flex-shrink-0">
                                <button type="button" class="btn btn-outline-danger remove-contact" data-index="${contactIndex}">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="form-check">
                                <input name="RelevantContacts[${contactIndex}].IsNotifyRecipient" class="form-check-input" type="checkbox" checked />
                                <label class="form-check-label">
                                    Notify recipient
                                </label>
                                <i class="fas fa-question-circle text-primary ms-2" data-bs-toggle="tooltip" title="Send notifications about this matter to this contact"></i>
                            </div>
                        </div>
                    </div>
                `;
                
                container.appendChild(newRow);
                contactIndex++;
                
                // Initialize tooltips for the new row
                const tooltipTriggerList = [].slice.call(newRow.querySelectorAll('[data-bs-toggle="tooltip"]'));
                tooltipTriggerList.map(function (tooltipTriggerEl) {
                    return new bootstrap.Tooltip(tooltipTriggerEl);
                });
            });
            
            // Remove contact functionality
            document.addEventListener('click', function(e) {
                if (e.target.closest('.remove-contact')) {
                    const button = e.target.closest('.remove-contact');
                    const row = button.closest('.relevant-contact-row');
                    row.remove();
                }
            });
        }

        // Matter Permissions Management (Step 4)
        if (@Model.Step === 4) {
            const accessEveryoneRadio = document.getElementById('accessEveryone');
            const accessSpecificRadio = document.getElementById('accessSpecific');
            const findUsersSection = document.getElementById('findUsersSection');
            const userSearchInput = document.getElementById('userSearch');
            const searchUsersBtn = document.getElementById('searchUsersBtn');
            const availableUsersList = document.getElementById('availableUsersList');
            const selectedUsersList = document.getElementById('selectedUsersList');
            const form = document.getElementById('matterForm');
            const userCheckboxes = document.querySelectorAll('.user-checkbox');
            
            let selectedUsers = new Set();
            
            // Handle access level radio button changes
            function handleAccessLevelChange() {
                if (accessSpecificRadio.checked) {
                    findUsersSection.style.display = 'block';
                } else {
                    findUsersSection.style.display = 'none';
                    selectedUsers.clear();
                    updateSelectedUsersDisplay();
                }
            }
            
            // Build a stable lookup map from the current DOM to resolve user info
            function buildUserLookup() {
                const map = new Map();
                const items = availableUsersList.querySelectorAll('.user-item');
                items.forEach(el => {
                    const id = String(el.getAttribute('data-user-id') || '');
                    const name = el.getAttribute('data-user-name') || '';
                    const email = el.getAttribute('data-user-email') || '';
                    if (id) map.set(id, { name, email });
                });
                return map;
            }

            // Update selected users display
            function updateSelectedUsersDisplay() {
                const userLookup = buildUserLookup();
                if (selectedUsers.size === 0) {
                    selectedUsersList.innerHTML = '<p class="text-muted mb-0 small">No users or groups selected yet.</p>';
                } else {
                    const badgesHtml = Array.from(selectedUsers).map(userId => {
                        const userIdentification = userLookup.get(String(userId));
                        const userName = (userIdentification && userIdentification.name) ? userIdentification.name : 'Unknown User';
                        const userEmail = (userIdentification && userIdentification.email) ? userIdentification.email : '';
                        return `
                            <span class="selected-user-badge">
                                ${userName}
                                <span class="remove-user" data-user-id="${userId}">
                                    <i class="fas fa-times"></i>
                                </span>
                            </span>
                        `;
                    }).join('');
                    selectedUsersList.innerHTML = badgesHtml;
                }
            }
            
            // Handle user checkbox changes
            function handleUserCheckboxChange(checkbox) {
                const userId = checkbox.value;
                const userItem = checkbox.closest('.user-item');
                
                if (checkbox.checked) {
                    selectedUsers.add(userId);
                    userItem.classList.add('selected');
                } else {
                    selectedUsers.delete(userId);
                    userItem.classList.remove('selected');
                }
                
                updateSelectedUsersDisplay();
            }
            
            // Handle user search
            function handleUserSearch() {
                const searchTerm = userSearchInput.value.toLowerCase();
                const userItems = document.querySelectorAll('.user-item');
                
                userItems.forEach(item => {
                    const userName = item.getAttribute('data-user-name').toLowerCase();
                    const userEmail = item.getAttribute('data-user-email').toLowerCase();
                    
                    if (userName.includes(searchTerm) || userEmail.includes(searchTerm)) {
                        item.style.display = 'block';
                    } else {
                        item.style.display = 'none';
                    }
                });
            }
            
            // Handle remove user from selected list
            function handleRemoveUser(userId) {
                selectedUsers.delete(userId);
                const checkbox = document.getElementById(`user_${userId}`);
                if (checkbox) {
                    checkbox.checked = false;
                    checkbox.closest('.user-item').classList.remove('selected');
                }
                updateSelectedUsersDisplay();
            }
            
            // Event listeners
            accessEveryoneRadio.addEventListener('change', handleAccessLevelChange);
            accessSpecificRadio.addEventListener('change', handleAccessLevelChange);
            
            userCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    handleUserCheckboxChange(this);
                });
            });
            
            userSearchInput.addEventListener('input', handleUserSearch);
            searchUsersBtn.addEventListener('click', handleUserSearch);
            
            // Handle remove user clicks
            selectedUsersList.addEventListener('click', function(e) {
                if (e.target.closest('.remove-user')) {
                    const userId = e.target.closest('.remove-user').getAttribute('data-user-id');
                    handleRemoveUser(userId);
                }
            });
            
            // On submit, write hidden inputs for selected users
            form.addEventListener('submit', function(e) {
                // Only when creating on step 4
                const createAction = e.submitter && e.submitter.name === 'action' && e.submitter.value === 'create';
                if (!createAction) return;
                
                // Clear existing hidden inputs
                const existing = form.querySelectorAll('input[name^="PermissionUserIds["]');
                existing.forEach(el => el.remove());
                
                // Write new hidden inputs
                Array.from(selectedUsers).forEach((id, index) => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = `PermissionUserIds[${index}]`;
                    input.value = id;
                    form.appendChild(input);
                });
            });

            // Initialize
            handleAccessLevelChange();
        }

    </script>
}
