                                        <span>Continue</span>
                                        <i class="fas fa-arrow-right" style="margin-top: 0rem;"></i>
                                    }
                                    else
                                    {
                                        <span>Create Matter</span>
                                        <i class="fas fa-check" style="margin-top: 0rem;"></i>
                                    }
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Column - Matter Preview -->
            <div class="col-lg-4" style="padding-left: 0rem;">
                <div class="card  border-0">
                    <div class="card-body p-3" st>
                        <h5 class="fw-bold text-dark mb-2">Matter Preview</h5>
                        <p class="text-muted mb-4">See how your matter will appear</p>

                        <!-- Matter Card Preview -->
