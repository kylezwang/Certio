@model Certio.Web.ViewModels.MatterFormViewModel
@{
    ViewData["Title"] = "Create Matter";
    Layout = "_ClientLayout";
}

<div class="min-h-screen py-8">
    <div class="container-fluid">
        <!-- Back Navigation -->
        <div class="mb-4">
            <a href="@Url.Action("Index", "Matter")" class="btn btn-ghost d-flex align-items-center gap-2 text-decoration-none">
                <i class="fas fa-arrow-left"></i>
                Back to Matters
            </a>
        </div>

        <!-- Progress Steps -->
        <div class="d-flex align-items-center mb-6">
            <div class="progress-step @(Model.Step >= 1 ? "active" : "")">
                1
            </div>
            <div class="progress-step-label @(Model.Step >= 1 ? "active" : "")">Basic Information</div>
            <div class="progress-line"></div>
            
            <div class="progress-step @(Model.Step >= 2 ? "active" : "")">
                2
            </div>
            <div class="progress-step-label @(Model.Step >= 2 ? "active" : "")">Matter Settings</div>
            <div class="progress-line"></div>
            
            <div class="progress-step @(Model.Step >= 3 ? "active" : "")">
                3
            </div>
            <div class="progress-step-label @(Model.Step >= 3 ? "active" : "")">Firm & Contacts</div>
            <div class="progress-line"></div>
            
            <div class="progress-step @(Model.Step >= 4 ? "active" : "")">
                4
            </div>
            <div class="progress-step-label @(Model.Step >= 4 ? "active" : "")">Review & Create</div>
        </div>

        <div class="row">
            <!-- Left Column - Form -->
            <div class="col-lg-8">
                <div class="card shadow-elegant border-0">
                    <div class="card-body p-4">
                        @if (Model.Step == 1)
                        {
                            <h1 class="display-6 fw-bold text-dark mb-2">Create Your Legal Matter</h1>
                            <p class="lead text-muted" style="font-size: 1.1rem;">Matters help your legal team stay organized, track progress, and manage tasks efficiently. Let's start with some basic information.</p>
                        }
                        else if (Model.Step == 2)
                        {
                            <h1 class="display-6 fw-bold text-dark mb-2">Configure Matter Settings</h1>
                            <p class="lead text-muted" style="font-size: 1.1rem;">Set the timeline, priority, and status for your matter to ensure proper tracking and organization.</p>
                        }
                        else if (Model.Step == 3)
                        {
                            <h1 class="display-6 fw-bold text-dark mb-2">Assign Relevant Attorneys & Contacts</h1>
                            <p class="lead text-muted" style="font-size: 1.1rem;">Select the attorneys and staff members who will be working on this matter to ensure proper collaboration and communication.</p>
                        }
                        else if (Model.Step == 4)
                        {
                            <h1 class="display-6 fw-bold text-dark mb-2">Review & Create</h1>
                            <p class="lead text-muted" style="font-size: 1.1rem;">Review your matter details to finalize creation.</p>
                        }

                        <form asp-action="Create" asp-controller="Matter" method="post" id="matterForm">
                            <input type="hidden" asp-for="Step" />
                            <!-- Persist values from other steps so full state is posted each time -->
                            @if (Model.Step != 1)
                            {
                                <input type="hidden" asp-for="Title" />
                                <input type="hidden" asp-for="Description" />
                                <input type="hidden" asp-for="PracticeArea" />
                                <input type="hidden" asp-for="MatterType" />
                            }
                            @if (Model.Step != 2)
                            {
                                <input type="hidden" asp-for="Status" />
                                <input type="hidden" asp-for="Priority" />
                                <input type="hidden" asp-for="StartDate" />
                                <input type="hidden" asp-for="DueDate" />
                                <input type="hidden" asp-for="PendingDate" />
                                <input type="hidden" asp-for="StatuteOfLimitationsDate" />
                            }
                            @if (Model.Step != 3)
                            {
                                @for (int i = 0; i < Model.FirmAssignments.Count; i++)
                                {
                                    <input type="hidden" name="FirmAssignments[@i].UserId" value="@Model.FirmAssignments[i].UserId" />
                                    <input type="hidden" name="FirmAssignments[@i].AssignmentType" value="@Model.FirmAssignments[i].AssignmentType" />
                                    <input type="hidden" name="FirmAssignments[@i].Role" value="@Model.FirmAssignments[i].Role" />
                                    <input type="hidden" name="FirmAssignments[@i].IsNotifyRecipient" value="@Model.FirmAssignments[i].IsNotifyRecipient" />
                                }
                                @for (int i = 0; i < Model.RelevantContacts.Count; i++)
                                {
                                    <input type="hidden" name="RelevantContacts[@i].UserId" value="@Model.RelevantContacts[i].UserId" />
                                    <input type="hidden" name="RelevantContacts[@i].Involvement" value="@Model.RelevantContacts[i].Involvement" />
                                    <input type="hidden" name="RelevantContacts[@i].IsNotifyRecipient" value="@Model.RelevantContacts[i].IsNotifyRecipient" />
                                }
                            }
                            @if (Model.Step != 4)
                            {
                                <input type="hidden" asp-for="AccessLevel" />
                            }
                            
                            @if (Model.Step == 1)
                            {
                                <!-- Basic Information Section -->
                                <div class="mb-5">
                                    <div class="d-flex align-items-center mb-4">
                                        <i class="fas fa-file-alt fs-4 me-3" style="color: #0b365e;"></i>
                                        <div>
                                            <h3 class="fw-bold text-dark mb-1">Basic Information</h3>
                                            <p class="text-muted mb-0">Provide the essential details for your matter.</p>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-12 mb-4">
                                            <label asp-for="Title" class="form-label fw-bold text-dark">
                                                Matter Title <span class="text-danger">*</span>
                                            </label>
                                            <input asp-for="Title" class="form-control form-control-lg" 
                                                   placeholder="e.g., Contract Review Automation" />
                                            <span asp-validation-for="Title" class="text-danger"></span>
                                        </div>

                                        <div class="col-12 mb-4">
                                            <label asp-for="Description" class="form-label fw-bold text-dark">Description</label>
                                            <textarea asp-for="Description" class="form-control" rows="4" 
                                                      placeholder="Describe what this matter aims to accomplish..."></textarea>
                                            <span asp-validation-for="Description" class="text-danger"></span>
                                        </div>

                                        <div class="col-md-6 mb-4">
                                            <label asp-for="PracticeArea" class="form-label fw-bold text-dark">
                                                <i class="fas fa-gem me-2" style="color: #0b365e;"></i>
                                                Practice Area <span class="text-danger">*</span>
                                            </label>
                                            <select asp-for="PracticeArea" class="form-select form-select-lg">
                                                <option value="">Select practice area</option>
                                                @foreach (var category in Model.PracticeAreas)
                                                {
                                                    <option value="@category">@category</option>
                                                }
                                            </select>
                                            <span asp-validation-for="PracticeArea" class="text-danger"></span>
                                        </div>

                                        <div class="col-md-6 mb-4">
                                            <label asp-for="MatterType" class="form-label fw-bold text-dark">
                                                <i class="fas fa-bars me-2" style="color: #0b365e;"></i>
                                                Matter Type <span class="text-danger">*</span>
                                            </label>
                                            <select asp-for="MatterType" class="form-select form-select-lg">
                                                <option value="">Select matter type</option>
                                                @foreach (var matterType in Model.MatterTypes)
                                                {
                                                    <option value="@matterType">@matterType</option>
                                                }
                                            </select>
                                            <span asp-validation-for="MatterType" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <!-- Example Matter Names -->
                                    <div class="mt-4">
                                        <h6 class="fw-bold mb-3" style="color: #0b365e;">Example matter names:</h6>
                                        <p class="text-muted">Contract Review Automation, Client Portal Dashboard, Compliance Tracking System, Legal Research Assistant</p>
                                    </div>
                                </div>
                            }
                            else if (Model.Step == 2)
                            {
                                <!-- Matter Settings Section -->
                                <div class="mb-5">
                                    <div class="d-flex align-items-center mb-4">
                                        <i class="fas fa-cog fs-4 me-3" style="color: #0b365e;"></i>
                                        <div>
                                            <h3 class="fw-bold text-dark mb-1">Matter Settings</h3>
                                            <p class="text-muted mb-0">Configure timeline, priority, and matter status.</p>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-4">
                                            <label asp-for="Status" class="form-label fw-bold text-dark">
                                                <i class="fas fa-clock me-2" style="color: #0b365e;"></i>
                                                Status <span class="text-danger">*</span>
                                            </label>
                                            <select asp-for="Status" class="form-select form-select-lg">
                                                <option value="">Select matter status</option>
                                                @foreach (var status in Model.Statuses)
                                                {
                                                    <option value="@status">@status</option>
                                                }
                                            </select>
                                            <span asp-validation-for="Status" class="text-danger"></span>
                                        </div>

                                        <div class="col-md-6 mb-4">
                                            <label asp-for="Priority" class="form-label fw-bold text-dark">
                                                <i class="fas fa-flag me-2" style="color: #0b365e;"></i>
                                                Priority <span class="text-danger">*</span>
                                            </label>
                                            <select asp-for="Priority" class="form-select form-select-lg">
                                                <option value="">Select matter priority</option>
                                                @foreach (var priority in Model.Priorities)
                                                {
                                                    <option value="@priority">@priority</option>
                                                }
                                            </select>
                                            <span asp-validation-for="Priority" class="text-danger"></span>
                                        </div>

                                        <div class="col-md-6 mb-4">
                                            <label asp-for="StartDate" class="form-label fw-bold text-dark">
                                                <i class="fas fa-calendar me-2" style="color: #0b365e;"></i>
                                                Start Date
                                            </label>
                                            <input asp-for="StartDate" type="date" class="form-control form-control-lg" 
                                                   placeholder="Pick start date" />
                                            <span asp-validation-for="StartDate" class="text-danger"></span>
                                        </div>

                                        <div class="col-md-6 mb-4">
                                            <label asp-for="DueDate" class="form-label fw-bold text-dark">
                                                <i class="fas fa-calendar me-2" style="color: #0b365e;"></i>
                                                Due Date
                                            </label>
                                            <input asp-for="DueDate" type="date" class="form-control form-control-lg" 
                                                   placeholder="Pick due date" />
                                            <span asp-validation-for="DueDate" class="text-danger"></span>
                                        </div>

                                        <div class="col-md-6 mb-4">
                                            <label asp-for="PendingDate" class="form-label fw-bold text-dark">
                                                <i class="fas fa-calendar me-2" style="color: #0b365e;"></i>
                                                Pending Date
                                            </label>
                                            <input asp-for="PendingDate" type="date" class="form-control form-control-lg" 
                                                   placeholder="Pick pending date" />
                                            <span asp-validation-for="PendingDate" class="text-danger"></span>
                                        </div>

                                        <div class="col-md-6 mb-4">
                                            <label asp-for="StatuteOfLimitationsDate" class="form-label fw-bold text-dark">
                                                <i class="fas fa-calendar me-2" style="color: #0b365e;"></i>
                                                Statute of Limitations Date
                                            </label>
                                            <input asp-for="StatuteOfLimitationsDate" type="date" class="form-control form-control-lg" 
                                                   placeholder="Pick statute of limitations date" />
                                            <span asp-validation-for="StatuteOfLimitationsDate" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <!-- Matter Timeline Tips -->
                                    <div class="mt-4">
                                        <h6 class="fw-bold mb-3" style="color: #0b365e;">Matter timeline tips:</h6>
                                        <p class="text-muted">Set realistic deadlines based on matter complexity. High priority matters will be highlighted in the dashboard and receive more attention from the team.</p>
                                    </div>
                                </div>
                            }
                            else if (Model.Step == 3)
                            {
                                <!-- Attorney Assignments Section -->
                                <div class="mb-4">
                                    <div class="d-flex align-items-center mb-4">
                                        <i class="fas fa-building-columns fs-4 me-3" style="color: #0b365e;"></i>
                                        <div>
                                            <h3 class="fw-bold text-dark mb-1">Firm assignments</h3>
                                            <p class="text-muted mb-0">Assign attorneys and staff responsible for this matter.</p>
                                        </div>
                                    </div>

                                    <!-- Firm Assignments -->
                                    <div id="firm-assignments-container">
                                        @if (Model.FirmAssignments.Count == 0)
                                        {
                                            <!-- Default firm assignment rows -->
                                            <div class="row">
                                                <div class="col-md-6 mb-4">
                                                    <label class="form-label fw-bold text-dark">
                                                        <i class="fas fa-user-tie me-2" style="color: #0b365e;"></i>
                                                        Responsible Attorney
                                                    </label>
                                                    <select name="FirmAssignments[0].UserId" class="form-select form-select-lg firm-assignment-select" data-assignment-type="ResponsibleAttorney">
                                                        <option value="">Select responsible attorney</option>
                                                        @foreach (var member in Model.OrgMembers)
                                                        {
                                                            <option value="@member.Id">@member.Name (@member.Email)</option>
                                                        }
                                                    </select>
                                                    <input type="hidden" name="FirmAssignments[0].AssignmentType" value="ResponsibleAttorney" />
                                                    <input type="hidden" name="FirmAssignments[0].Role" value="Responsible Attorney" />
                                                    <input type="hidden" name="FirmAssignments[0].IsNotifyRecipient" value="true" />
                                                </div>
                                                
                                                <div class="col-md-6 mb-4">
                                                    <label class="form-label fw-bold text-dark">
                                                        <i class="fas fa-user me-2" style="color: #0b365e;"></i>
                                                        Responsible Staff
                                                    </label>
                                                    <select name="FirmAssignments[1].UserId" class="form-select form-select-lg firm-assignment-select" data-assignment-type="ResponsibleStaff">
                                                        <option value="">Select responsible staff</option>
                                                        @foreach (var member in Model.OrgMembers)
                                                        {
                                                            <option value="@member.Id">@member.Name (@member.Email)</option>
                                                        }
                                                    </select>
                                                    <input type="hidden" name="FirmAssignments[1].AssignmentType" value="ResponsibleStaff" />
                                                    <input type="hidden" name="FirmAssignments[1].Role" value="Responsible Staff" />
                                                    <input type="hidden" name="FirmAssignments[1].IsNotifyRecipient" value="true" />
                                                </div>
                                            </div>
                                            
                                            <div class="row mb-4">
                                                <div class="col-12 mb-4">
                                                    <label class="form-label fw-bold text-dark">
                                                        <i class="fas fa-user-tie me-2" style="color: #0b365e;"></i>
                                                        Originating Attorney
                                                    </label>
                                                    <select name="FirmAssignments[2].UserId" class="form-select form-select-lg firm-assignment-select" data-assignment-type="OriginatingAttorney">
                                                        <option value="">Select originating attorney</option>
                                                        @foreach (var member in Model.OrgMembers)
                                                        {
                                                            <option value="@member.Id">@member.Name (@member.Email)</option>
                                                        }
                                                    </select>
                                                    <input type="hidden" name="FirmAssignments[2].AssignmentType" value="OriginatingAttorney" />
                                                    <input type="hidden" name="FirmAssignments[2].Role" value="Originating Attorney" />
                                                    <input type="hidden" name="FirmAssignments[2].IsNotifyRecipient" value="true" />
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <!-- Render firm assignments in proper order and layout -->
                                            <div class="row">
                                                <div class="col-md-6 mb-4">
                                                    <label class="form-label fw-bold text-dark">
                                                        <i class="fas fa-user-tie me-2" style="color: #0b365e;"></i>
                                                        Responsible Attorney
                                                    </label>
                                                    <select class="form-select form-select-lg firm-assignment-select" data-assignment-type="ResponsibleAttorney">
                                                        <option value="">Select responsible attorney</option>
                                                        @foreach (var member in Model.OrgMembers)
                                                        {
                                                            <option value="@member.Id" selected="@(Model.FirmAssignments.FirstOrDefault(fa => fa.AssignmentType == "ResponsibleAttorney")?.UserId == member.Id)">@member.Name (@member.Email)</option>
                                                        }
                                                    </select>
                                                    <input type="hidden" name="FirmAssignments[0].AssignmentType" value="ResponsibleAttorney" />
                                                    <input type="hidden" name="FirmAssignments[0].Role" value="Responsible Attorney" />
                                                    <input type="hidden" name="FirmAssignments[0].IsNotifyRecipient" value="true" />
                                                </div>
                                                
                                                <div class="col-md-6 mb-4">
                                                    <label class="form-label fw-bold text-dark">
                                                        <i class="fas fa-user me-2" style="color: #0b365e;"></i>
                                                        Responsible Staff
                                                    </label>
                                                    <select class="form-select form-select-lg firm-assignment-select" data-assignment-type="ResponsibleStaff">
                                                        <option value="">Select responsible staff</option>
                                                        @foreach (var member in Model.OrgMembers)
                                                        {
                                                            <option value="@member.Id" selected="@(Model.FirmAssignments.FirstOrDefault(fa => fa.AssignmentType == "ResponsibleStaff")?.UserId == member.Id)">@member.Name (@member.Email)</option>
                                                        }
                                                    </select>
                                                    <input type="hidden" name="FirmAssignments[1].AssignmentType" value="ResponsibleStaff" />
                                                    <input type="hidden" name="FirmAssignments[1].Role" value="Responsible Staff" />
                                                    <input type="hidden" name="FirmAssignments[1].IsNotifyRecipient" value="true" />
                                                </div>
                                            </div>
                                            
                                            <div class="row mb-4">
                                                <div class="col-12 mb-4">
                                                    <label class="form-label fw-bold text-dark">
                                                        <i class="fas fa-user-tie me-2" style="color: #0b365e;"></i>
                                                        Originating Attorney
                                                    </label>
                                                    <select class="form-select form-select-lg firm-assignment-select" data-assignment-type="OriginatingAttorney">
                                                        <option value="">Select originating attorney</option>
                                                        @foreach (var member in Model.OrgMembers)
                                                        {
                                                            <option value="@member.Id" selected="@(Model.FirmAssignments.FirstOrDefault(fa => fa.AssignmentType == "OriginatingAttorney")?.UserId == member.Id)">@member.Name (@member.Email)</option>
                                                        }
                                                    </select>
                                                    <input type="hidden" name="FirmAssignments[2].AssignmentType" value="OriginatingAttorney" />
                                                    <input type="hidden" name="FirmAssignments[2].Role" value="Originating Attorney" />
                                                    <input type="hidden" name="FirmAssignments[2].IsNotifyRecipient" value="true" />
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Relevant Contacts Section -->
                                <div class="mb-5">
                                    <div class="d-flex align-items-center mb-4">
                                        <i class="fas fa-users fs-4 me-3" style="color: #0b365e;"></i>
                                        <div>
                                            <h3 class="fw-bold text-dark mb-1">Relevant contacts</h3>
                                            <p class="text-muted mb-0">Add contacts who are involved with this matter.</p>
                                        </div>
                                    </div>

                                    <!-- Information Box -->
                                    <div class="alert alert-info mb-4">
                                        <i class="fas fa-info-circle me-2"></i>
                                        Information for relevant contacts appears on the matter dashboard.
                                    </div>

                                    <!-- Relevant Contacts List -->
                                    <div id="relevant-contacts-container">
                                        @if (Model.RelevantContacts.Count == 0)
                                        {
                                            <!-- Default empty row -->
                                            <div class="relevant-contact-row mb-3" data-index="0">
                                                <div class="container-fluid px-0">
                                                    <div class="d-flex gap-2 align-items-end">
                                                        <div class="flex-grow-1 flex-shrink-1" style="flex-basis: 0;">
                                                            <label class="form-label fw-bold text-dark">Contact</label>
                                                            <select name="RelevantContacts[0].UserId" class="form-select contact-select" data-index="0">
                                                                <option value="">What's the contact's name?</option>
                                                                @foreach (var member in Model.OrgMembers)
                                                                {
                                                                    <option value="@member.Id">@member.Name (@member.Email)</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="flex-grow-1 flex-shrink-1" style="flex-basis: 0;">
                                                            <label class="form-label fw-bold text-dark">Involvement</label>
                                                            <input name="RelevantContacts[0].Involvement" class="form-control" placeholder="e.g., Decision maker, Billing contact" />
                                                        </div>
                                                        <div class="flex-shrink-0">
                                                            <button type="button" class="btn btn-outline-danger remove-contact" data-index="0">
                                                                <i class="fas fa-times"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row mt-3">
                                                    <div class="col-12">
                                                        <div class="form-check">
                                                            <input name="RelevantContacts[0].IsNotifyRecipient" class="form-check-input" type="checkbox" checked />
                                                            <label class="form-check-label">
                                                                Notify recipient
                                                            </label>
                                                            <i class="fas fa-question-circle text-primary ms-2" data-bs-toggle="tooltip" title="Send notifications about this matter to this contact"></i>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            @for (int i = 0; i < Model.RelevantContacts.Count; i++)
                                            {
                                                <div class="relevant-contact-row mb-3" data-index="@i">
                                                    <div class="container-fluid px-0">
                                                        <div class="d-flex gap-2 align-items-end">
                                                            <div class="flex-grow-1 flex-shrink-1" style="flex-basis: 0;">
                                                                <label class="form-label fw-bold text-dark">Contact</label>
                                                                <select asp-for="RelevantContacts[i].UserId" class="form-select contact-select" data-index="@i">
                                                                    <option value="">What's the contact's name?</option>
                                                                    @foreach (var member in Model.OrgMembers)
                                                                    {
                                                                        <option value="@member.Id">@member.Name (@member.Email)</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                            <div class="flex-grow-1 flex-shrink-1" style="flex-basis: 0;">
                                                                <label class="form-label fw-bold text-dark">Involvement</label>
                                                                <input asp-for="RelevantContacts[i].Involvement" class="form-control" placeholder="e.g., Decision maker, Billing contact" />
                                                            </div>
                                                            <div class="flex-shrink-0">
                                                                <button type="button" class="btn btn-outline-danger remove-contact" data-index="@i">
                                                                    <i class="fas fa-times"></i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row mt-3">
                                                        <div class="col-12">
                                                            <div class="form-check">
                                                                <input asp-for="RelevantContacts[i].IsNotifyRecipient" class="form-check-input" type="checkbox" />
                                                                <label asp-for="RelevantContacts[i].IsNotifyRecipient" class="form-check-label">
                                                                    Notify recipient
                                                                </label>
                                                                <i class="fas fa-question-circle text-primary ms-2" data-bs-toggle="tooltip" title="Send notifications about this matter to this contact"></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>

                                    <!-- Add Contact Button -->
                                    <div class="mt-3">
                                        <button type="button" id="add-contact-btn" class="btn btn-outline-primary">
                                            <i class="fas fa-plus me-2"></i>Add contact
                                        </button>
                                    </div>
                                </div>
                            }
                            else if (Model.Step == 4)
                            {
                                <!-- Review & Create Section -->
                                <div class="mb-5">
                                    <div class="d-flex align-items-center mb-4">
                                        <i class="fas fa-eye fs-4 me-3" style="color: #0b365e;"></i>
                                        <div>
                                            <h3 class="fw-bold text-dark mb-1">Review & Create</h3>
                                            <p class="text-muted mb-0">Review your matter details and set permissions before creating.</p>
                                        </div>
                                    </div>

                                    <!-- Snapshot Container -->
                                    <div class="mb-5">
                                        <h5 class="fw-bold text-dark mb-3">Matter Summary</h5>
                                        <div class="snapshot-container">
                                            <div class="snapshot-slider">
