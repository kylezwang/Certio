</div>

@section Scripts {
    <script src="~/js/matter-details.js"></script>
    <script src="~/js/matter-info-carousel.js"></script>
    <script>
        const matterId = @Model.Matter.Id;
        const organizationId = @ViewBag.OrganizationId;
        let allUsers = [];
        let hasUnsavedChanges = false;
        let pendingAssignmentChanges = {}; // Store pending assignment changes
        let pendingMatterChanges = {}; // Store pending matter field changes

        // Store original values for comparison
        const originalValues = {
            title: '@Html.Raw(Model.Matter.Title.Replace("'", "\\'"))',
            description: '@Html.Raw((Model.Matter.Description ?? "").Replace("'", "\\'"))',
            status: '@Model.Matter.Status',
            practiceArea: '@Model.Matter.PracticeArea',
            startDate: '@(Model.Matter.StartDate?.ToString("yyyy-MM-dd") ?? "")',
            dueDate: '@(Model.Matter.DueDate?.ToString("yyyy-MM-dd") ?? "")',
            pendingDate: '@(Model.Matter.PendingDate?.ToString("yyyy-MM-dd") ?? "")',
            statuteOfLimitationsDate: '@(Model.Matter.StatuteOfLimitationsDate?.ToString("yyyy-MM-dd") ?? "")'
        };

        // Initialize change detection for all carousel inputs
        function initializeCarouselInputs() {
            const carouselInputs = document.querySelectorAll('.matter-carousel-input');
            carouselInputs.forEach(input => {
                const fieldName = input.dataset.field;
                const originalValue = originalValues[fieldName] || '';
                
                input.addEventListener('input', function() {
                    const currentValue = this.value || '';
                    if (currentValue !== originalValue) {
                        pendingMatterChanges[fieldName] = currentValue;
                        showSaveIndicator();
                    } else {
                        delete pendingMatterChanges[fieldName];
                        if (Object.keys(pendingMatterChanges).length === 0 && Object.keys(pendingAssignmentChanges).length === 0) {
                            hideSaveIndicator();
                        }
                    }
                });
                
                input.addEventListener('change', function() {
                    const currentValue = this.value || '';
                    if (currentValue !== originalValue) {
                        pendingMatterChanges[fieldName] = currentValue;
                        showSaveIndicator();
                    } else {
                        delete pendingMatterChanges[fieldName];
                        if (Object.keys(pendingMatterChanges).length === 0 && Object.keys(pendingAssignmentChanges).length === 0) {
                            hideSaveIndicator();
                        }
                    }
                });
            });
        }

        // Initialize on DOMContentLoaded or immediately if already loaded
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeCarouselInputs);
        } else {
            // DOM is already loaded, run initialization immediately
            initializeCarouselInputs();
        }

        // Function to show save indicator
        function showSaveIndicator() {
            hasUnsavedChanges = true;
            const saveBtn = document.getElementById('matterCarouselSaveBtn');
            if (saveBtn) {
                saveBtn.style.display = 'block';
            }
        }

        // Function to hide save indicator
        function hideSaveIndicator() {
            hasUnsavedChanges = false;
            const saveBtn = document.getElementById('matterCarouselSaveBtn');
            if (saveBtn) {
                saveBtn.style.display = 'none';
            }
        }

        // Function to save changes to backend
        async function saveMatterCarouselChanges() {
            const hasAssignmentChanges = Object.keys(pendingAssignmentChanges).length > 0;
            const hasMatterChanges = Object.keys(pendingMatterChanges).length > 0;
            
            if (!hasUnsavedChanges || (!hasAssignmentChanges && !hasMatterChanges)) {
                hideSaveIndicator();
                return;
            }

            try {
                const roleMap = {
                    'ResponsibleAttorney': 'Responsible Attorney',
                    'ResponsibleStaff': 'Responsible Staff',
                    'OriginatingAttorney': 'Originating Attorney'
                };

                // Save assignment changes
                if (hasAssignmentChanges) {
                    for (const [assignmentType, change] of Object.entries(pendingAssignmentChanges)) {
                        const { userId, assignmentId, clearAssignment } = change;

                        if (clearAssignment) {
                            // Remove assignment
                            if (assignmentId > 0) {
                                const removeResponse = await fetch(`/Client/${organizationId}/Matter/${matterId}/Assignment/${assignmentId}`, {
                                    method: 'DELETE',
                                    credentials: 'include',
                                    headers: {
                                        'Content-Type': 'application/json'
                                    }
                                });

                                if (!removeResponse.ok) {
                                    const errorData = await removeResponse.json();
                                    console.error('Error removing assignment:', errorData);
                                    alert(`Error removing ${assignmentType} assignment. Please try again.`);
                                    return;
                                }
                            }
                        } else if (userId > 0) {
                            // Add/update assignment
                            const assignResponse = await fetch(`/Client/${organizationId}/Matter/${matterId}/Assignment`, {
                                method: 'POST',
                                credentials: 'include',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({
                                    userId: userId,
                                    assignmentType: assignmentType,
                                    role: roleMap[assignmentType] || '',
                                    isNotifyRecipient: true
                                })
                            });

                            if (!assignResponse.ok) {
                                const errorData = await assignResponse.json();
                                console.error('Error assigning user:', errorData);
                                alert(`Error assigning ${assignmentType}. Please try again.`);
                                return;
                            }
                        }
                    }
                }

                // Save matter field changes
                if (hasMatterChanges) {
                    // Convert empty date strings to null
                    const dateFields = ['startDate', 'dueDate', 'pendingDate', 'statuteOfLimitationsDate'];
                    const updatePayload = { ...pendingMatterChanges };
                    dateFields.forEach(field => {
                        if (updatePayload[field] === '') {
                            updatePayload[field] = null;
                        }
                    });
                    
                    const updateResponse = await fetch(`/Client/${organizationId}/Matter/${matterId}`, {
                        method: 'PUT',
                        credentials: 'include',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(updatePayload)
                    });

                    if (!updateResponse.ok) {
                        const errorData = await updateResponse.json();
                        console.error('Error updating matter:', errorData);
                        alert('Error updating matter fields. Please try again.');
                        return;
                    }
                }

                // Clear pending changes and refresh page
                pendingAssignmentChanges = {};
                pendingMatterChanges = {};
                hideSaveIndicator();
                location.reload();

            } catch (error) {
                console.error('Error saving changes:', error);
                alert('An error occurred while saving changes. Please try again.');
            }
        }

        // Load users for assignment popup
        async function loadUsersForAssignment() {
            if (allUsers.length > 0) return allUsers;
            
            try {
                const response = await fetch(`/Client/${organizationId}/Matter/${matterId}/Users`, {
                    credentials: 'include'
                });
                if (response.ok) {
                    const result = await response.json();
                    if (result.success && result.users) {
                        allUsers = result.users.map(u => ({
                            id: u.id,
                            name: u.name || `${u.firstName || ''} ${u.lastName || ''}`.trim(),
                            initials: u.initials || `${(u.firstName || '')[0] || ''}${(u.lastName || '')[0] || ''}`.toUpperCase(),
                            email: u.email
                        }));
                    }
                }
            } catch (error) {
                console.error('Error loading users:', error);
            }
            return allUsers;
        }

        // Show matter assignment popup (single-select for assignment type)
        async function showMatterAssignmentPopup(button) {
            const assignmentType = button.dataset.assignmentType;
            const assignmentId = parseInt(button.dataset.assignmentId) || 0;
            const currentUserId = parseInt(button.dataset.currentUserId) || 0;
            
            // Get assignment type label
            const assignmentLabels = {
                'ResponsibleAttorney': 'Responsible Attorney',
                'ResponsibleStaff': 'Responsible Staff',
                'OriginatingAttorney': 'Originating Attorney'
            };
            const assignmentLabel = assignmentLabels[assignmentType] || assignmentType;
            
            // Load users
            await loadUsersForAssignment();
            
            // Create popup container
            const popup = document.createElement('div');
            popup.className = 'matter-assignment-popup';
            
            // Get button position
            const btnRect = button.getBoundingClientRect();
            
            // Position popup to the right of the button
            popup.style.cssText = `
                position: fixed;
                top: ${btnRect.top}px;
                left: ${btnRect.right + 10}px;
                background: white;
                border-radius: 0.5rem;
                padding: 1rem;
                width: 400px;
                max-height: 500px;
                overflow-y: auto;
                box-shadow: 0 4px 20px rgba(0,0,0,0.15);
                border: 1px solid #dee2e6;
                z-index: 1100;
            `;
            
            // Adjust if popup would go off-screen to the right
            const popupWidth = 400;
            const screenWidth = window.innerWidth;
            if (btnRect.right + popupWidth + 10 > screenWidth) {
                // Position to the left instead
                popup.style.left = `${btnRect.left - popupWidth - 10}px`;
            }
            
            // Adjust if popup would go off-screen at the bottom
            const popupHeight = 500;
            const screenHeight = window.innerHeight;
            if (btnRect.top + popupHeight > screenHeight) {
                popup.style.top = `${Math.max(10, screenHeight - popupHeight - 10)}px`;
            }
            
            // Currently selected user
            let selectedUserId = currentUserId;
            
            popup.innerHTML = `
                <div class="mb-2">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-user-plus me-2" style="color: #3d1019; font-size: 1rem;"></i>
                            <div>
                                <h6 class="fw-bold text-dark mb-0" style="font-size: 0.9rem;">Select ${assignmentLabel}</h6>
                                <p class="text-muted mb-0" style="font-size: 0.75rem;">Choose a user for this assignment.</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="mb-2">
                    <label class="form-label fw-bold text-dark mb-1" style="font-size: 0.85rem;">Search Users</label>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control" id="matterAssignmentUserSearch" placeholder="Search by name or email..." style="font-size: 0.875rem;">
                        <button class="btn btn-outline-secondary" type="button">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
                
                <div class="mb-2">
                    <label class="form-label fw-bold text-dark mb-1" style="font-size: 0.85rem;">Selected User</label>
                    <div id="matterAssignmentSelectedUser" class="border rounded p-2" style="min-height: 50px; background-color: #f8f9fa; font-size: 0.875rem;">
                        <p class="text-muted mb-0 small">No user selected yet.</p>
                    </div>
                </div>
                
                <div class="mb-2">
                    <label class="form-label fw-bold text-dark mb-1" style="font-size: 0.85rem;">Available Users</label>
                    <div id="matterAssignmentAvailableUsers" class="border rounded" style="max-height: 10rem; overflow-y: auto; padding-left: 1.75rem;">
                        <!-- Users will be loaded here -->
                    </div>
                </div>
                
                <div class="d-flex justify-content-end gap-2 mt-2">
                    <button class="btn btn-secondary btn-sm" id="matterAssignmentCancel" style="border-radius: 0.5rem;">Cancel</button>
                    <button class="btn btn-primary btn-sm" id="matterAssignmentDone" style="border-radius: 0.5rem;">Done</button>
                </div>
            `;
            
            document.body.appendChild(popup);
            
            const availableUsersList = popup.querySelector('#matterAssignmentAvailableUsers');
            const selectedUserDisplay = popup.querySelector('#matterAssignmentSelectedUser');
            const searchInput = popup.querySelector('#matterAssignmentUserSearch');
            
            function renderUsers(filterText = '') {
                if (!allUsers || allUsers.length === 0) {
                    availableUsersList.innerHTML = '<p class="text-muted mb-0" style="font-size: 0.75rem;">No users available.</p>';
                    return;
                }
                
                const filtered = allUsers.filter(u => 
                    !filterText || 
                    u.name.toLowerCase().includes(filterText.toLowerCase()) || 
                    (u.email && u.email.toLowerCase().includes(filterText.toLowerCase()))
                );
                
                availableUsersList.innerHTML = filtered.map(user => `
                    <div class="form-check user-item" style="padding: 0.4rem;">
                        <input class="form-check-input user-radio" type="radio" 
                               name="matterAssignmentUser" 
                               id="matter_user_${user.id}" 
                               value="${user.id}"
                               ${selectedUserId === user.id ? 'checked' : ''}
                               style="margin-top: 0.75rem;">
                        <label class="form-check-label" for="matter_user_${user.id}" style="cursor: pointer; font-size: 0.875rem;">
                            <strong>${user.name}</strong>
                            ${user.email ? `<small class="text-muted d-block" style="font-size: 0.75rem;">${user.email}</small>` : ''}
                        </label>
                    </div>
                `).join('');
                
                // Add "None" option at the top to clear assignment
                const noneOption = `
                    <div class="form-check user-item" style="padding: 0.4rem; border-bottom: 1px solid #dee2e6; margin-bottom: 0.25rem;">
                        <input class="form-check-input user-radio" type="radio" 
                               name="matterAssignmentUser" 
                               id="matter_user_0" 
                               value="0"
                               ${selectedUserId === 0 ? 'checked' : ''}
                               style="margin-top: 0.75rem;">
                        <label class="form-check-label" for="matter_user_0" style="cursor: pointer; font-size: 0.875rem;">
                            <strong class="text-muted">None (Clear assignment)</strong>
                        </label>
                    </div>
                `;
                availableUsersList.innerHTML = noneOption + availableUsersList.innerHTML;
                
                // Add radio event listeners
                const radios = availableUsersList.querySelectorAll('.user-radio');
                radios.forEach(radio => {
                    radio.addEventListener('change', function() {
                        selectedUserId = parseInt(this.value);
                        updateSelectedDisplay();
                    });
                    
                    // Also handle click event for immediate feedback
                    radio.addEventListener('click', function() {
                        selectedUserId = parseInt(this.value);
                        updateSelectedDisplay();
                    });
                });
                
                // Also handle clicks on labels (since clicking label triggers radio change)
                const labels = availableUsersList.querySelectorAll('label[for^="matter_user_"]');
                labels.forEach(label => {
                    label.addEventListener('click', function(e) {
                        const radioId = this.getAttribute('for');
                        const radioBtn = document.getElementById(radioId);
                        if (radioBtn) {
                            // Trigger change event
                            radioBtn.checked = true;
                            selectedUserId = parseInt(radioBtn.value);
                            updateSelectedDisplay();
                        }
                    });
                });
            }
            
            function updateSelectedDisplay() {
                if (selectedUserId === 0) {
                    selectedUserDisplay.innerHTML = '<p class="text-muted mb-0 small">No user selected (assignment will be cleared).</p>';
                    return;
                }
                
                const selectedUser = allUsers.find(u => u.id === selectedUserId);
                if (selectedUser) {
                    const initials = selectedUser.initials || selectedUser.name.split(' ').map(n => n[0]).join('').toUpperCase().substring(0, 2);
                    selectedUserDisplay.innerHTML = `
                        <div class="d-flex align-items-center gap-2">
                            <div class="member-avatar" style="width: 2rem; height: 2rem; font-size: 0.75rem;">
                                ${initials}
                            </div>
                            <div>
                                <div class="fw-bold" style="font-size: 0.875rem;">${selectedUser.name}</div>
                                ${selectedUser.email ? `<small class="text-muted d-block" style="font-size: 0.75rem;">${selectedUser.email}</small>` : ''}
                            </div>
                        </div>
                    `;
                } else {
                    selectedUserDisplay.innerHTML = '<p class="text-muted mb-0 small">No user selected yet.</p>';
                }
            }
            
            // Initialize display
            renderUsers();
            updateSelectedDisplay();
            
            // Ensure selectedUserId is properly initialized for display
            if (currentUserId > 0) {
                selectedUserId = currentUserId;
                updateSelectedDisplay();
            }
            
            // Search functionality
            searchInput.addEventListener('input', function() {
                renderUsers(this.value);
                // Update display after re-rendering to ensure selected user is shown
                updateSelectedDisplay();
            });
            
            // Handle Done button - only update UI, don't save to backend
            popup.querySelector('#matterAssignmentDone').addEventListener('click', function() {
                if (selectedUserId === currentUserId) {
                    // No change
                    popup.remove();
                    document.removeEventListener('click', outsideClickHandler);
                    return;
                }
                
                // Update UI only
                const roleMap = {
                    'ResponsibleAttorney': 'Responsible Attorney',
                    'ResponsibleStaff': 'Responsible Staff',
                    'OriginatingAttorney': 'Originating Attorney'
                };
                
                // Update the input field
                const inputId = assignmentType === 'ResponsibleAttorney' ? 'responsibleAttorneyInput' :
                               assignmentType === 'ResponsibleStaff' ? 'responsibleStaffInput' :
                               'originatingAttorneyInput';
                const input = document.getElementById(inputId);
                
                if (selectedUserId === 0) {
                    // Clearing assignment
                    if (input) {
                        input.value = 'Not specified';
                    }
                    // Store pending change
                    pendingAssignmentChanges[assignmentType] = {
                        userId: 0,
                        assignmentId: assignmentId,
                        clearAssignment: true
                    };
                    button.dataset.currentUserId = '0';
                    button.dataset.assignmentId = '0';
                } else {
                    // Assigning user
                    const selectedUser = allUsers.find(u => u.id === selectedUserId);
                    if (input && selectedUser) {
                        input.value = selectedUser.name;
                    }
                    // Store pending change
                    pendingAssignmentChanges[assignmentType] = {
                        userId: selectedUserId,
                        assignmentType: assignmentType,
                        assignmentId: assignmentId,
                        clearAssignment: false
                    };
                    button.dataset.currentUserId = selectedUserId;
                }
                
                // Show save indicator
                showSaveIndicator();
                
                // Close popup
                popup.remove();
                document.removeEventListener('click', outsideClickHandler);
            });
            
            // Handle Cancel button
            popup.querySelector('#matterAssignmentCancel').addEventListener('click', function() {
                popup.remove();
                document.removeEventListener('click', outsideClickHandler);
            });
            
            // Close on outside click
            const outsideClickHandler = function(e) {
                if (!popup.contains(e.target) && e.target !== button) {
                    popup.remove();
                    document.removeEventListener('click', outsideClickHandler);
                }
            };
            
            // Add click handler after a short delay to avoid immediate closing
            setTimeout(() => {
                document.addEventListener('click', outsideClickHandler);
            }, 100);
        }
    </script>
}

@functions {
    string GetStatusClass(string status)
    {
        return status switch
        {
            "Completed" => "bg-success text-white",
            "In Progress" => "bg-primary text-white",
            "Review" => "bg-warning text-dark",
            "Planning" => "bg-secondary text-white",
            _ => "bg-secondary text-white"
        };
    }

    string GetStatusIcon(string status)
    {
        return status switch
        {
            "Completed" => "fas fa-check-circle text-success",
            "In Progress" => "fas fa-play-circle text-primary",
            "Review" => "fas fa-exclamation-circle text-warning",
            "Planning" => "fas fa-clock text-muted",
            _ => "fas fa-clock text-muted"
        };
    }
}

