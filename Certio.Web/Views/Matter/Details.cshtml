                    <i class="fas fa-credit-card text-muted mb-3" style="font-size: 3rem;"></i>
                    <h4 class="text-dark mb-2">@matterLabel Billing</h4>
                    <p class="text-muted">This section will display billing information and time tracking for this @matterLabel.ToLower().</p>
                    <p class="text-muted small">(To be implemented in a future phase)</p>
                </div>
