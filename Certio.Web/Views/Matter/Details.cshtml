                    <!-- Status Overview -->
                    <div class="col-lg-6 mb-3 matter-card-wrapper">
                        <div class="card h-100 border-0 matter-card" style="padding-top: 0.5rem; position: relative;">
                            <div class="card-header bg-transparent border-0 pb-0">
                                <div class="mb-2">
                                    <div class="d-flex align-items-start">
                                        <i class="fas fa-chart-pie fs-5 me-2 flex-shrink-0 text-muted" style="margin-top: 2px;"></i>
                                        <div class="flex-grow-1">
                                            <h5 class="card-title fw-bold mb-2" style="color: black; font-size: 1rem; line-height: 1.3;">Status overview</h5>
                                        </div>
                                    </div>
                                    <p class="card-text text-muted mb-0" style="font-size: 0.8rem; line-height: 1.4; padding-left: 30px;">
                                        Get a snapshot of the status of your task items. 
                                        <a href="/Client/@ViewBag.OrganizationId/Matter/@Model.Matter.Id/Tasks" class="text-primary text-decoration-none">View all task items</a>
                                    </p>
                                </div>
                            </div>
                                <div class="card-body pt-2 d-flex flex-column align-items-center justify-content-center">
                                    @if (Model.TotalTasksCount > 0)
                                    {
                                        var r = 80.0; 
                                        var c = 2 * Math.PI * r; 
                                        var total = Math.Max(1, Model.TotalTasksCount);
                                        var segPlanned = (double)Model.TasksPending / total * c; // Planned/Pending
                                        var segInProgress = (double)Model.TasksInProgress / total * c;
                                        var segReview = (double)Model.TasksInReview / total * c;
                                        var segCompleted = (double)Model.TasksCompleted / total * c;
                                        var offsetPlanned = 0.0;
                                        var offsetInProgress = offsetPlanned + segPlanned;
                                        var offsetReview = offsetInProgress + segInProgress;
                                        var offsetCompleted = offsetReview + segReview;
                                        <div class="position-relative mb-3" style="width: 192px; height: 192px;">
                                            <svg class="w-100 h-100" style="transform: rotate(-90deg);" viewBox="0 0 192 192">
                                                <!-- track -->
                                                <circle cx="96" cy="96" r="80" stroke="#e5e7eb" stroke-width="16" fill="none" />
                                                <!-- Planned / Pending (secondary gray) -->
                                                @if (Model.TasksPending > 0)
                                                {
                                                    <circle cx="96" cy="96" r="80" style="stroke: rgba(var(--bs-secondary-rgb), 1); stroke-linecap: butt;" stroke-width="16" fill="none"
                                                            stroke-dasharray="@segPlanned @c" stroke-dashoffset="-@offsetPlanned" />
                                                }
                                                <!-- In Progress (primary) -->
                                                @if (Model.TasksInProgress > 0)
                                                {
                                                    <circle cx="96" cy="96" r="80" style="stroke: rgba(var(--bs-primary-rgb), 1); stroke-linecap: butt;" stroke-width="16" fill="none"
                                                            stroke-dasharray="@segInProgress @c" stroke-dashoffset="-@offsetInProgress" />
                                                }
                                                <!-- Review (amber) -->
                                                @if (Model.TasksInReview > 0)
                                                {
                                                    <circle cx="96" cy="96" r="80" style="stroke: rgba(var(--bs-warning-rgb), 1); stroke-linecap: butt;" stroke-width="16" fill="none"
                                                            stroke-dasharray="@segReview @c" stroke-dashoffset="-@offsetReview" />
                                                }
                                                <!-- Completed (green) -->
                                                @if (Model.TasksCompleted > 0)
                                                {
                                                    <circle cx="96" cy="96" r="80" style="stroke: rgba(var(--bs-success-rgb), 1); stroke-linecap: butt;" stroke-width="16" fill="none"
                                                            stroke-dasharray="@segCompleted @c" stroke-dashoffset="-@offsetCompleted" />
                                                }
                                            </svg>
                                            <div class="position-absolute top-50 start-50 translate-middle text-center">
                                                <div class="fs-1 fw-bold text-dark">@Model.TotalTasksCount</div>
                                                <div class="small text-muted">Total task items</div>
