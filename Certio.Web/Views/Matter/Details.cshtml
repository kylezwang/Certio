                                        Create, send, and track notices that require acknowledgement from vendors and your team.
                                    </p>
                                </div>
                            </div>
                            <div class="card-body pt-2">
                                @{
                                    var cc = Model.ChangeControlSummary;
                                }

                                <div id="change-control-card" data-org-id="@ViewBag.OrganizationId" data-matter-id="@Model.Matter.Id">
