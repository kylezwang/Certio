                                            <span class="badge bg-primary" style="margin-top:0; background-color: rgba(var(--bs-primary-rgb), 1) !important; font-weight: 600;">Pending: <span data-cc-count="pending">@((cc?.PendingCount) ?? 0)</span></span>
                                            <span class="badge bg-warning text-dark" style="margin-top:0; font-weight: 600;">Response Required: <span data-cc-count="clarify">@((cc?.NeedsClarificationCount) ?? 0)</span></span>
                                            <span class="badge bg-success" style="margin-top:0; font-weight: 600;">All Confirmed: <span data-cc-count="ack">@((cc?.AcknowledgedCount) ?? 0)</span></span>
                                        </div>
                                        <button id="cc-refresh-btn" class="btn btn-sm btn-outline-secondary" style="font-weight: 600;">
                                            <i class="fas fa-rotate-right me-1"></i> Refresh
                                        </button>
                                    </div>

                                    <!-- Draft composer toggle (Tasks-inspired) -->
                                    <div id="cc-add-container" class="cc-add-card-outer-container">
                                        <div class="cc-add-card-container">
                                            <button class="cc-add-card-button" id="cc-open-composer-btn" type="button">
                                                <div class="cc-add-card-icon">
                                                    <i class="fas fa-plus"></i>
                                                </div>
                                                <span class="cc-add-card-text">Draft new notice</span>
                                            </button>
                                        </div>

                                    <!-- Column headers (History/Billing inspired) -->
                                    <div id="cc-list-header" class="cc-row cc-header mb-2">
                                        <div class="cc-grid">
                                            <div>
                                                <button class="btn btn-sm" style="padding: 0.375rem 0.5rem; border: none; background: white; color: #2d3748; font-size: 0.75rem; font-weight: 700; border-radius: 0.5rem; cursor: default; text-align: left; width: 100%;">Status</button>
                                            </div>
                                            <div>
                                                <button class="btn btn-sm" style="padding: 0.375rem 0.5rem; border: none; background: white; color: #2d3748; font-size: 0.75rem; font-weight: 700; border-radius: 0.5rem; cursor: default; text-align: left; width: 100%;">Title</button>
                                            </div>
                                            <div>
                                                <button class="btn btn-sm" style="padding: 0.375rem 0.5rem; border: none; background: white; color: #2d3748; font-size: 0.75rem; font-weight: 700; border-radius: 0.5rem; cursor: default; text-align: right; width: 100%;">Actions</button>
                                            </div>
                                        </div>
                                    </div>
                                    </div>

                                    <div id="change-control-notice-list">
                                        @if (cc?.Notices != null && cc.Notices.Any())
                                        {
                                            var maxVisible = 2;
                                            var noticeList = cc.Notices.ToList();
                                            var visibleNotices = noticeList.Take(maxVisible).ToList();
                                            var hasMore = noticeList.Count > maxVisible;
                                            var hiddenCount = noticeList.Count - maxVisible;

                                            foreach (var n in visibleNotices)
                                            {
                                                var badgeClass = n.Status == "Acknowledged"
                                                    ? "bg-success"
                                                    : n.Status == "NeedsClarification"
                                                        ? ""
                                                        : (n.Status == "Sent" || n.Status == "PartiallyAcknowledged")
                                                            ? ""
                                                            : "";
                                                var sendLabel = n.Status == "Draft" ? "Send" : "Nudge";
                                                var sendDisabled = n.Status == "Acknowledged";
                                                var statusLabel = n.Status == "Acknowledged" ? "Confirmed"
                                                    : n.Status == "NeedsClarification" ? "Response Required"
                                                    : n.Status == "PartiallyAcknowledged" ? "Partial"
                                                    : n.Status;
                                                var statusIcon = n.Status == "Acknowledged" ? "fas fa-check-circle"
                                                    : n.Status == "NeedsClarification" ? "fas fa-circle-question"
                                                    : (n.Status == "Sent" || n.Status == "PartiallyAcknowledged") ? "fas fa-paper-plane"
                                                    : "fas fa-pen";

                                                <div class="cc-row cc-visible-row p-3 mb-2" data-notice-id="@n.Id">
                                                    <div class="cc-grid">
                                                        <div class="cc-status-col">
                                                            <span class="cc-status-pill badge @badgeClass">
                                                                <i class="@statusIcon"></i> @statusLabel
                                                            </span>
                                                            <div class="cc-status-counts">
                                                                <span class="cc-count-pill" style="background: rgba(var(--bs-success-rgb), 0.12); color: #065f46;">Confirmed @n.AcknowledgedRecipientCount / @n.RecipientCount</span>
                                                                <span class="cc-count-pill" style="background: rgba(var(--bs-warning-rgb), 0.16); color: #92400e;">Response Required @n.NeedsClarificationRecipientCount / @n.RecipientCount</span>
                                                                <span class="cc-count-pill" style="background: rgba(var(--bs-primary-rgb), 0.12); color: #1d4ed8;">Pending @n.PendingRecipientCount / @n.RecipientCount</span>
                                                            </div>
                                                        </div>
                                                        <div>
                                                            <div class="cc-title">@n.Title</div>
                                                            <div class="cc-meta">
                                                                <span class="cc-chip"><i class="fas fa-tag" style="opacity:0.75;"></i> @n.ChangeType</span>
                                                                <span class="cc-chip"><i class="fas fa-flag" style="opacity:0.75;"></i> @n.Priority</span>
                                                                <span class="cc-chip"><i class="fas fa-users" style="opacity:0.75;"></i> @n.RecipientCount</span>
                                                            </div>
                                                            @if (!string.IsNullOrWhiteSpace(n.Description))
                                                            {
                                                                <div class="cc-description" style="font-size: 0.8rem; color: #6b7280; margin-top: 0.25rem; line-height: 1.4;">@n.Description</div>
                                                            }
                                                        </div>
                                                        <div class="cc-col-actions">
                                                            <button class="btn btn-sm btn-outline-primary cc-send-btn" style="font-weight:600; padding: 0.2rem 0.5rem;" data-notice-id="@n.Id" @(sendDisabled ? "disabled" : "")>@sendLabel</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            }

                                            @* Hidden items (collapsed by default) *@
                                            @foreach (var n in noticeList.Skip(maxVisible))
                                            {
                                                var badgeClass = n.Status == "Acknowledged"
                                                    ? "bg-success"
                                                    : n.Status == "NeedsClarification"
                                                        ? ""
                                                        : (n.Status == "Sent" || n.Status == "PartiallyAcknowledged")
                                                            ? ""
                                                            : "";
                                                var sendLabel = n.Status == "Draft" ? "Send" : "Nudge";
                                                var sendDisabled = n.Status == "Acknowledged";
                                                var statusLabel = n.Status == "Acknowledged" ? "Confirmed"
                                                    : n.Status == "NeedsClarification" ? "Response Required"
                                                    : n.Status == "PartiallyAcknowledged" ? "Partial"
                                                    : n.Status;
                                                var statusIcon = n.Status == "Acknowledged" ? "fas fa-check-circle"
                                                    : n.Status == "NeedsClarification" ? "fas fa-circle-question"
                                                    : (n.Status == "Sent" || n.Status == "PartiallyAcknowledged") ? "fas fa-paper-plane"
                                                    : "fas fa-pen";

                                                <div class="cc-row cc-hidden-row p-3 mb-2" data-notice-id="@n.Id" style="display: none;">
                                                    <div class="cc-grid">
                                                        <div class="cc-status-col">
                                                            <span class="cc-status-pill badge @badgeClass">
                                                                <i class="@statusIcon"></i> @statusLabel
                                                            </span>
                                                            <div class="cc-status-counts">
                                                                <span class="cc-count-pill" style="background: rgba(var(--bs-success-rgb), 0.12); color: #065f46;">Confirmed @n.AcknowledgedRecipientCount / @n.RecipientCount</span>
                                                                <span class="cc-count-pill" style="background: rgba(var(--bs-warning-rgb), 0.16); color: #92400e;">Clarify @n.NeedsClarificationRecipientCount / @n.RecipientCount</span>
                                                                <span class="cc-count-pill" style="background: rgba(var(--bs-primary-rgb), 0.12); color: #1d4ed8;">Pending @n.PendingRecipientCount / @n.RecipientCount</span>
                                                            </div>
                                                        </div>
                                                        <div>
                                                            <div class="cc-title">@n.Title</div>
                                                            <div class="cc-meta">
                                                                <span class="cc-chip"><i class="fas fa-tag" style="opacity:0.75;"></i> @n.ChangeType</span>
                                                                <span class="cc-chip"><i class="fas fa-flag" style="opacity:0.75;"></i> @n.Priority</span>
                                                                <span class="cc-chip"><i class="fas fa-users" style="opacity:0.75;"></i> @n.RecipientCount</span>
                                                            </div>
                                                            @if (!string.IsNullOrWhiteSpace(n.Description))
                                                            {
                                                                <div class="cc-description" style="font-size: 0.8rem; color: #6b7280; margin-top: 0.25rem; line-height: 1.4;">@n.Description</div>
                                                            }
                                            </div>
                                                        <div class="cc-col-actions">
                                                            <button class="btn btn-sm btn-outline-primary cc-send-btn" style="font-weight:600; padding: 0.2rem 0.5rem;" data-notice-id="@n.Id" @(sendDisabled ? "disabled" : "")>@sendLabel</button>
                                        </div>
                                                    </div>
                                        </div>
                                            }

                                            @if (hasMore)
                                            {
                                                <div class="cc-toggle-row text-center py-2" id="cc-show-more-toggle" style="cursor: pointer; color: #6b7280; font-size: 0.8rem; border-top: 1px solid #e5e7eb;" onclick="toggleCCHiddenRows()">
                                                    <i class="fas fa-chevron-down"></i> Show @hiddenCount more
                                                </div>
                                            }
                                    }
                                    else
                                    {
                                            <div class="text-center py-3">
                                                <p class="text-muted small mb-0">No change notices yet</p>
                                            </div>
                                        }
                                        </div>
                                    <script>
                                        function toggleCCHiddenRows() {
                                            const hiddenRows = document.querySelectorAll('.cc-hidden-row');
                                            const toggle = document.getElementById('cc-show-more-toggle');
                                            const isExpanded = toggle.dataset.expanded === 'true';
                                            
                                            hiddenRows.forEach(row => {
                                                row.style.display = isExpanded ? 'none' : 'block';
                                            });
                                            
                                            toggle.dataset.expanded = !isExpanded;
                                            toggle.innerHTML = isExpanded 
                                                ? '<i class="fas fa-chevron-down"></i> Show @(cc?.Notices?.Count() > 2 ? cc.Notices.Count() - 2 : 0) more'
                                                : '<i class="fas fa-chevron-up"></i> Show less';
                                        }
                                    </script>

                                    <pre id="change-control-summary-json" class="d-none"></pre>
                                </div>

                                <!-- Change Notice Modal (Tasks-style) - for Draft and Edit -->
                                <div class="task-details-modal cc-modal" id="ccModal" style="display: none;">
                                    <div class="modal-dialog" style="margin-bottom: 1.5rem;">
                                        <div class="task-details-content">
                                            <!-- Modal Header -->
                                            <div class="task-details-header">
                                                <div class="task-details-header-left">
                                                    <div class="task-status-dropdown">
                                                        <select class="form-select task-status-select" id="ccStatusDropdown" disabled>
                                                            <option value="Draft">Draft</option>
                                                            <option value="Sent">Sent</option>
                                                            <option value="PartiallyAcknowledged">Partial</option>
                                                            <option value="NeedsClarification">Response Required</option>
                                                            <option value="Acknowledged">Confirmed</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="task-details-header-middle">
                                                    <div class="header-progress" id="ccHeaderProgress" style="display: none;">
                                                        <div class="progress" style="height: 8px;">
                                                            <div class="progress-bar bg-success" style="width: 0%" id="ccProgressBar"></div>
                                                        </div>
                                                        <span class="progress-text" style="font-size: 0.875rem; font-weight: 500; color: #6b7280;" id="ccProgressText">0%</span>
                                                    </div>
                                                </div>
                                                <div class="task-details-header-right">
                                                    <button class="btn btn-sm btn-link task-header-btn" id="ccDeleteBtn" title="Delete" style="display: none;">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-link task-header-btn" title="More options">
                                                        <i class="fas fa-ellipsis-h"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-primary me-2" id="ccHeaderActionBtn" style="font-weight: 600; display: none;">
                                                        <i class="fas fa-paper-plane me-1"></i> <span id="ccHeaderActionBtnText">Send</span>
                                                    </button>
                                                    <button type="button" class="btn-close" id="cc-close-modal" aria-label="Close"></button>
                                                </div>
                                            </div>

                                            <!-- Title Section -->
                                            <div class="task-details-title-section">
                                                <div class="task-title-container">
                                                    <i class="fa-solid fa-bullhorn" style="color:#3d1019; font-size: 1.25rem;"></i>
                                                    <input type="text" class="cc-title-input" id="ccTitleInput" placeholder="Change notice title" maxlength="200">
                                                </div>
                                            </div>

                                            <!-- Recipients Section (like Assignees) -->
                                            <div class="task-meta-section">
                                                <div class="task-members">
                                                    <span class="task-meta-label">Recipients</span>
                                                    <div class="cc-recipients-container task-assignees-container" id="ccRecipientsContainer">
                                                        <!-- Recipients will be dynamically rendered here -->
                                                    </div>
                                                    <button type="button" class="add-member-btn" id="ccAddRecipientBtn">
                                                        <i class="fas fa-plus"></i>
                                                    </button>
                                                </div>
                                            </div>

                                            <!-- Main Content Area (Two-column layout like Tasks) -->
                                            <div class="task-details-body">
                                                <!-- Left Panel -->
                                                <div class="task-details-left">
                                                    <form id="change-control-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="NoticeId" id="ccNoticeId" value="">
                                                        <input type="hidden" name="RecipientEmails" id="ccRecipientEmailsHidden" value="">

                                                        <!-- Description Section -->
                                                        <div class="task-section">
                                                            <div class="task-section-header">
                                                                <h6 class="task-section-title">
                                                                    <i class="fas fa-bars"></i> Description
                                                                </h6>
                                                            </div>
                                                            <div class="task-section-content">
                                                                <textarea class="form-control" name="Description" id="ccDescription" rows="4" maxlength="2000" placeholder="Add a description for this change notice..." style="font-size: 0.875rem;"></textarea>
                                                            </div>
                                                        </div>

                                                        <!-- Type & Priority Section -->
                                                        <div class="task-section" id="cc-type-priority-section">
                                                            <div class="task-section-header">
                                                                <h6 class="task-section-title">
                                                                    <i class="fas fa-cog"></i> Type & Priority
                                                                </h6>
                                                            </div>
                                                            <div class="task-section-content">
                                                                <div class="row">
                                                                    <div class="col-md-6 mb-3">
                                                                        <label class="form-label fw-bold" style="font-size: 0.875rem;">
                                                                            <i class="fas fa-tag me-2" style="color: #3d1019;"></i>Type
                                                                        </label>
                                                                        <select class="form-select" name="ChangeType" id="ccChangeType" style="font-size: 0.875rem;">
                                                                            <option value="General">General</option>
                                                                            <option value="Schedule">Schedule</option>
                                                                            <option value="Scope">Scope</option>
                                                                            <option value="Budget">Budget</option>
                                                                        </select>
                                                                    </div>
                                                                    <div class="col-md-6 mb-3">
                                                                        <label class="form-label fw-bold" style="font-size: 0.875rem;">
                                                                            <i class="fas fa-flag me-2" style="color: #3d1019;"></i>Priority
                                                                        </label>
                                                                        <select class="form-select" name="Priority" id="ccPriority" style="font-size: 0.875rem;">
                                                                            <option value="Low">Low</option>
                                                                            <option value="Medium" selected>Medium</option>
                                                                            <option value="High">High</option>
                                                                            <option value="Critical">Critical</option>
                                                                        </select>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Due Date Section -->
                                                        <div class="task-section" id="cc-due-section">
                                                            <div class="task-section-header">
                                                                <h6 class="task-section-title">
                                                                    <i class="fa-solid fa-calendar"></i> Deadline & Reminders
                                                                </h6>
                                                            </div>
                                                            <div class="task-section-content">
                                                                <div class="row">
                                                                    <div class="col-md-6 mb-3">
                                                                        <label class="form-label fw-bold" style="font-size: 0.875rem;">
                                                                            <i class="fa-solid fa-calendar-day me-2" style="color: #3d1019;"></i>Acknowledgement Due
                                                                        </label>
                                                                        <input class="form-control" type="datetime-local" name="AcknowledgementDueDate" id="ccDueDate" style="font-size: 0.875rem;">
                                                                    </div>
                                                                    <div class="col-md-6 mb-3">
                                                                        <label class="form-label fw-bold" style="font-size: 0.875rem;">
                                                                            <i class="fas fa-bell me-2" style="color: #3d1019;"></i>Auto Reminders
                                                                        </label>
                                                                        <select class="form-select" name="AutoReminderHoursBeforeDue" id="ccAutoReminders" style="font-size: 0.875rem;">
                                                                            <option value="0" selected>Off</option>
                                                                            <option value="24">24 hours before due</option>
                                                                            <option value="48">48 hours before due</option>
                                                                            <option value="72">72 hours before due</option>
                                                                        </select>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Recipients Section (Detailed) -->
                                                        <div class="task-section" id="cc-recipients-section" style="margin-bottom: 0;">
                                                            <div class="task-section-header">
                                                                <h6 class="task-section-title">
                                                                    <i class="fas fa-users"></i> Recipients
                                                                </h6>
                                                                <button type="button" class="btn btn-sm btn-outline-secondary edit-btn" id="ccAddRecipientBtnAlt" style="border-radius: 0.5rem;">
                                                                    <i class="fas fa-plus"></i> Add
                                                                </button>
                                                            </div>
                                                            <div class="task-section-content">
                                                                <div id="ccRecipientsList" class="cc-recipients-list">
                                                                    <!-- Recipients list will be rendered here -->
                                                                </div>
                                                                <div class="mt-2">
                                                                    <input type="text" class="form-control form-control-sm" id="ccAddRecipientEmail" placeholder="Add email address and press Enter" style="font-size: 0.875rem;">
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </form>
                                                </div>

                                                <!-- Right Panel (Activity/Comments) -->
                                                <div class="task-details-right">
                                                    <div class="comments-section">
                                                        <div class="comments-header">
                                                            <h6 class="comments-title">
                                                                <i class="fas fa-comment"></i> Activity & responses
                                                            </h6>
                                                        </div>
                                                        <div class="comment-input-section">
                                                            <textarea class="form-control comment-input" id="ccCommentInput" placeholder="Write a note..."></textarea>
                                                            <div class="mt-2 d-flex align-items-center">
                                                                <small class="text-muted" style="margin-right: 0.8rem; margin-left: 0.3rem; font-size: 0.8rem;">Type &#64; to mention users</small>
                                                                <button class="btn btn-sm btn-primary" id="ccPostCommentBtn" style="font-weight: 600;"><i class="fas fa-paper-plane"></i> Post</button>
                                                            </div>
                                                        </div>
                                                        <div class="activity-log" id="ccActivityLog">
                                                            <p class="text-muted small text-center">No activity yet.</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- Footer with action buttons -->
                                            <div class="task-details-footer" style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1.5rem; border-top: 1px solid #e5e7eb; background: #fff; flex-shrink: 0;">
                                                <div id="ccModalMode" style="font-size: 0.8rem; color: #6b7280;"></div>
                                                <div class="d-flex gap-2">
                                                    <button type="button" class="btn btn-outline-secondary" id="cc-cancel-btn" style="font-size: 0.875rem;">Cancel</button>
                                                    <button type="button" class="btn btn-primary" id="ccSaveBtn" style="font-weight: 600; font-size: 0.875rem;">
                                                        <i class="fas fa-save me-1"></i> <span id="ccSaveBtnText">Save</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Contact Selector Popup -->
                                <div id="ccContactSelectorPopup" class="cc-contact-selector-popup" style="display: none;"></div>
                                </div>
                        </div>
                    </div>

                    <!-- Recent Activity -->
                    <div class="col-lg-6 mb-3 matter-card-wrapper" style="order: 3;">
                        <div class="card h-100 border-0 matter-card" style="padding-top: 0.5rem; position: relative;">
                            <div class="card-header bg-transparent border-0 pb-0">
                                <div class="mb-2">
                                    <div class="d-flex align-items-start">
                                        <i class="fas fa-clock fs-5 me-2 flex-shrink-0 text-muted" style="margin-top: 2px;"></i>
                                        <div class="flex-grow-1">
                                            <h5 class="card-title fw-bold mb-2" style="color: black; font-size: 1rem; line-height: 1.3;">Recent Activity</h5>
                                        </div>
                                    </div>
                                    <p class="card-text text-muted mb-0" style="font-size: 0.8rem; line-height: 1.4; padding-left: 30px;">Track your team's latest updates</p>
                                </div>
                            </div>
                            <div class="card-body pt-2 d-flex flex-column align-items-center justify-content-center text-center">
                                @if (Model.RecentActivity.Any())
                                {
                                    <div class="w-100">
                                        @foreach (var activity in Model.RecentActivity.Take(5))
                                        {
                                            <div class="d-flex align-items-start mb-3 pb-3 border-bottom">
                                                <div class="me-3">
                                                    <i class="fas fa-circle-notch text-primary"></i>
                                                </div>
                                                <div class="flex-grow-1 text-start">
                                                    <p class="mb-1 fw-medium">@activity.Title</p>
                                                    <p class="small text-muted mb-0">@activity.Description</p>
                                                    <p class="small text-muted mb-0">@activity.Timestamp.ToString("MMM dd, yyyy")</p>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="rounded-3 d-flex align-items-center justify-content-center mb-3" 
                                         style="width: 80px; height: 80px; background-color: rgba(61, 16, 25, 0.1);">
                                        <i class="fas fa-check-circle text-primary" style="font-size: 2.5rem;"></i>
                                    </div>
                                    <h6 class="fw-semibold text-dark mb-2">No activity yet</h6>
                                    <p class="text-muted small mb-0" style="max-width: 320px;">
                                        Create a few work items and invite some teammates to your space to see your space activity.
                                    </p>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Status Overview -->
                    <div class="col-lg-6 mb-3 matter-card-wrapper" style="order: 4;">
                        <div class="card h-100 border-0 matter-card" style="padding-top: 0.5rem; position: relative;">
                            <div class="card-header bg-transparent border-0 pb-0">
                                <div class="mb-2">
                                    <div class="d-flex align-items-start">
                                        <i class="fas fa-chart-pie fs-5 me-2 flex-shrink-0 text-muted" style="margin-top: 2px;"></i>
                                        <div class="flex-grow-1">
                                            <h5 class="card-title fw-bold mb-2" style="color: black; font-size: 1rem; line-height: 1.3;">Status overview</h5>
                                        </div>
                                    </div>
                                    <p class="card-text text-muted mb-0" style="font-size: 0.8rem; line-height: 1.4; padding-left: 30px;">
                                        Get a snapshot of the status of your task items. 
                                        <a href="/Client/@ViewBag.OrganizationId/Matter/@Model.Matter.Id/Tasks" class="text-primary text-decoration-none">View all task items</a>
                                    </p>
                                </div>
                            </div>
                                <div class="card-body pt-2 d-flex flex-column align-items-center justify-content-center">
                                @if (Model.TotalTasksCount > 0)
                                {
                                        var r = 80.0; 
                                        var c = 2 * Math.PI * r; 
                                        var total = Math.Max(1, Model.TotalTasksCount);
                                        var segPlanned = (double)Model.TasksPending / total * c; // Planned/Pending
                                        var segInProgress = (double)Model.TasksInProgress / total * c;
                                        var segReview = (double)Model.TasksInReview / total * c;
                                        var segCompleted = (double)Model.TasksCompleted / total * c;
                                        var offsetPlanned = 0.0;
                                        var offsetInProgress = offsetPlanned + segPlanned;
                                        var offsetReview = offsetInProgress + segInProgress;
                                        var offsetCompleted = offsetReview + segReview;
                                        <div class="position-relative mb-3" style="width: 192px; height: 192px;">
                                            <svg class="w-100 h-100" style="transform: rotate(-90deg);" viewBox="0 0 192 192">
                                                <!-- track -->
                                                <circle cx="96" cy="96" r="80" stroke="#e5e7eb" stroke-width="16" fill="none" />
                                                <!-- Planned / Pending (secondary gray) -->
                                                @if (Model.TasksPending > 0)
                                                {
                                                    <circle cx="96" cy="96" r="80" style="stroke: rgba(var(--bs-secondary-rgb), 1); stroke-linecap: butt;" stroke-width="16" fill="none"
                                                            stroke-dasharray="@segPlanned @c" stroke-dashoffset="-@offsetPlanned" />
                                                }
                                                <!-- In Progress (primary) -->
                                                @if (Model.TasksInProgress > 0)
                                                {
                                                    <circle cx="96" cy="96" r="80" style="stroke: rgba(var(--bs-primary-rgb), 1); stroke-linecap: butt;" stroke-width="16" fill="none"
                                                            stroke-dasharray="@segInProgress @c" stroke-dashoffset="-@offsetInProgress" />
                                                }
                                                <!-- Review (amber) -->
                                                @if (Model.TasksInReview > 0)
                                                {
                                                    <circle cx="96" cy="96" r="80" style="stroke: rgba(var(--bs-warning-rgb), 1); stroke-linecap: butt;" stroke-width="16" fill="none"
                                                            stroke-dasharray="@segReview @c" stroke-dashoffset="-@offsetReview" />
                                                }
                                                <!-- Completed (green) -->
                                                @if (Model.TasksCompleted > 0)
                                                {
                                                    <circle cx="96" cy="96" r="80" style="stroke: rgba(var(--bs-success-rgb), 1); stroke-linecap: butt;" stroke-width="16" fill="none"
                                                            stroke-dasharray="@segCompleted @c" stroke-dashoffset="-@offsetCompleted" />
                                                }
                                            </svg>
                                            <div class="position-absolute top-50 start-50 translate-middle text-center">
                                                <div class="fs-1 fw-bold text-dark">@Model.TotalTasksCount</div>
                                                <div class="small text-muted">Total task items</div>
                                            </div>
                                            </div>
                                        <div class="d-flex flex-wrap justify-content-center gap-3 small">
                                            <div class="d-flex align-items-center gap-2"><span class="rounded" style="width:12px;height:12px;background-color: rgba(var(--bs-secondary-rgb), 1); margin-top:0.6rem;"></span><span class="text-muted">Planned: @Model.TasksPending</span></div>
                                            <div class="d-flex align-items-center gap-2"><span class="rounded" style="width:12px;height:12px;background-color: rgba(var(--bs-primary-rgb), 1); margin-top:0.6rem;"></span><span class="text-muted">In Progress: @Model.TasksInProgress</span></div>
                                            <div class="d-flex align-items-center gap-2"><span class="rounded" style="width:12px;height:12px;background-color: rgba(var(--bs-warning-rgb), 1); margin-top:0.6rem;"></span><span class="text-muted">Review: @Model.TasksInReview</span></div>
                                            <div class="d-flex align-items-center gap-2"><span class="rounded" style="width:12px;height:12px;background-color: rgba(var(--bs-success-rgb), 1); margin-top:0.6rem;"></span><span class="text-muted">Completed: @Model.TasksCompleted</span></div>
                                        </div>
                                }
                                else
                                {
                                        <div class="text-center py-5">
                                            <div class="mb-3">
                                                <i class="fa-solid fa-bars-progress text-muted" style="font-size: 3rem; opacity: 0.3;"></i>
                                            </div>
                                            <h6 class="fw-semibold text-dark mb-2">No task items yet</h6>
                                            <p class="text-muted small mb-0">Create tasks to track your work</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    
                </div>
            </div>
        </div>

        <!-- Tasks Tab (AJAX Loaded) -->
        <div id="tab-tasks" class="tab-content-section" style="display: none;">
            <!-- Content will be loaded via AJAX when tab is first accessed -->
        </div>

        <!-- Timeline Tab (AJAX Loaded) -->
        <div id="tab-timeline" class="tab-content-section" style="display: none;">
            <!-- Content will be loaded via AJAX when tab is first accessed -->
        </div>


        <!-- Calendar Tab (AJAX Loaded) -->
        <div id="tab-calendar" class="tab-content-section" style="display: none;">
            <!-- Content will be loaded via AJAX when tab is first accessed -->
        </div>

        <!-- Communications Tab (AJAX Loaded) -->
        <div id="tab-communications" class="tab-content-section" style="display: none;">
            <!-- Content will be loaded via AJAX when tab is first accessed -->
        </div>

        <!-- Documents Tab (Placeholder) -->
        <div id="tab-documents" class="tab-content-section" style="display: none;">
            <div class="container-fluid px-4 py-4">
                <div class="text-center py-5">
                    <i class="fas fa-folder text-muted mb-3" style="font-size: 3rem;"></i>
                    <h4 class="text-dark mb-2">@matterLabel Documents</h4>
                    <p class="text-muted">This section will display all documents and files associated with this @matterLabel.ToLower().</p>
                    <p class="text-muted small">(To be implemented in a future phase)</p>
                </div>
            </div>
        </div>

        <!-- Billing Tab (Placeholder) -->
        <div id="tab-billing" class="tab-content-section" style="display: none;">
            <div class="container-fluid px-4 py-4">
                <div class="text-center py-5">
                    <i class="fas fa-credit-card text-muted mb-3" style="font-size: 3rem;"></i>
                    <h4 class="text-dark mb-2">@matterLabel Billing</h4>
                    <p class="text-muted">This section will display billing information and time tracking for this @matterLabel.ToLower().</p>
                    <p class="text-muted small">(To be implemented in a future phase)</p>
                </div>
            </div>
        </div>

        <!-- History Tab (Placeholder) -->
        <div id="tab-history" class="tab-content-section" style="display: none;">
            <div class="container-fluid px-4 py-4">
                <div class="text-center py-5">
                    <i class="fas fa-history text-muted mb-3" style="font-size: 3rem;"></i>
                    <h4 class="text-dark mb-2">@matterLabel History</h4>
                    <p class="text-muted">This section will display the change history and audit log for this @matterLabel.ToLower().</p>
                    <p class="text-muted small">(To be implemented in a future phase)</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/matter-details.js"></script>
    <script src="~/js/matter-info-carousel.js"></script>
    <script src="~/js/change-control.js" asp-append-version="true"></script>
    <script>
        const matterId = @Model.Matter.Id;
        const organizationId = @ViewBag.OrganizationId;
        let allUsers = [];
        let hasUnsavedChanges = false;
        let pendingAssignmentChanges = {}; // Store pending assignment changes
        let pendingMatterChanges = {}; // Store pending matter field changes

        // Store original values for comparison
        const originalValues = {
            title: '@Html.Raw(Model.Matter.Title.Replace("'", "\\'"))',
            description: '@Html.Raw((Model.Matter.Description ?? "").Replace("'", "\\'"))',
            status: '@Model.Matter.Status',
            practiceArea: '@Model.Matter.PracticeArea',
            startDate: '@(Model.Matter.StartDate?.ToString("yyyy-MM-dd") ?? "")',
            dueDate: '@(Model.Matter.DueDate?.ToString("yyyy-MM-dd") ?? "")',
            pendingDate: '@(Model.Matter.PendingDate?.ToString("yyyy-MM-dd") ?? "")',
            statuteOfLimitationsDate: '@(Model.Matter.StatuteOfLimitationsDate?.ToString("yyyy-MM-dd") ?? "")'
        };

        // Initialize change detection for all carousel inputs
        function initializeCarouselInputs() {
            const carouselInputs = document.querySelectorAll('.matter-carousel-input');
            carouselInputs.forEach(input => {
                const fieldName = input.dataset.field;
                const originalValue = originalValues[fieldName] || '';
                
                input.addEventListener('input', function() {
                    const currentValue = this.value || '';
                    if (currentValue !== originalValue) {
                        pendingMatterChanges[fieldName] = currentValue;
                        showSaveIndicator();
                    } else {
                        delete pendingMatterChanges[fieldName];
                        if (Object.keys(pendingMatterChanges).length === 0 && Object.keys(pendingAssignmentChanges).length === 0) {
                            hideSaveIndicator();
                        }
                    }
                });
                
                input.addEventListener('change', function() {
                    const currentValue = this.value || '';
                    if (currentValue !== originalValue) {
                        pendingMatterChanges[fieldName] = currentValue;
                        showSaveIndicator();
                    } else {
                        delete pendingMatterChanges[fieldName];
                        if (Object.keys(pendingMatterChanges).length === 0 && Object.keys(pendingAssignmentChanges).length === 0) {
                            hideSaveIndicator();
                        }
                    }
                });
            });
        }

        // Initialize on DOMContentLoaded or immediately if already loaded
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeCarouselInputs);
        } else {
            // DOM is already loaded, run initialization immediately
            initializeCarouselInputs();
        }

        // Function to show save indicator
        function showSaveIndicator() {
            hasUnsavedChanges = true;
            const saveBtn = document.getElementById('matterCarouselSaveBtn');
            if (saveBtn) {
                saveBtn.style.display = 'block';
            }
        }

        // Function to hide save indicator
        function hideSaveIndicator() {
            hasUnsavedChanges = false;
            const saveBtn = document.getElementById('matterCarouselSaveBtn');
            if (saveBtn) {
                saveBtn.style.display = 'none';
            }
        }

        // Function to save changes to backend
        async function saveMatterCarouselChanges() {
            const hasAssignmentChanges = Object.keys(pendingAssignmentChanges).length > 0;
            const hasMatterChanges = Object.keys(pendingMatterChanges).length > 0;
            
            if (!hasUnsavedChanges || (!hasAssignmentChanges && !hasMatterChanges)) {
                hideSaveIndicator();
                return;
            }

            try {
                const roleMap = {
                    'ResponsibleAttorney': 'MC / Host',
                    'ResponsibleStaff': 'Photobooth',
                    'OriginatingAttorney': 'DJ & Music'
                };

                // Save assignment changes
                if (hasAssignmentChanges) {
                    for (const [assignmentType, change] of Object.entries(pendingAssignmentChanges)) {
                        const { userId, assignmentId, clearAssignment } = change;

                        if (clearAssignment) {
                            // Remove assignment
                            if (assignmentId > 0) {
                                const removeResponse = await fetch(`/Client/${organizationId}/Matter/${matterId}/Assignment/${assignmentId}`, {
                                    method: 'DELETE',
                                    credentials: 'include',
                                    headers: {
                                        'Content-Type': 'application/json'
                                    }
                                });

                                if (!removeResponse.ok) {
                                    const errorData = await removeResponse.json();
                                    console.error('Error removing assignment:', errorData);
                                    alert(`Error removing ${assignmentType} assignment. Please try again.`);
                                    return;
                                }
                            }
                        } else if (userId > 0) {
                            // Add/update assignment
                            const assignResponse = await fetch(`/Client/${organizationId}/Matter/${matterId}/Assignment`, {
                                method: 'POST',
                                credentials: 'include',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({
                                    userId: userId,
                                    assignmentType: assignmentType,
                                    role: roleMap[assignmentType] || '',
                                    isNotifyRecipient: true
                                })
                            });

                            if (!assignResponse.ok) {
                                const errorData = await assignResponse.json();
                                console.error('Error assigning user:', errorData);
                                alert(`Error assigning ${assignmentType}. Please try again.`);
                                return;
                            }
                        }
                    }
                }

                // Save matter field changes
                if (hasMatterChanges) {
                    // Convert empty date strings to null
                    const dateFields = ['startDate', 'dueDate', 'pendingDate', 'statuteOfLimitationsDate'];
                    const updatePayload = { ...pendingMatterChanges };
                    dateFields.forEach(field => {
                        if (updatePayload[field] === '') {
                            updatePayload[field] = null;
                        }
                    });
                    
                    const updateResponse = await fetch(`/Client/${organizationId}/Matter/${matterId}`, {
                        method: 'PUT',
                        credentials: 'include',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(updatePayload)
                    });

                    if (!updateResponse.ok) {
                        const errorData = await updateResponse.json();
                        console.error('Error updating matter:', errorData);
                        alert('Error updating matter fields. Please try again.');
                        return;
                    }
                }

                // Clear pending changes and refresh page
                pendingAssignmentChanges = {};
                pendingMatterChanges = {};
                hideSaveIndicator();
                location.reload();

            } catch (error) {
                console.error('Error saving changes:', error);
                alert('An error occurred while saving changes. Please try again.');
            }
        }

        // Load users for assignment popup
        async function loadUsersForAssignment() {
            if (allUsers.length > 0) return allUsers;
            
            try {
                const response = await fetch(`/Client/${organizationId}/Matter/${matterId}/Users`, {
                    credentials: 'include'
                });
                if (response.ok) {
                    const result = await response.json();
                    if (result.success && result.users) {
                        allUsers = result.users.map(u => ({
                            id: u.id,
                            name: u.name || `${u.firstName || ''} ${u.lastName || ''}`.trim(),
                            initials: u.initials || `${(u.firstName || '')[0] || ''}${(u.lastName || '')[0] || ''}`.toUpperCase(),
                            email: u.email
                        }));
                    }
                }
            } catch (error) {
                console.error('Error loading users:', error);
            }
            return allUsers;
        }

        // Show matter assignment popup (single-select for assignment type)
        async function showMatterAssignmentPopup(button) {
            const assignmentType = button.dataset.assignmentType;
            const assignmentId = parseInt(button.dataset.assignmentId) || 0;
            const currentUserId = parseInt(button.dataset.currentUserId) || 0;
            
            // Get assignment type label
            const assignmentLabels = {
                'ResponsibleAttorney': 'MC / Host',
                'ResponsibleStaff': 'Photobooth',
                'OriginatingAttorney': 'DJ & Music'
            };
            const assignmentLabel = assignmentLabels[assignmentType] || assignmentType;
            
            // Load users
            await loadUsersForAssignment();
            
            // Create popup container
            const popup = document.createElement('div');
            popup.className = 'matter-assignment-popup';
            
            // Get button position
            const btnRect = button.getBoundingClientRect();
            
            // Position popup to the right of the button
            popup.style.cssText = `
                position: fixed;
                top: ${btnRect.top}px;
                left: ${btnRect.right + 10}px;
                background: white;
                border-radius: 0.5rem;
                padding: 1rem;
                width: 400px;
                max-height: 500px;
                overflow-y: auto;
                box-shadow: 0 4px 20px rgba(0,0,0,0.15);
                border: 1px solid #dee2e6;
                z-index: 1100;
            `;
            
            // Adjust if popup would go off-screen to the right
            const popupWidth = 400;
            const screenWidth = window.innerWidth;
            if (btnRect.right + popupWidth + 10 > screenWidth) {
                // Position to the left instead
                popup.style.left = `${btnRect.left - popupWidth - 10}px`;
            }
            
            // Adjust if popup would go off-screen at the bottom
            const popupHeight = 500;
            const screenHeight = window.innerHeight;
            if (btnRect.top + popupHeight > screenHeight) {
                popup.style.top = `${Math.max(10, screenHeight - popupHeight - 10)}px`;
            }
            
            // Currently selected user
            let selectedUserId = currentUserId;
            
            popup.innerHTML = `
                <div class="mb-2">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-user-plus me-2" style="color: #3d1019; font-size: 1rem;"></i>
                            <div>
                                <h6 class="fw-bold text-dark mb-0" style="font-size: 0.9rem;">Select ${assignmentLabel}</h6>
                                <p class="text-muted mb-0" style="font-size: 0.75rem;">Choose a user for this assignment.</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="mb-2">
                    <label class="form-label fw-bold text-dark mb-1" style="font-size: 0.85rem;">Search Users</label>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control" id="matterAssignmentUserSearch" placeholder="Search by name or email..." style="font-size: 0.875rem;">
                        <button class="btn btn-outline-secondary" type="button">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
                
                <div class="mb-2">
                    <label class="form-label fw-bold text-dark mb-1" style="font-size: 0.85rem;">Selected User</label>
                    <div id="matterAssignmentSelectedUser" class="border rounded p-2" style="min-height: 50px; background-color: #f8f9fa; font-size: 0.875rem;">
                        <p class="text-muted mb-0 small">No user selected yet.</p>
                    </div>
                </div>
                
                <div class="mb-2">
                    <label class="form-label fw-bold text-dark mb-1" style="font-size: 0.85rem;">Available Users</label>
                    <div id="matterAssignmentAvailableUsers" class="border rounded" style="max-height: 10rem; overflow-y: auto; padding-left: 1.75rem;">
                        <!-- Users will be loaded here -->
                    </div>
                </div>
                
                <div class="d-flex justify-content-end mt-2">
                    <button class="btn btn-secondary btn-sm" id="matterAssignmentCancel" style="border-radius: 0.5rem;">Cancel</button>
                    <button class="btn btn-primary btn-sm" id="matterAssignmentDone" style="border-radius: 0.5rem; margin-left: 0.5rem;">Done</button>
                </div>
            `;
            
            document.body.appendChild(popup);
            
            const availableUsersList = popup.querySelector('#matterAssignmentAvailableUsers');
            const selectedUserDisplay = popup.querySelector('#matterAssignmentSelectedUser');
            const searchInput = popup.querySelector('#matterAssignmentUserSearch');
            
            function renderUsers(filterText = '') {
                if (!allUsers || allUsers.length === 0) {
                    availableUsersList.innerHTML = '<p class="text-muted mb-0" style="font-size: 0.75rem;">No users available.</p>';
                    return;
                }
                
                const filtered = allUsers.filter(u => 
                    !filterText || 
                    u.name.toLowerCase().includes(filterText.toLowerCase()) || 
                    (u.email && u.email.toLowerCase().includes(filterText.toLowerCase()))
                );
                
                availableUsersList.innerHTML = filtered.map(user => `
                    <div class="form-check user-item" style="padding: 0.4rem;">
                        <input class="form-check-input user-radio" type="radio" 
                               name="matterAssignmentUser" 
                               id="matter_user_${user.id}" 
                               value="${user.id}"
                               ${selectedUserId === user.id ? 'checked' : ''}
                               style="margin-top: 0.75rem;">
                        <label class="form-check-label" for="matter_user_${user.id}" style="cursor: pointer; font-size: 0.875rem;">
                            <strong>${user.name}</strong>
                            ${user.email ? `<small class="text-muted d-block" style="font-size: 0.75rem;">${user.email}</small>` : ''}
                        </label>
                    </div>
                `).join('');
                
                // Add "None" option at the top to clear assignment
                const noneOption = `
                    <div class="form-check user-item" style="padding: 0.4rem; border-bottom: 1px solid #dee2e6; margin-bottom: 0.25rem;">
                        <input class="form-check-input user-radio" type="radio" 
                               name="matterAssignmentUser" 
                               id="matter_user_0" 
                               value="0"
                               ${selectedUserId === 0 ? 'checked' : ''}
                               style="margin-top: 0.75rem;">
                        <label class="form-check-label" for="matter_user_0" style="cursor: pointer; font-size: 0.875rem;">
                            <strong class="text-muted">None (Clear assignment)</strong>
                        </label>
                    </div>
                `;
                availableUsersList.innerHTML = noneOption + availableUsersList.innerHTML;
                
                // Add radio event listeners
                const radios = availableUsersList.querySelectorAll('.user-radio');
                radios.forEach(radio => {
                    radio.addEventListener('change', function() {
                        selectedUserId = parseInt(this.value);
                        updateSelectedDisplay();
                    });
                    
                    // Also handle click event for immediate feedback
                    radio.addEventListener('click', function() {
                        selectedUserId = parseInt(this.value);
                        updateSelectedDisplay();
                    });
                });
                
                // Also handle clicks on labels (since clicking label triggers radio change)
                const labels = availableUsersList.querySelectorAll('label[for^="matter_user_"]');
                labels.forEach(label => {
                    label.addEventListener('click', function(e) {
                        const radioId = this.getAttribute('for');
                        const radioBtn = document.getElementById(radioId);
                        if (radioBtn) {
                            // Trigger change event
                            radioBtn.checked = true;
                            selectedUserId = parseInt(radioBtn.value);
                            updateSelectedDisplay();
                        }
                    });
                });
            }
            
            function updateSelectedDisplay() {
                if (selectedUserId === 0) {
                    selectedUserDisplay.innerHTML = '<p class="text-muted mb-0 small">No user selected (assignment will be cleared).</p>';
                    return;
                }
                
                const selectedUser = allUsers.find(u => u.id === selectedUserId);
                if (selectedUser) {
                    const initials = selectedUser.initials || selectedUser.name.split(' ').map(n => n[0]).join('').toUpperCase().substring(0, 2);
                    selectedUserDisplay.innerHTML = `
                        <div class="d-flex align-items-center gap-2">
                            <div class="member-avatar" style="width: 2rem; height: 2rem; font-size: 0.75rem;">
                                ${initials}
                            </div>
                            <div>
                                <div class="fw-bold" style="font-size: 0.875rem;">${selectedUser.name}</div>
                                ${selectedUser.email ? `<small class="text-muted d-block" style="font-size: 0.75rem;">${selectedUser.email}</small>` : ''}
                            </div>
                        </div>
                    `;
                } else {
                    selectedUserDisplay.innerHTML = '<p class="text-muted mb-0 small">No user selected yet.</p>';
                }
            }
            
            // Initialize display
            renderUsers();
            updateSelectedDisplay();
            
            // Ensure selectedUserId is properly initialized for display
            if (currentUserId > 0) {
                selectedUserId = currentUserId;
                updateSelectedDisplay();
            }
            
            // Search functionality
            searchInput.addEventListener('input', function() {
                renderUsers(this.value);
                // Update display after re-rendering to ensure selected user is shown
                updateSelectedDisplay();
            });
            
            // Handle Done button - only update UI, don't save to backend
            popup.querySelector('#matterAssignmentDone').addEventListener('click', function() {
                if (selectedUserId === currentUserId) {
                    // No change
                    popup.remove();
                    document.removeEventListener('click', outsideClickHandler);
                    return;
                }
                
                // Update UI only
                const roleMap = {
                    'ResponsibleAttorney': 'MC / Host',
                    'ResponsibleStaff': 'Photobooth',
                    'OriginatingAttorney': 'DJ & Music'
                };
                
                // Update the input field
                const inputId = assignmentType === 'ResponsibleAttorney' ? 'responsibleAttorneyInput' :
                               assignmentType === 'ResponsibleStaff' ? 'responsibleStaffInput' :
                               'originatingAttorneyInput';
                const input = document.getElementById(inputId);
                
                if (selectedUserId === 0) {
                    // Clearing assignment
                    if (input) {
                        input.value = 'Not specified';
                    }
                    // Store pending change
                    pendingAssignmentChanges[assignmentType] = {
                        userId: 0,
                        assignmentId: assignmentId,
                        clearAssignment: true
                    };
                    button.dataset.currentUserId = '0';
                    button.dataset.assignmentId = '0';
                } else {
                    // Assigning user
                    const selectedUser = allUsers.find(u => u.id === selectedUserId);
                    if (input && selectedUser) {
                        input.value = selectedUser.name;
                    }
                    // Store pending change
                    pendingAssignmentChanges[assignmentType] = {
                        userId: selectedUserId,
                        assignmentType: assignmentType,
                        assignmentId: assignmentId,
                        clearAssignment: false
                    };
                    button.dataset.currentUserId = selectedUserId;
                }
                
                // Show save indicator
                showSaveIndicator();
                
                // Close popup
                popup.remove();
                document.removeEventListener('click', outsideClickHandler);
            });
            
            // Handle Cancel button
            popup.querySelector('#matterAssignmentCancel').addEventListener('click', function() {
                popup.remove();
                document.removeEventListener('click', outsideClickHandler);
            });
            
            // Close on outside click
            const outsideClickHandler = function(e) {
                if (!popup.contains(e.target) && e.target !== button) {
                    popup.remove();
                    document.removeEventListener('click', outsideClickHandler);
                }
            };
            
            // Add click handler after a short delay to avoid immediate closing
            setTimeout(() => {
                document.addEventListener('click', outsideClickHandler);
            }, 100);
        }

        // Initialize relevant contacts functionality
        document.addEventListener('DOMContentLoaded', function() {
            // Add contact button click handler
            const addContactBtn = document.getElementById('addRelevantContactBtn');
            if (addContactBtn) {
                addContactBtn.addEventListener('click', showAddRelevantContactPopup);
            }
            
            // Remove contact button handlers
            document.querySelectorAll('.remove-contact-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const assignmentId = this.dataset.assignmentId;
                    removeRelevantContact(assignmentId, this.closest('.relevant-contact-row'));
                });
            });
        });

        // Show popup to add relevant contact
        async function showAddRelevantContactPopup() {
            await loadUsersForAssignment();
            
            const addBtn = document.getElementById('addRelevantContactBtn');
            const btnRect = addBtn.getBoundingClientRect();
            
            // Create popup - position right above the Add button
            const popupHeight = 320; // Approximate height of popup
            const popup = document.createElement('div');
            popup.className = 'relevant-contact-popup';
            popup.style.cssText = `
                position: fixed;
                top: ${btnRect.top - popupHeight - 10}px;
                left: ${btnRect.right - 350}px;
                background: white;
                border-radius: 0.5rem;
                padding: 1rem;
                width: 350px;
                max-height: 400px;
                overflow-y: auto;
                box-shadow: 0 4px 20px rgba(0,0,0,0.15);
                border: 1px solid #dee2e6;
                z-index: 1100;
            `;
            
            // Adjust position if off-screen
            const screenWidth = window.innerWidth;
            if (btnRect.right - 350 < 10) {
                popup.style.left = '10px';
            }
            // If popup would go above viewport, show below button instead
            if (btnRect.top - popupHeight - 10 < 10) {
                popup.style.top = `${btnRect.bottom + 10}px`;
            }
            
            popup.innerHTML = `
                <div class="mb-3">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fas fa-user-plus me-2" style="color: #3d1019; font-size: 1rem;"></i>
                        <div>
                            <h6 class="fw-bold text-dark mb-0" style="font-size: 0.9rem;">Add Relevant Contact</h6>
                            <p class="text-muted mb-0" style="font-size: 0.75rem;">Select a contact and their role.</p>
                        </div>
                    </div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label fw-bold text-dark mb-1" style="font-size: 0.85rem;">Contact</label>
                    <select id="newContactUserSelect" class="form-select form-select-sm">
                        <option value="">Select a contact...</option>
                        ${allUsers.map(u => `<option value="${u.id}">${u.name}${u.email ? ' (' + u.email + ')' : ''}</option>`).join('')}
                    </select>
                </div>
                
                <div class="mb-3">
                    <label class="form-label fw-bold text-dark mb-1" style="font-size: 0.85rem;">Involvement / Role</label>
                    <input type="text" id="newContactRole" class="form-control form-control-sm" placeholder="e.g., Decision maker, Billing contact">
                </div>
                
                <div class="mb-3">
                    <div class="form-check">
                        <input type="checkbox" id="newContactNotify" class="form-check-input" checked>
                        <label class="form-check-label" style="font-size: 0.85rem;">Notify recipient</label>
                    </div>
                </div>
                
                <div class="d-flex justify-content-end">
                    <button class="btn btn-secondary btn-sm" id="cancelAddContact" style="border-radius: 0.5rem;">Cancel</button>
                    <button class="btn btn-primary btn-sm" id="confirmAddContact" style="border-radius: 0.5rem; margin-left: 0.5rem;">Add Contact</button>
                </div>
            `;
            
            document.body.appendChild(popup);
            
            // Cancel button
            popup.querySelector('#cancelAddContact').addEventListener('click', function() {
                popup.remove();
            });
            
            // Confirm button - add contact immediately via API
            popup.querySelector('#confirmAddContact').addEventListener('click', async function() {
                const userId = popup.querySelector('#newContactUserSelect').value;
                const role = popup.querySelector('#newContactRole').value.trim();
                const notify = popup.querySelector('#newContactNotify').checked;
                
                if (!userId) {
                    alert('Please select a contact.');
                    return;
                }
                
                if (!role) {
                    alert('Please enter an involvement/role.');
                    return;
                }
                
                try {
                    const response = await fetch(`/Client/${organizationId}/Matter/${matterId}/Assignment`, {
                        method: 'POST',
                        credentials: 'include',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            userId: parseInt(userId),
                            assignmentType: 'RelevantContact',
                            role: role,
                            isNotifyRecipient: notify
                        })
                    });
                    
                    if (response.ok) {
                        popup.remove();
                        location.reload(); // Refresh to show the new contact
                    } else {
                        const errorData = await response.json();
                        console.error('Error adding contact:', errorData);
                        alert('Error adding contact. Please try again.');
                    }
                } catch (error) {
                    console.error('Error adding contact:', error);
                    alert('An error occurred. Please try again.');
                }
            });
            
            // Close on outside click
            const outsideClickHandler = function(e) {
                if (!popup.contains(e.target) && e.target !== addBtn) {
                    popup.remove();
                    document.removeEventListener('click', outsideClickHandler);
                }
            };
            
            setTimeout(() => {
                document.addEventListener('click', outsideClickHandler);
            }, 100);
        }

        // Remove relevant contact
        async function removeRelevantContact(assignmentId, rowElement) {
            if (!confirm('Are you sure you want to remove this contact?')) {
                return;
            }
            
            try {
                const response = await fetch(`/Client/${organizationId}/Matter/${matterId}/Assignment/${assignmentId}`, {
                    method: 'DELETE',
                    credentials: 'include',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                
                if (response.ok) {
                    // Remove the row from UI
                    rowElement.remove();
                    
                    // If no contacts left, show the "no contacts" message
                    const container = document.getElementById('relevant-contacts-container');
                    if (container && container.querySelectorAll('.relevant-contact-row').length === 0) {
                        container.innerHTML = `
                            <div class="text-muted small text-center py-2" id="noContactsMessage">
                                <i class="fas fa-info-circle me-1"></i>
                                No relevant contacts added yet.
                            </div>
                        `;
                    }
                } else {
                    const errorData = await response.json();
                    console.error('Error removing contact:', errorData);
                    alert('Error removing contact. Please try again.');
                }
            } catch (error) {
                console.error('Error removing contact:', error);
                alert('An error occurred. Please try again.');
            }
        }

        // ============================================
        // Timeline Tab (Planner View) Logic
        // ============================================
        (function() {
            'use strict';

            const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
            const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
            
            let timelineViewDate = new Date();
            let timelineCurrentView = 'day'; // 'day' or 'week'
            let timelineInitialized = false;
            let matterEventDate = null;

            // Parse the matter's event date
            const matterDueDateStr = '@(Model.Matter.DueDate?.ToString("yyyy-MM-dd") ?? "")';
            if (matterDueDateStr) {
                matterEventDate = new Date(matterDueDateStr + 'T00:00:00');
            }

            function initTimeline() {
                if (timelineInitialized) return;
                timelineInitialized = true;

                // Navigation buttons
                document.getElementById('timelinePrevBtn')?.addEventListener('click', () => navigateTimeline(-1));
                document.getElementById('timelineNextBtn')?.addEventListener('click', () => navigateTimeline(1));

                // View toggle dropdown
                document.querySelectorAll('.timeline-view-option').forEach(opt => {
                    opt.addEventListener('click', (e) => {
                        e.preventDefault();
                        const view = opt.dataset.view;
                        switchTimelineView(view);
                    });
                });

                // Set initial view to day and navigate to event date if available
                if (matterEventDate) {
                    timelineViewDate = new Date(matterEventDate);
                }
                switchTimelineView('day');

                // Update time indicator
                updateTimelineCurrentTimeIndicator();
                setInterval(updateTimelineCurrentTimeIndicator, 60000);
            }

            function navigateTimeline(direction) {
                if (timelineCurrentView === 'day') {
                    timelineViewDate.setDate(timelineViewDate.getDate() + direction);
                } else {
                    timelineViewDate.setDate(timelineViewDate.getDate() + (direction * 7));
                }
                updateTimelineHeader();
                updateTimelineEventBadges();
                renderTimelineTasks();
                updateTimelineCurrentTimeIndicator();
            }

            function switchTimelineView(view) {
                timelineCurrentView = view;
                const tabTimeline = document.getElementById('tab-timeline');
                
                // Update view class
                tabTimeline.classList.remove('day-view', 'week-view');
                tabTimeline.classList.add(view + '-view');

                // Update dropdown
                document.querySelectorAll('.timeline-view-option').forEach(opt => {
                    opt.classList.toggle('active', opt.dataset.view === view);
                });
                const label = document.getElementById('timelineViewToggleLabel');
                if (label) label.textContent = view === 'day' ? 'Day' : 'Week';

                updateTimelineHeader();
                updateTimelineEventBadges();
                renderTimelineTasks();
                updateTimelineCurrentTimeIndicator();
            }

            function updateTimelineHeader() {
                const dateLabel = document.getElementById('timelineMonthLabel');
                const daysHeader = document.getElementById('timelineDaysHeader');
                const datesHeader = document.getElementById('timelineDatesHeader');

                if (timelineCurrentView === 'day') {
                    const options = { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' };
                    if (dateLabel) dateLabel.textContent = timelineViewDate.toLocaleDateString('en-US', options);

                    const dayHeaders = daysHeader?.querySelectorAll('.timeline-day-header');
                    if (dayHeaders && dayHeaders[1]) dayHeaders[1].textContent = dayNames[timelineViewDate.getDay()];

                    const dateCells = datesHeader?.querySelectorAll('.timeline-date-cell');
                    if (dateCells && dateCells[1]) {
                        dateCells[1].textContent = timelineViewDate.getDate();
                        dateCells[1].classList.toggle('today', isTimelineToday(timelineViewDate));
                    }
                } else {
                    const weekStart = getTimelineWeekStart(timelineViewDate);
                    const weekEnd = new Date(weekStart);
                    weekEnd.setDate(weekEnd.getDate() + 6);

                    let labelText;
                    if (weekStart.getMonth() === weekEnd.getMonth()) {
                        labelText = `${monthNames[weekStart.getMonth()]} ${weekStart.getFullYear()}`;
                    } else {
                        labelText = `${monthNames[weekStart.getMonth()].substring(0, 3)} - ${monthNames[weekEnd.getMonth()].substring(0, 3)} ${weekEnd.getFullYear()}`;
                    }
                    if (dateLabel) dateLabel.textContent = labelText;

                    const dayHeaders = daysHeader?.querySelectorAll('.timeline-day-header');
                    for (let i = 0; i < 7; i++) {
                        if (dayHeaders && dayHeaders[i + 1]) dayHeaders[i + 1].textContent = dayNames[i];
                    }

                    const dateCells = datesHeader?.querySelectorAll('.timeline-date-cell');
                    for (let i = 0; i < 7; i++) {
                        const date = new Date(weekStart);
                        date.setDate(date.getDate() + i);
                        if (dateCells && dateCells[i + 1]) {
                            dateCells[i + 1].textContent = date.getDate();
                            dateCells[i + 1].classList.toggle('today', isTimelineToday(date));
                        }
                    }
                }
            }

            function updateTimelineEventBadges() {
                const badgeRow = document.getElementById('timelineEventBadgeRow');
                if (!badgeRow) return;

                // Clear existing badges
                badgeRow.querySelectorAll('.timeline-event-badge').forEach(b => b.remove());

                if (!matterEventDate) return;

                if (timelineCurrentView === 'day') {
                    if (isTimelineSameDay(timelineViewDate, matterEventDate)) {
                        const cell = badgeRow.querySelector('.timeline-event-badge-cell[data-day="0"]');
                        if (cell) {
                            cell.innerHTML = '<span class="timeline-event-badge"><i class="fas fa-star"></i> Day of Event</span>';
                        }
                    }
                } else {
                    const weekStart = getTimelineWeekStart(timelineViewDate);
                    for (let i = 0; i < 7; i++) {
                        const date = new Date(weekStart);
                        date.setDate(date.getDate() + i);
                        if (isTimelineSameDay(date, matterEventDate)) {
                            const cell = badgeRow.querySelector(`.timeline-event-badge-cell[data-day="${i}"]`);
                            if (cell) {
                                cell.innerHTML = '<span class="timeline-event-badge"><i class="fas fa-star"></i> Day of Event</span>';
                            }
                        }
                    }
                }
            }

            function renderTimelineTasks() {
                // Clear existing task cards
                document.querySelectorAll('#tab-timeline .timeline-task-card, #tab-timeline .timeline-all-day-task').forEach(el => el.remove());

                // Get tasks for this matter (you can extend this to load from API)
                const tasks = window.matterTasks || [];
                
                tasks.forEach(task => {
                    if (!task.dueDate) return;

                    const taskDueDate = new Date(task.dueDate);
                    let columnIndex = -1;

                    if (timelineCurrentView === 'day') {
                        if (isTimelineSameDay(taskDueDate, timelineViewDate)) {
                            columnIndex = 0;
                        }
                    } else {
                        const weekStart = getTimelineWeekStart(timelineViewDate);
                        for (let i = 0; i < 7; i++) {
                            const columnDate = new Date(weekStart);
                            columnDate.setDate(columnDate.getDate() + i);
                            if (isTimelineSameDay(taskDueDate, columnDate)) {
                                columnIndex = i;
                                break;
                            }
                        }
                    }

                    if (columnIndex === -1) return;

                    const hasTime = task.dueDate && task.dueDate.indexOf('T') !== -1;
                    const hour = taskDueDate.getHours();
                    const minutes = taskDueDate.getMinutes();

                    if (!hasTime || (hour === 0 && minutes === 0)) {
                        const allDayCell = document.querySelector(`#timelineAllDayRow .timeline-all-day-cell[data-day="${columnIndex}"]`);
                        if (allDayCell) {
                            const taskEl = createTimelineAllDayTask(task);
                            allDayCell.appendChild(taskEl);
                        }
                    } else {
                        const column = document.querySelector(`#timelineColumns .timeline-column[data-day="${columnIndex}"]`);
                        if (column) {
                            const taskEl = createTimelineTaskCard(task, taskDueDate);
                            column.appendChild(taskEl);
                        }
                    }
                });
            }

            function createTimelineAllDayTask(task) {
                const el = document.createElement('div');
                el.className = 'timeline-all-day-task';
                el.textContent = task.title;
                el.style.borderLeftColor = getPriorityColor(task.priority);
                el.addEventListener('click', () => {
                    if (typeof openTaskModal === 'function') openTaskModal(task.id);
                });
                return el;
            }

            function createTimelineTaskCard(task, dueDate) {
                const el = document.createElement('div');
                el.className = 'timeline-task-card';
                el.textContent = task.title;
                el.style.borderLeftColor = getPriorityColor(task.priority);

                const hour = dueDate.getHours();
                const minutes = dueDate.getMinutes();
                const top = (hour * 60 + minutes);
                el.style.top = top + 'px';
                el.style.height = '50px';

                el.addEventListener('click', () => {
                    if (typeof openTaskModal === 'function') openTaskModal(task.id);
                });
                return el;
            }

            function getPriorityColor(priority) {
                const colors = { 'Critical': '#dc3545', 'High': '#fd7e14', 'Medium': '#0d6efd', 'Low': '#6c757d' };
                return colors[priority] || colors['Medium'];
            }

            function updateTimelineCurrentTimeIndicator() {
                const indicator = document.getElementById('timelineCurrentTimeLine');
                if (!indicator) return;

                const now = new Date();
                let columnIndex = -1;

                if (timelineCurrentView === 'day') {
                    if (isTimelineToday(timelineViewDate)) {
                        columnIndex = 0;
                    }
                } else {
                    const weekStart = getTimelineWeekStart(timelineViewDate);
                    for (let i = 0; i < 7; i++) {
                        const date = new Date(weekStart);
                        date.setDate(date.getDate() + i);
                        if (isTimelineToday(date)) {
                            columnIndex = i;
                            break;
                        }
                    }
                }

                if (columnIndex === -1) {
                    indicator.style.display = 'none';
                    return;
                }

                const hour = now.getHours();
                const minutes = now.getMinutes();
                const top = (hour * 60 + minutes);

                indicator.style.display = 'block';
                indicator.style.top = top + 'px';

                // Position horizontally within the correct column
                const columnsWrapper = document.getElementById('timelineColumns');
                const columns = columnsWrapper?.querySelectorAll('.timeline-column');
                if (columns && columns[columnIndex]) {
                    const columnWidth = columns[columnIndex].offsetWidth;
                    const totalWidth = columnsWrapper.offsetWidth;
                    const left = (columnIndex / (timelineCurrentView === 'day' ? 1 : 7)) * 100;
                    const width = (1 / (timelineCurrentView === 'day' ? 1 : 7)) * 100;
                    indicator.style.left = left + '%';
                    indicator.style.width = width + '%';
                }
            }

            function getTimelineWeekStart(date) {
                const d = new Date(date);
                const day = d.getDay();
                d.setDate(d.getDate() - day);
                d.setHours(0, 0, 0, 0);
                return d;
            }

            function isTimelineToday(date) {
                const today = new Date();
                return date.getFullYear() === today.getFullYear() &&
                       date.getMonth() === today.getMonth() &&
                       date.getDate() === today.getDate();
            }

            function isTimelineSameDay(date1, date2) {
                return date1.getFullYear() === date2.getFullYear() &&
                       date1.getMonth() === date2.getMonth() &&
                       date1.getDate() === date2.getDate();
            }

            // Initialize when timeline tab is shown
            const observer = new MutationObserver((mutations) => {
                mutations.forEach((mutation) => {
                    if (mutation.type === 'attributes' && mutation.attributeName === 'style') {
                        const tabTimeline = document.getElementById('tab-timeline');
                        if (tabTimeline && tabTimeline.style.display !== 'none') {
                            initTimeline();

                            // Scroll to current time on first load
                            setTimeout(() => {
                                const now = new Date();
                                const scrollTo = Math.max(0, (now.getHours() - 2) * 60);
                                const timeGrid = document.getElementById('timelineTimeGrid');
                                if (timeGrid) timeGrid.scrollTop = scrollTo;
                            }, 100);
                        }
                    }
                });
            });

            const tabTimeline = document.getElementById('tab-timeline');
            if (tabTimeline) {
                observer.observe(tabTimeline, { attributes: true });
            }

            // Also handle immediate init if tab is already visible
            if (tabTimeline && tabTimeline.style.display !== 'none') {
                initTimeline();
            }

            // Expose initialization function globally for matter-details.js
            window.initializeTimeline = initTimeline;

            // Listen for custom tab change event from matter-details.js
            document.addEventListener('matterTabChanged', function(e) {
                if (e.detail && e.detail.tabName === 'timeline') {
                    initTimeline();
                    // Scroll to current time or event date
                    setTimeout(() => {
                        const timeGrid = document.getElementById('timelineTimeGrid');
                        if (timeGrid) {
                            const now = new Date();
                            const scrollTo = Math.max(0, (now.getHours() - 2) * 60);
                            timeGrid.scrollTop = scrollTo;
                        }
                    }, 100);
                }
            });
        })();
    </script>
}

@functions {
    string GetStatusClass(string status)
    {
        return status switch
        {
            "Completed" => "bg-success text-white",
            "In Progress" => "bg-primary text-white",
            "Review" => "bg-warning text-dark",
            "Planning" => "bg-secondary text-white",
            _ => "bg-secondary text-white"
        };
    }

    string GetStatusIcon(string status)
    {
        return status switch
        {
            "Completed" => "fas fa-check-circle text-success",
            "In Progress" => "fas fa-play-circle text-primary",
            "Review" => "fas fa-exclamation-circle text-warning",
            "Planning" => "fas fa-clock text-muted",
            _ => "fas fa-clock text-muted"
        };
    }
}

