<script>
(function() {
    // Contacts tab scoped variables
    const contactsOrgId = @organizationId;
    const contactsMatterId = @matterId;
    let contactsAllUsers = [];
    let contactsHasUnsavedChanges = false;
    let pendingContactsAssignmentChanges = {};

    // Show / hide save indicator (green check button)
    function showContactsSaveIndicator() {
        contactsHasUnsavedChanges = true;
        const saveBtn = document.getElementById('contactsSaveBtn');
        if (saveBtn) {
            saveBtn.style.display = 'block';
        }
    }

    function hideContactsSaveIndicator() {
        contactsHasUnsavedChanges = false;
        const saveBtn = document.getElementById('contactsSaveBtn');
        if (saveBtn) {
            saveBtn.style.display = 'none';
        }
    }

    // Save all pending assignment changes to backend
    window.saveContactsChanges = async function() {
        const hasAssignmentChanges = Object.keys(pendingContactsAssignmentChanges).length > 0;

        if (!contactsHasUnsavedChanges || !hasAssignmentChanges) {
            hideContactsSaveIndicator();
            return;
        }

        try {
            const roleMap = {
                'ResponsibleAttorney': 'Lead Coordinator',
                'ResponsibleStaff': 'Assistant'
            };

            for (const [assignmentType, change] of Object.entries(pendingContactsAssignmentChanges)) {
                const { userId, assignmentId, clearAssignment } = change;

                if (clearAssignment) {
                    if (assignmentId > 0) {
                        const removeResponse = await fetch(`/Client/${contactsOrgId}/Matter/${contactsMatterId}/Assignment/${assignmentId}`, {
                            method: 'DELETE',
                            credentials: 'include',
                            headers: { 'Content-Type': 'application/json' }
                        });
                        if (!removeResponse.ok) {
                            const errorData = await removeResponse.json();
                            console.error('Error removing assignment:', errorData);
                            alert(`Error removing ${assignmentType} assignment. Please try again.`);
                            return;
                        }
                    }
                } else if (userId > 0) {
                    const assignResponse = await fetch(`/Client/${contactsOrgId}/Matter/${contactsMatterId}/Assignment`, {
                        method: 'POST',
                        credentials: 'include',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            userId: userId,
                            assignmentType: assignmentType,
                            role: roleMap[assignmentType] || '',
                            isNotifyRecipient: true
                        })
                    });
                    if (!assignResponse.ok) {
                        const errorData = await assignResponse.json();
                        console.error('Error assigning user:', errorData);
                        alert(`Error assigning ${assignmentType}. Please try again.`);
                        return;
                    }
                }
            }

            // Clear pending changes and refresh page
            pendingContactsAssignmentChanges = {};
            hideContactsSaveIndicator();
            location.reload();

        } catch (error) {
            console.error('Error saving changes:', error);
            alert('An error occurred while saving changes. Please try again.');
        }
    };

    // Load users for assignment popup
    async function loadContactsUsers() {
        if (contactsAllUsers.length > 0) return contactsAllUsers;
        
        try {
            const response = await fetch(`/Client/${contactsOrgId}/Matter/${contactsMatterId}/Users`, {
                credentials: 'include'
            });
            if (response.ok) {
                const result = await response.json();
                if (result.success && result.users) {
                    contactsAllUsers = result.users.map(u => ({
                        id: u.id,
                        name: u.name || `${u.firstName || ''} ${u.lastName || ''}`.trim(),
                        initials: u.initials || `${(u.firstName || '')[0] || ''}${(u.lastName || '')[0] || ''}`.toUpperCase(),
                        email: u.email
                    }));
                }
            }
        } catch (error) {
            console.error('Error loading users:', error);
        }
        return contactsAllUsers;
    }

    // Show assignment popup for Lead Coordinator / Assistant
    window.showContactsAssignmentPopup = async function(button) {
        const assignmentType = button.dataset.assignmentType;
        const assignmentId = parseInt(button.dataset.assignmentId) || 0;
        const currentUserId = parseInt(button.dataset.currentUserId) || 0;
        
        const assignmentLabels = {
            'ResponsibleAttorney': 'Lead Coordinator',
            'ResponsibleStaff': 'Assistant'
        };
        const assignmentLabel = assignmentLabels[assignmentType] || assignmentType;
        
        await loadContactsUsers();
        
        const popup = document.createElement('div');
        popup.className = 'matter-assignment-popup';
        
        const btnRect = button.getBoundingClientRect();
        
        popup.style.cssText = `
            position: fixed;
            top: ${btnRect.top}px;
            left: ${btnRect.right + 10}px;
            background: white;
            border-radius: 0.5rem;
            padding: 1rem;
            width: 400px;
            max-height: 500px;
            overflow-y: auto;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            border: 1px solid #dee2e6;
            z-index: 1100;
        `;
        
        const popupWidth = 400;
        const screenWidth = window.innerWidth;
        if (btnRect.right + popupWidth + 10 > screenWidth) {
            popup.style.left = `${btnRect.left - popupWidth - 10}px`;
        }
        
        const popupHeight = 500;
        const screenHeight = window.innerHeight;
        if (btnRect.top + popupHeight > screenHeight) {
            popup.style.top = `${Math.max(10, screenHeight - popupHeight - 10)}px`;
        }
        
        let selectedUserId = currentUserId;
        
        popup.innerHTML = `
            <div class="mb-2">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-user-plus me-2" style="color: #3d1019; font-size: 1rem;"></i>
                        <div>
                            <h6 class="fw-bold text-dark mb-0" style="font-size: 0.9rem;">Select ${assignmentLabel}</h6>
                            <p class="text-muted mb-0" style="font-size: 0.75rem;">Choose a user for this assignment.</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="mb-2">
                <label class="form-label fw-bold text-dark mb-1" style="font-size: 0.85rem;">Search Users</label>
                <div class="input-group input-group-sm">
                    <input type="text" class="form-control" id="contactsAssignmentUserSearch" placeholder="Search by name or email..." style="font-size: 0.875rem;">
                    <button class="btn btn-outline-secondary" type="button">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>
            
            <div class="mb-2">
                <label class="form-label fw-bold text-dark mb-1" style="font-size: 0.85rem;">Selected User</label>
                <div id="contactsAssignmentSelectedUser" class="border rounded p-2" style="min-height: 50px; background-color: #f8f9fa; font-size: 0.875rem;">
                    <p class="text-muted mb-0 small">No user selected yet.</p>
                </div>
            </div>
            
            <div class="mb-2">
                <label class="form-label fw-bold text-dark mb-1" style="font-size: 0.85rem;">Available Users</label>
                <div id="contactsAssignmentAvailableUsers" class="border rounded" style="max-height: 10rem; overflow-y: auto; padding-left: 1.75rem;">
                </div>
            </div>
            
            <div class="d-flex justify-content-end mt-2">
                <button class="btn btn-secondary btn-sm" id="contactsAssignmentCancel" style="border-radius: 0.5rem;">Cancel</button>
                <button class="btn btn-primary btn-sm" id="contactsAssignmentDone" style="border-radius: 0.5rem; margin-left: 0.5rem;">Done</button>
            </div>
        `;
        
        document.body.appendChild(popup);
        
        const availableUsersList = popup.querySelector('#contactsAssignmentAvailableUsers');
        const selectedUserDisplay = popup.querySelector('#contactsAssignmentSelectedUser');
        const searchInput = popup.querySelector('#contactsAssignmentUserSearch');
        
        function renderUsers(filterText = '') {
            if (!contactsAllUsers || contactsAllUsers.length === 0) {
                availableUsersList.innerHTML = '<p class="text-muted mb-0" style="font-size: 0.75rem;">No users available.</p>';
                return;
            }
            
            const filtered = contactsAllUsers.filter(u => 
                !filterText || 
                u.name.toLowerCase().includes(filterText.toLowerCase()) || 
                (u.email && u.email.toLowerCase().includes(filterText.toLowerCase()))
            );
            
            availableUsersList.innerHTML = filtered.map(user => `
                <div class="form-check user-item" style="padding: 0.4rem;">
                    <input class="form-check-input user-radio" type="radio" 
                           name="contactsAssignmentUser" 
                           id="contacts_user_${user.id}" 
                           value="${user.id}"
                           ${selectedUserId === user.id ? 'checked' : ''}
                           style="margin-top: 0.75rem;">
                    <label class="form-check-label" for="contacts_user_${user.id}" style="cursor: pointer; font-size: 0.875rem;">
                        <strong>${user.name}</strong>
                        ${user.email ? `<small class="text-muted d-block" style="font-size: 0.75rem;">${user.email}</small>` : ''}
                    </label>
                </div>
            `).join('');
            
            const noneOption = `
                <div class="form-check user-item" style="padding: 0.4rem; border-bottom: 1px solid #dee2e6; margin-bottom: 0.25rem;">
                    <input class="form-check-input user-radio" type="radio" 
                           name="contactsAssignmentUser" 
                           id="contacts_user_0" 
                           value="0"
                           ${selectedUserId === 0 ? 'checked' : ''}
                           style="margin-top: 0.75rem;">
                    <label class="form-check-label" for="contacts_user_0" style="cursor: pointer; font-size: 0.875rem;">
                        <strong class="text-muted">None (Clear assignment)</strong>
                    </label>
                </div>
            `;
            availableUsersList.innerHTML = noneOption + availableUsersList.innerHTML;
            
            const radios = availableUsersList.querySelectorAll('.user-radio');
            radios.forEach(radio => {
                radio.addEventListener('change', function() {
                    selectedUserId = parseInt(this.value);
                    updateSelectedDisplay();
                });
                radio.addEventListener('click', function() {
                    selectedUserId = parseInt(this.value);
                    updateSelectedDisplay();
                });
            });
            
            const labels = availableUsersList.querySelectorAll('label[for^="contacts_user_"]');
            labels.forEach(label => {
                label.addEventListener('click', function(e) {
                    const radioId = this.getAttribute('for');
                    const radioBtn = document.getElementById(radioId);
                    if (radioBtn) {
                        radioBtn.checked = true;
                        selectedUserId = parseInt(radioBtn.value);
                        updateSelectedDisplay();
                    }
                });
            });
        }
        
        function updateSelectedDisplay() {
            if (selectedUserId === 0) {
                selectedUserDisplay.innerHTML = '<p class="text-muted mb-0 small">No user selected (assignment will be cleared).</p>';
                return;
            }
            
            const selectedUser = contactsAllUsers.find(u => u.id === selectedUserId);
            if (selectedUser) {
                const initials = selectedUser.initials || selectedUser.name.split(' ').map(n => n[0]).join('').toUpperCase().substring(0, 2);
                selectedUserDisplay.innerHTML = `
                    <div class="d-flex align-items-center gap-2">
                        <div class="member-avatar" style="width: 2rem; height: 2rem; font-size: 0.75rem;">
                            ${initials}
                        </div>
                        <div>
                            <div class="fw-bold" style="font-size: 0.875rem;">${selectedUser.name}</div>
                            ${selectedUser.email ? `<small class="text-muted d-block" style="font-size: 0.75rem;">${selectedUser.email}</small>` : ''}
                        </div>
                    </div>
                `;
            } else {
                selectedUserDisplay.innerHTML = '<p class="text-muted mb-0 small">No user selected yet.</p>';
            }
        }
        
        renderUsers();
        updateSelectedDisplay();
        
        if (currentUserId > 0) {
            selectedUserId = currentUserId;
            updateSelectedDisplay();
        }
        
        searchInput.addEventListener('input', function() {
            renderUsers(this.value);
            updateSelectedDisplay();
        });
        
        // Handle Done button - only update UI and store pending change (like Summary tab)
        popup.querySelector('#contactsAssignmentDone').addEventListener('click', function() {
            if (selectedUserId === currentUserId) {
                popup.remove();
                document.removeEventListener('click', outsideClickHandler);
                return;
            }
            
            // Update UI only
            const inputId = assignmentType === 'ResponsibleAttorney' ? 'contactsResponsibleAttorneyInput' : 'contactsResponsibleStaffInput';
            const input = document.getElementById(inputId);
            
            if (selectedUserId === 0) {
                // Clearing assignment
                if (input) input.value = 'Not specified';
                pendingContactsAssignmentChanges[assignmentType] = {
                    userId: 0,
                    assignmentId: assignmentId,
                    clearAssignment: true
                };
                button.dataset.currentUserId = '0';
                button.dataset.assignmentId = '0';
            } else {
                // Assigning user
                const selectedUser = contactsAllUsers.find(u => u.id === selectedUserId);
                if (input && selectedUser) input.value = selectedUser.name;
                pendingContactsAssignmentChanges[assignmentType] = {
                    userId: selectedUserId,
                    assignmentType: assignmentType,
                    assignmentId: assignmentId,
                    clearAssignment: false
                };
                button.dataset.currentUserId = selectedUserId;
            }
            
            // Show save indicator
            showContactsSaveIndicator();
            
            // Close popup
            popup.remove();
            document.removeEventListener('click', outsideClickHandler);
        });
        
        popup.querySelector('#contactsAssignmentCancel').addEventListener('click', function() {
            popup.remove();
            document.removeEventListener('click', outsideClickHandler);
        });
        
        const outsideClickHandler = function(e) {
            if (!popup.contains(e.target) && e.target !== button) {
                popup.remove();
                document.removeEventListener('click', outsideClickHandler);
            }
        };
        
        setTimeout(() => {
            document.addEventListener('click', outsideClickHandler);
        }, 100);
    };

    // Add relevant contact popup
    async function showContactsAddRelevantContactPopup() {
        await loadContactsUsers();
        
        const addBtn = document.getElementById('contactsAddRelevantContactBtn');
        const btnRect = addBtn.getBoundingClientRect();
        
        const popupHeight = 320;
        const popup = document.createElement('div');
        popup.className = 'relevant-contact-popup';
        popup.style.cssText = `
            position: fixed;
            top: ${btnRect.top - popupHeight - 10}px;
            left: ${btnRect.right - 350}px;
            background: white;
            border-radius: 0.5rem;
            padding: 1rem;
            width: 350px;
            max-height: 400px;
            overflow-y: auto;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            border: 1px solid #dee2e6;
            z-index: 1100;
        `;
        
        const screenWidth = window.innerWidth;
        if (btnRect.right - 350 < 10) {
            popup.style.left = '10px';
        }
        if (btnRect.top - popupHeight - 10 < 10) {
            popup.style.top = `${btnRect.bottom + 10}px`;
        }
        
        popup.innerHTML = `
            <div class="mb-3">
                <div class="d-flex align-items-center mb-2">
                    <i class="fas fa-user-plus me-2" style="color: #3d1019; font-size: 1rem;"></i>
                    <div>
                        <h6 class="fw-bold text-dark mb-0" style="font-size: 0.9rem;">Add Relevant Contact</h6>
                        <p class="text-muted mb-0" style="font-size: 0.75rem;">Select a contact and their role.</p>
                    </div>
                </div>
            </div>
            
            <div class="mb-3">
                <label class="form-label fw-bold text-dark mb-1" style="font-size: 0.85rem;">Contact</label>
                <select id="contactsNewContactUserSelect" class="form-select form-select-sm">
                    <option value="">Select a contact...</option>
                    ${contactsAllUsers.map(u => `<option value="${u.id}">${u.name}${u.email ? ' (' + u.email + ')' : ''}</option>`).join('')}
                </select>
            </div>
            
            <div class="mb-3">
                <label class="form-label fw-bold text-dark mb-1" style="font-size: 0.85rem;">Involvement / Role</label>
                <input type="text" id="contactsNewContactRole" class="form-control form-control-sm" placeholder="e.g., Decision maker, Billing contact">
            </div>
            
            <div class="mb-3">
                <div class="form-check">
                    <input type="checkbox" id="contactsNewContactNotify" class="form-check-input" checked>
                    <label class="form-check-label" style="font-size: 0.85rem;">Notify recipient</label>
                </div>
            </div>
            
            <div class="d-flex justify-content-end">
                <button class="btn btn-secondary btn-sm" id="contactsCancelAddContact" style="border-radius: 0.5rem;">Cancel</button>
                <button class="btn btn-primary btn-sm" id="contactsConfirmAddContact" style="border-radius: 0.5rem; margin-left: 0.5rem;">Add Contact</button>
            </div>
        `;
        
        document.body.appendChild(popup);
        
        popup.querySelector('#contactsCancelAddContact').addEventListener('click', function() {
            popup.remove();
        });
        
        popup.querySelector('#contactsConfirmAddContact').addEventListener('click', async function() {
            const userId = popup.querySelector('#contactsNewContactUserSelect').value;
            const role = popup.querySelector('#contactsNewContactRole').value.trim();
            const notify = popup.querySelector('#contactsNewContactNotify').checked;
            
            if (!userId) {
                alert('Please select a contact.');
                return;
            }
            
            if (!role) {
                alert('Please enter an involvement/role.');
                return;
            }
            
            try {
                const response = await fetch(`/Client/${contactsOrgId}/Matter/${contactsMatterId}/Assignment`, {
                    method: 'POST',
                    credentials: 'include',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        userId: parseInt(userId),
                        assignmentType: 'RelevantContact',
                        role: role,
                        isNotifyRecipient: notify
                    })
                });
                
                if (response.ok) {
                    popup.remove();
                    // Reload just the contacts tab
                    const tabContent = document.getElementById('tab-contacts');
                    if (tabContent && typeof window.__reloadContactsTab === 'function') {
                        window.__reloadContactsTab();
                    } else {
                        location.reload();
                    }
                } else {
                    const errorData = await response.json();
                    console.error('Error adding contact:', errorData);
                    alert('Error adding contact. Please try again.');
                }
            } catch (error) {
                console.error('Error adding contact:', error);
                alert('An error occurred. Please try again.');
            }
        });
        
        const outsideClickHandler = function(e) {
            if (!popup.contains(e.target) && e.target !== addBtn) {
                popup.remove();
                document.removeEventListener('click', outsideClickHandler);
            }
        };
        
        setTimeout(() => {
            document.addEventListener('click', outsideClickHandler);
        }, 100);
    }

    // Remove relevant contact
    async function removeContactsRelevantContact(assignmentId, rowElement) {
        if (!confirm('Are you sure you want to remove this contact?')) {
            return;
        }
        
        try {
            const response = await fetch(`/Client/${contactsOrgId}/Matter/${contactsMatterId}/Assignment/${assignmentId}`, {
                method: 'DELETE',
                credentials: 'include',
                headers: {
                    'Content-Type': 'application/json'
                }
            });
            
            if (response.ok) {
                rowElement.remove();
                
                const container = document.getElementById('contacts-relevant-contacts-container');
                if (container && container.querySelectorAll('.relevant-contact-row').length === 0) {
                    container.innerHTML = `
                        <div class="text-muted small text-center py-2" id="contactsNoContactsMessage">
                            <i class="fas fa-info-circle me-1"></i>
                            No relevant contacts added yet.
                        </div>
                    `;
                }
            } else {
                const errorData = await response.json();
                console.error('Error removing contact:', errorData);
                alert('Error removing contact. Please try again.');
            }
        } catch (error) {
            console.error('Error removing contact:', error);
            alert('An error occurred. Please try again.');
        }
    }

    // Initialize event listeners
    const addContactBtn = document.getElementById('contactsAddRelevantContactBtn');
    if (addContactBtn) {
        addContactBtn.addEventListener('click', showContactsAddRelevantContactPopup);
    }
    
    document.querySelectorAll('.contacts-remove-contact-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const assignmentId = this.dataset.assignmentId;
            removeContactsRelevantContact(assignmentId, this.closest('.relevant-contact-row'));
        });
    });

    // --- Vendor Modal Management ---
    function getInitials(first, last) {
        return ((first || '')[0] || '') + ((last || '')[0] || '').toUpperCase() || 'V';
    }

    function openContactModal(modalId) {
        const modal = document.getElementById(modalId);
        if (!modal) return;
        modal.style.display = 'flex';
        snapContactModalToMainContent(modal);
    }

    function closeContactModal(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) modal.style.display = 'none';
    }

    function snapContactModalToMainContent(modal) {
        if (!modal || modal.style.display === 'none') return;
        const wrapper = document.querySelector('.client-main-content-wrapper');
        if (!wrapper) return;
        const style = window.getComputedStyle(wrapper);
        if (style.right && style.right !== 'auto') modal.style.right = style.right;
        else modal.style.right = '';
        if (style.left && style.left !== 'auto') modal.style.left = style.left;
        else modal.style.left = '';
    }

    function snapAllContactModals() {
        snapContactModalToMainContent(document.getElementById('vendorDetailsModal'));
        snapContactModalToMainContent(document.getElementById('guestDetailsModal'));
    }

    window.showAddVendorPopup = function() {
        document.getElementById('vendorModalTitle').textContent = 'Add Vendor';
        document.getElementById('vendorEditId').value = '';
        document.getElementById('vendorModalAvatar').textContent = 'V';
        document.getElementById('vendorFirstName').value = '';
        document.getElementById('vendorLastName').value = '';
        document.getElementById('vendorEmail').value = '';
        document.getElementById('vendorPhone').value = '';
        document.getElementById('vendorCategory').value = '';
        document.getElementById('vendorStatus').value = 'Pending';
        document.getElementById('vendorContractAmount').value = '';
        document.getElementById('vendorAmountPaid').value = '';
        document.getElementById('vendorRole').value = '';
        openContactModal('vendorDetailsModal');
    };

    window.closeVendorModal = function() {
        closeContactModal('vendorDetailsModal');
    };

    window.editVendor = function(assignmentId) {
        const card = document.querySelector(`.vendor-card-col[data-assignment-id="${assignmentId}"]`);
        if (!card) return;
        document.getElementById('vendorModalTitle').textContent = 'Vendor Details';
        document.getElementById('vendorEditId').value = assignmentId;
        const fn = card.dataset.firstName || '';
        const ln = card.dataset.lastName || '';
        document.getElementById('vendorModalAvatar').textContent = getInitials(fn, ln);
        document.getElementById('vendorFirstName').value = fn;
        document.getElementById('vendorLastName').value = ln;
        document.getElementById('vendorEmail').value = card.dataset.email || '';
        document.getElementById('vendorPhone').value = card.dataset.phone || '';
        document.getElementById('vendorCategory').value = card.dataset.vendorCategory || '';
        document.getElementById('vendorStatus').value = card.dataset.vendorStatus || 'Pending';
        document.getElementById('vendorContractAmount').value = card.dataset.contractAmount || '';
        document.getElementById('vendorAmountPaid').value = card.dataset.amountPaid || '';
        document.getElementById('vendorRole').value = card.dataset.role || '';
        openContactModal('vendorDetailsModal');
    };

    window.saveVendor = async function() {
        const editId = document.getElementById('vendorEditId').value;
        const data = {
            assignmentType: 'Vendor',
            firstName: document.getElementById('vendorFirstName').value,
            lastName: document.getElementById('vendorLastName').value,
            email: document.getElementById('vendorEmail').value,
            phoneNumber: document.getElementById('vendorPhone').value,
            vendorCategory: document.getElementById('vendorCategory').value,
            vendorStatus: document.getElementById('vendorStatus').value,
            contractAmount: parseFloat(document.getElementById('vendorContractAmount').value) || null,
            amountPaid: parseFloat(document.getElementById('vendorAmountPaid').value) || null,
            role: document.getElementById('vendorRole').value
        };
        try {
            const url = editId
                ? `/Client/${contactsOrgId}/Matter/${contactsMatterId}/Contact/${editId}`
                : `/Client/${contactsOrgId}/Matter/${contactsMatterId}/Contact`;
            const resp = await fetch(url, {
                method: editId ? 'PUT' : 'POST',
                credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            if (resp.ok) { closeVendorModal(); location.reload(); }
            else alert('Error saving vendor.');
        } catch (e) { console.error(e); alert('Error saving vendor.'); }
    };

    window.removeVendor = async function(assignmentId) {
        if (!confirm('Remove this vendor?')) return;
        try {
            const resp = await fetch(`/Client/${contactsOrgId}/Matter/${contactsMatterId}/Contact/${assignmentId}`, { method: 'DELETE', credentials: 'include', headers: { 'Content-Type': 'application/json' } });
            if (resp.ok) location.reload();
            else alert('Error removing vendor.');
        } catch (e) { console.error(e); alert('Error removing vendor.'); }
    };

    // --- Guest Modal Management ---
    window.showAddGuestPopup = function() {
        document.getElementById('guestModalTitle').textContent = 'Add Guest';
        document.getElementById('guestEditId').value = '';
        document.getElementById('guestModalAvatar').textContent = 'G';
        document.getElementById('guestFirstName').value = '';
        document.getElementById('guestLastName').value = '';
        document.getElementById('guestEmail').value = '';
        document.getElementById('guestPhone').value = '';
        document.getElementById('guestPartySize').value = '1';
        document.getElementById('guestTableNumber').value = '';
        document.getElementById('guestRsvpStatus').value = 'Pending';
        document.getElementById('guestDietary').value = '';
        document.getElementById('guestMealChoice').value = '';
        openContactModal('guestDetailsModal');
    };

    window.closeGuestModal = function() {
        closeContactModal('guestDetailsModal');
    };

    window.editGuest = function(assignmentId) {
        const row = document.querySelector(`.guest-row[data-assignment-id="${assignmentId}"]`);
        if (!row) return;
        document.getElementById('guestModalTitle').textContent = 'Guest Details';
        document.getElementById('guestEditId').value = assignmentId;
        const fn = row.dataset.firstName || '';
        const ln = row.dataset.lastName || '';
        document.getElementById('guestModalAvatar').textContent = getInitials(fn, ln);
        document.getElementById('guestFirstName').value = fn;
        document.getElementById('guestLastName').value = ln;
        document.getElementById('guestEmail').value = row.dataset.email || '';
        document.getElementById('guestPhone').value = row.dataset.phone || '';
        document.getElementById('guestPartySize').value = row.dataset.partySize || '1';
        document.getElementById('guestTableNumber').value = row.dataset.tableNumber || '';
        document.getElementById('guestRsvpStatus').value = row.dataset.rsvpStatus || 'Pending';
        document.getElementById('guestDietary').value = row.dataset.dietary || '';
        document.getElementById('guestMealChoice').value = row.dataset.mealChoice || '';
        openContactModal('guestDetailsModal');
    };

    window.saveGuest = async function() {
        const editId = document.getElementById('guestEditId').value;
        const data = {
            assignmentType: 'Guest',
            firstName: document.getElementById('guestFirstName').value,
            lastName: document.getElementById('guestLastName').value,
            email: document.getElementById('guestEmail').value,
            phoneNumber: document.getElementById('guestPhone').value,
            partySize: parseInt(document.getElementById('guestPartySize').value) || 1,
            tableNumber: parseInt(document.getElementById('guestTableNumber').value) || null,
            rsvpStatus: document.getElementById('guestRsvpStatus').value,
            dietaryRestrictions: document.getElementById('guestDietary').value,
            mealChoice: document.getElementById('guestMealChoice').value
        };
        try {
            const url = editId
                ? `/Client/${contactsOrgId}/Matter/${contactsMatterId}/Contact/${editId}`
                : `/Client/${contactsOrgId}/Matter/${contactsMatterId}/Contact`;
            const resp = await fetch(url, {
                method: editId ? 'PUT' : 'POST',
                credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            if (resp.ok) { closeGuestModal(); location.reload(); }
            else alert('Error saving guest.');
        } catch (e) { console.error(e); alert('Error saving guest.'); }
    };

    window.removeGuest = async function(assignmentId) {
        if (!confirm('Remove this guest?')) return;
        try {
            const resp = await fetch(`/Client/${contactsOrgId}/Matter/${contactsMatterId}/Contact/${assignmentId}`, { method: 'DELETE', credentials: 'include', headers: { 'Content-Type': 'application/json' } });
            if (resp.ok) location.reload();
            else alert('Error removing guest.');
        } catch (e) { console.error(e); alert('Error removing guest.'); }
    };

    window.toggleGuestHiddenRows = function(toggleEl) {
        const card = toggleEl.closest('#guests-card');
        if (!card) return;
        const hiddenRows = card.querySelectorAll('.guest-hidden-row');
        const isExpanded = toggleEl.dataset.expanded === 'true';
        hiddenRows.forEach(row => { row.style.display = isExpanded ? 'none' : 'block'; });
        toggleEl.dataset.expanded = !isExpanded;
        const count = hiddenRows.length;
        toggleEl.innerHTML = isExpanded
            ? '<i class="fas fa-chevron-down"></i> Show ' + count + ' more'
            : '<i class="fas fa-chevron-up"></i> Show less';
    };

    // Wire up add buttons
    const addVendorBtn = document.getElementById('addVendorBtn');
    if (addVendorBtn) addVendorBtn.addEventListener('click', showAddVendorPopup);

    const addGuestBtn = document.getElementById('addGuestBtn');
    if (addGuestBtn) addGuestBtn.addEventListener('click', showAddGuestPopup);

    // Close modals on background click
    ['vendorDetailsModal', 'guestDetailsModal'].forEach(function(id) {
        const modal = document.getElementById(id);
        if (modal) {
            modal.addEventListener('click', function(e) {
                if (e.target === modal) closeContactModal(id);
            });
        }
    });

    // Dynamic positioning: snap modals to main-content wrapper
    const origAdjust = window.adjustTaskDetailsModalPosition;
    window.adjustTaskDetailsModalPosition = function() {
        if (typeof origAdjust === 'function') origAdjust();
        snapAllContactModals();
    };

    window.addEventListener('resize', snapAllContactModals);

    const mcObserver = new MutationObserver(function(mutations) {
        for (const m of mutations) {
            if (m.type === 'attributes' && m.attributeName === 'class') {
                setTimeout(snapAllContactModals, 50);
            }
        }
    });
    mcObserver.observe(document.body, { attributes: true, attributeFilter: ['class'] });

    const mcWrapper = document.querySelector('.client-main-content-wrapper');
    if (mcWrapper) {
        const wObs = new MutationObserver(function() { setTimeout(snapAllContactModals, 50); });
        wObs.observe(mcWrapper, { attributes: true, attributeFilter: ['style'] });
    }

    const mcHandle = document.getElementById('resizeHandle');
    if (mcHandle) {
        let mcResizing = false;
        let mcResizeTimeout;
        mcHandle.addEventListener('mousedown', function() { mcResizing = true; });
        document.addEventListener('mousemove', function() {
            if (!mcResizing) return;
            clearTimeout(mcResizeTimeout);
            mcResizeTimeout = setTimeout(snapAllContactModals, 16);
        });
        document.addEventListener('mouseup', function() {
            if (mcResizing) { mcResizing = false; snapAllContactModals(); }
        });
    }
})();
</script>
