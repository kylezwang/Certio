<script>
(function() {
    // Pass model data to JavaScript
    window.tasksData = {
        matters: @Html.Raw(Json.Serialize(Model.Matters)),
        users: @Html.Raw(Json.Serialize(Model.Users)),
        allTasks: @Html.Raw(Json.Serialize(Model.AllTasks))
    };

    // Pass current user data to JavaScript
    window.currentUser = {
        id: @ViewBag.CurrentUserId,
        name: '@ViewBag.CurrentUserName',
        initials: '@ViewBag.CurrentUserInitials',
        email: '@ViewBag.CurrentUserEmail'
    };

    // Global initialization function for Matter Tasks
    window.initializeMatterTasks = function() {
        const container = document.querySelector('.matter-tasks-content');
        if (!container) {
            console.error('Matter tasks container not found');
            return;
        }
        
        // Scope all selectors to the container
        const $ = (selector) => container.querySelector(selector);
        const $$ = (selector) => container.querySelectorAll(selector);
        
        // Clear any inline display styles on resizers and ensure they have proper initial styling
        const resizers = document.querySelectorAll('.view-resizer');
        resizers.forEach(resizer => {
            resizer.style.display = '';
            // Ensure resizers start hidden (tasks.js will show the right ones)
            resizer.classList.add('d-none');
        });
        
        // Initialize bottom navbar using shared function from tasks.js
        if (typeof window.initializeBottomNavbar === 'function') {
            window.initializeBottomNavbar();
            
            // Force resizers to show with inline styles (CSS has display:none as default)
            // The shared function uses classList, but CSS overrides it, so we need inline styles
            resizers.forEach(resizer => {
                const hasHiddenClass = resizer.classList.contains('d-none');
                if (!hasHiddenClass) {
                    resizer.style.display = 'flex';
                } else {
                    resizer.style.display = 'none';
                }
            });
        }
        
        // Initialize view resizers functionality (drag to resize)
        if (typeof initializeViewResizers === 'function') {
            initializeViewResizers();
        }
        
        // Watch for class changes on resizers to sync with inline styles
        // (Needed because CSS has display:none that overrides d-none removal)
        resizers.forEach(resizer => {
            const resizerObserver = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    if (mutation.attributeName === 'class') {
                        const hasHiddenClass = resizer.classList.contains('d-none');
                        if (!hasHiddenClass && resizer.style.display !== 'flex') {
                            resizer.style.display = 'flex';
                        } else if (hasHiddenClass && resizer.style.display !== 'none') {
                            resizer.style.display = 'none';
                        }
                    }
                });
            });
            
            resizerObserver.observe(resizer, {
                attributes: true,
                attributeFilter: ['class']
            });
        });
        
        // Setup add button positioning handler
        const tasksContent = document.querySelector('.matter-tasks-content, .tasks-content');
        if (tasksContent) {
            // Create MutationObserver to watch for class changes (especially 'all-views')
            const addButtonObserver = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    if (mutation.attributeName === 'class') {
                        handleAddButtonPositioning();
                    }
                });
            });
            
            addButtonObserver.observe(tasksContent, {
                attributes: true,
                attributeFilter: ['class']
            });
            
            // Call once immediately
            handleAddButtonPositioning();
        }
        
        // Function to handle add button positioning
        function handleAddButtonPositioning() {
            const addCardContainer = document.querySelector('.add-card-container');
            const addCardOuterContainer = document.querySelector('.add-card-outer-container');
            const tasksContent = document.querySelector('.matter-tasks-content, .tasks-content');
            
            if (!addCardContainer || !addCardOuterContainer || !tasksContent) return;
            
            const isAllViews = tasksContent.classList.contains('all-views');
            
            if (isAllViews) {
                // In all-views mode, move button outside outer container so it stays visible
                if (addCardContainer.parentElement === addCardOuterContainer) {
                    addCardContainer.dataset.originalParent = 'add-card-outer-container';
                    addCardOuterContainer.parentElement.insertBefore(addCardContainer, addCardOuterContainer);
                    addCardContainer.style.marginBottom = '0.5rem';
                }
            } else {
