                                                    <button class="btn btn-sm btn-link task-action-btn task-card-location-btn" title="Location" data-task-id="@task.Id" onclick="event.stopPropagation();">
                                                        <i class="fas fa-map-marker-alt"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-link task-action-btn task-card-comment-btn" title="Comments" data-task-id="@task.Id" onclick="event.stopPropagation();">
