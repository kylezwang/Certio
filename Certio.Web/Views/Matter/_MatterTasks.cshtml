                                                            </div>
                                                        }
                                                        @if (task.Assignments.Count > 2)
                                                        {
                                                            <div class="task-assignee-avatar-inline" title="+@(task.Assignments.Count - 2) more">
                                                                +@(task.Assignments.Count - 2)
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
