            // Adaptive floating actions positioning
            function updateFloatingActionsPosition() {
                const floatingActions = document.querySelector('.floating-actions');
                if (!floatingActions) return;

                // Get the tasks page container
                const tasksPage = document.querySelector('.tasks-page');
                if (!tasksPage) return;

                // Check if we're in multi-view mode
                const isMultiView = tasksContent.classList.contains('multi-view');
                
                if (isMultiView) {
                    // In multi-view mode, center within the inbox view
                    const inboxView = document.getElementById('inboxView');
                    if (inboxView) {
                        const rect = inboxView.getBoundingClientRect();
                        const centerX = rect.left + (rect.width / 2);
                        floatingActions.style.left = centerX + 'px';
                        floatingActions.style.transform = 'translateX(-50%)';
                    }
                } else {
                    // In single view mode, center within the full content area
                    const rect = tasksPage.getBoundingClientRect();
                    const centerX = rect.left + (rect.width / 2);
                    floatingActions.style.left = centerX + 'px';
                    floatingActions.style.transform = 'translateX(-50%)';
                }
            }

            // Adaptive navbar positioning (original behavior)
            function updateNavbarPosition() {
                const navbar = document.querySelector('.bottom-navbar');
                if (!navbar) return;

                // Get the tasks page container
                const tasksPage = document.querySelector('.tasks-page');
                if (!tasksPage) return;

                // Calculate the center of the visible content area
                const rect = tasksPage.getBoundingClientRect();
                const centerX = rect.left + (rect.width / 2);
                
                // Set the navbar position to the center of the content area
                navbar.style.left = centerX + 'px';
            }

            // Update on load and resize
            updateNavbarPosition();
            updateFloatingActionsPosition();
            window.addEventListener('resize', function() {
                updateNavbarPosition();
                updateFloatingActionsPosition();
            });
            
            // Update when layout changes (e.g., sidebar toggles)
            const resizeObserver = new ResizeObserver(function() {
                updateNavbarPosition();
                updateFloatingActionsPosition();
            });
            const tasksPage = document.querySelector('.tasks-page');
            if (tasksPage) {
                resizeObserver.observe(tasksPage);
            }

            // Also observe the main content container in case it changes
            const mainContent = document.querySelector('.main-content, .content-wrapper, main');
            if (mainContent) {
                resizeObserver.observe(mainContent);
            }

            // Kanban board vertical-to-horizontal scroll functionality
            const kanbanBoardContainer = document.querySelector('.kanban-board-container');
            if (kanbanBoardContainer) {
                let isScrolling = false;
                
                kanbanBoardContainer.addEventListener('wheel', function(e) {
                    // Only handle vertical scroll events
                    if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
                        e.preventDefault();
                        
                        // Convert vertical scroll to horizontal scroll
                        const scrollAmount = e.deltaY;
                        kanbanBoardContainer.scrollLeft += scrollAmount;
                        
                        // Add smooth scrolling effect
                        if (!isScrolling) {
                            isScrolling = true;
                            kanbanBoardContainer.style.scrollBehavior = 'smooth';
                            
                            setTimeout(() => {
                                isScrolling = false;
                                kanbanBoardContainer.style.scrollBehavior = 'auto';
                            }, 150);
                        }
                    }
                }, { passive: false });
            }

            // Scroll-to-field functionality for action buttons
            setupScrollToField();
        });

        function setupScrollToField() {
            // Wait a bit for modal to be fully rendered
            setTimeout(() => {
                const scrollableContainer = document.querySelector('.task-details-left');
                const statusBtn = document.getElementById('scroll-status-btn');
                const priorityBtn = document.getElementById('scroll-priority-btn');
                const datesBtn = document.getElementById('scroll-dates-btn');
                const checklistBtn = document.getElementById('scroll-checklist-btn');
                const attachmentBtn = document.getElementById('scroll-attachment-btn');
                
                const statusPrioritySection = document.getElementById('status-priority-section');
                const datesSection = document.getElementById('dates-section');
                const checklistSection = document.getElementById('checklist-section');
                const attachmentsSection = document.getElementById('attachments-section');
                
                const statusField = document.getElementById('status-field');
                const priorityField = document.getElementById('priority-field');
                const startDateField = document.getElementById('start-date-field');
                
                if (!scrollableContainer) {
                    console.error('Scrollable container not found');
                    return;
                }

            // Status button click handler
            if (statusBtn && statusPrioritySection) {
                statusBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    scrollToElement(statusPrioritySection);
                    // Remove focused class from other labels first
                    removeFocusedClass();
                    
                    // Add focused class to change color to black for Status label
                    const statusLabel = document.getElementById('status-label');
                    statusLabel.classList.add('focused');
                    
                    // Focus the field
                    setTimeout(() => statusField.focus(), 300);
                });
            }

            // Priority button click handler
            if (priorityBtn && statusPrioritySection) {
                priorityBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    scrollToElement(statusPrioritySection);
                    // Remove focused class from other labels first
                    removeFocusedClass();
                    
                    // Add focused class to change color to black for Priority label
                    const priorityLabel = document.getElementById('priority-label');
                    priorityLabel.classList.add('focused');
                    
                    // Focus the field
                    setTimeout(() => priorityField.focus(), 300);
                });
            }

            // Dates button click handler
            if (datesBtn && datesSection) {
                datesBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    scrollToElement(datesSection);
                    // Remove focused class from other labels first
                    removeFocusedClass();
                    
                    // Add focused class to change color to black for both date labels
                    const startDateLabel = document.getElementById('start-date-label');
                    const dueDateLabel = document.getElementById('due-date-label');
                    startDateLabel.classList.add('focused');
                    dueDateLabel.classList.add('focused');
                    
                    // Focus the first date field
                    setTimeout(() => startDateField.focus(), 300);
                });
            }

            // Checklist button click handler
            if (checklistBtn && checklistSection) {
                checklistBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    console.log('Checklist button clicked');
                    scrollToElement(checklistSection);
                    // Remove focused class from other labels
                    removeFocusedClass();
                });
            } else {
                console.log('Checklist elements not found:', { checklistBtn: !!checklistBtn, checklistSection: !!checklistSection });
            }

            // Attachment button click handler
            if (attachmentBtn && attachmentsSection) {
                attachmentBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    console.log('Attachment button clicked');
                    scrollToElement(attachmentsSection);
                    // Remove focused class from other labels
                    removeFocusedClass();
                });
            } else {
                console.log('Attachment elements not found:', { attachmentBtn: !!attachmentBtn, attachmentsSection: !!attachmentsSection });
            }

            // Location button click handler
            const locationBtn = document.getElementById('scroll-location-btn');
            const locationSection = document.getElementById('location-section');
            if (locationBtn && locationSection) {
                locationBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    console.log('Location button clicked');
                    scrollToElement(locationSection);
                    // Remove focused class from other labels
                    removeFocusedClass();
                });
            } else {
                console.log('Location elements not found:', { locationBtn: !!locationBtn, locationSection: !!locationSection });
            }
            
            // Status dropdown click handler - navigates to Status section
            const statusDropdown = document.getElementById('statusDropdown');
            if (statusDropdown && statusPrioritySection) {
                statusDropdown.addEventListener('click', function(e) {
                    e.stopPropagation(); // Prevent closing dropdown
                    scrollToElement(statusPrioritySection);
                    // Remove focused class from other labels
                    removeFocusedClass();
                });
                
                // Sync when header dropdown changes
                statusDropdown.addEventListener('change', function(e) {
                    syncStatusDropdowns(statusDropdown, statusField);
                });
            }
            
            // Sync when status section dropdown changes
            if (statusField) {
                statusField.addEventListener('change', function(e) {
                    syncStatusDropdowns(statusField, statusDropdown);
                });
            }
            
            // Function to sync dropdowns when either changes
            function syncStatusDropdowns(sourceDropdown, targetDropdown) {
                if (sourceDropdown && targetDropdown) {
                    const selectedValue = sourceDropdown.value;
                    if (targetDropdown.value !== selectedValue) {
                        targetDropdown.value = selectedValue;
                    }
                    // Update icon based on status
                    updateTaskTitleIcon(selectedValue);
                }
            }
            
            // Function to update task title icon based on status
            function updateTaskTitleIcon(status) {
                const icon = document.getElementById('taskTitleIcon');
                if (!icon) return;
                
                // Remove all status classes
                icon.className = icon.className.replace(/\bstatus-\w+/g, '');
                
                // Update icon and color based on status
                switch(status) {
                    case 'Pending':
                        icon.className = 'fa-solid fa-circle-question task-title-icon status-planned';
                        break;
                    case 'InProgress':
                        icon.className = 'fas fa-play-circle task-title-icon status-in-progress';
                        break;
                    case 'Review':
                        icon.className = 'fas fa-exclamation-circle task-title-icon status-review';
                        break;
                    case 'Completed':
                        icon.className = 'fas fa-check-circle task-title-icon status-completed';
                        break;
                    default:
                        icon.className = 'fa-solid fa-circle-question task-title-icon status-planned';
                }
            }
            
            // Header progress bar and text click handler - navigates to Subtasks section
            const headerProgressContainer = document.getElementById('headerProgressBarContainer');
            const headerProgressText = document.getElementById('headerProgressText');
            
            function scrollToSubtasks(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('Progress clicked - navigating to Subtasks');
                scrollToElement(checklistSection);
                // Remove focused class from other labels
                removeFocusedClass();
            }
            
            if (headerProgressContainer && checklistSection) {
                headerProgressContainer.addEventListener('click', scrollToSubtasks);
            }
            
            if (headerProgressText && checklistSection) {
                headerProgressText.addEventListener('click', scrollToSubtasks);
            }
            
            // Header attachment icon click handler - navigates to Attachments section
            const headerAttachmentBtn = document.getElementById('headerAttachmentBtn');
            if (headerAttachmentBtn && attachmentsSection) {
                headerAttachmentBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    console.log('Header attachment icon clicked');
                    scrollToElement(attachmentsSection);
                    // Remove focused class from other labels
                    removeFocusedClass();
                });
            }
            
            // Initialize status icon based on current selection
            const initialStatusDropdown = document.getElementById('statusDropdown');
            if (initialStatusDropdown) {
                updateTaskTitleIcon(initialStatusDropdown.value);
            }

            // Scroll event listener to revert colors when scrolling
            if (scrollableContainer) {
                let scrollTimeout;
                scrollableContainer.addEventListener('scroll', function() {
                    clearTimeout(scrollTimeout);
                    scrollTimeout = setTimeout(function() {
                        revertLabelColors();
                    }, 300);
                });
            }

            // Function to scroll to a specific element with smooth animation
            function scrollToElement(element) {
                if (!element || !scrollableContainer) return;
                
                console.log('Scrolling to element:', element.id);
                
                // Get the element's position relative to the scrollable container
                const scrollableRect = scrollableContainer.getBoundingClientRect();
                const elementRect = element.getBoundingClientRect();
                
                // Calculate how much we need to scroll
                const currentScrollTop = scrollableContainer.scrollTop;
                const elementOffsetFromContainerTop = elementRect.top - scrollableRect.top;
                const targetScrollTop = currentScrollTop + elementOffsetFromContainerTop - 10; // 10px padding
                
                console.log('Current scroll top:', currentScrollTop);
                console.log('Element position:', elementOffsetFromContainerTop);
                console.log('Target scroll top:', targetScrollTop);
                
                // Scroll smoothly to the element
                scrollableContainer.scrollTo({
                    top: targetScrollTop,
                    behavior: 'smooth'
                });
            }

            // Function to remove focused class from other labels
            function removeFocusedClass() {
                const labels = document.querySelectorAll('.status-priority-label');
                labels.forEach(label => label.classList.remove('focused'));
            }

            // Function to revert label colors by removing focused class
            function revertLabelColors() {
                const labels = document.querySelectorAll('.status-priority-label');
                labels.forEach(label => label.classList.remove('focused'));
            }
            }, 100); // End of setTimeout
        }

        // Matter Tasks Positioning and Additional Initialization
        function initializeMatterTasksPositioning() {
            
            // Initialize calendar navigation
            const prevWeekBtn = document.getElementById('prevWeekBtn');
            const nextWeekBtn = document.getElementById('nextWeekBtn');
            const todayBtn = document.getElementById('todayBtn');

            if (prevWeekBtn && !prevWeekBtn.hasAttribute('data-initialized')) {
                prevWeekBtn.setAttribute('data-initialized', 'true');
                prevWeekBtn.addEventListener('click', function() {
                    // TODO: Implement previous week navigation
                });
