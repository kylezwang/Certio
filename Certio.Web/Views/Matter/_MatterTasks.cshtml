                                    @foreach (var task in Model.CompletedTasks.OrderBy(t => t.Order))
                                    {
                                        <div class="task-card-item inbox-task-card" data-task-id="@task.Id" data-status="@task.Status" data-matter-id="@task.MatterId" data-matter-title="@task.MatterTitle" onclick="openTaskModal(@task.Id)">
