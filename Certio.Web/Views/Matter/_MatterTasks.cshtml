            if (nextWeekBtn && !nextWeekBtn.hasAttribute('data-initialized')) {
                nextWeekBtn.setAttribute('data-initialized', 'true');
                nextWeekBtn.addEventListener('click', function() {
                    // TODO: Implement next week navigation
                });
            }

            if (todayBtn && !todayBtn.hasAttribute('data-initialized')) {
                todayBtn.setAttribute('data-initialized', 'true');
                todayBtn.addEventListener('click', function() {
                    // TODO: Implement jump to today
                });
            }
            
            // Setup positioning functions
            function updateFloatingActionsPosition() {
                const floatingActions = document.querySelector('.floating-actions');
                if (!floatingActions) return;
                const tasksPage = document.querySelector('.matter-tasks-content, .tasks-content');
                if (!tasksPage) return;
                const tasksContent = document.querySelector('.matter-tasks-content, .tasks-content');
                const isMultiView = tasksContent && tasksContent.classList.contains('multi-view');
                
                if (isMultiView) {
                    const inboxView = document.getElementById('inboxView');
                    if (inboxView) {
                        const rect = inboxView.getBoundingClientRect();
                        const centerX = rect.left + (rect.width / 2);
                        floatingActions.style.left = centerX + 'px';
                        floatingActions.style.transform = 'translateX(-50%)';
                    }
                } else {
                    const rect = tasksPage.getBoundingClientRect();
                    const centerX = rect.left + (rect.width / 2);
                    floatingActions.style.left = centerX + 'px';
                    floatingActions.style.transform = 'translateX(-50%)';
                }
            }

            function updateNavbarPosition() {
                const navbar = document.querySelector('.bottom-navbar');
                if (!navbar) return;
                const tasksPage = document.querySelector('.matter-tasks-content, .tasks-content');
                if (!tasksPage) return;
                const rect = tasksPage.getBoundingClientRect();
                const centerX = rect.left + (rect.width / 2);
                navbar.style.left = centerX + 'px';
            }

            // Update positioning
            setTimeout(() => {
                updateNavbarPosition();
                updateFloatingActionsPosition();
            }, 100);
            
            // Add resize observer
            const resizeObserver = new ResizeObserver(function() {
                updateNavbarPosition();
                updateFloatingActionsPosition();
            });
            
            const tasksPage = document.querySelector('.matter-tasks-content, .tasks-content');
            if (tasksPage && !tasksPage.hasAttribute('data-resize-observed')) {
                tasksPage.setAttribute('data-resize-observed', 'true');
                resizeObserver.observe(tasksPage);
            }

            const mainContent = document.querySelector('.main-content, .content-wrapper, main');
            if (mainContent && !mainContent.hasAttribute('data-resize-observed')) {
                mainContent.setAttribute('data-resize-observed', 'true');
                resizeObserver.observe(mainContent);
            }

            // Kanban board vertical-to-horizontal scroll
            const kanbanBoardContainer = document.querySelector('.kanban-board-container');
            if (kanbanBoardContainer && !kanbanBoardContainer.hasAttribute('data-scroll-initialized')) {
                kanbanBoardContainer.setAttribute('data-scroll-initialized', 'true');
                let isScrolling = false;
                
                kanbanBoardContainer.addEventListener('wheel', function(e) {
                    if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
                        e.preventDefault();
                        const scrollAmount = e.deltaY;
                        kanbanBoardContainer.scrollLeft += scrollAmount;
                        
                        if (!isScrolling) {
                            isScrolling = true;
                            kanbanBoardContainer.style.scrollBehavior = 'smooth';
                            setTimeout(() => {
                                isScrolling = false;
                                kanbanBoardContainer.style.scrollBehavior = 'auto';
                            }, 150);
                        }
                    }
                }, { passive: false });
            }
            
            // Setup scroll-to-field functionality
            if (typeof setupScrollToField === 'function') {
                setupScrollToField();
            }
        }

        // View Resizer Functionality
        function initializeViewResizers() {
            const resizers = document.querySelectorAll('.view-resizer');
            
            resizers.forEach(resizer => {
                let isResizing = false;
                let startX = 0;
                let startLeftWidth = 0;
                let startRightWidth = 0;
                
                resizer.addEventListener('mousedown', function(e) {
                    isResizing = true;
                    startX = e.clientX;
                    
                    const leftView = document.getElementById(resizer.dataset.leftView);
                    const rightView = document.getElementById(resizer.dataset.rightView);
                    
                    if (leftView && rightView) {
                        startLeftWidth = leftView.offsetWidth;
                        startRightWidth = rightView.offsetWidth;
                        
                        // Add visual feedback
                        document.body.style.cursor = 'col-resize';
                        document.body.style.userSelect = 'none';
                        
                        // Prevent text selection during resize
                        e.preventDefault();
                    }
                });
                
                document.addEventListener('mousemove', function(e) {
                    if (!isResizing) return;
                    
                    const leftView = document.getElementById(resizer.dataset.leftView);
                    const rightView = document.getElementById(resizer.dataset.rightView);
                    
                    if (leftView && rightView) {
                        const deltaX = e.clientX - startX;
                        const containerWidth = resizer.parentElement.offsetWidth;
                        const resizerWidth = resizer.offsetWidth;
                        const availableWidth = containerWidth - resizerWidth;
                        
                        // Calculate new widths
                        let newLeftWidth = startLeftWidth + deltaX;
                        let newRightWidth = startRightWidth - deltaX;
                        
                        // Set minimum widths (20% of container)
                        const minWidth = availableWidth * 0.2;
                        
                        if (newLeftWidth < minWidth) {
                            newLeftWidth = minWidth;
                            newRightWidth = availableWidth - minWidth;
                        } else if (newRightWidth < minWidth) {
                            newRightWidth = minWidth;
                            newLeftWidth = availableWidth - minWidth;
                        }
                        
                        // Apply new widths
                        leftView.style.width = `${(newLeftWidth / availableWidth) * 100}%`;
                        rightView.style.width = `${(newRightWidth / availableWidth) * 100}%`;
                        
                        // Update title column widths dynamically
                        updateInboxTitleWidths();
                    }
                });
                
                document.addEventListener('mouseup', function() {
                    if (isResizing) {
                        isResizing = false;
                        document.body.style.cursor = '';
                        document.body.style.userSelect = '';
                        
                        // Final update after resizing is done
                        updateInboxTitleWidths();
                    }
                });
            });
        }
        
        // Function to dynamically adjust inbox task card title widths based on view width
        function updateInboxTitleWidths() {
            const inboxView = document.getElementById('inboxView');
            const tasksContent = document.querySelector('.tasks-content');
            
            if (!inboxView || !tasksContent) return;
            
            // Get the actual width of the inbox view
            const inboxWidth = inboxView.offsetWidth;
            
            // Check if we're in multi-view mode
            const isMultiView = tasksContent.classList.contains('multi-view');
            const isAllViews = tasksContent.classList.contains('all-views');
            
            if (!isMultiView) {
                // In single view mode (most space available), allow largest badge width
                const inboxTaskCards = inboxView.querySelectorAll('.inbox-task-card');
                inboxTaskCards.forEach(card => {
                    const titleColumn = card.querySelector('.task-title-column');
                    if (titleColumn) {
                        titleColumn.style.maxWidth = '';
                        const badgeSpan = card.querySelector('.task-matter-badge span');
                        if (badgeSpan) {
                            const width = titleColumn.offsetWidth;
                            if (width && width > 0) {
                                badgeSpan.style.maxWidth = `${Math.floor(width * 0.95)}px`;
                            }
                        }
                    }
                });
                return;
            }
            
            // Get all inbox task cards
            const inboxTaskCards = inboxView.querySelectorAll('.inbox-task-card');
            
            if (isAllViews) {
                // In 3-view mode (least space available): use smallest badge width
                inboxTaskCards.forEach(card => {
                    const titleColumn = card.querySelector('.task-title-column');
                    if (titleColumn) {
                        titleColumn.style.maxWidth = '';
                    }
                    // Badge width is smallest at 50% of the title column width
                    const badgeSpan = card.querySelector('.task-matter-badge span');
                    if (badgeSpan && titleColumn) {
                        const width = titleColumn.offsetWidth;
                        if (width && width > 0) {
                            badgeSpan.style.maxWidth = `${Math.floor(width * 0.5)}px`;
                        }
                    }
                });
            } else {
                // In 2-view mode (medium space available): use medium badge width
                inboxTaskCards.forEach(card => {
                    const titleColumn = card.querySelector('.task-title-column');
                    if (titleColumn) {
                        // Account for: checkbox (16px) + due date (100px) + assignees (60px) + gaps (24px) + padding (32px) + buffer (16px)
                        const fixedElementsWidth = 248;
                        const availableWidth = inboxWidth - fixedElementsWidth;
                        
                        // Ensure minimum width
                        const minWidth = 120;
                        const calculatedWidth = Math.max(minWidth, availableWidth);
                        
                        titleColumn.style.maxWidth = `${calculatedWidth}px`;
                        // Badge should be 70% of title width (medium)
                        const badgeSpan = card.querySelector('.task-matter-badge span');
                        if (badgeSpan) {
                            badgeSpan.style.maxWidth = `${Math.floor(calculatedWidth * 0.7)}px`;
                        }
                    }
                });
            }
        }
        
        // ==========================================
        // Status View Toggle Functionality
        // ==========================================
        
        // Load saved view preference
        function loadStatusViewPreference() {
            const inboxContainer = document.querySelector('.inbox-container');
            const isLegacyView = localStorage.getItem('certio_status_view_legacy') === 'true';
            
            if (inboxContainer) {
                if (isLegacyView) {
                    inboxContainer.classList.add('legacy-status-view');
                } else {
                    inboxContainer.classList.remove('legacy-status-view');
                }
            }
        }
        
        // Toggle status view
        function toggleStatusView() {
            const inboxContainer = document.querySelector('.inbox-container');
            
            if (inboxContainer) {
                const isLegacyView = inboxContainer.classList.toggle('legacy-status-view');
                
                // Save preference
                localStorage.setItem('certio_status_view_legacy', isLegacyView);
                
                // Update title widths after toggle
                setTimeout(() => {
                    updateInboxTitleWidths();
                }, 100);
            }
        }
        
        // Initialize status view toggle
        setTimeout(() => {
            // Load saved preference
            loadStatusViewPreference();
            
            // Add click handler to status column toggle button
            const statusToggleBtn = document.getElementById('statusColumnToggleMatter');
            if (statusToggleBtn) {
                statusToggleBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    toggleStatusView();
                });
            }
        }, 200);
        
})(); // End of IIFE
