                                                                 style="width: @task.ProgressPercentage" 
                                                                 aria-valuenow="@task.CompletedSubTasks" 
                                                                 aria-valuemin="0" 
                                                                 aria-valuemax="@task.TotalSubTasks"></div>
                                                        </div>
                                                        @if (task.UrgentSubTasksCount > 0)
                                                        {
                                                            <div class="urgent-subtasks-badge" title="@task.UrgentSubTasksCount subtask(s) due today or tomorrow">
                                                                @task.UrgentSubTasksCount
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            
