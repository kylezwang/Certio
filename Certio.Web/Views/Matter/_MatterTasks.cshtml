                                                    </button>
                                                </div>
                                            </div>
                                            
                                            <!-- Assignees Column -->
                                            <div class="task-assignees-column">
                                                @if (task.Assignments.Any())
                                                {
                                                    <div class="task-assignees-inline">
                                                        @foreach (var assignment in task.Assignments.Take(2))
                                                        {
                                                            <div class="task-assignee-avatar-inline" title="@assignment.UserName">
