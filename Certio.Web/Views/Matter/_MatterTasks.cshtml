<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
@if (ViewBag.GoogleMapsEnabled == true && !string.IsNullOrEmpty(ViewBag.GoogleMapsApiKey))
{
    <script>
        // Only load Google Maps if not already loaded/loading (avoid duplicate loads)
        (function() {
            // Check if already loaded
            if (window.google && window.google.maps && window.google.maps.places) {
                window.googleMapsReady = true;
                if (typeof initializeLocationSearch === 'function') {
                    setTimeout(initializeLocationSearch, 100);
                }
                return;
            }
            
            // Check if already loading (prevent duplicate script injections)
            if (window.__googleMapsLoading) {
                // Already loading, just wait for it
                const checkInterval = setInterval(function() {
                    if (window.googleMapsReady && typeof initializeLocationSearch === 'function') {
                        clearInterval(checkInterval);
                        initializeLocationSearch();
                    }
                }, 100);
                return;
            }
            
            // Mark as loading to prevent other instances from loading
            window.__googleMapsLoading = true;
            
            // Define callback for when Google Maps finishes loading
            window.initGoogleMaps = function() {
                try {
                    window.googleMapsReady = true;
                    window.__googleMapsLoading = false;
                    setTimeout(function() {
                        if (typeof initializeLocationSearch === 'function') {
                            initializeLocationSearch();
                        }
                    }, 100);
                } catch (err) {
                    console.error('Error in initGoogleMaps:', err);
                    window.__googleMapsLoading = false;
                }
            };
            
            // Dynamically inject script tag
            const script = document.createElement('script');
            script.src = 'https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey&libraries=places&callback=initGoogleMaps';
            script.async = true;
            script.defer = true;
            script.onerror = function() {
                console.error('Failed to load Google Maps API');
                window.__googleMapsLoading = false;
            };
            document.head.appendChild(script);
        })();
    </script>
}
