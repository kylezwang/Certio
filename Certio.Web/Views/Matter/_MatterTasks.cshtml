        document.addEventListener('DOMContentLoaded', function() {
            // Note: Checkbox event listeners are now attached when subtasks are loaded
            // in loadTaskData() for existing subtasks and addSubtaskToList() for new subtasks
            
            // Handle task title editing
            const taskTitle = document.querySelector('.task-title');
            if (taskTitle) {
                taskTitle.addEventListener('blur', function() {
                    // Save title changes here
                    console.log('Task title updated:', this.textContent);
                });
            }
            
            // Comments: load, post, react
            const commentsList = document.getElementById('commentsList');
            const commentInput = document.getElementById('commentInput');
            const postCommentBtn = document.getElementById('postCommentBtn');

            // Expose comment loader globally so other handlers (like openTaskModal)
            // can trigger initial load before this closure's scope is referenced
            window.loadComments = async function(taskId) {
                if (!commentsList || !taskId) return;
                commentsList.innerHTML = '<div class="text-muted">Loading comments...</div>';
                const res = await fetch(`/Tasks/GetComments?taskId=${taskId}`);
                const data = await res.json();
                if (!data.success) { commentsList.innerHTML = '<div class="task-due overdue">Failed to load comments</div>'; return; }
                renderComments(data.comments || []);
            }

            function renderComments(comments) {
                if (!commentsList) return;
                if (!comments || comments.length === 0) { commentsList.innerHTML = '<div class="text-muted">No comments yet.</div>'; return; }
                commentsList.innerHTML = comments.map(c => commentHtml(c)).join('');
                // Bind reaction buttons
                commentsList.querySelectorAll('[data-react]')?.forEach(btn => {
                    btn.addEventListener('click', async function() {
                        const commentId = parseInt(this.closest('[data-comment-id]')?.dataset?.commentId);
                        const reaction = this.dataset.react;
                        await reactToComment(commentId, reaction);
                        // reload minimal by updating counts
                        const taskId = document.querySelector('.task-title')?.dataset?.taskId;
                        if (taskId) window.loadComments(parseInt(taskId));
                    });
                });
            }

            function commentHtml(c) {
                const initials = c.userName?.split(' ').map(n=>n[0]).join('').substring(0,2).toUpperCase();
                const reactions = c.reactions || {};
                const like = reactions['like']||0;
                let rendered = escapeHtml(c.content || '');
                if (Array.isArray(c.mentions) && c.mentions.length > 0) {
                    for (const m of c.mentions) {
                        const name = (m.name || '').trim();
                        if (!name) continue;
                        const at = String.fromCharCode(64);
                        const escaped = name.replace(/[-\/^$*+?.()|[\]{}]/g, r => "\\" + r);
                        const pattern = new RegExp(at + escaped, 'i');
                        rendered = rendered.replace(pattern, `<span class="text-primary">&#64;${escapeHtml(name)}</span>`);
                    }
                }
                return `
                <div class="activity-item" data-comment-id="${c.id}">
                    <div class="activity-avatar">${initials||'U'}</div>
                    <div class="activity-content position-relative">
                        <div class="comment-header">
                            <strong>${c.userName}</strong>
                            <span class="comment-time">${c.timeAgo}</span>
                            <div class="comment-actions">
                                <button class="icon-btn" title="Like" data-react="like">👍 <span class="count">${like}</span></button>
                                <button class="icon-btn" title="Forward" data-action="forward"><i class="fas fa-share"></i></button>
                                <button class="icon-btn" title="Edit" data-action="edit"><i class="fas fa-pen"></i></button>
                                <button class="icon-btn" title="More" data-action="more"><i class="fas fa-ellipsis-h"></i></button>
                            </div>
                        </div>
                        <div class="activity-text">${rendered}</div>
                    </div>
                </div>`;
            }

            function escapeHtml(str){return (str||'').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;','\'':'&#39;'}[m]));}

            async function postComment(taskId, content, mentionUserIds){
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const res = await fetch('/Tasks/AddComment', {
                    method: 'POST', headers: {'Content-Type':'application/json','RequestVerificationToken': token},
                    body: JSON.stringify({ taskItemId: taskId, content, mentionUserIds: mentionUserIds||[] })
                });
                return await res.json();
            }

            async function reactToComment(commentId, reactionType){
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const res = await fetch('/Tasks/ReactToComment', {
                    method: 'POST', headers: {'Content-Type':'application/json','RequestVerificationToken': token},
                    body: JSON.stringify({ commentId, reactionType })
                });
                return await res.json();
            }

            // Minimal mentions: parse at-sign Name to ids via users list
            function extractMentionUserIds(text){
                const users = window.tasksData?.users||[];
                // Build regex via string to avoid Razor parsing at-sign
                const at = String.fromCharCode(64);
                const names = (text.match(new RegExp(at + "[^\\s" + at + "]+", "g"))||[]).map(x=>x.substring(1).toLowerCase());
                const mapped = [];
                for (const n of names){
                    const u = users.find(u=>u.name.toLowerCase().startsWith(n));
                    if (u) mapped.push(u.id);
                }
                return Array.from(new Set(mapped));
            }

            if (commentInput){
                commentInput.addEventListener('keydown', async function(e){
                    if (e.ctrlKey && e.key === 'Enter'){
                        const text = this.value.trim(); if (!text) return;
                        const taskId = document.querySelector('.task-title')?.dataset?.taskId;
                        if (!taskId) return;
                        await postComment(parseInt(taskId), text, extractMentionUserIds(text));
                        this.value='';
                        window.loadComments(parseInt(taskId));
                    }
                });
            }
            if (postCommentBtn){
                postCommentBtn.addEventListener('click', async function(){
                    const text = commentInput?.value.trim(); if (!text) return;
                    const taskId = document.querySelector('.task-title')?.dataset?.taskId;
                    if (!taskId) return;
                    await postComment(parseInt(taskId), text, extractMentionUserIds(text));
                    commentInput.value='';
                    window.loadComments(parseInt(taskId));
                });
            }
        });

        // Bottom navbar multi-view toggle functionality
