            // Function to update resizer visibility based on active views
            function updateResizerVisibility(activeViews) {
                const resizers = document.querySelectorAll('.view-resizer');
                
                // Hide all resizers first
                resizers.forEach(resizer => {
                    resizer.style.display = 'none';
                });
                
                // Show resizers based on active views
                if (activeViews.size === 2) {
                    const viewsArray = Array.from(activeViews);
                    
                    if (viewsArray.includes('inbox') && viewsArray.includes('planner')) {
                        // Show resizer between inbox and planner
                        const inboxPlannerResizer = document.getElementById('inboxPlannerResizer');
                        if (inboxPlannerResizer) {
                            inboxPlannerResizer.style.display = 'flex';
                        }
                    } else if (viewsArray.includes('inbox') && viewsArray.includes('board')) {
                        // Show resizer between inbox and board (skip planner)
                        const inboxPlannerResizer = document.getElementById('inboxPlannerResizer');
                        const plannerBoardResizer = document.getElementById('plannerBoardResizer');
                        if (inboxPlannerResizer) {
                            inboxPlannerResizer.style.display = 'flex';
                            // Update data attributes to reflect actual views
                            inboxPlannerResizer.dataset.leftView = 'inboxView';
                            inboxPlannerResizer.dataset.rightView = 'boardView';
                        }
                    } else if (viewsArray.includes('planner') && viewsArray.includes('board')) {
                        // Show resizer between planner and board
                        const plannerBoardResizer = document.getElementById('plannerBoardResizer');
                        if (plannerBoardResizer) {
                            plannerBoardResizer.style.display = 'flex';
                        }
                    }
                } else if (activeViews.size === 3) {
                    // Show both resizers for all three views
                    const inboxPlannerResizer = document.getElementById('inboxPlannerResizer');
                    const plannerBoardResizer = document.getElementById('plannerBoardResizer');
                    
                    if (inboxPlannerResizer) {
                        inboxPlannerResizer.style.display = 'flex';
                        // Reset data attributes to original
                        inboxPlannerResizer.dataset.leftView = 'inboxView';
                        inboxPlannerResizer.dataset.rightView = 'plannerView';
                    }
                    if (plannerBoardResizer) {
                        plannerBoardResizer.style.display = 'flex';
                    }
                }
            }
            
            function handleAddButtonPosition() {
                const addCardContainer = document.querySelector('.add-card-container');
                const addCardOuterContainer = document.querySelector('.add-card-outer-container');
                const inboxContainer = document.querySelector('.inbox-container');
                
                if (!addCardContainer || !addCardOuterContainer || !inboxContainer) return;
                
                // Check if we're in all-views mode
                const isAllViews = tasksContent.classList.contains('all-views');
                
                if (isAllViews) {
                    // Move add button outside the outer container if not already moved
                    if (addCardContainer.parentElement === addCardOuterContainer) {
                        // Store the original parent for later restoration
                        addCardContainer.dataset.originalParent = 'add-card-outer-container';
                        
                        // Insert the add button container before the outer container
                        addCardOuterContainer.parentElement.insertBefore(addCardContainer, addCardOuterContainer);
                        
                        // Add some margin to the moved button
                        addCardContainer.style.marginBottom = '0.5rem';
                    }
                } else {
                    // Move button back to original position if it was moved
                    if (addCardContainer.dataset.originalParent === 'add-card-outer-container' && 
                        addCardContainer.parentElement !== addCardOuterContainer) {
                        
                        // Move it back as the first child of the outer container
                        addCardOuterContainer.insertBefore(addCardContainer, addCardOuterContainer.firstChild);
                        
                        // Remove the temporary margin
                        addCardContainer.style.marginBottom = '';
                        
                        // Clean up the data attribute
                        delete addCardContainer.dataset.originalParent;
                    }
                }
            }
            
            function updateViewLayout() {
                // Update navbar visual state
                navItems.forEach(nav => {
                    const view = nav.getAttribute('data-view');
                    nav.classList.remove('active', 'multi-active');
                    
                    if (activeViews.has(view)) {
                        if (activeViews.size === 1) {
                            nav.classList.add('active');
                        } else {
                            nav.classList.add('multi-active');
                        }
                    }
                });
                
                // Update view containers visibility
                viewContainers.forEach(container => {
                    container.classList.add('d-none');
                });
                
                // Show active views
                activeViews.forEach(view => {
                    const targetView = document.getElementById(view + 'View');
                    if (targetView) {
                        targetView.classList.remove('d-none');
                        
                        // Reinitialize drag and drop if board view becomes visible
                        if (view === 'board' && window.reinitializeDragAndDropIfNeeded) {
                            window.reinitializeDragAndDropIfNeeded();
                        }
                    }
                });
                
                // Update layout classes
                tasksContent.classList.remove('multi-view', 'inbox-planner', 'inbox-board', 'planner-board', 'all-views');
                
                // Reset inline width styles when changing layouts
                viewContainers.forEach(container => {
                    container.style.width = '';
                });
                
                if (activeViews.size > 1) {
                    tasksContent.classList.add('multi-view');
                    
                    // Apply specific layout classes based on active views
                    const viewsArray = Array.from(activeViews);
                    
                    if (viewsArray.length === 2) {
                        if (viewsArray.includes('inbox') && viewsArray.includes('planner')) {
                            tasksContent.classList.add('inbox-planner');
                        } else if (viewsArray.includes('inbox') && viewsArray.includes('board')) {
                            tasksContent.classList.add('inbox-board');
                        } else if (viewsArray.includes('planner') && viewsArray.includes('board')) {
                            tasksContent.classList.add('planner-board');
                        }
                    } else if (viewsArray.length === 3) {
                        tasksContent.classList.add('all-views');
                        // Hide client navbar when all 3 views are selected
                        document.body.classList.add('sidebar-hidden');
                    }
                } else {
                    // Show client navbar when not in all-views mode
                    document.body.classList.remove('sidebar-hidden');
                }
                
                // Handle Add button positioning for all-views mode
                handleAddButtonPosition();
                
                // Update resizer visibility based on active views
                updateResizerVisibility(activeViews);
                
                // Reinitialize resizer functionality for newly visible resizers
                if (activeViews.size > 1) {
                    initializeViewResizers();
                }
                
                // Update floating actions positioning
