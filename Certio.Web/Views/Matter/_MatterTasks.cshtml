        // Load embedded map from stored location data
        function loadEmbeddedMapFromData(location, name, address) {
            const mapContainer = document.getElementById('mapContainer');
            
            if (!mapContainer) return;
            
            // Create map URL for embedded display
            const locationStr = location.lat + ',' + location.lng;
            const encodedName = encodeURIComponent(name);
            const encodedAddress = encodeURIComponent(address);
            
            const mapUrl = `https://maps.google.com/maps?q=${encodedName}|${encodedAddress}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
            
            // Create iframe for embedded map
            mapContainer.innerHTML = `
                <iframe 
                    class="embedded-map loaded"
                    src="${mapUrl}"
                    frameborder="0"
                    allowfullscreen>
                </iframe>
            `;
        }
        
        // Load task data for editing
        function loadTaskData(taskId) {
            // Prefer hydrated data passed to the page
            const allTasks = (window.tasksData && Array.isArray(window.tasksData.allTasks)) ? window.tasksData.allTasks : [];
            // Be resilient to different casings/keys from server
            const getId = t => (t?.id ?? t?.Id ?? t?.taskId ?? t?.TaskId);
            const task = allTasks.find(t => Number(getId(t)) === Number(taskId));
            
            if (!task) {
                console.error('Task not found:', taskId);
                return;
            }
            
            // Helpers for property resolution
            const getProp = (t, keys, fallback = '') => {
                for (const k of keys) { if (t && t[k] !== undefined && t[k] !== null) return t[k]; }
                return fallback;
            };
            
            // Set task ID and matter ID
            const taskTitle = document.querySelector('.task-title');
            if (taskTitle) {
                const titleVal = getProp(task, ['title','Title'], '');
                taskTitle.textContent = titleVal;
                taskTitle.dataset.taskId = String(getId(task) ?? taskId);
            }
            
            // Store task's matter ID for assignment filtering
            currentTaskMatterId = getProp(task, ['matterId','MatterId'], null);
            
            // Set description
            const descriptionField = document.querySelector('.task-description-textarea');
            if (descriptionField) {
                descriptionField.value = getProp(task, ['description','Description'], '');
            }
            
            // Set status and priority
            const statusDropdown = document.getElementById('statusDropdown');
            const statusField = document.getElementById('status-field');
            const priorityField = document.getElementById('priority-field');
            
            const statusVal = getProp(task, ['status','Status'], 'Pending');
            const priorityVal = getProp(task, ['priority','Priority'], 'Medium');
            
            if (statusDropdown) statusDropdown.value = statusVal;
            if (statusField) statusField.value = statusVal;
            if (priorityField) priorityField.value = priorityVal;
            
            // Update icon based on status
            updateTaskTitleIconFromModal(statusVal);
            
            // Set dates
            const startDateField = document.getElementById('start-date-field');
            const dueDateField = document.getElementById('due-date-field');
            
            const startedAt = getProp(task, ['startedAt','StartedAt'], null);
            const dueDate = getProp(task, ['dueDate','DueDate'], null);
            
            if (startDateField && startedAt) {
                const d = new Date(startedAt);
                if (!isNaN(d)) startDateField.value = d.toISOString().split('T')[0];
            }
            
            if (dueDateField && dueDate) {
                const d = new Date(dueDate);
                if (!isNaN(d)) dueDateField.value = d.toISOString().split('T')[0];
            }
            
            // Set location (if available)
            if (task.location) {
                // Try to parse location data if it's JSON, otherwise treat as text
                try {
                    const locationData = JSON.parse(task.location);
                    setLocationData(locationData);
                } catch (e) {
                    // If not JSON, treat as plain text and set in input
                    const locationInput = document.getElementById('locationSearchInput');
                    if (locationInput) {
                        locationInput.value = task.location;
                    }
                    
                    // Try to display the location even if it's just text
                    // Split the location string to extract name and address
                    const locationParts = task.location.split(', ');
                    if (locationParts.length >= 2) {
                        const locationName = locationParts[0];
                        const locationAddress = locationParts.slice(1).join(', ');
                        
                        const locationDisplay = document.getElementById('locationDisplay');
                        const locationNameEl = document.getElementById('locationName');
                        const locationAddressEl = document.getElementById('locationAddress');
                        
                        if (locationDisplay && locationNameEl && locationAddressEl) {
                            locationNameEl.textContent = locationName;
                            locationAddressEl.textContent = locationAddress;
                            locationDisplay.style.display = 'flex';
                            
                            // Load the map for plain text locations too
                            // Create a map URL using the location text
                            const encodedLocation = encodeURIComponent(task.location);
                            const mapUrl = `https://maps.google.com/maps?q=${encodedLocation}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
                            
                            const mapContainer = document.getElementById('mapContainer');
                            if (mapContainer) {
                                mapContainer.innerHTML = `
                                    <iframe 
                                        class="embedded-map loaded"
                                        src="${mapUrl}"
                                        frameborder="0"
                                        allowfullscreen>
                                    </iframe>
                                `;
                            }
                        }
                    }
                }
            }
            
            // Load subtasks (if available)
            if (task.subTasks && task.subTasks.length > 0) {
                const checklistItems = document.querySelector('.checklist-items');
                if (checklistItems) {
                    checklistItems.innerHTML = '';
                    
                    // Clear tracking maps when loading new task
                    originalSubtaskStates.clear();
                    modifiedExistingSubtasks.clear();
                    
                    task.subTasks.forEach(subtask => {
                        const isCompleted = subtask.status === 'Completed';
                        
                        // Store original state for change detection
                        originalSubtaskStates.set(subtask.id, {
                            isCompleted: isCompleted
                        });
                        
                        // Build assignment badges HTML
                        let assignmentHtml = '';
                        if (subtask.assignments && subtask.assignments.length > 0) {
                            assignmentHtml += '<div class="task-assignees-inline">';
                            subtask.assignments.forEach(assignment => {
                                assignmentHtml += `
                                    <div class="task-assignee-avatar-inline" title="${assignment.userName} (${assignment.assignmentType})">
                                        ${assignment.userInitials}
                                    </div>
                                `;
                            });
                            assignmentHtml += '</div>';
                        }
                        
                        // Build due date HTML
                        let dueDateHtml = '';
                        if (subtask.dueDate) {
                            // Parse date string directly to avoid timezone issues
                            const dateStr = subtask.dueDate.split('T')[0]; // Remove time part if present
                            const dateParts = dateStr.split('-');
                            const year = dateParts[0];
                            const month = dateParts[1];
                            const day = dateParts[2];
                            
                            // Create date for comparison (local timezone)
                            const dueDate = new Date(parseInt(year), parseInt(month) - 1, parseInt(day));
                            const today = new Date();
                            today.setHours(0, 0, 0, 0); // Reset time to start of day
                            
                            // Format as "Oct 15" style
                            const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                            const formattedDate = `${monthNames[parseInt(month) - 1]} ${parseInt(day)}`;
                            
                            const isOverdue = dueDate < today && subtask.status !== 'Completed';
                            const tomorrow = new Date(today);
                            tomorrow.setDate(today.getDate() + 1);
                            const isToday = dueDate.getTime() === today.getTime();
                            const isTomorrow = dueDate.getTime() === tomorrow.getTime();
                            const textColor = isOverdue ? '#c62828' : (isToday || isTomorrow ? '#1e1e1e' : '#6b7280');
                            dueDateHtml = `
                                <span class="badge badge-sm" style="background-color: ${isOverdue ? '#ffebee' : '#f5f5f5'}; color: ${textColor}; font-size: 0.7rem; padding: 0.25rem 0.5rem; border-radius: 0.25rem;">
                                    <i class="fa-solid fa-calendar-day" style="font-size: 0.65rem;"></i> ${formattedDate}
                                </span>
                            `;
                        }
                        
                        const item = document.createElement('div');
                        item.className = 'checklist-item' + (isCompleted ? ' completed' : '');
                        item.dataset.subtaskId = subtask.id;
                        item.dataset.isExisting = 'true'; // Mark as existing subtask
                        item.innerHTML = `
                            <div style="display: flex; align-items: center; width: 100%; padding: 0.5rem 0;">
                                <div style="display: flex; align-items: center; flex: 1; min-width: 0;">
                                    <input type="checkbox" class="form-check-input subtask-checkbox" ${isCompleted ? 'checked' : ''} style="margin-right: 0.5rem;">
                                    <label class="form-check-label" style="font-size: 0.875rem; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${subtask.title}</label>
                                </div>
                                <div style="display: flex; align-items: center; min-width: 80px; justify-content: right;">
                                    ${dueDateHtml}
                                </div>
                                <div style="display: flex; align-items: center; min-width: 120px; justify-content: flex-end; gap: 0.25rem;">
                                    ${assignmentHtml}
                                </div>
                            </div>
                        `;
                        checklistItems.appendChild(item);
                        
                        // Attach event listener for checkbox changes on existing subtasks
                        const checkbox = item.querySelector('.subtask-checkbox');
                        checkbox.addEventListener('change', function() {
                            const subtaskId = parseInt(item.dataset.subtaskId);
                            const newIsCompleted = this.checked;
                            
                            // Update visual state
                            if (newIsCompleted) {
                                item.classList.add('completed');
                            } else {
                                item.classList.remove('completed');
                            }
                            
                            // Track the change
                            const originalState = originalSubtaskStates.get(subtaskId);
                            if (originalState && originalState.isCompleted !== newIsCompleted) {
                                // Modified from original
                                modifiedExistingSubtasks.set(subtaskId, {
                                    isCompleted: newIsCompleted
                                });
                                hasUnsavedChanges = true;
                            } else {
                                // Reverted to original state
                                modifiedExistingSubtasks.delete(subtaskId);
                            }
                            
                            // Update progress bar
                            updateSubtaskProgressInModal();
                        });
                    });
                }
                
                // Update progress
                const completedCount = task.subTasks.filter(st => st.status === 'Completed').length;
                const totalCount = task.subTasks.length;
                const percentage = totalCount > 0 ? Math.round((completedCount / totalCount) * 100) : 0;
                updateChecklistProgressManual(percentage);
            } else {
                updateChecklistProgressManual(0);
            }
            
            // Load comments (if available)
            if (task.Comments && task.Comments.length > 0) {
                // TODO: Render comments in activity log
            }
            
            // Load assignees (if available)
            if (task.assignments && task.assignments.length > 0) {
                currentTaskAssignments = task.assignments.map(a => ({
                    userId: a.userId,
                    userName: a.userName,
                    userInitials: a.userInitials,
                    userEmail: a.userEmail || '',
                    assignmentType: a.assignmentType || 'Assignee',
                    role: a.role || ''
                }));
                // Keep a copy of original assignments to detect new ones later
                originalTaskAssignments = JSON.parse(JSON.stringify(currentTaskAssignments));
                renderTaskAssignees(currentTaskAssignments);
            } else {
                currentTaskAssignments = [];
                originalTaskAssignments = [];
                renderTaskAssignees([]);
            }
        }
        
        // Initialize save task functionality
        function initializeSaveTask() {
            // Add save button to modal header
            const headerRight = document.querySelector('.task-details-header-right');
            if (headerRight && !document.getElementById('saveTaskBtn')) {
                const saveBtn = document.createElement('button');
                saveBtn.id = 'saveTaskBtn';
                saveBtn.className = 'btn btn-sm btn-primary me-2';
                saveBtn.innerHTML = '<i class="fas fa-save me-1"></i> Save';
                saveBtn.style.marginRight = '0.5rem';
                
                // Insert before the close button
                const closeBtn = document.getElementById('closeTaskModal');
                headerRight.insertBefore(saveBtn, closeBtn);
                
                // Add click handler
                saveBtn.addEventListener('click', saveTask);
            }
        }
        
        // Save task (create or update)
        function saveTask() {
            const taskTitle = document.querySelector('.task-title');
            const taskId = taskTitle?.dataset?.taskId;
            
            // Validate required fields
            const title = taskTitle?.textContent.trim();
            if (!title) {
                alert('Please enter a task title');
                taskTitle.focus();
                return;
            }
            
            // Note: Assignee validation removed - creator is auto-assigned on the server
            
            // Get all field values
            const description = document.querySelector('.task-description-textarea')?.value || '';
            let status = document.getElementById('status-field')?.value || 'Pending';
            const priority = document.getElementById('priority-field')?.value || 'Medium';
            const startDate = document.getElementById('start-date-field')?.value || null;
            const dueDate = document.getElementById('due-date-field')?.value || null;
            
            // Auto-complete task if all subtasks are completed
            const existingSubtasks = document.querySelectorAll('.checklist-item:not(.new-subtask-card)');
            const totalSubtasks = existingSubtasks.length + pendingSubtasks.length;
            
            if (totalSubtasks > 0) {
                let completedCount = 0;
                
                // Count completed existing subtasks (check both UI state and modified tracking)
                existingSubtasks.forEach(item => {
                    const subtaskId = item.dataset.subtaskId;
                    
                    // Check if it's in the modified map first
                    if (subtaskId && modifiedExistingSubtasks.has(subtaskId)) {
                        if (modifiedExistingSubtasks.get(subtaskId).isCompleted) {
                            completedCount++;
                        }
                    } else {
                        // Otherwise check the UI state
                        if (item.classList.contains('completed')) {
                            completedCount++;
                        }
                    }
                });
                
                // Count completed pending subtasks
                pendingSubtasks.forEach(subtask => {
                    if (subtask.status === 'Completed') {
                        completedCount++;
                    }
                });
                
                // If all subtasks are completed, auto-set status to Completed
                if (completedCount === totalSubtasks) {
                    status = 'Completed';
                    console.log(`All ${totalSubtasks} subtasks completed - auto-setting task status to Completed`);
                }
            }
            // Get full location data including coordinates and place ID
            const locationData = getLocationData();
            // Send simple string for backend compatibility, but store full data in a hidden field
            const locationString = locationData ? `${locationData.name}, ${locationData.address}` : null;
            
            // Get matter ID (for now, use first matter from the list or require selection)
            // Use selected matter if available (but not 'all')
            const matterId = (currentMatterId && currentMatterId !== 'all') 
                ? currentMatterId 
                : (window.tasksData?.matters?.[0]?.Id || window.tasksData?.matters?.[0]?.id || null);
            
            if (!matterId) {
                alert('No matter found. Please ensure you have at least one matter.');
                return;
            }
            
            // Prepare request data
            const requestData = {
                title: title,
                description: description,
                status: status,
                priority: priority,
                startedAt: startDate,
                dueDate: dueDate,
                location: locationString,
                matterId: matterId,
                order: 0
            };
            
            console.log('Sending request data:', requestData);
            
            // Determine endpoint
            const url = taskId ? '/Tasks/Update' : '/Tasks/Create';
            if (taskId) {
                requestData.id = parseInt(taskId);
            }
            
            // Show loading state
            const saveBtn = document.getElementById('saveTaskBtn');
            const originalText = saveBtn.innerHTML;
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Saving...';
            
            // Get anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            
            // Send request
            fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(requestData)
            })
            .then(response => {
                console.log('Response status:', response.status);
                return response.json();
            })
            .then(async (data) => {
                console.log('Response data:', data);
                if (data.success) {
                    const savedTaskId = data.taskId || parseInt(taskId);
                    
                    // Save task assignments
                    if (currentTaskAssignments && currentTaskAssignments.length > 0) {
                        if (!taskId) {
                            // NEW task: Only save non-creator assignments (server already auto-assigned creator)
                            const nonCreatorAssignments = currentTaskAssignments.filter(a => a.role !== 'Task Creator');
                            if (nonCreatorAssignments.length > 0) {
                                await saveTaskAssignments(savedTaskId, nonCreatorAssignments);
                            }
                        } else {
                            // EXISTING task: only save NEW assignments (not already in database)
                            const newAssignments = currentTaskAssignments.filter(current => 
                                !originalTaskAssignments.some(original => original.userId === current.userId)
                            );
                            if (newAssignments.length > 0) {
                                await saveTaskAssignments(savedTaskId, newAssignments);
                            }
                        }
                    }
                    
                    // If there are modified existing subtasks, save them first
                    if (modifiedExistingSubtasks.size > 0) {
                        await saveModifiedExistingSubtasks();
                    }
                    
                    // If there are pending subtasks, save them now
                    if (pendingSubtasks.length > 0) {
                        await savePendingSubtasks(savedTaskId);
                    }
                    
                    // Success - reload page to show updated task
                    window.location.reload();
                } else {
                    // Error
                    console.error('Save error:', data);
                    alert('Error: ' + (data.message || 'Failed to save task'));
                    saveBtn.disabled = false;
                    saveBtn.innerHTML = originalText;
                }
            })
            .catch(error => {
                console.error('Error saving task:', error);
                alert('An error occurred while saving the task');
                saveBtn.disabled = false;
                saveBtn.innerHTML = originalText;
            });
        }
        
        // Function to save modified existing subtasks to database
        async function saveModifiedExistingSubtasks() {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            
            // Save each modified subtask sequentially
            for (const [subtaskId, changes] of modifiedExistingSubtasks.entries()) {
                try {
                    const response = await fetch('/Tasks/UpdateSubTaskStatus', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({
                            subTaskId: parseInt(subtaskId),
                            isCompleted: changes.isCompleted
                        })
                    });
                    
                    const data = await response.json();
                    if (!data.success) {
                        console.error('Failed to update subtask:', subtaskId, data.message);
                    }
                } catch (error) {
                    console.error('Error updating subtask:', subtaskId, error);
                }
            }
            
            // Clear modified subtasks after saving
            modifiedExistingSubtasks.clear();
        }
        
        // Function to save pending subtasks to database
        async function savePendingSubtasks(taskId) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            
            // Save each subtask sequentially
            for (const subtask of pendingSubtasks) {
                // Prepare assignments data
                const assignmentsData = subtask.assignments?.map(a => ({
                    userId: a.userId,
                    assignmentType: a.assignmentType || 'Assignee',
                    role: a.role || ''
                })) || [];
                
                try {
                    const response = await fetch('/Tasks/CreateSubTask', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({
                            taskId: taskId,
                            title: subtask.title,
                            dueDate: subtask.dueDate || null,
                            assignments: assignmentsData.length > 0 ? assignmentsData : null
                        })
                    });
                    
                    const data = await response.json();
                    if (!data.success) {
                        console.error('Failed to save subtask:', subtask.title, data.message);
                    } else if (data.subTask && subtask.status === 'Completed') {
                        // If the subtask was marked as completed before saving, update its status
                        const updateResponse = await fetch('/Tasks/UpdateSubTaskStatus', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token
                            },
                            body: JSON.stringify({
                                subTaskId: data.subTask.id,
                                isCompleted: true
                            })
                        });
                        
                        const updateData = await updateResponse.json();
                        if (!updateData.success) {
                            console.error('Failed to update subtask status:', subtask.title, updateData.message);
                        }
                    }
                } catch (error) {
                    console.error('Error saving subtask:', subtask.title, error);
                }
            }
            
            // Clear pending subtasks after saving
            pendingSubtasks = [];
            hasUnsavedChanges = false;
        }
        
        // Function to save task assignments to database
        async function saveTaskAssignments(taskId, assignmentsToSave = null) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            
            // Use provided assignments or default to all current assignments
            const assignments = assignmentsToSave || currentTaskAssignments;
            
            // Save each assignment sequentially
            for (const assignment of assignments) {
                try {
                    const response = await fetch('/Tasks/AddAssignment', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({
                            taskItemId: taskId,
                            userId: assignment.userId,
                            assignmentType: 'Assignee',
                            role: null
                        })
                    });
                    
                    const data = await response.json();
                    if (!data.success) {
                        console.error('Failed to save assignment:', assignment.userName, data.message);
                    }
                } catch (error) {
                    console.error('Error saving assignment:', assignment.userName, error);
                }
            }
        }
        
        // Update checklist progress manually
        function updateChecklistProgressManual(percentage) {
            const progressBar = document.querySelector('.checklist-progress .progress-bar');
            const progressText = document.querySelector('.checklist-progress .progress-text');
            const headerProgressBar = document.getElementById('headerProgressBar');
            const headerProgressText = document.getElementById('headerProgressText');
            
            if (progressBar) progressBar.style.width = percentage + '%';
            if (progressText) progressText.textContent = percentage + '%';
            if (headerProgressBar) headerProgressBar.style.width = percentage + '%';
            if (headerProgressText) headerProgressText.textContent = percentage + '%';
        }
        
        // Update task title icon based on status
        function updateTaskTitleIconFromModal(status) {
            const icon = document.getElementById('taskTitleIcon');
            if (!icon) return;
            
            // Remove all status classes
            icon.className = icon.className.replace(/\bstatus-\w+/g, '');
            
            // Update icon and color based on status
            switch(status) {
                case 'Pending':
                    icon.className = 'fa-solid fa-circle-question task-title-icon status-planned';
                    break;
                case 'InProgress':
                    icon.className = 'fas fa-play-circle task-title-icon status-in-progress';
                    break;
                case 'Review':
                    icon.className = 'fas fa-exclamation-circle task-title-icon status-review';
                    break;
                case 'Completed':
                    icon.className = 'fas fa-check-circle task-title-icon status-completed';
                    break;
                default:
                    icon.className = 'fa-solid fa-circle-question task-title-icon status-planned';
            }
        }

        // Track pending subtasks (not yet saved to database)
        let pendingSubtasks = [];
        let hasUnsavedChanges = false;
        
        // Track original subtask states for change detection
        let originalSubtaskStates = new Map(); // Map<subtaskId, {isCompleted: bool, ...}>
        let modifiedExistingSubtasks = new Map(); // Map<subtaskId, {isCompleted: bool, ...}>

        // Function to update subtask progress in modal
        function updateSubtaskProgressInModal() {
            const totalItems = document.querySelectorAll('.checklist-item').length;
            const completedItems = document.querySelectorAll('.checklist-item.completed').length;
            const percentage = totalItems > 0 ? Math.round((completedItems / totalItems) * 100) : 0;
            updateChecklistProgressManual(percentage);
        }
        
        // Function to update subtask status on server (global scope)
        function updateSubTaskStatus(subtaskId, isCompleted) {
            fetch('/Tasks/UpdateSubTaskStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({
                    subTaskId: parseInt(subtaskId),
                    isCompleted: isCompleted
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    console.log('SubTask status updated successfully');
                } else {
                    console.error('Failed to update subtask status:', data.message);
                    alert('Failed to update subtask status: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error updating subtask status:', error);
                alert('An error occurred while updating the subtask');
            });
        }

        // Initialize subtask functionality
        function initializeSubtasks() {
            const addSubtaskBtn = document.getElementById('addSubtaskBtn');
            const checklistItems = document.querySelector('.checklist-items');
            
            if (addSubtaskBtn) {
                addSubtaskBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    // Check if there's already a subtask form in the DOM
                    const existingForm = document.querySelector('.new-subtask-card');
                    if (existingForm) {
                        console.log('Subtask form already exists, removing it first');
                        existingForm.remove();
                    }
                    
                    // Create new subtask card with improved UI
                    const newSubtaskCard = document.createElement('div');
                    newSubtaskCard.className = 'new-subtask-card';
                    newSubtaskCard.style.cssText = 'padding: 1rem 0rem; background-color: #fff; border-radius: 0.375rem; margin-bottom: 1rem;';
                    newSubtaskCard.innerHTML = `
                        <div style="margin-bottom: 0.75rem;">
                            <textarea class="form-control subtask-title-input" placeholder="Enter subtask title..." rows="1" style="resize: none; border: 1px solid #dee2e6; font-size: 0.875rem; padding: 0.75rem;"></textarea>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div style="display: flex; gap: 0.5rem;">
                                <button class="btn btn-primary btn-sm add-subtask-btn" style="padding: 0.375rem 1rem; border-radius: 0.5rem;">
                                    Add
                                </button>
                                <button class="btn btn-outline-secondary btn-sm cancel-subtask-btn" style="padding: 0.375rem 1rem; border-radius: 0.5rem;">
                                    Cancel
                                </button>
                            </div>
                            <div style="display: flex; gap: 0.5rem;">
                                <button class="btn btn-sm" id="assignSubtaskBtn" style="padding: 0.375rem 0.75rem; border: none; background: transparent; border-radius: 0.5rem;" onmouseover="this.style.backgroundColor='#eef1f3'" onmouseout="this.style.backgroundColor='transparent'">
                                    <i class="fas fa-user-plus"></i> Assign
                                </button>
                                <button class="btn btn-sm" id="dueDateSubtaskBtn" style="padding: 0.375rem 0.75rem; border: none; background: transparent; border-radius: 0.5rem;" onmouseover="this.style.backgroundColor='#eef1f3'" onmouseout="this.style.backgroundColor='transparent'">
                                    <i class="fa-solid fa-calendar-day"></i> Due date
                                </button>
                            </div>
                        </div>
                        <input type="date" class="form-control mt-2 subtask-duedate-input" style="display: none; font-size: 0.875rem;">
                        <div class="subtask-assignments-container" style="display: none;"></div>
                    `;
                    
                    // Insert at the beginning of checklist items
                    if (checklistItems) {
                        checklistItems.insertBefore(newSubtaskCard, checklistItems.firstChild);
                        
                        // Focus on the textarea
                        const input = newSubtaskCard.querySelector('.subtask-title-input');
                        input.focus();
                        
                        // Store selected assignments and due date
                        let selectedAssignments = [];
                        let selectedDueDate = null;
                        
                        // Validation function
                        function validateSubtaskForm(showMessages = false) {
                            const title = input.value.trim();
                            const hasTitle = title.length > 0;
                            const hasDueDate = selectedDueDate !== null && selectedDueDate !== '';
                            const hasAssignments = selectedAssignments.length > 0;
                            
                            const isValid = hasTitle && hasDueDate && hasAssignments;
                            
                            // Only show validation messages if requested (when Add button is clicked)
                            if (showMessages) {
                                updateValidationMessages(hasTitle, hasDueDate, hasAssignments);
                            }
                            
                            return isValid;
                        }
                        
                        // Update validation messages
                        function updateValidationMessages(hasTitle, hasDueDate, hasAssignments) {
                            // Remove existing validation messages
                            const existingMessages = newSubtaskCard.querySelectorAll('.validation-message');
                            existingMessages.forEach(msg => msg.remove());
                            
                            // Add validation messages
                            const messages = [];
                            if (!hasTitle) messages.push('Title is required');
                            if (!hasDueDate) messages.push('Due date is required');
                            if (!hasAssignments) messages.push('At least one assignee is required');
                            
                            if (messages.length > 0) {
                                const validationDiv = document.createElement('div');
                                validationDiv.className = 'validation-message';
                                validationDiv.style.cssText = 'font-size: 0.75rem; color: #dc3545; margin-bottom: 0.5rem; padding: 0.5rem; background-color: #f8d7da; border-radius: 0.25rem; border: 1px solid #f5c6cb;';
                                validationDiv.innerHTML = '<i class="fas fa-exclamation-triangle"></i> ' + messages.join(', ');
                                
                                // Insert above the title input field
                                const titleContainer = newSubtaskCard.querySelector('div[style*="margin-bottom: 0.75rem"]');
                                titleContainer.insertBefore(validationDiv, titleContainer.firstChild);
                            }
                        }
                        
                        // Handle Add button
                        const addBtn = newSubtaskCard.querySelector('.add-subtask-btn');
                        addBtn.disabled = false; // Always enabled
                        addBtn.classList.add('btn-primary');
                        
                        addBtn.addEventListener('click', function() {
                            if (validateSubtaskForm(true)) { // Show messages when clicked
                                const title = input.value.trim();
                                createSubtask(title, selectedDueDate, selectedAssignments);
                            }
                        });
                        
                        // Handle Cancel button
                        const cancelBtn = newSubtaskCard.querySelector('.cancel-subtask-btn');
                        cancelBtn.addEventListener('click', function() {
                            newSubtaskCard.remove();
                        });
                        
                        // Handle Due Date button
                        const dueDateBtn = newSubtaskCard.querySelector('#dueDateSubtaskBtn');
                        const dueDateInput = newSubtaskCard.querySelector('.subtask-duedate-input');
                        dueDateBtn.addEventListener('click', function(e) {
                            e.preventDefault();
                            if (dueDateInput.style.display === 'none') {
                                dueDateInput.style.display = 'block';
                                dueDateInput.focus();
                            } else {
                                dueDateInput.style.display = 'none';
                            }
                        });
                        
                        dueDateInput.addEventListener('change', function() {
                            selectedDueDate = this.value;
                            if (this.value) {
                                // Parse the date string directly without timezone conversion
                                const dateParts = this.value.split('-');
                                const year = dateParts[0];
                                const month = dateParts[1];
                                const day = dateParts[2];
                                
                                // Format as MM/DD/YYYY to match the display format
                                const formattedDate = `${month}/${day}/${year}`;
                                dueDateBtn.innerHTML = '<i class="fa-solid fa-calendar-day"></i> ' + formattedDate;
                                dueDateBtn.style.color = '#0d6efd';
                            } else {
                                selectedDueDate = null;
                                dueDateBtn.innerHTML = '<i class="fa-solid fa-calendar-day"></i> Due date';
                                dueDateBtn.style.color = '';
                            }
                            
                            // Trigger validation (no messages)
                            validateSubtaskForm(false);
                        });
                        
                        // Handle Assign button
                        const assignBtn = newSubtaskCard.querySelector('#assignSubtaskBtn');
                        assignBtn.addEventListener('click', function(e) {
                            e.preventDefault();
                            showSubtaskAssignmentPopup(selectedAssignments, function(assignments) {
                                selectedAssignments = assignments;
                                updateAssignmentDisplay(assignBtn, assignments);
                                
                                // Trigger validation after assignment change (no messages)
                                validateSubtaskForm(false);
                            });
                        });
                        
                        // Add validation trigger for title input
                        input.addEventListener('input', function() {
                            validateSubtaskForm(false); // No messages
                        });
                        
                        // Add validation trigger for title input on keyup (for paste events)
                        input.addEventListener('keyup', function() {
                            validateSubtaskForm(false); // No messages
                        });
                        
                        // Initial validation (no messages)
                        validateSubtaskForm(false);
                        
                        // Handle Escape key
                        input.addEventListener('keydown', function(e) {
                            if (e.key === 'Escape') {
                                e.preventDefault();
                                newSubtaskCard.remove();
                            }
                        });
                    }
                });
            }
            
            // Function to create a subtask (stored in memory, not saved to DB immediately)
            function createSubtask(title, dueDate, assignments) {
                // Generate temporary ID for the subtask
                const tempId = 'temp_' + Date.now();
                
                // Transform assignment data to match expected structure
                const transformedAssignments = (assignments || []).map(assignment => ({
                    userId: assignment.userId,
                    userName: assignment.userName,
                    userInitials: assignment.userName ? assignment.userName.split(' ').map(n => n[0]).join('').toUpperCase() : '??',
                    userEmail: assignment.userEmail || '',
                    assignmentType: assignment.assignmentType || 'Assignee',
                    role: assignment.role || ''
                }));
                
                // Auto-add subtask assignees to task assignees if they're not already assigned
                transformedAssignments.forEach(assignment => {
                    const isAlreadyAssigned = currentTaskAssignments.some(ta => ta.userId === assignment.userId);
                    if (!isAlreadyAssigned) {
                        currentTaskAssignments.push({
                            userId: assignment.userId,
                            userName: assignment.userName,
                            userInitials: assignment.userInitials,
                            userEmail: assignment.userEmail || '',
                            assignmentType: 'Assignee',
                            role: 'Subtask Assignee'
                        });
                    }
                });
                
                // Update task assignees UI if any new assignees were added
                if (transformedAssignments.length > 0) {
                    renderTaskAssignees(currentTaskAssignments);
                }
                
                // Create subtask object
                const newSubtask = {
                    id: tempId,
                    title: title,
                    dueDate: dueDate,
                    status: 'Pending',
                    assignments: transformedAssignments,
                    isPending: true // Mark as not yet saved to database
                };
                
                // Add to pending subtasks list
                pendingSubtasks.push(newSubtask);
                
                // Mark as having unsaved changes
                hasUnsavedChanges = true;
                
                // Remove the subtask form
                const existingForm = document.querySelector('.new-subtask-card');
                if (existingForm) {
                    existingForm.remove();
                }
                
                // Add the new subtask to the list
                addSubtaskToList(newSubtask);
                
                // Update progress
                updateSubtaskProgress();
            }
            
            // Function to add subtask to the list
            function addSubtaskToList(subtask) {
                if (!checklistItems) return;
                
                // Build assignment badges HTML
                let assignmentHtml = '';
                if (subtask.assignments && subtask.assignments.length > 0) {
                    assignmentHtml += '<div class="task-assignees-inline">';
                    subtask.assignments.forEach(assignment => {
                        assignmentHtml += `
                            <div class="task-assignee-avatar-inline" title="${assignment.userName} (${assignment.assignmentType})">
                                ${assignment.userInitials}
                            </div>
                        `;
                    });
                    assignmentHtml += '</div>';
                }
                
                // Build due date HTML
                let dueDateHtml = '';
                if (subtask.dueDate) {
                    // Parse date string directly to avoid timezone issues
                    const dateStr = subtask.dueDate.split('T')[0]; // Remove time part if present
                    const dateParts = dateStr.split('-');
                    const year = dateParts[0];
                    const month = dateParts[1];
                    const day = dateParts[2];
                    
                    // Create date for comparison (local timezone)
                    const dueDate = new Date(parseInt(year), parseInt(month) - 1, parseInt(day));
                    const today = new Date();
                    today.setHours(0, 0, 0, 0); // Reset time to start of day
                    
                    // Format as "Oct 15" style
                    const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                    const formattedDate = `${monthNames[parseInt(month) - 1]} ${parseInt(day)}`;
                    
                    const isOverdue = dueDate < today && subtask.status !== 'Completed';
                    const tomorrow = new Date(today);
                    tomorrow.setDate(today.getDate() + 1);
                    const isToday = dueDate.getTime() === today.getTime();
                    const isTomorrow = dueDate.getTime() === tomorrow.getTime();
                    const textColor = isOverdue ? '#c62828' : (isToday || isTomorrow ? '#1e1e1e' : '#6b7280');
                    dueDateHtml = `
                        <span class="badge badge-sm" style="background-color: ${isOverdue ? '#ffebee' : '#f5f5f5'}; color: ${textColor}; font-size: 0.7rem; padding: 0.25rem 0.5rem; border-radius: 0.25rem;">
                            <i class="fa-solid fa-calendar-day" style="font-size: 0.65rem;"></i> ${formattedDate}
                        </span>
                    `;
                }
                
                const subtaskItem = document.createElement('div');
                const isCompleted = subtask.status === 'Completed';
                subtaskItem.className = 'checklist-item' + (isCompleted ? ' completed' : '');
                subtaskItem.dataset.subtaskId = subtask.id;
                subtaskItem.dataset.isExisting = 'true'; // Mark as existing subtask
                subtaskItem.innerHTML = `
                    <div style="display: flex; align-items: center; width: 100%; padding: 0.5rem 0;">
                        <div style="display: flex; align-items: center; flex: 1; min-width: 0;">
                            <input type="checkbox" class="form-check-input subtask-checkbox" ${isCompleted ? 'checked' : ''} style="margin-right: 0.5rem;">
                            <label class="form-check-label" style="font-size: 0.875rem; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${subtask.title}</label>
                        </div>
                        <div style="display: flex; align-items: center; min-width: 80px; justify-content: right;">
                            ${dueDateHtml}
                        </div>
                        <div style="display: flex; align-items: center; min-width: 120px; justify-content: flex-end; gap: 0.25rem;">
                            ${assignmentHtml}
                        </div>
                    </div>
                `;
                checklistItems.appendChild(subtaskItem);
                
                // Add event listener for checkbox toggle
                const checkbox = subtaskItem.querySelector('input[type="checkbox"]');
                checkbox.addEventListener('change', function() {
                    const subtaskId = subtask.id;
                    const isCompleted = this.checked;
                    
                    if (isCompleted) {
                        subtaskItem.classList.add('completed');
                    } else {
                        subtaskItem.classList.remove('completed');
                    }
                    
                    // For pending subtasks, just update the in-memory status
                    if (subtask.isPending) {
                        // Update the subtask object in the pendingSubtasks array
                        const pendingSubtask = pendingSubtasks.find(st => st.id === subtaskId);
                        if (pendingSubtask) {
                            pendingSubtask.status = isCompleted ? 'Completed' : 'Pending';
                        }
                        // Mark as having unsaved changes
                        hasUnsavedChanges = true;
                    }
                    
                    // Update progress bar
                    updateSubtaskProgressInModal();
                });
            }
            
            // Function to update subtask progress
            function updateSubtaskProgress() {
                const totalItems = document.querySelectorAll('.checklist-item:not(.new-subtask-card)').length;
                const completedItems = document.querySelectorAll('.checklist-item.completed:not(.new-subtask-card)').length;
                const percentage = totalItems > 0 ? Math.round((completedItems / totalItems) * 100) : 0;
                
                updateChecklistProgressManual(percentage);
            }
            
            
