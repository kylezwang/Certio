                    <button class="btn btn-primary btn-sm" id="taskAssignDone" style="border-radius: 0.5rem;">Done</button>
                </div>
            `;
            
            document.body.appendChild(popup);
            
            // Load available users from the tasksData
            const availableUsersList = popup.querySelector('#taskAvailableUsersList');
            const selectedUsersList = popup.querySelector('#taskSelectedUsersList');
            const searchInput = popup.querySelector('#taskUserSearch');
            
            // Add hover handlers for hint icon
            const hintIcon = popup.querySelector('.task-hint-icon');
            const hintTooltip = popup.querySelector('.task-hint-tooltip');
            
            if (hintIcon && hintTooltip) {
                hintIcon.addEventListener('mouseenter', function() {
                    this.classList.remove('far');
                    this.classList.add('fas');
                    hintTooltip.style.display = 'block';
                });
                
                hintIcon.addEventListener('mouseleave', function() {
                    this.classList.remove('fas');
                    this.classList.add('far');
                    hintTooltip.style.display = 'none';
                });
            }
            
            // Get users from window.tasksData
            const allUsers = window.tasksData?.users || [];
            
            // Filter users by the TASK's matter (not the view filter)
            let users = allUsers;
            const matters = window.tasksData?.matters || [];
            
            if (currentTaskMatterId) {
                // Show only users assigned to this task's matter
                const taskMatter = matters.find(m => m.id === currentTaskMatterId || m.Id === currentTaskMatterId);
                if (taskMatter && taskMatter.assignedUserIds) {
                    users = allUsers.filter(u => taskMatter.assignedUserIds.includes(u.id));
                }
            }
            
            function renderUsers(filterText = '') {
                    const filtered = users.filter(u => 
                        !filterText || 
                        u.name.toLowerCase().includes(filterText.toLowerCase()) || 
                        u.email.toLowerCase().includes(filterText.toLowerCase())
                    );
                    
                    availableUsersList.innerHTML = filtered.map(user => `
                        <div class="form-check user-item" style="padding: 0.4rem;">
                            <input class="form-check-input user-checkbox" type="checkbox" 
                                   id="task_user_${user.id}" value="${user.id}"
                                   ${selectedUsers.some(u => u.userId === user.id) ? 'checked' : ''} style="margin-top: 0.75rem;">
                            <label class="form-check-label" for="task_user_${user.id}" style="cursor: pointer; font-size: 0.875rem;">
                                <strong>${user.name}</strong>
                                <small class="text-muted d-block" style="font-size: 0.75rem;">${user.email}</small>
                            </label>
                        </div>
                    `).join('');
                    
                    // Add checkbox event listeners
                    availableUsersList.querySelectorAll('.user-checkbox').forEach(checkbox => {
                        checkbox.addEventListener('change', function() {
                            const userId = parseInt(this.value);
                            const user = users.find(u => u.id === userId);
                            
                            if (this.checked) {
                                if (!selectedUsers.some(u => u.userId === userId)) {
                                    selectedUsers.push({
                                        userId: userId,
                                        userName: user.name,
                                        userInitials: user.initials,
                                        userEmail: user.email
                                    });
                                }
                            } else {
                                const index = selectedUsers.findIndex(u => u.userId === userId);
                                if (index > -1) {
                                    selectedUsers.splice(index, 1);
                                }
                            }
                            updateSelectedDisplay();
                        });
                    });
                }
                
                function updateSelectedDisplay() {
                    if (selectedUsers.length === 0) {
                        selectedUsersList.innerHTML = '<p class="text-muted mb-0" style="font-size: 0.75rem;">No users or groups selected yet.</p>';
                    } else {
                        selectedUsersList.innerHTML = selectedUsers.map(user => `
                            <span class="badge bg-primary me-1 mb-1" style="font-size: 0.75rem;">
                                ${user.userName}
                                <i class="fas fa-times ms-1" style="cursor: pointer;" data-user-id="${user.userId}"></i>
                            </span>
                        `).join('');
                        
                        // Add remove handlers
                        selectedUsersList.querySelectorAll('.fa-times').forEach(icon => {
                            icon.addEventListener('click', function() {
                                const userId = parseInt(this.dataset.userId);
                                const index = selectedUsers.findIndex(u => u.userId === userId);
                                if (index > -1) {
                                    selectedUsers.splice(index, 1);
                                }
                                const checkbox = availableUsersList.querySelector(`#task_user_${userId}`);
                                if (checkbox) checkbox.checked = false;
                                updateSelectedDisplay();
                            });
                        });
                    }
                }
                
                // Initialize display
                renderUsers();
                updateSelectedDisplay();
                
                // Search functionality
                searchInput.addEventListener('input', function() {
                    renderUsers(this.value);
                });
                
                // Handle Done button
                popup.querySelector('#taskAssignDone').addEventListener('click', function() {
                    callback(selectedUsers);
                    popup.remove();
                    document.removeEventListener('click', outsideClickHandler);
                });
                
                // Handle Cancel button
                popup.querySelector('#taskAssignCancel').addEventListener('click', function() {
                    popup.remove();
                    document.removeEventListener('click', outsideClickHandler);
                });
                
                // Close on outside click
                const outsideClickHandler = function(e) {
                    if (!popup.contains(e.target) && e.target !== assignBtn) {
                        popup.remove();
                        document.removeEventListener('click', outsideClickHandler);
                    }
                };
                
                // Add click handler after a short delay to avoid immediate closing
                setTimeout(() => {
                    document.addEventListener('click', outsideClickHandler);
                }, 100);
            }
            
            // Function to render task assignees in the modal
            function renderTaskAssignees(assignments) {
                const container = document.getElementById('taskAssigneesContainer');
                if (!container) return;
                
                if (!assignments || assignments.length === 0) {
                    container.innerHTML = '';
                    return;
                }
                
                container.innerHTML = assignments.map(assignment => {
                    const initials = assignment.userInitials || assignment.userName.split(' ').map(n => n[0]).join('').toUpperCase();
                    const tooltip = assignment.role ? `${assignment.userName} (${assignment.role})` : assignment.userName;
                    return `
                        <div class="member-avatar" title="${tooltip}">
                            ${initials}
                        </div>
                    `;
                }).join('');
            }
            
