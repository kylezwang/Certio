                    await handleSendDMEmail(message, subject, orgId);
                } else {
                    // Send email in channel mode
                    await handleSendChannelEmail(message, subject, orgId);
                }
            }
            
            // Send email in DM mode
            async function handleSendDMEmail(message, subject, orgId) {
                const messageInput = document.getElementById('messageInput');
                const emailSubjectInput = document.getElementById('channelEmailSubjectInput');
                const sendButton = document.getElementById('sendButton');
                
                // Get recipient email
                let recipientEmail = null;
                if (typeof window.getCurrentDirectOtherUserEmail === 'function') {
                    recipientEmail = window.getCurrentDirectOtherUserEmail();
                }
                
                if (!recipientEmail || recipientEmail.trim() === '') {
                    alert('Recipient email is not available. Please switch to regular message mode.');
                    return;
                }
                
                const currentThreadId = typeof window.getCurrentDirectThreadId === 'function' ? window.getCurrentDirectThreadId() : null;
                if (!currentThreadId) {
                    alert('No active direct message thread. Please open a direct message conversation and try again.');
                    // Exit email mode
                    isEmailModeActive = false;
                    const switcherIcon = emailSwitcherBtn?.querySelector('i');
                    const sendButtonIcon = sendButton?.querySelector('i');
                    if (switcherIcon) switcherIcon.className = 'fas fa-envelope';
                    if (sendButtonIcon) sendButtonIcon.className = 'fas fa-paper-plane';
                    if (emailSubjectInput) emailSubjectInput.style.display = 'none';
                    return;
                }
                
                // Disable send button
                if (sendButton) {
                    sendButton.disabled = true;
                    sendButton.classList.add('is-loading');
                }
                
                try {
                    // Get email account info
                    const emailAccountResponse = await fetch('/api/email-oauth/status');
                    const emailAccountResult = await emailAccountResponse.json();
                    
                    if (!emailAccountResult.success || !emailAccountResult.connected) {
                        alert('Please connect your email account first.');
                        return;
                    }
                    
                    const emailAccount = emailAccountResult.emailAccount;
                    
                    // Create message metadata
                    const metadata = {
                        EmailSubject: subject || 'Re: Direct Message',
                        EmailTo: recipientEmail,
                        EmailProvider: emailAccount.provider
                    };
                    
                    // Show optimistic message immediately (optional enhancement)
                    // This will be replaced when we reload messages
                    
                    // Create the direct message with Email type
                    const dmResponse = await fetch(`/api/dm/threads/${currentThreadId}/messages?orgId=${orgId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            Body: message,
                            MessageType: 'Email',
                            Metadata: JSON.stringify(metadata)
                        })
                    });
                    
                    const dmResult = await dmResponse.json();
                    
                    if (!dmResponse.ok || !dmResult.success) {
                        throw new Error(dmResult.error || 'Failed to create message');
                    }
                    
                    const newMessageId = dmResult.message?.id || dmResult.messageId;
                    if (!newMessageId) {
                        throw new Error('Message was created but message identifier was missing.');
                    }
                    
                    // Send the actual email via OAuth
                    const emailResponse = await fetch(`/api/dm/threads/${currentThreadId}/send-email?orgId=${orgId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            MessageId: newMessageId
                        })
                    });
                    
                    const emailResult = await emailResponse.json();
                    
                    if (!emailResponse.ok || !emailResult.success) {
                        throw new Error(emailResult.error || 'Failed to send email');
                    }
                    
                    // Clear inputs
                    if (messageInput) {
                        messageInput.value = '';
                        messageInput.style.height = 'auto';
                    }
                    if (emailSubjectInput) {
                        emailSubjectInput.value = '';
                    }
                    
                    // Reload messages to show the sent email
                    if (typeof loadDirectMessages === 'function') {
                        loadDirectMessages(currentThreadId);
                    }
                    
                    console.log('Email sent successfully in DM mode');
                } catch (error) {
                    console.error('Error sending email in DM mode:', error);
                    alert('Failed to send email: ' + (error.message || error));
                } finally {
                    if (sendButton) {
                        sendButton.disabled = false;
                        sendButton.classList.remove('is-loading');
                    }
                }
            }
            
