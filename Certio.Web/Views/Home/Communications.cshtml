                    // Extract emails from members (excluding current user)
                    const recipientEmails = membersData.members
                        .filter(m => m.email && m.email.trim() !== '' && m.userId != currentUserId)
                        .map(m => m.email.trim());
                    
                    if (recipientEmails.length === 0) {
