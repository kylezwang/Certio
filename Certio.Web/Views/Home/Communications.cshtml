                    const emailAccountResult = await emailAccountResponse.json();
                    
                    if (!emailAccountResult.success || !emailAccountResult.connected) {
                        alert('Please connect your email account first.');
                        return;
                    }
                    
                    const emailAccount = emailAccountResult.emailAccount;
                    
                    // Fetch channel members to get their emails
                    const membersResponse = await fetch(`/Client/${orgId}/Communications/GetChannelMembers?channelId=${channelId}`);
                    if (!membersResponse.ok) {
                        throw new Error('Failed to load channel members');
