@model Certio.Web.ViewModels.CommunicationsViewModel
@using Certio.Web.ViewModels
@using System.Text.Encodings.Web
@using System.Text.RegularExpressions
@{
    ViewData["Title"] = "Communications";
    ViewData["BodyClass"] = "communications-page";
    // Show AI chat panel like other pages
    ViewData["HideChatPanel"] = false;
    Layout = "_ClientLayout";
    var organizationId = ViewBag.OrganizationId ?? ViewContext.HttpContext.Items["CurrentOrganizationId"];
}

<!-- Organization ID for JavaScript access -->
<div class="d-none" data-organization-id="@organizationId"></div>

<div class="communications-container">
    <div class="communications-layout">
        <!-- Sidebar -->
        <div class="communications-sidebar">
            <!-- Header -->
            <div class="communications-header">
                <h2 class="communications-title">Communications Hub</h2>
                <!-- Search Bar for Communications -->
                <div style="position: relative; margin-top: 0.5rem;">
                    <i class="fas fa-search" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: #6b7280; font-size: 0.875rem; pointer-events: none; z-index: 1;"></i>
                    <input type="text" class="comms-search-input" id="commsPageSearchInput" placeholder="Search channels and messages..." style="width: 100%; padding-left: 2.25rem; padding-right: 2.5rem;">
                    <button class="comms-filter-btn" title="Filter" style="position: absolute; right: 0.5rem; top: 50%; transform: translateY(-50%);">
                        <i class="fas fa-filter"></i>
                    </button>
                </div>
            </div>

            <!-- Channels -->
            <div class="channels-section">
                @foreach (var category in Model.ChannelCategories.Where(c => c.Name != "VOICE CHANNELS"))
                {
                    <div class="channel-category">
                        <button class="category-toggle" data-category="@category.Name">
                            <i class="fas fa-chevron-down category-icon"></i>
                            @category.Name
                        </button>
                        
                        <div class="channels-list" data-category="@category.Name">
                            @* Show category-level channels first (e.g., firm's general channels) *@
                            @foreach (var channel in category.Channels)
                            {
                                <button class="channel-item @(channel.Name == Model.ActiveChannel ? "active" : "") @(channel.MatterId.HasValue ? "matter-channel" : "")" 
                                        data-channel="@channel.Name"
                                        data-channel-id="@channel.Id"
                                        data-type="@channel.Type.ToString().ToLower()"
                                        data-private="@channel.IsPrivate.ToString().ToLower()"
                                        data-matter-id="@(channel.MatterId?.ToString() ?? "")"
                                        data-matter-title="@(channel.MatterTitle ?? "")"
                                        title="@(channel.MatterId.HasValue ? channel.MatterTitle : channel.Name)">
                                    <div class="channel-info">
                                        @if (channel.Type == ChannelType.Voice)
                                        {
                                            <i class="fas fa-volume-up channel-icon"></i>
                                        }
                                        else
                                        {
                                            @if (channel.MatterId.HasValue)
                                            {
                                                <i class="fas fa-folder channel-icon"></i>
                                            }
                                            else if (channel.IsPrivate)
                                            {
                                                <i class="fas fa-lock channel-icon"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-hashtag channel-icon"></i>
                                            }
                                        }
                                        <span class="channel-name">@channel.Name</span>
                                    </div>
                                    <div class="channel-meta">
                                        @if (channel.Type == ChannelType.Voice && channel.Users.Any())
                                        {
                                            <div class="voice-users">
                                                @foreach (var user in channel.Users.Take(3))
                                                {
                                                    <div class="voice-user-avatar">@user</div>
                                                }
                                            </div>
                                        }
                                        @if (channel.Unread > 0)
                                        {
                                            <span class="unread-badge">@channel.Unread</span>
                                        }
                                    </div>
                                </button>
                            }
                            
                            @* Then show subcategories (e.g., Firm Matters) *@
                            @foreach (var subcategory in category.Subcategories)
                            {
                                <div class="subcategory-section">
                                    <button class="subcategory-toggle" data-subcategory="@subcategory.Name">
                                        <i class="fas fa-chevron-down subcategory-icon"></i>
                                        @subcategory.Name
                                    </button>
                                    <div class="subcategory-channels" data-subcategory="@subcategory.Name">
                                        @foreach (var channel in subcategory.Channels)
                                        {
                                            <button class="channel-item @(channel.Name == Model.ActiveChannel ? "active" : "") @(channel.MatterId.HasValue ? "matter-channel" : "")" 
                                                    data-channel="@channel.Name"
                                                    data-channel-id="@channel.Id"
                                                    data-type="@channel.Type.ToString().ToLower()"
                                                    data-private="@channel.IsPrivate.ToString().ToLower()"
                                                    data-matter-id="@(channel.MatterId?.ToString() ?? "")"
                                                    data-matter-title="@(channel.MatterTitle ?? "")"
                                                    data-org-id="@(subcategory.OrganizationId?.ToString() ?? "")"
                                                    title="@(channel.MatterId.HasValue ? channel.MatterTitle : channel.Name)">
                                                <div class="channel-info">
                                                    @if (channel.Type == ChannelType.Voice)
                                                    {
                                                        <i class="fas fa-volume-up channel-icon"></i>
                                                    }
                                                    else
                                                    {
                                                        @if (channel.MatterId.HasValue)
                                                        {
                                                            <i class="fas fa-folder channel-icon"></i>
                                                        }
                                                        else if (channel.IsPrivate)
                                                        {
                                                            <i class="fas fa-lock channel-icon"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="fas fa-hashtag channel-icon"></i>
                                                        }
                                                    }
                                                    <span class="channel-name">@channel.Name</span>
                                                </div>
                                                <div class="channel-meta">
                                                    @if (channel.Type == ChannelType.Voice && channel.Users.Any())
                                                    {
                                                        <div class="voice-users">
                                                            @foreach (var user in channel.Users.Take(3))
                                                            {
                                                                <div class="voice-user-avatar">@user</div>
                                                            }
                                                        </div>
                                                    }
                                                    @if (channel.Unread > 0)
                                                    {
                                                        <span class="unread-badge">@channel.Unread</span>
                                                    }
                                                </div>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Direct Messages -->
                <h3 class="team-title">Direct Messages — @Model.OnlineMembersCount Online</h3>
                <div class="team-members">
                    @* Show current user first *@
                    @foreach (var member in Model.TeamMembers.Where(m => m.UserId == ViewBag.CurrentUserId))
                    {
                        <div class="team-member @(member.CanDirectMessage ? "dm-user-item" : "dm-user-disabled")" 
                             data-user-id="@member.UserId" 
                             data-user-name="@member.Name"
                             data-user-email="@(member.Email ?? "")"
                             data-can-dm="@member.CanDirectMessage.ToString().ToLower()"
                             data-org-id="@member.OrganizationId"
                             data-org-name="@member.OrganizationName"
                             style="cursor: @(member.CanDirectMessage ? "pointer" : "not-allowed"); @(member.CanDirectMessage ? "" : "opacity: 0.6;")">
                            <div class="member-avatar current-user-avatar">
                                <span>@member.Avatar</span>
                                <div class="status-indicator @member.Status"></div>
                            </div>
                            <div class="member-info">
                                <div class="member-name-row">
                                    <span class="member-name">@member.Name</span>
                                    <span class="you-label" style="font-weight: 500; color: #888888; font-size: 0.9em;">(You)</span>
                                </div>
                                <p class="member-activity">@member.Activity</p>
                            </div>
                        </div>
                    }
                    @* Then show all other members *@
                    @foreach (var member in Model.TeamMembers.Where(m => m.UserId != ViewBag.CurrentUserId))
                    {
                        <div class="team-member @(member.CanDirectMessage ? "dm-user-item" : "dm-user-disabled")" 
                             data-user-id="@member.UserId" 
                             data-user-name="@member.Name"
                             data-user-email="@(member.Email ?? "")"
                             data-can-dm="@member.CanDirectMessage.ToString().ToLower()"
                             data-org-id="@member.OrganizationId"
                             data-org-name="@member.OrganizationName"
                             data-is-external="@member.IsExternalContacts.ToString().ToLower()"
                             style="cursor: @(member.CanDirectMessage ? "pointer" : "not-allowed"); @(member.CanDirectMessage ? "" : "opacity: 0.6;")">
                            <div class="member-avatar @(member.IsExternalContacts ? "external-contacts-avatar" : "")" style="background: @member.Color !important;">
                                <span>@member.Avatar</span>
                                @if (!member.IsExternalContacts)
                                {
                                <div class="status-indicator @member.Status"></div>
                                }
                            </div>
                            <div class="member-info">
                                <div class="member-name-row">
                                    <span class="member-name">@member.Name</span>
                                    <i class="@member.RoleIcon @member.RoleColor" style="font-size: 0.875rem;"></i>
                                </div>
                                <p class="member-activity">@member.Activity</p>
                            </div>
                        </div>
                    }
                </div>

                <!-- Inbox (Email Messages) - Will be reordered by JavaScript -->
                <div id="emailInboxSection" style="display: none; padding: 0 0.5rem; border-bottom: 1px solid #e8e8e8;">
                    <h3 class="team-title">Email Inbox</h3>
                    <div class="team-members">
                        <div id="inboxItem" class="team-member dm-user-item" style="cursor: pointer;" data-type="inbox">
                            <div class="member-avatar" style="
                                width: 32px;
                                height: 32px;
                                border-radius: 6px;
                                background: #c7b7a3;
                                color: white;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                font-size: 0.875rem;
                                flex-shrink: 0;
                            ">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <div class="member-info">
                                <div class="member-name-row">
                                    <span class="member-name">Inbox</span>
                                    <span id="inboxUnreadBadge" class="unread-badge" style="display: none;">0</span>
                                </div>
                                <p class="member-activity">Email messages</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Email Integration - Will be reordered by JavaScript -->
                <div id="emailIntegrationSection" class="email-integration-section" style="padding: 1rem 1rem 0 1rem; background: #f8f9fa; border-radius: 8px;">
                    <h4 style="font-size: 0.9em; font-weight: 600; margin-bottom: 12px; color: #333;">Email Integration</h4>
                    <div id="emailAccountStatus">
                        <div id="emailConnected" style="display: none; padding: 0.75rem 0; background: #f8f9fa; border-radius: 6px;">
                            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                <!-- Icon and Provider Name - matching Calendar style -->
                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    <i id="connectedProviderIcon" class="fab fa-google" style="color: #4285f4; font-size: 1.2em;"></i>
                                    <div style="display: flex; flex-direction: column; gap: 0.125rem;">
                                        <span id="connectedProviderName" style="font-size: 0.9em; font-weight: 500;">Gmail</span>
                                        <span id="connectedEmailAddress" style="font-size: 0.85em; font-weight: 400; color: #666;"></span>
                                    </div>
                                </div>
                                <!-- Disconnect Button -->
                                <button id="disconnectEmailBtn" class="btn btn-sm btn-outline-danger" style="font-size: 0.75em; padding: 4px 8px; align-self: flex-start;">
                                    Disconnect
                                </button>
                            </div>
                        </div>
                        <div id="emailNotConnected" style="display: none;">
                            <div style="display: flex; gap: 0.75rem;">
                                <button id="connectGmailBtn" class="oauth-connect-btn">
                                    <i class="fab fa-google"></i>
                                </button>
                                <button id="connectOutlookBtn" class="oauth-connect-btn">
                                    <i class="fab fa-windows"></i>
                                </button>
                            </div>
                            <p style="font-size: 0.85em; color: #666; margin: 0.75rem 0 0.25rem 0;">Connect your Gmail or Outlook to sync with Direct Messages</p>
                        </div>
                    </div>
                    <button id="sendAsEmailToggle" class="btn btn-sm btn-outline-secondary" style="width: 100%; font-size: 0.75em; margin-top: 8px; display: none;">
                        <i class="fas fa-envelope" style="margin-right: 5px;"></i>Switch to Email Mode
                    </button>
                </div>
            </div>

        </div>

        <!-- Main Chat Area -->
        <div class="main-chat">
            <!-- Chat Header -->
            <div class="chat-header">
                <div class="chat-header-content">
                    <div class="channel-header">
                        <i class="fas fa-hashtag channel-header-icon"></i>
                        <div class="channel-details">
                            <h2 class="channel-title">@Model.ActiveChannel</h2>
                            <p class="channel-description">Secure legal communications</p>
                        </div>
                    </div>
                    <div class="chat-controls">
                        <button class="control-btn" title="Search">
                            <i class="fas fa-search"></i>
                        </button>
                        <button class="control-btn" title="Notifications">
                            <i class="fas fa-bell"></i>
                        </button>
                        <button class="control-btn" title="Members">
                            <i class="fas fa-users"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Messages -->
            <div class="messages-container">
                <div class="messages-list">
                    @{
                        Message? previousMessage = null;
                        var currentUserId = ViewBag.CurrentUserId;
                    }
                    @foreach (var message in Model.Messages)
                    {
                        var member = Model.TeamMembers.FirstOrDefault(m => m.Name == message.User);
                        var isCurrentUser = message.UserId.HasValue && currentUserId != null && message.UserId.Value.ToString() == currentUserId.ToString();
                        
                        // Check if message should be grouped with previous
                        var isGrouped = false;
                        if (previousMessage != null && message.UserId.HasValue && previousMessage.UserId.HasValue && 
                            message.UserId.Value == previousMessage.UserId.Value && 
                            message.CreatedAt.HasValue && previousMessage.CreatedAt.HasValue)
                        {
                            var diffInMinutes = (message.CreatedAt.Value - previousMessage.CreatedAt.Value).TotalMinutes;
                            isGrouped = diffInMinutes <= 15;
                        }
                        
                        var messageClasses = "message-item";
                        if (isCurrentUser) { messageClasses += " current-user-message"; }
                        if (isGrouped) { messageClasses += " grouped-message"; }
                        
                        // Get avatar color from member or default
                        var avatarColor = "#3d1019"; // Default maroon
                        var isExternalContacts = false;
                        if (member != null)
                        {
                            avatarColor = member.Color ?? "#3d1019";
                            isExternalContacts = member.IsExternalContacts;
                            // Override to gray if external contacts
                            if (isExternalContacts)
                            {
                                avatarColor = "#aaaaaa";
                            }
                        }
                        else if (message.UserId.HasValue)
                        {
                            // Try to find member by UserId instead of Name
                            var memberByUserId = Model.TeamMembers.FirstOrDefault(m => m.UserId == message.UserId.Value);
                            if (memberByUserId != null)
                            {
                                avatarColor = memberByUserId.Color ?? "#3d1019";
                                isExternalContacts = memberByUserId.IsExternalContacts;
                                if (isExternalContacts)
                                {
                                    avatarColor = "#aaaaaa";
                                }
                            }
                        }
                        
                        <div class="@messageClasses" data-message-id="@message.Id">
                            <div class="message-avatar @(isExternalContacts ? "external-contacts-avatar" : "")" style="background: @avatarColor !important;">
                                <span>@message.Avatar</span>
                            </div>
                            <div class="message-content">
                                @* Email badge for email messages - above header *@
                                @if (message.MessageType == "Email")
                                {
                                    <div class="task-matter-badge@(isCurrentUser ? " task-matter-badge-right" : "")">
                                        <span class="badge matter-priority-badge task-priority-badge priority-medium" style="font-size: 0.625rem; padding: 0.25rem 0.5rem; border-radius: 12px; font-weight: 600; background-color: #e3f2fd; color: #1565c0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: inline-block;">
                                            Sent via email
                                        </span>
                                    </div>
                                }
                                <div class="message-header">
                                    <span class="message-author">@message.User</span>
                                    @if (member != null)
                                    {
                                        <i class="@member.RoleIcon @member.RoleColor"></i>
                                    }
                                    @{
                                        DateTime? messageDate = message.CreatedAt;
                                        string dateStr = "";
                                        string timeStr = "";
                                        
                                        if (messageDate.HasValue)
                                        {
                                            var date = messageDate.Value;
                                            var now = DateTime.Now;
                                            var isToday = date.Date == now.Date;
                                            
                                            // Format time
                                            var hours = date.Hour;
                                            var minutes = date.Minute;
                                            var ampm = hours >= 12 ? "PM" : "AM";
                                            var displayHours = hours % 12 == 0 ? 12 : hours % 12;
                                            timeStr = $"{displayHours}:{minutes:D2} {ampm}";
                                            
                                            // Format date (only if not today)
                                            if (!isToday)
                                            {
                                                dateStr = date.ToString("MMM d, yyyy");
                                            }
                                        }
                                        else if (!string.IsNullOrEmpty(message.Time))
                                        {
                                            // Fallback to Time property if CreatedAt is not available
                                            timeStr = message.Time;
                                        }
                                    }
                                    <span class="message-time">
                                        @if (!string.IsNullOrEmpty(dateStr))
                                        {
                                            <span class="message-date">@dateStr</span>
                                        }
                                        <span class="message-time-value">@timeStr</span>
                                    </span>
                                </div>
                                @{
                                    var encodedContent = HtmlEncoder.Default.Encode(message.Content ?? string.Empty);
                                    // Normalize line endings
                                    var normalizedContent = encodedContent
                                        .Replace("\r\n", "\n")
                                        .Replace("\r", "\n");
                                    // Convert sequences of 2+ newlines to double <br> (paragraph breaks)
                                    // Then convert remaining single newlines to single <br>
                                    var contentWithBreaks = Regex.Replace(normalizedContent, @"\n{2,}", "<br><br>")
                                        .Replace("\n", "<br />");
                                }
                                <p class="message-text">@Html.Raw(contentWithBreaks)</p>
                                @if (message.Reactions.Any())
                                {
                                    <div class="message-reactions">
                                        @foreach (var reaction in message.Reactions)
                                        {
                                            <button class="reaction-btn">
                                                @reaction.Emoji @reaction.Count
                                            </button>
                                        }
                                        <button class="add-reaction-btn">
                                            <i class="fas fa-smile"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                            @if (isGrouped)
                            {
                                string hoverTimestamp = "";
                                if (message.CreatedAt.HasValue)
                                {
                                    var hoverDate = message.CreatedAt.Value;
                                    var hoverHours = hoverDate.Hour;
                                    var hoverMinutes = hoverDate.Minute;
                                    var hoverAmpm = hoverHours >= 12 ? "PM" : "AM";
                                    var hoverDisplayHours = hoverHours % 12 == 0 ? 12 : hoverHours % 12;
                                    hoverTimestamp = $"{hoverDisplayHours}:{hoverMinutes:D2} {hoverAmpm}";
                                }
                                else if (!string.IsNullOrEmpty(message.Time))
                                {
                                    hoverTimestamp = message.Time;
                                }
                                <div class="hover-timestamp">@hoverTimestamp</div>
                            }
                        </div>
                        
                        previousMessage = message;
                    }
                </div>
            </div>

            <!-- Scroll to bottom button -->
            <button class="scroll-to-bottom-btn" id="scrollToBottomBtn" title="Scroll to bottom">
                <i class="fas fa-arrow-down"></i>
            </button>

            <!-- Message Input -->
            <div class="message-input-container">
                <!-- Regular DM Input -->
                <div id="regularMessageInput" class="message-input-wrapper">
                    <!-- Email Subject Input (shown when in email mode) -->
                    <input type="text" class="email-subject-input" id="channelEmailSubjectInput" placeholder="Subject..." style="display: none;" />
                    
                    <button class="input-btn" id="emailSwitcherBtn" title="Switch to Email Mode">
                        <i class="fas fa-envelope"></i>
                    </button>
                    <button class="input-btn" title="Attach File">
                        <i class="fas fa-paperclip"></i>
                    </button>
                    <textarea class="message-input" 
                              id="messageInput"
                              placeholder="Message #@Model.ActiveChannel" 
                              rows="1"></textarea>
                    <div class="input-controls">
                        <button class="input-btn" title="Emoji">
                            <i class="fas fa-smile"></i>
                        </button>
                        <button class="send-btn" id="sendButton" title="Send">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </div>

                <!-- Email Input Container (hidden by default) -->
                <div id="emailMessageInput" class="email-input-wrapper" style="display: none;">
                    <div class="email-input-header" style="background: #f0f0f0; padding: 8px 12px; border-radius: 8px 8px 0 0; font-size: 0.85em; color: #666;">
                        <i class="fas fa-envelope" style="margin-right: 5px;"></i>
                        <span>Send as Email</span>
                        <button id="toggleEmailInputBtn" class="btn btn-sm btn-link" style="float: right; padding: 0; font-size: 0.85em; color: #666;">
                            Switch to DM
                        </button>
                    </div>
                    <div class="email-input-fields" style="padding: 12px; background: #fff; border: 1px solid #ddd; border-top: none;">
                        <div style="margin-bottom: 8px;">
                            <label style="font-size: 0.75em; color: #666; display: block; margin-bottom: 4px;">Subject</label>
                            <input type="text" id="emailSubjectInput" class="form-control form-control-sm" placeholder="Email subject" style="font-size: 0.85em;">
                        </div>
                        <div style="margin-bottom: 8px;">
                            <label style="font-size: 0.75em; color: #666; display: block; margin-bottom: 4px;">To</label>
                            <input type="text" id="emailToInput" class="form-control form-control-sm" placeholder="Recipient email" readonly style="font-size: 0.85em; background: #f5f5f5;">
                        </div>
                        <textarea class="message-input" 
                                  id="emailBodyInput"
                                  placeholder="Email message" 
                                  rows="3" 
                                  style="font-size: 0.85em; margin-bottom: 8px;"></textarea>
                        <div style="display: flex; justify-content: flex-end; gap: 8px;">
                            <button id="cancelEmailBtn" class="btn btn-sm btn-secondary" style="font-size: 0.75em;">
                                Cancel
                            </button>
                            <button id="sendEmailBtn" class="btn btn-sm btn-primary" style="font-size: 0.75em;">
                                <i class="fas fa-paper-plane" style="margin-right: 5px;"></i>Send Email
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Signal to chat.js to NOT attach its send button handler on this page -->
    <script>
        window.communicationsPageActive = true;
    </script>
    
    <!-- SignalR Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    
    <!-- Communications Script -->
    <script src="~/js/communications.js"></script>
    
    <!-- Direct Messages Script -->
    <script src="~/js/direct-messages.js"></script>
    
    <!-- Email Integration Script -->
    <script src="~/js/email-integration.js"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Get current user and organization info
            const currentUserId = '@ViewBag.CurrentUserId';
            const currentUserName = '@ViewBag.CurrentUserName';
            const currentOrganizationId = '@ViewBag.OrganizationId';
            
            // Debug logging
            console.log('Initialization values:');
            console.log('  currentUserId:', currentUserId, '(type:', typeof currentUserId, ')');
            console.log('  currentUserName:', currentUserName, '(type:', typeof currentUserName, ')');
            console.log('  currentOrganizationId:', currentOrganizationId, '(type:', typeof currentOrganizationId, ')');
            
            // Get active channel from the first public channel
            const firstChannel = document.querySelector('.channel-item');
            const activeChannelId = firstChannel ? firstChannel.dataset.channelId : null;
            const activeChannelName = firstChannel ? firstChannel.querySelector('.channel-name')?.textContent : 'general';
            
            console.log('Channel info:');
            console.log('  firstChannel:', firstChannel);
            console.log('  activeChannelId:', activeChannelId, '(type:', typeof activeChannelId, ')');
            console.log('  activeChannelName:', activeChannelName);
            
            // Initialize communications chat if we have required data
            if (currentUserId && activeChannelId && typeof initializeCommunicationsChat === 'function') {
                console.log('Initializing communications chat...');
                initializeCommunicationsChat(activeChannelId, currentUserId, currentUserName, currentOrganizationId);
            } else {
                console.warn('Cannot initialize communications chat:', {
                    hasUserId: !!currentUserId,
