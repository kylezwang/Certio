@model Certio.Web.ViewModels.ServicesViewModel
@using Certio.Web.ViewModels
@{
    ViewData["Title"] = "Services - Legal Communication Hub";
    ViewData["BodyClass"] = "services-page";
}

<div class="services-container">
    <div class="services-layout">
        <!-- Sidebar -->
        <div class="services-sidebar">
            <!-- Header -->
            <div class="services-header">
                <h2 class="services-title">Legal Services Hub</h2>
                <p class="services-subtitle">Professional Communication</p>
            </div>

            <!-- Channels -->
            <div class="channels-section">
                @foreach (var category in Model.ChannelCategories)
                {
                    <div class="channel-category">
                        <button class="category-toggle" data-category="@category.Name">
                            <i class="fas fa-chevron-down category-icon"></i>
                            @category.Name
                        </button>
                        
                        <div class="channels-list" data-category="@category.Name">
                            @foreach (var channel in category.Channels)
                            {
                                <button class="channel-item @(channel.Name == Model.ActiveChannel ? "active" : "")" 
                                        data-channel="@channel.Name" 
                                        data-type="@channel.Type.ToString().ToLower()"
                                        data-private="@channel.IsPrivate.ToString().ToLower()">
                                    <div class="channel-info">
                                        @if (channel.Type == ChannelType.Voice)
                                        {
                                            <i class="fas fa-volume-up channel-icon"></i>
                                        }
                                        else
                                        {
                                            @if (channel.IsPrivate)
                                            {
                                                <i class="fas fa-lock channel-icon"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-hashtag channel-icon"></i>
                                            }
                                        }
                                        <span class="channel-name">@channel.Name</span>
                                    </div>
                                    <div class="channel-meta">
                                        @if (channel.Type == ChannelType.Voice && channel.Users.Any())
                                        {
                                            <div class="voice-users">
                                                @foreach (var user in channel.Users.Take(3))
                                                {
                                                    <div class="voice-user-avatar">@user</div>
                                                }
                                            </div>
                                        }
                                        @if (channel.Unread > 0)
                                        {
                                            <span class="unread-badge">@channel.Unread</span>
                                        }
                                    </div>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- User Panel -->
            <div class="user-panel">
                <div class="user-info">
                    <div class="user-avatar">
                        <span>YU</span>
                        <div class="status-indicator online"></div>
                    </div>
                    <div class="user-details">
                        <p class="user-name">You</p>
                        <p class="user-status">Managing legal operations</p>
                    </div>
                    <div class="user-controls">
                        <button class="control-btn" title="Microphone">
                            <i class="fas fa-microphone"></i>
                        </button>
                        <button class="control-btn" title="Headphones">
                            <i class="fas fa-headphones"></i>
                        </button>
                        <button class="control-btn" title="Settings">
                            <i class="fas fa-cog"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Team Members -->
            <div class="team-section">
                <h3 class="team-title">Team — @Model.OnlineMembersCount Online</h3>
                <div class="team-members">
                    @foreach (var member in Model.TeamMembers)
                    {
                        <div class="team-member">
                            <div class="member-avatar">
                                <span>@member.Avatar</span>
                                <div class="status-indicator @member.Status"></div>
                            </div>
                            <div class="member-info">
                                <div class="member-name-row">
                                    <span class="member-name">@member.Name</span>
                                    <i class="@member.RoleIcon @member.RoleColor"></i>
                                </div>
                                <p class="member-activity">@member.Activity</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Main Chat Area -->
        <div class="main-chat">
            <!-- Chat Header -->
            <div class="chat-header">
                <div class="chat-header-content">
                    <div class="channel-header">
                        <i class="fas fa-hashtag channel-header-icon"></i>
                        <div class="channel-details">
                            <h2 class="channel-title">@Model.ActiveChannel</h2>
                            <p class="channel-description">Secure legal communications</p>
                        </div>
                    </div>
                    <div class="chat-controls">
                        <button class="control-btn" title="Search">
                            <i class="fas fa-search"></i>
                        </button>
                        <button class="control-btn" title="Notifications">
                            <i class="fas fa-bell"></i>
                        </button>
                        <button class="control-btn" title="Members">
                            <i class="fas fa-users"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Messages -->
            <div class="messages-container">
                <div class="messages-list">
                    @foreach (var message in Model.Messages)
                    {
                        var member = Model.TeamMembers.FirstOrDefault(m => m.Name == message.User);
                        <div class="message-item">
                            <div class="message-avatar">
                                <span>@message.Avatar</span>
                            </div>
                            <div class="message-content">
                                <div class="message-header">
                                    <span class="message-author">@message.User</span>
                                    @if (member != null)
                                    {
                                        <i class="@member.RoleIcon @member.RoleColor"></i>
                                    }
                                    <span class="message-time">@message.Time</span>
                                </div>
                                <p class="message-text">@message.Content</p>
                                @if (message.Reactions.Any())
                                {
                                    <div class="message-reactions">
                                        @foreach (var reaction in message.Reactions)
                                        {
                                            <button class="reaction-btn">
                                                @reaction.Emoji @reaction.Count
                                            </button>
                                        }
                                        <button class="add-reaction-btn">
                                            <i class="fas fa-smile"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Scroll to bottom button -->
            <button class="scroll-to-bottom-btn" id="scrollToBottomBtn" title="Scroll to bottom">
                <i class="fas fa-arrow-down"></i>
            </button>

            <!-- Message Input -->
            <div class="message-input-container">
                <div class="message-input-wrapper">
                    <button class="input-btn" title="Attach File">
                        <i class="fas fa-paperclip"></i>
                    </button>
                    <textarea class="message-input" 
                              placeholder="Message #@Model.ActiveChannel" 
                              rows="1"></textarea>
                    <div class="input-controls">
                        <button class="input-btn" title="Emoji">
                            <i class="fas fa-smile"></i>
                        </button>
                        <button class="send-btn" title="Send">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Category toggle functionality
            const categoryToggles = document.querySelectorAll('.category-toggle');
            categoryToggles.forEach(toggle => {
                toggle.addEventListener('click', function() {
                    const categoryName = this.dataset.category;
                    const channelsList = document.querySelector(`[data-category="${categoryName}"]`);
                    const icon = this.querySelector('.category-icon');
                    
                    if (channelsList.style.display === 'none') {
                        channelsList.style.display = 'block';
                        icon.style.transform = 'rotate(0deg)';
                    } else {
                        channelsList.style.display = 'none';
                        icon.style.transform = 'rotate(-90deg)';
                    }
                });
            });

            // Channel selection
            const channelItems = document.querySelectorAll('.channel-item');
            channelItems.forEach(item => {
                item.addEventListener('click', function() {
                    // Remove active class from all channels
                    channelItems.forEach(ch => ch.classList.remove('active'));
                    // Add active class to clicked channel
                    this.classList.add('active');
                    
                    // Update channel title
                    const channelName = this.dataset.channel;
                    document.querySelector('.channel-title').textContent = channelName;
                    
                    // Update channel description based on type
                    const channelType = this.dataset.type;
                    const channelDescription = channelType === 'voice' ? 'Voice Channel' : 'Secure legal communications';
                    document.querySelector('.channel-description').textContent = channelDescription;
                    
                    // Update channel header icon
                    const headerIcon = document.querySelector('.channel-header-icon');
                    if (channelType === 'voice') {
                        headerIcon.className = 'fas fa-volume-up channel-header-icon';
                    } else {
                        const isPrivate = this.dataset.private === 'true';
                        headerIcon.className = isPrivate ? 'fas fa-lock channel-header-icon' : 'fas fa-hashtag channel-header-icon';
                    }
                });
            });

            // Auto-resize textarea
            const messageInput = document.querySelector('.message-input');
            messageInput.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 120) + 'px';
            });

            // Send message on Enter (without Shift)
            messageInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    if (this.value.trim()) {
                        // Handle send message
                        console.log('Sending message:', this.value);
                        this.value = '';
                        this.style.height = 'auto';
                    }
                }
            });

            // Send button click
            const sendBtn = document.querySelector('.send-btn');
            sendBtn.addEventListener('click', function() {
                if (messageInput.value.trim()) {
                    console.log('Sending message:', messageInput.value);
                    messageInput.value = '';
                    messageInput.style.height = 'auto';
                }
            });

            // Auto-scroll to bottom of messages
            function scrollToBottom() {
                const messagesContainer = document.querySelector('.messages-container');
                if (messagesContainer) {
                    messagesContainer.scrollTop = messagesContainer.scrollHeight;
                }
            }

            // Smooth scroll to bottom
            function smoothScrollToBottom() {
                const messagesContainer = document.querySelector('.messages-container');
                if (messagesContainer) {
                    messagesContainer.scrollTo({
                        top: messagesContainer.scrollHeight,
                        behavior: 'smooth'
                    });
                }
            }

            // Scroll to bottom on page load (instant, no animation)
            scrollToBottom();
            // Also scroll after a short delay to ensure all content is rendered
            setTimeout(scrollToBottom, 100);
            // Final scroll after images and other content might load
            setTimeout(scrollToBottom, 500);

            // Make scrollToBottom available globally for future use
            window.scrollToBottom = scrollToBottom;
            window.smoothScrollToBottom = smoothScrollToBottom;

            // Scroll to bottom button functionality
            const scrollToBottomBtn = document.getElementById('scrollToBottomBtn');
            const messagesContainer = document.querySelector('.messages-container');
            
            if (scrollToBottomBtn && messagesContainer) {
                // Show/hide scroll to bottom button based on scroll position
                function toggleScrollButton() {
                    const isAtBottom = messagesContainer.scrollTop + messagesContainer.clientHeight >= messagesContainer.scrollHeight - 10;
                    if (isAtBottom) {
                        scrollToBottomBtn.classList.remove('show');
                    } else {
                        scrollToBottomBtn.classList.add('show');
                    }
                }

                // Listen for scroll events
                messagesContainer.addEventListener('scroll', toggleScrollButton);

                // Click handler for scroll to bottom button
                scrollToBottomBtn.addEventListener('click', function() {
                    smoothScrollToBottom();
                });

                // Initial check
                toggleScrollButton();
            }
        });
    </script>
}
