            // Don't show placeholder anymore - it's always hidden
            // if (state.placeholder) {
            //     state.placeholder.classList.remove('d-none');
            // }

            if (state.frame) {
                state.frame.src = 'about:blank';
                state.frame.classList.add('d-none');
