        }

        function findInitialDocumentCard(cards) {
            const params = new URLSearchParams(window.location.search);
            const requestedId = params.get('doc');
            if (requestedId) {
                const requestedCard = document.querySelector(`.document-card-selectable[data-document-id="${requestedId}"]`);
                if (requestedCard) {
                    return requestedCard;
                }
            }

            return cards[0] || null;
        }

        async function openDocumentCard(card) {
            if (!card) {
                return;
            }

            const state = documentViewerState;
            if (!state.frame) {
                return;
            }

            if (state.currentCard === card && card.dataset.documentResolvedSrc) {
                setDocumentViewerSource(card.dataset.documentResolvedSrc, { skipReload: true });
                return;
            }

            document.querySelectorAll('.document-card-selectable.is-active').forEach(c => c.classList.remove('is-active'));
            card.classList.add('is-active');
            state.currentCard = card;

            updateDocumentViewerHeader(card);

            // Add active class to container to trigger full-screen layout
            const container = document.querySelector('.documents-container');
            if (container) {
                container.classList.add('document-viewer-active');
            }

            if (state.placeholder) {
                state.placeholder.classList.add('d-none');
            }
            if (state.viewerContainer) {
                state.viewerContainer.classList.remove('d-none');
                state.viewerContainer.removeAttribute('hidden');
            }

            if (state.error) {
                state.error.classList.add('d-none');
            }

            if (state.loading) {
                state.loading.classList.remove('d-none');
            }

            if (state.frame) {
                state.frame.classList.add('d-none');
            }

            if (card.dataset.documentResolvedSrc) {
                setDocumentViewerSource(card.dataset.documentResolvedSrc);
                return;
            }

            // Try to build embed URL from existing data attributes first
            const embedUrl = card.dataset.documentEmbedUrl || '';
            const previewUrl = card.dataset.documentPreviewUrl || '';
            const downloadUrl = card.dataset.documentDownloadUrl || '';
            const externalFileId = card.dataset.documentExternalId || '';

            if (embedUrl || previewUrl || downloadUrl || externalFileId) {
                const resolvedUrl = buildDocumentEmbedUrl({
                    provider: (card.dataset.documentProvider || '').toLowerCase(),
                    sourceType: card.dataset.documentSourceType || '',
                    embedUrl: embedUrl,
                    fallbackEmbedUrl: embedUrl,
                    previewUrl: previewUrl,
                    downloadUrl: downloadUrl,
                    fileType: card.dataset.documentFileType || '',
                    externalFileId: externalFileId
                });

                if (resolvedUrl) {
                    card.dataset.documentResolvedSrc = resolvedUrl;
                    setDocumentViewerSource(resolvedUrl);
                    return;
                }
            }

            // Fallback to API call if no direct URL available
            const docId = card.dataset.documentId;
            const orgId = card.dataset.documentOrgId;

            if (!docId || !orgId) {
                displayDocumentViewerError('Missing document identifiers.', card);
                return;
            }

            try {
                const response = await fetch(`/api/documents/${docId}/embed?orgId=${encodeURIComponent(orgId)}`, { 
                    credentials: 'include',
                    headers: {
                        'Accept': 'application/json'
                    }
                });
                
                // Check if response is actually JSON
                const contentType = response.headers.get('content-type');
                if (!contentType || !contentType.includes('application/json')) {
                    // Response is HTML (likely an error page), skip API and use fallback
                    throw new Error('API returned non-JSON response. Using direct URL.');
                }

                if (!response.ok) {
                    throw new Error(`Failed to retrieve embed URL (status ${response.status})`);
                }

                const payload = await response.json();
                const resolvedUrl = buildDocumentEmbedUrl({
                    provider: (card.dataset.documentProvider || '').toLowerCase(),
                    sourceType: card.dataset.documentSourceType || '',
                    embedUrl: payload.embedUrl || card.dataset.documentEmbedUrl || '',
                    fallbackEmbedUrl: card.dataset.documentEmbedUrl || '',
                    previewUrl: card.dataset.documentPreviewUrl || '',
                    downloadUrl: card.dataset.documentDownloadUrl || '',
                    fileType: card.dataset.documentFileType || '',
                    externalFileId: card.dataset.documentExternalId || ''
                });

                if (!resolvedUrl) {
                    throw new Error('No embeddable URL is available for this document.');
                }

                card.dataset.documentResolvedSrc = resolvedUrl;
                setDocumentViewerSource(resolvedUrl);
            } catch (error) {
                console.error('Unable to load document embed', error);
                // Try fallback using direct URLs from data attributes
                const fallbackUrl = buildDocumentEmbedUrl({
                    provider: (card.dataset.documentProvider || '').toLowerCase(),
                    sourceType: card.dataset.documentSourceType || '',
                    embedUrl: card.dataset.documentEmbedUrl || '',
                    fallbackEmbedUrl: card.dataset.documentEmbedUrl || '',
                    previewUrl: card.dataset.documentPreviewUrl || '',
                    downloadUrl: card.dataset.documentDownloadUrl || '',
                    fileType: card.dataset.documentFileType || '',
                    externalFileId: card.dataset.documentExternalId || ''
                });

                if (fallbackUrl) {
                    card.dataset.documentResolvedSrc = fallbackUrl;
                    setDocumentViewerSource(fallbackUrl);
                } else {
                    displayDocumentViewerError(error.message || 'Unable to load document.', card, {
                        provider: card.dataset.documentProvider || '',
                        previewUrl: card.dataset.documentPreviewUrl || '',
                        downloadUrl: card.dataset.documentDownloadUrl || '',
                        embedUrl: card.dataset.documentEmbedUrl || ''
                    });
                }
            }
        }

        function updateDocumentViewerHeader(card) {
            const state = documentViewerState;
            if (!card) {
                return;
            }

            const title = card.dataset.documentTitle || 'Document';
            if (state.title) {
                state.title.textContent = title;
            }

            const provider = (card.dataset.documentProvider || '').toLowerCase();
            const sourceType = card.dataset.documentSourceType || '';
            if (state.providerBadge) {
                state.providerBadge.textContent = formatProviderLabel(provider, sourceType);
            }

            if (state.meta) {
                state.meta.textContent = buildDocumentMetaLine(
                    card.dataset.documentAuthor || '',
                    card.dataset.documentModified || '',
                    card.dataset.documentStatus || ''
                );
            }

            const openUrl = card.dataset.documentOpenUrl
                || card.dataset.documentEmbedUrl
                || card.dataset.documentPreviewUrl
                || card.dataset.documentDownloadUrl
                || '';

            if (state.openExternal) {
                if (openUrl) {
                    state.openExternal.href = openUrl;
                    state.openExternal.classList.remove('disabled');
                    state.openExternal.setAttribute('aria-disabled', 'false');
                } else {
                    state.openExternal.removeAttribute('href');
                    state.openExternal.classList.add('disabled');
                    state.openExternal.setAttribute('aria-disabled', 'true');
                }
            }
        }

        function setDocumentViewerSource(url, options = {}) {
            const state = documentViewerState;
            if (!state.frame) {
                return;
            }

            if (!url) {
                displayDocumentViewerError('No document source provided.', state.currentCard || null);
                return;
            }

            if (state.error) {
                state.error.classList.add('d-none');
            }

            if (state.loading) {
                state.loading.classList.remove('d-none');
            }

            state.frame.classList.add('d-none');

            // Set a timeout to hide loading indicator if iframe doesn't load
            let loadTimeout = setTimeout(() => {
                if (state.loading && !state.loading.classList.contains('d-none')) {
                    console.warn('Document iframe load timeout, hiding loading indicator');
                    state.loading.classList.add('d-none');
                    state.frame.classList.remove('d-none');
                }
            }, 10000); // 10 second timeout

            const handleLoad = () => {
                clearTimeout(loadTimeout);
                if (state.loading) {
                    state.loading.classList.add('d-none');
                }
                state.frame.classList.remove('d-none');
                state.frame.removeEventListener('load', handleLoad);
            };

            const handleError = () => {
                clearTimeout(loadTimeout);
                if (state.loading) {
                    state.loading.classList.add('d-none');
                }
                state.frame.classList.remove('d-none');
            };

            state.frame.addEventListener('load', handleLoad, { once: true });
            state.frame.addEventListener('error', handleError, { once: true });

            if (!options.skipReload || state.frame.src !== url) {
                state.frame.src = url;
                // If URL is a Google Docs or Office Online URL, it might not trigger load event properly
                // Hide loading after a short delay if it's an external embed URL
                if (url.includes('docs.google.com') || url.includes('officeapps.live.com') || url.includes('onedrive.live.com')) {
                    setTimeout(() => {
                        if (state.loading && !state.loading.classList.contains('d-none')) {
                            state.loading.classList.add('d-none');
                            state.frame.classList.remove('d-none');
                        }
                    }, 2000); // Hide loading after 2 seconds for external embeds
                }
            } else {
                handleLoad();
            }
        }

        function closeDocumentViewer() {
