        function displayDocumentViewerError(message, card, links = {}) {
            const state = documentViewerState;

            if (state.loading) {
                state.loading.classList.add('d-none');
            }

            if (state.frame) {
                state.frame.classList.add('d-none');
                state.frame.src = 'about:blank';
            }

            if (!state.error) {
                return;
            }

            state.error.classList.remove('d-none');

            const fallback = links.embedUrl
                || links.previewUrl
                || links.downloadUrl
                || (card ? (card.dataset.documentOpenUrl || '') : '');

            let fallbackHtml = '';
            if (fallback) {
                fallbackHtml = ` You can still <a href="${fallback}" target="_blank" rel="noopener">open it in a new tab</a>.`;
                if (state.openExternal) {
                    state.openExternal.href = fallback;
                    state.openExternal.classList.remove('disabled');
                    state.openExternal.setAttribute('aria-disabled', 'false');
                }
            } else if (state.openExternal) {
                state.openExternal.removeAttribute('href');
                state.openExternal.classList.add('disabled');
                state.openExternal.setAttribute('aria-disabled', 'true');
            }

            const safeMessage = message || 'Unable to embed this document.';
            state.error.innerHTML = `<strong>We couldn't embed this document.</strong> ${safeMessage}${fallbackHtml}`;
        }

        function buildDocumentEmbedUrl(options) {
            const {
                provider,
                sourceType,
                embedUrl,
                fallbackEmbedUrl,
                previewUrl,
                downloadUrl,
                fileType,
                externalFileId
            } = options;

            let candidate = embedUrl || fallbackEmbedUrl || previewUrl || '';

            if (!candidate && provider === 'google' && externalFileId) {
                candidate = `https://docs.google.com/document/d/${externalFileId}/edit`;
            }

            if (!candidate && downloadUrl) {
                if (fileType && fileType.toLowerCase().includes('pdf')) {
                    return `https://docs.google.com/gview?embedded=1&url=${encodeURIComponent(downloadUrl)}`;
                }

                candidate = downloadUrl;
            }

            if (!candidate) {
                return null;
            }

            try {
                const parsed = new URL(candidate);

                if (provider === 'google' || sourceType === 'GoogleDrive') {
                    parsed.searchParams.set('rm', 'embedded');
                    parsed.searchParams.set('embedded', 'true');
                    return parsed.toString();
                }

                if (provider === 'microsoft' || provider === 'onedrive' || sourceType === 'OneDrive') {
                    if (parsed.hostname.includes('onedrive.live.com')) {
                        const resid = parsed.searchParams.get('resid');
                        const cid = parsed.searchParams.get('cid');
                        const authkey = parsed.searchParams.get('authkey');
                        const action = parsed.searchParams.get('action');

                        if (resid) {
                            const embedParams = new URLSearchParams();
                            embedParams.set('resid', resid);
                            if (cid) {
                                embedParams.set('cid', cid);
                            }
                            if (authkey) {
                                embedParams.set('authkey', authkey);
                            }
                            embedParams.set('action', action || 'edit');
                            embedParams.set('em', '2');
                            embedParams.set('wdAllowInteractivity', '1');
                            embedParams.set('wdDownloadButton', '0');
                            embedParams.set('wdInConfigurator', '1');
                            return `https://onedrive.live.com/embed?${embedParams.toString()}`;
                        }
                    }

                    if (parsed.hostname.includes('sharepoint.com')) {
                        parsed.searchParams.set('web', '1');
                        parsed.searchParams.set('wdAllowInteractivity', '1');
                        parsed.searchParams.set('action', parsed.searchParams.get('action') || 'edit');
                        return parsed.toString();
                    }

                    if (downloadUrl) {
                        return `https://view.officeapps.live.com/op/embed.aspx?src=${encodeURIComponent(downloadUrl)}`;
                    }
                }

                return parsed.toString();
            } catch (error) {
                console.warn('Unable to normalize embed URL', candidate, error);
                return candidate;
            }
        }

        function formatProviderLabel(provider, sourceType) {
