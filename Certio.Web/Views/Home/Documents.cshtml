@using Certio.Domain.Documents
@model Certio.Web.ViewModels.DocumentsViewModel
@{
    ViewData["Title"] = "Documents";
    Layout = "_ClientLayout";
}

<div class="documents-container" style="max-width: 100%; margin: 0 auto; padding: 0;">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="display-6 fw-bold text-dark mb-2">Documents</h1>
            <p class="lead text-muted">Manage and organize your legal documents</p>
        </div>
        <button class="btn btn-primary d-flex align-items-center gap-2">
            <i class="fas fa-upload"></i>
            Upload Document
        </button>
    </div>

    <!-- Search and Filters -->
    <div class="row mb-4">
        <div class="col-md-8">
            <div class="search-container">
                <i class="fas fa-search"></i>
                <input type="text" class="form-control" placeholder="Search documents..." />
            </div>
        </div>
        <div class="col-md-4">
            <div class="filter-buttons">
                <button class="filter-button">
                    <i class="fas fa-filter"></i>
                    Filter
                </button>
                <button class="filter-button">
                    <i class="fas fa-calendar"></i>
                    Date Range
                </button>
                <button class="filter-button" id="refreshDocumentsBtn" title="Refresh documents">
                    <i class="fas fa-sync-alt"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Matter Folders Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center">
                    <h5 class="fw-bold mb-0 me-2">Matter Folders</h5>
                    <i class="fas fa-chevron-down" style="color: rgba(11, 54, 94, 0.8);"></i>
                </div>
                <div class="search-container" style="max-width: 300px;">
                    <i class="fas fa-search"></i>
                    <input type="text" class="form-control" placeholder="Search matters..." />
                </div>
            </div>
            <div class="matters-scroll-container" style="overflow-x: auto; overflow-y: hidden; margin: 0 -0.75rem; padding: 0.75rem;">
                <div class="d-flex" style="min-width: min-content; gap: 1rem;">
                    @if (Model.Matters != null && Model.Matters.Any())
                    {
                        @foreach (var matter in Model.Matters)
                        {
                            var statusIcon = matter.Status switch
                            {
                                "Completed" => "fas fa-check-circle text-success",
                                "In Progress" => "fas fa-play-circle text-primary",
                                "Review" => "fas fa-exclamation-circle text-warning",
                                "Planning" => "fas fa-clock text-muted",
                                _ => "fas fa-circle text-secondary"
                            };
                            
                            var statusBadgeClass = matter.Status switch
                            {
                                "Completed" => "bg-success text-white",
                                "In Progress" => "bg-primary text-white",
                                "Review" => "bg-warning text-dark",
                                "Planning" => "bg-secondary text-white",
                                _ => "bg-secondary text-white"
                            };
                            
                            <a href="/Client/@ViewBag.OrganizationId/Matter/@matter.Id" class="text-decoration-none" style="flex: 0 0 14rem;">
                                <div class="card matter-folder-card border-0 h-100">
                                    <div class="card-body">
                                        <div class="matter-folder-content">
                                            <div class="me-3">
                                                <i class="fas fa-folder text-muted fs-4"></i>
                                            </div>
                                            <div class="flex-grow-1 min-width-0">
                                                <h6 class="fw-semibold mb-0 text-dark" style="max-width: 180px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.3;">@matter.Title</h6>
                                                <div class="d-flex align-items-baseline gap-2">
                                                    <i class="@statusIcon" style="font-size: 0.75rem;"></i>
                                                    <span class="badge @statusBadgeClass" style="font-size: 0.65rem; padding: 0.2rem 0.5rem; line-height: 1.3;">@matter.Status</span>
                                                </div>
                                            </div>
                                            <div class="ms-2">
                                                <i class="fas fa-ellipsis-v text-muted"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 w-100">
                            <p class="text-muted">No matters available</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Sidebar - Folders and Storage -->
        <div class="col-lg-3 mb-4">
            <!-- Document Integration Card -->
            <div class="card border-0 mb-4">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h5 class="card-title fw-bold mb-1">Document Integrations</h5>
                    <p class="text-muted small mb-0">Connect cloud storage</p>
                </div>
                <div class="card-body pt-2">
                    <div id="documentIntegrationsContainer">
                        <!-- Not Connected State -->
                        <div id="documentIntegrationsNotConnected" style="display: none;">
                            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                                <button id="connectGoogleDriveBtn" class="oauth-connect-btn" style="flex: 1; min-width: 120px;">
                                    <i class="fab fa-google"></i>
                                    <span style="margin-left: 0.5rem;">Drive</span>
                                </button>
                                <button id="connectOneDriveBtn" class="oauth-connect-btn" style="flex: 1; min-width: 120px;">
                                    <i class="fab fa-windows"></i>
                                    <span style="margin-left: 0.5rem;">OneDrive</span>
                                </button>
                            </div>
                            <p style="font-size: 0.85em; color: #666; margin: 0.75rem 0 0.25rem 0;">Connect your cloud storage to sync documents</p>
                        </div>
                        
                        <!-- Connected State -->
                        <div id="documentIntegrationsConnected" style="display: none;">
                            <div id="googleDriveStatus" style="display: none; margin-bottom: 0.75rem; padding: 0.75rem; background: #f8f9fa; border-radius: 6px;">
                                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                    <!-- Icon and Provider Name -->
                                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                                        <i class="fab fa-google" style="color: #4285f4; font-size: 1.2em;"></i>
                                        <span style="font-size: 0.9em; font-weight: 500;">Google Drive</span>
                                    </div>
                                    <!-- Connected Status -->
                                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                                        <i class="fas fa-check-circle" style="color: #10b981;"></i>
                                        <span style="font-size: 0.85em; color: #10b981;">Connected</span>
                                    </div>
                                    <!-- Disconnect Button -->
                                    <button id="disconnectGoogleDriveBtn" class="btn btn-sm btn-outline-danger" style="font-size: 0.75em; padding: 4px 8px; align-self: flex-start;">
                                        Disconnect
                                    </button>
                                </div>
                            </div>
                            <div id="oneDriveStatus" style="display: none; margin-bottom: 0.75rem; padding: 0.75rem; background: #f8f9fa; border-radius: 6px;">
                                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                    <!-- Icon and Provider Name -->
                                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                                        <i class="fab fa-windows" style="color: #0078d4; font-size: 1.2em;"></i>
                                        <span style="font-size: 0.9em; font-weight: 500;">OneDrive</span>
                                    </div>
                                    <!-- Connected Status -->
                                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                                        <i class="fas fa-check-circle" style="color: #10b981;"></i>
                                        <span style="font-size: 0.85em; color: #10b981;">Connected</span>
                                    </div>
                                    <!-- Disconnect Button -->
                                    <button id="disconnectOneDriveBtn" class="btn btn-sm btn-outline-danger" style="font-size: 0.75em; padding: 4px 8px; align-self: flex-start;">
                                        Disconnect
                                    </button>
                                </div>
                            </div>
                            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.5rem;">
                                <button id="connectGoogleDriveBtnConnected" class="oauth-connect-btn" style="flex: 1; min-width: 120px; display: none;">
                                    <i class="fab fa-google"></i>
                                    <span style="margin-left: 0.5rem;">Drive</span>
                                </button>
                                <button id="connectOneDriveBtnConnected" class="oauth-connect-btn" style="flex: 1; min-width: 120px; display: none;">
                                    <i class="fab fa-windows"></i>
                                    <span style="margin-left: 0.5rem;">OneDrive</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Folders Card -->
            <div class="card border-0 mb-4">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h5 class="card-title fw-bold mb-1">Folders</h5>
                    <p class="text-muted small mb-0">Organize by category</p>
                </div>
                <div class="card-body pt-2">
                    @foreach (var folder in Model.Folders)
                    {
                        <div class="d-flex align-items-center justify-content-between p-3 rounded-3 folder-item">
                            <div class="d-flex align-items-center">
                                <div class="p-2 bg-primary bg-opacity-10 rounded-2 me-3">
                                    <i class="@GetFolderIcon(folder.Icon) text-primary"></i>
                                </div>
                                <span class="fw-medium text-dark">@folder.Name</span>
                            </div>
                            <span class="badge bg-secondary">@folder.Count</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Storage Card -->
            <div class="card border-0">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h5 class="card-title fw-bold text-dark mb-1">Storage</h5>
                </div>
                <div class="card-body pt-2">
                    <div class="mb-3">
                        <div class="d-flex justify-content-between text-sm mb-2">
                            <span class="text-muted">Used</span>
                            <span class="fw-medium">@Model.Storage.UsedGB GB of @Model.Storage.TotalGB GB</span>
                        </div>
                        <div class="progress storage-progress">
                            <div class="progress-bar" 
                                 style="width: @Model.Storage.UsagePercentage%"></div>
                        </div>
                    </div>
                    
                    <div class="pt-3 border-top">
                        <div class="d-flex justify-content-between text-sm mb-2">
                            <span class="text-muted">Documents</span>
                            <span class="fw-medium">@Model.Storage.DocumentCount</span>
                        </div>
                        <div class="d-flex justify-content-between text-sm mb-2">
                            <span class="text-muted">Shared</span>
                            <span class="fw-medium">@Model.Storage.SharedCount</span>
                        </div>
                        <div class="d-flex justify-content-between text-sm">
                            <span class="text-muted">Recent</span>
                            <span class="fw-medium">@Model.Storage.RecentCount</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content - Documents List -->
        <div class="col-lg-9">
            <div class="documents-list">
                @foreach (var doc in Model.Documents)
                {
                    <div class="card border-0 document-card mb-3">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-start justify-content-between">
                                <div class="d-flex align-items-start flex-grow-1">
                                    <div class="p-3 bg-primary bg-opacity-10 rounded-3 me-4">
                                        <i class="@GetDocumentIcon(doc.Icon) text-primary fs-5"></i>
                                    </div>
                                    
                                    <div class="flex-grow-1 min-width-0">
                                        <h5 class="fw-semibold text-dark mb-1 text-truncate">@doc.Name</h5>
                                        <p class="text-muted small mb-3">@doc.Type</p>
                                        
                                        <div class="d-flex flex-wrap gap-2 mb-3">
                                            @foreach (var tag in doc.Tags)
                                            {
                                                <span class="document-tag">@tag</span>
                                            }
                                        </div>
                                        
                                        <div class="d-flex align-items-center gap-4 text-muted small">
                                            <div class="d-flex align-items-center">
                                                <i class="fas fa-user me-1"></i>
                                                <span>@doc.Author</span>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <i class="fas fa-calendar me-1"></i>
                                                <span>Modified @doc.Modified.ToString("yyyy-MM-dd")</span>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <i class="@GetVisibilityIcon(doc.Visibility) me-1"></i>
                                                <span>@doc.Visibility</span>
                                            </div>
                                            <span>@doc.Size</span>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="d-flex flex-column align-items-end gap-3">
                                    <span class="badge @GetStatusClass(doc.Status)">@doc.Status.ToString()</span>
                                    
                                    <div class="d-flex align-items-center gap-1 document-actions">
                                        <button class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-download"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-share"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-ellipsis-h"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Horizontal scroll on mouse wheel for matters container
        document.addEventListener('DOMContentLoaded', function() {
            const mattersContainer = document.querySelector('.matters-scroll-container');
            if (mattersContainer) {
                mattersContainer.addEventListener('wheel', function(e) {
                    if (e.deltaY !== 0) {
                        e.preventDefault();
                        this.scrollLeft += e.deltaY;
                    }
                }, { passive: false });
            }

            // Setup document OAuth event listeners and load status
            setupDocumentOAuthListeners();
            loadDocumentConnectionStatus();
        });

        // Load document connection status
        async function loadDocumentConnectionStatus() {
            try {
                const orgId = getCurrentOrganizationId();
                const url = orgId ? `/api/drive-oauth/status?orgId=${orgId}` : '/api/drive-oauth/status';
                
                const response = await fetch(url);
                const result = await response.json();
                
                if (result.success) {
                    updateDocumentStatusUI(result);
                }
            } catch (error) {
                console.error('Error loading document connection status:', error);
            }
        }

        // Update document status UI
        function updateDocumentStatusUI(status) {
            const notConnectedDiv = document.getElementById('documentIntegrationsNotConnected');
            const connectedDiv = document.getElementById('documentIntegrationsConnected');
            const googleStatusDiv = document.getElementById('googleDriveStatus');
            const oneDriveStatusDiv = document.getElementById('oneDriveStatus');
            const connectGoogleBtn = document.getElementById('connectGoogleDriveBtnConnected');
            const connectOneDriveBtn = document.getElementById('connectOneDriveBtnConnected');

            const googleConnected = status.googleDrive?.connected || false;
            const oneDriveConnected = status.oneDrive?.connected || false;

            if (googleConnected || oneDriveConnected) {
                // Show connected state
                if (notConnectedDiv) notConnectedDiv.style.display = 'none';
                if (connectedDiv) connectedDiv.style.display = 'block';

                // Show Google Drive status if connected
                if (googleStatusDiv) {
                    googleStatusDiv.style.display = googleConnected ? 'block' : 'none';
                }
                if (connectGoogleBtn) {
                    connectGoogleBtn.style.display = googleConnected ? 'none' : 'block';
                }

                // Show OneDrive status if connected
                if (oneDriveStatusDiv) {
                    oneDriveStatusDiv.style.display = oneDriveConnected ? 'block' : 'none';
                }
                if (connectOneDriveBtn) {
                    connectOneDriveBtn.style.display = oneDriveConnected ? 'none' : 'block';
                }
            } else {
                // Show not connected state
                if (notConnectedDiv) notConnectedDiv.style.display = 'block';
                if (connectedDiv) connectedDiv.style.display = 'none';
            }
        }

        // Setup document OAuth event listeners
        function setupDocumentOAuthListeners() {
            // Connect buttons (not connected state)
            const connectGoogleDriveBtn = document.getElementById('connectGoogleDriveBtn');
            const connectOneDriveBtn = document.getElementById('connectOneDriveBtn');

            if (connectGoogleDriveBtn) {
                connectGoogleDriveBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    connectDocumentProvider('google');
                });
            }

            if (connectOneDriveBtn) {
                connectOneDriveBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    connectDocumentProvider('onedrive');
                });
            }

            // Connect buttons (connected state - for adding additional provider)
            const connectGoogleDriveBtnConnected = document.getElementById('connectGoogleDriveBtnConnected');
            const connectOneDriveBtnConnected = document.getElementById('connectOneDriveBtnConnected');

            if (connectGoogleDriveBtnConnected) {
                connectGoogleDriveBtnConnected.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    connectDocumentProvider('google');
                });
            }

            if (connectOneDriveBtnConnected) {
                connectOneDriveBtnConnected.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    connectDocumentProvider('onedrive');
                });
            }

            // Disconnect buttons
            const disconnectGoogleDriveBtn = document.getElementById('disconnectGoogleDriveBtn');
            const disconnectOneDriveBtn = document.getElementById('disconnectOneDriveBtn');

            // Refresh documents button (next to Date Range)
            const refreshDocumentsBtn = document.getElementById('refreshDocumentsBtn');
            if (refreshDocumentsBtn) {
                refreshDocumentsBtn.addEventListener('click', async function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    await refreshDocuments();
                });
            }

            if (disconnectGoogleDriveBtn) {
                disconnectGoogleDriveBtn.addEventListener('click', async function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (confirm('Are you sure you want to disconnect Google Drive? This will stop syncing documents from Google Drive.')) {
                        await disconnectDocumentProvider('google');
                    }
                });
            }

            if (disconnectOneDriveBtn) {
                disconnectOneDriveBtn.addEventListener('click', async function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (confirm('Are you sure you want to disconnect OneDrive? This will stop syncing documents from OneDrive.')) {
                        await disconnectDocumentProvider('onedrive');
                    }
                });
            }

            // Listen for OAuth callback messages
            window.addEventListener('message', function(event) {
                // Verify origin
                if (event.origin !== window.location.origin) {
                    return;
                }

                if (event.data.type === 'document-oauth-success') {
                    console.log(`Successfully connected ${event.data.provider} for documents`);
                    // Reload status to update UI
                    loadDocumentConnectionStatus();
                    // Show success message
                    alert(`${event.data.provider} connected successfully! Your documents will sync automatically. Documents may take a few moments to appear.`);
                    // Refresh page after delay to show synced documents
                    setTimeout(() => {
                        window.location.reload();
                    }, 5000);
                } else if (event.data.type === 'document-oauth-error') {
                    const errorMsg = event.data.errorDescription || event.data.error || 'Unknown error occurred';
                    console.error(`Failed to connect ${event.data.provider}:`, errorMsg);
                    alert(`Failed to connect ${event.data.provider}: ${errorMsg}`);
                }
            });
        }

        // Disconnect document provider
        async function disconnectDocumentProvider(provider) {
            console.log(`Disconnecting document provider: ${provider}`);
            try {
                const orgId = getCurrentOrganizationId();
                const url = `/api/drive-oauth/${provider === 'google' ? 'google' : 'onedrive'}${orgId ? `?orgId=${orgId}` : ''}`;
                
                const response = await fetch(url, {
                    method: 'DELETE'
                });
                const result = await response.json();
                
                if (result.success) {
                    console.log(`Successfully disconnected ${provider}`);
                    // Reload status to update UI
                    loadDocumentConnectionStatus();
                    alert(`${provider === 'google' ? 'Google Drive' : 'OneDrive'} disconnected successfully.`);
                    // Refresh page to update document list
                    window.location.reload();
                } else {
                    console.error(`Failed to disconnect ${provider}:`, result.error);
                    alert(`Failed to disconnect ${provider}: ${result.error || 'Unknown error'}`);
                }
            } catch (error) {
                console.error(`Error disconnecting ${provider}:`, error);
                alert(`Failed to disconnect ${provider}. Please try again.`);
            }
        }

        // Refresh documents - syncs all connected providers and reloads page
        async function refreshDocuments() {
            console.log('Refreshing documents...');
            try {
                const orgId = getCurrentOrganizationId();
                const url = `/api/drive-oauth/sync${orgId ? `?orgId=${orgId}` : ''}`;
                
                // Disable button and show loading state
                const refreshBtn = document.getElementById('refreshDocumentsBtn');
                if (refreshBtn) {
                    refreshBtn.disabled = true;
                    const icon = refreshBtn.querySelector('i');
                    if (icon) {
                        icon.classList.add('fa-spin');
                    }
                }
                
                const response = await fetch(url, {
                    method: 'POST'
                });
                const result = await response.json();
                
                if (result.success) {
                    // Wait a bit for sync to process, then reload
                    setTimeout(() => {
                        window.location.reload();
                    }, 3000);
                } else {
                    // Re-enable button on error
                    if (refreshBtn) {
                        refreshBtn.disabled = false;
                        const icon = refreshBtn.querySelector('i');
                        if (icon) {
                            icon.classList.remove('fa-spin');
                        }
                    }
                    alert(`Failed to start sync: ${result.error || 'Unknown error'}`);
                }
            } catch (error) {
                console.error('Error refreshing documents:', error);
                const refreshBtn = document.getElementById('refreshDocumentsBtn');
                if (refreshBtn) {
                    refreshBtn.disabled = false;
                    const icon = refreshBtn.querySelector('i');
                    if (icon) {
                        icon.classList.remove('fa-spin');
                    }
                }
                alert('Failed to refresh documents. Please try again.');
            }
        }

        // Connect document provider (Google Drive or OneDrive)
        async function connectDocumentProvider(provider) {
            console.log(`Connecting document provider: ${provider}`);
            try {
                // Get orgId from URL path (/Client/{orgId}/...)
                const orgId = getCurrentOrganizationId();
                
                // Build authorize URL with orgId query parameter
                const authorizeUrl = `/api/drive-oauth/${provider === 'google' ? 'google' : 'onedrive'}/authorize`;
                const urlWithOrgId = orgId ? `${authorizeUrl}?orgId=${orgId}` : authorizeUrl;

                console.log(`Fetching authorization URL for ${provider} with orgId: ${orgId}...`);
                const response = await fetch(urlWithOrgId);
                const result = await response.json();

                console.log(`Authorization response:`, result);

                if (result.success && result.authorizationUrl) {
                    console.log(`Opening OAuth popup with URL: ${result.authorizationUrl}`);
                    // Open OAuth popup
                    const popup = window.open(result.authorizationUrl, 'Document OAuth', 'width=600,height=700');

                    if (!popup) {
                        alert('Please allow popups for this site to connect your document storage.');
                        return;
                    }

                    console.log('OAuth popup opened, waiting for callback...');

                    // Fallback: check if popup closed (in case postMessage doesn't work)
                    const checkInterval = setInterval(() => {
                        if (popup.closed) {
                            clearInterval(checkInterval);
                            console.log('OAuth popup closed');
                        }
                    }, 1000);
                } else {
                    console.error('Failed to get authorization URL:', result);
                    alert(`Failed to get authorization URL: ${result.error || 'Unknown error'}`);
                }
            } catch (error) {
                console.error(`Error connecting ${provider}:`, error);
                alert(`Failed to connect ${provider}. Please try again.`);
            }
        }

        // Get current organization ID from URL path
        function getCurrentOrganizationId() {
            // Try to get from URL path (/Client/{orgId}/...)
            const pathMatch = window.location.pathname.match(/\/Client\/(\d+)/);
            if (pathMatch && pathMatch[1]) {
                return parseInt(pathMatch[1], 10);
            }
            return null;
        }
    </script>
}

@functions {
    string GetFolderIcon(string icon)
    {
        return icon switch
        {
            "FileText" => "fas fa-file-alt",
            "File" => "fas fa-file",
            "Archive" => "fas fa-archive",
            _ => "fas fa-file"
        };
    }

    string GetDocumentIcon(string icon)
    {
        return icon switch
        {
            "FileText" => "fas fa-file-alt",
            "File" => "fas fa-file",
            "Image" => "fas fa-image",
            "Video" => "fas fa-video",
            "Archive" => "fas fa-archive",
            _ => "fas fa-file"
        };
    }

    string GetVisibilityIcon(string visibility)
    {
        return visibility switch
        {
            "Public" => "fas fa-globe",
            "Team" => "fas fa-users",
            "Private" => "fas fa-lock",
            _ => "fas fa-lock"
        };
    }

    string GetStatusClass(DocumentStatus status)
    {
        return status switch
        {
            DocumentStatus.Final or DocumentStatus.Published => "bg-success text-white",
            DocumentStatus.Draft => "bg-primary text-white",
            DocumentStatus.Review => "bg-warning text-dark",
            _ => "bg-secondary text-white"
        };
    }
}

