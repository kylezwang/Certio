        */
        // Documents lazy loading (similar to email inbox)
        let documentsPaginationState = {
            skip: 0,
            hasMore: true,
            loading: false,
            currentSourceType: null,
            currentFileTypeFilter: 'google-docs', // Default to Google Docs
            currentDateRange: 'last-30-days'
        };
        let documentsLazyObserver = null;

        function initDocumentsLazyLoading() {
            // Clear initial server-rendered documents since we want to filter by Google Docs by default
            const container = document.getElementById('documentsContainer');
            if (container) {
                const initialDocs = container.querySelectorAll('[data-document-entry="true"]');
                initialDocs.forEach(doc => doc.remove());
            }
            
            // Reset pagination state for fresh load
            documentsPaginationState.skip = 0;
            documentsPaginationState.hasMore = true;

            const sentinel = document.getElementById('documentsLazyLoadSentinel');

            if ('IntersectionObserver' in window && sentinel) {
                documentsLazyObserver = new IntersectionObserver(entries => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            loadMoreDocuments();
                        }
                    });
                }, {
                    root: null,
                    rootMargin: '200px',
                    threshold: 0
                });

                documentsLazyObserver.observe(sentinel);
            } else {
                // Fallback: traditional scroll listener
                let scrollTimeout;
                window.addEventListener('scroll', () => {
                    clearTimeout(scrollTimeout);
                    scrollTimeout = setTimeout(() => {
                        if (documentsPaginationState.loading || !documentsPaginationState.hasMore) return;

                        const scrollPosition = window.innerHeight + window.scrollY;
                        const documentHeight = document.documentElement.scrollHeight;

                        if (scrollPosition >= documentHeight - 200) {
                            loadMoreDocuments();
                        }
                    }, 100);
                });
            }

            // Apply default filters on page load (this will trigger document reload)
            applyDateRangeFilter('last-30-days', true, true);
            applyFileTypeFilter('google-docs', false); // false = reload documents with filter
        }

        async function loadMoreDocuments() {
            if (documentsPaginationState.loading || !documentsPaginationState.hasMore) return;
            
            documentsPaginationState.loading = true;
            const loadingIndicator = document.getElementById('documentsLoadingIndicator');
            const emptyState = document.getElementById('documentsEmptyState');
            
            if (loadingIndicator) loadingIndicator.style.display = 'block';
            if (emptyState) emptyState.style.display = 'none';
            
            try {
                const orgId = getCurrentOrganizationId();
                if (!orgId) {
                    throw new Error('Organization ID not found');
                }
                
                const params = new URLSearchParams({
                    orgId: orgId.toString(),
                    skip: documentsPaginationState.skip.toString(),
                    take: '25'
                });
                
                if (documentsPaginationState.currentSourceType) {
                    params.set('sourceType', documentsPaginationState.currentSourceType);
                }
                
                if (documentsPaginationState.currentFileTypeFilter && documentsPaginationState.currentFileTypeFilter !== 'all') {
                    params.set('fileTypeFilter', documentsPaginationState.currentFileTypeFilter);
                }

                if (documentsPaginationState.currentDateRange && documentsPaginationState.currentDateRange !== 'all-time') {
                    params.set('dateRange', documentsPaginationState.currentDateRange);
                }
                
                const response = await fetch(`/api/documents/list?${params.toString()}`);
                const result = await response.json();
                
                console.log('Document list response:', {
                    documentsReceived: result.documents?.length || 0,
                    hasMore: result.hasMore,
                    skip: documentsPaginationState.skip,
                    total: result.total,
                    filter: documentsPaginationState.currentFileTypeFilter
                });
                
                if (loadingIndicator) loadingIndicator.style.display = 'none';
                
                if (result.success && result.documents && result.documents.length > 0) {
                    const container = document.getElementById('documentsContainer');
                    if (container) {
                        result.documents.forEach(doc => {
                            container.appendChild(createDocumentCard(doc));
                        });
                    }
                    
                    documentsPaginationState.skip += result.documents.length;
                    documentsPaginationState.hasMore = result.hasMore;

                    console.log('Documents loaded. New state:', {
                        skip: documentsPaginationState.skip,
                        hasMore: documentsPaginationState.hasMore,
                        totalInDOM: document.querySelectorAll('[data-document-entry="true"]').length
                    });

                    // If there's still room below the fold, keep loading
                    if (documentsPaginationState.hasMore) {
                        setTimeout(() => maybeLoadMoreDocuments(), 100);
                    }
                } else {
                    documentsPaginationState.hasMore = false;
                    if (emptyState && documentsPaginationState.skip === 0) {
                        emptyState.style.display = 'block';
                    }
                }
            } catch (error) {
                console.error('Error loading more documents:', error);
                if (loadingIndicator) loadingIndicator.style.display = 'none';
            } finally {
                documentsPaginationState.loading = false;
            }
        }

        function maybeLoadMoreDocuments() {
            if (documentsPaginationState.loading || !documentsPaginationState.hasMore) return;

            const documentHeight = document.documentElement.scrollHeight;
            const viewportHeight = window.innerHeight;

            if (documentHeight <= viewportHeight + 160) {
                loadMoreDocuments();
            }
        }

