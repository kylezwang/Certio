        function extractLocation(metadata) {
            if (!metadata) return 'Root';
            
            // For OneDrive: parentPath format is like "/drive/root:/Folder/Subfolder"
            if (metadata.parentPath) {
                const path = metadata.parentPath.replace('/drive/root:', '').trimStart('/');
                if (path && path !== 'root') {
                    const pathParts = path.split('/').filter(p => p);
                    if (pathParts.length > 0) {
                        return pathParts[pathParts.length - 1];
                    }
                    return path;
                }
            }
            
            // For Google Drive: check parentFolderName first
            if (metadata.parentFolderName) return metadata.parentFolderName;
            if (metadata.driveFolder) return metadata.driveFolder;
            if (metadata.folderName) return metadata.folderName;
            
            return 'Root';
        }

        function isStatusInteractive(status) {
            return status === 'Draft' || status === 'Review' || status === 'Final' || status === 'Published';
        }

        function getStatusClass(status) {
            switch (status) {
                case 'Final':
                case 'Published':
                    return 'bg-success text-white';
                case 'Draft':
                    return 'bg-primary text-white';
                case 'Review':
                    return 'bg-warning text-dark';
                default:
                    return 'bg-secondary text-white';
            }
        }

        function getVisibilityIcon(visibility) {
            switch (visibility) {
                case 'Public':
                    return 'fas fa-globe';
                case 'Team':
                    return 'fas fa-users';
                case 'Private':
                    return 'fas fa-lock';
                default:
                    return 'fas fa-lock';
            }
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Navigate to document (used by card click)
        function navigateToDocument(event, url) {
            // Don't navigate if clicking on badge, buttons, or their children
            if (event && event.target) {
                const target = event.target;
                
                // Check if clicking on badge
                if (target.classList && target.classList.contains('badge')) {
                    return false;
                }
                
                // Check if clicking on button
                if (target.classList && target.classList.contains('btn')) {
                    return false;
                }
                
                // Check if clicking on icon inside button
                if (target.closest('button')) {
                    return false;
                }
                
                // Check if clicking on icon inside badge
                if (target.closest('.badge')) {
                    return false;
                }
            }
            
            // Check if the event was marked as handled by a child element
            if (event && event.__handled) {
                return false;
            }
            
            window.location.href = url;
            return false;
        }

