@using Certio.Domain.Documents
@model Certio.Web.ViewModels.DocumentsViewModel
@{
    ViewData["Title"] = "Documents";
    Layout = "_ClientLayout";
}

@section PageStyles {
    <style>
        /* Document sidebar cards - use same styling as matter folders */
        .document-sidebar-card-wrapper {
            color: inherit;
            text-decoration: none;
        }

        .document-sidebar-card-wrapper:hover {
            color: inherit;
            text-decoration: none;
        }

        .document-sidebar-card-wrapper .matter-folder-card {
            background-color: #ffffff;
            border-radius: 12px;
            transition: all 0.2s ease-in-out;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(0,0,0,0.25);
            min-height: 120px;
        }

        .document-sidebar-card-wrapper .matter-folder-card:hover {
            background-color: #eef1f3;
            transform: translateY(-1px);
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.2) !important;
        }

        .document-sidebar-card-wrapper .matter-folder-card .card-body {
            color: inherit;
        }

        /* Ensure all text inside card maintains proper color */
        .document-sidebar-card-wrapper h6,
        .document-sidebar-card-wrapper p,
        .document-sidebar-card-wrapper span {
            color: inherit;
        }

        /* Document Cards Styling */
        .document-card {
            cursor: pointer;
            transition: all 0.2s ease-in-out;
            background-color: #ffffff;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.25);
        }

        .document-card:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.2) !important;
        }

        .document-card .btn-outline-secondary {
            border-color: #dee2e6;
            color: #6c757d;
        }

        .document-card .btn-outline-secondary:hover {
            background-color: #f8f9fa;
            border-color: #adb5bd;
            color: #495057;
        }
    </style>
}

<div class="documents-container" style="max-width: 100%; margin: 0 auto; padding: 0;">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="display-6 fw-bold text-dark mb-2">Documents</h1>
            <p class="lead text-muted">Manage and organize your legal documents</p>
        </div>
        <button class="btn btn-primary d-flex align-items-center gap-2">
            <i class="fas fa-upload"></i>
            Upload Document
        </button>
    </div>

    <!-- Search and Filters -->
    <div class="row mb-4 g-2">
        <div class="col-md-6 col-lg-7">
            <div class="search-container">
                <i class="fas fa-search"></i>
                <input type="text" class="form-control" placeholder="Search documents..." />
            </div>
        </div>
        <div class="col-md-6 col-lg-5">
            <div class="filter-buttons d-flex justify-content-end" style="flex-wrap: nowrap; gap: 0.375rem;">
                <div class="dropdown d-inline-block">
                    <button class="filter-button dropdown-toggle" type="button" id="fileTypeFilterBtn" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-filter"></i>
                        <span id="fileTypeFilterLabel">Google Docs</span>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="fileTypeFilterBtn">
                        <li><a class="dropdown-item" href="#" onclick="applyFileTypeFilter('google-docs'); return false;">Google Docs</a></li>
                        <li><a class="dropdown-item" href="#" onclick="applyFileTypeFilter('google-sheets'); return false;">Google Sheets</a></li>
                        <li><a class="dropdown-item" href="#" onclick="applyFileTypeFilter('google-slides'); return false;">Google Slides</a></li>
                        <li><a class="dropdown-item" href="#" onclick="applyFileTypeFilter('pdf'); return false;">PDF</a></li>
                        <li><a class="dropdown-item" href="#" onclick="applyFileTypeFilter('word'); return false;">Word Documents</a></li>
                        <li><a class="dropdown-item" href="#" onclick="applyFileTypeFilter('excel'); return false;">Excel Spreadsheets</a></li>
                        <li><a class="dropdown-item" href="#" onclick="applyFileTypeFilter('powerpoint'); return false;">PowerPoint</a></li>
                        <li><a class="dropdown-item" href="#" onclick="applyFileTypeFilter('text'); return false;">Text Files</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#" onclick="applyFileTypeFilter('all'); return false;">All Files</a></li>
                    </ul>
                </div>
                <div class="dropdown d-inline-block">
                    <button class="filter-button dropdown-toggle" type="button" id="dateRangeFilterBtn" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-calendar"></i>
                        <span id="dateRangeFilterLabel">Last 30 Days</span>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="dateRangeFilterBtn">
                        <li><a class="dropdown-item" href="#" onclick="applyDateRangeFilter('last-7-days'); return false;">Last 7 Days</a></li>
                        <li><a class="dropdown-item" href="#" onclick="applyDateRangeFilter('last-30-days'); return false;">Last 30 Days</a></li>
                        <li><a class="dropdown-item" href="#" onclick="applyDateRangeFilter('last-90-days'); return false;">Last 90 Days</a></li>
                        <li><a class="dropdown-item" href="#" onclick="applyDateRangeFilter('this-year'); return false;">This Year</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#" onclick="applyDateRangeFilter('all-time'); return false;">All Time</a></li>
                    </ul>
                </div>
                <button class="filter-button" id="refreshDocumentsBtn" title="Refresh documents">
                    <i class="fas fa-sync-alt"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Matter Folders Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center">
                    <h5 class="fw-bold mb-0 me-2">Matter Folders</h5>
                    <i class="fas fa-chevron-down" style="color: rgba(11, 54, 94, 0.8);"></i>
                </div>
                <div class="search-container" style="max-width: 300px;">
                    <i class="fas fa-search"></i>
                    <input type="text" class="form-control" placeholder="Search matters..." />
                </div>
            </div>
            <div class="matters-scroll-container" style="overflow-x: auto; overflow-y: hidden; margin: 0 -0.75rem; padding: 0.75rem 0.75rem 0 0.75rem;">
                <div class="d-flex" style="min-width: min-content; gap: 1rem;">
                    @if (Model.Matters != null && Model.Matters.Any())
                    {
                        @foreach (var matter in Model.Matters)
                        {
                            var statusIcon = matter.Status switch
                            {
                                "Completed" => "fas fa-check-circle text-success",
                                "In Progress" => "fas fa-play-circle text-primary",
                                "Review" => "fas fa-exclamation-circle text-warning",
                                "Planning" => "fas fa-clock text-muted",
                                _ => "fas fa-circle text-secondary"
                            };
                            
                            var statusBadgeClass = matter.Status switch
                            {
                                "Completed" => "bg-success text-white",
                                "In Progress" => "bg-primary text-white",
                                "Review" => "bg-warning text-dark",
                                "Planning" => "bg-secondary text-white",
                                _ => "bg-secondary text-white"
                            };
                            
                            <div class="matter-folder-dropzone position-relative" style="flex: 0 0 14rem;" data-matter-id="@matter.Id" data-matter-title="@matter.Title" ondrop="handleDocumentDrop(event)" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" onclick="handleMatterFolderFilter(event, @matter.Id)">
                                <div class="card matter-folder-card border-0 h-100" style="cursor: pointer; height: 90% !important;">
                                    <div class="card-body">
                                        <div class="matter-folder-content">
                                            <div class="me-3">
                                                <i class="fas fa-folder text-muted fs-4"></i>
                                            </div>
                                            <div class="flex-grow-1 min-width-0">
                                                <h6 class="fw-semibold mb-0 text-dark" style="max-width: 180px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.3;">@matter.Title</h6>
                                                <div class="d-flex align-items-baseline gap-2">
                                                    <i class="@statusIcon" style="font-size: 0.75rem;"></i>
                                                    <span class="badge @statusBadgeClass" style="font-size: 0.65rem; padding: 0.2rem 0.5rem; line-height: 1.3;">@matter.Status</span>
                                                </div>
                                            </div>
                                            <div class="ms-2 matter-folder-menu-btn" onclick="event.stopPropagation(); window.location.href='/Client/@ViewBag.OrganizationId/Matter/Details/@matter.Id';" style="cursor: pointer; z-index: 10; position: relative;">
                                                <i class="fas fa-ellipsis-v text-muted"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 w-100">
                            <p class="text-muted">No matters available</p>
                        </div>
                    }
                    
                    @* Add invisible placeholder cards to fill up to 6 total cards for proper proportions *@
                    var matterCount = Model.Matters != null && Model.Matters.Any() ? Model.Matters.Count() : 0;
                    var placeholderCount = Math.Max(0, 6 - matterCount);
                    @for (int i = 0; i < placeholderCount; i++)
                    {
                        <div class="matter-folder-placeholder" style="flex: 0 0 14rem; pointer-events: none;">
                            <div class="card matter-folder-card border-0 h-100" style="background-color: transparent; box-shadow: none !important; cursor: default; min-height: 120px; border: none !important;">
                                <div class="card-body">
                                    <div class="matter-folder-content" style="visibility: hidden;">
                                        <div class="me-3">
                                            <i class="fas fa-folder text-muted fs-4"></i>
                                        </div>
                                        <div class="flex-grow-1 min-width-0">
                                            <h6 class="fw-semibold mb-0 text-dark" style="max-width: 180px;">&nbsp;</h6>
                                            <div class="d-flex align-items-baseline gap-2">
                                                <span class="badge">&nbsp;</span>
                                            </div>
                                        </div>
                                        <div class="ms-2">
                                            <i class="fas fa-ellipsis-v text-muted"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Left Sidebar - Integrations, Folders and Storage -->
        <div class="col-lg-3 mb-4">
            <!-- Document Integration Card -->
            <div class="card border-0 mb-4">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h5 class="card-title fw-bold mb-1">Document Integrations</h5>
                    <p class="text-muted small mb-0">Connect cloud storage</p>
                </div>
                <div class="card-body pt-2">
                    <div id="documentIntegrationsContainer">
                        <!-- Not Connected State -->
                        <div id="documentIntegrationsNotConnected" style="display: none;">
                            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                                <button id="connectGoogleDriveBtn" class="oauth-connect-btn" style="flex: 1; min-width: 120px;">
                                    <i class="fab fa-google"></i>
                                    <span style="margin-left: 0.5rem;">Drive</span>
                                </button>
                                <button id="connectOneDriveBtn" class="oauth-connect-btn" style="flex: 1; min-width: 120px;">
                                    <i class="fab fa-windows"></i>
                                    <span style="margin-left: 0.5rem;">OneDrive</span>
                                </button>
                            </div>
                            <p style="font-size: 0.85em; color: #666; margin: 0.75rem 0 0.25rem 0;">Connect your cloud storage to sync documents</p>
                        </div>
                        
                        <!-- Connected State -->
                        <div id="documentIntegrationsConnected" style="display: none;">
                            <div id="googleDriveStatus" style="display: none; padding: 0.75rem; background: #f8f9fa; border-radius: 6px;">
                                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                    <!-- Icon and Provider Name -->
                                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                                        <i class="fab fa-google" style="color: #4285f4; font-size: 1.2em;"></i>
                                        <div style="display: flex; flex-direction: column; gap: 0.125rem;">
                                            <span style="font-size: 0.9em; font-weight: 500;">Google Drive</span>
                                            <span id="googleDriveEmail" style="font-size: 0.85em; font-weight: 400; color: #666;"></span>
                                        </div>
                                    </div>
                                    <!-- Disconnect Button -->
                                    <button id="disconnectGoogleDriveBtn" class="btn btn-sm btn-outline-danger" style="font-size: 0.75em; padding: 4px 8px; align-self: flex-start;">
                                        Disconnect
                                    </button>
                                </div>
                            </div>
                            <div id="oneDriveStatus" style="display: none; padding: 0.75rem; background: #f8f9fa; border-radius: 6px;">
                                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                    <!-- Icon and Provider Name -->
                                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                                        <i class="fab fa-windows" style="color: #0078d4; font-size: 1.2em;"></i>
                                        <div style="display: flex; flex-direction: column; gap: 0.125rem;">
                                            <span style="font-size: 0.9em; font-weight: 500;">OneDrive</span>
                                            <span id="oneDriveEmail" style="font-size: 0.85em; font-weight: 400; color: #666;"></span>
                                        </div>
                                    </div>
                                    <!-- Disconnect Button -->
                                    <button id="disconnectOneDriveBtn" class="btn btn-sm btn-outline-danger" style="font-size: 0.75em; padding: 4px 8px; align-self: flex-start;">
                                        Disconnect
                                    </button>
                                </div>
                            </div>
                            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.5rem;">
                                <button id="connectGoogleDriveBtnConnected" class="oauth-connect-btn" style="flex: 1; min-width: 120px; display: none; white-space: nowrap;">
                                    <i class="fab fa-google"></i>
                                    <span style="margin-left: 0.5rem;">Drive</span>
                                </button>
                                <button id="connectOneDriveBtnConnected" class="oauth-connect-btn" style="flex: 1; min-width: 120px; display: none; white-space: nowrap;">
                                    <i class="fab fa-windows"></i>
                                    <span style="margin-left: 0.5rem;">OneDrive</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Folders Card -->
            <div class="card border-0 mb-4">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h5 class="card-title fw-bold mb-1">Folders</h5>
                    <p class="text-muted small mb-0">Organize by category</p>
                </div>
                <div class="card-body pt-2">
                    @foreach (var folder in Model.Folders)
                    {
                        <div class="d-flex align-items-center justify-content-between rounded-3 folder-item" style="padding: 0.5rem 0;">
                            <div class="d-flex align-items-center">
                                @if (folder.Name == "Google Drive")
                                {
                                    <div class="p-2 bg-light rounded-2 me-3 d-flex align-items-center justify-content-center" style="width: 2.5rem; height: 2.5rem; min-width: 2.5rem;">
                                        <i class="fab fa-google" style="font-size: 1.25rem; color: #4285f4;"></i>
                                    </div>
                                }
                                else if (folder.Name == "OneDrive")
                                {
                                    <div class="p-2 bg-light rounded-2 me-3 d-flex align-items-center justify-content-center" style="width: 2.5rem; height: 2.5rem; min-width: 2.5rem;">
                                        <i class="fab fa-windows" style="font-size: 1.25rem; color: #0078d4;"></i>
                                    </div>
                                }
                                else
                                {
                                    <div class="p-2 bg-primary bg-opacity-10 rounded-2 me-3 d-flex align-items-center justify-content-center" style="width: 2.5rem; height: 2.5rem; min-width: 2.5rem;">
                                        <i class="@GetFolderIcon(folder.Icon) text-primary"></i>
                                    </div>
                                }
                                <span class="fw-medium text-dark">@folder.Name</span>
                            </div>
                            <span class="badge bg-secondary">@folder.Count</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Storage Card -->
            <div class="card border-0">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h5 class="card-title fw-bold text-dark mb-1">Storage</h5>
                </div>
                <div class="card-body pt-2">
                    @if (Model.Storage.TotalGB > 0)
                    {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between text-sm mb-2">
                            <span class="text-muted">Used</span>
                            <span class="fw-medium">@Math.Round(Model.Storage.UsedGB, 2) GB of @Model.Storage.TotalGB GB</span>
                        </div>
                        <div class="progress storage-progress">
                            <div class="progress-bar" 
                                 style="width: @Model.Storage.UsagePercentage%"></div>
                        </div>
                    </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <p class="text-muted small mb-0">Connect Google Drive or OneDrive to view storage usage</p>
                        </div>
                    }
                    
                    <div class="pt-3 border-top">
                        <div class="d-flex justify-content-between text-sm mb-2">
                            <span class="text-muted">Documents</span>
                            <span class="fw-medium">@Model.Storage.DocumentCount</span>
                        </div>
                        <div class="d-flex justify-content-between text-sm mb-2">
                            <span class="text-muted">Shared</span>
                            <span class="fw-medium">@Model.Storage.SharedCount</span>
                        </div>
                        <div class="d-flex justify-content-between text-sm">
                            <span class="text-muted">Recent</span>
                            <span class="fw-medium">@Model.Storage.RecentCount</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content Area - Documents List -->
        <div class="col-lg-9">
            <div class="d-flex flex-column" id="documentsContainer">
                <!-- Initial documents from server-side render -->
                @foreach (var doc in Model.Documents)
                {
                    var provider = GetDocumentProvider(doc);
                    var openUrl = GetPrimaryOpenUrl(doc);
                    var modifiedIso = FormatIso8601(doc.Modified);
                    var fileSize = doc.Metadata != null && doc.Metadata.TryGetValue("size", out var size) ? size : null;
                    var visibility = doc.Metadata != null && doc.Metadata.TryGetValue("visibility", out var vis) && !string.IsNullOrWhiteSpace(vis) ? vis : "Private";
                    
                    // Get document location/folder path
                    var location = "Root";
                    if (doc.Metadata != null)
                    {
                        // For OneDrive: parentPath format is like "/drive/root:/Folder/Subfolder" or "/drive/root:"
                        if (doc.Metadata.TryGetValue("parentPath", out var parentPath) && !string.IsNullOrWhiteSpace(parentPath))
                        {
                            var path = parentPath.Replace("/drive/root:", "").TrimStart('/');
                            if (!string.IsNullOrWhiteSpace(path) && path != "root")
                            {
                                // Extract folder name from path (last segment)
                                var pathParts = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
                                if (pathParts.Length > 0)
                                {
                                    location = pathParts[pathParts.Length - 1];
                                }
                                else
                                {
                                    location = path;
                                }
                            }
                        }
                        // For Google Drive: check for folder name in metadata (populated by sync service)
                        else if (doc.Metadata.TryGetValue("parentFolderName", out var parentFolderName) && !string.IsNullOrWhiteSpace(parentFolderName))
                        {
                            location = parentFolderName;
                        }
                        else if (doc.Metadata.TryGetValue("driveFolder", out var driveFolder) && !string.IsNullOrWhiteSpace(driveFolder))
                        {
                            location = driveFolder;
                        }
                        else if (doc.Metadata.TryGetValue("folderName", out var folderName) && !string.IsNullOrWhiteSpace(folderName))
                        {
                            location = folderName;
                        }
                    }
                    
                    <a href="javascript:void(0);" onclick="navigateToDocument(event, '/Client/@ViewBag.OrganizationId/Documents/@doc.Id');" class="text-decoration-none" style="color: inherit;" data-document-entry="true">
                        <div class="card document-card border-0 mb-3 @(doc.SourceType == Certio.Domain.Documents.DocumentSourceType.GoogleDrive || doc.SourceType == Certio.Domain.Documents.DocumentSourceType.OneDrive ? "draggable-document" : "")" 
                             style="cursor: pointer;"
                             draggable="@(doc.SourceType == Certio.Domain.Documents.DocumentSourceType.GoogleDrive || doc.SourceType == Certio.Domain.Documents.DocumentSourceType.OneDrive ? "true" : "false")"
                             ondragstart="handleDragStart(event)"
                             ondragend="handleDragEnd(event)"
                             data-document-id="@doc.Id"
                             data-document-source-type="@doc.SourceType.ToString()"
                             data-document-org-id="@ViewBag.OrganizationId">
                            <div class="card-body p-4" style="position: relative;">
                                <!-- Status Badge and Action Icons (Top Right) -->
                                <div class="position-absolute" style="top: 1rem; right: 1rem;">
                                    <div class="d-flex flex-column align-items-end gap-2">
                                        <!-- Status Badge (clickable for Draft/Review) -->
                                        @{
                                            var statusBadgeClass = GetStatusClass(doc.Status);
                                            var isClickable = doc.Status == Certio.Domain.Documents.DocumentStatus.Draft
                                                || doc.Status == Certio.Domain.Documents.DocumentStatus.Review
                                                || doc.Status == Certio.Domain.Documents.DocumentStatus.Final
                                                || doc.Status == Certio.Domain.Documents.DocumentStatus.Published;
                                        }
                                        <span class="badge @statusBadgeClass @(isClickable ? "document-status-badge-clickable" : "")" 
                                               data-document-id="@doc.Id"
                                               data-current-status="@doc.Status"
                                               style="font-size: 0.65rem; padding: 0.2rem 0.5rem; line-height: 1.3; @(isClickable ? "cursor: pointer;" : "")">
                                            @doc.Status.ToString()
                                        </span>
                                        <!-- Action Icons -->
                                        <div class="d-flex gap-2 align-items-center" style="margin-top: 0;">
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center" 
                                                    title="Download" 
                                                    style="width: 36px; height: 36px; padding: 0; margin: 0; border: 1px solid; line-height: 1;"
                                                    onclick="event.stopPropagation(); event.preventDefault(); downloadDocument(@doc.Id);">
                                                <i class="fas fa-download" style="font-size: 0.875rem; line-height: 1;"></i>
                                            </button>
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center" 
                                                    title="Share" 
                                                    style="width: 36px; height: 36px; padding: 0; margin: 0; border: 1px solid; line-height: 1;"
                                                    onclick="event.stopPropagation(); event.preventDefault();">
                                                <i class="fas fa-share-alt" style="font-size: 0.875rem; line-height: 1;"></i>
                                            </button>
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center document-hide-btn" 
                                                    title="Hide document" 
                                                    style="width: 36px; height: 36px; padding: 0; margin: 0; border: 1px solid; line-height: 1;"
                                                    onclick="hideDocumentCard(event);">
                                                <i class="fas fa-ellipsis-h" style="font-size: 0.875rem; line-height: 1;"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Document Icon and Content -->
                                <div class="d-flex align-items-start mb-3">
                                    @{
                                        string iconClass = "fas fa-file";
                                        string iconBgColor = "bg-primary bg-opacity-10";
                                        string iconTextColor = "text-primary";
                                        
                                        if (doc.SourceType == Certio.Domain.Documents.DocumentSourceType.GoogleDrive)
                                        {
                                            iconClass = "fab fa-google";
                                            iconBgColor = "bg-light";
                                            iconTextColor = "";
                                            // Google colors: #4285f4 (blue), #34a853 (green), #fbbc04 (yellow), #ea4335 (red)
                                            // Using a gradient-like approach with the primary blue
                                        }
                                        else if (doc.SourceType == Certio.Domain.Documents.DocumentSourceType.OneDrive)
                                        {
                                            iconClass = "fab fa-windows";
                                            iconBgColor = "bg-light";
                                            iconTextColor = "";
                                            // Microsoft blue: #0078d4
                                        }
                                    }
                                    <div class="p-3 @iconBgColor rounded-3 me-3 flex-shrink-0">
                                        @if (doc.SourceType == Certio.Domain.Documents.DocumentSourceType.GoogleDrive)
                                        {
                                            <i class="@iconClass" style="font-size: 1.5rem; color: #4285f4;"></i>
                                        }
                                        else if (doc.SourceType == Certio.Domain.Documents.DocumentSourceType.OneDrive)
                                        {
                                            <i class="@iconClass" style="font-size: 1.5rem; color: #0078d4;"></i>
                                        }
                                        else
                                        {
                                            <i class="@iconClass @iconTextColor" style="font-size: 1.5rem;"></i>
                                        }
                                    </div>
                                    <div class="flex-grow-1 min-width-0">
                                        <h5 class="fw-bold text-dark mb-1" style="font-size: 1.1rem; line-height: 1.3;">@doc.Name</h5>
                                        <div class="d-flex align-items-center text-muted small mb-2" style="font-size: 0.85rem;">
                                            <i class="fas fa-folder me-2" style="font-size: 0.75rem;"></i>
                                            <span>@location</span>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Client Name Badge (if exists) -->
                                @if (doc.Metadata != null && doc.Metadata.TryGetValue("clientName", out var clientName) && !string.IsNullOrWhiteSpace(clientName))
                                {
                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                        <span class="badge bg-secondary" style="font-size: 0.6rem;">@clientName</span>
                                    </div>
                                }
                                
                                <!-- Metadata -->
                                <div class="border-top pt-3">
                                    <div class="d-flex flex-wrap align-items-center gap-3 text-muted small" style="font-size: 0.8rem;">
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-user me-2"></i>
                                            <span>@doc.Author</span>
                                        </div>
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-calendar me-2"></i>
                                            <span>Modified @doc.Modified.ToString("yyyy-MM-dd")</span>
                                        </div>
                                        <div class="d-flex align-items-center">
                                            <i class="@GetVisibilityIcon(visibility) me-2"></i>
                                            <span>@visibility</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(fileSize))
                                        {
                                            <div class="d-flex align-items-center">
                                                <span>@fileSize</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                }
                <!-- Loading indicator for lazy loading -->
                <div id="documentsLoadingIndicator" class="text-center py-4" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="text-muted mt-2">Loading more documents...</p>
                </div>
                <div id="documentsLazyLoadSentinel" style="height: 1px;"></div>
                <!-- Empty state -->
                <div id="documentsEmptyState" class="text-center py-5" style="display: none;">
                    <i class="fas fa-folder-open fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No documents found</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Horizontal scroll on mouse wheel for matters container
        document.addEventListener('DOMContentLoaded', function() {
            const mattersContainer = document.querySelector('.matters-scroll-container');
            if (mattersContainer) {
                mattersContainer.addEventListener('wheel', function(e) {
                    if (e.deltaY !== 0) {
                        e.preventDefault();
                        this.scrollLeft += e.deltaY;
                    }
                }, { passive: false });
            }

            // Setup document OAuth event listeners and load status
            setupDocumentOAuthListeners();
            loadDocumentConnectionStatus();
            
            // Initialize lazy loading for documents
            initDocumentsLazyLoading();

            // Attach status badge click handlers
            attachDocumentStatusHandlers();

            // Restore hidden documents from localStorage
            restoreHiddenDocuments();
        });

        // Load document connection status
        async function loadDocumentConnectionStatus() {
            try {
                const orgId = getCurrentOrganizationId();
                const url = orgId ? `/api/drive-oauth/status?orgId=${orgId}` : '/api/drive-oauth/status';
                
                const response = await fetch(url);
                const result = await response.json();
                
                if (result.success) {
                    updateDocumentStatusUI(result);
                }
            } catch (error) {
                console.error('Error loading document connection status:', error);
            }
        }

        // Update document status UI
        function updateDocumentStatusUI(status) {
            const notConnectedDiv = document.getElementById('documentIntegrationsNotConnected');
            const connectedDiv = document.getElementById('documentIntegrationsConnected');
            const googleStatusDiv = document.getElementById('googleDriveStatus');
            const oneDriveStatusDiv = document.getElementById('oneDriveStatus');
            const connectGoogleBtn = document.getElementById('connectGoogleDriveBtnConnected');
            const connectOneDriveBtn = document.getElementById('connectOneDriveBtnConnected');
            const googleEmailSpan = document.getElementById('googleDriveEmail');
            const oneDriveEmailSpan = document.getElementById('oneDriveEmail');

            const googleConnected = status.googleDrive?.connected || false;
            const oneDriveConnected = status.oneDrive?.connected || false;

            if (googleConnected || oneDriveConnected) {
                // Show connected state
                if (notConnectedDiv) notConnectedDiv.style.display = 'none';
                if (connectedDiv) connectedDiv.style.display = 'block';

                // Show Google Drive status if connected
                if (googleStatusDiv) {
                    googleStatusDiv.style.display = googleConnected ? 'block' : 'none';
                }
                if (googleEmailSpan && status.googleDrive?.email) {
                    googleEmailSpan.textContent = status.googleDrive.email;
                }
                if (connectGoogleBtn) {
                    connectGoogleBtn.style.display = googleConnected ? 'none' : 'block';
                }

                // Show OneDrive status if connected
                if (oneDriveStatusDiv) {
                    oneDriveStatusDiv.style.display = oneDriveConnected ? 'block' : 'none';
                }
                if (oneDriveEmailSpan && status.oneDrive?.email) {
                    oneDriveEmailSpan.textContent = status.oneDrive.email;
                }
                if (connectOneDriveBtn) {
                    connectOneDriveBtn.style.display = oneDriveConnected ? 'none' : 'block';
                }
            } else {
                // Show not connected state
                if (notConnectedDiv) notConnectedDiv.style.display = 'block';
                if (connectedDiv) connectedDiv.style.display = 'none';
            }
        }

        // Setup document OAuth event listeners
        function setupDocumentOAuthListeners() {
            // Connect buttons (not connected state)
            const connectGoogleDriveBtn = document.getElementById('connectGoogleDriveBtn');
            const connectOneDriveBtn = document.getElementById('connectOneDriveBtn');

            if (connectGoogleDriveBtn) {
                connectGoogleDriveBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    connectDocumentProvider('google');
                });
            }

            if (connectOneDriveBtn) {
                connectOneDriveBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    connectDocumentProvider('onedrive');
                });
            }

            // Connect buttons (connected state - for adding additional provider)
            const connectGoogleDriveBtnConnected = document.getElementById('connectGoogleDriveBtnConnected');
            const connectOneDriveBtnConnected = document.getElementById('connectOneDriveBtnConnected');

            if (connectGoogleDriveBtnConnected) {
                connectGoogleDriveBtnConnected.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    connectDocumentProvider('google');
                });
            }

            if (connectOneDriveBtnConnected) {
                connectOneDriveBtnConnected.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    connectDocumentProvider('onedrive');
                });
            }

            // Disconnect buttons
            const disconnectGoogleDriveBtn = document.getElementById('disconnectGoogleDriveBtn');
            const disconnectOneDriveBtn = document.getElementById('disconnectOneDriveBtn');

            // Refresh documents button (next to Date Range)
            const refreshDocumentsBtn = document.getElementById('refreshDocumentsBtn');
            if (refreshDocumentsBtn) {
                refreshDocumentsBtn.addEventListener('click', async function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    await refreshDocuments();
                });
            }

            if (disconnectGoogleDriveBtn) {
                disconnectGoogleDriveBtn.addEventListener('click', async function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (confirm('Are you sure you want to disconnect Google Drive? This will stop syncing documents from Google Drive.')) {
                        await disconnectDocumentProvider('google');
                    }
                });
            }

            if (disconnectOneDriveBtn) {
                disconnectOneDriveBtn.addEventListener('click', async function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (confirm('Are you sure you want to disconnect OneDrive? This will stop syncing documents from OneDrive.')) {
                        await disconnectDocumentProvider('onedrive');
                    }
                });
            }

            // Listen for OAuth callback messages
            window.addEventListener('message', function(event) {
                // Verify origin
                if (event.origin !== window.location.origin) {
                    return;
                }

                if (event.data.type === 'document-oauth-success') {
                    console.log(`Successfully connected ${event.data.provider} for documents`);
                    // Reload status to update UI immediately (no page reload needed)
                    loadDocumentConnectionStatus();
                    // Show success message
                    alert(`${event.data.provider} connected successfully! Your documents will sync automatically. Documents may take a few moments to appear.`);
                } else if (event.data.type === 'document-oauth-error') {
                    const errorMsg = event.data.errorDescription || event.data.error || 'Unknown error occurred';
                    console.error(`Failed to connect ${event.data.provider}:`, errorMsg);
                    alert(`Failed to connect ${event.data.provider}: ${errorMsg}`);
                }
            });
        }

        // Disconnect document provider
        async function disconnectDocumentProvider(provider) {
            console.log(`Disconnecting document provider: ${provider}`);
            try {
                const orgId = getCurrentOrganizationId();
                const url = `/api/drive-oauth/${provider === 'google' ? 'google' : 'onedrive'}${orgId ? `?orgId=${orgId}` : ''}`;
                
                const response = await fetch(url, {
                    method: 'DELETE'
                });
                const result = await response.json();
                
                if (result.success) {
                    console.log(`Successfully disconnected ${provider}`);
                    // Reload status to update UI
                    loadDocumentConnectionStatus();
                    alert(`${provider === 'google' ? 'Google Drive' : 'OneDrive'} disconnected successfully.`);
                    // Refresh page to update document list
                    window.location.reload();
                } else {
                    console.error(`Failed to disconnect ${provider}:`, result.error);
                    alert(`Failed to disconnect ${provider}: ${result.error || 'Unknown error'}`);
                }
            } catch (error) {
                console.error(`Error disconnecting ${provider}:`, error);
                alert(`Failed to disconnect ${provider}. Please try again.`);
            }
        }

        // Refresh documents - syncs all connected providers and reloads page
        async function refreshDocuments() {
            console.log('Refreshing documents...');
            try {
                const orgId = getCurrentOrganizationId();
                const url = `/api/drive-oauth/sync${orgId ? `?orgId=${orgId}` : ''}`;
                
                // Disable button and show loading state
                const refreshBtn = document.getElementById('refreshDocumentsBtn');
                if (refreshBtn) {
                    refreshBtn.disabled = true;
                    const icon = refreshBtn.querySelector('i');
                    if (icon) {
                        icon.classList.add('fa-spin');
                    }
                }
                
                const response = await fetch(url, {
                    method: 'POST'
                });
                const result = await response.json();
                
                if (result.success) {
                    // Wait a bit for sync to process, then reload
                    setTimeout(() => {
                        window.location.reload();
                    }, 3000);
                } else {
                    // Re-enable button on error
                    if (refreshBtn) {
                        refreshBtn.disabled = false;
                        const icon = refreshBtn.querySelector('i');
                        if (icon) {
                            icon.classList.remove('fa-spin');
                        }
                    }
                    alert(`Failed to start sync: ${result.error || 'Unknown error'}`);
                }
            } catch (error) {
                console.error('Error refreshing documents:', error);
                const refreshBtn = document.getElementById('refreshDocumentsBtn');
                if (refreshBtn) {
                    refreshBtn.disabled = false;
                    const icon = refreshBtn.querySelector('i');
                    if (icon) {
                        icon.classList.remove('fa-spin');
                    }
                }
                alert('Failed to refresh documents. Please try again.');
            }
        }

        // Connect document provider (Google Drive or OneDrive)
        async function connectDocumentProvider(provider) {
            console.log(`Connecting document provider: ${provider}`);
            try {
                // Get orgId from URL path (/Client/{orgId}/...)
                const orgId = getCurrentOrganizationId();
                
                // Build authorize URL with orgId query parameter
                const authorizeUrl = `/api/drive-oauth/${provider === 'google' ? 'google' : 'onedrive'}/authorize`;
                const urlWithOrgId = orgId ? `${authorizeUrl}?orgId=${orgId}` : authorizeUrl;

                console.log(`Fetching authorization URL for ${provider} with orgId: ${orgId}...`);
                const response = await fetch(urlWithOrgId);
                const result = await response.json();

                console.log(`Authorization response:`, result);

                if (result.success && result.authorizationUrl) {
                    console.log(`Opening OAuth popup with URL: ${result.authorizationUrl}`);
                    // Open OAuth popup
                    const popup = window.open(result.authorizationUrl, 'Document OAuth', 'width=600,height=700');

                    if (!popup) {
                        alert('Please allow popups for this site to connect your document storage.');
                        return;
                    }

                    console.log('OAuth popup opened, waiting for callback...');

                    // Fallback: check if popup closed (in case postMessage doesn't work)
                    const checkInterval = setInterval(() => {
                        if (popup.closed) {
                            clearInterval(checkInterval);
                            console.log('OAuth popup closed');
                        }
                    }, 1000);
                } else {
                    console.error('Failed to get authorization URL:', result);
                    alert(`Failed to get authorization URL: ${result.error || 'Unknown error'}`);
                }
            } catch (error) {
                console.error(`Error connecting ${provider}:`, error);
                alert(`Failed to connect ${provider}. Please try again.`);
            }
        }

        // Get current organization ID from URL path
        function getCurrentOrganizationId() {
            // Try to get from URL path (/Client/{orgId}/...)
            const pathMatch = window.location.pathname.match(/\/Client\/(\d+)/);
            if (pathMatch && pathMatch[1]) {
                return parseInt(pathMatch[1], 10);
            }
            return null;
        }

        // Download document function
        async function downloadDocument(docId) {
            try {
                const orgId = getCurrentOrganizationId();
                const url = `/api/documents/${docId}/download${orgId ? `?orgId=${orgId}` : ''}`;
                
                const response = await fetch(url, {
                    method: 'GET',
                    credentials: 'include'
                });
                
                if (response.ok) {
                    const blob = await response.blob();
                    const downloadUrl = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = downloadUrl;
                    a.download = response.headers.get('Content-Disposition')?.split('filename=')[1]?.replace(/"/g, '') || 'document';
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(downloadUrl);
                    document.body.removeChild(a);
                } else {
                    alert('Failed to download document. Please try again.');
                }
            } catch (error) {
                console.error('Error downloading document:', error);
                alert('Failed to download document. Please try again.');
            }
        }

        // Removed inline viewer functions - documents now open in separate page
        /*
