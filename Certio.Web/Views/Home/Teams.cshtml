@model Certio.Web.ViewModels.TeamsViewModel
@{
    ViewData["Title"] = "Teams";
    Layout = "_ClientLayout";
}

<div class="min-h-screen">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="display-6 fw-bold mb-2">Teams</h1>
            <p class="lead text-muted">
                Manage team members across all matter stakeholders
            </p>
        </div>
        <a class="btn btn-primary d-flex align-items-center gap-2" asp-controller="Client" asp-action="AddPeople" asp-route-orgId="@ViewBag.OrganizationId">
            <i class="fas fa-user-plus"></i>
            Add people
        </a>
    </div>

    <!-- Search and Filters -->
    <div class="row mb-4">
        <div class="col-md-8">
            <div class="search-container">
                <i class="fas fa-search"></i>
                <input type="text" class="form-control" placeholder="Search by name or role..." />
            </div>
        </div>
        <div class="col-md-4">
            <div class="filter-buttons">
                <div class="dropdown d-inline-block me-2">
                    <button class="filter-button dropdown-toggle" type="button" id="teamsFilterBtn" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-filter"></i>
                        <span id="teamsFilterLabel">All Team Members</span>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="teamsFilterBtn">
                        <li><a class="dropdown-item teams-filter-option" href="#" data-filter="all">All Team Members</a></li>
                        <li><a class="dropdown-item teams-filter-option" href="#" data-filter="client">Client Team</a></li>
                        <li><a class="dropdown-item teams-filter-option" href="#" data-filter="legal">Legal Team</a></li>
                        <li><a class="dropdown-item teams-filter-option" href="#" data-filter="external">External Team</a></li>
                    </ul>
                </div>
                <div class="dropdown d-inline-block">
                    <button class="filter-button dropdown-toggle" type="button" id="teamsDateFilterBtn" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-calendar"></i>
                        <span id="teamsDateFilterLabel">All Time</span>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="teamsDateFilterBtn">
                        <li><a class="dropdown-item teams-date-option" href="#" data-date-range="all-time">All Time</a></li>
                        <li><a class="dropdown-item teams-date-option" href="#" data-date-range="last-30-days">Last 30 Days</a></li>
                        <li><a class="dropdown-item teams-date-option" href="#" data-date-range="last-90-days">Last 90 Days</a></li>
                        <li><a class="dropdown-item teams-date-option" href="#" data-date-range="this-year">This Year</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Matters Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center">
                    <h5 class="fw-bold text-dark mb-0 me-2">Matters</h5>
                    <i class="fas fa-chevron-down text-muted"></i>
                </div>
                <div class="search-container" style="max-width: 300px;">
                    <i class="fas fa-search"></i>
                    <input type="text" class="form-control" placeholder="Search matters..." />
                </div>
            </div>
            <div class="matters-scroll-container" style="overflow-x: auto; overflow-y: hidden; margin: 0 -0.75rem; padding:0.75rem;">
                <div class="d-flex" style="min-width: min-content; gap: 1rem;">
                    @if (Model.Matters != null && Model.Matters.Any())
                    {
                        @foreach (var matter in Model.Matters)
                        {
                            var statusIcon = matter.Status switch
                            {
                                "Completed" => "fas fa-check-circle text-success",
                                "In Progress" => "fas fa-play-circle text-primary",
                                "Review" => "fas fa-exclamation-circle text-warning",
                                "Planning" => "fas fa-clock text-muted",
                                _ => "fas fa-circle text-secondary"
                            };
                            
                            var statusBadgeClass = matter.Status switch
                            {
                                "Completed" => "bg-success text-white",
                                "In Progress" => "bg-primary text-white",
                                "Review" => "bg-warning text-dark",
                                "Planning" => "bg-secondary text-white",
                                _ => "bg-secondary text-white"
                            };
                            
                            <a href="/Client/@ViewBag.OrganizationId/Matter/@matter.Id" class="text-decoration-none" style="flex: 0 0 14rem;">
                                <div class="card matter-folder-card border-0 h-100">
                                    <div class="card-body">
                                        <div class="matter-folder-content">
                                            <div class="me-3">
                                                <i class="fas fa-folder text-muted fs-4"></i>
                                            </div>
                                            <div class="flex-grow-1 min-width-0">
                                                <h6 class="fw-semibold text-dark mb-0" style="max-width: 200px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.3;">@matter.Title</h6>
                                                <div class="d-flex align-items-baseline gap-2">
                                                    <i class="@statusIcon" style="font-size: 0.75rem;"></i>
                                                    <span class="badge @statusBadgeClass" style="font-size: 0.65rem; padding: 0.2rem 0.5rem; line-height: 1.3;">@matter.Status</span>
                                                </div>
                                            </div>
                                            <div class="ms-2">
                                                <i class="fas fa-ellipsis-v text-muted"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 w-100">
                            <p class="text-muted">No matters available</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Team Sections -->
    <div id="teamsContainer">
        @foreach (var teamType in Enum.GetValues<Certio.Web.ViewModels.TeamType>())
        {
            var teamMembers = Model.TeamMembers.Where(m => m.Team == teamType).ToList();
            if (teamMembers.Any())
            {
                <div class="mb-5 team-section" data-team="@teamType.ToString().ToLower()">
                    <div class="team-section-header">
                        @{
                            var teamIcon = teamType switch
                            {
                                Certio.Web.ViewModels.TeamType.Client => "fas fa-users",
                                Certio.Web.ViewModels.TeamType.Legal => "fa-solid fa-building-columns",
                                Certio.Web.ViewModels.TeamType.External => "fas fa-user",
                                _ => "fas fa-users"
                            };
                            var teamTitle = teamType switch
                            {
                                Certio.Web.ViewModels.TeamType.Client => "Client Team",
                                Certio.Web.ViewModels.TeamType.Legal => "Legal Team",
                                Certio.Web.ViewModels.TeamType.External => "External (Other Parties)",
                                _ => ""
                            };
                        }
                        <i class="@teamIcon"></i>
                        <h2>@teamTitle</h2>
                        <span class="team-badge">@teamMembers.Count</span>
                    </div>
                    
                    <div class="row g-4">
                        @foreach (var member in teamMembers)
                        {
                            <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2 team-member-card" data-name="@member.Name.ToLower()" data-role="@member.Role.ToLower()" data-team="@member.Team.ToString().ToLower()">
                                <div class="card h-100 border-0  hover-shadow transition-smooth cursor-pointer">
                                    <div class="card-body d-flex flex-column align-items-center text-center p-4">
                                        <!-- Avatar -->
                                        <div class="mb-3">
                                            <div class="team-member-avatar" 
                                                 style="background-color: @(member.Team == Certio.Web.ViewModels.TeamType.Legal ? "#3d1019" : (member.Team == Certio.Web.ViewModels.TeamType.Client ? "#69848C" : member.Color));">
                                                @member.Initials
                                            </div>
                                        </div>
                                        
                                        <!-- Name and Role -->
                                        <h5 class="card-title fw-medium mb-1">@member.Name</h5>
                                        <p class="text-muted small mb-3">@member.Role</p>
                                        
                                        <!-- Team Type -->
                                        <div class="d-flex align-items-center gap-1 text-muted small">
                                            <i class="fas fa-briefcase" style="font-size: 0.75rem;"></i>
                                            <span>@member.Team</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Add People Modal -->
<div class="modal fade" id="addPeopleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add People</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label for="memberName" class="form-label">Name</label>
                        <input type="text" class="form-control" id="memberName" required>
                    </div>
                    <div class="mb-3">
                        <label for="memberRole" class="form-label">Role</label>
                        <input type="text" class="form-control" id="memberRole" required>
                    </div>
                    <div class="mb-3">
                        <label for="memberDepartment" class="form-label">Department</label>
                        <input type="text" class="form-control" id="memberDepartment">
                    </div>
                    <div class="mb-3">
                        <label for="memberTeam" class="form-label">Team</label>
                        <select class="form-select" id="memberTeam" required>
                            <option value="">Select Team</option>
                            <option value="Client">Client Team</option>
                            <option value="Legal">Legal Team</option>
                            <option value="External">External (Other Parties)</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary">Add Member</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('teamSearchInput');
            const teamMemberCards = Array.from(document.querySelectorAll('.team-member-card'));
            const teamSections = Array.from(document.querySelectorAll('.team-section'));
            const teamFilterLabel = document.getElementById('teamsFilterLabel');
            const teamDateFilterLabel = document.getElementById('teamsDateFilterLabel');

            const teamFilterLabels = {
                'all': 'All Team Members',
                'client': 'Client Team',
                'legal': 'Legal Team',
                'external': 'External Team'
            };

            const teamDateLabels = {
                'all-time': 'All Time',
                'last-30-days': 'Last 30 Days',
                'last-90-days': 'Last 90 Days',
                'this-year': 'This Year'
            };

            let currentTeamFilter = 'all';
            let currentTeamDateRange = 'all-time';
            let currentTeamSearchTerm = '';

            function updateTeamVisibility() {
                teamSections.forEach(section => {
                    const cards = Array.from(section.querySelectorAll('.team-member-card'));
                    let visibleCount = 0;

                    cards.forEach(card => {
                        const team = (card.dataset.team || '').toLowerCase();
                        const name = card.dataset.name || '';
                        const role = card.dataset.role || '';

                        const matchesTeam = currentTeamFilter === 'all' || team === currentTeamFilter;
                        const matchesSearch = !currentTeamSearchTerm || name.includes(currentTeamSearchTerm) || role.includes(currentTeamSearchTerm);

                        const shouldShow = matchesTeam && matchesSearch;
                        card.style.display = shouldShow ? '' : 'none';
                        if (shouldShow) {
                            visibleCount++;
                        }
                    });

                    section.style.display = visibleCount > 0 ? '' : 'none';
                });
            }

            function applyTeamFilter(filter) {
                currentTeamFilter = filter;
                if (teamFilterLabel) {
                    teamFilterLabel.textContent = teamFilterLabels[filter] || 'Filter';
                }
                updateTeamVisibility();

                document.dispatchEvent(new CustomEvent('teams:filterChanged', {
                    detail: { filter }
                }));
            }

            function applyTeamDateRange(range, skipEvent = false) {
                currentTeamDateRange = range;
                if (teamDateFilterLabel) {
                    teamDateFilterLabel.textContent = teamDateLabels[range] || 'Date Range';
                }

                if (!skipEvent) {
                    document.dispatchEvent(new CustomEvent('teams:dateRangeChanged', {
                        detail: { range }
                    }));
                }
            }

            // Horizontal scroll on mouse wheel for matters container
            const mattersContainer = document.querySelector('.matters-scroll-container');
            if (mattersContainer) {
                mattersContainer.addEventListener('wheel', function(e) {
                    if (e.deltaY !== 0) {
                        e.preventDefault();
                        this.scrollLeft += e.deltaY;
                    }
                }, { passive: false });
            }

            // Search functionality
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    currentTeamSearchTerm = this.value.toLowerCase();
                    updateTeamVisibility();
                });
            }

            document.querySelectorAll('.teams-filter-option').forEach(option => {
                option.addEventListener('click', function(e) {
                    e.preventDefault();
                    applyTeamFilter(this.dataset.filter || 'all');
                });
            });

            document.querySelectorAll('.teams-date-option').forEach(option => {
                option.addEventListener('click', function(e) {
                    e.preventDefault();
                    applyTeamDateRange(this.dataset.dateRange || 'all-time');
                });
            });

            // Add hover effects
            teamMemberCards.forEach(card => {
                card.addEventListener('mouseenter', function() {
                    this.classList.add('shadow-lg');
                });
                
                card.addEventListener('mouseleave', function() {
                    this.classList.remove('shadow-lg');
                });
            });

            // Initialize filters
            applyTeamFilter('all');
            applyTeamDateRange('all-time', true);
        });
    </script>
}

<style>
    .hover-shadow {
        transition: box-shadow 0.2s ease-in-out;
    }
    
    .hover-shadow:hover {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
    
    .cursor-pointer {
        cursor: pointer;
    }
    
    .transition-smooth {
        transition: all 0.2s ease-in-out;
    }
    
    .team-member-card .card {
        border-radius: 12px;
    }
    
    .team-member-card .card-body {
        border-radius: 12px;
    }
</style>
