@model Certio.Web.ViewModels.TeamsViewModel
@{
    ViewData["Title"] = "Teams";
    Layout = "_ClientLayout";
}

<div class="min-h-screen">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="display-6 fw-bold mb-2">People</h1>
            <p class="lead text-muted">
                Manage team members across all project stakeholders
            </p>
        </div>
        <a class="btn btn-primary d-flex align-items-center gap-2" asp-controller="Home" asp-action="AddPeople">
            <i class="fas fa-user-plus"></i>
            Add people
        </a>
    </div>

    <!-- Search and Filters -->
    <div class="row mb-4">
        <div class="col-md-8">
            <div class="search-container">
                <i class="fas fa-search"></i>
                <input type="text" class="form-control" placeholder="Search by name or role..." />
            </div>
        </div>
        <div class="col-md-4">
            <div class="filter-buttons">
                <button class="filter-button">
                    <i class="fas fa-filter"></i>
                    Filter
                </button>
                <button class="filter-button">
                    <i class="fas fa-calendar"></i>
                    Date Range
                </button>
            </div>
        </div>
    </div>

    <!-- Projects Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center">
                    <h5 class="fw-bold text-dark mb-0 me-2">Projects</h5>
                    <i class="fas fa-chevron-down text-muted"></i>
                </div>
                <div class="search-container" style="max-width: 300px;">
                    <i class="fas fa-search"></i>
                    <input type="text" class="form-control" placeholder="Search projects..." />
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-6 col-lg-3">
                    <div class="card project-folder-card border-0 ">
                        <div class="card-body">
                            <div class="project-folder-content">
                                <div class="flex-grow-1" style="padding-left: 0.3rem;">
                                    <h6 class="fw-semibold text-dark mb-0">Contract Review Automation</h6>
                                    <div class="d-flex align-items-baseline gap-2">
                                        <i class="fas fa-play-circle text-primary" style="font-size: 0.75rem;"></i>
                                        <span class="badge bg-primary text-white" style="font-size: 0.65rem; padding: 0.2rem 0.5rem; line-height: 1.3;">In Progress</span>
                                    </div>
                                </div>
                                <div class="ms-2">
                                    <i class="fas fa-ellipsis-v text-muted"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="card project-folder-card border-0 ">
                        <div class="card-body">
                            <div class="project-folder-content">
                                <div class="flex-grow-1" style="padding-left: 0.3rem;">
                                    <h6 class="fw-semibold text-dark mb-0">Client Portal Dashboard</h6>
                                    <div class="d-flex align-items-baseline gap-2">
                                        <i class="fas fa-exclamation-circle text-warning" style="font-size: 0.75rem;"></i>
                                        <span class="badge bg-warning text-dark" style="font-size: 0.65rem; padding: 0.2rem 0.5rem; line-height: 1.3;">Review</span>
                                    </div>
                                </div>
                                <div class="ms-2">
                                    <i class="fas fa-ellipsis-v text-muted"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="card project-folder-card border-0 ">
                        <div class="card-body">
                            <div class="project-folder-content">
                                <div class="flex-grow-1" style="padding-left: 0.3rem;">
                                    <h6 class="fw-semibold text-dark mb-0">Compliance Tracking System</h6>
                                    <div class="d-flex align-items-baseline gap-2">
                                        <i class="fas fa-clock text-muted" style="font-size: 0.75rem;"></i>
                                        <span class="badge bg-secondary text-white" style="font-size: 0.65rem; padding: 0.2rem 0.5rem; line-height: 1.3;">Planning</span>
                                    </div>
                                </div>
                                <div class="ms-2">
                                    <i class="fas fa-ellipsis-v text-muted"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="card project-folder-card border-0 ">
                        <div class="card-body">
                            <div class="project-folder-content">
                                <div class="flex-grow-1" style="padding-left: 0.3rem;">
                                    <h6 class="fw-semibold text-dark mb-0">Legal Research Assistant</h6>
                                    <div class="d-flex align-items-baseline gap-2">
                                        <i class="fas fa-check-circle text-success" style="font-size: 0.75rem;"></i>
                                        <span class="badge bg-success text-white" style="font-size: 0.65rem; padding: 0.2rem 0.5rem; line-height: 1.3;">Completed</span>
                                    </div>
                                </div>
                                <div class="ms-2">
                                    <i class="fas fa-ellipsis-v text-muted"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Team Sections -->
    <div id="teamsContainer">
        @foreach (var teamType in Enum.GetValues<Certio.Web.ViewModels.TeamType>())
        {
            var teamMembers = Model.TeamMembers.Where(m => m.Team == teamType).ToList();
            if (teamMembers.Any())
            {
                <div class="mb-5 team-section" data-team="@teamType.ToString().ToLower()">
                    <div class="team-section-header">
                        @{
                            var teamIcon = teamType switch
                            {
                                Certio.Web.ViewModels.TeamType.Client => "fas fa-building",
                                Certio.Web.ViewModels.TeamType.Legal => "fas fa-users",
                                Certio.Web.ViewModels.TeamType.External => "fas fa-user",
                                _ => "fas fa-users"
                            };
                            var teamTitle = teamType switch
                            {
                                Certio.Web.ViewModels.TeamType.Client => "Client Team",
                                Certio.Web.ViewModels.TeamType.Legal => "Legal Team",
                                Certio.Web.ViewModels.TeamType.External => "External (Other Parties)",
                                _ => ""
                            };
                        }
                        <i class="@teamIcon"></i>
                        <h2>@teamTitle</h2>
                        <span class="team-badge">@teamMembers.Count</span>
                    </div>
                    
                    <div class="row g-4">
                        @foreach (var member in teamMembers)
                        {
                            <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2 team-member-card" data-name="@member.Name.ToLower()" data-role="@member.Role.ToLower()">
                                <div class="card h-100 border-0  hover-shadow transition-smooth cursor-pointer">
                                    <div class="card-body d-flex flex-column align-items-center text-center p-4">
                                        <!-- Avatar -->
                                        <div class="mb-3">
                                            <div class="team-member-avatar" 
                                                 style="background-color: @member.Color;">
                                                @member.Initials
                                            </div>
                                        </div>
                                        
                                        <!-- Name and Role -->
                                        <h5 class="card-title fw-medium mb-1">@member.Name</h5>
                                        <p class="text-muted small mb-3">@member.Role</p>
                                        
                                        <!-- Team Type -->
                                        <div class="d-flex align-items-center gap-1 text-muted small">
                                            <i class="fas fa-briefcase" style="font-size: 0.75rem;"></i>
                                            <span>@member.Team</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Add People Modal -->
<div class="modal fade" id="addPeopleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add People</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label for="memberName" class="form-label">Name</label>
                        <input type="text" class="form-control" id="memberName" required>
                    </div>
                    <div class="mb-3">
                        <label for="memberRole" class="form-label">Role</label>
                        <input type="text" class="form-control" id="memberRole" required>
                    </div>
                    <div class="mb-3">
                        <label for="memberDepartment" class="form-label">Department</label>
                        <input type="text" class="form-control" id="memberDepartment">
                    </div>
                    <div class="mb-3">
                        <label for="memberTeam" class="form-label">Team</label>
                        <select class="form-select" id="memberTeam" required>
                            <option value="">Select Team</option>
                            <option value="Client">Client Team</option>
                            <option value="Legal">Legal Team</option>
                            <option value="External">External (Other Parties)</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary">Add Member</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const teamMemberCards = document.querySelectorAll('.team-member-card');
            const teamSections = document.querySelectorAll('.team-section');

            // Search functionality
            searchInput.addEventListener('input', function() {
                const searchTerm = this.value.toLowerCase();
                
                teamMemberCards.forEach(card => {
                    const name = card.dataset.name || '';
                    const role = card.dataset.role || '';
                    
                    if (name.includes(searchTerm) || role.includes(searchTerm)) {
                        card.style.display = 'block';
                    } else {
                        card.style.display = 'none';
                    }
                });

                // Hide team sections that have no visible members
                teamSections.forEach(section => {
                    const visibleMembers = section.querySelectorAll('.team-member-card[style*="display: block"], .team-member-card:not([style*="display: none"])');
                    if (visibleMembers.length === 0) {
                        section.style.display = 'none';
                    } else {
                        section.style.display = 'block';
                    }
                });
            });

            // Add hover effects
            teamMemberCards.forEach(card => {
                card.addEventListener('mouseenter', function() {
                    this.classList.add('shadow-lg');
                });
                
                card.addEventListener('mouseleave', function() {
                    this.classList.remove('shadow-lg');
                });
            });
        });
    </script>
}

<style>
    .hover-shadow {
        transition: box-shadow 0.2s ease-in-out;
    }
    
    .hover-shadow:hover {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
    
    .cursor-pointer {
        cursor: pointer;
    }
    
    .transition-smooth {
        transition: all 0.2s ease-in-out;
    }
    
    .team-member-card .card {
        border-radius: 12px;
    }
    
    .team-member-card .card-body {
        border-radius: 12px;
    }
</style>
