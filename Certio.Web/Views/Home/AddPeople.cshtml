@model Certio.Web.ViewModels.AddPeopleFormViewModel
@{
    ViewData["Title"] = "Add People";
    Layout = "_ClientLayout";

    // Determine if this is an EventPlanner organization for conditional text
    var orgType = ViewBag.OrganizationType ?? OrganizationType.LawFirm;
    var isEventPlanner = orgType == OrganizationType.EventPlanner;
    var serviceProviderType = isEventPlanner ? "event planning company" : "law firm";
    var serviceProviderTypeCapitalized = isEventPlanner ? "Event Planning Company" : "Law Firm";
    var teamMemberType = isEventPlanner ? "planners, coordinators, or staff" : "attorneys, paralegals, or staff members";

    var generatedJoinCode = TempData["JoinCode"] as string;
    var generatedJoinCodeEmail = TempData["JoinCodeEmail"] as string;
    var joinCodeInviteeName = TempData["JoinCodeInviteeName"] as string;
    var joinCodeInviteeRole = TempData["JoinCodeInviteeRole"] as string;
    var joinCodeInviteeUserType = TempData["JoinCodeInviteeUserType"] as string;
    var joinCodeInviteeRoleDisplay = string.IsNullOrWhiteSpace(joinCodeInviteeRole)
        ? string.Empty
        : System.Text.RegularExpressions.Regex.Replace(joinCodeInviteeRole, "(?<=[a-z])(?=[A-Z])", " ");
    var joinCodeSuccessMessage = TempData["JoinCodeSuccess"] as string ?? TempData["Success"] as string;
    var joinCodeOrganizationType = TempData["JoinCodeOrganizationType"] as string;
    var joinCodeLawFirmOrgIdValue = TempData["JoinCodeLawFirmOrgId"]?.ToString();
    var joinCodeClientOrgIdValue = TempData["JoinCodeClientOrgId"]?.ToString();
    var hasGeneratedJoinCode = !string.IsNullOrWhiteSpace(generatedJoinCode);
    var joinCodeInviteeDisplayName = !string.IsNullOrWhiteSpace(joinCodeInviteeName) ? joinCodeInviteeName : generatedJoinCodeEmail;
    _ = int.TryParse(joinCodeLawFirmOrgIdValue, out var joinCodeLawFirmOrgId);
    _ = int.TryParse(joinCodeClientOrgIdValue, out var joinCodeClientOrgId);
}

<div class="min-h-screen py-8">
    <div class="container-fluid">
        <div class="mb-4">
            <a href="@Url.Action("Teams", "Client", new { orgId = ViewBag.OrganizationId ?? 0 })" class="btn btn-ghost d-flex align-items-center gap-2 text-decoration-none">
                <i class="fas fa-arrow-left"></i>
                Back to Teams
            </a>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @if (!hasGeneratedJoinCode && !string.IsNullOrWhiteSpace(joinCodeSuccessMessage))
        {
            <div class="alert alert-success">@joinCodeSuccessMessage</div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info">@TempData["Info"]</div>
        }

        @if (Model.IsLawFirmUser && Model.IsClientOrganization)
        {
            <!-- Law Firm User in Client Organization (2-Step Wizard) -->
            @if (Model.Step == 1)
            {
                <!-- Step 1: Card Selection -->
                <div class="row">
                    <div class="col-lg-10 mx-auto">
                        <div class="text-center mb-5">
                            <h1 class="display-6 fw-bold text-dark mb-2">Add People to @ViewBag.OrganizationName</h1>
                            <p class="lead text-muted" style="font-size: 1.1rem;">Choose who you'd like to add</p>
                            @if (Model.IsClientOrganization)
                            {
                                <span class="badge bg-info text-white mt-2">Client Organization</span>
                            }
                        </div>

                        <form asp-action="AddPeople" asp-controller="Client" asp-route-orgId="@ViewBag.OrganizationId" method="post">
                            <input type="hidden" asp-for="Step" />
                            <input type="hidden" asp-for="IsLawFirmUser" />
                            <input type="hidden" asp-for="IsClientOrganization" />
                            <input type="hidden" asp-for="LawFirmOrganizationId" />
                            <input type="hidden" asp-for="LawFirmOrganizationName" />
                            <input type="hidden" asp-for="SelectionType" id="selectionTypeInput" />

                            <div class="row mb-5">
                                <!-- Internal Team Card -->
                                <div class="col-md-4 mb-3">
                                    <div class="card h-100 border-0 shadow-elegant user-type-card" data-type="InternalTeam" style="cursor: pointer; transition: all 0.3s ease;">
                                        <div class="card-body p-4">
                                            <div class="text-center mb-3">
                                                <div class="p-3 icon-bg-primary rounded-circle d-inline-flex" style="background: rgba(13, 110, 253, 0.1);">
                                                    <i class="fas fa-user-tie text-primary fs-1"></i>
                                                </div>
                                            </div>
                                            <h5 class="fw-bold text-dark text-center mb-2">Internal Team</h5>
                                            <p class="text-muted text-center mb-0 small">
                                                @if (Model.IsClientOrganization)
                                                {
                                                    <text>Add members from @Model.LawFirmOrganizationName to work on this client's matters</text>
                                                }
                                                else
                                                {
                                                    <text>Add @teamMemberType to your @serviceProviderType</text>
                                                }
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Client Card -->
                                <div class="col-md-4 mb-3">
                                    <div class="card h-100 border-0 shadow-elegant user-type-card" data-type="Client" style="cursor: pointer; transition: all 0.3s ease;">
                                        <div class="card-body p-4">
                                            <div class="text-center mb-3">
                                                <div class="p-3 rounded-circle d-inline-flex" style="background: rgba(25, 135, 84, 0.1);">
                                                    <i class="fas fa-building text-success fs-1"></i>
                                                </div>
                                            </div>
                                            <h5 class="fw-bold text-dark text-center mb-2">Client</h5>
                                            <p class="text-muted text-center mb-0 small">
                                                @if (Model.IsClientOrganization)
                                                {
                                                    <text>Invite @ViewBag.OrganizationName employees to collaborate on their matters</text>
                                                }
                                                else
                                                {
                                                    <text>Create a new client organization and invite their representatives</text>
                                                }
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <!-- External Party Card -->
                                <div class="col-md-4 mb-3">
                                    <div class="card h-100 border-0 shadow-elegant user-type-card" data-type="External" style="cursor: pointer; transition: all 0.3s ease;">
                                        <div class="card-body p-4">
                                            <div class="text-center mb-3">
                                                <div class="p-3 rounded-circle d-inline-flex" style="background: rgba(255, 193, 7, 0.1);">
                                                    <i class="fas fa-handshake text-warning fs-1"></i>
                                                </div>
                                            </div>
                                            <h5 class="fw-bold text-dark text-center mb-2">External Party</h5>
                                            <p class="text-muted text-center mb-0 small">
                                                Add external contacts who don't belong to your firm or client organizations
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            }
            else if (Model.Step == 2)
            {
                <!-- Step 2: Form Based on Selection -->
                <div class="row">
                    <div class="col-lg-8">
                        <div class="card shadow-elegant border-0">
                            <div class="card-body p-4">
                                @if (Model.IsClientOrganization && Model.SelectionType == "InternalTeam")
                                {
                                    <!-- Client Context -> Internal Team -> Team Member Selection -->
                                    <h1 class="display-6 fw-bold text-dark mb-2">Assign Firm Members to @ViewBag.OrganizationName</h1>
                                    <p class="lead text-muted mb-4" style="font-size: 1.1rem;">Select team members from @Model.LawFirmOrganizationName to work on this client</p>

                                    <form asp-action="AddPeople" asp-controller="Client" asp-route-orgId="@ViewBag.OrganizationId" method="post" id="teamSelectionForm">
                                        <input type="hidden" asp-for="Step" />
                                        <input type="hidden" asp-for="SelectionType" />
                                        <input type="hidden" asp-for="IsLawFirmUser" />
                                        <input type="hidden" asp-for="IsClientOrganization" />
                                        <input type="hidden" asp-for="LawFirmOrganizationId" />
                                        <input type="hidden" asp-for="LawFirmOrganizationName" />

                                        <!-- Search Box -->
                                        <div class="mb-4">
                                            <div class="d-flex align-items-center mb-3">
                                                <i class="fas fa-search fs-4 me-3" style="color: #3d1019;"></i>
                                                <div>
                                                    <h5 class="fw-bold text-dark mb-1">Find Team Members</h5>
                                                    <p class="text-muted mb-0 small">Search by name or email</p>
                                                </div>
                                            </div>
                                            <div class="input-group">
                                                <input type="text" class="form-control form-control-lg" id="teamMemberSearch" placeholder="Search by name or email...">
                                                <button class="btn btn-outline-secondary" type="button">
                                                    <i class="fas fa-search"></i>
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Selected Team Members -->
                                        <div id="selectedMembersContainer" class="mb-4">
                                            <label class="form-label fw-bold text-dark">Selected Team Members</label>
                                            <div id="selectedMembersList" class="border rounded p-3" style="min-height: 60px; background-color: #f8f9fa;">
                                                <p class="text-muted mb-0 small" id="emptySelectionMessage">No team members selected yet.</p>
                                                <div id="selectedMembersChips" class="d-flex flex-wrap gap-2"></div>
                                            </div>
                                            <span asp-validation-for="SelectedUserIds" class="text-danger"></span>
                                        </div>

                                        <!-- Available Team Members List -->
                                        <div id="availableMembersContainer" class="mb-4">
                                            <label class="form-label fw-bold text-dark">Available Team Members from @Model.LawFirmOrganizationName</label>
                                            <div id="availableMembersList" class="border rounded" style="max-height: 300px; overflow-y: auto; padding: 0.5rem;">
                                                @if (Model.AvailableTeamMembers.Any())
                                                {
                                                    @foreach (var member in Model.AvailableTeamMembers)
                                                    {
                                                        <div class="form-check user-item py-2 px-2 @(member.IsAlreadyAssigned ? "already-assigned" : "")"
                                                             data-user-id="@member.Id"
                                                             data-user-name="@member.Name"
                                                             data-user-email="@member.Email"
                                                             data-user-role="@member.Role"
                                                             style="@(member.IsAlreadyAssigned ? "background-color: #f8f9fa; opacity: 0.6;" : "")">
                                                            <input class="form-check-input member-checkbox"
                                                                   type="checkbox"
                                                                   name="SelectedUserIds"
                                                                   id="user_@member.Id"
                                                                   value="@member.Id"
                                                                   @(member.IsCurrentUser || member.IsAlreadyAssigned ? "checked disabled" : "")>
                                                            <label class="form-check-label" for="user_@member.Id" style="cursor: pointer; width: 100%;">
                                                                <div class="d-flex align-items-center">
                                                                    <div class="flex-grow-1">
                                                                        <strong>@member.Name</strong>
                                                                        @if (member.IsCurrentUser)
                                                                        {
                                                                            <span class="badge bg-primary text-white ms-2" style="font-size: 0.65rem;">YOU</span>
                                                                        }
                                                                        <small class="text-muted d-block">@member.Email</small>
                                                                        @{
                                                                            var orgType = ViewBag.OrganizationType ?? OrganizationType.LawFirm;
                                                                            var displayRole = RoleDisplayHelper.GetRoleDisplayName(member.Role, orgType);
                                                                        }
                                                                        <small class="text-muted">@displayRole</small>
                                                                    </div>
                                                                    @if (member.IsAlreadyAssigned)
                                                                    {
                                                                        <span class="badge bg-secondary" style="font-size: 0.7rem;">Already Assigned</span>
                                                                    }
                                                                </div>
                                                            </label>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <p class="text-muted text-center py-3 mb-0">No team members available</p>
                                                }
                                            </div>
                                        </div>

                                        <!-- Navigation Buttons -->
                                        <div class="d-flex justify-content-between">
                                            <button type="submit" name="action" value="back" class="btn btn-outline-secondary btn-lg d-flex align-items-center gap-2">
                                                <i class="fas fa-arrow-left"></i>
                                                Back
                                            </button>
                                            <button type="submit" class="btn btn-primary btn-lg d-flex align-items-center gap-2">
                                                <span>Assign Selected Members</span>
                                                <i class="fas fa-check"></i>
                                            </button>
                                        </div>
                                    </form>
                                }
                                else
                                {
                                    <!-- All other cases: Join Code Form -->
                                    string titleText = "";
                                    string descriptionText = "";
                                    string roleLabel = "Role";
                                    var roleOptions = new List<string>();

                                    if (Model.SelectionType == "InternalTeam")
                                    {
                                        titleText = "Invite Internal Team Member";
                                        descriptionText = "This person will be added to " + (Model.IsClientOrganization ? ViewBag.OrganizationName : Model.LawFirmOrganizationName);
                                        roleLabel = isEventPlanner ? "Event Planning Role" : "Law Firm Role";
                                        // Role values stay the same (stored in DB), but display names will differ
                                        roleOptions = new List<string> { "ManagingPartner", "Partner", "Associate", "Paralegal", "Staff" };
                                    }
                                    else if (Model.SelectionType == "Client")
                                    {
                                        titleText = "Invite Client Representative";
                                        descriptionText = "This person will be added as a member of " + ViewBag.OrganizationName;
                                        roleLabel = "Client Role";
                                        roleOptions = new List<string> { "Owner", "Manager", "Member", "Lawyer" };
                                    }
                                    else if (Model.SelectionType == "External")
                                    {
                                        titleText = "Invite External Party";
                                        descriptionText = "This person will be added as an external contact";
                                        roleLabel = "External Role";
                                        roleOptions = new List<string> { "OpposingCounsel", "ExpertWitness", "CourtPersonnel", "RegulatoryBody", "Other" };
                                    }

                                    <h1 class="display-6 fw-bold text-dark mb-2">@titleText</h1>
                                    <p class="lead text-muted mb-4" style="font-size: 1.1rem;">@descriptionText</p>

                                    <form asp-action="AddPeople" asp-controller="Client" asp-route-orgId="@ViewBag.OrganizationId" method="post">
                                        <input type="hidden" asp-for="Step" />
                                        <input type="hidden" asp-for="SelectionType" />
                                        <input type="hidden" asp-for="IsLawFirmUser" />
                                        <input type="hidden" asp-for="IsClientOrganization" />
                                        <input type="hidden" asp-for="LawFirmOrganizationId" />
                                        <input type="hidden" asp-for="LawFirmOrganizationName" />

                                        <div class="mb-4">
                                            <label asp-for="Email" class="form-label fw-bold text-dark">Email Address <span class="text-danger">*</span></label>
                                            <input asp-for="Email" class="form-control form-control-lg" placeholder="name@example.com" />
                                            <span asp-validation-for="Email" class="text-danger"></span>
                                        </div>

                                        <div class="mb-4">
                                            <label asp-for="Role" class="form-label fw-bold text-dark">@roleLabel <span class="text-danger">*</span></label>
                                            <select asp-for="Role" class="form-select form-select-lg">
                                                <option value="">Select role</option>
                                                @foreach (var role in roleOptions)
                                                {
                                                    var orgType = ViewBag.OrganizationType ?? OrganizationType.LawFirm;
                                                    var displayName = RoleDisplayHelper.GetRoleDisplayName(role, orgType);
                                                    <option value="@role">@displayName</option>
                                                }
                                            </select>
                                            <span asp-validation-for="Role" class="text-danger"></span>
                                        </div>

                                        @if (Model.SelectionType == "InternalTeam" || Model.SelectionType == "Client")
                                        {
                                            <div class="mb-4">
                                                <label asp-for="Department" class="form-label fw-bold text-dark">Department (Optional)</label>
                                                <input asp-for="Department" class="form-control form-control-lg" placeholder="e.g., Litigation, Corporate" />
                                            </div>

                                            <div class="mb-4">
                                                <label asp-for="JobTitle" class="form-label fw-bold text-dark">Job Title (Optional)</label>
                                                <input asp-for="JobTitle" class="form-control form-control-lg" placeholder="@(isEventPlanner ? "e.g., Senior Planner" : "e.g., Senior Attorney")" />
                                            </div>
                                        }

                                        <div class="d-flex justify-content-between">
                                            <button type="submit" name="action" value="back" class="btn btn-outline-secondary btn-lg d-flex align-items-center gap-2">
                                                <i class="fas fa-arrow-left"></i>
                                                Back
                                            </button>
                                            <button type="submit" class="btn btn-primary btn-lg d-flex align-items-center gap-2">
                                                <span>Generate Join Code</span>
                                                <i class="fas fa-key"></i>
                                            </button>
                                        </div>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Right Sidebar - Info Card -->
                    <div class="col-lg-4">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body p-3">
                                <h5 class="fw-bold text-dark mb-2">
                                    @if (Model.IsClientOrganization && Model.SelectionType == "InternalTeam")
                                    {
                                        <text>Team Assignment</text>
                                    }
                                    else
                                    {
                                        <text>Invitation Info</text>
                                    }
                                </h5>
                                <p class="text-muted mb-0 small">
                                    @if (Model.IsClientOrganization && Model.SelectionType == "InternalTeam")
                                    {
                                        <text>Selected team members will be assigned to work on matters for @ViewBag.OrganizationName. They will maintain their connection to @Model.LawFirmOrganizationName.</text>
                                    }
                                    else if (Model.SelectionType == "InternalTeam")
                                    {
                                        <text>This person will be added to your @serviceProviderType and will appear in team selection for matters and tasks.</text>
                                    }
                                    else if (Model.SelectionType == "Client")
                                    {
                                        <text>The invited person will join as a client member and can collaborate on matters based on their assigned role.</text>
                                    }
                                    else if (Model.SelectionType == "External")
                                    {
                                        <text>External contacts can be assigned to specific matters but won't have organization-wide access.</text>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else if (Model.IsLawFirmUser && !Model.IsClientOrganization)
        {
            <!-- Law Firm User in Their Own Law Firm Organization (Simple Single Page) -->
            <div class="row">
                <div class="col-lg-8">
                    <div class="card shadow-elegant border-0">
                        <div class="card-body p-4">
                            <h1 class="display-6 fw-bold text-dark mb-2">
                                Add Team Member to
                                <span class="d-block">@ViewBag.OrganizationName</span>
                            </h1>
                            <p class="lead text-muted" style="font-size: 1.1rem;">Invite a team member to your @serviceProviderType.</p>

                            <form asp-action="AddPeople" asp-controller="Client" asp-route-orgId="@ViewBag.OrganizationId" method="post">
                                <input type="hidden" asp-for="IsLawFirmUser" />
                                <input type="hidden" asp-for="IsClientOrganization" />
                                <input type="hidden" asp-for="SelectionType" value="InternalTeam" />

                                <div class="mb-4">
                                    <label asp-for="Email" class="form-label fw-bold text-dark">Email Address <span class="text-danger">*</span></label>
                                    <input asp-for="Email" class="form-control form-control-lg" placeholder="name@example.com" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Role" class="form-label fw-bold text-dark">@serviceProviderTypeCapitalized Role <span class="text-danger">*</span></label>
                                    <select asp-for="Role" class="form-select form-select-lg">
                                        <option value="">Select role</option>
                                        @{
                                            var serviceProviderRoles = new[] { "ManagingPartner", "Partner", "Associate", "Paralegal", "Staff" };
                                            foreach (var role in serviceProviderRoles)
                                            {
                                                var displayName = RoleDisplayHelper.GetRoleDisplayName(role, orgType);
                                                <option value="@role">@displayName</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="Role" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Department" class="form-label fw-bold text-dark">Department (Optional)</label>
                                    <input asp-for="Department" class="form-control form-control-lg" placeholder="e.g., Litigation, Corporate" />
                                </div>

                                <div class="mb-4">
                                    <label asp-for="JobTitle" class="form-label fw-bold text-dark">Job Title (Optional)</label>
                                    <input asp-for="JobTitle" class="form-control form-control-lg" placeholder="@(isEventPlanner ? "e.g., Senior Planner" : "e.g., Senior Attorney")" />
                                </div>

                                <div class="d-flex justify-content-end">
                                    <button type="submit" class="btn btn-primary btn-lg d-flex align-items-center gap-2">
                                        <span>Generate Join Code</span>
                                        <i class="fas fa-key"></i>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-3">
                            <h5 class="fw-bold text-dark mb-2">Internal Team Member</h5>
                            <p class="text-muted mb-0 small">This person will be added to your @serviceProviderType and will appear in team selection for matters and tasks across all client organizations.</p>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Client User Experience (Simple Single Page) -->
            <div class="row">
                <div class="col-lg-8">
                    <div class="card shadow-elegant border-0">
                        <div class="card-body p-4">
                            <h1 class="display-6 fw-bold text-dark mb-2">Add People to @ViewBag.OrganizationName</h1>
                            <p class="lead text-muted" style="font-size: 1.1rem;">Invite a new person to your organization by generating a join code.</p>

                            <form asp-action="AddPeople" asp-controller="Client" asp-route-orgId="@ViewBag.OrganizationId" method="post">
                                <input type="hidden" asp-for="IsLawFirmUser" />
                                <input type="hidden" asp-for="SelectionType" value="Client" />

                                <div class="mb-4">
                                    <label asp-for="Email" class="form-label fw-bold text-dark">Email Address <span class="text-danger">*</span></label>
                                    <input asp-for="Email" class="form-control form-control-lg" placeholder="name@example.com" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Role" class="form-label fw-bold text-dark">Role <span class="text-danger">*</span></label>
                                    <select asp-for="Role" class="form-select form-select-lg">
                                        <option value="">Select role</option>
                                        <option value="Owner">Owner</option>
                                        <option value="Manager">Manager</option>
                                        <option value="Member">Member</option>
                                        <option value="Lawyer">Lawyer</option>
                                    </select>
                                    <span asp-validation-for="Role" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Department" class="form-label fw-bold text-dark">Department (Optional)</label>
                                    <input asp-for="Department" class="form-control form-control-lg" placeholder="e.g., Operations, Legal" />
                                </div>

                                <div class="mb-4">
                                    <label asp-for="JobTitle" class="form-label fw-bold text-dark">Job Title (Optional)</label>
                                    <input asp-for="JobTitle" class="form-control form-control-lg" placeholder="e.g., VP of Operations" />
                                </div>

                                <div class="d-flex justify-content-end">
                                    <button type="submit" class="btn btn-primary btn-lg d-flex align-items-center gap-2">
                                        <span>Generate Join Code</span>
                                        <i class="fas fa-key"></i>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-3">
                            <h5 class="fw-bold text-dark mb-2">Invitation Info</h5>
                            <p class="text-muted mb-0 small">This person will join your organization as a client member with the selected role. They'll be able to view and collaborate based on their role permissions.</p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (hasGeneratedJoinCode)
{
    <div class="task-details-modal" id="joinCodeModal" style="display: none; border-radius: 12px; left: 23vw; bottom: 0;">
        <div class="modal-dialog" style="margin-bottom: 1.5rem;">
            <div class="task-details-content">
                <div class="task-details-header" style="display: flex; justify-content: space-between; align-items: center; padding: 1.5rem;">
                    <div class="task-details-header-left" style="display: flex; align-items: center; gap: 0.5rem; flex: 1;">
                        <i class="fa-solid fa-key" style="color: #3d1019; font-size: 1.25rem;"></i>
                        <h2 class="task-title" style="cursor: default; margin: 0; font-size: 1.25rem; font-weight: 600; color: #3d1019;">Join Code Generated</h2>
                    </div>
                    <div class="task-details-header-right" style="margin-left: auto;">
                        <button type="button" class="btn-close" id="closeJoinCodeModal" aria-label="Close"></button>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(joinCodeSuccessMessage))
                {
                    <div class="task-details-body" style="padding: 0 1.5rem 1rem;">
                        <div class="alert alert-success" style="margin-bottom: 1rem; border-radius: 8px;">
                            <i class="fas fa-check-circle me-2"></i>
                            @joinCodeSuccessMessage
                        </div>
                    </div>
                }

                <div class="task-details-body">
                    <div class="task-details-left">
                        <div class="task-section">
                            <div class="task-section-header">
                                <h6 class="task-section-title">
                                    <i class="fas fa-key"></i> Join Code
                                </h6>
                            </div>
                            <div class="task-section-content">
                                <div style="position: relative; margin-bottom: 0.75rem;">
                                    <input type="text" class="form-control form-control-lg" id="joinCodeValue" readonly value="@generatedJoinCode" style="font-size: 1.25rem; font-weight: 600; letter-spacing: 0.1em; font-family: monospace; background-color: #f8f9fa; padding-right: 5.5rem;">
                                    <div style="position: absolute; right: 0.5rem; top: 50%; transform: translateY(-50%); display: flex; align-items: center; gap: 0.5rem;">
                                        <button class="join-code-action-btn" type="button" id="copyJoinCodeBtn" title="Copy">
                                            <i class="fas fa-copy"></i>
                                        </button>
                                        <button class="join-code-action-btn" type="button" id="notalizeJoinCodeBtn" title="Notalize">
                                            <img src="/images/Notal_Logo.png" alt="Notalize" style="width: 18px; height: 18px; object-fit: contain;" />
                                        </button>
                                    </div>
                                </div>
                                <small class="text-muted d-block mb-2" style="font-size: 0.875rem;">
                                    Share this code with the invitee. It expires in 7 days.
                                </small>
                                @if (!string.IsNullOrWhiteSpace(generatedJoinCodeEmail))
                                {
                                    <small class="text-muted d-block" style="font-size: 0.875rem;">
                                        Suggested recipient: <strong>@generatedJoinCodeEmail</strong>
                                    </small>
                                }
                                @if (!string.IsNullOrWhiteSpace(joinCodeInviteeRole))
                                {
                                    <small class="text-muted d-block" style="font-size: 0.875rem;">
                                        Invited as: <strong>@joinCodeInviteeRoleDisplay</strong>
                                    </small>
                                }
                                @if (!string.IsNullOrWhiteSpace(joinCodeInviteeUserType))
                                {
                                    <small class="text-muted d-block" style="font-size: 0.875rem;">
                                        Intended user type: <strong>@joinCodeInviteeUserType</strong>
                                    </small>
                                }
                            </div>
                        </div>

                        <div class="task-section" style="margin-bottom: 0;">
                            <div class="task-section-header">
                                <h6 class="task-section-title">
                                    <i class="fas fa-info-circle"></i> Instructions
                                </h6>
                            </div>
                            <div class="task-section-content">
                                <div style="font-size: 0.875rem; color: #4a5568;">
                                    <p style="margin-bottom: 0.5rem;">
                                        <strong>1.</strong> Click Notalize <em>(recommended)</em>, <strong>or</strong> copy the join code above.
                                    </p>
                                    <p style="margin-bottom: 0.5rem;">
                                        <strong>2.</strong> Share it with the invitee via Communications hub or email.
                                    </p>
                                    <p style="margin-bottom: 0;">
                                        <strong>3.</strong> The invitee will use this code to join the organization.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="task-action-buttons" style="padding: 0 1.5rem 1.5rem; justify-content: flex-end;">
                    <button type="button" class="btn btn-primary" id="doneJoinCodeBtn" style="border-radius: 0.5rem;">
                        Done
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            function loadScript(src) {
                return new Promise((resolve, reject) => {
                    const script = document.createElement('script');
                    script.src = src;
                    script.onload = resolve;
                    script.onerror = reject;
                    document.head.appendChild(script);
                });
            }

            function initValidationScripts() {
                if (window.__validationScriptsLoaded) {
                    return;
                }

                function ensureJQuery() {
                    if (window.jQuery) {
                        return Promise.resolve();
                    }
                    if (window.__loadingJQuery) {
                        return window.__loadingJQuery;
                    }
                    window.__loadingJQuery = loadScript('@Url.Content("~/lib/jquery/dist/jquery.min.js")');
                    return window.__loadingJQuery;
                }

                ensureJQuery()
                    .then(() => Promise.all([
                        loadScript('@Url.Content("~/lib/jquery-validation/dist/jquery.validate.min.js")'),
                        loadScript('@Url.Content("~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js")')
                    ]))
                    .then(() => {
                        window.__validationScriptsLoaded = true;
                    })
                    .catch(err => console.error('Failed to load validation scripts', err));
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initValidationScripts);
            } else {
                initValidationScripts();
            }
        })();
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Card selection for step 1
            const selectionCards = document.querySelectorAll('.user-type-card');
            const selectionTypeInput = document.getElementById('selectionTypeInput');

            selectionCards.forEach(card => {
                card.addEventListener('click', function() {
                    const type = this.getAttribute('data-type');
                    if (selectionTypeInput) {
                        selectionTypeInput.value = type;
                        this.closest('form').submit();
                    }
                });

                card.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-4px)';
                    this.style.boxShadow = '0 8px 25px rgba(0,0,0,0.15)';
                });

                card.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                    this.style.boxShadow = '0 2px 8px rgba(0,0,0,0.08)';
                });
            });

            // Team member search functionality
            const searchInput = document.getElementById('teamMemberSearch');
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    const searchTerm = this.value.toLowerCase();
                    const userItems = document.querySelectorAll('.user-item');

                    userItems.forEach(item => {
                        const name = item.getAttribute('data-user-name').toLowerCase();
                        const email = item.getAttribute('data-user-email').toLowerCase();

                        if (name.includes(searchTerm) || email.includes(searchTerm)) {
                            item.style.display = '';
                        } else {
                            item.style.display = 'none';
                        }
                    });
                });
            }

            // Team member checkbox handling
            const memberCheckboxes = document.querySelectorAll('.member-checkbox:not([disabled])');
            const selectedChipsContainer = document.getElementById('selectedMembersChips');
            const emptyMessage = document.getElementById('emptySelectionMessage');

            function updateSelectedDisplay() {
                if (!selectedChipsContainer) return;

                selectedChipsContainer.innerHTML = '';
                const checkedBoxes = document.querySelectorAll('.member-checkbox:checked:not([disabled])');

                if (checkedBoxes.length > 0 && emptyMessage) {
                    emptyMessage.style.display = 'none';
                }

                checkedBoxes.forEach(checkbox => {
                    const userItem = checkbox.closest('.user-item');
                    const name = userItem.getAttribute('data-user-name');
                    const role = userItem.getAttribute('data-user-role');
                    const userId = userItem.getAttribute('data-user-id');

                    const chip = document.createElement('div');
                    chip.className = 'badge bg-primary text-white d-flex align-items-center gap-2';
                    chip.style.fontSize = '0.9rem';
                    chip.style.padding = '0.5rem 0.75rem';
                    chip.innerHTML = `
                        <div>
                            <strong>${name}</strong>
                            <small class="d-block" style="font-size: 0.75rem;">${role}</small>
                        </div>
                        <button type="button" class="btn-close btn-close-white" style="font-size: 0.6rem;" data-user-id="${userId}"></button>
                    `;

                    chip.querySelector('.btn-close').addEventListener('click', function() {
                        checkbox.checked = false;
                        updateSelectedDisplay();
                    });

                    selectedChipsContainer.appendChild(chip);
                });

                if (checkedBoxes.length === 0 && emptyMessage) {
                    emptyMessage.style.display = '';
                }
            }

            memberCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', updateSelectedDisplay);
            });

            updateSelectedDisplay();

            // Join code modal logic
            const joinCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(generatedJoinCode ?? string.Empty));
            const joinCodeEmail = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(generatedJoinCodeEmail ?? string.Empty));
            const joinCodeInviteeName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(joinCodeInviteeDisplayName ?? string.Empty));
            const joinCodeInviteeRole = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(joinCodeInviteeRole ?? string.Empty));
            const joinCodeInviteeUserType = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(joinCodeInviteeUserType ?? string.Empty));
            const joinCodeOrganizationTypeValue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(joinCodeOrganizationType ?? string.Empty));
            const joinCodeOrganizationType = (joinCodeOrganizationTypeValue || '').toLowerCase();
            const joinCodeLawFirmOrgId = @joinCodeLawFirmOrgId;
            const joinCodeClientOrgId = @joinCodeClientOrgId;
            const canNotalizeJoinCode = Boolean(joinCode) && joinCode.length > 0 &&
                joinCodeEmail.length > 0 &&
                joinCodeLawFirmOrgId > 0 &&
                joinCodeClientOrgId > 0 &&
                joinCodeOrganizationType === 'client';

            if (joinCode && joinCode.length > 0) {
                const modalEl = document.getElementById('joinCodeModal');
                if (modalEl) {
                    modalEl.style.display = 'flex';
                    document.body.style.overflow = 'hidden';

                    const copyBtn = document.getElementById('copyJoinCodeBtn');
                    const notalizeBtn = document.getElementById('notalizeJoinCodeBtn');
                    const input = document.getElementById('joinCodeValue');
                    const closeBtn = document.getElementById('closeJoinCodeModal');
                    const doneBtn = document.getElementById('doneJoinCodeBtn');

                    if (copyBtn && input) {
                        copyBtn.addEventListener('click', async (e) => {
                            e.stopPropagation();
                            try {
                                await navigator.clipboard.writeText(input.value);
                                const originalHtml = copyBtn.innerHTML;
                                copyBtn.innerHTML = '<i class="fas fa-check"></i>';
                                setTimeout(() => {
                                    copyBtn.innerHTML = originalHtml;
                                }, 1500);
                            } catch (err) {
                                console.error('Failed to copy:', err);
                            }
                        });
                    }

                    if (notalizeBtn) {
                        if (canNotalizeJoinCode) {
                            notalizeBtn.style.display = '';
                            notalizeBtn.addEventListener('click', async (e) => {
                                e.stopPropagation();
                                await notalizeJoinCodeFromAddPeople(joinCode, joinCodeLawFirmOrgId, joinCodeClientOrgId, {
                                    email: joinCodeEmail,
                                    name: joinCodeInviteeName,
                                    role: joinCodeInviteeRole,
                                    userType: joinCodeInviteeUserType,
                                    organizationType: joinCodeOrganizationType
                                });
                            });
                        } else {
                            notalizeBtn.style.display = 'none';
                        }
                    }

                    function closeJoinCodeModal() {
                        modalEl.style.display = 'none';
                        document.body.style.overflow = '';
                    }

                    if (closeBtn) {
                        closeBtn.addEventListener('click', (e) => {
                            e.stopPropagation();
                            closeJoinCodeModal();
                        });
                    }

                    if (doneBtn) {
                        doneBtn.addEventListener('click', (e) => {
                            e.stopPropagation();
                            closeJoinCodeModal();
                        });
                    }

                    modalEl.addEventListener('click', function (e) {
                        if (e.target === modalEl) {
                            closeJoinCodeModal();
                        }
                    });
                }
            }

            async function notalizeJoinCodeFromAddPeople(code, lawFirmOrgId, clientOrgId, inviteeContext) {
                if (!lawFirmOrgId || !clientOrgId) {
                    alert('Unable to determine organization context for notalize.');
                    return;
                }

                const notalizeBtn = document.getElementById('notalizeJoinCodeBtn');
                try {
                    if (notalizeBtn) {
                        notalizeBtn.style.opacity = '0.5';
                        notalizeBtn.style.pointerEvents = 'none';
                    }

                    const response = await fetch(`/api/dm/notalize-join-code?orgId=${lawFirmOrgId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            JoinCode: code,
                            ClientOrgId: clientOrgId,
                            TargetOrgId: clientOrgId,
                            InviteeEmail: inviteeContext?.email ?? '',
                            InviteeName: inviteeContext?.name ?? '',
                            InviteeRole: inviteeContext?.role ?? '',
                            InvitedUserType: inviteeContext?.userType ?? '',
                            LawFirmOrgId: lawFirmOrgId
                        })
                    });

                    const result = await response.json();

                    if (result.success && result.thread && result.messageTemplate) {
                        sessionStorage.setItem('notalizeJoinCodeMessage', result.messageTemplate);
                        sessionStorage.setItem('notalizeJoinCodeThreadId', result.thread.id);
                        sessionStorage.setItem('notalizeJoinCodeOtherUserId', result.thread.otherUserId);
                        sessionStorage.setItem('notalizeJoinCodeOtherUserName', result.thread.otherUserName);

                        window.location.href = `/Client/${lawFirmOrgId}/Communications?notalize=true`;
                    } else {
                        alert(result.error || 'Failed to notalize join code. Please try again.');
                        if (notalizeBtn) {
                            notalizeBtn.style.opacity = '';
                            notalizeBtn.style.pointerEvents = '';
                        }
                    }
                } catch (error) {
                    console.error('Error notalizing join code:', error);
                    alert('An error occurred while notalizing the join code.');
                    if (notalizeBtn) {
                        notalizeBtn.style.opacity = '';
                        notalizeBtn.style.pointerEvents = '';
                    }
                }
            }
        });
    </script>

    <link rel="stylesheet" href="~/css/tasks.css" />

    <style>
