@model Certio.Web.ViewModels.AddPeopleViewModel
@{
    ViewData["Title"] = "Add People";
    Layout = "_ClientLayout";
}

<div class="min-h-screen bg-gradient-subtle py-8">
    <div class="container-fluid">
        <div class="mb-4">
            <a href="@Url.Action("Teams", "Home")" class="btn btn-ghost d-flex align-items-center gap-2 text-decoration-none">
                <i class="fas fa-arrow-left"></i>
                Back to Teams
            </a>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-elegant border-0">
                    <div class="card-body p-4">
                        <h1 class="display-6 fw-bold text-dark mb-2">Add people</h1>
                        <p class="lead text-muted" style="font-size: 1.1rem;">Invite a new person to your organization by generating a join code.</p>

                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger">@TempData["Error"]</div>
                        }
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success">@TempData["Success"]</div>
                        }
                        @if (ViewBag.JoinCode != null)
                        {
                            <div class="alert alert-info d-flex align-items-center gap-2">
                                <i class="fas fa-key"></i>
                                <div>
                                    <div class="fw-bold">Join Code</div>
                                    <div>@ViewBag.JoinCode</div>
                                </div>
                            </div>
                        }

                        <form asp-action="AddPeople" asp-controller="Home" method="post">
                            <div class="mb-4">
                                <label asp-for="Email" class="form-label fw-bold text-dark">Email <span class="text-danger">*</span></label>
                                <input asp-for="Email" class="form-control form-control-lg" placeholder="name@example.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="UserType" class="form-label fw-bold text-dark">User Type <span class="text-danger">*</span></label>
                                <select asp-for="UserType" class="form-select form-select-lg" id="userTypeSelect">
                                    <option value="@Certio.Domain.Users.UserType.Client">Client</option>
                                    <option value="@Certio.Domain.Users.UserType.External">External</option>
                                    <option value="@Certio.Domain.Users.UserType.Certio">Certio</option>
                                </select>
                                <span asp-validation-for="UserType" class="text-danger"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Role" class="form-label fw-bold text-dark">Role <span class="text-danger">*</span></label>
                                <select asp-for="Role" class="form-select form-select-lg" id="roleSelect">
                                    <option value="">Select role</option>
                                    @foreach (var role in Enum.GetValues<Certio.Domain.Users.OrganizationRole>())
                                    {
                                        <option value="@role">@role</option>
                                    }
                                </select>
                                <span asp-validation-for="Role" class="text-danger"></span>
                            </div>

                            <div class="d-flex justify-content-end">
                                <button type="submit" class="btn btn-primary btn-lg d-flex align-items-center gap-2">
                                    <span>Generate Join Code</span>
                                    <i class="fas fa-key"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0">
                    <div class="card-body p-3">
                        <h5 class="fw-bold text-dark mb-2">Invitation Info</h5>
                        <p class="text-muted mb-4">Select the appropriate user type and subtype. We'll show the join code here after generation and log it to the debug console.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const userTypeSelect = document.getElementById('userTypeSelect');
            const roleSelect = document.getElementById('roleSelect');

            function updateRoleOptions() {
                const userType = userTypeSelect.value;
                const currentRole = roleSelect.value;
                
                console.log('Updating role options for user type:', userType);
                
                // Clear existing options except the first one
                roleSelect.innerHTML = '<option value="">Select role</option>';
                
                // Define all available roles
                const allRoles = [
                    'Owner', 'Manager', 'Member', 'Lawyer',
                    'OpposingCounsel', 'ExpertWitness', 'CourtPersonnel', 'RegulatoryBody', 'Other',
                    'Admin', 'ProjectManager', 'Support', 'Legal',
                    'Guest'
                ];
                
                let addedRoles = [];
                
                allRoles.forEach(function(role) {
                    const option = document.createElement('option');
                    option.value = role;
                    option.textContent = role;
                    
                    // Filter roles based on user type
                    if (userType === 'Client' && ['Owner', 'Manager', 'Member', 'Lawyer'].includes(role)) {
                        roleSelect.appendChild(option);
                        addedRoles.push(role);
                    } else if (userType === 'External' && ['OpposingCounsel', 'ExpertWitness', 'CourtPersonnel', 'RegulatoryBody', 'Other'].includes(role)) {
                        roleSelect.appendChild(option);
                        addedRoles.push(role);
                    } else if (userType === 'Certio' && ['Admin', 'ProjectManager', 'Support', 'Legal'].includes(role)) {
                        roleSelect.appendChild(option);
                        addedRoles.push(role);
                    }
                });
                
                console.log('Added roles for', userType, ':', addedRoles);
                console.log('Total options in select:', roleSelect.options.length);
                
                // Restore previous selection if still valid
                if (currentRole && roleSelect.querySelector(`option[value="${currentRole}"]`)) {
                    roleSelect.value = currentRole;
                }
            }

            updateRoleOptions();
            userTypeSelect.addEventListener('change', updateRoleOptions);
        });
    </script>
}


