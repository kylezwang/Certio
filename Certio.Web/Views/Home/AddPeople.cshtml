@model Certio.Web.ViewModels.AddPeopleViewModel
@{
    ViewData["Title"] = "Add People";
    Layout = "_ClientLayout";
}

<div class="min-h-screen bg-gradient-subtle py-8">
    <div class="container-fluid">
        <div class="mb-4">
            <a href="@Url.Action("Teams", "Home")" class="btn btn-ghost d-flex align-items-center gap-2 text-decoration-none">
                <i class="fas fa-arrow-left"></i>
                Back to Teams
            </a>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-elegant border-0">
                    <div class="card-body p-4">
                        <h1 class="display-6 fw-bold text-dark mb-2">Add people</h1>
                        <p class="lead text-muted" style="font-size: 1.1rem;">Invite a new person to your organization by generating a join code.</p>

                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger">@TempData["Error"]</div>
                        }
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success">@TempData["Success"]</div>
                        }
                        @* Modal is triggered below when JoinCode is present *@

                        <form asp-action="AddPeople" asp-controller="Home" method="post">
                            <div class="mb-4">
                                <label asp-for="Email" class="form-label fw-bold text-dark">Email <span class="text-danger">*</span></label>
                                <input asp-for="Email" class="form-control form-control-lg" placeholder="name@example.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="mb-4">
                                <label asp-for="UserType" class="form-label fw-bold text-dark">User Type <span class="text-danger">*</span></label>
                                <select asp-for="UserType" class="form-select form-select-lg" id="userTypeSelect">
                                    <option value="@Certio.Domain.Users.UserTypes.Client">Client</option>
                                    <option value="@Certio.Domain.Users.UserTypes.LawFirm">Law Firm</option>
                                    <option value="@Certio.Domain.Users.UserTypes.External">External</option>
                                    <option value="@Certio.Domain.Users.UserTypes.Certio">Certio</option>
                                </select>
                                <span asp-validation-for="UserType" class="text-danger"></span>
                            </div>

                            <div id="lawFirmNote" class="alert alert-secondary d-none">
                                This invitation will add the user as a <strong>Law Firm</strong> member. Their actual firm role will be resolved automatically after they connect their Law Firm.
                            </div>

                            <div id="roleContainer" class="mb-4">
                                <label asp-for="Role" class="form-label fw-bold text-dark">Role <span id="roleRequiredAsterisk" class="text-danger">*</span></label>
                                <select asp-for="Role" class="form-select form-select-lg" id="roleSelect">
                                    <option value="">Select role</option>
                                </select>
                                <span asp-validation-for="Role" class="text-danger"></span>
                            </div>

                            <div class="d-flex justify-content-end">
                                <button type="submit" class="btn btn-primary btn-lg d-flex align-items-center gap-2">
                                    <span>Generate Join Code</span>
                                    <i class="fas fa-key"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0">
                    <div class="card-body p-3">
                        <h5 class="fw-bold text-dark mb-2">Invitation Info</h5>
                        <p class="text-muted mb-4">Client invites for Law Firm users do not require a role selection. The system assigns their role based on their Law Firm membership.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @* Join Code Modal *@
    <div class="modal fade" id="joinCodeModal" tabindex="-1" aria-labelledby="joinCodeLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="joinCodeLabel">Join Code</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="input-group">
                        <input type="text" class="form-control" id="joinCodeValue" readonly value="@ViewBag.JoinCode">
                        <button class="btn btn-outline-secondary" type="button" id="copyJoinCodeBtn"><i class="fas fa-copy"></i></button>
                    </div>
                    <small class="text-muted d-block mt-2">Share this code with the invitee. It expires in 7 days.</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Done</button>
                </div>
            </div>
        </div>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const userTypeSelect = document.getElementById('userTypeSelect');
            const roleSelect = document.getElementById('roleSelect');
            const roleContainer = document.getElementById('roleContainer');
            const lawFirmNote = document.getElementById('lawFirmNote');
            const roleAsterisk = document.getElementById('roleRequiredAsterisk');

            const RoleOptions = {
                Client: ['Owner', 'Manager', 'Member', 'Lawyer'],
                External: ['OpposingCounsel', 'ExpertWitness', 'CourtPersonnel', 'RegulatoryBody', 'Other'],
                Certio: ['Admin', 'MatterManager', 'Support', 'Legal'],
                LawFirm: ['Partner', 'Associate', 'Paralegal', 'Staff']
            };

            function populateRoles(type) {
                roleSelect.innerHTML = '<option value="">Select role</option>';
                (RoleOptions[type] || []).forEach(r => {
                    const opt = document.createElement('option');
                    opt.value = r;
                    opt.textContent = r;
                    roleSelect.appendChild(opt);
                });
            }

            function updateUI() {
                const type = userTypeSelect.value;
                if (type === 'LawFirm') {
                    roleContainer.classList.add('d-none');
                    lawFirmNote.classList.remove('d-none');
                    roleAsterisk.style.visibility = 'hidden';
                    roleSelect.value = '';
                    roleSelect.setAttribute('disabled', 'disabled');
                    // Clear any visible validation message for Role
                    const validationSpan = roleContainer.querySelector('[data-valmsg-for="Role"]');
                    if (validationSpan) { validationSpan.textContent = ''; }
                } else {
                    roleContainer.classList.remove('d-none');
                    lawFirmNote.classList.add('d-none');
                    roleAsterisk.style.visibility = 'visible';
                    roleSelect.removeAttribute('disabled');
                    populateRoles(type);
                }
            }

            // Initialize
            populateRoles(userTypeSelect.value);
            updateUI();
            userTypeSelect.addEventListener('change', updateUI);

            // Show join code modal if present
            const joinCode = '@(ViewBag.JoinCode ?? "")';
            if (joinCode && joinCode.length > 0) {
                const modalEl = document.getElementById('joinCodeModal');
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
                const copyBtn = document.getElementById('copyJoinCodeBtn');
                const input = document.getElementById('joinCodeValue');
                copyBtn?.addEventListener('click', async () => {
                    try {
                        await navigator.clipboard.writeText(input.value);
                        copyBtn.innerHTML = '<i class="fas fa-check"></i>';
                        setTimeout(() => copyBtn.innerHTML = '<i class="fas fa-copy"></i>', 1500);
                    } catch {}
                });
            }
        });
    </script>
}


