        }

        .form-check-input:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

        #joinCodeModal.task-details-modal {
            position: fixed;
            top: 7vh;
            left: 23vw;
            right: 320px;
            bottom: 0;
