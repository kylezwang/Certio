                                            <!-- Same structure as other task cards -->
                                            <div class="task-checkbox-column">
                                                <div class="form-check" style="padding-left: 0;">
                                                    <input class="form-check-input card-checkbox" 
                                                           type="checkbox" 
                                                           id="inbox-task-@task.Id"
                                                           data-task-id="@task.Id"
                                                               @(task.Status == "Completed" ? "checked" : "")
                                                               onclick="event.stopPropagation();">
                                                    </div>
                                                </div>
                                                
                                                <div class="task-title-column" style="display: flex; flex-direction: column; align-items: flex-start;">
                                                    <label class="form-check-label task-title-label" for="inbox-task-@task.Id">
                                                        @task.Title
                                                    </label>
                                                </div>
                                                
                                                <div class="task-align-column">
                                                    <button class="task-align-btn task-card-align-btn" title="Description" data-task-id="@task.Id" onclick="event.stopPropagation();">
                                                        <i class="fa-solid fa-align-left"></i>
                                                    </button>
                                                </div>
                                                
                                                <div class="task-priority-column">
                                                    @if (!string.IsNullOrEmpty(task.Priority))
                                                    {
                                                        <span class="badge matter-priority-badge task-card-priority-btn" style="@GetPriorityStyles(task.Priority); font-size: 0.7em; cursor: pointer;" 
                                                              data-task-id="@task.Id" title="Click to edit priority">
                                                                @task.Priority
                                                            </span>
                                                        }
                                                </div>
                                                
                                                <div class="task-due-date-column">
                                                        @if (task.DueDate.HasValue)
                                                        {
                                                            var today = DateTime.Now.Date;
                                                            var dueDate = task.DueDate.Value.Date;
                                                            var daysUntilDue = (dueDate - today).Days;
                                                            var isOverdue = daysUntilDue < 0;
                                                            var isTodayOrTomorrow = !isOverdue && daysUntilDue <= 1;
                                                            var dueDateClass = "task-card-date-btn";
                                                            var dueDateColor = isOverdue ? "#c62828" : (isTodayOrTomorrow ? "#1e1e1e" : "#6b7280");
                                                            var dueDateWeight = "600";
                                                        <span class="@dueDateClass" style="font-size: 0.75em; cursor: pointer; color: @dueDateColor !important; font-weight: @dueDateWeight !important;" 
                                                              data-task-id="@task.Id" title="Click to edit dates">
                                                            <i class="fa-solid fa-calendar-day"></i> @task.DueDate.Value.ToString("MMM dd, yyyy")
                                                            </span>
                                                        }
                                                </div>
                                                
                                                <div class="task-progress-column">
                                                    @if (task.TotalSubTasks > 0)
                                                    {
                                                        <div class="task-progress task-card-progress-btn" data-task-id="@task.Id" title="Click to edit subtasks" style="cursor: pointer;">
                                                            <span>@task.CompletedSubTasks/@task.TotalSubTasks</span>
                                                            <div class="progress">
                                                                <div class="progress-bar" role="progressbar" 
                                                                     style="width: @task.ProgressPercentage" 
                                                                     aria-valuenow="@task.CompletedSubTasks" 
                                                                     aria-valuemin="0" 
                                                                     aria-valuemax="@task.TotalSubTasks"></div>
                                                            </div>
                                                            @if (task.UrgentSubTasksCount > 0)
                                                            {
                                                                <div class="urgent-subtasks-badge" title="@task.UrgentSubTasksCount subtask(s) due today or tomorrow">
                                                                    @task.UrgentSubTasksCount
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                                
                                                <div class="task-actions-column">
                                                    <div class="task-action-buttons">
                                                        <button class="btn btn-sm btn-link task-action-btn task-card-attachment-btn" title="Attachments" data-task-id="@task.Id" onclick="event.stopPropagation();">
                                                            <i class="fas fa-paperclip"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-link task-action-btn task-card-location-btn" title="Location" data-task-id="@task.Id" onclick="event.stopPropagation();">
                                                            <i class="fas fa-map-marker-alt"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                                
                                                <div class="task-assignees-column">
                                                    <div class="task-assignees">
                                                        @if (task.Assignments.Any())
                                                        {
                                                            @foreach (var assignment in task.Assignments.Take(3))
                                                            {
                                                                <div class="assignee-avatar" title="@assignment.UserName">
                                                                    <span class="assignee-initials">@assignment.UserInitials</span>
                                                                </div>
                                                            }
                                                            @if (task.Assignments.Count > 3)
                                                            {
                                                                <div class="assignee-avatar assignee-more" title="@(task.Assignments.Count - 3) more assignees">
                                                                    <span class="assignee-initials">+@(task.Assignments.Count - 3)</span>
                                                                </div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-sm btn-outline-secondary assign-task-btn" title="Assign task" data-task-id="@task.Id" onclick="event.stopPropagation();">
                                                                <i class="fas fa-user-plus"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- Empty State -->
                        <div class="empty-state">
                            <div class="empty-state-icon">
                                <i class="fas fa-bars-progress"></i>
                            </div>
                            <h3>No tasks yet</h3>
                            <p>Create your first task to get started with this matter.</p>
                            <button class="btn btn-primary" id="addFirstTaskButton">
                                <i class="fas fa-plus"></i>
                                Add Task
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    
    <!-- Resizer between Inbox and Planner -->
    <div class="view-resizer" id="inboxPlannerResizer" data-left-view="inboxView" data-right-view="plannerView"></div>
    
    <!-- Planner View -->
    <div class="view-container d-none" id="plannerView">
        <div class="planner-container">
            <div class="text-center py-5 text-muted">
                <i class="fa-solid fa-calendar-day" style="font-size: 3rem; opacity: 0.3;"></i>
                <h5 class="mt-3">Planner View</h5>
                <p>Calendar planner view coming soon</p>
            </div>
        </div>
    </div>
    
    <!-- Resizer between Planner and Board -->
    <div class="view-resizer" id="plannerBoardResizer" data-left-view="plannerView" data-right-view="boardView"></div>
    
    <!-- Board View -->
    <div class="view-container d-none" id="boardView">
        <div class="kanban-board-container">
            <div class="kanban-board" id="kanbanBoardFull">
                <!-- Planned Column -->
                <div class="kanban-column" data-status="Pending">
                    <div class="column-header">
                        <div class="d-flex align-items-center">
                            <h6 class="mb-0 fw-bold">Planned</h6>
                            <span class="badge bg-secondary" style="margin-left: 0.75rem;">@Model.PlannedTasks.Count</span>
                        </div>
                        <button class="btn btn-sm btn-link text-muted column-add-btn" data-status="Pending">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                    <div class="column-cards" id="column-pending-full">
                        @foreach (var task in Model.PlannedTasks.OrderBy(t => t.Order))
                        {
                            <partial name="_TaskCard" model="task" />
                        }
                    </div>
                </div>

                <!-- In Progress Column -->
                <div class="kanban-column" data-status="InProgress">
                    <div class="column-header">
                        <div class="d-flex align-items-center">
                            <h6 class="mb-0 fw-bold">In Progress</h6>
                            <span class="badge bg-primary" style="margin-left: 0.75rem;">@Model.InProgressTasks.Count</span>
                        </div>
                        <button class="btn btn-sm btn-link text-muted column-add-btn" data-status="InProgress">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                    <div class="column-cards" id="column-inprogress-full">
                        @foreach (var task in Model.InProgressTasks.OrderBy(t => t.Order))
                        {
                            <partial name="_TaskCard" model="task" />
                        }
                    </div>
                </div>

                <!-- Review Column -->
                <div class="kanban-column" data-status="Review">
                    <div class="column-header">
                        <div class="d-flex align-items-center">
                            <h6 class="mb-0 fw-bold">Review</h6>
                            <span class="badge bg-warning" style="margin-left: 0.75rem;">@Model.ReviewTasks.Count</span>
                        </div>
                        <button class="btn btn-sm btn-link text-muted column-add-btn" data-status="Review">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                    <div class="column-cards" id="column-review-full">
                        @foreach (var task in Model.ReviewTasks.OrderBy(t => t.Order))
                        {
                            <partial name="_TaskCard" model="task" />
                        }
                    </div>
                </div>

                <!-- Completed Column -->
                <div class="kanban-column" data-status="Completed">
                    <div class="column-header">
                        <div class="d-flex align-items-center">
                            <h6 class="mb-0 fw-bold">Completed</h6>
                            <span class="badge bg-success" style="margin-left: 0.75rem;">@Model.CompletedTasks.Count</span>
                        </div>
                        <button class="btn btn-sm btn-link text-muted column-add-btn" data-status="Completed">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                    <div class="column-cards" id="column-completed-full">
                        @foreach (var task in Model.CompletedTasks.OrderBy(t => t.Order))
                        {
                            <partial name="_TaskCard" model="task" />
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Bottom Navigation Bar -->
    <div class="bottom-navbar">
        <div class="nav-item active" data-view="inbox">
            <i class="fas fa-bars-progress"></i>
            <span>Tasks</span>
        </div>
        <div class="nav-item" data-view="planner">
            <i class="fa-solid fa-calendar-day"></i>
            <span>Planner</span>
        </div>
        <div class="nav-item" data-view="board">
            <i class="fa-solid fa-chart-simple" style="transform: rotate(180deg);"></i>
            <span>Board</span>
        </div>
    </div>
</div>

<!-- Task Details Modal (shared across all views) -->
<div class="task-details-modal" id="taskDetailsModal" style="display: none; border-radius: 12px;">
    <div class="modal-dialog" style="margin-bottom: 1.5rem;">
        <div class="task-details-content">
            <!-- Modal Header -->
            <div class="task-details-header">
                <div class="task-details-header-left">
                    <div class="task-status-dropdown">
                        <select class="form-select task-status-select" id="statusDropdown">
                            <option value="Pending">Planned</option>
                            <option value="InProgress">In Progress</option>
                            <option value="Review">Review</option>
                            <option value="Completed">Completed</option>
                        </select>
                        <i class="fas fa-chevron-down status-dropdown-arrow"></i>
                    </div>
                </div>
                <div class="task-details-header-middle">
                    <div class="header-progress">
                        <div class="progress" style="height: 8px;" id="headerProgressBarContainer">
                            <div class="progress-bar" style="width: 0%" id="headerProgressBar"></div>
                        </div>
                        <span class="progress-text" style="font-size: 0.875rem; font-weight: 500; color: #6b7280;" id="headerProgressText">0%</span>
                    </div>
                </div>
                <div class="task-details-header-right">
                    <button class="btn btn-sm btn-link task-header-btn">
                        <i class="fas fa-bell"></i>
                    </button>
                    <button class="btn btn-sm btn-link task-header-btn" id="headerAttachmentBtn">
                        <i class="fas fa-paperclip"></i>
                    </button>
                    <button class="btn btn-sm btn-link task-header-btn">
                        <i class="fas fa-ellipsis-h"></i>
                    </button>
                    <button type="button" class="btn-close" id="closeTaskModal" aria-label="Close"></button>
                </div>
            </div>

            <!-- Task Title -->
            <div class="task-details-title-section">
                <div class="task-title-container">
                    <i class="fa-solid fa-circle-question task-title-icon" id="taskTitleIcon"></i>
                    <h2 class="task-title" contenteditable="true" data-placeholder="Enter task title..."></h2>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="task-action-buttons">
                <button class="btn btn-sm btn-outline-secondary task-action-btn" id="scroll-status-btn" style="font-size: 0.875rem; border-radius: 0.5rem;">
                    <i class="fas fa-clock"></i> Status
                </button>
                <button class="btn btn-sm btn-outline-secondary task-action-btn" id="scroll-priority-btn" style="font-size: 0.875rem; border-radius: 0.5rem;">
                    <i class="fas fa-exclamation-circle"></i> Priority
                </button>
                <button class="btn btn-sm btn-outline-secondary task-action-btn" id="scroll-dates-btn" style="font-size: 0.875rem; border-radius: 0.5rem;">
                    <i class="fa-solid fa-calendar-day"></i> Dates
                </button>
                <button class="btn btn-sm btn-outline-secondary task-action-btn" id="scroll-checklist-btn" style="font-size: 0.875rem; border-radius: 0.5rem;">
                    <i class="fas fa-check-square"></i> Subtasks
                </button>
                <button class="btn btn-sm btn-outline-secondary task-action-btn" id="scroll-attachment-btn" style="font-size: 0.875rem; border-radius: 0.5rem;">
                    <i class="fas fa-paperclip"></i> Attachments
                </button>
                <button class="btn btn-sm btn-outline-secondary task-action-btn" id="scroll-location-btn" style="border-radius: 0.5rem;">
                    <i class="fas fa-map-marker-alt"></i> Location
                </button>
            </div>

            <!-- Assignees -->
            <div class="task-meta-section">
                <div class="task-members">
                    <span class="task-meta-label">Assignees</span>
                    <div class="task-assignees-container" id="taskAssigneesContainer">
                        <!-- Assignees will be dynamically rendered here -->
                    </div>
                    <button class="btn btn-sm btn-outline-secondary add-member-btn" id="addTaskAssigneeBtn">
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="task-details-body">
                <!-- Left Panel -->
                <div class="task-details-left">
                    <!-- Description Section -->
                    <div class="task-section">
                        <div class="task-section-header">
                            <h6 class="task-section-title">
                                <i class="fas fa-bars"></i> Description
                            </h6>
                        </div>
                        <div class="task-section-content">
                            <textarea class="form-control task-description-textarea" rows="4" placeholder="Add a description for this task..." style="font-size: 0.875rem;"></textarea>
                        </div>
                    </div>

                    <!-- Status and Priority Section -->
                    <div class="task-section" id="status-priority-section">
                        <div class="task-section-header">
                            <h6 class="task-section-title">
                                <i class="fas fa-cog"></i> Status & Priority
                            </h6>
                        </div>
                        <div class="task-section-content">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold status-priority-label" style="font-size: 0.875rem;" id="status-label">
                                        <i class="fas fa-clock me-2" style="color: #3d1019;"></i>
                                        Status
                                    </label>
                                    <select class="form-select status-field" style="font-size: 0.875rem;" id="status-field">
                                        <option value="Pending" selected>Planned</option>
                                        <option value="InProgress">In Progress</option>
                                        <option value="Review">Review</option>
                                        <option value="Completed">Completed</option>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold status-priority-label" style="font-size: 0.875rem;" id="priority-label">
                                        <i class="fas fa-exclamation-circle me-2" style="color: #3d1019;"></i>
                                        Priority
                                    </label>
                                    <select class="form-select priority-field" style="font-size: 0.875rem;" id="priority-field">
                                        <option value="">Select priority</option>
                                        <option value="Low">Low</option>
                                        <option value="Medium">Medium</option>
                                        <option value="High">High</option>
                                        <option value="Critical">Critical</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Dates Section -->
                    <div class="task-section" id="dates-section">
                        <div class="task-section-header">
                            <h6 class="task-section-title">
                                <i class="fa-solid fa-calendar-day"></i> Dates
                            </h6>
                        </div>
                        <div class="task-section-content">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold status-priority-label" style="font-size: 0.875rem;" id="start-date-label">
                                        <i class="fa-solid fa-calendar-day me-2" style="color: #3d1019;"></i>
                                        Start Date
                                    </label>
                                    <input type="date" class="form-control dates-field" style="font-size: 0.875rem;" id="start-date-field" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold status-priority-label" style="font-size: 0.875rem;" id="due-date-label">
                                        <i class="fa-solid fa-calendar-day me-2" style="color: #3d1019;"></i>
                                        Due Date
                                    </label>
                                    <input type="date" class="form-control dates-field" style="font-size: 0.875rem;" id="due-date-field" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Subtasks Section -->
                    <div class="task-section" id="checklist-section">
                        <div class="task-section-header">
                            <h6 class="task-section-title">
                                <i class="fas fa-check-square"></i> Subtasks
                            </h6>
                            <button class="btn btn-sm btn-outline-secondary edit-btn" id="addSubtaskBtn" style="border-radius: 0.5rem;">
                                <i class="fas fa-plus"></i> Add subtask
                            </button>
                        </div>
                        <div class="task-section-content">
                            <div class="checklist-progress">
                                <div class="progress">
                                    <div class="progress-bar" style="width: 0%" id="subtaskProgressBar"></div>
                                </div>
                                <span class="progress-text" id="subtaskProgressText">0%</span>
                            </div>
                            <div class="checklist-items" id="subtasksList">
                                <!-- Subtasks will be rendered here dynamically -->
                            </div>
                        </div>
                    </div>

                    <!-- Attachments Section -->
                    <div class="task-section" id="attachments-section">
                        <div class="task-section-header">
                            <h6 class="task-section-title">
                                <i class="fas fa-paperclip"></i> Attachments
                            </h6>
                        </div>
                        <div class="task-section-content">
                            <div class="attachments-container">
                                <button class="attachment-upload-btn">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                    <span>Upload files</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Location Section -->
                    <div class="task-section" id="location-section" style="margin-bottom: 0;">
                        <div class="task-section-header">
                            <h6 class="task-section-title">
                                <i class="fas fa-map-marker-alt"></i> Location
                            </h6>
                        </div>
                        <div class="task-section-content">
                            <div class="location-container">
                                <div class="location-search">
                                    <div class="search-input-group">
                                        <input type="text" class="form-control location-search-input" 
                                               placeholder="Start typing a location..." 
                                               id="locationSearchInput"
                                               autocomplete="off">
                                    </div>
                                </div>
                                <div class="location-display" id="locationDisplay" style="display: none;">
                                    <div class="location-info">
                                        <p class="location-address" id="locationAddress"></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Panel - Activity Log -->
                <div class="task-details-right">
                    <div class="task-section">
                        <div class="task-section-header">
                            <h6 class="task-section-title">
                                <i class="fas fa-comment-dots"></i> Activity
                            </h6>
                        </div>
                        <div class="task-section-content">
                            <div class="comment-input-section">
                                <textarea class="form-control comment-input" placeholder="Add a comment..." rows="2" id="commentInput"></textarea>
                                <button class="btn btn-primary btn-sm mt-2" id="addCommentBtn">
                                    <i class="fas fa-paper-plane"></i> Add Comment
                                </button>
                            </div>
                            <div class="activity-log" id="commentsList">
                                <!-- Comments will be rendered here -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Include the task management scripts -->
<script src="~/js/tasks.js"></script>
<script>
    // Initialize task modal functionality for Matter Tasks
    document.addEventListener('DOMContentLoaded', function() {
        // Make sure the modal opens when clicking "Add a task" button
        const addTaskButton = document.getElementById('addTaskButton');
        const addFirstTaskButton = document.getElementById('addFirstTaskButton');
        
        if (addTaskButton) {
            addTaskButton.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                openTaskModal(null, 'Pending'); // null taskId means create new
            });
        }
        
        if (addFirstTaskButton) {
            addFirstTaskButton.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                openTaskModal(null, 'Pending');
            });
        }
    });
</script>
