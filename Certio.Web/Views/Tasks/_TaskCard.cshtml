@model Certio.Web.ViewModels.TaskItemViewModel

@functions {
    string GetPriorityStyles(string priority)
    {
        return priority switch
        {
            "Critical" => "color: #dc3545; background-color: #f5b7b1;",
            "High" => "color: #fd7e14; background-color: #ffeaa7;",
            "Medium" => "color: #0d6efd; background-color: #cfe2ff;",
            "Low" => "color: #6c757d; background-color: #e9ecef;",
            _ => "color: #6c757d; background-color: #e9ecef;"
        };
    }
}

<div class="task-card" data-task-id="@Model.Id" data-matter-id="@Model.MatterId" draggable="true">
    <div class="task-card-header">
        <div class="form-check">
            <input class="form-check-input card-checkbox" type="checkbox" 
                   id="card-task-@Model.Id" 
                   data-task-id="@Model.Id"
                   @(Model.Status == "Completed" ? "checked" : "")>
        </div>
        <span class="badge matter-priority-badge" style="@GetPriorityStyles(Model.Priority); font-size: 0.7rem;">@Model.Priority</span>
    </div>
    
    <div class="task-card-body" onclick="openTaskModal(@Model.Id)">
        <h6 class="task-card-title">@Model.Title</h6>
        
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="task-card-description">@Model.Description</p>
        }
        
        @if (Model.TotalSubTasks > 0)
        {
            <div class="task-card-meta">
                <div class="task-progress">
                    <i class="fas fa-check-square"></i>
                    <span>@Model.CompletedSubTasks/@Model.TotalSubTasks</span>
                    <div class="progress">
                        <div class="progress-bar" role="progressbar" 
                             style="width: @Model.ProgressPercentage" 
                             aria-valuenow="@Model.CompletedSubTasks" 
                             aria-valuemin="0" 
                             aria-valuemax="@Model.TotalSubTasks"></div>
                    </div>
                    @if (Model.UrgentSubTasksCount > 0)
                    {
                        <div class="urgent-subtasks-badge" title="@Model.UrgentSubTasksCount subtask(s) due today or tomorrow">
                            @Model.UrgentSubTasksCount
                        </div>
                    }
                </div>
            </div>
        }
        
        <div class="task-card-footer">
            @if (Model.DueDate.HasValue)
            {
                var daysUntilDue = (Model.DueDate.Value - DateTime.UtcNow).Days;
                var dateClass = daysUntilDue < 0 ? "overdue" : (daysUntilDue <= 1 ? "text-dark" : "text-muted");
                <div class="task-due @(daysUntilDue < 0 ? "overdue" : "")">
                    <i class="fa-solid fa-calendar-day"></i>
                    <span class="@dateClass">@Model.DueDateFormatted</span>
                </div>
            }
            else
            {
                <div></div>
            }
            
            @if (Model.Assignments.Any())
            {
                <div class="task-assignees">
                    @foreach (var assignment in Model.Assignments.Take(2))
                    {
                        <div class="assignee-avatar" title="@assignment.UserName">
                            @assignment.UserInitials
                        </div>
                    }
                    @if (Model.Assignments.Count > 2)
                    {
                        <div class="assignee-avatar">
                            +@(Model.Assignments.Count - 2)
                        </div>
                    }
                </div>
            }
            else
            {
                <div></div>
            }
        </div>
    </div>
</div>

