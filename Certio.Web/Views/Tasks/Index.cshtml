        <!-- Board View -->
        <div class="view-container" id="boardView">
            <div class="kanban-board-container">
                <div class="kanban-board" id="kanbanBoardFull">
                    <!-- Planned Column -->
                    <div class="kanban-column" data-status="Pending">
                        <div class="column-header">
                            <div class="d-flex align-items-center">
                                <h6 class="mb-0 fw-bold">Planned</h6>
                                <span class="badge bg-secondary" style="margin-left: 0.75rem;">@Model.PlannedTasks.Count</span>
                            </div>
                            <button class="btn btn-sm btn-link text-muted column-add-btn" data-status="Pending">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <div class="column-cards" id="column-pending-full">
                            @foreach (var task in Model.PlannedTasks.OrderBy(t => t.Order))
                            {
                                <partial name="_TaskCard" model="task" />
                            }
                        </div>
                    </div>

                    <!-- In Progress Column -->
                    <div class="kanban-column" data-status="InProgress">
                        <div class="column-header">
                            <div class="d-flex align-items-center">
                                <h6 class="mb-0 fw-bold">In Progress</h6>
                                <span class="badge bg-primary" style="margin-left: 0.75rem;">@Model.InProgressTasks.Count</span>
                            </div>
                            <button class="btn btn-sm btn-link text-muted column-add-btn" data-status="InProgress">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <div class="column-cards" id="column-inprogress-full">
                            @foreach (var task in Model.InProgressTasks.OrderBy(t => t.Order))
                            {
                                <partial name="_TaskCard" model="task" />
                            }
                        </div>
                    </div>

                    <!-- Review Column -->
                    <div class="kanban-column" data-status="Review">
                        <div class="column-header">
                            <div class="d-flex align-items-center">
                                <h6 class="mb-0 fw-bold">Review</h6>
                                <span class="badge bg-warning" style="margin-left: 0.75rem;">@Model.ReviewTasks.Count</span>
                            </div>
                            <button class="btn btn-sm btn-link text-muted column-add-btn" data-status="Review">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <div class="column-cards" id="column-review-full">
                            @foreach (var task in Model.ReviewTasks.OrderBy(t => t.Order))
                            {
                                <partial name="_TaskCard" model="task" />
                            }
                        </div>
                    </div>

                    <!-- Completed Column -->
                    <div class="kanban-column" data-status="Completed">
                        <div class="column-header">
                            <div class="d-flex align-items-center">
                                <h6 class="mb-0 fw-bold">Completed</h6>
                                <span class="badge bg-success" style="margin-left: 0.75rem;">@Model.CompletedTasks.Count</span>
                            </div>
                            <button class="btn btn-sm btn-link text-muted column-add-btn" data-status="Completed">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <div class="column-cards" id="column-completed-full">
                            @foreach (var task in Model.CompletedTasks.OrderBy(t => t.Order))
                            {
                                <partial name="_TaskCard" model="task" />
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Task Details Modal -->
        <div class="task-details-modal" id="taskDetailsModal" style="display: none; border-radius: 12px;">
            <div class="modal-dialog">
                <div class="task-details-content">
                    <!-- Modal Header -->
                    <div class="task-details-header">
                        <div class="task-details-header-left">
                            <div class="task-status-dropdown">
                                <select class="form-select task-status-select">
                                    <option value="Pending">Planned</option>
                                    <option value="InProgress">In Progress</option>
                                    <option value="Review">Review</option>
                                    <option value="Completed">Completed</option>
                                </select>
                            </div>
                        </div>
                        <div class="task-details-header-right">
                            <button class="btn btn-sm btn-link task-header-btn">
                                <i class="fas fa-bell"></i>
                            </button>
                            <button class="btn btn-sm btn-link task-header-btn">
                                <i class="fas fa-paperclip"></i>
                            </button>
                            <button class="btn btn-sm btn-link task-header-btn">
                                <i class="fas fa-ellipsis-h"></i>
                            </button>
                            <button type="button" class="btn-close" id="closeTaskModal" aria-label="Close"></button>
                        </div>
                    </div>

                    <!-- Task Title -->
                    <div class="task-details-title-section">
                        <div class="task-title-container">
                            <i class="fas fa-check-circle task-title-icon"></i>
                            <h2 class="task-title" contenteditable="true">Draft Founder Agreement & IP Assignment (4-yr vest, 1-yr cliff)</h2>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="task-action-buttons">
                        <button class="btn btn-sm btn-outline-secondary task-action-btn">
                            <i class="fas fa-plus"></i> Add
                        </button>
                        <button class="btn btn-sm btn-outline-secondary task-action-btn">
                            <i class="fas fa-clock"></i> Dates
                        </button>
                        <button class="btn btn-sm btn-outline-secondary task-action-btn">
                            <i class="fas fa-check-square"></i> Checklist
                        </button>
                        <button class="btn btn-sm btn-outline-secondary task-action-btn">
                            <i class="fas fa-paperclip"></i> Attachment
                        </button>
                        <button class="btn btn-sm btn-outline-secondary task-action-btn">
                            <i class="fas fa-map-marker-alt"></i> Location
                        </button>
                    </div>

                    <!-- Members and Labels -->
                    <div class="task-meta-section">
                        <div class="task-members">
                            <span class="task-meta-label">Members</span>
                            <div class="member-avatar">CT</div>
                            <button class="btn btn-sm btn-outline-secondary add-member-btn">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                        <div class="task-labels">
                            <span class="task-meta-label">Labels</span>
                            <div class="task-label green-label">Label</div>
                            <button class="btn btn-sm btn-outline-secondary add-label-btn">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Main Content Area -->
                    <div class="task-details-body">
                        <!-- Left Panel -->
                        <div class="task-details-left">
                            <!-- Description Section -->
                            <div class="task-section">
                                <div class="task-section-header">
                                    <h6 class="task-section-title">
                                        <i class="fas fa-bars"></i> Description
                                    </h6>
                                    <button class="btn btn-sm btn-link edit-btn">Edit</button>
                                </div>
                                <div class="task-section-content">
                                    <p class="task-description">Test description for this task</p>
                                </div>
                            </div>

                            <!-- Custom Fields Section -->
                            <div class="task-section">
                                <div class="task-section-header">
                                    <h6 class="task-section-title">
                                        <i class="fas fa-table"></i> Custom Fields
                                    </h6>
                                    <button class="btn btn-sm btn-link edit-btn">Edit</button>
                                </div>
                                <div class="task-section-content">
                                    <div class="custom-field">
                                        <label class="custom-field-label">Priority</label>
                                        <select class="form-select custom-field-select priority-select">
                                            <option value="Low">Low</option>
                                            <option value="Medium">Medium</option>
                                            <option value="High">High</option>
                                            <option value="Highest" selected>Highest</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- Checklist Section -->
                            <div class="task-section">
                                <div class="task-section-header">
                                    <h6 class="task-section-title">
                                        <i class="fas fa-check-square"></i> Checklist
                                    </h6>
                                </div>
                                <div class="task-section-content">
                                    <div class="checklist-progress">
                                        <div class="progress">
                                            <div class="progress-bar" style="width: 33%"></div>
                                        </div>
                                        <span class="progress-text">33%</span>
                                    </div>
                                    <div class="checklist-items">
                                        <div class="checklist-item completed">
                                            <input type="checkbox" class="form-check-input" checked>
                                            <label class="form-check-label">fadefeqtfeg</label>
                                        </div>
                                        <div class="checklist-item">
                                            <input type="checkbox" class="form-check-input">
                                            <label class="form-check-label">geqwwgeg</label>
                                        </div>
                                    </div>
                                    <div class="checklist-actions">
                                        <button class="btn btn-sm btn-link">Hide checked items</button>
                                        <button class="btn btn-sm btn-link text-danger">Delete</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Panel -->
                        <div class="task-details-right">
                            <div class="comments-section">
                                <div class="comments-header">
                                    <h6 class="comments-title">
                                        <i class="fas fa-comment"></i> Comments and activity
                                    </h6>
                                    <button class="btn btn-sm btn-link">Show details</button>
                                </div>
                                <div class="comment-input-section">
                                    <textarea class="form-control comment-input" placeholder="Write a comment..."></textarea>
                                </div>
                                <div class="activity-log">
                                    <div class="activity-item">
                                        <div class="activity-avatar">K</div>
                                        <div class="activity-content">
                                            <span class="activity-text">
                                                <strong>kylezwang</strong> added this card to <strong>Planned</strong>
                                            </span>
                                            <div class="activity-time">Sep 25, 2025, 9:48 PM</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Navigation Bar -->
    <div class="bottom-navbar">
        <div class="nav-item multi-active" data-view="inbox">
            <i class="fas fa-bars-progress"></i>
            <span>Tasks</span>
        </div>
        <div class="nav-item multi-active" data-view="planner">
            <i class="fas fa-calendar"></i>
            <span>Planner</span>
        </div>
        <div class="nav-item multi-active" data-view="board">
            <i class="fa-solid fa-chart-simple" style="transform: rotate(180deg);"></i>
            <span>Board</span>
        </div>
        <div class="nav-item" data-view="switch">
            <i class="bi bi-stack"></i>
            <span>Switch Matters</span>
        </div>
    </div>
</div>

<!-- Task Detail Modal -->
<div class="modal fade" id="taskDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold" id="taskDetailTitle">Task Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="taskDetailContent">
                    <!-- Content will be loaded dynamically -->
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script src="~/js/tasks.js"></script>
    <script>
        // Pass model data to JavaScript
        window.tasksData = {
            matters: @Html.Raw(Json.Serialize(Model.Matters)),
            users: @Html.Raw(Json.Serialize(Model.Users))
        };

        // Task Details Modal functionality
        document.addEventListener('DOMContentLoaded', function() {
            const addTaskButton = document.getElementById('addTaskButton');
            const taskDetailsModal = document.getElementById('taskDetailsModal');
            const closeTaskModal = document.getElementById('closeTaskModal');
            
            if (addTaskButton) {
                addTaskButton.addEventListener('click', function() {
                    taskDetailsModal.style.display = 'flex';
                });
            }
            
            if (closeTaskModal) {
                closeTaskModal.addEventListener('click', function() {
                    taskDetailsModal.style.display = 'none';
                });
            }
            
            // Close modal when clicking outside
            if (taskDetailsModal) {
                taskDetailsModal.addEventListener('click', function(e) {
                    if (e.target === taskDetailsModal) {
                        taskDetailsModal.style.display = 'none';
                    }
                });
            }
            
            // Handle checklist item interactions
            const checklistItems = document.querySelectorAll('.checklist-item input[type="checkbox"]');
            checklistItems.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    updateChecklistProgress();
                });
            });
            
            function updateChecklistProgress() {
                const totalItems = document.querySelectorAll('.checklist-item').length;
                const completedItems = document.querySelectorAll('.checklist-item.completed').length;
                const progressPercentage = totalItems > 0 ? Math.round((completedItems / totalItems) * 100) : 0;
                
                const progressBar = document.querySelector('.progress-bar');
                const progressText = document.querySelector('.progress-text');
                
                if (progressBar) {
                    progressBar.style.width = progressPercentage + '%';
                }
                if (progressText) {
                    progressText.textContent = progressPercentage + '%';
                }
            }
            
            // Handle task title editing
            const taskTitle = document.querySelector('.task-title');
            if (taskTitle) {
                taskTitle.addEventListener('blur', function() {
                    // Save title changes here
                    console.log('Task title updated:', this.textContent);
                });
            }
            
            // Handle comment submission
            const commentInput = document.querySelector('.comment-input');
            if (commentInput) {
                commentInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' && e.ctrlKey) {
                        // Submit comment
                        const comment = this.value.trim();
                        if (comment) {
                            addComment(comment);
                            this.value = '';
                        }
                    }
                });
            }
            
            function addComment(commentText) {
                const activityLog = document.querySelector('.activity-log');
                if (activityLog) {
                    const newActivityItem = document.createElement('div');
                    newActivityItem.className = 'activity-item';
                    newActivityItem.innerHTML = `
                        <div class="activity-avatar">U</div>
                        <div class="activity-content">
                            <span class="activity-text">
                                <strong>You</strong> commented: ${commentText}
                            </span>
                            <div class="activity-time">${new Date().toLocaleString()}</div>
                        </div>
                    `;
                    activityLog.insertBefore(newActivityItem, activityLog.firstChild);
                }
            }
        });

        // Bottom navbar multi-view toggle functionality
        document.addEventListener('DOMContentLoaded', function() {
            // Ensure conversations are loaded for the Tasks page
            setTimeout(function() {
                if (typeof loadConversationsForPanel === 'function') {
                    console.log('Tasks page: Loading conversations...');
                    loadConversationsForPanel();
                } else {
                    console.error('Tasks page: loadConversationsForPanel function not available');
                }
            }, 100); // Small delay to ensure chat.js is loaded
            
            const navItems = document.querySelectorAll('.bottom-navbar .nav-item');
            const viewContainers = document.querySelectorAll('.view-container');
            const tasksContent = document.querySelector('.tasks-content');
            
            // Track active views
            let activeViews = new Set(['inbox', 'planner', 'board']); // Default to all views
            
            // Initialize the layout
            updateViewLayout();

            navItems.forEach(item => {
                item.addEventListener('click', function() {
                    const view = this.getAttribute('data-view');
                    
                    // Skip switch matters for now
                    if (view === 'switch') {
                        return;
                    }
                    
                    // Toggle the view
                    if (activeViews.has(view)) {
                        // If it's the only active view, don't remove it
                        if (activeViews.size === 1) {
                            return;
                        }
                        activeViews.delete(view);
                    } else {
                        activeViews.add(view);
                    }
                    
                    updateViewLayout();
                });
            });
            
            function updateViewLayout() {
                // Update navbar visual state
                navItems.forEach(nav => {
                    const view = nav.getAttribute('data-view');
                    nav.classList.remove('active', 'multi-active');
                    
                    if (activeViews.has(view)) {
                        if (activeViews.size === 1) {
                            nav.classList.add('active');
                        } else {
                            nav.classList.add('multi-active');
                        }
                    }
                });
                
                // Update view containers visibility
                viewContainers.forEach(container => {
                    container.classList.add('d-none');
                });
                
                // Show active views
                activeViews.forEach(view => {
                    const targetView = document.getElementById(view + 'View');
                    if (targetView) {
                        targetView.classList.remove('d-none');
                    }
                });
                
                // Update layout classes
                tasksContent.classList.remove('multi-view', 'inbox-planner', 'inbox-board', 'planner-board', 'all-views');
                
                if (activeViews.size > 1) {
                    tasksContent.classList.add('multi-view');
                    
                    // Apply specific layout classes based on active views
                    const viewsArray = Array.from(activeViews);
                    
                    if (viewsArray.length === 2) {
                        if (viewsArray.includes('inbox') && viewsArray.includes('planner')) {
                            tasksContent.classList.add('inbox-planner');
                        } else if (viewsArray.includes('inbox') && viewsArray.includes('board')) {
                            tasksContent.classList.add('inbox-board');
                        } else if (viewsArray.includes('planner') && viewsArray.includes('board')) {
                            tasksContent.classList.add('planner-board');
                        }
                    } else if (viewsArray.length === 3) {
                        tasksContent.classList.add('all-views');
                    }
                }
                
                // Update floating actions positioning
                updateFloatingActionsPosition();
            }

            // Calendar navigation functionality
            const prevWeekBtn = document.getElementById('prevWeekBtn');
            const nextWeekBtn = document.getElementById('nextWeekBtn');
            const todayBtn = document.getElementById('todayBtn');

            if (prevWeekBtn) {
                prevWeekBtn.addEventListener('click', function() {
                    // TODO: Implement previous week navigation
                    console.log('Previous week clicked');
                });
            }

            if (nextWeekBtn) {
                nextWeekBtn.addEventListener('click', function() {
                    // TODO: Implement next week navigation
                    console.log('Next week clicked');
                });
            }

            if (todayBtn) {
                todayBtn.addEventListener('click', function() {
                    // TODO: Implement jump to today
                    console.log('Today clicked');
                });
            }

            // Adaptive floating actions positioning
            function updateFloatingActionsPosition() {
                const floatingActions = document.querySelector('.floating-actions');
                if (!floatingActions) return;

                // Get the tasks page container
                const tasksPage = document.querySelector('.tasks-page');
                if (!tasksPage) return;

                // Check if we're in multi-view mode
                const isMultiView = tasksContent.classList.contains('multi-view');
                
                if (isMultiView) {
                    // In multi-view mode, center within the inbox view
                    const inboxView = document.getElementById('inboxView');
                    if (inboxView) {
                        const rect = inboxView.getBoundingClientRect();
                        const centerX = rect.left + (rect.width / 2);
                        floatingActions.style.left = centerX + 'px';
                        floatingActions.style.transform = 'translateX(-50%)';
                    }
                } else {
                    // In single view mode, center within the full content area
                    const rect = tasksPage.getBoundingClientRect();
                    const centerX = rect.left + (rect.width / 2);
                    floatingActions.style.left = centerX + 'px';
                    floatingActions.style.transform = 'translateX(-50%)';
                }
            }

            // Adaptive navbar positioning (original behavior)
            function updateNavbarPosition() {
                const navbar = document.querySelector('.bottom-navbar');
                if (!navbar) return;

                // Get the tasks page container
                const tasksPage = document.querySelector('.tasks-page');
                if (!tasksPage) return;

                // Calculate the center of the visible content area
                const rect = tasksPage.getBoundingClientRect();
                const centerX = rect.left + (rect.width / 2);
                
                // Set the navbar position to the center of the content area
                navbar.style.left = centerX + 'px';
            }

            // Update on load and resize
            updateNavbarPosition();
            updateFloatingActionsPosition();
            window.addEventListener('resize', function() {
                updateNavbarPosition();
                updateFloatingActionsPosition();
            });
            
            // Update when layout changes (e.g., sidebar toggles)
            const resizeObserver = new ResizeObserver(function() {
                updateNavbarPosition();
                updateFloatingActionsPosition();
            });
            const tasksPage = document.querySelector('.tasks-page');
            if (tasksPage) {
                resizeObserver.observe(tasksPage);
            }

            // Also observe the main content container in case it changes
            const mainContent = document.querySelector('.main-content, .content-wrapper, main');
            if (mainContent) {
                resizeObserver.observe(mainContent);
            }

            // Kanban board vertical-to-horizontal scroll functionality
            const kanbanBoardContainer = document.querySelector('.kanban-board-container');
            if (kanbanBoardContainer) {
                let isScrolling = false;
                
                kanbanBoardContainer.addEventListener('wheel', function(e) {
                    // Only handle vertical scroll events
                    if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
                        e.preventDefault();
                        
                        // Convert vertical scroll to horizontal scroll
                        const scrollAmount = e.deltaY;
                        kanbanBoardContainer.scrollLeft += scrollAmount;
                        
                        // Add smooth scrolling effect
                        if (!isScrolling) {
                            isScrolling = true;
                            kanbanBoardContainer.style.scrollBehavior = 'smooth';
                            
                            setTimeout(() => {
                                isScrolling = false;
                                kanbanBoardContainer.style.scrollBehavior = 'auto';
                            }, 150);
                        }
                    }
                }, { passive: false });
            }
        });
    </script>
}


