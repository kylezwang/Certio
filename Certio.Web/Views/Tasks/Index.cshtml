<!-- Task Detail Modal -->
<div class="modal fade" id="taskDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold" id="taskDetailTitle">Task Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="taskDetailContent">
                    <!-- Content will be loaded dynamically -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Task Modal -->
<div class="modal fade" id="taskFormModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="taskFormModalTitle">Add Task</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="taskForm">
                <div class="modal-body">
                    <input type="hidden" id="taskId" name="id">
                    <div class="mb-3">
                        <label for="taskMatter" class="form-label">Matter</label>
                        <select class="form-select" id="taskMatter" name="matterId" required>
                            <option value="">Select Matter</option>
                            @foreach (var matter in Model.Matters)
                            {
                                <option value="@matter.Id">@matter.Title</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="taskTitle" class="form-label">Title</label>
                        <input type="text" class="form-control" id="taskTitle" name="title" required>
                    </div>
                    <div class="mb-3">
                        <label for="taskDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="taskDescription" name="description" rows="3"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="taskPriority" class="form-label">Priority</label>
                            <select class="form-select" id="taskPriority" name="priority">
                                <option value="Low">Low</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="High">High</option>
                                <option value="Critical">Critical</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="taskDueDate" class="form-label">Due Date</label>
                            <input type="date" class="form-control" id="taskDueDate" name="dueDate">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="taskStatus" class="form-label">Status</label>
                        <select class="form-select" id="taskStatus" name="status">
                            <option value="Pending">Planned</option>
                            <option value="InProgress">In Progress</option>
                            <option value="Review">Review</option>
                            <option value="Completed">Completed</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Task</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script src="~/js/tasks.js"></script>
    <script>
        // Pass model data to JavaScript
        window.tasksData = {
            matters: @Html.Raw(Json.Serialize(Model.Matters)),
            users: @Html.Raw(Json.Serialize(Model.Users))
        };

        // Bottom navbar multi-view toggle functionality
        document.addEventListener('DOMContentLoaded', function() {
            // Ensure conversations are loaded for the Tasks page
            setTimeout(function() {
                if (typeof loadConversationsForPanel === 'function') {
                    console.log('Tasks page: Loading conversations...');
                    loadConversationsForPanel();
                } else {
                    console.error('Tasks page: loadConversationsForPanel function not available');
                }
            }, 100); // Small delay to ensure chat.js is loaded
            
            const navItems = document.querySelectorAll('.bottom-navbar .nav-item');
            const viewContainers = document.querySelectorAll('.view-container');
            const tasksContent = document.querySelector('.tasks-content');
            
            // Track active views
            let activeViews = new Set(['inbox', 'planner', 'board']); // Default to all views
            
            // Initialize the layout
            updateViewLayout();

            navItems.forEach(item => {
                item.addEventListener('click', function() {
                    const view = this.getAttribute('data-view');
                    
                    // Skip switch matters for now
                    if (view === 'switch') {
                        return;
                    }
                    
                    // Toggle the view
                    if (activeViews.has(view)) {
                        // If it's the only active view, don't remove it
                        if (activeViews.size === 1) {
                            return;
                        }
                        activeViews.delete(view);
                    } else {
                        activeViews.add(view);
                    }
                    
                    updateViewLayout();
                });
            });
            
            function updateViewLayout() {
                // Update navbar visual state
                navItems.forEach(nav => {
                    const view = nav.getAttribute('data-view');
                    nav.classList.remove('active', 'multi-active');
                    
                    if (activeViews.has(view)) {
                        if (activeViews.size === 1) {
                            nav.classList.add('active');
                        } else {
                            nav.classList.add('multi-active');
                        }
                    }
                });
                
                // Update view containers visibility
                viewContainers.forEach(container => {
                    container.classList.add('d-none');
                });
                
                // Show active views
                activeViews.forEach(view => {
                    const targetView = document.getElementById(view + 'View');
                    if (targetView) {
                        targetView.classList.remove('d-none');
                    }
                });
                
                // Update layout classes
                tasksContent.classList.remove('multi-view', 'inbox-planner', 'inbox-board', 'planner-board', 'all-views');
                
                if (activeViews.size > 1) {
                    tasksContent.classList.add('multi-view');
                    
                    // Apply specific layout classes based on active views
                    const viewsArray = Array.from(activeViews);
                    
                    if (viewsArray.length === 2) {
                        if (viewsArray.includes('inbox') && viewsArray.includes('planner')) {
                            tasksContent.classList.add('inbox-planner');
                        } else if (viewsArray.includes('inbox') && viewsArray.includes('board')) {
                            tasksContent.classList.add('inbox-board');
                        } else if (viewsArray.includes('planner') && viewsArray.includes('board')) {
                            tasksContent.classList.add('planner-board');
                        }
                    } else if (viewsArray.length === 3) {
                        tasksContent.classList.add('all-views');
                    }
                }
                
                // Update floating actions positioning
                updateFloatingActionsPosition();
            }

            // Calendar navigation functionality
            const prevWeekBtn = document.getElementById('prevWeekBtn');
            const nextWeekBtn = document.getElementById('nextWeekBtn');
            const todayBtn = document.getElementById('todayBtn');

            if (prevWeekBtn) {
                prevWeekBtn.addEventListener('click', function() {
                    // TODO: Implement previous week navigation
                    console.log('Previous week clicked');
                });
            }

            if (nextWeekBtn) {
                nextWeekBtn.addEventListener('click', function() {
                    // TODO: Implement next week navigation
                    console.log('Next week clicked');
                });
            }

            if (todayBtn) {
                todayBtn.addEventListener('click', function() {
                    // TODO: Implement jump to today
                    console.log('Today clicked');
                });
            }

            // Adaptive floating actions positioning
            function updateFloatingActionsPosition() {
                const floatingActions = document.querySelector('.floating-actions');
                if (!floatingActions) return;

                // Get the tasks page container
                const tasksPage = document.querySelector('.tasks-page');
                if (!tasksPage) return;

                // Check if we're in multi-view mode
                const isMultiView = tasksContent.classList.contains('multi-view');
                
                if (isMultiView) {
                    // In multi-view mode, center within the inbox view
                    const inboxView = document.getElementById('inboxView');
                    if (inboxView) {
                        const rect = inboxView.getBoundingClientRect();
                        const centerX = rect.left + (rect.width / 2);
                        floatingActions.style.left = centerX + 'px';
                        floatingActions.style.transform = 'translateX(-50%)';
                    }
                } else {
                    // In single view mode, center within the full content area
                    const rect = tasksPage.getBoundingClientRect();
                    const centerX = rect.left + (rect.width / 2);
                    floatingActions.style.left = centerX + 'px';
                    floatingActions.style.transform = 'translateX(-50%)';
                }
            }

            // Adaptive navbar positioning (original behavior)
            function updateNavbarPosition() {
                const navbar = document.querySelector('.bottom-navbar');
                if (!navbar) return;

                // Get the tasks page container
                const tasksPage = document.querySelector('.tasks-page');
                if (!tasksPage) return;

                // Calculate the center of the visible content area
                const rect = tasksPage.getBoundingClientRect();
                const centerX = rect.left + (rect.width / 2);
                
                // Set the navbar position to the center of the content area
                navbar.style.left = centerX + 'px';
            }

            // Update on load and resize
            updateNavbarPosition();
            updateFloatingActionsPosition();
            window.addEventListener('resize', function() {
                updateNavbarPosition();
                updateFloatingActionsPosition();
            });
            
            // Update when layout changes (e.g., sidebar toggles)
            const resizeObserver = new ResizeObserver(function() {
                updateNavbarPosition();
                updateFloatingActionsPosition();
            });
            const tasksPage = document.querySelector('.tasks-page');
            if (tasksPage) {
                resizeObserver.observe(tasksPage);
            }

            // Also observe the main content container in case it changes
            const mainContent = document.querySelector('.main-content, .content-wrapper, main');
            if (mainContent) {
                resizeObserver.observe(mainContent);
            }

            // Kanban board vertical-to-horizontal scroll functionality
            const kanbanBoardContainer = document.querySelector('.kanban-board-container');
            if (kanbanBoardContainer) {
                let isScrolling = false;
                
                kanbanBoardContainer.addEventListener('wheel', function(e) {
                    // Only handle vertical scroll events
                    if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
                        e.preventDefault();
                        
                        // Convert vertical scroll to horizontal scroll
                        const scrollAmount = e.deltaY;
                        kanbanBoardContainer.scrollLeft += scrollAmount;
                        
                        // Add smooth scrolling effect
                        if (!isScrolling) {
                            isScrolling = true;
                            kanbanBoardContainer.style.scrollBehavior = 'smooth';
                            
                            setTimeout(() => {
                                isScrolling = false;
                                kanbanBoardContainer.style.scrollBehavior = 'auto';
                            }, 150);
                        }
                    }
                }, { passive: false });
            }
        });
    </script>
}

