@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    @if (ViewBag.GoogleMapsEnabled == true && !string.IsNullOrEmpty(ViewBag.GoogleMapsApiKey))
    {
        <script>
            // Google Maps initialization callback must be defined before async load
            window.initGoogleMaps = function() {
                try {
                    console.log('Google Maps API loaded successfully');
                    window.googleMapsReady = true;
                    setTimeout(function() {
                        if (typeof initializeLocationSearch === 'function') {
                            initializeLocationSearch();
                        } else {
                            console.warn('initializeLocationSearch function not found');
                        }
                    }, 100);
                } catch (err) {
                    console.error('Error in initGoogleMaps:', err);
                }
            }
        </script>
        <script src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey&libraries=places&callback=initGoogleMaps" async defer></script>
    }
    <script src="~/js/tasks.js"></script>
    <script>
        // Make initializeLocationSearch available globally for debugging
        window.initializeLocationSearch = window.initializeLocationSearch || function() {
            console.warn('initializeLocationSearch called but not implemented');
        };
    </script>
    <script>
        // Pass model data to JavaScript
        window.tasksData = {
            matters: @Html.Raw(Json.Serialize(Model.Matters)),
            users: @Html.Raw(Json.Serialize(Model.Users)),
            allTasks: @Html.Raw(Json.Serialize(Model.AllTasks))
        };

        // Task Details Modal functionality
        document.addEventListener('DOMContentLoaded', function() {
            const taskDetailsModal = document.getElementById('taskDetailsModal');
            const closeTaskModal = document.getElementById('closeTaskModal');
            const addTaskButton = document.getElementById('addTaskButton');
            
            // Open modal for creating new task when clicking "Add a task" button
            if (addTaskButton) {
                addTaskButton.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    openTaskModal(null, 'Pending'); // null taskId means create new
                });
            }
            
            // Open modal when clicking on task cards (exclude only direct checkbox clicks)
            const taskCardItems = document.querySelectorAll('.task-card-item');
            taskCardItems.forEach(card => {
                card.addEventListener('click', function(e) {
                    if (e.target.closest('input')) {
                        return; // don't open modal when interacting with checkbox directly
                    }
                    const taskId = this.getAttribute('data-task-id');
                    if (taskId && taskDetailsModal) {
                        // Load task data and open modal in edit mode
                        openTaskModal(parseInt(taskId));
                    }
                });
            });

            // Ensure clicking the label (task text) opens modal
            const taskLabels = document.querySelectorAll('.task-card-item label');
            taskLabels.forEach(label => {
                label.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const taskCard = this.closest('.task-card-item');
                    const taskId = taskCard?.getAttribute('data-task-id');
                    if (taskId && taskDetailsModal) {
                        openTaskModal(parseInt(taskId));
                    }
                });
            });
            
            if (closeTaskModal) {
                closeTaskModal.addEventListener('click', function() {
                    taskDetailsModal.style.display = 'none';
                    resetTaskModal();
                });
            }
            
            // Close modal when clicking on backdrop (outside modal content)
            if (taskDetailsModal) {
                taskDetailsModal.addEventListener('click', function(e) {
                    // Only close if clicking directly on the backdrop (taskDetailsModal itself)
                    if (e.target === taskDetailsModal) {
                        taskDetailsModal.style.display = 'none';
                        resetTaskModal();
                    }
                });
            }
            
            // Initialize save task button
            initializeSaveTask();

            // Initialize matter selector (wrapped to avoid breaking other handlers)
            try {
                initializeMatterSelector();
            } catch (err) {
                console.error('Error initializing matter selector:', err);
            }
        });

        // Matter selection state
        let currentMatterId = null;

        // Initialize Matter Selector
        function initializeMatterSelector() {
            const switchMattersBtn = document.getElementById('switchMattersBtn');
            const matterPopup = document.getElementById('matterPopup');
            const matterItems = document.querySelectorAll('.matter-item');

            // Initialize top matter selector - now uses same popup as bottom navbar
            const topMatterSelectorBtn = document.getElementById('topMatterSelectorBtn');

            // Load saved matter from localStorage or default to "View All Matters"
            const savedMatterId = localStorage.getItem('certio_selected_matter_id');
            if (savedMatterId === 'all') {
                selectMatter('all');
            } else if (savedMatterId && window.tasksData.matters.find(m => m.Id == savedMatterId)) {
                selectMatter(parseInt(savedMatterId));
            } else {
                // Default to "View All Matters" when loading fresh
                selectMatter('all');
            }

            // Toggle popup above navbar
            if (switchMattersBtn && matterPopup) {
                switchMattersBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const isVisible = matterPopup.style.display === 'block' || matterPopup.style.display === 'flex';
                    matterPopup.style.display = isVisible ? 'none' : 'block';
                    // Remove top positioning class for bottom navbar
                    matterPopup.classList.remove('top-positioned');
                    console.log('Bottom navbar clicked - removed top-positioned class');
                    // Trigger custom event for popup positioning system
                    if (!isVisible) {
                        setTimeout(() => {
                            document.dispatchEvent(new CustomEvent('matterPopupShown', { detail: { source: 'bottom' } }));
                        }, 10);
                    }
                });
            }

            // Toggle top matter popup - now uses same popup as bottom navbar
            if (topMatterSelectorBtn && matterPopup) {
                topMatterSelectorBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const isVisible = matterPopup.style.display === 'block' || matterPopup.style.display === 'flex';
                    matterPopup.style.display = isVisible ? 'none' : 'block';
                    // Add top positioning class for top selector
                    matterPopup.classList.add('top-positioned');
                    console.log('Top selector clicked - added top-positioned class');
                    // Trigger custom event for popup positioning system
                    if (!isVisible) {
                        setTimeout(() => {
                            document.dispatchEvent(new CustomEvent('matterPopupShown', { detail: { source: 'top' } }));
                        }, 10);
                    }
                });
            }

            // Close when clicking outside
            document.addEventListener('click', function(e) {
                if (!matterPopup) return;
                const clickInsidePopup = matterPopup.contains(e.target);
                const clickOnSwitchButton = switchMattersBtn && switchMattersBtn.contains(e.target);
                const clickOnTopButton = topMatterSelectorBtn && topMatterSelectorBtn.contains(e.target);
                if (!clickInsidePopup && !clickOnSwitchButton && !clickOnTopButton) {
                    matterPopup.style.display = 'none';
                    // Remove positioning class when closing
                    matterPopup.classList.remove('top-positioned');
                }
            });

            // Handle matter selection
            matterItems.forEach(item => {
                item.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const matterId = this.dataset.matterId;
                    
                    // Handle "View All Matters" case
                    if (matterId === 'all') {
                        selectMatter('all');
                    } else {
                        const mId = parseInt(matterId);
                        if (!Number.isFinite(mId)) return;
                        selectMatter(mId);
                    }
                    
                    if (matterPopup) {
                        matterPopup.style.display = 'none';
                        // Remove positioning class when closing
                        matterPopup.classList.remove('top-positioned');
                    }
                });
            });
        }

        // Select a matter and filter tasks
        function selectMatter(matterId) {
            if (matterId === 'all') {
                currentMatterId = 'all';
                localStorage.setItem('certio_selected_matter_id', 'all');
                console.log('[Tasks] Switched to Viewing All Matters');
                
                // Update top matter selector text
                const topMatterSelectorText = document.getElementById('topMatterSelectorText');
                if (topMatterSelectorText) {
                    topMatterSelectorText.textContent = 'Viewing All Matters';
                    console.log('Updated top matter selector text to: Viewing All Matters');
                }
                
                // Show all tasks
                showAllTasks();
                return;
            }
            
            if (!Number.isFinite(matterId)) {
                // Fallback to "View All Matters"
                selectMatter('all');
                return;
            }
            currentMatterId = matterId;
            localStorage.setItem('certio_selected_matter_id', matterId);
            console.log('[Tasks] Switched MatterId =', matterId);

            // Update top matter selector text
            const topMatterSelectorText = document.getElementById('topMatterSelectorText');
            if (topMatterSelectorText && window.tasksData?.matters) {
                console.log('Available matters:', window.tasksData.matters);
                console.log('Looking for matter ID:', matterId, 'Type:', typeof matterId);
                
                // Try different property name variations
                let selectedMatter = window.tasksData.matters.find(m => m.Id == matterId);
                if (!selectedMatter) {
                    selectedMatter = window.tasksData.matters.find(m => m.id == matterId);
                }
                if (!selectedMatter) {
                    selectedMatter = window.tasksData.matters.find(m => m.MatterId == matterId);
                }
                if (!selectedMatter) {
                    selectedMatter = window.tasksData.matters.find(m => m.matterId == matterId);
                }
                
                if (selectedMatter) {
                    const title = selectedMatter.Title || selectedMatter.title || selectedMatter.Name || selectedMatter.name;
                    topMatterSelectorText.textContent = title;
                    console.log('Updated top matter selector text to:', title);
                } else {
                    console.log('Selected matter not found for ID:', matterId);
                    console.log('Available matter IDs:', window.tasksData.matters.map(m => ({ Id: m.Id, id: m.id, MatterId: m.MatterId, matterId: m.matterId })));
                }
            } else {
                console.log('topMatterSelectorText element or matters data not found');
            }

            // Filter inbox tasks
            filterTasksByMatter(matterId);
        }

        // Show all tasks (no filtering)
        function showAllTasks() {
            // Show all inbox tasks
            const inboxTasks = document.querySelectorAll('.task-cards-container .task-card-item');
            inboxTasks.forEach(task => {
                task.style.display = '';
            });

            // Show all board cards
            const boardCards = document.querySelectorAll('.kanban-board .task-card');
            boardCards.forEach(card => {
                card.style.display = '';
            });

            // Update column counts
            updateBoardColumnCountsLocal();
            
            console.log('[Tasks] Showing all tasks across all matters');
        }

        // Filter tasks by matter across views
        function filterTasksByMatter(matterId) {
            // Inbox items
            const inboxTasks = document.querySelectorAll('.task-cards-container .task-card-item');
            let visibleCount = 0;
            inboxTasks.forEach(task => {
                const taskMatterId = parseInt(task.getAttribute('data-matter-id'));
                if (!isNaN(taskMatterId) && taskMatterId === matterId) {
                    task.style.display = '';
                    visibleCount++;
                } else {
                    task.style.display = 'none';
                }
            });

            // Empty state handling
            const emptyState = document.querySelector('.task-cards-container .text-center.text-muted');
            if (emptyState) {
                emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
            }

            // Board cards
            const boardCards = document.querySelectorAll('.kanban-board .task-card');
            boardCards.forEach(card => {
                const taskMatterId = parseInt(card.getAttribute('data-matter-id'));
                if (!isNaN(taskMatterId) && taskMatterId === matterId) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });

            // Update column counts locally
            updateBoardColumnCountsLocal();
        }

        // Local recount for board columns (visible cards only)
        function updateBoardColumnCountsLocal() {
            document.querySelectorAll('.kanban-column').forEach(column => {
                const visibleCards = Array.from(column.querySelectorAll('.task-card')).filter(el => el.style.display !== 'none');
                const badge = column.querySelector('.badge');
                if (badge) badge.textContent = visibleCards.length;
            });
        }
        
        // Open task modal for create or edit
        window.openTaskModal = function(taskId = null, defaultStatus = 'Pending') {
            const taskDetailsModal = document.getElementById('taskDetailsModal');
            
            // Always clear placeholders and reset UI first to avoid stale default content
            clearTaskModal();

            if (taskId) {
                // Edit mode - load task data
                loadTaskData(taskId);
            } else {
                // Create mode - clear all fields
                document.getElementById('statusDropdown').value = defaultStatus;
                document.getElementById('status-field').value = defaultStatus;
                updateTaskTitleIconFromModal(defaultStatus);
            }
            
            // Show modal
            taskDetailsModal.style.display = 'flex';
            
            // Focus on title field
            setTimeout(() => {
                const titleField = document.querySelector('.task-title');
                if (titleField) {
                    titleField.focus();
                }
            }, 100);
        }
        
        // Clear task modal for new task creation
        function clearTaskModal() {
            // Clear title
            const taskTitle = document.querySelector('.task-title');
            if (taskTitle) {
                taskTitle.textContent = '';
                taskTitle.dataset.taskId = '';
            }
            
            // Clear description
            const descriptionField = document.querySelector('.task-description-textarea');
            if (descriptionField) {
                descriptionField.value = '';
            }
            
            // Reset status and priority to defaults
            const statusDropdown = document.getElementById('statusDropdown');
            const statusField = document.getElementById('status-field');
            const priorityField = document.getElementById('priority-field');
            
            if (statusDropdown) statusDropdown.value = 'Pending';
            if (statusField) statusField.value = 'Pending';
            if (priorityField) priorityField.value = 'Medium';
            
            // Clear dates
            const startDateField = document.getElementById('start-date-field');
            const dueDateField = document.getElementById('due-date-field');
            if (startDateField) startDateField.value = '';
            if (dueDateField) dueDateField.value = '';
            
            // Clear location
            const locationInput = document.getElementById('locationSearchInput');
            const locationDisplay = document.getElementById('locationDisplay');
            const mapContainer = document.getElementById('mapContainer');
            
            if (locationInput) locationInput.value = '';
            if (locationDisplay) locationDisplay.style.display = 'none';
            if (mapContainer) {
                mapContainer.innerHTML = `
                    <div class="map-placeholder">
                        <i class="fas fa-map-marked-alt" style="font-size: 3rem; color: #d1d5db;"></i>
                        <p class="text-muted mt-2">No location selected</p>
                        <small class="text-muted">Search for a location to display it on the map</small>
                    </div>
                `;
            }
            
            // Clear subtasks
            const checklistItems = document.querySelector('.checklist-items');
            if (checklistItems) {
                checklistItems.innerHTML = `
                    <div class="text-muted text-center py-3">
                        <i class="fas fa-info-circle"></i> No subtasks yet. Add your first subtask below.
                    </div>
                `;
            }
            
            // Update progress to 0%
            updateChecklistProgressManual(0);
        }
        
        // Reset task modal
        function resetTaskModal() {
            clearTaskModal();
        }
        
        // Get current location data from the modal
        function getLocationData() {
            const locationDisplay = document.getElementById('locationDisplay');
            const locationName = document.getElementById('locationName');
            const locationAddress = document.getElementById('locationAddress');
            
            // Check if location is selected
            if (locationDisplay && locationDisplay.style.display !== 'none' && locationName && locationAddress) {
                return {
                    name: locationName.textContent || '',
                    address: locationAddress.textContent || '',
                    formatted_address: locationAddress.textContent || '',
                    // Store the current location data if available
                    place_id: window.currentLocationData?.place_id || null,
                    geometry: window.currentLocationData?.geometry || null
                };
            }
            
            return null;
        }
        
        // Set location data in the modal
        function setLocationData(locationData) {
            if (!locationData) return;
            
            const locationDisplay = document.getElementById('locationDisplay');
            const locationName = document.getElementById('locationName');
            const locationAddress = document.getElementById('locationAddress');
            const locationInput = document.getElementById('locationSearchInput');
            
            if (locationDisplay && locationName && locationAddress) {
                locationName.textContent = locationData.name || '';
                locationAddress.textContent = locationData.address || locationData.formatted_address || '';
                locationDisplay.style.display = 'flex';
                
                // Store the location data globally for map display
                window.currentLocationData = locationData;
                
                // Load the map if we have coordinates
                if (locationData.geometry && locationData.geometry.location) {
                    loadEmbeddedMapFromData(locationData.geometry.location, locationData.name, locationData.address || locationData.formatted_address);
                }
                
                // Update the search input
                if (locationInput) {
                    locationInput.value = locationData.name || '';
                }
            }
        }
        
        // Load embedded map from stored location data
        function loadEmbeddedMapFromData(location, name, address) {
            const mapContainer = document.getElementById('mapContainer');
            
            if (!mapContainer) return;
            
            // Create map URL for embedded display
            const locationStr = location.lat + ',' + location.lng;
            const encodedName = encodeURIComponent(name);
            const encodedAddress = encodeURIComponent(address);
            
            const mapUrl = `https://maps.google.com/maps?q=${encodedName}|${encodedAddress}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
            
            // Create iframe for embedded map
            mapContainer.innerHTML = `
                <iframe 
                    class="embedded-map loaded"
                    src="${mapUrl}"
                    frameborder="0"
                    allowfullscreen>
                </iframe>
            `;
        }
        
        // Load task data for editing
        function loadTaskData(taskId) {
            // Prefer hydrated data passed to the page
            const allTasks = (window.tasksData && Array.isArray(window.tasksData.allTasks)) ? window.tasksData.allTasks : [];
            const task = allTasks.find(t => Number(t.id) === Number(taskId));
            
            if (!task) {
                console.error('Task not found:', taskId);
                return;
            }
            
            // Set task ID in title element for saving
            const taskTitle = document.querySelector('.task-title');
            if (taskTitle) {
                taskTitle.textContent = task.title || '';
                taskTitle.dataset.taskId = taskId;
            }
            
            // Set description
            const descriptionField = document.querySelector('.task-description-textarea');
            if (descriptionField) {
                descriptionField.value = task.description || '';
            }
            
            // Set status and priority
            const statusDropdown = document.getElementById('statusDropdown');
            const statusField = document.getElementById('status-field');
            const priorityField = document.getElementById('priority-field');
            
            if (statusDropdown) statusDropdown.value = task.status || 'Pending';
            if (statusField) statusField.value = task.status || 'Pending';
            if (priorityField) priorityField.value = task.priority || 'Medium';
            
            // Update icon based on status
            updateTaskTitleIconFromModal(task.status || 'Pending');
            
            // Set dates
            const startDateField = document.getElementById('start-date-field');
            const dueDateField = document.getElementById('due-date-field');
            
            if (startDateField && task.startedAt) {
                // Convert to YYYY-MM-DD format for date input
                const startDate = new Date(task.startedAt);
                startDateField.value = startDate.toISOString().split('T')[0];
            }
            
            if (dueDateField && task.dueDate) {
                const dueDate = new Date(task.dueDate);
                dueDateField.value = dueDate.toISOString().split('T')[0];
            }
            
            // Set location (if available)
            if (task.location) {
                // Try to parse location data if it's JSON, otherwise treat as text
                try {
                    const locationData = JSON.parse(task.location);
                    setLocationData(locationData);
                } catch (e) {
                    // If not JSON, treat as plain text and set in input
                    const locationInput = document.getElementById('locationSearchInput');
                    if (locationInput) {
                        locationInput.value = task.location;
                    }
                    
                    // Try to display the location even if it's just text
                    // Split the location string to extract name and address
                    const locationParts = task.location.split(', ');
                    if (locationParts.length >= 2) {
                        const locationName = locationParts[0];
                        const locationAddress = locationParts.slice(1).join(', ');
                        
                        const locationDisplay = document.getElementById('locationDisplay');
                        const locationNameEl = document.getElementById('locationName');
                        const locationAddressEl = document.getElementById('locationAddress');
                        
                        if (locationDisplay && locationNameEl && locationAddressEl) {
                            locationNameEl.textContent = locationName;
                            locationAddressEl.textContent = locationAddress;
                            locationDisplay.style.display = 'flex';
                            
                            // Load the map for plain text locations too
                            // Create a map URL using the location text
                            const encodedLocation = encodeURIComponent(task.location);
                            const mapUrl = `https://maps.google.com/maps?q=${encodedLocation}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
                            
                            const mapContainer = document.getElementById('mapContainer');
                            if (mapContainer) {
                                mapContainer.innerHTML = `
                                    <iframe 
                                        class="embedded-map loaded"
                                        src="${mapUrl}"
                                        frameborder="0"
                                        allowfullscreen>
                                    </iframe>
                                `;
                            }
                        }
                    }
                }
            }
            
            // Load subtasks (if available)
            if (task.subTasks && task.subTasks.length > 0) {
                const checklistItems = document.querySelector('.checklist-items');
                if (checklistItems) {
                    checklistItems.innerHTML = '';
                    task.subTasks.forEach(subtask => {
                        const item = document.createElement('div');
                        item.className = 'checklist-item' + (subtask.isCompleted ? ' completed' : '');
                        item.innerHTML = `
                            <input type="checkbox" class="form-check-input" ${subtask.isCompleted ? 'checked' : ''}>
                            <label class="form-check-label" style="font-size: 0.875rem;">${subtask.title}</label>
                        `;
                        checklistItems.appendChild(item);
                    });
                }
                
                // Update progress
                const completedCount = task.SubTasks.filter(st => st.IsCompleted).length;
                const totalCount = task.SubTasks.length;
                const percentage = totalCount > 0 ? Math.round((completedCount / totalCount) * 100) : 0;
                updateChecklistProgressManual(percentage);
            } else {
                updateChecklistProgressManual(0);
            }
            
            // Load comments (if available)
            if (task.Comments && task.Comments.length > 0) {
                // TODO: Render comments in activity log
            }
            
            // Load assignees (if available)
            if (task.Assignments && task.Assignments.length > 0) {
                // TODO: Render assignees
            }
        }
        
        // Initialize save task functionality
        function initializeSaveTask() {
            // Add save button to modal header
            const headerRight = document.querySelector('.task-details-header-right');
            if (headerRight && !document.getElementById('saveTaskBtn')) {
                const saveBtn = document.createElement('button');
                saveBtn.id = 'saveTaskBtn';
                saveBtn.className = 'btn btn-sm btn-primary me-2';
                saveBtn.innerHTML = '<i class="fas fa-save me-1"></i> Save';
                saveBtn.style.marginRight = '0.5rem';
                
                // Insert before the close button
                const closeBtn = document.getElementById('closeTaskModal');
                headerRight.insertBefore(saveBtn, closeBtn);
                
                // Add click handler
                saveBtn.addEventListener('click', saveTask);
            }
        }
        
        // Save task (create or update)
        function saveTask() {
            const taskTitle = document.querySelector('.task-title');
            const taskId = taskTitle?.dataset?.taskId;
            
            // Validate required fields
            const title = taskTitle?.textContent.trim();
            if (!title) {
                alert('Please enter a task title');
                taskTitle.focus();
                return;
            }
            
            // Get all field values
            const description = document.querySelector('.task-description-textarea')?.value || '';
            const status = document.getElementById('status-field')?.value || 'Pending';
            const priority = document.getElementById('priority-field')?.value || 'Medium';
            const startDate = document.getElementById('start-date-field')?.value || null;
            const dueDate = document.getElementById('due-date-field')?.value || null;
            // Get full location data including coordinates and place ID
            const locationData = getLocationData();
            // Send simple string for backend compatibility, but store full data in a hidden field
            const locationString = locationData ? `${locationData.name}, ${locationData.address}` : null;
            
            // Get matter ID (for now, use first matter from the list or require selection)
            // Use selected matter if available
            const matterId = currentMatterId || (window.tasksData?.matters?.[0]?.Id ?? null);
            
            if (!matterId) {
                alert('No matter found. Please ensure you have at least one matter.');
                return;
            }
            
            // Prepare request data
            const requestData = {
                title: title,
                description: description,
                status: status,
                priority: priority,
                startedAt: startDate,
                dueDate: dueDate,
                location: locationString,
                matterId: matterId,
                order: 0
            };
            
            console.log('Sending request data:', requestData);
            
            // Determine endpoint
            const url = taskId ? '/Tasks/Update' : '/Tasks/Create';
            if (taskId) {
                requestData.id = parseInt(taskId);
            }
            
            // Show loading state
            const saveBtn = document.getElementById('saveTaskBtn');
            const originalText = saveBtn.innerHTML;
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Saving...';
            
            // Get anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            
            // Send request
            fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(requestData)
            })
            .then(response => {
                console.log('Response status:', response.status);
                return response.json();
            })
            .then(data => {
                console.log('Response data:', data);
                if (data.success) {
                    // Success - reload page to show new task
                    window.location.reload();
                } else {
                    // Error
                    console.error('Save error:', data);
                    alert('Error: ' + (data.message || 'Failed to save task'));
                    saveBtn.disabled = false;
                    saveBtn.innerHTML = originalText;
                }
            })
            .catch(error => {
                console.error('Error saving task:', error);
                alert('An error occurred while saving the task');
                saveBtn.disabled = false;
                saveBtn.innerHTML = originalText;
            });
        }
        
        // Update checklist progress manually
        function updateChecklistProgressManual(percentage) {
            const progressBar = document.querySelector('.checklist-progress .progress-bar');
            const progressText = document.querySelector('.checklist-progress .progress-text');
            const headerProgressBar = document.getElementById('headerProgressBar');
            const headerProgressText = document.getElementById('headerProgressText');
            
            if (progressBar) progressBar.style.width = percentage + '%';
            if (progressText) progressText.textContent = percentage + '%';
            if (headerProgressBar) headerProgressBar.style.width = percentage + '%';
            if (headerProgressText) headerProgressText.textContent = percentage + '%';
        }
        
        // Update task title icon based on status
        function updateTaskTitleIconFromModal(status) {
            const icon = document.getElementById('taskTitleIcon');
            if (!icon) return;
            
            // Remove all status classes
            icon.className = icon.className.replace(/\bstatus-\w+/g, '');
            
            // Update icon and color based on status
            switch(status) {
                case 'Pending':
                    icon.className = 'fa-solid fa-circle-question task-title-icon status-planned';
                    break;
                case 'InProgress':
                    icon.className = 'fas fa-play-circle task-title-icon status-in-progress';
                    break;
                case 'Review':
                    icon.className = 'fas fa-exclamation-circle task-title-icon status-review';
                    break;
                case 'Completed':
                    icon.className = 'fas fa-check-circle task-title-icon status-completed';
                    break;
                default:
                    icon.className = 'fa-solid fa-circle-question task-title-icon status-planned';
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            
            // Handle checklist item interactions
            const checklistItems = document.querySelectorAll('.checklist-item input[type="checkbox"]');
            checklistItems.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    updateChecklistProgress();
                });
            });
            
            function updateChecklistProgress() {
                const totalItems = document.querySelectorAll('.checklist-item').length;
                const completedItems = document.querySelectorAll('.checklist-item.completed').length;
                const progressPercentage = totalItems > 0 ? Math.round((completedItems / totalItems) * 100) : 0;
                
                // Update main checklist progress
                const progressBar = document.querySelector('.checklist-progress .progress-bar');
                const progressText = document.querySelector('.checklist-progress .progress-text');
                
                if (progressBar) {
                    progressBar.style.width = progressPercentage + '%';
                }
                if (progressText) {
                    progressText.textContent = progressPercentage + '%';
                }
                
                // Update header progress
                const headerProgressBar = document.getElementById('headerProgressBar');
                const headerProgressText = document.getElementById('headerProgressText');
                
                if (headerProgressBar) {
                    headerProgressBar.style.width = progressPercentage + '%';
                }
                if (headerProgressText) {
                    headerProgressText.textContent = progressPercentage + '%';
                }
            }
            
            // Handle task title editing
            const taskTitle = document.querySelector('.task-title');
            if (taskTitle) {
                taskTitle.addEventListener('blur', function() {
                    // Save title changes here
                    console.log('Task title updated:', this.textContent);
                });
            }
            
            // Handle comment submission
            const commentInput = document.querySelector('.comment-input');
            if (commentInput) {
                commentInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' && e.ctrlKey) {
                        // Submit comment
                        const comment = this.value.trim();
                        if (comment) {
                            addComment(comment);
                            this.value = '';
                        }
                    }
                });
            }
            
            function addComment(commentText) {
                const activityLog = document.querySelector('.activity-log');
                if (activityLog) {
                    const newActivityItem = document.createElement('div');
                    newActivityItem.className = 'activity-item';
                    newActivityItem.innerHTML = `
                        <div class="activity-avatar">U</div>
                        <div class="activity-content">
                            <span class="activity-text">
                                <strong>You</strong> commented: ${commentText}
                            </span>
                            <div class="activity-time">${new Date().toLocaleString()}</div>
                        </div>
                    `;
                    activityLog.insertBefore(newActivityItem, activityLog.firstChild);
                }
            }
        });

        // Bottom navbar multi-view toggle functionality
        document.addEventListener('DOMContentLoaded', function() {
            // Ensure conversations are loaded for the Tasks page
            setTimeout(function() {
                if (typeof loadConversationsForPanel === 'function') {
                    console.log('Tasks page: Loading conversations...');
                    loadConversationsForPanel();
                } else {
                    console.error('Tasks page: loadConversationsForPanel function not available');
                }
            }, 100); // Small delay to ensure chat.js is loaded
            
            const navItems = document.querySelectorAll('.bottom-navbar .nav-item');
            const viewContainers = document.querySelectorAll('.view-container');
            const tasksContent = document.querySelector('.tasks-content');
            
            // Track active views
            let activeViews = new Set(['inbox']); // Default to inbox only
            
            // Initialize the layout
            updateViewLayout();

            navItems.forEach(item => {
                item.addEventListener('click', function() {
                    const view = this.getAttribute('data-view');
                    
                    // Skip switch matters for now
                    if (view === 'switch') {
                        return;
                    }
                    
                    // Toggle the view
                    if (activeViews.has(view)) {
                        // If it's the only active view, don't remove it
                        if (activeViews.size === 1) {
                            return;
                        }
                        activeViews.delete(view);
                    } else {
                        activeViews.add(view);
                    }
                    
                    updateViewLayout();
                });
            });
            
            function updateViewLayout() {
                // Update navbar visual state
                navItems.forEach(nav => {
                    const view = nav.getAttribute('data-view');
                    nav.classList.remove('active', 'multi-active');
                    
                    if (activeViews.has(view)) {
                        if (activeViews.size === 1) {
                            nav.classList.add('active');
                        } else {
                            nav.classList.add('multi-active');
                        }
                    }
                });
                
                // Update view containers visibility
                viewContainers.forEach(container => {
                    container.classList.add('d-none');
                });
                
                // Show active views
                activeViews.forEach(view => {
                    const targetView = document.getElementById(view + 'View');
                    if (targetView) {
                        targetView.classList.remove('d-none');
                        
                        // Reinitialize drag and drop if board view becomes visible
                        if (view === 'board' && window.reinitializeDragAndDropIfNeeded) {
                            window.reinitializeDragAndDropIfNeeded();
                        }
                    }
                });
                
                // Update layout classes
                tasksContent.classList.remove('multi-view', 'inbox-planner', 'inbox-board', 'planner-board', 'all-views');
                
                if (activeViews.size > 1) {
                    tasksContent.classList.add('multi-view');
                    
                    // Apply specific layout classes based on active views
                    const viewsArray = Array.from(activeViews);
                    
                    if (viewsArray.length === 2) {
                        if (viewsArray.includes('inbox') && viewsArray.includes('planner')) {
                            tasksContent.classList.add('inbox-planner');
                        } else if (viewsArray.includes('inbox') && viewsArray.includes('board')) {
                            tasksContent.classList.add('inbox-board');
                        } else if (viewsArray.includes('planner') && viewsArray.includes('board')) {
                            tasksContent.classList.add('planner-board');
                        }
                    } else if (viewsArray.length === 3) {
                        tasksContent.classList.add('all-views');
                    }
                }
                
                // Update floating actions positioning
                updateFloatingActionsPosition();
            }

            // Calendar navigation functionality
            const prevWeekBtn = document.getElementById('prevWeekBtn');
            const nextWeekBtn = document.getElementById('nextWeekBtn');
            const todayBtn = document.getElementById('todayBtn');

            if (prevWeekBtn) {
                prevWeekBtn.addEventListener('click', function() {
                    // TODO: Implement previous week navigation
                    console.log('Previous week clicked');
                });
            }

            if (nextWeekBtn) {
                nextWeekBtn.addEventListener('click', function() {
                    // TODO: Implement next week navigation
                    console.log('Next week clicked');
                });
            }

            if (todayBtn) {
                todayBtn.addEventListener('click', function() {
                    // TODO: Implement jump to today
                    console.log('Today clicked');
                });
            }

            // Adaptive floating actions positioning
            function updateFloatingActionsPosition() {
                const floatingActions = document.querySelector('.floating-actions');
                if (!floatingActions) return;

                // Get the tasks page container
                const tasksPage = document.querySelector('.tasks-page');
                if (!tasksPage) return;

                // Check if we're in multi-view mode
                const isMultiView = tasksContent.classList.contains('multi-view');
                
                if (isMultiView) {
                    // In multi-view mode, center within the inbox view
                    const inboxView = document.getElementById('inboxView');
                    if (inboxView) {
                        const rect = inboxView.getBoundingClientRect();
                        const centerX = rect.left + (rect.width / 2);
                        floatingActions.style.left = centerX + 'px';
                        floatingActions.style.transform = 'translateX(-50%)';
                    }
                } else {
                    // In single view mode, center within the full content area
                    const rect = tasksPage.getBoundingClientRect();
                    const centerX = rect.left + (rect.width / 2);
                    floatingActions.style.left = centerX + 'px';
                    floatingActions.style.transform = 'translateX(-50%)';
                }
            }

            // Adaptive navbar positioning (original behavior)
            function updateNavbarPosition() {
                const navbar = document.querySelector('.bottom-navbar');
                if (!navbar) return;

                // Get the tasks page container
                const tasksPage = document.querySelector('.tasks-page');
                if (!tasksPage) return;

                // Calculate the center of the visible content area
                const rect = tasksPage.getBoundingClientRect();
                const centerX = rect.left + (rect.width / 2);
                
                // Set the navbar position to the center of the content area
                navbar.style.left = centerX + 'px';
            }

            // Update on load and resize
            updateNavbarPosition();
            updateFloatingActionsPosition();
            window.addEventListener('resize', function() {
                updateNavbarPosition();
                updateFloatingActionsPosition();
            });
            
            // Update when layout changes (e.g., sidebar toggles)
            const resizeObserver = new ResizeObserver(function() {
                updateNavbarPosition();
                updateFloatingActionsPosition();
            });
            const tasksPage = document.querySelector('.tasks-page');
            if (tasksPage) {
                resizeObserver.observe(tasksPage);
            }

            // Also observe the main content container in case it changes
            const mainContent = document.querySelector('.main-content, .content-wrapper, main');
            if (mainContent) {
                resizeObserver.observe(mainContent);
            }

            // Kanban board vertical-to-horizontal scroll functionality
            const kanbanBoardContainer = document.querySelector('.kanban-board-container');
            if (kanbanBoardContainer) {
                let isScrolling = false;
                
                kanbanBoardContainer.addEventListener('wheel', function(e) {
                    // Only handle vertical scroll events
                    if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
                        e.preventDefault();
                        
                        // Convert vertical scroll to horizontal scroll
                        const scrollAmount = e.deltaY;
                        kanbanBoardContainer.scrollLeft += scrollAmount;
                        
                        // Add smooth scrolling effect
                        if (!isScrolling) {
                            isScrolling = true;
                            kanbanBoardContainer.style.scrollBehavior = 'smooth';
                            
                            setTimeout(() => {
                                isScrolling = false;
                                kanbanBoardContainer.style.scrollBehavior = 'auto';
                            }, 150);
                        }
                    }
                }, { passive: false });
            }

            // Scroll-to-field functionality for action buttons
            setupScrollToField();
        });

        function setupScrollToField() {
            // Wait a bit for modal to be fully rendered
            setTimeout(() => {
                const scrollableContainer = document.querySelector('.task-details-left');
                const statusBtn = document.getElementById('scroll-status-btn');
                const priorityBtn = document.getElementById('scroll-priority-btn');
                const datesBtn = document.getElementById('scroll-dates-btn');
                const checklistBtn = document.getElementById('scroll-checklist-btn');
                const attachmentBtn = document.getElementById('scroll-attachment-btn');
                
                const statusPrioritySection = document.getElementById('status-priority-section');
                const datesSection = document.getElementById('dates-section');
                const checklistSection = document.getElementById('checklist-section');
                const attachmentsSection = document.getElementById('attachments-section');
                
                const statusField = document.getElementById('status-field');
                const priorityField = document.getElementById('priority-field');
                const startDateField = document.getElementById('start-date-field');
                
                if (!scrollableContainer) {
                    console.error('Scrollable container not found');
                    return;
                }

            // Status button click handler
            if (statusBtn && statusPrioritySection) {
                statusBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    scrollToElement(statusPrioritySection);
                    // Remove focused class from other labels first
                    removeFocusedClass();
                    
                    // Add focused class to change color to black for Status label
                    const statusLabel = document.getElementById('status-label');
                    statusLabel.classList.add('focused');
                    
                    // Focus the field
                    setTimeout(() => statusField.focus(), 300);
                });
            }

            // Priority button click handler
            if (priorityBtn && statusPrioritySection) {
                priorityBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    scrollToElement(statusPrioritySection);
                    // Remove focused class from other labels first
                    removeFocusedClass();
                    
                    // Add focused class to change color to black for Priority label
                    const priorityLabel = document.getElementById('priority-label');
                    priorityLabel.classList.add('focused');
                    
                    // Focus the field
                    setTimeout(() => priorityField.focus(), 300);
                });
            }

            // Dates button click handler
            if (datesBtn && datesSection) {
                datesBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    scrollToElement(datesSection);
                    // Remove focused class from other labels first
                    removeFocusedClass();
                    
                    // Add focused class to change color to black for both date labels
                    const startDateLabel = document.getElementById('start-date-label');
                    const dueDateLabel = document.getElementById('due-date-label');
                    startDateLabel.classList.add('focused');
                    dueDateLabel.classList.add('focused');
                    
                    // Focus the first date field
                    setTimeout(() => startDateField.focus(), 300);
                });
            }

            // Checklist button click handler
            if (checklistBtn && checklistSection) {
                checklistBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    console.log('Checklist button clicked');
                    scrollToElement(checklistSection);
                    // Remove focused class from other labels
                    removeFocusedClass();
                });
            } else {
                console.log('Checklist elements not found:', { checklistBtn: !!checklistBtn, checklistSection: !!checklistSection });
            }

            // Attachment button click handler
            if (attachmentBtn && attachmentsSection) {
                attachmentBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    console.log('Attachment button clicked');
                    scrollToElement(attachmentsSection);
                    // Remove focused class from other labels
                    removeFocusedClass();
                });
            } else {
                console.log('Attachment elements not found:', { attachmentBtn: !!attachmentBtn, attachmentsSection: !!attachmentsSection });
            }
            
            // Status dropdown click handler - navigates to Status section
            const statusDropdown = document.getElementById('statusDropdown');
            if (statusDropdown && statusPrioritySection) {
                statusDropdown.addEventListener('click', function(e) {
                    e.stopPropagation(); // Prevent closing dropdown
                    scrollToElement(statusPrioritySection);
                    // Remove focused class from other labels
                    removeFocusedClass();
                });
                
                // Sync when header dropdown changes
                statusDropdown.addEventListener('change', function(e) {
                    syncStatusDropdowns(statusDropdown, statusField);
                });
            }
            
            // Sync when status section dropdown changes
            if (statusField) {
                statusField.addEventListener('change', function(e) {
                    syncStatusDropdowns(statusField, statusDropdown);
                });
            }
            
            // Function to sync dropdowns when either changes
            function syncStatusDropdowns(sourceDropdown, targetDropdown) {
                if (sourceDropdown && targetDropdown) {
                    const selectedValue = sourceDropdown.value;
                    if (targetDropdown.value !== selectedValue) {
                        targetDropdown.value = selectedValue;
                    }
                    // Update icon based on status
                    updateTaskTitleIcon(selectedValue);
                }
            }
            
            // Function to update task title icon based on status
            function updateTaskTitleIcon(status) {
                const icon = document.getElementById('taskTitleIcon');
                if (!icon) return;
                
                // Remove all status classes
                icon.className = icon.className.replace(/\bstatus-\w+/g, '');
                
                // Update icon and color based on status
                switch(status) {
                    case 'Pending':
                        icon.className = 'fa-solid fa-circle-question task-title-icon status-planned';
                        break;
                    case 'InProgress':
                        icon.className = 'fas fa-play-circle task-title-icon status-in-progress';
                        break;
                    case 'Review':
                        icon.className = 'fas fa-exclamation-circle task-title-icon status-review';
                        break;
                    case 'Completed':
                        icon.className = 'fas fa-check-circle task-title-icon status-completed';
                        break;
                    default:
                        icon.className = 'fa-solid fa-circle-question task-title-icon status-planned';
                }
            }
            
            // Header progress bar and text click handler - navigates to Subtasks section
            const headerProgressContainer = document.getElementById('headerProgressBarContainer');
            const headerProgressText = document.getElementById('headerProgressText');
            
            function scrollToSubtasks(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('Progress clicked - navigating to Subtasks');
                scrollToElement(checklistSection);
                // Remove focused class from other labels
                removeFocusedClass();
            }
            
            if (headerProgressContainer && checklistSection) {
                headerProgressContainer.addEventListener('click', scrollToSubtasks);
            }
            
            if (headerProgressText && checklistSection) {
                headerProgressText.addEventListener('click', scrollToSubtasks);
            }
            
            // Header attachment icon click handler - navigates to Attachments section
            const headerAttachmentBtn = document.getElementById('headerAttachmentBtn');
            if (headerAttachmentBtn && attachmentsSection) {
                headerAttachmentBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    console.log('Header attachment icon clicked');
                    scrollToElement(attachmentsSection);
                    // Remove focused class from other labels
                    removeFocusedClass();
                });
            }
            
            // Initialize status icon based on current selection
            const initialStatusDropdown = document.getElementById('statusDropdown');
            if (initialStatusDropdown) {
                updateTaskTitleIcon(initialStatusDropdown.value);
            }

            // Scroll event listener to revert colors when scrolling
            if (scrollableContainer) {
                let scrollTimeout;
                scrollableContainer.addEventListener('scroll', function() {
                    clearTimeout(scrollTimeout);
                    scrollTimeout = setTimeout(function() {
                        revertLabelColors();
                    }, 300);
                });
            }

            // Function to scroll to a specific element with smooth animation
            function scrollToElement(element) {
                if (!element || !scrollableContainer) return;
                
                console.log('Scrolling to element:', element.id);
                
                // Get the element's position relative to the scrollable container
                const scrollableRect = scrollableContainer.getBoundingClientRect();
                const elementRect = element.getBoundingClientRect();
                
                // Calculate how much we need to scroll
                const currentScrollTop = scrollableContainer.scrollTop;
                const elementOffsetFromContainerTop = elementRect.top - scrollableRect.top;
                const targetScrollTop = currentScrollTop + elementOffsetFromContainerTop - 10; // 10px padding
                
                console.log('Current scroll top:', currentScrollTop);
                console.log('Element position:', elementOffsetFromContainerTop);
                console.log('Target scroll top:', targetScrollTop);
                
                // Scroll smoothly to the element
                scrollableContainer.scrollTo({
                    top: targetScrollTop,
                    behavior: 'smooth'
                });
            }

            // Function to remove focused class from other labels
            function removeFocusedClass() {
                const labels = document.querySelectorAll('.status-priority-label');
                labels.forEach(label => label.classList.remove('focused'));
            }

            // Function to revert label colors by removing focused class
            function revertLabelColors() {
                const labels = document.querySelectorAll('.status-priority-label');
                labels.forEach(label => label.classList.remove('focused'));
            }
            }, 100); // End of setTimeout
        }
    </script>
}


