@model Certio.Web.ViewModels.TasksViewModel
@{
    ViewData["Title"] = "Tasks";
    Layout = "_ClientLayout";
}

<link rel="stylesheet" href="~/css/tasks.css" />

<div class="tasks-page">
    <!-- Main Content Container -->
    <div class="tasks-content" style="position: relative;">
        <!-- Inbox View -->
        <div class="view-container" id="inboxView">
            <div class="inbox-container">
                <!-- Inbox Header -->
                <div class="inbox-header">
                    <div class="inbox-title">
                        <i class="fas fa-bars-progress"></i>
                        <span>Tasks</span>
                    </div>
                    <div class="inbox-actions">
                        <button class="action-btn">
                            <i class="fas fa-volume-up"></i>
                        </button>
                        <button class="action-btn">
                            <i class="fas fa-bars"></i>
                        </button>
                        <button class="action-btn">
                            <i class="fas fa-ellipsis-v"></i>
                        </button>
                    </div>
                </div>

                <!-- Add Card Button -->
                <div class="add-card-container">
                    <button class="add-card-button" id="addTaskButton">
                        <div class="add-card-icon">
                            <i class="fas fa-plus"></i>
                        </div>
                        <span class="add-card-text">Add a task</span>
                    </button>
                </div>

                <!-- Task Cards -->
                <div class="task-cards-container">
                    <div class="task-card-item">
                        <div class="form-check">
                            <input class="form-check-input task-radio" type="radio" name="task" id="task2">
                            <label class="form-check-label" for="task2">Example Task #2</label>
                        </div>
                    </div>
                    <div class="task-card-item">
                        <div class="form-check">
                            <input class="form-check-input task-radio" type="radio" name="task" id="task3">
                            <label class="form-check-label" for="task3">Example Task #3</label>
                        </div>
                    </div>
                    <div class="task-card-item">
                        <div class="form-check">
                            <input class="form-check-input task-radio" type="radio" name="task" id="task1">
                            <label class="form-check-label" for="task1">Example Task #1</label>
                        </div>
                    </div>
                </div>

                <!-- Floating Action Buttons -->
                <div class="floating-actions">
                    <button class="floating-btn">
                        <i class="fas fa-envelope"></i>
                    </button>
                    <button class="floating-btn">
                        <i class="fab fa-slack"></i>
                    </button>
                    <button class="floating-btn">
                        <i class="fab fa-microsoft"></i>
                    </button>
                    <button class="floating-btn">
                        <i class="fas fa-mobile-alt"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Planner View -->
        <div class="view-container" id="plannerView">
            <div class="planner-container">
                <!-- Calendar Navigation Header -->
                <div class="calendar-header">
                    <div class="calendar-nav-left">
                        <button class="month-year-selector">
                            <i class="fas fa-calendar"></i>
                            <span class="month-year">Oct 2025</span>
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <button class="nav-btn" id="prevWeekBtn">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <button class="today-btn" id="todayBtn">Today</button>
                        <button class="nav-btn" id="nextWeekBtn">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                    <div class="calendar-nav-right">
                        <div class="premium-badge">PREMIUM</div>
                        <button class="calendar-selector">
                            <span>1 calendar</span>
                            <i class="bi bi-gear"></i>
                        </button>
                    </div>
                </div>

                <!-- Calendar Grid -->
                <div class="calendar-grid">
                    <!-- Days Header -->
                    <div class="calendar-days-header">
                        <div class="day-header">Sun</div>
                        <div class="day-header">Mon</div>
                        <div class="day-header">Tue</div>
                        <div class="day-header">Wed</div>
                        <div class="day-header">Thu</div>
                        <div class="day-header">Fri</div>
                        <div class="day-header">Sat</div>
                    </div>

                    <!-- Dates Header -->
                    <div class="calendar-dates-header">
                        <div class="date-cell">28</div>
                        <div class="date-cell">29</div>
                        <div class="date-cell">30</div>
                        <div class="date-cell active">1</div>
                        <div class="date-cell">2</div>
                        <div class="date-cell">3</div>
                        <div class="date-cell">4</div>
                    </div>

                    <!-- Single Day Header for Multi-view -->
                    <div class="calendar-days-header single-day-header d-none">
                        <div class="day-header">Wed</div>
                    </div>

                    <!-- Single Date Header for Multi-view -->
                    <div class="calendar-dates-header single-date-header d-none">
                        <div class="date-cell active">1</div>
                    </div>

                    <!-- All Day Row (Fixed) -->
                    <div class="all-day-row">
                        <div class="all-day-time-column">
                            <div class="time-slot all-day">All day</div>
                        </div>
                        <div class="all-day-calendar-columns">
