@model Certio.Web.ViewModels.TasksViewModel
@{
    ViewData["Title"] = "Tasks";
    Layout = "_ClientLayout";
}

@functions {
    string GetPriorityStyles(string priority)
    {
        return priority switch
        {
            "Critical" => "color: #dc3545; background-color: #f5b7b1;",
            "High" => "color: #fd7e14; background-color: #ffeaa7;",
            "Medium" => "color: #0d6efd; background-color: #cfe2ff;",
            "Low" => "color: #6c757d; background-color: #e9ecef;",
            _ => "color: #6c757d; background-color: #e9ecef;"
        };
    }

    string GetStatusClass(string status)
    {
        return status switch
        {
            "Completed" => "bg-success text-white",
            "InProgress" => "bg-primary text-white",
            "Review" => "bg-warning text-dark",
            "Pending" => "bg-secondary text-white",
            _ => "bg-secondary text-white"
        };
    }

    string GetStatusIcon(string status)
    {
        return status switch
        {
            "Completed" => "fas fa-check-circle text-success",
            "InProgress" => "fas fa-play-circle text-primary",
            "Review" => "fas fa-exclamation-circle text-warning",
            "Pending" => "fas fa-clock text-muted",
            _ => "fas fa-clock text-muted"
        };
    }
}

<link rel="stylesheet" href="~/css/tasks.css" />

<div class="tasks-page">
    <!-- Main Content Container -->
    <div class="tasks-content" style="position: relative;">
        <!-- Tasks Page Header with Matter Selector -->
        <div class="tasks-page-header">
            <div class="matter-selector-container">
                <button class="matter-selector-btn" id="topMatterSelectorBtn">
                    <i class="fas fa-folder"></i>
                    <span class="matter-selector-text" id="topMatterSelectorText">Select Matter</span>
                    <i class="fas fa-chevron-down matter-selector-arrow"></i>
                </button>
            </div>
        </div>
        
        <!-- Inbox View -->
        <div class="view-container" id="inboxView">
            <div class="inbox-container">
                <!-- Inbox Header -->
                <div class="inbox-header">
                    <div class="inbox-title">
                        <i class="fas fa-bars-progress"></i>
                        <span>Tasks</span>
                    </div>
                    <div class="inbox-actions">
                        <button class="action-btn">
                            <i class="fas fa-volume-up"></i>
                        </button>
                        <button class="action-btn">
                            <i class="fas fa-bars"></i>
                        </button>
                        <button class="action-btn">
                            <i class="fas fa-ellipsis-v"></i>
                        </button>
                    </div>
                </div>

                <!-- Add Card Button -->
                <div class="add-card-container">
                    <button class="add-card-button" id="addTaskButton">
                        <div class="add-card-icon">
                            <i class="fas fa-plus"></i>
                        </div>
                        <span class="add-card-text">Add a task</span>
                    </button>
                </div>

                <!-- Task Cards -->
                <div class="task-cards-container">
                    @if (Model.AllTasks.Any())
                    {
                        <!-- Planned Tasks Section -->
                        @if (Model.PlannedTasks.Any())
                        {
                            <div class="inbox-status-section">
                                <div class="inbox-status-header">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="@GetStatusIcon("Pending")" style="font-size: 0.85rem; padding-top: 0.6rem;"></i>
                                        <span class="badge @GetStatusClass("Pending")" style="font-size: 0.7rem;">Planned (@Model.PlannedTasks.Count)</span>
                                    </div>
                                </div>
                                <div class="inbox-status-tasks">
                                    @foreach (var task in Model.PlannedTasks.OrderBy(t => t.Order))
                                    {
                                        <div class="task-card-item" data-task-id="@task.Id" data-status="@task.Status" data-matter-id="@task.MatterId">
                                            <div class="form-check">
                                                <input class="form-check-input card-checkbox" 
                                                       type="checkbox" 
                                                       id="inbox-task-@task.Id"
                                                       data-task-id="@task.Id"
                                                       @(task.Status == "Completed" ? "checked" : "")>
                                                <label class="form-check-label" for="inbox-task-@task.Id">
                                                    @task.Title
                                                    @if (!string.IsNullOrEmpty(task.Priority) && task.Priority != "Medium")
                                                    {
                                                        <span class="badge matter-priority-badge ms-2" style="@GetPriorityStyles(task.Priority); font-size: 0.7em;">
                                                            @task.Priority
                                                        </span>
                                                    }
                                                    @if (task.DueDate.HasValue)
                                                    {
                                                        var daysUntilDue = (task.DueDate.Value - DateTime.UtcNow).Days;
                                                        var dueDateClass = daysUntilDue < 0 ? "text-danger" : (daysUntilDue <= 2 ? "text-warning" : "text-muted");
                                                        <span class="ms-2 @dueDateClass" style="font-size: 0.75em;">
                                                            <i class="fas fa-calendar"></i> @task.DueDate.Value.ToString("MMM dd")
                                                        </span>
                                                    }
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- In Progress Tasks Section -->
                        @if (Model.InProgressTasks.Any())
                        {
