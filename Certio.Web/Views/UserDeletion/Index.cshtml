@{
    ViewData["Title"] = "User Deletion Management";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h2>User Deletion Management</h2>
            <p class="text-muted">Manage user account deletion requests and soft delete functionality.</p>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Request Account Deletion</h5>
                </div>
                <div class="card-body">
                    <p>Submit a request to delete your account. Choose your preferred deletion level:</p>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="deletionType" value="Deactivate" id="deactivate" checked>
                            <label class="form-check-label" for="deactivate">
                                <strong>Deactivate Account</strong>
                                <small class="d-block text-muted">Your account will be deactivated but all data will be preserved for business purposes.</small>
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="deletionType" value="CompleteDeletion" id="complete">
                            <label class="form-check-label" for="complete">
                                <strong>Complete Data Deletion</strong>
                                <small class="d-block text-muted">All your personal data will be permanently deleted. Only anonymized business metrics will remain.</small>
                            </label>
                        </div>
                    </div>
                    <a href="@Url.Action("RequestDeletion")" class="btn btn-primary">Submit Deletion Request</a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Soft Delete Status</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <h6><i class="fas fa-check" aria-hidden="true"></i> Cascade conflicts resolved</h6>
                        <p class="mb-0">All cascade path conflicts have been resolved using the Restrict + Application Cleanup pattern.</p>
                    </div>
                    <div class="alert alert-success">
                        <h6><i class="fas fa-check" aria-hidden="true"></i> Soft delete implemented</h6>
                        <p class="mb-0">Users can now be soft deleted with complete data cleanup options.</p>
                    </div>
                    <div class="alert alert-warning">
                        <h6><i class="fas fa-triangle-exclamation" aria-hidden="true"></i> No zombie records</h6>
                        <p class="mb-0">All relationships use Restrict behavior, preventing orphaned records.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5>Implementation Summary</h5>
                </div>
                <div class="card-body">
                    <h6>What Was Implemented:</h6>
                    <ul>
                        <li><strong>Soft Delete Properties:</strong> Added IsDeleted, DeletedAt, DeletedById, DeletionReason to User model</li>
                        <li><strong>UserDeletionService:</strong> Handles both Deactivate and CompleteDeletion operations</li>
                        <li><strong>Cascade Resolution:</strong> Changed all problematic cascade relationships to Restrict</li>
                        <li><strong>Application Cleanup:</strong> Comprehensive data cleanup for complete deletion</li>
                        <li><strong>Query Optimization:</strong> ActiveUsers property for efficient soft delete queries</li>
                        <li><strong>Audit Trail:</strong> Complete deletion history and audit logs</li>
                    </ul>

                    <h6 class="mt-3">Cascade Relationship Matrix:</h6>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Entity</th>
                                    <th>Relationship</th>
                                    <th>Delete Behavior</th>
                                    <th>Cleanup Strategy</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>UserOrganization</td>
                                    <td>User → UserOrganizations</td>
                                    <td><span class="badge bg-success">CASCADE</span></td>
                                    <td>Automatic</td>
                                </tr>
                                <tr>
                                    <td>TeamMembership</td>
                                    <td>User → TeamMemberships</td>
                                    <td><span class="badge bg-success">CASCADE</span></td>
                                    <td>Automatic</td>
                                </tr>
                                <tr>
                                    <td>MatterAssignment</td>
                                    <td>User → MatterAssignments</td>
                                    <td><span class="badge bg-warning">RESTRICT</span></td>
                                    <td>Application Cleanup</td>
                                </tr>
                                <tr>
                                    <td>StatusItemComment</td>
                                    <td>User → StatusItemComments</td>
                                    <td><span class="badge bg-warning">RESTRICT</span></td>
                                    <td>Application Cleanup</td>
                                </tr>
                                <tr>
                                    <td>MatterPermission</td>
                                    <td>User → MatterPermissions</td>
                                    <td><span class="badge bg-warning">RESTRICT</span></td>
                                    <td>Application Cleanup</td>
                                </tr>
                                <tr>
                                    <td>DocumentComment</td>
                                    <td>User → DocumentComments</td>
                                    <td><span class="badge bg-warning">RESTRICT</span></td>
                                    <td>Application Cleanup</td>
                                </tr>
                                <tr>
                                    <td>Notification</td>
                                    <td>User → Notifications</td>
                                    <td><span class="badge bg-warning">RESTRICT</span></td>
                                    <td>Application Cleanup</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5>Test Functions</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">These are test functions to demonstrate the soft delete functionality:</p>
                    <div class="btn-group" role="group">
                        <a href="@Url.Action("ActiveUsers")" class="btn btn-outline-primary">View Active Users</a>
                        <a href="@Url.Action("ProcessRequests")" class="btn btn-outline-secondary">Process Deletion Requests</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
