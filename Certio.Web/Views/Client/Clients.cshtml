@{
    ViewData["Title"] = "Clients";
    Layout = "_ClientLayout";
    ViewData["BodyClass"] = "clients-page";
}

<div class="min-h-screen">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="display-6 fw-bold mb-2">Clients</h1>
            <p class="lead text-muted">
                Manage clients under @(ViewBag.OrganizationName ?? "Organization")
            </p>
        </div>
        <a class="btn btn-primary d-flex align-items-center gap-2" href="@Url.Action("NewClient", "Client", new { orgId = ViewBag.OrganizationId ?? 0 })" id="newClientBtn" style="font-weight: 500;">
            <i class="fas fa-user-plus"></i>
            New client
        </a>
    </div>

    <!-- Search and Filters -->
    <div class="row mb-4">
        <div class="col-md-8">
            <div class="search-container">
                <i class="fas fa-search"></i>
                <input type="text" class="form-control" id="clientSearchInput" placeholder="Search by name or organization..." />
            </div>
        </div>
        <div class="col-md-4">
            <div class="filter-buttons">
                <div class="dropdown d-inline-block me-2">
                    <button class="filter-button dropdown-toggle" type="button" id="clientsFilterBtn" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-filter"></i>
                        <span id="clientsFilterLabel">All Clients</span>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="clientsFilterBtn">
                        <li><a class="dropdown-item clients-filter-option" href="#" data-filter="all">All Clients</a></li>
                        <li><a class="dropdown-item clients-filter-option" href="#" data-filter="active">Active Clients</a></li>
                        <li><a class="dropdown-item clients-filter-option" href="#" data-filter="pending">Pending Invitations</a></li>
                        <li><a class="dropdown-item clients-filter-option" href="#" data-filter="external">External Guests</a></li>
                    </ul>
                </div>
                <div class="dropdown d-inline-block">
                    <button class="filter-button dropdown-toggle" type="button" id="clientsDateFilterBtn" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-calendar"></i>
                        <span id="clientsDateFilterLabel">All Time</span>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="clientsDateFilterBtn">
                        <li><a class="dropdown-item clients-date-option" href="#" data-date-range="all-time">All Time</a></li>
                        <li><a class="dropdown-item clients-date-option" href="#" data-date-range="last-30-days">Last 30 Days</a></li>
                        <li><a class="dropdown-item clients-date-option" href="#" data-date-range="last-90-days">Last 90 Days</a></li>
                        <li><a class="dropdown-item clients-date-option" href="#" data-date-range="this-year">This Year</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Client Organization Sections -->
    <div id="clientsContainer">
        @if (ViewBag.ClientRelationships != null && ((List<object>)ViewBag.ClientRelationships).Any())
        {
            @foreach (dynamic client in ViewBag.ClientRelationships)
            {
                var clientName = client.OwnerName ?? client.OrganizationName ?? "Unknown";
                var orgName = client.DisplayOrganizationName ?? client.OrganizationName ?? "Unknown Organization"; // Use DisplayOrganizationName for title
                var initials = client.OwnerInitials ?? "??";
                var orgId = client.OrganizationId ?? 0;
                var role = client.OwnerRole ?? "Owner";
                var isExternalGuests = client.IsExternalGuests ?? false;
                var orgUsers = client.Users ?? new List<dynamic>(); // Get all users in the organization
                
                <div class="mb-5 client-section">
                    @{
                        var ownerHasMembership = client.OwnerHasMembership ?? false;
                        var hasRegisteredUsers = orgUsers.Count > 0;
                        var isConfirmed = ownerHasMembership || hasRegisteredUsers;
                        var clientStatus = isExternalGuests ? "external" : (isConfirmed ? "active" : "pending");
                        var iconColor = isExternalGuests ? "#aaaaaa" : (isConfirmed ? "#69848C" : "#aaaaaa");
                        var iconClass = isExternalGuests ? "external-guests-icon" : (isConfirmed ? "" : "pending-client-icon");
                    }
                    <div class="team-section-header">
                        <i class="fa-solid fa-building-user @iconClass" style="color: @iconColor;"></i>
                        <h2>@orgName</h2>
                        <span class="team-badge">@(orgUsers.Count > 0 ? orgUsers.Count : 1)</span>
                    </div>
                    
                    <div class="row g-4">
                        @* Show all users in the organization *@
                        @if (orgUsers.Count > 0)
                        {
                            @foreach (dynamic user in orgUsers)
                            {
                                var userName = user.UserName ?? "Unknown";
                                var userInitials = user.UserInitials ?? "??";
                                var userRole = user.UserRole ?? "Guest";
                                var userId = user.UserId ?? 0;
                                var userColor = user.UserColor ?? "#69848C";
                                var userEmail = user.UserEmail ?? "";
                                
                                <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2 client-card team-member-card" 
                                     data-name="@(userName.ToString().ToLower())" 
                                     data-org="@(orgName.ToString().ToLower())"
                                     data-status="@clientStatus"
                                     data-is-confirmed="@(isConfirmed && !isExternalGuests ? "true" : "false")"
                                     data-member-id="@userId"
                                     data-member-name="@userName"
                                     data-member-email="@userEmail"
                                     data-member-initials="@userInitials"
                                     data-member-displayrole="@userRole"
                                     data-member-role="@userRole"
                                     data-member-department=""
                                     data-member-location=""
                                     data-user-color="@userColor"
                                     onclick="event.preventDefault(); showUserDetailsModal(this);">
                                    <div class="card h-100 border-0 hover-shadow transition-smooth cursor-pointer">
                                            <div class="card-body d-flex flex-column align-items-center text-center p-4">
                                                <!-- Avatar -->
                                                <div class="mb-3">
                                                    <div class="team-member-avatar @(isExternalGuests ? "external-guests-avatar" : "")" style="@(isExternalGuests ? "" : $"background-color: {userColor};")">
                                                        @userInitials
                                                    </div>
                                                </div>
                                                
                                                <!-- Name and Role -->
                                                <h5 class="card-title fw-medium mb-1">@userName</h5>
                                                <p class="text-muted small mb-3">@userRole</p>
                                                
                                                <!-- Organization Type -->
                                                <div class="d-flex flex-column align-items-center gap-1">
                                                    <div class="d-flex align-items-center gap-1 text-muted small">
                                                        <i class="fas fa-briefcase" style="font-size: 0.75rem;"></i>
                                                        <span>@(isExternalGuests ? "External" : (isConfirmed ? "Active" : "Pending"))</span>
                                                    </div>
                                                    @if (!isExternalGuests && !isConfirmed)
                                                    {
                                                        <button type="button" class="btn btn-link p-0 view-join-code-btn" 
                                                                data-org-id="@orgId" 
                                                                style="color: #aaaaaa; text-decoration: none; border: none; background: none; padding: 0.25rem !important;"
                                                                title="View Join Code"
                                                                onclick="event.preventDefault(); event.stopPropagation(); viewJoinCode(@orgId);">
                                                            <i class="fas fa-key" style="font-size: 1rem;"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                </div>
                            }
                        }
                        else
                        {
                            @* Fallback to showing owner if no users list *@
                            var ownerColor = (client.OwnerDisplayColor ?? "#69848C").ToString();
                            var ownerEmail = client.OwnerEmail ?? "";
                            <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2 client-card team-member-card" 
                                 data-name="@(clientName.ToString().ToLower())" 
                                 data-org="@(orgName.ToString().ToLower())"
                                 data-status="@clientStatus"
                                 data-is-confirmed="@(isConfirmed && !isExternalGuests ? "true" : "false")"
                                 data-member-id="0"
                                 data-member-name="@clientName"
                                 data-member-email="@ownerEmail"
                                 data-member-initials="@initials"
                                 data-member-displayrole="@role"
                                 data-member-role="@role"
                                 data-member-department=""
                                 data-member-location=""
                                 data-user-color="@ownerColor"
                                 onclick="event.preventDefault(); showUserDetailsModal(this);">
                                <div class="card h-100 border-0 hover-shadow transition-smooth cursor-pointer">
                                        <div class="card-body d-flex flex-column align-items-center text-center p-4">
                                            <!-- Avatar -->
                                            <div class="mb-3">
                                                <div class="team-member-avatar @(isExternalGuests ? "external-guests-avatar" : "")" style="@(isExternalGuests ? "" : $"background-color: {ownerColor};")">
                                                    @initials
                                                </div>
                                            </div>
                                            
                                            <!-- Name and Role -->
                                            <h5 class="card-title fw-medium mb-1">@clientName</h5>
                                            <p class="text-muted small mb-3">@role</p>
                                            
                                            <!-- Organization Type -->
                                            <div class="d-flex flex-column align-items-center gap-1">
                                                <div class="d-flex align-items-center gap-1 text-muted small">
                                                    <i class="fas fa-briefcase" style="font-size: 0.75rem;"></i>
                                                    <span>@(isExternalGuests ? "External" : (isConfirmed ? "Active" : "Pending"))</span>
                                                </div>
                                                @if (!isExternalGuests && !isConfirmed)
                                                {
                                                    <button type="button" class="btn btn-link p-0 view-join-code-btn" 
                                                            data-org-id="@orgId" 
                                                            style="color: #aaaaaa; text-decoration: none; border: none; background: none; padding: 0.25rem !important;"
                                                            title="View Join Code"
                                                            onclick="event.preventDefault(); event.stopPropagation(); viewJoinCode(@orgId);">
                                                        <i class="fas fa-key" style="font-size: 1rem;"></i>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="text-center py-5">
                    <i class="fas fa-users text-muted mb-3" style="font-size: 3rem;"></i>
                    <h4 class="text-dark mb-2">No clients yet</h4>
                    <p class="text-muted">Add your first client to get started.</p>
                </div>
            </div>
        }
    </div>
</div>

<!-- User Details Modal (Same as Teams page) -->
<div class="task-details-modal" id="userDetailsModal" style="display: none;">
    <div class="modal-dialog">
        <div class="task-details-content">
            <!-- Modal Header -->
            <div class="task-details-header" style="display: flex; justify-content: space-between; align-items: center; padding: 1.5rem; border-bottom: 1px solid #e5e7eb;">
                <div class="task-details-header-left" style="display: flex; align-items-center; gap: 0.75rem; flex: 1;">
                    <i class="fa-solid fa-user" style="color: #3d1019; font-size: 1.25rem;"></i>
                    <h2 class="task-title" style="cursor: default; margin: 0; font-size: 1.25rem; font-weight: 600; color: #3d1019;">Client Details</h2>
                </div>
                <button type="button" class="btn-close" onclick="closeUserDetailsModal()" aria-label="Close" style="margin: 0;"></button>
            </div>

            <!-- Modal Body -->
            <div class="task-details-body" style="padding: 2rem; max-height: 70vh;">
                <!-- User Avatar & Name -->
                <div class="text-center mb-4">
                    <div class="user-avatar-large" id="modalUserAvatar" style="width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.75rem; font-weight: 600; color: white; margin: 0 auto; background-color: #3d1019;">
                        JD
                    </div>
                    <h3 class="fw-bold text-dark mt-3 mb-1" id="modalUserName">John Doe</h3>
                    <p class="text-muted" id="modalUserRole">Managing Partner</p>
                </div>

                <!-- User Details Form - Matching Register.cshtml styling -->
                <form id="userDetailsForm">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-4">
                                <label for="modalInputFirstName" class="form-label fw-bold text-dark">First Name</label>
                                <input type="text" class="form-control form-control-lg" id="modalInputFirstName" placeholder="Enter first name" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-4">
                                <label for="modalInputLastName" class="form-label fw-bold text-dark">Last Name</label>
                                <input type="text" class="form-control form-control-lg" id="modalInputLastName" placeholder="Enter last name" required>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label for="modalInputEmail" class="form-label fw-bold text-dark">Email Address</label>
                        <input type="email" class="form-control form-control-lg" id="modalInputEmail" placeholder="Enter email address" required>
                    </div>

                    <div class="form-group mb-4">
                        <label for="modalInputRole" class="form-label fw-bold text-dark">Role</label>
                        <select class="form-select form-select-lg" id="modalInputRole">
                            <option value="">Select a role</option>
                            <option value="@Certio.Domain.Users.OrganizationRoles.Owner">Owner</option>
                            <option value="@Certio.Domain.Users.OrganizationRoles.Manager">Manager</option>
                            <option value="@Certio.Domain.Users.OrganizationRoles.Member">Member</option>
                            <option value="@Certio.Domain.Users.OrganizationRoles.Lawyer">Lawyer</option>
                        </select>
                    </div>

                    <div class="form-group mb-4">
                        <label for="modalInputDepartment" class="form-label fw-bold text-dark">Department (Optional)</label>
                        <input type="text" class="form-control form-control-lg" id="modalInputDepartment" placeholder="">
                    </div>

                    <div class="form-group mb-4">
                        <label for="modalInputLocation" class="form-label fw-bold text-dark">Location (Optional)</label>
                        <input type="text" class="form-control form-control-lg" id="modalInputLocation" placeholder="">
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-secondary" onclick="closeUserDetailsModal()">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@* Join Code Modal - Using task-details-modal structure *@
@if (TempData["JoinCode"] != null)
{
    <div class="task-details-modal" id="joinCodeModal" style="display: none; border-radius: 12px; left: 23vw; bottom: 0;">
        <div class="modal-dialog" style="margin-bottom: 1.5rem;">
            <div class="task-details-content">
                <!-- Modal Header -->
                <div class="task-details-header" style="display: flex; justify-content: space-between; align-items: center; padding: 1.5rem;">
                    <div class="task-details-header-left" style="display: flex; align-items: center; gap: 0.5rem; flex: 1;">
                        <i class="fa-solid fa-key" style="color: #3d1019; font-size: 1.25rem;"></i>
                        <h2 class="task-title" style="cursor: default; margin: 0; font-size: 1.25rem; font-weight: 600; color: #3d1019;">Join Code Generated</h2>
                    </div>
                    <div class="task-details-header-right" style="margin-left: auto;">
                        <button type="button" class="btn-close" id="closeJoinCodeModal" aria-label="Close"></button>
                    </div>
                </div>

                <!-- Success Message -->
                @if (TempData["Success"] != null)
                {
                    <div class="task-details-body" style="padding: 0 1.5rem 1rem;">
                        <div class="alert alert-success" style="margin-bottom: 1rem; border-radius: 8px;">
                            <i class="fas fa-check-circle me-2"></i>
                            @TempData["Success"]
                        </div>
                    </div>
                }

                <!-- Main Content Area -->
                <div class="task-details-body">
                    <!-- Left Panel -->
                    <div class="task-details-left">
                        <!-- Join Code Section -->
                        <div class="task-section">
                            <div class="task-section-header">
                                <h6 class="task-section-title">
                                    <i class="fas fa-key"></i> Join Code
                                </h6>
                            </div>
                            <div class="task-section-content">
                                <div style="position: relative; margin-bottom: 0.75rem;">
                                    <input type="text" class="form-control form-control-lg" id="joinCodeValue" readonly value="@TempData["JoinCode"]" style="font-size: 1.25rem; font-weight: 600; letter-spacing: 0.1em; font-family: monospace; background-color: #f8f9fa; padding-right: 5.5rem;">
                                    <div style="position: absolute; right: 0.5rem; top: 50%; transform: translateY(-50%); display: flex; align-items: center; gap: 0.5rem;">
                                        <button class="join-code-action-btn" type="button" id="copyJoinCodeBtn" title="Copy">
                                            <i class="fas fa-copy"></i>
                                        </button>
                                        <button class="join-code-action-btn" type="button" id="notalizeJoinCodeBtn" title="Notalize">
                                            <img src="/images/Notal_Logo.png" alt="Notalize" style="width: 18px; height: 18px; object-fit: contain;" />
                                        </button>
                                    </div>
                                </div>
                                <small class="text-muted d-block mb-4" style="font-size: 0.875rem;">
                                    Share this code with the client via email, also handled through Communications hub. It expires in 7 days.
                                </small>
                            </div>
                        </div>

                        <!-- Instructions Section -->
                        <div class="task-section" style="margin-bottom: 0;">
                            <div class="task-section-header">
                                <h6 class="task-section-title">
                                    <i class="fas fa-info-circle"></i> Instructions
                                </h6>
                            </div>
                            <div class="task-section-content">
                                <div style="font-size: 0.875rem; color: #4a5568;">
                                    <p style="margin-bottom: 0.5rem;">
                                        <strong>1.</strong> Click Notalize <em>(recommended)</em>, <strong>or</strong> Copy the join code above.
                                    </p>
                                    <p style="margin-bottom: 0.5rem;">
                                        <strong>2.</strong> Share it with the client via email mode in the Communications hub.
                                    </p>
                                    <p style="margin-bottom: 0;">
                                        <strong>3.</strong> The client will use this code to join the organization and will be pending until usage.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="task-action-buttons" style="padding: 0 1.5rem 1.5rem; justify-content: flex-end;">
                    <button type="button" class="btn btn-primary" id="doneJoinCodeBtn" style="border-radius: 0.5rem;">
                        Done
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section GlobalSidebarFinalCard {
    <partial name="_ClientsFilters" />
}

@section Scripts {
    <script>
        // User Details Modal Functions (Same as Teams page)
        function showUserDetailsModal(element) {
            const modal = document.getElementById('userDetailsModal');
            if (!modal) return;

            // Get data from the clicked card
            const memberId = element.getAttribute('data-member-id');
            const memberName = element.getAttribute('data-member-name');
            const memberEmail = element.getAttribute('data-member-email');
            const memberInitials = element.getAttribute('data-member-initials');
            const memberDisplayRole = element.getAttribute('data-member-displayrole');
            const memberRole = element.getAttribute('data-member-role');
            const memberDepartment = element.getAttribute('data-member-department');
            const memberLocation = element.getAttribute('data-member-location');
            const userColor = element.getAttribute('data-user-color');
            const isConfirmed = element.getAttribute('data-is-confirmed') === 'true';

            // Get the team color from the avatar in the card
            const avatarColor = userColor || '#3d1019';

            // Split name into first and last
            const nameParts = (memberName || '').split(' ');
            const firstName = nameParts[0] || '';
            const lastName = nameParts.slice(1).join(' ') || '';

            // Get form elements
            const roleSelect = document.getElementById('modalInputRole');
            const departmentInput = document.getElementById('modalInputDepartment');
            const locationInput = document.getElementById('modalInputLocation');

            // Populate modal
            document.getElementById('modalUserAvatar').textContent = memberInitials || 'JD';
            document.getElementById('modalUserAvatar').style.backgroundColor = avatarColor;
            document.getElementById('modalUserName').textContent = memberName || 'User';
            document.getElementById('modalUserRole').textContent = memberDisplayRole || 'Team Member';
            document.getElementById('modalInputFirstName').value = firstName;
            document.getElementById('modalInputLastName').value = lastName;
            document.getElementById('modalInputEmail').value = memberEmail || '';
            
            // Set role dropdown value
            if (roleSelect) {
                roleSelect.value = memberRole || '';
            }
            
            // Set department and location
            if (departmentInput) {
                departmentInput.value = memberDepartment || '';
            }
            if (locationInput) {
                locationInput.value = memberLocation || '';
            }

            // Enable/disable fields based on confirmation status
            if (isConfirmed) {
                // Enable fields and add placeholders
                if (roleSelect) {
                    roleSelect.disabled = false;
                }
                if (departmentInput) {
                    departmentInput.disabled = false;
                    departmentInput.placeholder = 'e.g., Litigation, Corporate';
                }
                if (locationInput) {
                    locationInput.disabled = false;
                    locationInput.placeholder = 'e.g., New York, San Francisco';
                }
            } else {
                // Disable fields and remove placeholders
                if (roleSelect) {
                    roleSelect.disabled = true;
                }
                if (departmentInput) {
                    departmentInput.disabled = true;
                    departmentInput.placeholder = '';
                }
                if (locationInput) {
                    locationInput.disabled = true;
                    locationInput.placeholder = '';
                }
            }

            // Show modal
            modal.style.display = 'flex';
            
            // Add body class to handle sidebar adjustments
            if (document.querySelector('.client-sidebar') && document.querySelector('.client-sidebar').style.transform === 'translateX(-100%)') {
                document.body.classList.add('sidebar-hidden');
            }
            if (document.querySelector('.chat-panel') && document.querySelector('.chat-panel').style.display === 'none') {
                document.body.classList.add('chat-hidden');
            }
        }

        function closeUserDetailsModal() {
            const modal = document.getElementById('userDetailsModal');
            if (modal) {
                modal.style.display = 'none';
            }
        }

        // Helper function to get last opened client organization ID from localStorage
        function getLastOpenedClientOrgId() {
            try {
                return localStorage.getItem('lastOpenedClientOrgId');
            } catch (e) {
                return null;
            }
        }

        // Helper function to set last opened client organization ID in localStorage
        function setLastOpenedClientOrgId(orgId) {
            try {
                if (orgId && !isNaN(orgId)) {
                    localStorage.setItem('lastOpenedClientOrgId', orgId.toString());
                }
            } catch (e) {
                // Ignore localStorage errors
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            // User Details Modal event handlers
            const modal = document.getElementById('userDetailsModal');
            if (modal) {
                modal.addEventListener('click', function(e) {
                    if (e.target === modal) {
                        closeUserDetailsModal();
                    }
                });
            }

            // Handle form submission
            const form = document.getElementById('userDetailsForm');
            if (form) {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    
                    const firstName = document.getElementById('modalInputFirstName').value;
                    const lastName = document.getElementById('modalInputLastName').value;
                    const email = document.getElementById('modalInputEmail').value;
                    const role = document.getElementById('modalInputRole').value;
                    const department = document.getElementById('modalInputDepartment').value;
                    const location = document.getElementById('modalInputLocation').value;
                    
                    // Validation
                    if (!firstName || !lastName || !email) {
                        alert('Please fill in all required fields');
                        return;
                    }
                    
                    if (password && password.length < 6) {
                        alert('Password must be at least 6 characters long');
                        return;
                    }
                    
                    // TODO: Add save logic here - send to backend
                    console.log('Saving user details...', {
                        firstName,
                        lastName,
                        email,
                        password: password ? '***' : 'unchanged'
                    });
                    
                    closeUserDetailsModal();
                });
            }

            const searchInput = document.getElementById('clientSearchInput');
            const clientCards = Array.from(document.querySelectorAll('.client-card'));
            const clientSections = Array.from(document.querySelectorAll('.client-section'));
            const clientFilterLabel = document.getElementById('clientsFilterLabel');
            const clientDateFilterLabel = document.getElementById('clientsDateFilterLabel');

            const clientFilterLabels = {
                'all': 'All Clients',
                'active': 'Active Clients',
                'pending': 'Pending Invitations',
                'external': 'External Guests'
            };

            const clientDateLabels = {
                'all-time': 'All Time',
                'last-30-days': 'Last 30 Days',
                'last-90-days': 'Last 90 Days',
                'this-year': 'This Year'
            };

            let currentClientStatusFilter = 'all';
            let currentClientDateRange = 'all-time';
            let currentClientSearchTerm = '';

            function updateClientVisibility() {
                clientSections.forEach(section => {
                    const cards = Array.from(section.querySelectorAll('.client-card'));
                    let visibleCount = 0;

                    cards.forEach(card => {
                        const status = (card.dataset.status || '').toLowerCase();
                        const name = card.dataset.name || '';
                        const org = card.dataset.org || '';

                        const matchesStatus = currentClientStatusFilter === 'all' || status === currentClientStatusFilter;
                        const matchesSearch = !currentClientSearchTerm || name.includes(currentClientSearchTerm) || org.includes(currentClientSearchTerm);

                        const shouldShow = matchesStatus && matchesSearch;
                        card.style.display = shouldShow ? '' : 'none';
                        if (shouldShow) {
                            visibleCount++;
                        }
                    });

                    section.style.display = visibleCount > 0 ? '' : 'none';
                });
            }

            function applyClientsStatusFilter(filter) {
                currentClientStatusFilter = filter;
                if (clientFilterLabel) {
                    clientFilterLabel.textContent = clientFilterLabels[filter] || 'Filter';
                }
                updateClientVisibility();

                document.dispatchEvent(new CustomEvent('clients:statusFilterChanged', {
                    detail: { filter }
                }));
            }

            function applyClientsDateRange(range, skipEvent = false) {
                currentClientDateRange = range;
                if (clientDateFilterLabel) {
                    clientDateFilterLabel.textContent = clientDateLabels[range] || 'Date Range';
                }

                if (!skipEvent) {
                    document.dispatchEvent(new CustomEvent('clients:dateRangeChanged', {
                        detail: { range }
                    }));
                }
            }

            // Track when client cards are clicked
            clientCards.forEach(card => {
                const link = card.querySelector('a[href^="/Client/"]');
                if (link) {
                    link.addEventListener('click', function(e) {
                        const href = this.getAttribute('href');
                        const match = href.match(/\/Client\/(\d+)\/Dashboard/);
                        if (match && match[1]) {
                            const orgId = match[1];
                            setLastOpenedClientOrgId(orgId);
                        }
                    });
                }
            });

            // Search functionality
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    currentClientSearchTerm = this.value.toLowerCase();
                    updateClientVisibility();
                });
            }

            document.querySelectorAll('.clients-filter-option').forEach(option => {
                option.addEventListener('click', function(e) {
                    e.preventDefault();
                    applyClientsStatusFilter(this.dataset.filter || 'all');
                });
            });

            document.querySelectorAll('.clients-date-option').forEach(option => {
                option.addEventListener('click', function(e) {
                    e.preventDefault();
                    applyClientsDateRange(this.dataset.dateRange || 'all-time');
                });
            });

            // Add hover effects
            clientCards.forEach(card => {
                const cardElement = card.querySelector('.card');
                if (cardElement) {
                    cardElement.addEventListener('mouseenter', function() {
                        this.classList.add('shadow-lg');
                    });
                    
                    cardElement.addEventListener('mouseleave', function() {
                        this.classList.remove('shadow-lg');
                    });
                }
            });

            // Initialize filters
            applyClientsStatusFilter('all');
            applyClientsDateRange('all-time', true);

            // Apply client-side sorting based on last opened
            const clientsContainer = document.getElementById('clientsContainer');
            if (clientsContainer) {
                const lastOpenedOrgId = getLastOpenedClientOrgId();
                const sections = Array.from(clientsContainer.querySelectorAll('.client-section'));
                
                // Sort sections: External Contacts at bottom, last opened at top (excluding external)
                sections.sort((a, b) => {
                    const aLink = a.querySelector('a[href^="/Client/"]');
                    const bLink = b.querySelector('a[href^="/Client/"]');
                    
                    if (!aLink || !bLink) return 0;
                    
                    const aMatch = aLink.getAttribute('href').match(/\/Client\/(\d+)\/Dashboard/);
                    const bMatch = bLink.getAttribute('href').match(/\/Client\/(\d+)\/Dashboard/);
                    const aOrgId = aMatch ? aMatch[1] : null;
                    const bOrgId = bMatch ? bMatch[1] : null;
                    
                    // Check if external contacts
                    const aIsExternal = a.querySelector('.external-guests-icon') !== null;
                    const bIsExternal = b.querySelector('.external-guests-icon') !== null;
                    
                    // External contacts always at bottom
                    if (aIsExternal && !bIsExternal) return 1;
                    if (!aIsExternal && bIsExternal) return -1;
                    
                    // Last opened at top (but not external)
                    if (!aIsExternal && !bIsExternal && lastOpenedOrgId) {
                        if (aOrgId === lastOpenedOrgId && bOrgId !== lastOpenedOrgId) return -1;
                        if (aOrgId !== lastOpenedOrgId && bOrgId === lastOpenedOrgId) return 1;
                    }
                    
                    return 0; // Keep original order for others
                });
                
                // Re-append sections in sorted order
                sections.forEach(section => {
                    clientsContainer.appendChild(section);
                });
            }

            // Join code modal
            const joinCode = '@(TempData["JoinCode"] ?? "")';
            if (joinCode && joinCode.length > 0) {
                const modalEl = document.getElementById('joinCodeModal');
                if (modalEl) {
                    // Show modal using task-details-modal style
                    modalEl.style.display = 'flex';
                    document.body.style.overflow = 'hidden';
                    
                    const copyBtn = document.getElementById('copyJoinCodeBtn');
                    const notalizeBtn = document.getElementById('notalizeJoinCodeBtn');
                    const input = document.getElementById('joinCodeValue');
                    const closeBtn = document.getElementById('closeJoinCodeModal');
                    const doneBtn = document.getElementById('doneJoinCodeBtn');
                    const clientOrgId = @(TempData["NewClientOrgId"] ?? 0);
                    
                    // Copy functionality
                    if (copyBtn && input) {
                        copyBtn.addEventListener('click', async (e) => {
                            e.stopPropagation();
                            try {
                                await navigator.clipboard.writeText(input.value);
                                const originalHtml = copyBtn.innerHTML;
                                copyBtn.innerHTML = '<i class="fas fa-check"></i>';
                                setTimeout(() => {
                                    copyBtn.innerHTML = originalHtml;
                                }, 1500);
                            } catch (err) {
                                console.error('Failed to copy:', err);
                            }
                        });
                    }
                    
                    // Notalize functionality
                    if (notalizeBtn && input && clientOrgId) {
                        notalizeBtn.addEventListener('click', async (e) => {
                            e.stopPropagation();
                            await notalizeJoinCode(input.value, clientOrgId);
                        });
                    }
                    
                    // Close handlers
                    function closeJoinCodeModal() {
                        modalEl.style.display = 'none';
                        document.body.style.overflow = '';
                    }
                    
                    if (closeBtn) {
                        closeBtn.addEventListener('click', closeJoinCodeModal);
                    }
                    
                    if (doneBtn) {
                        doneBtn.addEventListener('click', closeJoinCodeModal);
                    }
                    
                    // Close on backdrop click
                    modalEl.addEventListener('click', function(e) {
                        if (e.target === modalEl) {
                            closeJoinCodeModal();
                        }
                    });
                }
            }

            // View Join Code functionality
            window.viewJoinCode = async function(orgId) {
                try {
                    const response = await fetch(`/Client/GetJoinCode?orgId=${orgId}`, {
                        method: 'GET',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    });

                    const data = await response.json();
                    if (data.success && data.joinCode) {
                        // Show the join code in a modal
                        showJoinCodeModal(data.joinCode, data.organizationName || 'Client Organization', orgId);
                    } else {
                        alert(data.message || 'Unable to retrieve join code. Please generate a new one.');
                    }
                } catch (error) {
                    console.error('Error fetching join code:', error);
                    alert('An error occurred while fetching the join code.');
                }
            };

            // Notalize join code functionality
            async function notalizeJoinCode(joinCode, clientOrgId) {
                try {
                    // Get law firm organization ID
                    const lawFirmOrgId = @(ViewBag.OrganizationId ?? 0);
                    if (!lawFirmOrgId) {
                        alert('Unable to determine organization context. Please try again.');
                        return;
                    }

                    // Disable button during request (check both button IDs)
                    const notalizeBtn = document.getElementById('notalizeViewJoinCodeBtn') || document.getElementById('notalizeJoinCodeBtn');
                    if (notalizeBtn) {
                        notalizeBtn.style.opacity = '0.5';
                        notalizeBtn.style.pointerEvents = 'none';
                    }

                    // Call notalize API
                    const response = await fetch(`/api/dm/notalize-join-code?orgId=${lawFirmOrgId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            JoinCode: joinCode,
                            ClientOrgId: clientOrgId,
                            TargetOrgId: clientOrgId
                        })
                    });

                    const result = await response.json();

                    if (result.success && result.thread && result.messageTemplate) {
                        // Store message template in sessionStorage for Communications page
                        sessionStorage.setItem('notalizeJoinCodeMessage', result.messageTemplate);
                        sessionStorage.setItem('notalizeJoinCodeThreadId', result.thread.id);
                        sessionStorage.setItem('notalizeJoinCodeOtherUserId', result.thread.otherUserId);
                        sessionStorage.setItem('notalizeJoinCodeOtherUserName', result.thread.otherUserName);

                        // Redirect to Communications page
                        window.location.href = `/Client/${lawFirmOrgId}/Communications?notalize=true`;
                    } else {
                        alert(result.error || 'Failed to notalize join code. Please try again.');
                        if (notalizeBtn) {
                            notalizeBtn.style.opacity = '';
                            notalizeBtn.style.pointerEvents = '';
                        }
                    }
                } catch (error) {
                    console.error('Error notalizing join code:', error);
                    alert('Failed to notalize join code. Please try again.');
                    const notalizeBtn = document.getElementById('notalizeViewJoinCodeBtn') || document.getElementById('notalizeJoinCodeBtn');
                    if (notalizeBtn) {
                        notalizeBtn.style.opacity = '';
                        notalizeBtn.style.pointerEvents = '';
                    }
                }
            }

            function showJoinCodeModal(joinCode, orgName, clientOrgId) {
                // Create or update modal
                let modal = document.getElementById('viewJoinCodeModal');
                if (!modal) {
                    modal = document.createElement('div');
                    modal.id = 'viewJoinCodeModal';
                    modal.className = 'task-details-modal';
                    modal.style.cssText = 'display: none; border-radius: 12px; left: 23vw; bottom: 0;';
                    modal.innerHTML = `
                        <div class="modal-dialog" style="margin-bottom: 1.5rem;">
                            <div class="task-details-content">
                                <!-- Modal Header -->
                                <div class="task-details-header" style="display: flex; justify-content: space-between; align-items: center; padding: 1.5rem;">
                                    <div class="task-details-header-left" style="display: flex; align-items: center; gap: 0.5rem; flex: 1;">
                                        <i class="fa-solid fa-key" style="color: #3d1019; font-size: 1.25rem;"></i>
                                        <h2 class="task-title" style="cursor: default; margin: 0; font-size: 1.25rem; font-weight: 600; color: #3d1019;">Join Code Generated</h2>
                                    </div>
                                    <div class="task-details-header-right" style="margin-left: auto;">
                                        <button type="button" class="btn-close" id="closeViewJoinCodeModal" aria-label="Close"></button>
                                    </div>
                                </div>

                                <!-- Success Message -->
                                <div class="task-details-body" style="padding: 0 1.5rem 1rem;">
                                    <div class="alert alert-success" style="margin-bottom: 1rem; border-radius: 8px;">
                                        <i class="fas fa-check-circle me-2"></i>
                                        Client organization '${orgName}' created successfully.
                                    </div>
                                </div>

                                <!-- Main Content Area -->
                                <div class="task-details-body">
                                    <!-- Left Panel -->
                                    <div class="task-details-left">
                                        <!-- Join Code Section -->
                                        <div class="task-section">
                                            <div class="task-section-header">
                                                <h6 class="task-section-title">
                                                    <i class="fas fa-key"></i> Join Code
                                                </h6>
                                            </div>
                                            <div class="task-section-content">
                                                <div style="position: relative; margin-bottom: 0.75rem;">
                                                    <input type="text" class="form-control form-control-lg" id="viewJoinCodeValue" readonly style="font-size: 1.25rem; font-weight: 600; letter-spacing: 0.1em; font-family: monospace; background-color: #f8f9fa; padding-right: 5.5rem;">
                                                    <div style="position: absolute; right: 0.5rem; top: 50%; transform: translateY(-50%); display: flex; align-items: center; gap: 0.5rem;">
                                                        <button class="join-code-action-btn" type="button" id="copyViewJoinCodeBtn" title="Copy">
                                                            <i class="fas fa-copy"></i>
                                                        </button>
                                                        <button class="join-code-action-btn" type="button" id="notalizeViewJoinCodeBtn" title="Notalize">
                                                            <img src="/images/Notal_Logo.png" alt="Notalize" style="width: 18px; height: 18px; object-fit: contain;" />
                                                        </button>
                                                    </div>
                                                </div>
                                                <small class="text-muted d-block mb-4" style="font-size: 0.875rem;">
                                                    Share this code with the client via email, also handled through Communications hub. It expires in 7 days.
                                                </small>
                                            </div>
                                        </div>

                                        <!-- Instructions Section -->
                                        <div class="task-section" style="margin-bottom: 0;">
                                            <div class="task-section-header">
                                                <h6 class="task-section-title">
                                                    <i class="fas fa-info-circle"></i> Instructions
                                                </h6>
                                            </div>
                                            <div class="task-section-content">
                                                <div style="font-size: 0.875rem; color: #4a5568;">
                                                    <p style="margin-bottom: 0.5rem;">
                                                        <strong>1.</strong> Click Notalize <em>(recommended)</em>, <strong>or</strong> Copy the join code above.
                                                    </p>
                                                    <p style="margin-bottom: 0.5rem;">
                                                        <strong>2.</strong> Share it with the client via email mode in the Communications hub.
                                                    </p>
                                                    <p style="margin-bottom: 0;">
                                                        <strong>3.</strong> The client will use this code to join the organization and will be pending until usage.
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="task-action-buttons" style="padding: 0 1.5rem 1.5rem; justify-content: flex-end;">
                                    <button type="button" class="btn btn-primary" id="doneViewJoinCodeBtn" style="border-radius: 0.5rem;">
                                        Done
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                    document.body.appendChild(modal);

                    // Setup event listeners
                    const closeBtn = modal.querySelector('#closeViewJoinCodeModal');
                    const doneBtn = modal.querySelector('#doneViewJoinCodeBtn');
                    const copyBtn = modal.querySelector('#copyViewJoinCodeBtn');
                    const notalizeBtn = modal.querySelector('#notalizeViewJoinCodeBtn');
                    const input = modal.querySelector('#viewJoinCodeValue');

                    function closeModal() {
                        modal.style.display = 'none';
                        document.body.style.overflow = '';
                    }

                    closeBtn.addEventListener('click', closeModal);
                    doneBtn.addEventListener('click', closeModal);

                    if (copyBtn && input) {
                        copyBtn.addEventListener('click', async (e) => {
                            e.stopPropagation();
                            try {
                                await navigator.clipboard.writeText(input.value);
                                const originalHtml = copyBtn.innerHTML;
                                copyBtn.innerHTML = '<i class="fas fa-check"></i>';
                                setTimeout(() => {
                                    copyBtn.innerHTML = originalHtml;
                                }, 1500);
                            } catch (err) {
                                console.error('Failed to copy:', err);
                            }
                        });
                    }

                    if (notalizeBtn && input) {
                        notalizeBtn.addEventListener('click', async (e) => {
                            e.stopPropagation();
                            await notalizeJoinCode(input.value, clientOrgId);
                        });
                    }

                    modal.addEventListener('click', function(e) {
                        if (e.target === modal) {
                            closeModal();
                        }
                    });
                }

                // Update modal content
                document.getElementById('viewJoinCodeValue').value = joinCode;
                // Update success message with organization name
                const successAlert = modal.querySelector('.alert-success');
                if (successAlert) {
                    successAlert.innerHTML = `<i class="fas fa-check-circle me-2"></i>Client organization '${orgName}' created successfully.`;
                }
                modal.style.display = 'flex';
                document.body.style.overflow = 'hidden';
            }
        });
    </script>
}

