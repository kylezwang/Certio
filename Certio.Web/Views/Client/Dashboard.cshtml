@model Certio.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_ClientLayout";
}

<div class="global-dashboard-main">
    <div class="row h-100">
        <!-- Full Width Content -->
        <div class="col-12 main-column">
    <!-- AI Chat Section -->
    <div class="card mb-4 mt-3 border-0 ai-chat-card gd-card" id="aiChatCard">
        <div class="card-body p-0 ai-chat-card-body">
            <button class="btn btn-link text-muted p-0 ai-fullscreen-btn" id="aiFullscreenBtn" title="Toggle fullscreen">
                <i class="fas fa-expand"></i>
            </button>
            <div class="row g-0 h-100">
                <!-- Conversations Column -->
                <div class="col-md-3 conversations-column" id="conversationsColumn">
                    <div class="conversations-list" id="conversationsList">
                        <div class="conversations-loading">Loading conversations...</div>
                    </div>
                </div>
                <!-- Main Chat Content -->
                <div class="col-12 ai-chat-main-content" id="aiChatMainContent">
                    <!-- Default Landing View (shown when no conversation selected) -->
                    <div class="p-4 dashboard-landing-view" id="dashboardLandingView">
                        <div class="text-center mb-3">
                            <img src="~/images/Notal_Banner_Logo_Large_Text.png" alt="Notal AI" style="height: 45px; object-fit: contain;" />
                        </div>
                        <h2 class="text-center mb-4 fs-2 fw-semibold text-dark">What can I help with?</h2>
                        
                        <div class="search-container-large" id="searchContainer">
                            <i class="fas fa-plus"></i>
                            <input type="text" class="form-control form-control-lg" id="dashboardSearchInput" placeholder="Ask anything" />
                            <div class="search-actions">
                                <button class="btn btn-link text-muted">
                                    <i class="fas fa-microphone"></i>
                                </button>
                                <button class="btn btn-link text-muted" id="dashboardSendBtn">
                                    <i class="fas fa-paper-plane"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Conversation View (shown when conversation is selected) -->
                    <div class="dashboard-conversation-view" id="dashboardConversationView" style="display: none;">
                        <!-- Messages Container -->
                        <div class="dashboard-chat-messages" id="dashboardChatMessages">
                            <!-- Notal AI Conversation Header -->
                            <div class="notal-conversation-header" id="dashboardNotalHeader" style="display: none;">
                                <div class="ai-message-bubble">
                                    <div class="message-content">
                                        <div class="message-header">
                                            <img src="/images/Notal_Banner_Logo.png" alt="Notal AI" class="ai-message-logo" />
                                            <span class="timestamp">Just now</span>
                                        </div>
                                        <div class="message-text">
                                            Hi! I'm Notal, your AI legal assistant. How can I help you today?
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Messages will be loaded here -->
                        </div>
                        
                        <!-- Chat Input -->
                        <div class="dashboard-chat-input">
                            <div class="input-container">
                                <!-- Attachment Preview (hidden by default) -->
                                <div class="attachment-preview" id="dashboardAttachmentPreview" style="display: none;">
                                    <i class="fas fa-paperclip attachment-preview-icon"></i>
                                    <div class="attachment-preview-info">
                                        <div class="attachment-preview-name" id="dashboardAttachmentName">Document.pdf</div>
                                        <div class="attachment-preview-size" id="dashboardAttachmentSize">2.4 MB</div>
                                    </div>
                                    <button class="attachment-preview-remove" id="dashboardRemoveAttachment" title="Remove attachment">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                                
                                <!-- Main Input Row -->
                                <div class="message-input-wrapper">
                                    <textarea class="message-input" 
                                              id="dashboardMessageInput" 
                                              placeholder="Message Notal..." 
                                              rows="1"
                                              maxlength="2000"></textarea>
                                    <button class="send-button" id="dashboardSendButton" title="Send message">
                                        <i class="fas fa-paper-plane"></i>
                                    </button>
                                </div>
                                
                                <!-- Action Buttons Row -->
                                <div class="input-actions-row">
                                    <button class="input-action-btn" id="dashboardAttachFileBtn" title="Attach file">
                                        <i class="fas fa-paperclip"></i>
                                    </button>
                                    <button class="input-action-btn" id="dashboardEmojiBtn" title="Add emoji">
                                        <i class="fas fa-smile"></i>
                                    </button>
                                    <button class="input-action-btn" id="dashboardMicBtn" title="Voice message">
                                        <i class="fas fa-microphone"></i>
                                    </button>
                                    <div class="input-action-btn-group">
                                        <button class="input-action-btn" id="dashboardCodeBtn" title="Character Count">
                                            <i class="fas fa-code"></i>
                                        </button>
                                        <div class="char-counter" id="dashboardCharCounter">0 / 2000</div>
                                    </div>
                                </div>
                            </div>
                            <!-- Hidden file input for attachments -->
                            <input type="file" id="dashboardFileInput" style="display: none;" accept=".pdf,.doc,.docx,.txt,.png,.jpg,.jpeg">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Access Section -->
    <div class="card mb-4 border-0 gd-card">
        <div class="card-body p-4">
            <h5 class="card-title fw-bold mb-3">Quick Access</h5>
            
            <div class="row gx-4 gy-3">
                @if (Model.OrganizationType == Certio.Domain.Organizations.OrganizationType.LawFirm)
                {
                    <div class="col-md-3">
                        <a href="#" class="quick-access-item qa-card" data-action="open-global-clients">
                            <div class="d-flex flex-column align-items-center text-center p-3">
                                <div class="quick-access-icon mb-2">
                                    <i class="fas fa-users text-purple"></i>
                                </div>
                                <span class="fw-medium">Clients</span>
                            </div>
                        </a>
                    </div>
                }
                else
                {
                    <div class="col-md-3">
                        <a href="/Client/@ViewBag.OrganizationId/Teams" class="quick-access-item qa-card">
                            <div class="d-flex flex-column align-items-center text-center p-3">
                                <div class="quick-access-icon mb-2">
                                    <i class="fa-solid fa-user-group text-purple"></i>
                                </div>
                                <span class="fw-medium">Teams</span>
                            </div>
                        </a>
                    </div>
                }
                <div class="col-md-3">
                    <a href="/Client/@ViewBag.OrganizationId/Calendar" class="quick-access-item qa-card">
                        <div class="d-flex flex-column align-items-center text-center p-3">
                            <div class="quick-access-icon mb-2">
                                <i class="far fa-calendar text-success"></i>
                            </div>
                            <span class="fw-medium">Calendar</span>
                        </div>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/Client/@ViewBag.OrganizationId/Billing" class="quick-access-item qa-card">
                        <div class="d-flex flex-column align-items-center text-center p-3">
                            <div class="quick-access-icon mb-2">
                                <i class="fa-regular fa-credit-card text-warning"></i>
                            </div>
                            <span class="fw-medium">Billing</span>
                        </div>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/Client/@ViewBag.OrganizationId/History" class="quick-access-item qa-card">
                        <div class="d-flex flex-column align-items-center text-center p-3">
                            <div class="quick-access-icon mb-2">
                                <i class="fas fa-clock text-info"></i>
                            </div>
                            <span class="fw-medium">History</span>
                        </div>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/Client/@ViewBag.OrganizationId/Matter" class="quick-access-item qa-card">
                        <div class="d-flex flex-column align-items-center text-center p-3">
                            <div class="quick-access-icon mb-2">
                                <i class="fas fa-briefcase" style="color: #0b365e;"></i>
                            </div>
                            <span class="fw-medium">Matters</span>
                        </div>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/Client/@ViewBag.OrganizationId/Tasks" class="quick-access-item qa-card">
                        <div class="d-flex flex-column align-items-center text-center p-3">
                            <div class="quick-access-icon mb-2">
                                <i class="fa-solid fa-bars-progress" style="color: #9bc0ec;"></i>
                            </div>
                            <span class="fw-medium">Tasks</span>
                        </div>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/Client/@ViewBag.OrganizationId/Communications" class="quick-access-item qa-card">
                        <div class="d-flex flex-column align-items-center text-center p-3">
                            <div class="quick-access-icon mb-2">
                                <i class="far fa-comments text-danger"></i>
                            </div>
                            <span class="fw-medium">Communications</span>
                        </div>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/Client/@ViewBag.OrganizationId/Documents" class="quick-access-item qa-card">
                        <div class="d-flex flex-column align-items-center text-center p-3">
                            <div class="quick-access-icon mb-2">
                                <i class="far fa-file-alt text-primary"></i>
                            </div>
                            <span class="fw-medium">Documents</span>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Row: Upcoming Deadlines, Daily Briefing, Next Suggestions -->
    <div class="row gx-4">
        <!-- Upcoming Deadlines -->
        <div class="col-md-4 mb-4">
            <div class="card border-0 h-100 gd-card">
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold mb-3"><i class="fa-solid fa-calendar-day me-2 text-muted" style="font-size: 0.75em;"></i>Upcoming Deadlines</h5>
                    
                    <div id="dashboardUpcomingDeadlinesList">
                        <p class="text-muted small mb-2">Loading deadlines...</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Daily Briefing -->
        <div class="col-md-4 mb-4">
            <div class="card border-0 h-100 daily-briefing-card gd-card">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-chart-pie text-muted me-2" style="font-size: 0.9em;"></i>
                        <h5 class="card-title fw-bold mb-0">Daily Briefing</h5>
                    </div>
                    
                    <div class="briefing-item mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-semibold">Today</span>
                        </div>
                        <span class="text-primary fw-bold">@Model.FilingsDueToday filings due</span>
                        <div class="text-muted small">@Model.FilingsDueDescription</div>
                    </div>
                    
                    <div class="briefing-item mb-3">
                        <div class="text-primary fw-bold">@Model.ClientCallsToday client call</div>
                        <div class="text-muted small">@Model.ClientCallsDescription</div>
                    </div>
                    
                    <div class="briefing-item">
                        <div class="text-primary fw-bold">@Model.OverdueInvoices overdue invoice</div>
                        <div class="text-muted small">@Model.OverdueInvoicesDescription</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Next Suggestions -->
        <div class="col-md-4 mb-4">
            <div class="card border-0 h-100 gd-card">
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold mb-3"><img src="~/images/Notal_Banner_Logo_Large_Text.png" alt="Notal AI" style="height: 1.3rem; object-fit: contain; display: inline-block; margin-right: 0.25rem; margin-bottom: 0.2rem;" />Suggestions</h5>
                    
                    @if (Model.NextSuggestions.Any())
                    {
                        @foreach (var suggestion in Model.NextSuggestions.Take(3))
                        {
                            <div class="suggestion-item mb-3">
                                <div class="fw-semibold">@suggestion.Title</div>
                                <div class="text-muted small">@suggestion.Description</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="suggestion-item mb-3">
                            <div class="fw-semibold">Matter Z inactive 12 days</div>
                            <div class="text-muted small">→ follow up</div>
                        </div>
                        
                        <div class="suggestion-item mb-3">
                            <div class="fw-semibold">3 overdue invoices</div>
                            <div class="text-muted small">→ send reminders</div>
                        </div>
                        
                        <div class="suggestion-item">
                            <div class="fw-semibold">Paralegal C overloaded</div>
                            <div class="text-muted small">→ consider reassigning</div>
                        </div>
                    }
                </div>
            </div>
        </div>
        </div>
    </div>
</div>

<style>
    .global-dashboard-main {
        padding: 0 0.75rem;
        max-width: 1400px; /* Constrain max width */
        margin: 0 auto; /* Center the dashboard content */
    }

    /* Force 4x2 grid layout for quick access */
    .global-dashboard-main .row > [class^="col-"] {
    }
    .global-dashboard-main .row .col-md-3 .quick-access-item {
        width: 100%;
    }

    .card {
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.25);
    }

    .ai-chat-card {
        position: relative;
        transition: all 0.3s ease;
    }

    .ai-chat-card.activated {
        min-height: calc(100vh - 300px);
    }

    .ai-chat-card-body {
        padding: 1rem 0; /* Minimal padding for default state */
        transition: all 0.3s ease-in-out;
        position: relative; /* For absolute positioning of conversations column */
    }

    /* Expand height when activated to fill remaining space */
    .ai-chat-card.activated .ai-chat-card-body {
        height: calc(100vh - 300px); /* Fill remaining viewport height */
        min-height: calc(100vh - 300px);
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .ai-chat-card.activated .ai-chat-card-body .row {
        flex: 1;
        min-height: 0;
        height: 100%;
        display: flex;
        align-items: stretch;
    }

    .ai-chat-card.fullscreen .ai-chat-card-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .ai-chat-card.fullscreen .ai-chat-card-body .row {
        flex: 1;
        min-height: 0;
        height: 100%;
        display: flex;
        align-items: stretch;
    }

    .ai-fullscreen-btn {
        position: absolute;
        top: 1rem;
        right: 1rem;
        font-size: 1.25rem;
        color: #6c757d !important;
        background: none;
        border: none;
        cursor: pointer;
        z-index: 10;
        transition: color 0.2s ease;
    }

    .ai-fullscreen-btn:hover {
        color: #495057 !important;
    }

    .ai-chat-card.fullscreen {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        width: 100% !important;
        height: 100% !important;
        max-width: none !important;
        margin: 0 !important;
        z-index: 1000 !important;
        border-radius: 12px !important;
        display: flex !important;
        flex-direction: column !important;
    }

    .ai-chat-card.fullscreen .card-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .ai-chat-card.fullscreen .conversations-column {
        max-height: 100%;
    }


    /* Conversations Column - Hidden by default */
    .conversations-column {
        background-color: transparent; /* Remove background - scrollbar will show through */
        border-right: none;
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 0;
        min-width: 0;
        padding: 0;
        margin: 0;
        visibility: hidden;
        opacity: 0;
        transform: translateX(-100%);
        transition: width 0.3s ease-in-out, transform 0.3s ease-in-out, opacity 0.3s ease-in-out, visibility 0.3s ease-in-out;
        overflow: hidden;
        z-index: 1;
        flex: none !important;
        max-width: none !important;
    }

    .ai-chat-card.activated .conversations-column,
    .ai-chat-card.fullscreen .conversations-column {
        border-right: 1px solid #ddd;
    }

    /* Show conversations column when activated */
    .ai-chat-card.activated .conversations-column {
        width: 25%;
        visibility: visible;
        opacity: 1;
        transform: translateX(0);
        overflow-y: auto;
    }

    .ai-chat-card.activated .conversations-column .conversations-list {
        padding: 1rem;
    }

    /* Always show in fullscreen mode */
    .ai-chat-card.fullscreen .conversations-column {
        width: 25% !important;
        visibility: visible !important;
        opacity: 1 !important;
        transform: translateX(0) !important;
        overflow-y: auto !important;
    }

    .ai-chat-card.fullscreen .conversations-column .conversations-list {
        padding: 1rem !important;
    }

    /* Adjust main content when activated - use margin instead of flex to prevent shift */
    .ai-chat-main-content {
        transition: margin-left 0.3s ease-in-out;
        margin-left: 0;
        position: relative;
        z-index: 0;
    }

    /* Center content vertically and horizontally when activated */
    .ai-chat-card.activated .ai-chat-main-content {
        margin-left: 25%;
        height: 100%;
        min-height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 1;
        align-self: stretch;
    }

    .ai-chat-card.activated .ai-chat-main-content > div {
        width: 100%;
    }

    .ai-chat-card.fullscreen .ai-chat-main-content {
        margin-left: 25% !important;
        height: 100% !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        flex: 1 !important;
    }

    .ai-chat-card.fullscreen .ai-chat-main-content > div {
        width: 100% !important;
    }

    .conversations-column::-webkit-scrollbar {
        width: 6px;
    }

    .conversations-column::-webkit-scrollbar-track {
        background: transparent; /* Remove track background */
    }

    .conversations-column::-webkit-scrollbar-thumb {
        background: #ececec; /* Use the lighter gray color for the scrollbar */
        border-radius: 3px;
        border: 1px solid rgba(0, 0, 0, 0.05); /* Very subtle border for definition */
    }

    .conversations-column::-webkit-scrollbar-thumb:hover {
        background: #d5d5d5; /* Slightly darker on hover for feedback */
    }

    /* Firefox scrollbar styling */
    .conversations-column {
        scrollbar-width: thin;
        scrollbar-color: #ececec transparent;
    }

    .conversations-list {
        padding: 1rem;
    }

    .conversations-loading {
        text-align: center;
        color: #6c757d;
        font-size: 0.875rem;
        padding: 1rem;
    }

    .conversation-item {
        padding: 0.75rem;
        margin-bottom: 0.5rem;
        background-color: rgba(255, 255, 255, 0.7);
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        border: 1px solid transparent;
    }

    .conversation-item:hover {
        background-color: rgba(255, 255, 255, 0.9);
        border-color: rgba(61, 16, 25, 0.2);
    }

    .conversation-item.active {
        background-color: #3d1019;
        color: white;
        border-color: #3d1019;
    }

    .conversation-item .conversation-title {
        font-size: 0.875rem;
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        margin: 0;
    }

    .conversation-item.active .conversation-title {
        color: white;
    }

    .ai-chat-main-content {
        display: flex;
        flex-direction: column;
    }

    .search-container-large {
        position: relative;
        max-width: 600px;
        width: 100%;
        margin: 0 auto;
    }

    .search-container-large input {
        padding: 0.75rem 3rem 0.75rem 3rem;
        border: 1px solid #e5e7eb;
        border-radius: 24px;
        background-color: #f9fafb;
        font-size: 1rem;
    }

    /* Match placeholder to Matters subtitle (lead text) */
    .search-container-large input::placeholder {
        font-size: 1.1rem;
        font-weight: 300;
        color: #6c757d;
    }

    .search-container-large i.fa-plus {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        color: #6b7280;
    }

    .search-actions {
        position: absolute;
        right: 0.5rem;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        gap: 0.25rem;
    }

    .search-actions .btn {
        padding: 0.25rem 0.5rem;
        border: none;
    }

    .quick-access-item {
        display: block;
        text-decoration: none;
        color: inherit;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    /* Add shadow and spacing on the card itself so gutters show between tiles */
    .qa-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.25);
        display: block;
        transition: transform 0.2s ease, background-color 0.2s ease;
    }

    /* Single hover effect for qa-card buttons */
    .qa-card:hover {
        background-color: #eef1f3;
        color: inherit;
        text-decoration: none;
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.2) !important;
    }

    .quick-access-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .text-purple {
        color: #8b5cf6 !important;
    }

    /* Match Matters card styling */
    .gd-card {
        transition: all 0.3s ease;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.25);
    }

    .gd-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 1px 12px rgba(0, 0, 0, 0.2) !important;
    }

    /* Firm Summary styles */
    .firm-stat {
        padding: 0.5rem 0;
    }

    /* Daily Briefing styles */
    .daily-briefing-card .card-body {
        background: white;
        border-radius: 12px;
    }

    .briefing-item {
        padding: 0.5rem 0;
    }

    /* Suggestion styles */
    .suggestion-item {
        padding: 0.5rem 0;
        border-bottom: 1px solid #f3f4f6;
    }

    .suggestion-item:last-child {
        border-bottom: none;
    }

    /* Main column styling */
    .main-column {
        padding: 0 0.75rem;
    }

    /* Override main content padding for Client Dashboard only */
    .main-content.client-main-content {
        padding: 0 !important;
    }

    /* Dashboard Chat Styles */
    .dashboard-conversation-view {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
    }

    .dashboard-chat-messages {
        flex: 1;
        padding: 1rem;
        overflow-y: auto;
        background-color: #ffffff;
        scroll-behavior: smooth;
        min-height: 0;
    }

    .dashboard-chat-messages::-webkit-scrollbar {
        width: 6px;
    }

    .dashboard-chat-messages::-webkit-scrollbar-track {
        background: transparent;
    }

    .dashboard-chat-messages::-webkit-scrollbar-thumb {
        background: rgba(0, 0, 0, 0.2);
        border-radius: 3px;
    }

    .dashboard-chat-messages::-webkit-scrollbar-thumb:hover {
        background: rgba(0, 0, 0, 0.35);
    }

    .dashboard-chat-input {
        padding: 1rem;
        border-top: 1px solid #e5e7eb;
        background-color: #ffffff;
    }

    /* Ensure conversation view takes full height when activated */
    .ai-chat-card.activated .dashboard-conversation-view {
        height: 100%;
    }

    .ai-chat-card.fullscreen .dashboard-conversation-view {
        height: 100%;
    }

</style>

@section Scripts {
    @if (Model.OrganizationType == Certio.Domain.Organizations.OrganizationType.LawFirm)
    {
        <script>
            // For LawFirm organizations, trigger the clients popup from _Layout.cshtml
            document.addEventListener('DOMContentLoaded', function () {
                document.querySelectorAll('[data-action="open-global-clients"]').forEach(function (el) {
                    el.addEventListener('click', function (e) {
                        e.preventDefault();
                        e.stopPropagation(); // prevent the global outside-click handler from immediately closing it
                        const btn = document.getElementById('clientsButton');
                        if (!btn) return;
                        // Trigger the same handler without bubbling to document
                        btn.dispatchEvent(new MouseEvent('click', { bubbles: false }));
                    });
                });
            });
        </script>
    }
    
    <script>
        // Load upcoming deadlines for dashboard
        document.addEventListener('DOMContentLoaded', async function () {
            await loadDashboardUpcomingDeadlines();
            initializeAiFullscreen();
            initializeAiChatActivation();
            await loadDashboardConversations();
        });

        function initializeAiChatActivation() {
            const aiCard = document.getElementById('aiChatCard');
            const searchContainer = document.getElementById('searchContainer');
            
            if (!aiCard || !searchContainer) return;

            // Handle click on search container to activate
            searchContainer.addEventListener('click', function(e) {
                // Don't activate if clicking on action buttons
                if (e.target.closest('.search-actions') || e.target.closest('.btn')) {
                    return;
                }
                
                // Focus the input if clicking on container
                const input = searchContainer.querySelector('input');
                if (input && e.target === searchContainer) {
                    input.focus();
                }
                
                // Activate if not already activated (unless fullscreen)
                if (!aiCard.classList.contains('activated') && !aiCard.classList.contains('fullscreen')) {
                    aiCard.classList.add('activated');
                }
            });

            // Handle input focus to activate
            const input = searchContainer.querySelector('input');
            if (input) {
                input.addEventListener('focus', function() {
                    if (!aiCard.classList.contains('activated') && !aiCard.classList.contains('fullscreen')) {
                        aiCard.classList.add('activated');
                    }
                });
            }
        }

        async function loadDashboardConversations() {
            const conversationsList = document.getElementById('conversationsList');
            if (!conversationsList) return;

            try {
                const orgId = @ViewBag.OrganizationId;
                if (!orgId) {
                    conversationsList.innerHTML = '<div class="conversations-loading">No organization selected</div>';
                    return;
                }

                const response = await fetch(`/Client/${orgId}/Chat/GetAIConversations`, {
                    credentials: 'include'
                });

                if (!response.ok) {
                    conversationsList.innerHTML = '<div class="conversations-loading">No AI conversations yet</div>';
                    return;
                }

                const conversations = await response.json();

                if (!conversations || conversations.length === 0) {
                    conversationsList.innerHTML = '<div class="conversations-loading">No AI conversations yet</div>';
                    return;
                }

                // Render conversations vertically
                conversationsList.innerHTML = conversations.map(conversation => {
                    return `
                        <div class="conversation-item" data-conversation-id="${conversation.id}">
                            <div class="conversation-title">${conversation.title || 'Untitled Conversation'}</div>
                        </div>
                    `;
                }).join('');

                // Add click handlers - scoped to dashboard conversations only
                conversationsList.querySelectorAll('.conversation-item').forEach(item => {
                    item.addEventListener('click', function(e) {
                        e.stopPropagation(); // Prevent event from bubbling to sidebar handlers
                        
                        // Scope selection to dashboard conversations list only
                        const dashboardConversationsList = document.getElementById('conversationsList');
                        if (!dashboardConversationsList) return;
                        
                        // Remove active class from all dashboard items only
                        dashboardConversationsList.querySelectorAll('.conversation-item').forEach(i => {
                            i.classList.remove('active');
                        });
                        
                        // Add active class to clicked item
                        this.classList.add('active');
                        
                        // Save to localStorage with dashboard-specific key
                        const conversationId = this.dataset.conversationId;
                        localStorage.setItem('dashboardSelectedConversation', conversationId);
                        
                        // Activate the card if not already activated
                        const aiCard = document.getElementById('aiChatCard');
                        if (aiCard && !aiCard.classList.contains('fullscreen')) {
                            aiCard.classList.add('activated');
                        }
                        
                        // Load conversation messages and show conversation view
                        loadDashboardConversation(conversationId);
                    });
                });

                // Restore previously selected conversation - scoped to dashboard only
                const savedConversationId = localStorage.getItem('dashboardSelectedConversation');
                if (savedConversationId) {
                    // Only look within the dashboard conversations list
                    const savedItem = conversationsList.querySelector(`.conversation-item[data-conversation-id="${savedConversationId}"]`);
                    if (savedItem) {
                        // Remove active class from all dashboard items only
                        conversationsList.querySelectorAll('.conversation-item').forEach(i => {
                            i.classList.remove('active');
                        });
                        
                        // Add active class to saved item
                        savedItem.classList.add('active');
                        
                        // Activate the card
                        const aiCard = document.getElementById('aiChatCard');
                        if (aiCard && !aiCard.classList.contains('fullscreen')) {
                            aiCard.classList.add('activated');
                        }
                        
                        // Load conversation messages
                        loadDashboardConversation(savedConversationId);
                    }
                }

            } catch (error) {
                console.error('Error loading conversations:', error);
                conversationsList.innerHTML = '<div class="conversations-loading">Failed to load conversations</div>';
            }
        }

        function initializeAiFullscreen() {
            const aiCard = document.getElementById('aiChatCard');
            const fullscreenBtn = document.getElementById('aiFullscreenBtn');
            const mainContent = document.querySelector('.main-content.client-main-content');
            
            if (!aiCard || !fullscreenBtn) return;

            function toggleFullscreen(isFullscreen) {
                if (isFullscreen) {
                    aiCard.classList.add('fullscreen', 'activated'); // Always activate conversations in fullscreen
                    if (mainContent) {
                        mainContent.style.position = 'relative';
                        mainContent.style.overflow = 'hidden';
                    }
                    const icon = fullscreenBtn.querySelector('i');
                    icon.classList.remove('fa-expand');
                    icon.classList.add('fa-compress');
                } else {
                    aiCard.classList.remove('fullscreen');
                    // Keep activated state if it was activated before fullscreen
                    if (mainContent) {
                        mainContent.style.position = '';
                        mainContent.style.overflow = '';
                    }
                    const icon = fullscreenBtn.querySelector('i');
                    icon.classList.remove('fa-compress');
                    icon.classList.add('fa-expand');
                }
            }

            fullscreenBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                const isFullscreen = aiCard.classList.contains('fullscreen');
                toggleFullscreen(!isFullscreen);
            });

            // Allow ESC key to exit fullscreen
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && aiCard.classList.contains('fullscreen')) {
                    toggleFullscreen(false);
                }
            });
        }

        // Dashboard conversation state
        let dashboardCurrentConversationId = null;

        // Load conversation messages for dashboard
        async function loadDashboardConversation(conversationId) {
            dashboardCurrentConversationId = conversationId;
            
            // Show conversation view, hide landing view
            const landingView = document.getElementById('dashboardLandingView');
            const conversationView = document.getElementById('dashboardConversationView');
            
            if (landingView) landingView.style.display = 'none';
            if (conversationView) {
                conversationView.style.display = 'flex';
                // Ensure it takes full height
                conversationView.style.height = '100%';
            }
            
            // Show conversation header
            const notalHeader = document.getElementById('dashboardNotalHeader');
            if (notalHeader) notalHeader.style.display = 'block';
            
            // Load messages
            await loadDashboardConversationMessages(conversationId);
            
            // Initialize dashboard chat input handlers
            initializeDashboardChatInput();
        }

        // Load messages for a conversation
        async function loadDashboardConversationMessages(conversationId) {
            const chatMessages = document.getElementById('dashboardChatMessages');
            if (!chatMessages) return;
            
            try {
                const orgId = @ViewBag.OrganizationId;
                if (!orgId) {
                    console.error('Organization ID not found');
                    return;
                }
                
                const response = await fetch(`/Client/${orgId}/Chat/GetMessages/${conversationId}`);
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const messages = await response.json();
                
                // Clear existing messages (except header)
                const messagesToRemove = chatMessages.querySelectorAll('.ai-message-bubble:not(.notal-conversation-header .ai-message-bubble), .user-message-bubble');
                messagesToRemove.forEach(msg => msg.remove());
                
                // Display messages
                messages.forEach(message => {
                    addDashboardMessageToChat(message);
                });
                
                // Scroll to bottom
                chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'instant' });
                
            } catch (error) {
                console.error('Error loading messages:', error);
                chatMessages.innerHTML += '<div class="text-danger p-2">Failed to load messages</div>';
            }
        }

        // Add message to dashboard chat
        function addDashboardMessageToChat(message) {
            const chatMessages = document.getElementById('dashboardChatMessages');
            if (!chatMessages) return;
            
            const messageDiv = document.createElement('div');
            const isAI = message.isFromAI || false;
            messageDiv.className = isAI ? 'ai-message-bubble' : 'user-message-bubble';
            
            const timestamp = new Date(message.createdAt || Date.now()).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
            
            // Use content directly as HTML (like sidebar does) - AI returns HTML-formatted content
            let formattedContent = message.content || '';
            
            if (isAI) {
                messageDiv.innerHTML = `
                    <div class="message-content">
                        <div class="message-header">
                            <img src="/images/Notal_Banner_Logo.png" alt="Notal AI" class="ai-message-logo" />
                            <span class="timestamp">${timestamp}</span>
                        </div>
                        <div class="message-text">${formattedContent}</div>
                    </div>
                `;
            } else {
                // For user messages, escape HTML for security
                formattedContent = formattedContent
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/\\n/g, '\n')
                    .replace(/\n/g, '<br>');
                
                messageDiv.innerHTML = `
                    <div class="message-content">
                        <div class="message-header">
                            <span class="timestamp">${timestamp}</span>
                        </div>
                        <div class="message-text">${formattedContent}</div>
                    </div>
                `;
            }
            
            chatMessages.appendChild(messageDiv);
            chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'instant' });
        }

        // Initialize dashboard chat input handlers
        function initializeDashboardChatInput() {
            const messageInput = document.getElementById('dashboardMessageInput');
            const sendButton = document.getElementById('dashboardSendButton');
            
            if (!messageInput || !sendButton) return;
            
            // Check if already initialized to avoid duplicate listeners
            if (messageInput.dataset.initialized === 'true') return;
            messageInput.dataset.initialized = 'true';
            
            // Send message handler
            const sendMessage = async () => {
                const input = document.getElementById('dashboardMessageInput');
                const message = input.value.trim();
                
                if (!message || !dashboardCurrentConversationId) return;
                
                // Clear input
                input.value = '';
                updateDashboardCharCounter();
                
                // Add user message immediately
                addDashboardMessageToChat({
                    content: message,
                    isFromAI: false,
                    createdAt: new Date().toISOString()
                });
                
                // Show intelligent AI thinking indicator
                showDashboardAIThinkingIndicator(message);
                
                // Send to server
                try {
                    const orgId = @ViewBag.OrganizationId;
                    const response = await fetch(`/Client/${orgId}/Chat/SendMessage`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: `conversationId=${dashboardCurrentConversationId}&content=${encodeURIComponent(message)}&messageType=Text`
                    });
                    
                    const data = await response.json();
                    
                    if (data.success) {
                        // Generate streaming AI response
                        await generateDashboardAIResponse(message);
                    } else {
                        console.error('Failed to send message:', data.error);
                        hideDashboardAIThinkingIndicator();
                    }
                } catch (error) {
                    console.error('Error sending message:', error);
                    hideDashboardAIThinkingIndicator();
                }
            };
            
            // Event listeners
            sendButton.addEventListener('click', sendMessage);
            messageInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    sendMessage();
                }
            });
            
            // Character counter
            messageInput.addEventListener('input', updateDashboardCharCounter);
            
            // Auto-resize textarea
            messageInput.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 120) + 'px';
            });
        }

        // Update character counter
        function updateDashboardCharCounter() {
            const input = document.getElementById('dashboardMessageInput');
            const counter = document.getElementById('dashboardCharCounter');
            if (input && counter) {
                const length = input.value.length;
                counter.textContent = `${length} / 2000`;
            }
        }

        // Show intelligent AI thinking indicator (dashboard version)
        function showDashboardAIThinkingIndicator(userMessage) {
            const chatMessages = document.getElementById('dashboardChatMessages');
            if (!chatMessages) return;
            
            // Determine thinking message based on user input
            let thinkingMessage = "AI is thinking...";
            const messageLower = userMessage.toLowerCase();
            
            if (messageLower.includes("document review") || messageLower.includes("review")) {
                thinkingMessage = "Analyzing document requirements...";
            } else if (messageLower.includes("contract") || messageLower.includes("agreement")) {
                thinkingMessage = "Reviewing contract details...";
            } else if (messageLower.includes("hello") || messageLower.includes("hi")) {
                thinkingMessage = "Preparing personalized greeting...";
            } else if (messageLower.includes("help") || messageLower.includes("assistance")) {
                thinkingMessage = "Identifying best assistance approach...";
            } else if (messageLower.includes("legal") || messageLower.includes("law")) {
                thinkingMessage = "Processing legal inquiry...";
            } else if (messageLower.includes("question") || messageLower.includes("?")) {
                thinkingMessage = "Formulating detailed response...";
            }
            
            const thinkingDiv = document.createElement('div');
            thinkingDiv.id = 'dashboard-ai-thinking-indicator';
            thinkingDiv.className = 'message ai-message';
            thinkingDiv.innerHTML = `
                <div class="message-header">
                    <img src="/images/Notal_Banner_Logo.png" alt="Notal AI" class="ai-message-logo" />
                    <span class="timestamp">${new Date().toLocaleTimeString()}</span>
                </div>
                <div class="message-content">
                    <div class="ai-thinking">
                        <div class="thinking-spinner">
                            <div class="spinner-border spinner-border-sm" role="status">
                                <span class="sr-only">Loading...</span>
                            </div>
                        </div>
                        <span class="thinking-text" id="dashboardThinkingText">${thinkingMessage}</span>
                    </div>
                </div>
            `;
            
            chatMessages.appendChild(thinkingDiv);
            chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'instant' });
            
            // Apply wave animation to thinking text
            const thinkingTextElement = thinkingDiv.querySelector('#dashboardThinkingText');
            if (thinkingTextElement) {
                const text = thinkingTextElement.textContent;
                thinkingTextElement.innerHTML = text.split('').map((char, index) => {
                    const delay = index * 0.05; // 50ms delay between each character
                    return `<span style="animation-delay: ${delay}s;">${char === ' ' ? '&nbsp;' : char}</span>`;
                }).join('');
            }
        }

        // Hide AI thinking indicator (dashboard version)
        function hideDashboardAIThinkingIndicator() {
            const thinkingDiv = document.getElementById('dashboard-ai-thinking-indicator');
            if (thinkingDiv) {
                thinkingDiv.remove();
            }
        }

        // Create streaming AI message placeholder (dashboard version)
        function createDashboardStreamingAIMessagePlaceholder() {
            const chatMessages = document.getElementById('dashboardChatMessages');
            if (!chatMessages) return null;
            
            const messageDiv = document.createElement('div');
            messageDiv.className = 'message ai-message ai-message-bubble streaming';
            messageDiv.innerHTML = `
                <div class="message-content">
                    <div class="message-header">
                        <img src="/images/Notal_Banner_Logo.png" alt="Notal AI" class="ai-message-logo" />
                        <span class="timestamp">${new Date().toLocaleTimeString()}</span>
                    </div>
                    <div class="message-text"></div>
                </div>
            `;
            
            chatMessages.appendChild(messageDiv);
            return messageDiv;
        }

        // Generate AI response with streaming (dashboard version)
        async function generateDashboardAIResponse(userMessage) {
            try {
                const orgId = @ViewBag.OrganizationId;
                if (!orgId) {
                    console.error('Organization ID not found');
                    return;
                }
                
                // Keep "AI is thinking..." visible until first chunk arrives
                let aiMessageDiv = null;
                let messageTextDiv = null;
                let isFirstChunk = true;
                
                let fullContent = '';
                
                // Track if user has manually scrolled up
                let userHasScrolledUp = false;
                let lastScrollHeight = 0;
                
                const chatMessages = document.getElementById('dashboardChatMessages');
                
                // Detect manual scroll by user
                const handleScroll = () => {
                    if (!chatMessages) return;
                    
                    const isAtBottom = chatMessages.scrollHeight - chatMessages.scrollTop - chatMessages.clientHeight < 50;
                    
                    // If user scrolls back to bottom, re-enable auto-scroll
                    if (isAtBottom) {
                        userHasScrolledUp = false;
                    } 
                    // If scroll position changed and we're not at bottom, user scrolled up
                    else if (chatMessages.scrollHeight === lastScrollHeight) {
                        userHasScrolledUp = true;
                    }
                    
                    lastScrollHeight = chatMessages.scrollHeight;
                };
                
                // Add scroll listener
                if (chatMessages) {
                    chatMessages.addEventListener('scroll', handleScroll);
                }
                
                const response = await fetch(`/Client/${orgId}/Chat/GenerateAIResponseStream`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        conversationId: parseInt(dashboardCurrentConversationId),
                        userMessage: userMessage
                    })
                });
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                // Handle Server-Sent Events stream
                const reader = response.body.getReader();
                const decoder = new TextDecoder();
                let buffer = '';
                
                while (true) {
                    const { done, value } = await reader.read();
                    
                    if (done) {
                        break;
                    }
                    
                    // Decode the chunk and add to buffer
                    buffer += decoder.decode(value, { stream: true });
                    
                    // Process complete SSE messages (separated by \n\n)
                    const messages = buffer.split('\n\n');
                    buffer = messages.pop() || ''; // Keep incomplete message in buffer
                    
                    for (const message of messages) {
                        if (message.startsWith('data: ')) {
                            const jsonData = message.substring(6);
                            
                            try {
                                const eventData = JSON.parse(jsonData);
                                
                                // Add delay between chunks for smooth visual streaming (30ms per chunk)
                                await new Promise(resolve => setTimeout(resolve, 30));
                                
                                if (eventData.error) {
                                    // Error occurred
                                    hideDashboardAIThinkingIndicator();
                                    if (messageTextDiv) {
                                        messageTextDiv.innerHTML = eventData.content || 'An error occurred while generating the response.';
                                    }
                                    // Remove streaming class
                                    if (aiMessageDiv) {
                                        aiMessageDiv.classList.remove('streaming');
                                    }
                                    if (chatMessages) {
                                        chatMessages.removeEventListener('scroll', handleScroll);
                                    }
                                    return;
                                }
                                
                                if (eventData.done) {
                                    // Stream complete - remove streaming class
                                    hideDashboardAIThinkingIndicator();
                                    if (aiMessageDiv) {
                                        aiMessageDiv.classList.remove('streaming');
                                    }
                                    if (messageTextDiv) {
                                        // Use content directly as HTML (like sidebar does) - AI returns HTML-formatted content
                                        messageTextDiv.innerHTML = fullContent || 'No response generated.';
                                    }
                                    
                                    // Remove scroll listener
                                    if (chatMessages) {
                                        chatMessages.removeEventListener('scroll', handleScroll);
                                    }
                                    
                                    return;
                                }
                                
                                if (eventData.content) {
                                    // On first chunk: hide thinking indicator and create streaming placeholder
                                    if (isFirstChunk) {
                                        hideDashboardAIThinkingIndicator();
                                        aiMessageDiv = createDashboardStreamingAIMessagePlaceholder();
                                        messageTextDiv = aiMessageDiv.querySelector('.message-text');
                                        
                                        // Initialize empty message text
                                        messageTextDiv.textContent = '';
                                        
                                        isFirstChunk = false;
                                    }
                                    
                                    try {
                                        // Append chunk to full content
                                        fullContent += eventData.content;
                                        
                                        // During streaming: keep HTML structure, only remove incomplete tags (like sidebar)
                                        let displayText = fullContent
                                            .replace(/<[^>]*$/g, '')  // Remove incomplete tag at the end (e.g., "<p" or "<stro")
                                            .trim();
                                        
                                        // Update using innerHTML to preserve HTML formatting during streaming (like sidebar)
                                        const tempDiv = document.createElement('div');
                                        tempDiv.innerHTML = displayText;
                                        
                                        // Clear messageTextDiv and rebuild with formatted content
                                        messageTextDiv.innerHTML = '';
                                        while (tempDiv.firstChild) {
                                            messageTextDiv.appendChild(tempDiv.firstChild);
                                        }
                                        
                                        // Auto-scroll only if user hasn't manually scrolled up
                                        if (chatMessages && !userHasScrolledUp) {
                                            chatMessages.scrollTop = chatMessages.scrollHeight;
                                            lastScrollHeight = chatMessages.scrollHeight;
                                        }
                                    } catch (domError) {
                                        console.error('Error in DOM update:', domError);
                                    }
                                }
                            } catch (e) {
                                console.error('Error parsing SSE:', e);
                            }
                        }
                    }
                }
                
            } catch (error) {
                console.error('Error generating streaming AI response:', error);
                hideDashboardAIThinkingIndicator();
                
                // Show error message in chat
                const chatMessages = document.getElementById('dashboardChatMessages');
                if (chatMessages) {
                    const errorDiv = document.createElement('div');
                    errorDiv.className = 'ai-message-bubble error-message';
                    errorDiv.innerHTML = `
                        <div class="message-content">
                            <div class="message-header">
                                <img src="/images/Notal_Banner_Logo.png" alt="Notal AI" class="ai-message-logo" />
                                <span class="timestamp">${new Date().toLocaleTimeString()}</span>
                            </div>
                            <div class="message-text">
                                I apologize, but I'm having trouble generating a response right now. Please try again in a moment.
                            </div>
                        </div>
                    `;
                    chatMessages.appendChild(errorDiv);
                    chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'smooth' });
                }
            }
        }

        // Handle search input send (for landing view)
        document.addEventListener('DOMContentLoaded', function() {
            const searchSendBtn = document.getElementById('dashboardSendBtn');
            const searchInput = document.getElementById('dashboardSearchInput');
            
            if (searchSendBtn && searchInput) {
                searchSendBtn.addEventListener('click', async function() {
                    const message = searchInput.value.trim();
                    if (!message) return;
                    
                    // Check if we have a conversation selected
                    const savedConversationId = localStorage.getItem('dashboardSelectedConversation');
                    
                    if (savedConversationId) {
                        // Use existing conversation
                        dashboardCurrentConversationId = savedConversationId;
                        loadDashboardConversation(savedConversationId);
                        
                        // Wait a bit for view to switch, then send message
                        setTimeout(() => {
                            const dashboardInput = document.getElementById('dashboardMessageInput');
                            if (dashboardInput) {
                                dashboardInput.value = message;
                                document.getElementById('dashboardSendButton').click();
                            }
                        }, 100);
                    } else {
                        // Create new conversation (you may want to implement this)
                        console.log('Creating new conversation from search input');
                    }
                });
                
                searchInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        searchSendBtn.click();
                    }
                });
            }
        });

        async function loadDashboardUpcomingDeadlines() {
            const deadlinesList = document.getElementById('dashboardUpcomingDeadlinesList');
            if (!deadlinesList) return;
            
            try {
                const orgId = @ViewBag.OrganizationId;
                if (!orgId) {
                    deadlinesList.innerHTML = '<p class="text-muted small">Unable to load deadlines.</p>';
                    return;
                }
                
                // Fetch upcoming calendar events (deadlines)
                const endDate = new Date();
                endDate.setDate(endDate.getDate() + 30); // Next 30 days
                
                const response = await fetch(`/Client/${orgId}/Calendar/Events?start=${new Date().toISOString()}&end=${endDate.toISOString()}`, {
                    credentials: 'include'
                });
                
                if (!response.ok) {
                    throw new Error('Failed to fetch deadlines');
                }
                
                const result = await response.json();
                
                if (!result.success || !result.events || result.events.length === 0) {
                    deadlinesList.innerHTML = '<p class="text-muted small">No upcoming deadlines.</p>';
                    return;
                }
                
                // Filter and sort events as deadlines
                const deadlines = result.events
                    .filter(e => new Date(e.startDateTime) > new Date())
                    .sort((a, b) => new Date(a.startDateTime) - new Date(b.startDateTime))
                    .slice(0, 5); // Show top 5
                
                if (deadlines.length === 0) {
                    deadlinesList.innerHTML = '<p class="text-muted small">No upcoming deadlines.</p>';
                    return;
                }
                
                // Render deadlines
                deadlinesList.innerHTML = deadlines.map(deadline => {
                    const date = new Date(deadline.startDateTime);
                    const isToday = date.toDateString() === new Date().toDateString();
                    const daysDiff = Math.ceil((date - new Date()) / (1000 * 60 * 60 * 24));
                    const urgencyClass = daysDiff <= 1 ? 'border-danger' : daysDiff <= 3 ? 'border-warning' : 'border-primary';
                    
                    return `
                        <div class="deadline-item ${urgencyClass} border-start border-3 ps-2 mb-2">
                            <div class="d-flex justify-content-between align-items-start">
                                <div style="flex: 1; min-width: 0;">
                                    <div class="fw-semibold text-truncate" style="font-size: 0.85rem;">${deadline.title}</div>
                                    <div class="text-muted small">${date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}${isToday ? ' (Today)' : ''}</div>
                                </div>
                            </div>
                        </div>
                    `;
                }).join('');
                
            } catch (error) {
                console.error('Error loading deadlines:', error);
                deadlinesList.innerHTML = '<p class="text-muted small">Error loading deadlines.</p>';
            }
        }
    </script>
}
