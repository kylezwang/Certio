        function resetDashboardChatCard(keepActivated = false) {
            const aiCard = document.getElementById('aiChatCard');
            const closeBtn = document.getElementById('aiCloseBtn');
            const fullscreenBtn = document.getElementById('aiFullscreenBtn');
            const landingView = document.getElementById('dashboardLandingView');
            const conversationView = document.getElementById('dashboardConversationView');
            const conversationsList = document.getElementById('conversationsList');

            // Reset conversation state
            window.dashboardCurrentConversationId = null;
            localStorage.removeItem('dashboardSelectedConversation');

            // Remove active class from all conversation items
            if (conversationsList) {
                conversationsList.querySelectorAll('.conversation-item').forEach(item => {
                    item.classList.remove('active');
                });
            }

            // Hide conversation view, show landing view
            if (conversationView) conversationView.style.display = 'none';
            if (landingView) landingView.style.display = 'block';

            // Hide close button and adjust fullscreen button position
            if (closeBtn) closeBtn.style.display = 'none';
            if (fullscreenBtn) fullscreenBtn.classList.remove('has-close-btn');

            // Remove activated class only if not in fullscreen mode and not keeping activated
            if (aiCard && !aiCard.classList.contains('fullscreen') && !keepActivated) {
                aiCard.classList.remove('activated');
            }
        }

        // Load conversation messages for dashboard
        async function loadDashboardConversation(conversationId) {
            window.dashboardCurrentConversationId = conversationId;

            // Show close button and adjust fullscreen button position
            const closeBtn = document.getElementById('aiCloseBtn');
            const fullscreenBtn = document.getElementById('aiFullscreenBtn');
            if (closeBtn) closeBtn.style.display = 'block';
            if (fullscreenBtn) fullscreenBtn.classList.add('has-close-btn');

            // Show conversation view, hide landing view
            const landingView = document.getElementById('dashboardLandingView');
            const conversationView = document.getElementById('dashboardConversationView');

            if (landingView) landingView.style.display = 'none';
            if (conversationView) {
                conversationView.style.display = 'flex';
                // Ensure it takes full height
                conversationView.style.height = '100%';
            }

            // Show conversation header
            const notalHeader = document.getElementById('dashboardNotalHeader');
            if (notalHeader) notalHeader.style.display = 'block';

            // Load messages
            await loadDashboardConversationMessages(conversationId);

            // Initialize dashboard chat input handlers
            initializeDashboardChatInput();
        }

        // Load messages for a conversation
        async function loadDashboardConversationMessages(conversationId) {
            const chatMessages = document.getElementById('dashboardChatMessages');
            if (!chatMessages) return;

            try {
                const orgId = @ViewBag.OrganizationId;
                if (!orgId) {
                    console.error('Organization ID not found');
                    return;
                }

                const response = await fetch(`/Client/${orgId}/Chat/GetMessages/${conversationId}`);

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const messages = await response.json();

                // Clear existing messages (except header)
                const messagesToRemove = chatMessages.querySelectorAll('.ai-message-bubble:not(.notal-conversation-header .ai-message-bubble), .user-message-bubble');
                messagesToRemove.forEach(msg => msg.remove());

                // Display messages
                messages.forEach(message => {
                    addDashboardMessageToChat(message);
                });

                // Scroll to bottom
                chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'instant' });

            } catch (error) {
                console.error('Error loading messages:', error);
                chatMessages.innerHTML += '<div class="text-danger p-2">Failed to load messages</div>';
            }
        }

        // Add message to dashboard chat (with optional attachment indicator)
        function addDashboardMessageToChat(message, attachmentInfo = null) {
            const chatMessages = document.getElementById('dashboardChatMessages');
            if (!chatMessages) return;

            const messageDiv = document.createElement('div');
            const isAI = message.isFromAI || false;
            messageDiv.className = isAI ? 'ai-message-bubble' : 'user-message-bubble';

            const timestamp = new Date(message.createdAt || Date.now()).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });

            // Use content directly as HTML (like sidebar does) - AI returns HTML-formatted content.
            // Also: never show raw [ACTION:...] blocks in dashboard chat (match sidebar behavior).
            let formattedContent = message.content || '';
            if (isAI) {
                try {
                    if (typeof window.AgentActions !== 'undefined' && window.AgentActions.replaceWithCards) {
                        formattedContent = window.AgentActions.replaceWithCards(formattedContent);
                    } else {
                        formattedContent = formattedContent.replace(/\[ACTION:\w+\][\s\S]*?\[\/ACTION\]/g, '');
                    }
                    formattedContent = formattedContent.replace(/\[ACTION:[\s\S]*$/g, '').trim();
                } catch (e) {
                    // ignore
                }
            }

            // Parse attachment info from message metadata if not provided directly (check both camelCase and PascalCase)
            const metadataStr = message.metadata || message.Metadata;
            if (!attachmentInfo && metadataStr) {
                try {
                    const metadata = JSON.parse(metadataStr);
                    if (metadata.attachmentFileName && metadata.attachmentFileSize) {
                        attachmentInfo = {
                            fileName: metadata.attachmentFileName,
                            fileSize: metadata.attachmentFileSize
                        };
                    }
                } catch (e) {
                    // Ignore JSON parse errors
                }
            }

            // Build attachment HTML if present
            let attachmentHtml = '';
            if (attachmentInfo) {
                const fileSizeKb = (attachmentInfo.fileSize / 1024).toFixed(1);
                attachmentHtml = `
                    <div class="message-attachment" style="
                        display: flex;
                        align-items: center;
                        gap: 0.5rem;
                        padding: 0.5rem 0.75rem;
                        background: rgba(61, 16, 25, 0.05);
                        border-radius: 8px;
                        margin-bottom: 0.5rem;
                        border: 1px solid rgba(61, 16, 25, 0.1);
                    ">
                        <i class="fas fa-paperclip" style="color: #3d1019; font-size: 0.875rem;"></i>
                        <div style="flex: 1; min-width: 0; overflow: hidden;">
                            <div style="font-weight: 500; font-size: 0.875rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%;">${attachmentInfo.fileName}</div>
                            <div style="font-size: 0.75rem; color: #6b7280;">${fileSizeKb} KB</div>
                        </div>
                    </div>
                `;
            }

            if (isAI) {
                messageDiv.innerHTML = `
                    <div class="message-content">
                        <div class="message-header">
                            <img src="/images/Notal_Banner_Logo.png" alt="Notal AI" class="ai-message-logo" />
                            <span class="timestamp">${timestamp}</span>
                        </div>
                        <div class="message-text">${formattedContent}</div>
                    </div>
                `;
            } else {
                // For user messages, escape HTML for security
                formattedContent = formattedContent
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/\\n/g, '\n')
                    .replace(/\n/g, '<br>');

                messageDiv.innerHTML = `
                    <div class="message-content">
                        <div class="message-header">
                            <span class="timestamp">${timestamp}</span>
                        </div>
                        ${attachmentHtml}
                        <div class="message-text">${formattedContent}</div>
                    </div>
                `;
            }

            chatMessages.appendChild(messageDiv);
            chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'instant' });
        }

        // Initialize dashboard chat input handlers
        function initializeDashboardChatInput() {
            const messageInput = document.getElementById('dashboardMessageInput');
            const sendButton = document.getElementById('dashboardSendButton');

            if (!messageInput || !sendButton) return;

            // Check if already initialized to avoid duplicate listeners
            if (messageInput.dataset.initialized === 'true') return;
            messageInput.dataset.initialized = 'true';

            // Send message handler
            const sendMessage = async () => {
                const input = document.getElementById('dashboardMessageInput');
                const fileInput = document.getElementById('dashboardFileInput');
                const attachmentPreview = document.getElementById('dashboardAttachmentPreview');
                const attachFileBtn = document.getElementById('dashboardAttachFileBtn');
                const message = input.value.trim();

                // Check if there's a file attached
                const hasAttachment = fileInput && fileInput.files && fileInput.files.length > 0;

                if (!message && !hasAttachment) return;
                if (!window.dashboardCurrentConversationId) return;

                // Capture file and file info before clearing
                let capturedFile = null;
                let fileInfo = null;
                if (hasAttachment) {
                    capturedFile = fileInput.files[0];
                    fileInfo = {
                        name: capturedFile.name,
                        size: capturedFile.size
                    };
                }

                // Clear input
                input.value = '';
                updateDashboardCharCounter();

                // Clear attachment preview immediately
                if (attachmentPreview) {
                    attachmentPreview.style.display = 'none';
                }
                if (attachFileBtn) {
                    attachFileBtn.classList.remove('active');
                }

                // Clear the file input immediately
                if (fileInput) {
                    fileInput.value = '';
                }

                // Build attachment info for display
                const attachmentInfo = dashboardPendingAttachment ? {
                    fileName: dashboardPendingAttachment.fileName,
                    fileSize: dashboardPendingAttachment.fileSize
                } : (fileInfo ? { fileName: fileInfo.name, fileSize: fileInfo.size } : null);

                // Add user message immediately (with attachment indicator if present)
                addDashboardMessageToChat({
                    content: message || 'Please analyze this document.',
                    isFromAI: false,
                    createdAt: new Date().toISOString()
                }, attachmentInfo);

                // Show intelligent AI thinking indicator
                showDashboardAIThinkingIndicator(message || 'Analyzing attached document...');

                // If we have a file but haven't uploaded yet, upload it now
                if (capturedFile && !dashboardPendingAttachment) {
                    console.log('Processing attachment in background:', capturedFile.name);
                    const uploadedAttachment = await uploadDashboardAttachment(capturedFile);
                    if (uploadedAttachment) {
                        dashboardPendingAttachment = uploadedAttachment;
                    }
                }

                // Send to server
                try {
                    const orgId = @ViewBag.OrganizationId;

                    // Build request body with attachment metadata if present
                    let requestBody = `conversationId=${window.dashboardCurrentConversationId}&content=${encodeURIComponent(message || 'Please analyze this document.')}&messageType=Text`;

                    if (fileInfo) {
                        requestBody += `&attachmentFileName=${encodeURIComponent(fileInfo.name)}&attachmentFileSize=${fileInfo.size}`;
                    }

                    const response = await fetch(`/Client/${orgId}/Chat/SendMessage`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: requestBody
                    });

                    const data = await response.json();

                    if (data.success) {
                        // Generate streaming AI response (will include attachment content if dashboardPendingAttachment is set)
                        await generateDashboardAIResponse(message || 'Please analyze this document.');
                    } else {
                        console.error('Failed to send message:', data.error);
                        hideDashboardAIThinkingIndicator();
                    }
                } catch (error) {
                    console.error('Error sending message:', error);
                    hideDashboardAIThinkingIndicator();
                }
            };

            // Event listeners
            sendButton.addEventListener('click', sendMessage);
            messageInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    sendMessage();
                }
            });

            // Character counter
            messageInput.addEventListener('input', updateDashboardCharCounter);

            // Auto-resize textarea
            messageInput.addEventListener('input', function () {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 120) + 'px';
            });
        }

        // Update character counter
        function updateDashboardCharCounter() {
            const input = document.getElementById('dashboardMessageInput');
            const counter = document.getElementById('dashboardCharCounter');
            if (input && counter) {
                const length = input.value.length;
                counter.textContent = `${length} / 2000`;
            }
        }

        // Show intelligent AI thinking indicator (dashboard version)
        function showDashboardAIThinkingIndicator(userMessage) {
            const chatMessages = document.getElementById('dashboardChatMessages');
            if (!chatMessages) return;

            // Determine thinking message based on user input
            let thinkingMessage = "AI is thinking...";
            const messageLower = userMessage.toLowerCase();

            // Check if there's a pending attachment - show document analysis message
            if (dashboardPendingAttachment || messageLower.includes("analyze this document") ||
                messageLower.includes("pdf") || messageLower.includes("attachment")) {
                thinkingMessage = "Analyzing document content...";
            } else if (messageLower.includes("document review") || messageLower.includes("review")) {
                thinkingMessage = "Analyzing document requirements...";
            } else if (messageLower.includes("contract") || messageLower.includes("agreement")) {
                thinkingMessage = "Reviewing contract details...";
            } else if (messageLower.includes("hello") || messageLower.includes("hi")) {
                thinkingMessage = "Preparing personalized greeting...";
            } else if (messageLower.includes("help") || messageLower.includes("assistance")) {
                thinkingMessage = "Identifying best assistance approach...";
            } else if (messageLower.includes("event") || messageLower.includes("vendor")) {
                thinkingMessage = "Processing your event planning question...";
            } else if (messageLower.includes("question") || messageLower.includes("?")) {
                thinkingMessage = "Formulating detailed response...";
            }

            const thinkingDiv = document.createElement('div');
            thinkingDiv.id = 'dashboard-ai-thinking-indicator';
            thinkingDiv.className = 'message ai-message';
            thinkingDiv.innerHTML = `
                <div class="message-header">
                    <img src="/images/Notal_Banner_Logo.png" alt="Notal AI" class="ai-message-logo" />
                    <span class="timestamp">${new Date().toLocaleTimeString()}</span>
                </div>
                <div class="message-content">
                    <div class="ai-thinking">
                        <div class="thinking-spinner">
                            <div class="spinner-border spinner-border-sm" role="status">
                                <span class="sr-only">Loading...</span>
                            </div>
                        </div>
                        <span class="thinking-text" id="dashboardThinkingText">${thinkingMessage}</span>
                    </div>
                </div>
            `;

            chatMessages.appendChild(thinkingDiv);
            chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'instant' });

            // Apply wave animation to thinking text
            const thinkingTextElement = thinkingDiv.querySelector('#dashboardThinkingText');
            if (thinkingTextElement) {
                const text = thinkingTextElement.textContent;
                thinkingTextElement.innerHTML = text.split('').map((char, index) => {
                    const delay = index * 0.05; // 50ms delay between each character
                    return `<span style="animation-delay: ${delay}s;">${char === ' ' ? '&nbsp;' : char}</span>`;
                }).join('');
            }
        }

        // Hide AI thinking indicator (dashboard version)
        function hideDashboardAIThinkingIndicator() {
            const thinkingDiv = document.getElementById('dashboard-ai-thinking-indicator');
            if (thinkingDiv) {
                thinkingDiv.remove();
            }
        }

        // Create streaming AI message placeholder (dashboard version)
        function createDashboardStreamingAIMessagePlaceholder() {
            const chatMessages = document.getElementById('dashboardChatMessages');
            if (!chatMessages) return null;

            const messageDiv = document.createElement('div');
            messageDiv.className = 'message ai-message ai-message-bubble streaming';
            messageDiv.innerHTML = `
                <div class="message-content">
                    <div class="message-header">
                        <img src="/images/Notal_Banner_Logo.png" alt="Notal AI" class="ai-message-logo" />
                        <span class="timestamp">${new Date().toLocaleTimeString()}</span>
                    </div>
                    <div class="message-text"></div>
                </div>
            `;

            chatMessages.appendChild(messageDiv);
            return messageDiv;
        }

        // Generate AI response with streaming (dashboard version)
        async function generateDashboardAIResponse(userMessage) {
            try {
                const orgId = @ViewBag.OrganizationId;
                if (!orgId) {
                    console.error('Organization ID not found');
                    return;
                }

                // Keep "AI is thinking..." visible until first chunk arrives
                let aiMessageDiv = null;
                let messageTextDiv = null;
                let isFirstChunk = true;

                let fullContent = '';

                // Track if user has manually scrolled up
                let userHasScrolledUp = false;
                let lastScrollHeight = 0;

                const chatMessages = document.getElementById('dashboardChatMessages');

                // Detect manual scroll by user
                const handleScroll = () => {
                    if (!chatMessages) return;

                    const isAtBottom = chatMessages.scrollHeight - chatMessages.scrollTop - chatMessages.clientHeight < 50;

                    // If user scrolls back to bottom, re-enable auto-scroll
                    if (isAtBottom) {
                        userHasScrolledUp = false;
                    }
                    // If scroll position changed and we're not at bottom, user scrolled up
                    else if (chatMessages.scrollHeight === lastScrollHeight) {
                        userHasScrolledUp = true;
                    }

                    lastScrollHeight = chatMessages.scrollHeight;
                };

                // Add scroll listener
                if (chatMessages) {
                    chatMessages.addEventListener('scroll', handleScroll);
                }

                // Build request body with optional attachment content
                const requestBody = {
                    conversationId: parseInt(window.dashboardCurrentConversationId),
                    userMessage: userMessage
                };

                // Include AI mode and model if AgentActions is available
                if (typeof window.AgentActions !== 'undefined') {
                    requestBody.aiMode = window.AgentActions.getMode();
                    requestBody.aiModel = window.AgentActions.getModel();
                    console.log('[AgentActions] Dashboard sending with mode:', requestBody.aiMode, 'model:', requestBody.aiModel);
                }

                // Wait for attachment upload to complete if still uploading
                if (window._dashboardUploadingAttachment) {
                    console.log('Waiting for attachment upload to complete...');
                    while (window._dashboardUploadingAttachment) {
                        await new Promise(resolve => setTimeout(resolve, 100));
                    }
                }

                // Include attachment content if present
                if (dashboardPendingAttachment) {
                    requestBody.attachmentContent = dashboardPendingAttachment.extractedContent;
                    requestBody.attachmentFileName = dashboardPendingAttachment.fileName;
                    console.log(`Including attachment in dashboard AI request: ${dashboardPendingAttachment.fileName}`);
                    // Clear pending attachment after including it
                    dashboardPendingAttachment = null;
                }

                const response = await fetch(`/Client/${orgId}/Chat/GenerateAIResponseStream`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(requestBody)
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                // Handle Server-Sent Events stream
                const reader = response.body.getReader();
                const decoder = new TextDecoder();
                let buffer = '';

                while (true) {
                    const { done, value } = await reader.read();

                    if (done) {
                        break;
                    }

                    // Decode the chunk and add to buffer
                    buffer += decoder.decode(value, { stream: true });

                    // Process complete SSE messages (separated by \n\n)
                    const messages = buffer.split('\n\n');
                    buffer = messages.pop() || ''; // Keep incomplete message in buffer

                    for (const message of messages) {
                        if (message.startsWith('data: ')) {
                            const jsonData = message.substring(6);

                            try {
                                const eventData = JSON.parse(jsonData);

                                // Add delay between chunks for smooth visual streaming (30ms per chunk)
                                await new Promise(resolve => setTimeout(resolve, 30));

                                if (eventData.error) {
                                    // Error occurred
                                    hideDashboardAIThinkingIndicator();
                                    if (messageTextDiv) {
                                        messageTextDiv.innerHTML = eventData.content || 'An error occurred while generating the response.';
                                    }
                                    // Remove streaming class
                                    if (aiMessageDiv) {
                                        aiMessageDiv.classList.remove('streaming');
                                    }
                                    if (chatMessages) {
                                        chatMessages.removeEventListener('scroll', handleScroll);
                                    }
                                    return;
                                }

                                if (eventData.done) {
                                    // Stream complete - remove streaming class
                                    hideDashboardAIThinkingIndicator();
                                    if (aiMessageDiv) {
                                        aiMessageDiv.classList.remove('streaming');
                                    }
                                    if (messageTextDiv) {
                                        // Clean the content for display - replace action commands with nice action cards
                                        let displayContent = fullContent;
                                        if (typeof window.AgentActions !== 'undefined') {
                                            // Use replaceWithCards to show animated action cards
                                            if (window.AgentActions.replaceWithCards) {
                                                displayContent = window.AgentActions.replaceWithCards(fullContent);
                                            } else if (window.AgentActions.stripActionCommands) {
                                                // Fallback: strip if replaceWithCards not available
                                                displayContent = window.AgentActions.stripActionCommands(fullContent);
                                            }
                                        }
                                        // Use content directly as HTML - AI returns HTML-formatted content
                                        messageTextDiv.innerHTML = displayContent || 'No response generated.';
                                    }

                                    // Agent Actions: Check for action commands in AI response
                                    if (typeof window.AgentActions !== 'undefined') {
                                        try {
                                            const detectedActions = window.AgentActions.parseResponse(fullContent);
                                            if (detectedActions && detectedActions.length > 0) {
                                                console.log('[AgentActions] Detected actions in dashboard AI response:', detectedActions);
                                                window.AgentActions.processActions(detectedActions, window.dashboardCurrentConversationId);
                                            }
                                        } catch (agentError) {
                                            console.error('[AgentActions] Error processing dashboard actions:', agentError);
                                        }
                                    }

                                    // Remove scroll listener
                                    if (chatMessages) {
                                        chatMessages.removeEventListener('scroll', handleScroll);
                                    }

                                    return;
                                }

                                if (eventData.content) {
                                    // Safety net: skip suspected duplicate full-response chunk
                                    if (fullContent.length > 100 && eventData.content.length >= fullContent.length * 0.9) {
                                        console.warn('Dashboard: Skipping suspected duplicate full-response chunk');
                                        continue;
                                    }

                                    // On first chunk: hide thinking indicator and create streaming placeholder
                                    if (isFirstChunk) {
                                        hideDashboardAIThinkingIndicator();
                                        aiMessageDiv = createDashboardStreamingAIMessagePlaceholder();
                                        messageTextDiv = aiMessageDiv.querySelector('.message-text');

                                        // Initialize empty message text
                                        messageTextDiv.textContent = '';

                                        isFirstChunk = false;
                                    }

                                    try {
                                        // Append chunk to full content
                                        fullContent += eventData.content;

                                        // During streaming: keep HTML structure, only remove incomplete tags (like sidebar)
                                        let displayText = fullContent
                                            .replace(/<[^>]*$/g, '')  // Remove incomplete tag at the end (e.g., "<p" or "<stro")
                                            .trim();

                                        // Match sidebar streaming behavior: replace complete action blocks with action cards,
                                        // and hide any in-progress trailing action block (no raw [ACTION] text).
                                        if (typeof window.AgentActions !== 'undefined') {
                                            if (window.AgentActions.replaceWithCardsStreaming) {
                                                displayText = window.AgentActions.replaceWithCardsStreaming(displayText);
                                            } else if (window.AgentActions.replaceWithCards) {
                                                displayText = window.AgentActions.replaceWithCards(displayText);
                                                displayText = displayText.replace(/\[ACTION:[\s\S]*$/g, '').trim();
                                            } else if (window.AgentActions.stripActionCommands) {
                                                displayText = window.AgentActions.stripActionCommands(displayText);
                                                displayText = displayText.replace(/\[ACTION:[\s\S]*$/g, '').trim();
                                            }
                                        } else {
                                            displayText = displayText.replace(/\[ACTION:[\s\S]*$/g, '').trim();
                                        }

                                        // Update using innerHTML to preserve HTML formatting during streaming (like sidebar)
                                        const tempDiv = document.createElement('div');
                                        tempDiv.innerHTML = displayText;

                                        // Clear messageTextDiv and rebuild with formatted content
                                        messageTextDiv.innerHTML = '';
                                        while (tempDiv.firstChild) {
                                            messageTextDiv.appendChild(tempDiv.firstChild);
                                        }

                                        // Auto-scroll only if user hasn't manually scrolled up
                                        if (chatMessages && !userHasScrolledUp) {
                                            chatMessages.scrollTop = chatMessages.scrollHeight;
                                            lastScrollHeight = chatMessages.scrollHeight;
                                        }
                                    } catch (domError) {
                                        console.error('Error in DOM update:', domError);
                                    }
                                }
                            } catch (e) {
                                console.error('Error parsing SSE:', e);
                            }
                        }
                    }
                }

            } catch (error) {
                console.error('Error generating streaming AI response:', error);
                hideDashboardAIThinkingIndicator();

                // Show error message in chat
                const chatMessages = document.getElementById('dashboardChatMessages');
                if (chatMessages) {
                    const errorDiv = document.createElement('div');
                    errorDiv.className = 'ai-message-bubble error-message';
                    errorDiv.innerHTML = `
                        <div class="message-content">
                            <div class="message-header">
                                <img src="/images/Notal_Banner_Logo.png" alt="Notal AI" class="ai-message-logo" />
                                <span class="timestamp">${new Date().toLocaleTimeString()}</span>
                            </div>
                            <div class="message-text">
                                I apologize, but I'm having trouble generating a response right now. Please try again in a moment.
                            </div>
                        </div>
                    `;
                    chatMessages.appendChild(errorDiv);
                    chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'smooth' });
                }
            }
        }

        // Handle search input send (for landing view)
        document.addEventListener('DOMContentLoaded', function () {
            const searchSendBtn = document.getElementById('dashboardSendBtn');
            const searchInput = document.getElementById('dashboardSearchInput');

            if (searchSendBtn && searchInput) {
                searchSendBtn.addEventListener('click', async function () {
                    const message = searchInput.value.trim();
                    const fileInput = document.getElementById('dashboardFileInput');
                    const hasAttachment = fileInput && fileInput.files && fileInput.files.length > 0;

                    if (!message && !hasAttachment) return;

                    // Check if we have a conversation selected
                    const savedConversationId = localStorage.getItem('dashboardSelectedConversation');

                    // Use default message if only attachment is present
                    const effectiveMessage = message || (hasAttachment ? 'Please analyze this document.' : '');

                    // Clear the search input
                    searchInput.value = '';

                    // Clear the landing attachment preview
                    const landingAttachmentPreview = document.getElementById('landingAttachmentPreview');
                    if (landingAttachmentPreview) {
                        landingAttachmentPreview.style.display = 'none';
                    }

                    if (savedConversationId) {
                        // Use existing conversation
                        window.dashboardCurrentConversationId = savedConversationId;
                        loadDashboardConversation(savedConversationId);

                        // Wait a bit for view to switch, then send message
                        setTimeout(() => {
                            const dashboardInput = document.getElementById('dashboardMessageInput');
                            if (dashboardInput) {
                                dashboardInput.value = effectiveMessage;
                                document.getElementById('dashboardSendButton').click();
                            }
                        }, 100);
                    } else {
                        // Create new conversation
                        try {
                            const orgId = @ViewBag.OrganizationId;
                            const conversationTitle = hasAttachment ? 'Document Analysis' : 'New Chat';
                            const response = await fetch(`/Client/${orgId}/Chat/CreateConversation`, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/x-www-form-urlencoded',
                                },
                                body: `title=${encodeURIComponent(conversationTitle)}&description=${encodeURIComponent(effectiveMessage)}`
                            });

                            const data = await response.json();

                            if (data.success && data.conversationId) {
                                // Set as current conversation
                                window.dashboardCurrentConversationId = data.conversationId;
                                localStorage.setItem('dashboardSelectedConversation', data.conversationId);

                                // Load the conversation and send the message
                                await loadDashboardConversation(data.conversationId);

                                // Wait for view to switch, then send message
                                setTimeout(() => {
                                    const dashboardInput = document.getElementById('dashboardMessageInput');
                                    if (dashboardInput) {
                                        dashboardInput.value = effectiveMessage;
                                        document.getElementById('dashboardSendButton').click();
                                    }
                                }, 200);

                                // Reload conversations list
                                loadDashboardConversations();
                            } else {
                                console.error('Failed to create conversation:', data.error);
                            }
                        } catch (error) {
                            console.error('Error creating conversation:', error);
                        }
                    }
                });

                searchInput.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        searchSendBtn.click();
                    }
                });
            }
        });
    </script>
}

