        // Parse suggestions content and create truncated summary view
        function createSuggestionsSummary(fullContent, maxItems = 3) {
            // Create a temporary DOM element to parse HTML
            const tempDiv = document.createElement('div');
            tempDiv.innerHTML = fullContent;
            
            let items = [];
            
            // Try to find list items first (most common format)
            const listItems = tempDiv.querySelectorAll('li');
            if (listItems.length > 0) {
                listItems.forEach(item => {
                    const itemText = item.textContent.trim();
                    if (itemText && itemText.length > 0 && !itemText.match(/^(here are|suggestions?|based on)/i)) {
                        items.push(item.outerHTML);
                    }
                });
            }
            
            // If no list items, try paragraphs
            if (items.length === 0) {
                const paragraphs = tempDiv.querySelectorAll('p');
                paragraphs.forEach(p => {
                    const itemText = p.textContent.trim();
                    if (itemText && itemText.length > 0 && !itemText.match(/^(here are|suggestions?|based on)/i)) {
                        items.push(p.outerHTML);
                    }
                });
            }
            
            // If still no items, try splitting by line breaks
            if (items.length === 0) {
                const text = tempDiv.textContent || tempDiv.innerText || '';
                const lines = text.split(/\n+/).filter(line => {
                    const trimmed = line.trim();
                    return trimmed.length > 0 && 
                           !trimmed.match(/^(here are|suggestions?|based on|today)/i) &&
                           trimmed.length > 10; // Only substantial lines
                });
                lines.forEach(line => {
                    items.push(`<p>${line.trim()}</p>`);
                });
            }
            
            // Filter out empty or very short items
            items = items.filter(item => {
                const temp = document.createElement('div');
                temp.innerHTML = item;
                const text = temp.textContent.trim();
                return text.length > 10;
            });
            
            // Limit to maxItems
            const visibleItems = items.slice(0, maxItems);
            const remainingCount = items.length - maxItems;
            
            let summaryHTML = visibleItems.join('');
            
            // Add "+X more suggestions" link if there are more items
            if (remainingCount > 0) {
                summaryHTML += `<div class="suggestions-more-link-container"><a href="#" class="suggestions-more-link text-primary text-decoration-none">+${remainingCount} more suggestion${remainingCount !== 1 ? 's' : ''}</a></div>`;
            }
            
            return summaryHTML || fullContent; // Fallback to full content if parsing fails
        }

