@model Certio.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_ClientLayout";
}

<div class="global-dashboard-main">
    <div class="row h-100">
        <!-- Full Width Content -->
        <div class="col-12 main-column">
    <!-- AI Chat Section -->
    <div class="card mb-4 mt-3 border-0 ai-chat-card gd-card" id="aiChatCard">
        <div class="card-body p-0 ai-chat-card-body">
            <button class="btn btn-link text-muted p-0 ai-fullscreen-btn" id="aiFullscreenBtn" title="Toggle fullscreen">
                <i class="fas fa-expand"></i>
            </button>
            <div class="row g-0 h-100">
                <!-- Conversations Column -->
                <div class="col-md-3 conversations-column" id="conversationsColumn">
                    <div class="conversations-list" id="conversationsList">
                        <div class="conversations-loading">Loading conversations...</div>
                    </div>
                </div>
                <!-- Main Chat Content -->
                <div class="col-12 ai-chat-main-content" id="aiChatMainContent">
                    <div class="p-4">
            <div class="text-center mb-3">
                <img src="~/images/Notal_Banner_Logo_Large_Text.png" alt="Notal AI" style="height: 45px; object-fit: contain;" />
            </div>
            <h2 class="text-center mb-4 fs-2 fw-semibold text-dark">What can I help with?</h2>
            
                        <div class="search-container-large" id="searchContainer">
                <i class="fas fa-plus"></i>
                <input type="text" class="form-control form-control-lg" placeholder="Ask anything" />
                <div class="search-actions">
                    <button class="btn btn-link text-muted">
                        <i class="fas fa-microphone"></i>
                    </button>
                    <button class="btn btn-link text-muted">
                        <i class="fas fa-paper-plane"></i>
                    </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Access Section -->
    <div class="card mb-4 border-0 gd-card">
        <div class="card-body p-4">
            <h5 class="card-title fw-bold mb-3">Quick Access</h5>
            
            <div class="row gx-4 gy-3">
                @if (Model.OrganizationType == Certio.Domain.Organizations.OrganizationType.LawFirm)
                {
                    <div class="col-md-3">
                        <a href="#" class="quick-access-item qa-card" data-action="open-global-clients">
                            <div class="d-flex flex-column align-items-center text-center p-3">
                                <div class="quick-access-icon mb-2">
                                    <i class="fas fa-users text-purple"></i>
                                </div>
                                <span class="fw-medium">Clients</span>
                            </div>
                        </a>
                    </div>
                }
                else
                {
                    <div class="col-md-3">
                        <a href="/Client/@ViewBag.OrganizationId/Teams" class="quick-access-item qa-card">
                            <div class="d-flex flex-column align-items-center text-center p-3">
                                <div class="quick-access-icon mb-2">
                                    <i class="fa-solid fa-user-group text-purple"></i>
                                </div>
                                <span class="fw-medium">Teams</span>
                            </div>
                        </a>
                    </div>
                }
                <div class="col-md-3">
                    <a href="/Client/@ViewBag.OrganizationId/Calendar" class="quick-access-item qa-card">
                        <div class="d-flex flex-column align-items-center text-center p-3">
                            <div class="quick-access-icon mb-2">
                                <i class="far fa-calendar text-success"></i>
                            </div>
                            <span class="fw-medium">Calendar</span>
                        </div>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/Client/@ViewBag.OrganizationId/Billing" class="quick-access-item qa-card">
                        <div class="d-flex flex-column align-items-center text-center p-3">
                            <div class="quick-access-icon mb-2">
                                <i class="fa-regular fa-credit-card text-warning"></i>
                            </div>
                            <span class="fw-medium">Billing</span>
                        </div>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/Client/@ViewBag.OrganizationId/History" class="quick-access-item qa-card">
                        <div class="d-flex flex-column align-items-center text-center p-3">
                            <div class="quick-access-icon mb-2">
                                <i class="fas fa-clock text-info"></i>
                            </div>
                            <span class="fw-medium">History</span>
                        </div>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/Client/@ViewBag.OrganizationId/Matter" class="quick-access-item qa-card">
                        <div class="d-flex flex-column align-items-center text-center p-3">
                            <div class="quick-access-icon mb-2">
                                <i class="fas fa-briefcase" style="color: #0b365e;"></i>
                            </div>
                            <span class="fw-medium">Matters</span>
                        </div>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/Client/@ViewBag.OrganizationId/Tasks" class="quick-access-item qa-card">
                        <div class="d-flex flex-column align-items-center text-center p-3">
                            <div class="quick-access-icon mb-2">
                                <i class="fa-solid fa-bars-progress" style="color: #9bc0ec;"></i>
                            </div>
                            <span class="fw-medium">Tasks</span>
                        </div>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/Client/@ViewBag.OrganizationId/Communications" class="quick-access-item qa-card">
                        <div class="d-flex flex-column align-items-center text-center p-3">
                            <div class="quick-access-icon mb-2">
                                <i class="far fa-comments text-danger"></i>
                            </div>
                            <span class="fw-medium">Communications</span>
                        </div>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/Client/@ViewBag.OrganizationId/Documents" class="quick-access-item qa-card">
                        <div class="d-flex flex-column align-items-center text-center p-3">
                            <div class="quick-access-icon mb-2">
                                <i class="far fa-file-alt text-primary"></i>
                            </div>
                            <span class="fw-medium">Documents</span>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Row: Upcoming Deadlines, Daily Briefing, Next Suggestions -->
    <div class="row gx-4">
        <!-- Upcoming Deadlines -->
        <div class="col-md-4 mb-4">
            <div class="card border-0 h-100 gd-card">
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold mb-3"><i class="fa-solid fa-calendar-day me-2 text-muted" style="font-size: 0.75em;"></i>Upcoming Deadlines</h5>
                    
                    <div id="dashboardUpcomingDeadlinesList">
                        <p class="text-muted small mb-2">Loading deadlines...</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Daily Briefing -->
        <div class="col-md-4 mb-4">
            <div class="card border-0 h-100 daily-briefing-card gd-card">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-chart-pie text-muted me-2" style="font-size: 0.9em;"></i>
                        <h5 class="card-title fw-bold mb-0">Daily Briefing</h5>
                    </div>
                    
                    <div class="briefing-item mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-semibold">Today</span>
                        </div>
                        <span class="text-primary fw-bold">@Model.FilingsDueToday filings due</span>
                        <div class="text-muted small">@Model.FilingsDueDescription</div>
                    </div>
                    
                    <div class="briefing-item mb-3">
                        <div class="text-primary fw-bold">@Model.ClientCallsToday client call</div>
                        <div class="text-muted small">@Model.ClientCallsDescription</div>
                    </div>
                    
                    <div class="briefing-item">
                        <div class="text-primary fw-bold">@Model.OverdueInvoices overdue invoice</div>
                        <div class="text-muted small">@Model.OverdueInvoicesDescription</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Next Suggestions -->
        <div class="col-md-4 mb-4">
            <div class="card border-0 h-100 gd-card">
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold mb-3"><img src="~/images/Notal_Banner_Logo_Large_Text.png" alt="Notal AI" style="height: 1.25rem; object-fit: contain; display: inline-block; margin-right: 0.25rem; margin-bottom: 0.2rem;" />Suggestions</h5>
                    
                    @if (Model.NextSuggestions.Any())
                    {
                        @foreach (var suggestion in Model.NextSuggestions.Take(3))
                        {
                            <div class="suggestion-item mb-3">
                                <div class="fw-semibold">@suggestion.Title</div>
                                <div class="text-muted small">@suggestion.Description</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="suggestion-item mb-3">
                            <div class="fw-semibold">Matter Z inactive 12 days</div>
                            <div class="text-muted small">→ follow up</div>
                        </div>
                        
                        <div class="suggestion-item mb-3">
                            <div class="fw-semibold">3 overdue invoices</div>
                            <div class="text-muted small">→ send reminders</div>
                        </div>
                        
                        <div class="suggestion-item">
                            <div class="fw-semibold">Paralegal C overloaded</div>
                            <div class="text-muted small">→ consider reassigning</div>
                        </div>
                    }
                </div>
            </div>
        </div>
        </div>
    </div>
</div>

<style>
    .global-dashboard-main {
        padding: 0 0.75rem;
        max-width: 1400px; /* Constrain max width */
        margin: 0 auto; /* Center the dashboard content */
    }

    /* Force 4x2 grid layout for quick access */
    .global-dashboard-main .row > [class^="col-"] {
    }
    .global-dashboard-main .row .col-md-3 .quick-access-item {
        width: 100%;
    }

    .card {
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.25);
    }

    .ai-chat-card {
        position: relative;
        transition: all 0.3s ease;
    }

    .ai-chat-card.activated {
        min-height: calc(100vh - 300px);
    }

    .ai-chat-card-body {
        padding: 1rem 0; /* Minimal padding for default state */
        transition: all 0.3s ease-in-out;
        position: relative; /* For absolute positioning of conversations column */
    }

    /* Expand height when activated to fill remaining space */
    .ai-chat-card.activated .ai-chat-card-body {
        height: calc(100vh - 300px); /* Fill remaining viewport height */
        min-height: calc(100vh - 300px);
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .ai-chat-card.activated .ai-chat-card-body .row {
        flex: 1;
        min-height: 0;
        height: 100%;
        display: flex;
        align-items: stretch;
    }

    .ai-chat-card.fullscreen .ai-chat-card-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .ai-chat-card.fullscreen .ai-chat-card-body .row {
        flex: 1;
        min-height: 0;
        height: 100%;
        display: flex;
        align-items: stretch;
    }

    .ai-fullscreen-btn {
        position: absolute;
        top: 1rem;
        right: 1rem;
        font-size: 1.25rem;
        color: #6c757d !important;
        background: none;
        border: none;
        cursor: pointer;
        z-index: 10;
        transition: color 0.2s ease;
    }

    .ai-fullscreen-btn:hover {
        color: #495057 !important;
    }

    .ai-chat-card.fullscreen {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        width: 100% !important;
        height: 100% !important;
        max-width: none !important;
        margin: 0 !important;
        z-index: 1000 !important;
        border-radius: 12px !important;
        display: flex !important;
        flex-direction: column !important;
    }

    .ai-chat-card.fullscreen .card-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .ai-chat-card.fullscreen .conversations-column {
        max-height: 100%;
    }


    /* Conversations Column - Hidden by default */
    .conversations-column {
        background-color: transparent; /* Remove background - scrollbar will show through */
        border-right: none;
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 0;
        min-width: 0;
        padding: 0;
        margin: 0;
        visibility: hidden;
        opacity: 0;
        transform: translateX(-100%);
        transition: width 0.3s ease-in-out, transform 0.3s ease-in-out, opacity 0.3s ease-in-out, visibility 0.3s ease-in-out;
        overflow: hidden;
        z-index: 1;
        flex: none !important;
        max-width: none !important;
    }

    .ai-chat-card.activated .conversations-column,
    .ai-chat-card.fullscreen .conversations-column {
        border-right: 1px solid #ddd;
    }

    /* Show conversations column when activated */
    .ai-chat-card.activated .conversations-column {
        width: 25%;
        visibility: visible;
        opacity: 1;
        transform: translateX(0);
        overflow-y: auto;
    }

    .ai-chat-card.activated .conversations-column .conversations-list {
        padding: 1rem;
    }

    /* Always show in fullscreen mode */
    .ai-chat-card.fullscreen .conversations-column {
        width: 25% !important;
        visibility: visible !important;
        opacity: 1 !important;
        transform: translateX(0) !important;
        overflow-y: auto !important;
    }

    .ai-chat-card.fullscreen .conversations-column .conversations-list {
        padding: 1rem !important;
    }

    /* Adjust main content when activated - use margin instead of flex to prevent shift */
    .ai-chat-main-content {
        transition: margin-left 0.3s ease-in-out;
        margin-left: 0;
        position: relative;
        z-index: 0;
    }

    /* Center content vertically and horizontally when activated */
    .ai-chat-card.activated .ai-chat-main-content {
        margin-left: 25%;
        height: 100%;
        min-height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 1;
        align-self: stretch;
    }

    .ai-chat-card.activated .ai-chat-main-content > div {
        width: 100%;
    }

    .ai-chat-card.fullscreen .ai-chat-main-content {
        margin-left: 25% !important;
        height: 100% !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        flex: 1 !important;
    }

    .ai-chat-card.fullscreen .ai-chat-main-content > div {
        width: 100% !important;
    }

    .conversations-column::-webkit-scrollbar {
        width: 6px;
    }

    .conversations-column::-webkit-scrollbar-track {
        background: transparent; /* Remove track background */
    }

    .conversations-column::-webkit-scrollbar-thumb {
        background: #ececec; /* Use the lighter gray color for the scrollbar */
        border-radius: 3px;
        border: 1px solid rgba(0, 0, 0, 0.05); /* Very subtle border for definition */
    }

    .conversations-column::-webkit-scrollbar-thumb:hover {
        background: #d5d5d5; /* Slightly darker on hover for feedback */
    }

    /* Firefox scrollbar styling */
    .conversations-column {
        scrollbar-width: thin;
        scrollbar-color: #ececec transparent;
    }

    .conversations-list {
        padding: 1rem;
    }

    .conversations-loading {
        text-align: center;
        color: #6c757d;
        font-size: 0.875rem;
        padding: 1rem;
    }

    .conversation-item {
        padding: 0.75rem;
        margin-bottom: 0.5rem;
        background-color: rgba(255, 255, 255, 0.7);
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        border: 1px solid transparent;
    }

    .conversation-item:hover {
        background-color: rgba(255, 255, 255, 0.9);
        border-color: rgba(61, 16, 25, 0.2);
    }

    .conversation-item.active {
        background-color: #3d1019;
        color: white;
        border-color: #3d1019;
    }

    .conversation-item .conversation-title {
        font-size: 0.875rem;
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        margin: 0;
    }

    .conversation-item.active .conversation-title {
        color: white;
    }

    .ai-chat-main-content {
        display: flex;
        flex-direction: column;
    }

    .search-container-large {
        position: relative;
        max-width: 600px;
        width: 100%;
        margin: 0 auto;
    }

    .search-container-large input {
        padding: 0.75rem 3rem 0.75rem 3rem;
        border: 1px solid #e5e7eb;
        border-radius: 24px;
        background-color: #f9fafb;
        font-size: 1rem;
    }

    /* Match placeholder to Matters subtitle (lead text) */
    .search-container-large input::placeholder {
        font-size: 1.1rem;
        font-weight: 300;
        color: #6c757d;
    }

    .search-container-large i.fa-plus {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        color: #6b7280;
    }

    .search-actions {
        position: absolute;
        right: 0.5rem;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        gap: 0.25rem;
    }

    .search-actions .btn {
        padding: 0.25rem 0.5rem;
        border: none;
    }

    .quick-access-item {
        display: block;
        text-decoration: none;
        color: inherit;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    /* Add shadow and spacing on the card itself so gutters show between tiles */
    .qa-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.25);
        display: block;
        transition: transform 0.2s ease, background-color 0.2s ease;
    }

    /* Single hover effect for qa-card buttons */
    .qa-card:hover {
        background-color: #eef1f3;
        color: inherit;
        text-decoration: none;
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.2) !important;
    }

    .quick-access-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .text-purple {
        color: #8b5cf6 !important;
    }

    /* Match Matters card styling */
    .gd-card {
        transition: all 0.3s ease;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.25);
    }

    .gd-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 1px 12px rgba(0, 0, 0, 0.2) !important;
    }

    /* Firm Summary styles */
    .firm-stat {
        padding: 0.5rem 0;
    }

    /* Daily Briefing styles */
    .daily-briefing-card .card-body {
        background: white;
        border-radius: 12px;
    }

    .briefing-item {
        padding: 0.5rem 0;
    }

    /* Suggestion styles */
    .suggestion-item {
        padding: 0.5rem 0;
        border-bottom: 1px solid #f3f4f6;
    }

    .suggestion-item:last-child {
        border-bottom: none;
    }

    /* Main column styling */
    .main-column {
        padding: 0 0.75rem;
    }

    /* Override main content padding for Client Dashboard only */
    .main-content.client-main-content {
        padding: 0 !important;
    }

</style>

@section Scripts {
    @if (Model.OrganizationType == Certio.Domain.Organizations.OrganizationType.LawFirm)
    {
        <script>
            // For LawFirm organizations, trigger the clients popup from _Layout.cshtml
            document.addEventListener('DOMContentLoaded', function () {
                document.querySelectorAll('[data-action="open-global-clients"]').forEach(function (el) {
                    el.addEventListener('click', function (e) {
                        e.preventDefault();
                        e.stopPropagation(); // prevent the global outside-click handler from immediately closing it
                        const btn = document.getElementById('clientsButton');
                        if (!btn) return;
                        // Trigger the same handler without bubbling to document
                        btn.dispatchEvent(new MouseEvent('click', { bubbles: false }));
                    });
                });
            });
        </script>
    }
    
    <script>
        // Load upcoming deadlines for dashboard
        document.addEventListener('DOMContentLoaded', async function () {
            await loadDashboardUpcomingDeadlines();
            initializeAiFullscreen();
            initializeAiChatActivation();
            await loadDashboardConversations();
        });

        function initializeAiChatActivation() {
            const aiCard = document.getElementById('aiChatCard');
            const searchContainer = document.getElementById('searchContainer');
            
            if (!aiCard || !searchContainer) return;

            // Handle click on search container to activate
            searchContainer.addEventListener('click', function(e) {
                // Don't activate if clicking on action buttons
                if (e.target.closest('.search-actions') || e.target.closest('.btn')) {
                    return;
                }
                
                // Focus the input if clicking on container
                const input = searchContainer.querySelector('input');
                if (input && e.target === searchContainer) {
                    input.focus();
                }
                
                // Activate if not already activated (unless fullscreen)
                if (!aiCard.classList.contains('activated') && !aiCard.classList.contains('fullscreen')) {
                    aiCard.classList.add('activated');
                }
            });

            // Handle input focus to activate
            const input = searchContainer.querySelector('input');
            if (input) {
                input.addEventListener('focus', function() {
                    if (!aiCard.classList.contains('activated') && !aiCard.classList.contains('fullscreen')) {
                        aiCard.classList.add('activated');
                    }
                });
            }
        }

        async function loadDashboardConversations() {
            const conversationsList = document.getElementById('conversationsList');
            if (!conversationsList) return;

            try {
                const orgId = @ViewBag.OrganizationId;
                if (!orgId) {
                    conversationsList.innerHTML = '<div class="conversations-loading">No organization selected</div>';
                    return;
                }

                const response = await fetch(`/Client/${orgId}/Chat/GetAIConversations`, {
                    credentials: 'include'
                });

                if (!response.ok) {
                    conversationsList.innerHTML = '<div class="conversations-loading">No AI conversations yet</div>';
                    return;
                }

                const conversations = await response.json();

                if (!conversations || conversations.length === 0) {
                    conversationsList.innerHTML = '<div class="conversations-loading">No AI conversations yet</div>';
                    return;
                }

                // Render conversations vertically
                conversationsList.innerHTML = conversations.map(conversation => {
                    return `
                        <div class="conversation-item" data-conversation-id="${conversation.id}">
                            <div class="conversation-title">${conversation.title || 'Untitled Conversation'}</div>
                        </div>
                    `;
                }).join('');

                // Add click handlers - scoped to dashboard conversations only
                conversationsList.querySelectorAll('.conversation-item').forEach(item => {
                    item.addEventListener('click', function(e) {
                        e.stopPropagation(); // Prevent event from bubbling to sidebar handlers
                        
                        // Scope selection to dashboard conversations list only
                        const dashboardConversationsList = document.getElementById('conversationsList');
                        if (!dashboardConversationsList) return;
                        
                        // Remove active class from all dashboard items only
                        dashboardConversationsList.querySelectorAll('.conversation-item').forEach(i => {
                            i.classList.remove('active');
                        });
                        
                        // Add active class to clicked item
                        this.classList.add('active');
                        
                        // Save to localStorage with dashboard-specific key
                        const conversationId = this.dataset.conversationId;
                        localStorage.setItem('dashboardSelectedConversation', conversationId);
                        
                        // Activate the card if not already activated
                        const aiCard = document.getElementById('aiChatCard');
                        if (aiCard && !aiCard.classList.contains('fullscreen')) {
                            aiCard.classList.add('activated');
                        }
                        
                        // You can add navigation logic here if needed
                        // e.g., window.location.href = `/Client/${orgId}/Chat/Conversation/${conversationId}`;
                    });
                });

                // Restore previously selected conversation - scoped to dashboard only
                const savedConversationId = localStorage.getItem('dashboardSelectedConversation');
                if (savedConversationId) {
                    // Only look within the dashboard conversations list
                    const savedItem = conversationsList.querySelector(`.conversation-item[data-conversation-id="${savedConversationId}"]`);
                    if (savedItem) {
                        // Remove active class from all dashboard items only
                        conversationsList.querySelectorAll('.conversation-item').forEach(i => {
                            i.classList.remove('active');
                        });
                        
                        // Add active class to saved item
                        savedItem.classList.add('active');
                        
                        // Activate the card
                        const aiCard = document.getElementById('aiChatCard');
                        if (aiCard && !aiCard.classList.contains('fullscreen')) {
                            aiCard.classList.add('activated');
                        }
                    }
                }

            } catch (error) {
                console.error('Error loading conversations:', error);
                conversationsList.innerHTML = '<div class="conversations-loading">Failed to load conversations</div>';
            }
        }

        function initializeAiFullscreen() {
            const aiCard = document.getElementById('aiChatCard');
            const fullscreenBtn = document.getElementById('aiFullscreenBtn');
            const mainContent = document.querySelector('.main-content.client-main-content');
            
            if (!aiCard || !fullscreenBtn) return;

            function toggleFullscreen(isFullscreen) {
                if (isFullscreen) {
                    aiCard.classList.add('fullscreen', 'activated'); // Always activate conversations in fullscreen
                    if (mainContent) {
                        mainContent.style.position = 'relative';
                        mainContent.style.overflow = 'hidden';
                    }
                    const icon = fullscreenBtn.querySelector('i');
                    icon.classList.remove('fa-expand');
                    icon.classList.add('fa-compress');
                } else {
                    aiCard.classList.remove('fullscreen');
                    // Keep activated state if it was activated before fullscreen
                    if (mainContent) {
                        mainContent.style.position = '';
                        mainContent.style.overflow = '';
                    }
                    const icon = fullscreenBtn.querySelector('i');
                    icon.classList.remove('fa-compress');
                    icon.classList.add('fa-expand');
                }
            }

            fullscreenBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                const isFullscreen = aiCard.classList.contains('fullscreen');
                toggleFullscreen(!isFullscreen);
            });

            // Allow ESC key to exit fullscreen
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && aiCard.classList.contains('fullscreen')) {
                    toggleFullscreen(false);
                }
            });
        }

        async function loadDashboardUpcomingDeadlines() {
            const deadlinesList = document.getElementById('dashboardUpcomingDeadlinesList');
            if (!deadlinesList) return;
            
            try {
                const orgId = @ViewBag.OrganizationId;
                if (!orgId) {
                    deadlinesList.innerHTML = '<p class="text-muted small">Unable to load deadlines.</p>';
                    return;
                }
                
                // Fetch upcoming calendar events (deadlines)
                const endDate = new Date();
                endDate.setDate(endDate.getDate() + 30); // Next 30 days
                
                const response = await fetch(`/Client/${orgId}/Calendar/Events?start=${new Date().toISOString()}&end=${endDate.toISOString()}`, {
                    credentials: 'include'
                });
                
                if (!response.ok) {
                    throw new Error('Failed to fetch deadlines');
                }
                
                const result = await response.json();
                
                if (!result.success || !result.events || result.events.length === 0) {
                    deadlinesList.innerHTML = '<p class="text-muted small">No upcoming deadlines.</p>';
                    return;
                }
                
                // Filter and sort events as deadlines
                const deadlines = result.events
                    .filter(e => new Date(e.startDateTime) > new Date())
                    .sort((a, b) => new Date(a.startDateTime) - new Date(b.startDateTime))
                    .slice(0, 5); // Show top 5
                
                if (deadlines.length === 0) {
                    deadlinesList.innerHTML = '<p class="text-muted small">No upcoming deadlines.</p>';
                    return;
                }
                
                // Render deadlines
                deadlinesList.innerHTML = deadlines.map(deadline => {
                    const date = new Date(deadline.startDateTime);
                    const isToday = date.toDateString() === new Date().toDateString();
                    const daysDiff = Math.ceil((date - new Date()) / (1000 * 60 * 60 * 24));
                    const urgencyClass = daysDiff <= 1 ? 'border-danger' : daysDiff <= 3 ? 'border-warning' : 'border-primary';
                    
                    return `
                        <div class="deadline-item ${urgencyClass} border-start border-3 ps-2 mb-2">
                            <div class="d-flex justify-content-between align-items-start">
                                <div style="flex: 1; min-width: 0;">
                                    <div class="fw-semibold text-truncate" style="font-size: 0.85rem;">${deadline.title}</div>
                                    <div class="text-muted small">${date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}${isToday ? ' (Today)' : ''}</div>
                                </div>
                            </div>
                        </div>
                    `;
                }).join('');
                
            } catch (error) {
                console.error('Error loading deadlines:', error);
                deadlinesList.innerHTML = '<p class="text-muted small">Error loading deadlines.</p>';
            }
        }
    </script>
}
