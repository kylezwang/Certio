                                                    Hi! I'm Notal, your AI assistant. How can I help you today?
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Messages will be loaded here -->
                                </div>

                                <!-- Chat Input -->
                                <div class="dashboard-chat-input">
                                    <div class="input-container">
                                        <!-- Attachment Preview (hidden by default) -->
                                        <div class="attachment-preview" id="dashboardAttachmentPreview" style="display: none;">
                                            <i class="fas fa-paperclip attachment-preview-icon"></i>
                                            <div class="attachment-preview-info">
