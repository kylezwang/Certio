@model Certio.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_ClientLayout";
    var orgType = ViewBag.OrganizationType != null
        ? (Certio.Domain.Organizations.OrganizationType)ViewBag.OrganizationType
        : Certio.Domain.Organizations.OrganizationType.LawFirm;
    var orgEntity = ViewBag.OrganizationEntity as Certio.Domain.Organizations.Organization;
    // Use custom terminology if available, otherwise fall back to type-based default
    var mattersLabel = orgEntity != null
        ? Certio.Web.Helpers.RoleDisplayHelper.GetMattersTerminology(orgEntity)
        : Certio.Web.Helpers.RoleDisplayHelper.GetMattersTerminology(orgType);
    var matterLabel = orgEntity != null
        ? Certio.Web.Helpers.RoleDisplayHelper.GetMatterTerminology(orgEntity)
        : Certio.Web.Helpers.RoleDisplayHelper.GetMatterTerminology(orgType);
}

@*
    NOTE: This is a style-first pass (layout/structure/visual language only) for the operational
    cards below the AI chat section. All numbers, lists, and amounts in those cards are placeholder
    sample content; real data wiring (ViewModel/controller/AJAX) is intentionally deferred until the
    layout is approved. See docs/BACKLOG/AI_TERMINOLOGY_CLEANUP_AND_RUNTIME_ISSUES.md (Part 2, P0)
    for the Daily Briefing / Notal Suggestions latency issue this redesign replaces (those two
    AI-generated cards were removed; the "What can I help with?" ask box below is fully functional
    and unrelated to that latency issue since it only calls the AI on-demand, per message).

    EXCEPTION: The "Recent Events" card is wired to real data. Each Matter/Event Details page
    records itself to localStorage ("certio_recent_events") when opened; this card reads that
    list (scoped to the current organization) and renders the most recently opened events.
*@

<div class="global-dashboard-main">
    <div class="row h-100">
        <div class="col-12 main-column dash-main-column">

            <!-- AI Chat Section -->
            <div class="card mb-4 border-0 ai-chat-card gd-card" id="aiChatCard">
                <div class="card-body p-0 ai-chat-card-body">
                    <button class="btn btn-link text-muted p-0 ai-close-btn" id="aiCloseBtn" title="Close conversation" style="display: none;">
                        <i class="fas fa-times"></i>
                    </button>
                    <button class="btn btn-link text-muted p-0 ai-fullscreen-btn" id="aiFullscreenBtn" title="Toggle fullscreen">
                        <i class="fas fa-expand"></i>
                    </button>
                    <div class="row g-0 h-100">
                        <!-- Conversations Column -->
                        <div class="col-md-3 conversations-column" id="conversationsColumn">
                            <!-- Sticky Header with Search and New Note -->
                            <div class="conversations-header">
                                <!-- Search Bar Container with New Note -->
                                <div class="conversations-search-container">
                                    <i class="fas fa-search conversations-search-icon"></i>
                                    <input type="text" class="conversations-search-input" placeholder="Search Notes" id="conversationsSearchInput" />
                                    <button class="conversations-filter-btn" title="Filter">
                                        <i class="fas fa-filter"></i>
                                    </button>
                                    <!-- New Note Button -->
                                    <div class="conversations-new-note-container">
                                        <a href="#" id="newNoteBtn" class="text-decoration-none" style="display: block;">
                                            <div class="card border-0 conversations-new-note-btn">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="fas fa-plus" style="color: #3d1019; font-size: 0.875rem;"></i>
                                                    <div style="min-width: 0; flex: 1; margin-top: 0;">
                                                        <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.875rem;">
                                                            New Note
                                                        </h6>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="conversations-list" id="conversationsList">
                                <div class="conversations-loading">Loading conversations...</div>
                            </div>
                        </div>
                        <!-- Main Chat Content -->
                        <div class="col-12 ai-chat-main-content" id="aiChatMainContent">
                            <!-- Default Landing View (shown when no conversation selected) -->
                            <div class="p-4 dashboard-landing-view" id="dashboardLandingView">
                                <div class="text-center mb-3">
                                    <img src="~/images/Notal_Banner_Logo_Large_Text.png" alt="Notal AI" style="height: 45px; object-fit: contain;" />
                                </div>
                                <h2 class="text-center mb-4 fs-2 fw-semibold text-dark">What can I help with?</h2>

                                <!-- Attachment Preview for Landing View (hidden by default) -->
                                <div class="attachment-preview landing-attachment-preview" id="landingAttachmentPreview" style="display: none; max-width: 600px; margin: 0 auto 1rem auto;">
                                    <i class="fas fa-paperclip attachment-preview-icon"></i>
                                    <div class="attachment-preview-info">
                                        <div class="attachment-preview-name" id="landingAttachmentName">Document.pdf</div>
                                        <div class="attachment-preview-size" id="landingAttachmentSize">2.4 MB</div>
                                    </div>
                                    <button class="attachment-preview-remove" id="landingRemoveAttachment" title="Remove attachment">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>

                                <div class="search-container-large" id="searchContainer">
                                    <div class="search-plus-container">
                                        <button class="btn btn-link text-muted" id="dashboardPlusBtn" type="button" title="Add attachment">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                    <input type="text" class="form-control form-control-lg" id="dashboardSearchInput" placeholder="Ask anything" />
                                    <div class="search-actions">
                                        <button class="btn btn-link text-muted">
                                            <i class="fas fa-microphone"></i>
                                        </button>
                                        <button class="btn btn-link text-muted" id="dashboardSendBtn">
                                            <i class="fas fa-paper-plane"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Conversation View (shown when conversation is selected) -->
