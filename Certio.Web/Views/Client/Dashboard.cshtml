        // Generate AI response with streaming (dashboard version)
        async function generateDashboardAIResponse(userMessage) {
            try {
                const orgId = @ViewBag.OrganizationId;
                if (!orgId) {
                    console.error('Organization ID not found');
                    return;
                }
                
                // Keep "AI is thinking..." visible until first chunk arrives
                let aiMessageDiv = null;
                let messageTextDiv = null;
                let isFirstChunk = true;
                
                let fullContent = '';
                
                // Track if user has manually scrolled up
                let userHasScrolledUp = false;
                let lastScrollHeight = 0;
                
                const chatMessages = document.getElementById('dashboardChatMessages');
                
                // Detect manual scroll by user
                const handleScroll = () => {
                    if (!chatMessages) return;
                    
                    const isAtBottom = chatMessages.scrollHeight - chatMessages.scrollTop - chatMessages.clientHeight < 50;
                    
                    // If user scrolls back to bottom, re-enable auto-scroll
                    if (isAtBottom) {
                        userHasScrolledUp = false;
                    } 
                    // If scroll position changed and we're not at bottom, user scrolled up
                    else if (chatMessages.scrollHeight === lastScrollHeight) {
                        userHasScrolledUp = true;
                    }
                    
                    lastScrollHeight = chatMessages.scrollHeight;
                };
                
                // Add scroll listener
                if (chatMessages) {
                    chatMessages.addEventListener('scroll', handleScroll);
                }
                
                const response = await fetch(`/Client/${orgId}/Chat/GenerateAIResponseStream`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        conversationId: parseInt(window.dashboardCurrentConversationId),
                        userMessage: userMessage
                    })
                });
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                // Handle Server-Sent Events stream
                const reader = response.body.getReader();
                const decoder = new TextDecoder();
                let buffer = '';
                
                while (true) {
                    const { done, value } = await reader.read();
                    
                    if (done) {
                        break;
                    }
                    
                    // Decode the chunk and add to buffer
                    buffer += decoder.decode(value, { stream: true });
                    
                    // Process complete SSE messages (separated by \n\n)
                    const messages = buffer.split('\n\n');
                    buffer = messages.pop() || ''; // Keep incomplete message in buffer
                    
                    for (const message of messages) {
                        if (message.startsWith('data: ')) {
                            const jsonData = message.substring(6);
                            
                            try {
                                const eventData = JSON.parse(jsonData);
                                
                                // Add delay between chunks for smooth visual streaming (30ms per chunk)
                                await new Promise(resolve => setTimeout(resolve, 30));
                                
                                if (eventData.error) {
                                    // Error occurred
                                    hideDashboardAIThinkingIndicator();
                                    if (messageTextDiv) {
                                        messageTextDiv.innerHTML = eventData.content || 'An error occurred while generating the response.';
                                    }
                                    // Remove streaming class
                                    if (aiMessageDiv) {
                                        aiMessageDiv.classList.remove('streaming');
                                    }
                                    if (chatMessages) {
                                        chatMessages.removeEventListener('scroll', handleScroll);
                                    }
                                    return;
                                }
                                
                                if (eventData.done) {
                                    // Stream complete - remove streaming class
                                    hideDashboardAIThinkingIndicator();
                                    if (aiMessageDiv) {
                                        aiMessageDiv.classList.remove('streaming');
                                    }
                                    if (messageTextDiv) {
                                        // Use content directly as HTML (like sidebar does) - AI returns HTML-formatted content
                                        messageTextDiv.innerHTML = fullContent || 'No response generated.';
                                    }
                                    
                                    // Remove scroll listener
                                    if (chatMessages) {
                                        chatMessages.removeEventListener('scroll', handleScroll);
                                    }
                                    
                                    return;
                                }
                                
                                if (eventData.content) {
                                    // On first chunk: hide thinking indicator and create streaming placeholder
                                    if (isFirstChunk) {
                                        hideDashboardAIThinkingIndicator();
                                        aiMessageDiv = createDashboardStreamingAIMessagePlaceholder();
                                        messageTextDiv = aiMessageDiv.querySelector('.message-text');
                                        
                                        // Initialize empty message text
                                        messageTextDiv.textContent = '';
                                        
                                        isFirstChunk = false;
                                    }
                                    
                                    try {
                                        // Append chunk to full content
                                        fullContent += eventData.content;
                                        
                                        // During streaming: keep HTML structure, only remove incomplete tags (like sidebar)
                                        let displayText = fullContent
                                            .replace(/<[^>]*$/g, '')  // Remove incomplete tag at the end (e.g., "<p" or "<stro")
                                            .trim();
                                        
                                        // Update using innerHTML to preserve HTML formatting during streaming (like sidebar)
                                        const tempDiv = document.createElement('div');
                                        tempDiv.innerHTML = displayText;
                                        
                                        // Clear messageTextDiv and rebuild with formatted content
                                        messageTextDiv.innerHTML = '';
                                        while (tempDiv.firstChild) {
                                            messageTextDiv.appendChild(tempDiv.firstChild);
                                        }
                                        
                                        // Auto-scroll only if user hasn't manually scrolled up
                                        if (chatMessages && !userHasScrolledUp) {
                                            chatMessages.scrollTop = chatMessages.scrollHeight;
                                            lastScrollHeight = chatMessages.scrollHeight;
                                        }
                                    } catch (domError) {
                                        console.error('Error in DOM update:', domError);
                                    }
                                }
                            } catch (e) {
                                console.error('Error parsing SSE:', e);
                            }
                        }
                    }
                }
                
            } catch (error) {
                console.error('Error generating streaming AI response:', error);
                hideDashboardAIThinkingIndicator();
                
                // Show error message in chat
                const chatMessages = document.getElementById('dashboardChatMessages');
                if (chatMessages) {
                    const errorDiv = document.createElement('div');
                    errorDiv.className = 'ai-message-bubble error-message';
                    errorDiv.innerHTML = `
                        <div class="message-content">
                            <div class="message-header">
                                <img src="/images/Notal_Banner_Logo.png" alt="Notal AI" class="ai-message-logo" />
                                <span class="timestamp">${new Date().toLocaleTimeString()}</span>
                            </div>
                            <div class="message-text">
                                I apologize, but I'm having trouble generating a response right now. Please try again in a moment.
                            </div>
                        </div>
                    `;
                    chatMessages.appendChild(errorDiv);
                    chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'smooth' });
                }
            }
        }

        // Handle search input send (for landing view)
        document.addEventListener('DOMContentLoaded', function() {
            const searchSendBtn = document.getElementById('dashboardSendBtn');
            const searchInput = document.getElementById('dashboardSearchInput');
            
            if (searchSendBtn && searchInput) {
                searchSendBtn.addEventListener('click', async function() {
                    const message = searchInput.value.trim();
                    if (!message) return;
                    
                    // Check if we have a conversation selected
                    const savedConversationId = localStorage.getItem('dashboardSelectedConversation');
                    
                    if (savedConversationId) {
                        // Use existing conversation
                        window.dashboardCurrentConversationId = savedConversationId;
                        loadDashboardConversation(savedConversationId);
                        
                        // Wait a bit for view to switch, then send message
                        setTimeout(() => {
                            const dashboardInput = document.getElementById('dashboardMessageInput');
                            if (dashboardInput) {
                                dashboardInput.value = message;
                                document.getElementById('dashboardSendButton').click();
                            }
                        }, 100);
                    } else {
                        // Create new conversation
                        try {
                            const orgId = @ViewBag.OrganizationId;
                            const response = await fetch(`/Client/${orgId}/Chat/CreateConversation`, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/x-www-form-urlencoded',
                                },
                                body: `title=New Chat&description=${encodeURIComponent(message)}`
                            });
                            
                            const data = await response.json();
                            
                            if (data.success && data.conversationId) {
                                // Set as current conversation
                                window.dashboardCurrentConversationId = data.conversationId;
                                localStorage.setItem('dashboardSelectedConversation', data.conversationId);
                                
                                // Load the conversation and send the message
                                await loadDashboardConversation(data.conversationId);
                                
                                // Wait for view to switch, then send message
                                setTimeout(() => {
                                    const dashboardInput = document.getElementById('dashboardMessageInput');
                                    if (dashboardInput) {
                                        dashboardInput.value = message;
                                        document.getElementById('dashboardSendButton').click();
                                    }
                                }, 200);
                                
                                // Reload conversations list
                                loadDashboardConversations();
                            } else {
                                console.error('Failed to create conversation:', data.error);
                            }
                        } catch (error) {
                            console.error('Error creating conversation:', error);
                        }
                    }
                });
                
                searchInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        searchSendBtn.click();
                    }
                });
            }
        });

        // Stream AI-powered briefing and suggestions (once per session)
        async function streamDashboardBriefingCards() {
            // Check if already shown this session
            const briefingShown = sessionStorage.getItem('briefingCardsShown');
            if (briefingShown === 'true') {
                // Load cached content if available
                const cachedBriefing = sessionStorage.getItem('briefingContent');
                const cachedSuggestions = sessionStorage.getItem('suggestionsContent');
                
                if (cachedBriefing) {
                    const contentElement = document.getElementById('dailyBriefingContent');
                    const summaryElement = document.getElementById('dailyBriefingSummary');
                    
                    // Parse and create summary grid
                    const counts = parseBriefingContent(cachedBriefing);
                    if (summaryElement) {
                        updateBriefingSummary(counts);
                    }
                    
                    // Format and store full content
                    let displayText = cachedBriefing
                        .replace(/<[^>]*$/g, '')
                        .trim();
                    
                    if (typeof formatIntelligentResponse === 'function') {
                        displayText = formatIntelligentResponse(displayText);
                    } else {
                        displayText = displayText
                            .replace(/\n/g, '<br>')
                            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                            .replace(/→/g, '→');
                    }
                    
                    if (contentElement) {
                        contentElement.innerHTML = displayText;
                    }
                }
                if (cachedSuggestions) {
                    const suggestionsContentElement = document.getElementById('notalSuggestionsContent');
                    const suggestionsSummaryElement = document.getElementById('notalSuggestionsSummary');
                    
                    // Format cached content
                    let displayText = cachedSuggestions
                        .replace(/<[^>]*$/g, '')
                        .trim();
                    
                    if (typeof formatIntelligentResponse === 'function') {
                        displayText = formatIntelligentResponse(displayText);
                    } else {
                        displayText = displayText
                            .replace(/\n/g, '<br>')
                            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                            .replace(/→/g, '→');
                    }
                    
                    // Create truncated summary view
                    if (suggestionsSummaryElement) {
                        const summaryHTML = createSuggestionsSummary(displayText, 3);
                        suggestionsSummaryElement.innerHTML = summaryHTML;
                    }
                    
                    // Store full content for fullscreen view
                    if (suggestionsContentElement) {
                        suggestionsContentElement.innerHTML = displayText;
                    }
                }
                return;
            }

            try {
                const orgId = @ViewBag.OrganizationId;
                if (!orgId) return;

                // Stream Daily Briefing
                await streamBriefingCard('daily-briefing', 
                    'dailyBriefingContent',
                    `Generate a concise daily briefing for today. Include:
                    - Number of filings due today with case names
                    - Scheduled client calls with times and names
                    - Any overdue items (invoices, tasks, deadlines)
                    Format as brief bullet points. Be specific and actionable.
                    IMPORTANT: Do NOT use emojis. Use Unicode symbols like •, ▸, ►, ✓, ✔, ✗, ✘, →, ‣ instead.
                    Example format:
                    Today
                    2 filings due
                    Smith v. Jones, ABC Corp
                    
                    1 client call
                    4:30 PM with Johnson
                    
                    1 overdue invoice
                    follow-up needed`
                );

                // Wait a moment before streaming suggestions
                await new Promise(resolve => setTimeout(resolve, 800));

                // Stream Notal Suggestions
                await streamBriefingCard('notal-suggestions',
                    'notalSuggestionsContent',
                    `Generate 3-4 actionable suggestions based on current workload. Include:
                    - Inactive matters needing follow-up
                    - Overdue invoices or billings
                    - Resource allocation issues (overloaded team members)
                    Format as brief items with action arrows.
                    IMPORTANT: Do NOT use emojis. Use Unicode symbols like •, ▸, ►, ✓, ✔, ✗, ✘, →, ‣ instead.
                    Example format:
                    Matter Z inactive 12 days
                    -> follow up
                    
                    3 overdue invoices
                    -> send reminders
                    
                    Paralegal C overloaded
                    -> consider reassigning`
                );

                // Mark as shown for this session
                sessionStorage.setItem('briefingCardsShown', 'true');
            } catch (error) {
                console.error('Error streaming briefing cards:', error);
            }
        }

        // Stream individual briefing card with AI (using C# backend like chat sidebar)
        async function streamBriefingCard(cardType, contentElementId, promptTemplate) {
            const contentElement = document.getElementById(contentElementId);
            if (!contentElement) return;

            // For Daily Briefing and Suggestions, we need to handle both summary and full content views
            const isDailyBriefing = contentElementId === 'dailyBriefingContent';
            const isSuggestions = contentElementId === 'notalSuggestionsContent';
            const summaryElement = isDailyBriefing ? document.getElementById('dailyBriefingSummary') : 
                                   isSuggestions ? document.getElementById('notalSuggestionsSummary') : null;

            try {
                const orgId = @ViewBag.OrganizationId;
                const response = await fetch(`/Client/${orgId}/Chat/GenerateDashboardCardStream`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        userMessage: promptTemplate,
                        cardType: cardType
                    })
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                // Clear loading state
                if ((isDailyBriefing || isSuggestions) && summaryElement) {
                    summaryElement.innerHTML = '';
                } else {
                    contentElement.innerHTML = '';
                }

                // Handle SSE streaming (same format as chat sidebar)
                const reader = response.body.getReader();
                const decoder = new TextDecoder();
                let buffer = '';
                let fullContent = '';

                while (true) {
                    const { done, value } = await reader.read();
                    
                    if (done) break;
                    
                    buffer += decoder.decode(value, { stream: true });
                    const messages = buffer.split('\n\n');
                    buffer = messages.pop() || '';
                    
                    for (const message of messages) {
                        if (message.startsWith('data: ')) {
                            const jsonData = message.substring(6);
                            
                            try {
                                const eventData = JSON.parse(jsonData);
                                
                                if (eventData.error) {
                                    if ((isDailyBriefing || isSuggestions) && summaryElement) {
                                        summaryElement.innerHTML = '<p class="text-muted small">Unable to generate content</p>';
                                    } else {
                                        contentElement.innerHTML = '<p class="text-muted small">Unable to generate content</p>';
                                    }
                                    return;
                                }
                                
                                if (eventData.done) {
                                    // Cache the final content for session persistence
                                    sessionStorage.setItem(contentElementId === 'dailyBriefingContent' ? 'briefingContent' : 'suggestionsContent', fullContent);
                                    
                                    // Format full content for display
                                    let displayText = fullContent
                                        .replace(/<[^>]*$/g, '')
                                        .trim();
                                    
                                    if (typeof formatIntelligentResponse === 'function') {
                                        displayText = formatIntelligentResponse(displayText);
                                    } else {
                                        displayText = displayText
                                            .replace(/\n/g, '<br>')
                                            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                                            .replace(/→/g, '→');
                                    }
                                    
                                    // For Daily Briefing, parse content and create summary grid
                                    if (isDailyBriefing && summaryElement) {
                                        const counts = parseBriefingContent(fullContent);
                                        updateBriefingSummary(counts);
                                        contentElement.innerHTML = displayText;
                                    }
                                    // For Suggestions, create truncated summary view
                                    else if (isSuggestions && summaryElement) {
                                        const summaryHTML = createSuggestionsSummary(displayText, 3);
                                        summaryElement.innerHTML = summaryHTML;
                                        contentElement.innerHTML = displayText;
                                    }
                                    // For other cards, update normally
                                    else {
                                        contentElement.innerHTML = displayText;
                                    }
                                    return;
                                }
                                
                                if (eventData.content) {
                                    fullContent += eventData.content;
                                    
                                    // Format content for display
                                    let displayText = fullContent
                                        .replace(/<[^>]*$/g, '')
                                        .trim();
                                    
                                    if (typeof formatIntelligentResponse === 'function') {
                                        displayText = formatIntelligentResponse(displayText);
                                    } else {
                                        displayText = displayText
                                            .replace(/\n/g, '<br>')
                                            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                                            .replace(/→/g, '→');
                                    }
                                    
                                    // For Daily Briefing, update summary grid as content streams
                                    if (isDailyBriefing && summaryElement) {
                                        const counts = parseBriefingContent(fullContent);
                                        updateBriefingSummary(counts);
                                        contentElement.innerHTML = displayText;
                                    }
                                    // For Suggestions, update truncated summary view as content streams
                                    else if (isSuggestions && summaryElement) {
                                        const summaryHTML = createSuggestionsSummary(displayText, 3);
                                        summaryElement.innerHTML = summaryHTML;
                                        contentElement.innerHTML = displayText;
                                    }
                                    // For other cards, update normally
                                    else {
                                        contentElement.innerHTML = displayText;
                                    }
                                }
                            } catch (e) {
                                console.error('Error parsing SSE:', e);
                            }
                        }
                    }
                }
            } catch (error) {
                console.error(`Error streaming ${cardType}:`, error);
                if (isDailyBriefing && summaryElement) {
                    summaryElement.innerHTML = '<p class="text-muted small">Unable to load content</p>';
                } else {
                    contentElement.innerHTML = '<p class="text-muted small">Unable to load content</p>';
                }
            }
        }

        async function loadDashboardUpcomingDeadlines() {
            const deadlinesList = document.getElementById('dashboardUpcomingDeadlinesList');
            if (!deadlinesList) return;
            
            try {
                const orgId = @ViewBag.OrganizationId;
                if (!orgId) {
                    deadlinesList.innerHTML = '<p class="text-muted small">Unable to load deadlines.</p>';
                    return;
                }
                
                // Fetch upcoming calendar events (deadlines)
                const endDate = new Date();
                endDate.setDate(endDate.getDate() + 30); // Next 30 days
                
                const response = await fetch(`/Client/${orgId}/Calendar/Events?start=${new Date().toISOString()}&end=${endDate.toISOString()}`, {
                    credentials: 'include'
                });
                
                if (!response.ok) {
                    throw new Error('Failed to fetch deadlines');
                }
                
                const result = await response.json();
                
                if (!result.success || !result.events || result.events.length === 0) {
                    deadlinesList.innerHTML = '<p class="text-muted small">No upcoming deadlines.</p>';
                    return;
                }
                
                // Filter and sort events as deadlines
                const deadlines = result.events
                    .filter(e => new Date(e.startDateTime) > new Date())
                    .sort((a, b) => new Date(a.startDateTime) - new Date(b.startDateTime))
                    .slice(0, 5); // Show top 5
                
                if (deadlines.length === 0) {
                    deadlinesList.innerHTML = '<p class="text-muted small">No upcoming deadlines.</p>';
                    return;
                }
                
                // Render deadlines
                deadlinesList.innerHTML = deadlines.map(deadline => {
                    const date = new Date(deadline.startDateTime);
                    const isToday = date.toDateString() === new Date().toDateString();
                    const daysDiff = Math.ceil((date - new Date()) / (1000 * 60 * 60 * 24));
                    const urgencyClass = daysDiff <= 1 ? 'border-danger' : daysDiff <= 3 ? 'border-warning' : 'border-primary';
                    
                    return `
                        <div class="deadline-item ${urgencyClass} border-start border-3 ps-2 mb-2">
                            <div class="d-flex justify-content-between align-items-start">
                                <div style="flex: 1; min-width: 0;">
                                    <div class="fw-semibold text-truncate" style="font-size: 0.85rem;">${deadline.title}</div>
                                    <div class="text-muted small">${date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}${isToday ? ' (Today)' : ''}</div>
                                </div>
                            </div>
                        </div>
                    `;
                }).join('');
                
            } catch (error) {
                console.error('Error loading deadlines:', error);
                deadlinesList.innerHTML = '<p class="text-muted small">Error loading deadlines.</p>';
            }
        }
    </script>
}
