@section Scripts {
    <script>
        (function () {
            var STORAGE_KEY = 'certio_recent_events';
            var MAX_DISPLAYED = 3;
            var currentOrgId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((ViewBag.OrganizationId ?? "").ToString()));
            var listEl = document.getElementById('dashRecentEventsList');
            if (!listEl) return;

            function getStatusBadgeClass(status) {
                switch (status) {
                    case 'Completed': return 'bg-success text-white';
                    case 'In Progress': return 'bg-primary text-white';
                    case 'Review': return 'bg-warning text-dark';
                    case 'Planning': return 'bg-secondary text-white';
                    default: return 'bg-secondary text-white';
                }
            }

            function getInitials(title) {
                if (!title) return '';
                var initials = '';
                var parts = title.split(' ').filter(Boolean);
                for (var i = 0; i < parts.length && initials.length < 2; i++) {
                    var cleaned = parts[i].replace(/&/g, '').trim();
                    if (cleaned) initials += cleaned[0].toUpperCase();
                }
                return initials;
            }

            function formatTimeAgo(timestamp) {
                var diffMs = Date.now() - timestamp;
                var diffMin = Math.floor(diffMs / 60000);
                if (diffMin < 1) return 'Just now';
                if (diffMin < 60) return diffMin + 'm ago';
                var diffHr = Math.floor(diffMin / 60);
                if (diffHr < 24) return diffHr + 'h ago';
                var diffDay = Math.floor(diffHr / 24);
                return diffDay + 'd ago';
            }

            function formatDueDate(iso) {
                if (!iso) return 'No event date';
                var d = new Date(iso);
                if (isNaN(d.getTime())) return 'No event date';
                return d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
            }

            function escapeHtml(str) {
                var div = document.createElement('div');
                div.textContent = str || '';
                return div.innerHTML;
            }

            function renderEmpty() {
                listEl.innerHTML = '<p class="text-muted small mb-0">No recently opened events yet. Open an event to see it here.</p>';
            }

            function render(events) {
                if (!events.length) {
                    renderEmpty();
                    return;
                }

                listEl.innerHTML = events.map(function (evt) {
                    var href = '/Client/' + evt.orgId + '/Matter/Details/' + evt.id;
                    return '' +
                        '<a class="dash-event-card" href="' + href + '">' +
                            '<div class="dash-event-card-top">' +
                                '<div class="dash-event-card-icon">' + escapeHtml(getInitials(evt.title)) + '</div>' +
                                '<span class="dash-event-card-title">' + escapeHtml(evt.title) + '</span>' +
                                '<span class="badge dash-event-card-status ' + getStatusBadgeClass(evt.status) + '">' + escapeHtml(evt.status || 'Unknown') + '</span>' +
                            '</div>' +
                            '<div class="dash-event-card-meta-row">' +
                                '<span><i class="fas fa-calendar me-1"></i>' + escapeHtml(formatDueDate(evt.dueDate)) + '</span>' +
                                '<span>Viewed ' + formatTimeAgo(evt.viewedAt) + '</span>' +
                            '</div>' +
                        '</a>';
                }).join('');
            }

            try {
                var raw = window.localStorage.getItem(STORAGE_KEY);
                var events = raw ? JSON.parse(raw) : [];
                if (!Array.isArray(events)) events = [];

                events = events.filter(function (evt) {
                    return evt && String(evt.orgId) === currentOrgId;
                });

                events.sort(function (a, b) { return (b.viewedAt || 0) - (a.viewedAt || 0); });

                render(events.slice(0, MAX_DISPLAYED));
            } catch (e) {
                renderEmpty();
            }
        })();
    </script>

    <script>
        // ==================== AI Chat Card ("What can I help with?") ====================
        // Pending attachment state for dashboard
        let dashboardPendingAttachment = null;
        window._dashboardUploadingAttachment = false;
        window.dashboardCurrentConversationId = null;

        document.addEventListener('DOMContentLoaded', async function () {
            initializeAiFullscreen();
            initializeAiChatActivation();
            initializeAiClose();
            initializeNewNoteButton();
            initializeDashboardPlusButton();
            initializeDashboardFileUpload();
            await loadDashboardConversations();
        });

        function initializeAiChatActivation() {
            const aiCard = document.getElementById('aiChatCard');
            const searchContainer = document.getElementById('searchContainer');

            if (!aiCard || !searchContainer) return;

            // Handle click on search container to activate
            searchContainer.addEventListener('click', function (e) {
                // Don't activate if clicking on action buttons or plus button
                if (e.target.closest('.search-actions') || e.target.closest('.search-plus-container')) {
                    return;
                }

                // Focus the input if clicking on container
                const input = searchContainer.querySelector('input');
                if (input && e.target === searchContainer) {
                    input.focus();
                }

                // Activate if not already activated (unless fullscreen)
                if (!aiCard.classList.contains('activated') && !aiCard.classList.contains('fullscreen')) {
                    aiCard.classList.add('activated');
                }
            });

            // Handle input focus to activate
            const input = searchContainer.querySelector('input');
            if (input) {
                input.addEventListener('focus', function () {
                    if (!aiCard.classList.contains('activated') && !aiCard.classList.contains('fullscreen')) {
                        aiCard.classList.add('activated');
                    }
                });
            }
        }

        function initializeDashboardPlusButton() {
            const plusBtn = document.getElementById('dashboardPlusBtn');
            if (plusBtn) {
                plusBtn.addEventListener('click', showDashboardAttachmentMenu);
            }
        }

        // Initialize dashboard file upload functionality
        function initializeDashboardFileUpload() {
            const fileInput = document.getElementById('dashboardFileInput');
            const attachFileBtn = document.getElementById('dashboardAttachFileBtn');
            const attachmentPreview = document.getElementById('dashboardAttachmentPreview');
            const removeAttachment = document.getElementById('dashboardRemoveAttachment');
            const landingAttachmentPreview = document.getElementById('landingAttachmentPreview');
            const landingRemoveAttachment = document.getElementById('landingRemoveAttachment');

            // Attach file button click handler
            if (attachFileBtn && fileInput) {
                attachFileBtn.addEventListener('click', function () {
                    fileInput.click();
                });
            }

            // File input change handler
            if (fileInput) {
                fileInput.addEventListener('change', function (e) {
                    const file = e.target.files[0];
                    if (file) {
                        // Show attachment preview
                        const fileName = file.name;
                        const fileSize = (file.size / (1024 * 1024)).toFixed(2) + ' MB';

                        // Determine which view is active
                        const landingView = document.getElementById('dashboardLandingView');
                        const conversationView = document.getElementById('dashboardConversationView');
                        const isLandingView = landingView && landingView.style.display !== 'none';

                        if (isLandingView && landingAttachmentPreview) {
                            // Show in landing view
                            const landingAttachmentName = document.getElementById('landingAttachmentName');
                            const landingAttachmentSize = document.getElementById('landingAttachmentSize');

                            if (landingAttachmentName) landingAttachmentName.textContent = fileName;
                            if (landingAttachmentSize) landingAttachmentSize.textContent = fileSize;

                            landingAttachmentPreview.style.display = 'flex';
                        } else if (attachmentPreview) {
                            // Show in conversation view
                            const attachmentName = document.getElementById('dashboardAttachmentName');
                            const attachmentSize = document.getElementById('dashboardAttachmentSize');

                            if (attachmentName) attachmentName.textContent = fileName;
                            if (attachmentSize) attachmentSize.textContent = fileSize;

                            attachmentPreview.style.display = 'flex';
                            if (attachFileBtn) {
                                attachFileBtn.classList.add('active');
                            }
                        }
                    }
                });
            }

            // Remove attachment handler for conversation view
            if (removeAttachment && fileInput && attachmentPreview) {
                removeAttachment.addEventListener('click', function () {
                    fileInput.value = '';
                    attachmentPreview.style.display = 'none';
                    dashboardPendingAttachment = null;
                    if (attachFileBtn) {
                        attachFileBtn.classList.remove('active');
                    }
                });
            }

            // Remove attachment handler for landing view
            if (landingRemoveAttachment && fileInput && landingAttachmentPreview) {
                landingRemoveAttachment.addEventListener('click', function () {
                    fileInput.value = '';
                    landingAttachmentPreview.style.display = 'none';
                    dashboardPendingAttachment = null;
                });
            }
        }

        // Upload and extract content from attachment (dashboard version)
        async function uploadDashboardAttachment(file) {
            const orgId = @ViewBag.OrganizationId;
            if (!orgId) {
                console.error('Organization ID not found');
                return null;
            }

            // Set uploading flag
            window._dashboardUploadingAttachment = true;

            const formData = new FormData();
            formData.append('file', file);

            try {
                const response = await fetch(`/Client/${orgId}/Chat/UploadAttachment`, {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();

                if (data.success) {
                    console.log(`Dashboard attachment processed: ${data.fileName} (${data.contentLength} chars extracted)`);
                    window._dashboardUploadingAttachment = false;
                    return {
                        fileName: data.fileName,
                        fileSize: data.fileSize,
                        extractedContent: data.extractedContent
                    };
                } else {
                    console.error('Failed to process attachment:', data.error);
                    window._dashboardUploadingAttachment = false;
                    alert('Failed to process attachment: ' + data.error);
                    return null;
                }
            } catch (error) {
                console.error('Error uploading attachment:', error);
                window._dashboardUploadingAttachment = false;
                alert('Error uploading attachment. Please try again.');
                return null;
            }
        }

        // Dashboard conversation context menu
        function showDashboardConversationContextMenu(event, conversationItem) {
            // Remove existing context menu if any
            const existingMenu = document.getElementById('conversationContextMenu');
            if (existingMenu) {
                existingMenu.remove();
            }

            const conversationId = conversationItem.dataset.conversationId;
            const conversationTitle = conversationItem.querySelector('.conversation-title')?.textContent || 'Untitled Note';

            // Create context menu
            const contextMenu = document.createElement('div');
            contextMenu.id = 'conversationContextMenu';
            contextMenu.className = 'conversation-context-menu';
            contextMenu.innerHTML = `
                <div class="context-menu-item" onclick="renameDashboardConversation('${conversationId}', '${conversationTitle.replace(/'/g, "\\'")}')">
                    <i class="fas fa-edit"></i> Rename Note
                </div>
                <div class="context-menu-item delete-item" onclick="deleteDashboardConversation('${conversationId}')">
                    <i class="fas fa-trash"></i> Delete Note
                </div>
            `;

            // Position the menu
            contextMenu.style.left = event.pageX + 'px';
            contextMenu.style.top = event.pageY + 'px';

            document.body.appendChild(contextMenu);
        }

        // Show attachment menu popup for dashboard plus button
        function showDashboardAttachmentMenu(event) {
            event.preventDefault();
            event.stopPropagation();

            // Remove existing attachment menu if any
            const existingMenu = document.getElementById('dashboardAttachmentMenu');
            if (existingMenu) {
                existingMenu.remove();
                return;
            }

            const plusBtn = document.getElementById('dashboardPlusBtn');
            if (!plusBtn) return;

            // Get button position
            const rect = plusBtn.getBoundingClientRect();

            // Create attachment menu
            const attachmentMenu = document.createElement('div');
            attachmentMenu.id = 'dashboardAttachmentMenu';
            attachmentMenu.className = 'conversation-context-menu';
            attachmentMenu.innerHTML = `
                <div class="context-menu-item" onclick="handleAddPhotosFiles()">
                    <i class="fas fa-paperclip"></i> Add photos & files
                </div>
                <div class="context-menu-item" onclick="handleAddFromGoogleDrive()">
                    <i class="fab fa-google" style="color: #4285f4; width: auto; font-size: 14px;"></i> Add from Google Drive
                </div>
                <div class="context-menu-item" onclick="handleAddFromOneDrive()">
                    <i class="fab fa-windows" style="color: #0078d4; width: auto; font-size: 14px;"></i> Add from Microsoft OneDrive
                </div>
            `;

            document.body.appendChild(attachmentMenu);

            // Get actual menu dimensions after rendering
            const menuRect = attachmentMenu.getBoundingClientRect();
            const actualMenuHeight = menuRect.height;

            // Position the menu above the button, left-aligned with button's left edge
            const leftPosition = rect.left;
            const topPosition = rect.top - actualMenuHeight - 8; // 8px gap above button

            attachmentMenu.style.left = leftPosition + 'px';
            attachmentMenu.style.top = topPosition + 'px';

            // Close menu when clicking outside
            setTimeout(() => {
                document.addEventListener('click', function closeMenu(e) {
                    if (!attachmentMenu.contains(e.target) && e.target !== plusBtn && !plusBtn.contains(e.target)) {
                        attachmentMenu.remove();
                        document.removeEventListener('click', closeMenu);
                    }
                });
            }, 0);
        }

