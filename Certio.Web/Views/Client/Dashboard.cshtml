        // Load messages for a conversation
        async function loadDashboardConversationMessages(conversationId) {
            const chatMessages = document.getElementById('dashboardChatMessages');
            if (!chatMessages) return;
            
            try {
                const orgId = @ViewBag.OrganizationId;
                if (!orgId) {
                    console.error('Organization ID not found');
                    return;
                }
                
                const response = await fetch(`/Client/${orgId}/Chat/GetMessages/${conversationId}`);
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const messages = await response.json();
                
                // Clear existing messages (except header)
                const messagesToRemove = chatMessages.querySelectorAll('.ai-message-bubble:not(.notal-conversation-header .ai-message-bubble), .user-message-bubble');
                messagesToRemove.forEach(msg => msg.remove());
                
                // Display messages
                messages.forEach(message => {
                    addDashboardMessageToChat(message);
                });
                
                // Scroll to bottom
                chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'instant' });
                
            } catch (error) {
                console.error('Error loading messages:', error);
                chatMessages.innerHTML += '<div class="text-danger p-2">Failed to load messages</div>';
            }
        }

        // Add message to dashboard chat
        function addDashboardMessageToChat(message) {
            const chatMessages = document.getElementById('dashboardChatMessages');
            if (!chatMessages) return;
            
            const messageDiv = document.createElement('div');
            const isAI = message.isFromAI || false;
            messageDiv.className = isAI ? 'ai-message-bubble' : 'user-message-bubble';
            
            const timestamp = new Date(message.createdAt || Date.now()).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
            
            // Use content directly as HTML (like sidebar does) - AI returns HTML-formatted content
            let formattedContent = message.content || '';
            
            if (isAI) {
                messageDiv.innerHTML = `
                    <div class="message-content">
                        <div class="message-header">
                            <img src="/images/Notal_Banner_Logo.png" alt="Notal AI" class="ai-message-logo" />
                            <span class="timestamp">${timestamp}</span>
                        </div>
                        <div class="message-text">${formattedContent}</div>
                    </div>
                `;
            } else {
                // For user messages, escape HTML for security
                formattedContent = formattedContent
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/\\n/g, '\n')
                    .replace(/\n/g, '<br>');
                
                messageDiv.innerHTML = `
                    <div class="message-content">
                        <div class="message-header">
                            <span class="timestamp">${timestamp}</span>
                        </div>
                        <div class="message-text">${formattedContent}</div>
                    </div>
                `;
            }
            
            chatMessages.appendChild(messageDiv);
            chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'instant' });
        }

        // Initialize dashboard chat input handlers
        function initializeDashboardChatInput() {
            const messageInput = document.getElementById('dashboardMessageInput');
            const sendButton = document.getElementById('dashboardSendButton');
            
            if (!messageInput || !sendButton) return;
            
            // Check if already initialized to avoid duplicate listeners
            if (messageInput.dataset.initialized === 'true') return;
            messageInput.dataset.initialized = 'true';
            
            // Send message handler
            const sendMessage = async () => {
                const input = document.getElementById('dashboardMessageInput');
                const message = input.value.trim();
                
                if (!message || !window.dashboardCurrentConversationId) return;
                
                // Clear input
                input.value = '';
                updateDashboardCharCounter();
                
                // Add user message immediately
                addDashboardMessageToChat({
                    content: message,
                    isFromAI: false,
                    createdAt: new Date().toISOString()
                });
                
                // Show intelligent AI thinking indicator
                showDashboardAIThinkingIndicator(message);
                
                // Send to server
                try {
                    const orgId = @ViewBag.OrganizationId;
                    const response = await fetch(`/Client/${orgId}/Chat/SendMessage`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: `conversationId=${window.dashboardCurrentConversationId}&content=${encodeURIComponent(message)}&messageType=Text`
                    });
                    
                    const data = await response.json();
                    
                    if (data.success) {
                        // Generate streaming AI response
                        await generateDashboardAIResponse(message);
                    } else {
                        console.error('Failed to send message:', data.error);
                        hideDashboardAIThinkingIndicator();
                    }
                } catch (error) {
                    console.error('Error sending message:', error);
                    hideDashboardAIThinkingIndicator();
                }
            };
            
            // Event listeners
            sendButton.addEventListener('click', sendMessage);
            messageInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    sendMessage();
                }
            });
            
            // Character counter
            messageInput.addEventListener('input', updateDashboardCharCounter);
            
            // Auto-resize textarea
            messageInput.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 120) + 'px';
            });
        }

