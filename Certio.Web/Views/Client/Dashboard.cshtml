        // Parse briefing content and extract counts for summary grid
        function parseBriefingContent(content) {
            // Remove HTML tags and normalize whitespace
            const text = content.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').toLowerCase();
            
            // Extract counts for different categories
            let filingsDue = 0;
            let clientCalls = 0;
            let overdueItems = 0;
            
            // Look for filings due patterns - most specific first
            const filingsMatch = text.match(/(\d+)\s*(filings?|filing)\s*(due|today)/i);
            if (filingsMatch) {
                filingsDue = parseInt(filingsMatch[1]) || 0;
            } else {
                // Try alternative pattern
                const filingsAlt = text.match(/(\d+)\s*(filings?)/i);
                if (filingsAlt) {
                    filingsDue = parseInt(filingsAlt[1]) || 0;
                }
            }
            
            // Look for client calls - MUST include "client" to avoid false matches
            const clientCallsMatch = text.match(/(\d+)\s*(client\s*)?calls?/i);
            if (clientCallsMatch) {
                clientCalls = parseInt(clientCallsMatch[1]) || 0;
            } else {
                // Try pattern with "client call" explicitly
                const clientCallsAlt = text.match(/client\s*calls?.*?(\d+)/i);
                if (clientCallsAlt) {
                    clientCalls = parseInt(clientCallsAlt[1]) || 0;
                }
            }
            
            // Look for overdue items - check for "overdue" keyword specifically
            const overdueMatch = text.match(/(\d+)\s*overdue\s*(tasks?|items?|invoices?|deadlines?)/i);
            if (overdueMatch) {
                overdueItems = parseInt(overdueMatch[1]) || 0;
            } else {
                // Try alternative patterns
                const overdueAlt1 = text.match(/(\d+)\s*(overdue|past\s*due)/i);
                if (overdueAlt1) {
                    overdueItems = parseInt(overdueAlt1[1]) || 0;
                } else {
                    const overdueAlt2 = text.match(/overdue.*?(\d+)/i);
                    if (overdueAlt2) {
                        overdueItems = parseInt(overdueAlt2[1]) || 0;
                    }
                }
            }
            
            return {
                filingsDue: filingsDue,
                clientCalls: clientCalls,
                overdueItems: overdueItems
            };
        }

