        // Dashboard rename conversation
        function renameDashboardConversation(conversationId, currentTitle) {
            const newTitle = prompt('Enter new note name:', currentTitle);
            if (newTitle && newTitle.trim() !== '' && newTitle !== currentTitle) {
                const orgId = @ViewBag.OrganizationId;
                if (!orgId) {
                    console.error('Organization ID not found');
                    return;
                }

                fetch(`/Client/${orgId}/Chat/RenameConversation`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        conversationId: parseInt(conversationId),
                        newTitle: newTitle.trim()
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Update the conversation title in the UI
                        const conversationElement = document.querySelector(`.conversation-item[data-conversation-id="${conversationId}"] .conversation-title`);
                        if (conversationElement) {
                            conversationElement.textContent = newTitle.trim();
                        }
                        // Also update in sidebar if it exists
                        const sidebarElement = document.querySelector(`.conversation-tab[data-conversation-id="${conversationId}"] .tab-title`);
                        if (sidebarElement) {
                            sidebarElement.textContent = newTitle.trim();
                        }
                    } else {
                        alert('Failed to rename note: ' + (data.error || 'Unknown error'));
                    }
                })
                .catch(error => {
                    console.error('Error renaming conversation:', error);
                    alert('Failed to rename note');
                });
            }

            // Remove context menu
            const contextMenu = document.getElementById('conversationContextMenu');
            if (contextMenu) {
                contextMenu.remove();
            }
        }

        // Dashboard delete conversation
        function deleteDashboardConversation(conversationId) {
            if (!confirm('Are you sure you want to delete this note? This action cannot be undone.')) {
                return;
            }

            const orgId = @ViewBag.OrganizationId;
            if (!orgId) {
                console.error('Organization ID not found');
                return;
            }

            const convId = parseInt(conversationId);
            const convIdStr = String(conversationId);

            fetch(`/Client/${orgId}/Chat/DeleteConversation`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    conversationId: convId
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Remove the conversation from the dashboard UI
                    const conversationElement = document.querySelector(`.conversation-item[data-conversation-id="${convIdStr}"]`);
                    if (conversationElement) {
                        conversationElement.remove();
                    }

                    // Also remove from sidebar if it exists
                    const sidebarElement = document.querySelector(`.conversation-tab[data-conversation-id="${convIdStr}"]`);
                    if (sidebarElement) {
                        sidebarElement.remove();
                    }

                    // If this was the active conversation, reset the dashboard chat card
                    if (window.dashboardCurrentConversationId === convIdStr || window.dashboardCurrentConversationId === convId) {
                        resetDashboardChatCard(true); // Keep conversations column visible
                    }

                    // Remove from localStorage if it was saved
                    const savedConversationId = localStorage.getItem('dashboardSelectedConversation');
                    if (savedConversationId === convIdStr || savedConversationId === String(convId)) {
                        localStorage.removeItem('dashboardSelectedConversation');
                    }
                } else {
                    alert('Failed to delete note: ' + (data.error || 'Unknown error'));
                }
            })
            .catch(error => {
                console.error('Error deleting conversation:', error);
                alert('Failed to delete note');
            });

            // Remove context menu
            const contextMenu = document.getElementById('conversationContextMenu');
            if (contextMenu) {
                contextMenu.remove();
            }
        }

        async function loadDashboardConversations() {
            const conversationsList = document.getElementById('conversationsList');
            if (!conversationsList) return;

            try {
                const orgId = @ViewBag.OrganizationId;
                if (!orgId) {
                    conversationsList.innerHTML = '<div class="conversations-loading">No organization selected</div>';
                    return;
                }

                const response = await fetch(`/Client/${orgId}/Chat/GetAIConversations`, {
                    credentials: 'include'
                });

                if (!response.ok) {
                    conversationsList.innerHTML = '<div class="conversations-loading">No AI conversations yet</div>';
                    return;
                }

                const conversations = await response.json();

                if (!conversations || conversations.length === 0) {
                    conversationsList.innerHTML = '<div class="conversations-loading">No AI conversations yet</div>';
                    return;
                }

                // Render conversations vertically
                conversationsList.innerHTML = conversations.map(conversation => {
                    return `
                        <div class="conversation-item" data-conversation-id="${conversation.id}">
                            <div class="conversation-title">${conversation.title || 'Untitled Conversation'}</div>
                        </div>
                    `;
                }).join('');

                // Add click handlers - scoped to dashboard conversations only
                conversationsList.querySelectorAll('.conversation-item').forEach(item => {
                    item.addEventListener('click', function (e) {
                        e.stopPropagation(); // Prevent event from bubbling to sidebar handlers

                        // Scope selection to dashboard conversations list only
                        const dashboardConversationsList = document.getElementById('conversationsList');
                        if (!dashboardConversationsList) return;

                        // Remove active class from all dashboard items only
                        dashboardConversationsList.querySelectorAll('.conversation-item').forEach(i => {
                            i.classList.remove('active');
                        });

                        // Add active class to clicked item
                        this.classList.add('active');

                        // Save to localStorage with dashboard-specific key
                        const conversationId = this.dataset.conversationId;
                        localStorage.setItem('dashboardSelectedConversation', conversationId);

                        // Activate the card if not already activated
                        const aiCard = document.getElementById('aiChatCard');
                        if (aiCard && !aiCard.classList.contains('fullscreen')) {
                            aiCard.classList.add('activated');
                        }

                        // Load conversation messages and show conversation view
                        loadDashboardConversation(conversationId);
                    });

                    // Add right-click context menu handler
                    item.addEventListener('contextmenu', function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        showDashboardConversationContextMenu(e, this);
                    });
                });

                // Restore previously selected conversation - scoped to dashboard only
                const savedConversationId = localStorage.getItem('dashboardSelectedConversation');
                if (savedConversationId) {
                    // Only look within the dashboard conversations list
                    const savedItem = conversationsList.querySelector(`.conversation-item[data-conversation-id="${savedConversationId}"]`);
                    if (savedItem) {
                        // Remove active class from all dashboard items only
                        conversationsList.querySelectorAll('.conversation-item').forEach(i => {
                            i.classList.remove('active');
                        });

                        // Add active class to saved item
                        savedItem.classList.add('active');

                        // Activate the card
                        const aiCard = document.getElementById('aiChatCard');
                        if (aiCard && !aiCard.classList.contains('fullscreen')) {
                            aiCard.classList.add('activated');
                        }

                        // Load conversation messages
                        loadDashboardConversation(savedConversationId);
                    }
                }

            } catch (error) {
                console.error('Error loading conversations:', error);
                conversationsList.innerHTML = '<div class="conversations-loading">Failed to load conversations</div>';
            }
        }

        function initializeAiFullscreen() {
            const aiCard = document.getElementById('aiChatCard');
            const fullscreenBtn = document.getElementById('aiFullscreenBtn');
            const mainContent = document.querySelector('.main-content.client-main-content');

            if (!aiCard || !fullscreenBtn) return;

            function toggleFullscreen(isFullscreen) {
                if (isFullscreen) {
                    aiCard.classList.add('fullscreen', 'activated'); // Always activate conversations in fullscreen

                    // Get main content dimensions and position
                    if (mainContent) {
                        const rect = mainContent.getBoundingClientRect();
                        aiCard.style.position = 'fixed';
                        aiCard.style.top = rect.top + 'px';
                        aiCard.style.left = rect.left + 'px';
                        aiCard.style.width = rect.width + 'px';
                        aiCard.style.height = rect.height + 'px';
                    }

                    const icon = fullscreenBtn.querySelector('i');
                    icon.classList.remove('fa-expand');
                    icon.classList.add('fa-compress');
                } else {
                    aiCard.classList.remove('fullscreen');

                    // Reset inline styles
                    aiCard.style.position = '';
                    aiCard.style.top = '';
                    aiCard.style.left = '';
                    aiCard.style.width = '';
                    aiCard.style.height = '';

                    const icon = fullscreenBtn.querySelector('i');
                    icon.classList.remove('fa-compress');
                    icon.classList.add('fa-expand');
                }
            }

            fullscreenBtn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();

                const isFullscreen = aiCard.classList.contains('fullscreen');
                toggleFullscreen(!isFullscreen);
            });

            // Allow ESC key to exit fullscreen
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && aiCard.classList.contains('fullscreen')) {
                    toggleFullscreen(false);
                }
            });
        }

        function updateAiChatFullscreenPosition() {
            const mainContent = document.querySelector('.main-content.client-main-content');
            if (!mainContent) return;

            const rect = mainContent.getBoundingClientRect();

            const aiCard = document.getElementById('aiChatCard');
            if (aiCard && aiCard.classList.contains('fullscreen')) {
                aiCard.style.top = rect.top + 'px';
                aiCard.style.left = rect.left + 'px';
                aiCard.style.width = rect.width + 'px';
                aiCard.style.height = rect.height + 'px';
            }
        }

        // Handle window resize/scroll to update fullscreen card position
        window.addEventListener('resize', updateAiChatFullscreenPosition);
        window.addEventListener('scroll', updateAiChatFullscreenPosition, { passive: true });

        function initializeAiClose() {
            const closeBtn = document.getElementById('aiCloseBtn');
