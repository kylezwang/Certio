<style>
    /* Calendar Page Container */
    .calendar-page-container {
        height: 100%;
        display: flex;
        flex-direction: column;
        background: #ffffff;
    }

    /* Calendar Header Bar */
    .calendar-header-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.5rem;
        background: #ffffff;
        border-bottom: 1px solid #e5e7eb;
    }

    .calendar-month-label {
        font-size: 1.25rem;
        font-weight: 600;
        color: #1f2937;
    }

    .calendar-nav-controls {
        display: flex;
        gap: 0.5rem;
    }

    .calendar-nav-controls .btn {
        padding: 0.375rem 0.75rem;
    }

    .calendar-nav-controls .btn:hover {
        background-color: #eef1f3;
    }

    /* Calendar Grid Container */
    .calendar-grid-container {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        grid-template-rows: auto repeat(5, 1fr);
        flex: 1;
        background: #e5e7eb;
        gap: 1px;
        overflow: hidden;
    }

    /* Day Headers */
    .calendar-day-header {
        background: #f8fafc;
        padding: 0.5rem 0.75rem;
        text-align: center;
        font-weight: 600;
        font-size: 0.875rem;
        color: #6b7280;
    }

    /* Day Cells */
    .calendar-day-cell {
        background: #ffffff;
        padding: 0.5rem;
        position: relative;
        min-height: 120px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .calendar-day-cell.other-month {
        background: #fafafa;
    }

    .calendar-day-cell.other-month .day-number {
        color: #9ca3af;
    }

    .calendar-day-cell.today {
        background: #ffffff;
    }

    .calendar-day-cell.today .day-number {
        background: #2563eb;
        color: #ffffff;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
    }

    /* Selected Day - mirror sidebar behavior */
    .calendar-day-cell.selected .day-number {
        background: #2563eb;
        color: #ffffff;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
    }

    /* Day Number */
    .day-number {
        font-size: 0.875rem;
        font-weight: 500;
        color: #374151;
        margin-bottom: 0.5rem;
    }

    /* Event Items */
    .event-item {
        font-size: 0.8rem;
        margin-bottom: 0.25rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        cursor: pointer;
    }

    /* Event Dots (for specific time events) */
    .event-dot {
        color: #4b5563;
        padding-left: 0.75rem;
        position: relative;
    }

    .event-dot::before {
        content: '';
        position: absolute;
        left: 0.25rem;
        top: 0.4rem;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #6b7280;
    }

    .event-dot.purple::before {
        background: #a855f7;
    }

    .event-dot.blue::before {
        background: #2563eb;
    }

    .event-dot.red::before {
        background: #ef4444;
    }

    .event-dot:hover {
        color: #1f2937;
        font-weight: 500;
    }

    /* Event Pills (for all-day events) */
    .event-pill {
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        font-weight: 600;
        color: #ffffff;
        display: inline-block;
        max-width: 100%;
    }

    .event-pill.purple-pill {
        background: #8b5cf6;
    }

    .event-pill.blue-pill {
        background: #5b7bd5;
    }

    .event-pill.red-pill {
        background: #ef4444;
    }

    .event-pill:hover {
        opacity: 0.9;
        transform: translateY(-1px);
    }

    /* Responsive adjustments */
    @@media (max-width: 1400px) {
        .calendar-day-cell {
            min-height: 100px;
        }
        
        .event-item {
            font-size: 0.75rem;
        }
    }

    @@media (max-width: 1200px) {
        .calendar-day-cell {
            min-height: 80px;
        }
        
        .day-number {
            font-size: 0.75rem;
        }
        
        .event-item {
            font-size: 0.7rem;
        }
    }
</style>

@section Scripts {
    <script>
        // Calendar state
        let currentDate = new Date();
        const orgId = @ViewBag.OrganizationId;
        
        // Listen for calendar filter changes
        window.addEventListener('calendarFiltersChanged', function(event) {
            const selectedCalendars = event.detail.selectedCalendars;
            console.log('Calendar page received filter update:', selectedCalendars);
            
            // TODO: Update the calendar view based on selected filters
            // This will filter events displayed in the calendar scoped to this org
            // Fetch: /Client/{orgId}/Calendar/Events?calendarIds=...
        });

        // Month navigation
        document.addEventListener('DOMContentLoaded', function() {
            const prevBtn = document.getElementById('prevMonthBtn');
            const nextBtn = document.getElementById('nextMonthBtn');
            const monthLabel = document.querySelector('.calendar-month-label');

            if (prevBtn) {
                prevBtn.addEventListener('click', function() {
                    currentDate.setMonth(currentDate.getMonth() - 1);
                    updateCalendar();
                });
            }

            if (nextBtn) {
                nextBtn.addEventListener('click', function() {
                    currentDate.setMonth(currentDate.getMonth() + 1);
                    updateCalendar();
                });
            }

            function updateCalendar() {
                // Update month label
                const monthNames = ['January', 'February', 'March', 'April', 'May', 'June',
                                  'July', 'August', 'September', 'October', 'November', 'December'];
                monthLabel.textContent = `${monthNames[currentDate.getMonth()]} ${currentDate.getFullYear()}`;
                
                // TODO: Fetch events for the new month from the server scoped to this org
                // Fetch: /Client/{orgId}/Calendar/Events?year=2025&month=10
                console.log('Calendar updated to:', monthLabel.textContent, 'for org:', orgId);
            }

            // Event click handlers
            const eventItems = document.querySelectorAll('.event-item');
            eventItems.forEach(item => {
                item.addEventListener('click', function(e) {
                    e.stopPropagation();
                    console.log('Event clicked:', this.textContent);
                    // TODO: Show event details modal or navigate to event page
                });
            });

            // Day selection behavior (mirror sidebar calendar)
            function clearSelected() {
                document.querySelectorAll('.calendar-day-cell.selected').forEach(function (el) {
                    el.classList.remove('selected');
                });
                // Remove automatic today highlight once a selection is made
                document.querySelectorAll('.calendar-day-cell.today').forEach(function (el) {
                    el.classList.remove('today');
                });
            }

            const dayCells = document.querySelectorAll('.calendar-day-cell');
            dayCells.forEach(cell => {
                cell.addEventListener('click', function() {
                    clearSelected();
                    this.classList.add('selected');
                    const dayText = this.querySelector('.day-number')?.textContent || '';
                    const dayNum = parseInt(dayText.replace(/[^0-9]/g, ''), 10);
                    // Broadcast to sidebar calendar
                    window.dispatchEvent(new CustomEvent('calendarDaySelected', { detail: { day: dayNum } }));
                    // TODO: Open create event modal for this org
                });
            });

            // Listen for selection from sidebar to reflect here
            window.addEventListener('calendarDaySelected', function(e) {
                if (!e || !e.detail || !e.detail.day) return;
                const target = Array.from(document.querySelectorAll('.calendar-day-cell .day-number'))
                    .find(el => (el.textContent || '').trim().replace(/[^0-9]/g, '') === String(e.detail.day));
                if (target) {
                    clearSelected();
                    target.closest('.calendar-day-cell')?.classList.add('selected');
                }
            });
        });
    </script>
}

