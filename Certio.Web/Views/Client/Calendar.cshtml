    }

    .planner-all-day-task[data-priority="Low"] {
        border-left-color: #6c757d;
    }
</style>

@section Scripts {
    <script>
        // Calendar state
        // Terminology variables from server
        const selectMatterText = '@Html.Raw("Select a " + matterLabel)';
        const viewAllMattersText = '@Html.Raw("View All " + mattersLabel)';
        
        let currentDate = new Date();
        let currentViewDate = new Date(); // For planner view navigation
        let currentView = 'month'; // 'month', 'week', 'day'
        const orgId = @ViewBag.OrganizationId;
        const currentUserId = @ViewBag.CurrentUserId;
        const userTimeZone = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.UserTimeZone ?? "UTC"));
        let allEvents = [];
        let allTasks = []; // Tasks for planner view
        let allMatters = [];
        let allUsers = [];
        let currentEventId = null; // For edit mode
        let eventAttendees = []; // Track attendees for new/edited event

        // Timezone Helper Functions
        // Converts a datetime-local input value to UTC ISO string in user's timezone
        function convertLocalInputToUTC(dateTimeLocalValue) {
            if (!dateTimeLocalValue) return null;
            
            const [datePart, timePart] = dateTimeLocalValue.split('T');
            if (!datePart || !timePart) return null;

            const [year, month, day] = datePart.split('-').map(Number);
            const [hour, minute] = timePart.split(':').map(Number);
            
            const assumedUtc = new Date(Date.UTC(year, month - 1, day, hour, minute || 0));
            const offsetMinutes = getTimezoneOffset(assumedUtc, userTimeZone);
            const utcDate = new Date(assumedUtc.getTime() - offsetMinutes * 60000);
            
            return utcDate.toISOString();
        }
        
        // Converts a UTC ISO string to datetime-local format in user's timezone
        function convertUTCToLocalInput(utcISOString) {
            if (!utcISOString) return '';
            
            const utcDate = new Date(utcISOString);
            
            const offsetMinutes = getTimezoneOffset(utcDate, userTimeZone);
            const localDate = new Date(utcDate.getTime() + offsetMinutes * 60000);
            
            const year = localDate.getUTCFullYear();
            const month = String(localDate.getUTCMonth() + 1).padStart(2, '0');
            const day = String(localDate.getUTCDate()).padStart(2, '0');
            const hours = String(localDate.getUTCHours()).padStart(2, '0');
            const minutes = String(localDate.getUTCMinutes()).padStart(2, '0');
            
            return `${year}-${month}-${day}T${hours}:${minutes}`;
        }
        
        // Get timezone offset in minutes for a specific timezone
        function getTimezoneOffset(date, timeZone) {
            try {
                const formatter = new Intl.DateTimeFormat('en-US', {
                    timeZone,
                    hour12: false,
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit',
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit'
                });

                const parts = formatter.formatToParts(date);
                const data = {};
                for (const { type, value } of parts) {
                    data[type] = value;
                }

                const utcEstimate = Date.UTC(
                    Number(data.year),
                    Number(data.month) - 1,
                    Number(data.day),
                    Number(data.hour),
                    Number(data.minute),
                    Number(data.second ?? '0')
                );

                return (utcEstimate - date.getTime()) / 60000;
            } catch (e) {
                console.error('Error calculating timezone offset:', e);
                return -date.getTimezoneOffset();
            }
        }
        
        // Format date for display in user's timezone
        function formatDateInUserTz(utcISOString, includeTime = true) {
            if (!utcISOString) return '';
            
            const date = new Date(utcISOString);
            const options = {
                timeZone: userTimeZone,
                year: 'numeric',
                month: 'short',
                day: 'numeric'
            };
            
            if (includeTime) {
                options.hour = 'numeric';
                options.minute = '2-digit';
                options.hour12 = true;
            }
            
            return date.toLocaleString('en-US', options);
        }

        // Initialize calendar on page load
        document.addEventListener('DOMContentLoaded', async function() {
            await loadMatters();
            await loadUsers();
            await fetchAndRenderCalendar();
            initializeEventHandlers();
            initializeModalHandlers();
            
            // Initialize location search if Google Maps is ready, otherwise it will be initialized by callback
            if (window.google && google.maps && google.maps.places) {
                initializeEventLocationSearch();
            } else {
                // Try again after a delay in case Google Maps is still loading
                setTimeout(function() {
                    if (window.google && google.maps && google.maps.places) {
                        initializeEventLocationSearch();
                    }
                }, 2000);
            }
            
            // Initialize view toggle
            initializeViewToggle();
        });

        // Load matters for dropdown
        async function loadMatters() {
            try {
                const response = await fetch(`/Client/${orgId}/Calendar/Matters`, {
                    credentials: 'include'
                });
                const result = await response.json();
                if (result.success) {
                    allMatters = result.matters;
                    populateMatterPopup();
                    initializeMatterSelector();
                }
            } catch (error) {
                console.error('Error loading matters:', error);
            }
        }

        // Load users for attendee selection
        async function loadUsers() {
            try {
                const response = await fetch(`/Client/${orgId}/Users`, {
                    credentials: 'include'
                });
                if (response.ok) {
                    const result = await response.json();
                    if (result.success && result.users) {
                        allUsers = result.users;
                    }
                }
            } catch (error) {
                console.error('Error loading users:', error);
                // Fallback: use current user
                allUsers = [{ id: currentUserId, name: '@ViewBag.CurrentUserName', initials: '@ViewBag.CurrentUserInitials' }];
            }
        }

        // Populate matter popup in modal header
        function populateMatterPopup() {
            const matterPopupList = document.getElementById('eventMatterPopupList');
            matterPopupList.innerHTML = `
                <button type="button" class="event-matter-item" data-matter-id="" title="Select a @matterLabel">
                    <i class="fas fa-folder-open"></i>
                    <span class="event-matter-item-text">Select a @matterLabel</span>
                </button>
            `;
            
            allMatters.forEach(matter => {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'event-matter-item';
                button.dataset.matterId = matter.id;
                button.title = matter.title;
                button.innerHTML = `
                    <i class="fas fa-folder"></i>
                    <span class="event-matter-item-text">${matter.title}</span>
                `;
                matterPopupList.appendChild(button);
            });

            // Add click handlers to matter items
            document.querySelectorAll('.event-matter-item').forEach(item => {
                item.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const matterId = this.dataset.matterId;
                    const matterText = this.querySelector('.event-matter-item-text').textContent;
                    
                    // Update button text
                    document.getElementById('eventMatterSelectorText').textContent = matterText;
                    
                    // Store selected matter ID
                    document.getElementById('eventMatterSelectorBtn').dataset.selectedMatterId = matterId;
                    
                    // Hide popup
                    document.getElementById('eventMatterPopup').style.display = 'none';
                });
            });
        }

        // Initialize matter selector button
        function initializeMatterSelector() {
            const matterBtn = document.getElementById('eventMatterSelectorBtn');
            const matterPopup = document.getElementById('eventMatterPopup');
            
            if (matterBtn && matterPopup) {
                matterBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const isVisible = matterPopup.style.display === 'block';
                    matterPopup.style.display = isVisible ? 'none' : 'block';
                });
            }

            // Close popup when clicking outside
            document.addEventListener('click', function(e) {
                if (!matterPopup) return;
                const clickInsidePopup = matterPopup.contains(e.target);
                const clickOnButton = matterBtn && matterBtn.contains(e.target);
                if (!clickInsidePopup && !clickOnButton) {
                    matterPopup.style.display = 'none';
                }
            });
        }



        // Fetch and render calendar
        async function fetchAndRenderCalendar() {
            const year = currentDate.getFullYear();
            const month = currentDate.getMonth();
            
            // Get first and last day of month
            const startDate = new Date(year, month, 1);
            const endDate = new Date(year, month + 1, 0);
            
            try {
                const response = await fetch(
                    `/Client/${orgId}/Calendar/Events?start=${startDate.toISOString()}&end=${endDate.toISOString()}`,
                    { credentials: 'include' }
                );
                const result = await response.json();
                
                if (result.success) {
                    allEvents = result.events;
                    renderCalendar(year, month, allEvents);
                }
            } catch (error) {
                console.error('Error fetching events:', error);
            }
        }

        // Render calendar grid
        function renderCalendar(year, month, events) {
            // Hide loading state
            const loadingState = document.getElementById('calendarLoadingState');
            if (loadingState) {
                loadingState.style.display = 'none';
            }
            
                // Update month label
                const monthNames = ['January', 'February', 'March', 'April', 'May', 'June',
                                  'July', 'August', 'September', 'October', 'November', 'December'];
            document.querySelector('.calendar-month-label').textContent = `${monthNames[month]} ${year}`;
            
            // Clear existing calendar
            const gridContainer = document.querySelector('.calendar-grid-container');
            const dayHeaders = gridContainer.querySelectorAll('.calendar-day-header');
            gridContainer.innerHTML = '';
            
            // Re-add day headers
            dayHeaders.forEach(header => gridContainer.appendChild(header.cloneNode(true)));
            
            // Calculate calendar dates
            const firstDay = new Date(year, month, 1);
            const lastDay = new Date(year, month + 1, 0);
            const prevLastDay = new Date(year, month, 0);
            const firstDayOfWeek = firstDay.getDay(); // 0 = Sunday
            const daysInMonth = lastDay.getDate();
            const daysInPrevMonth = prevLastDay.getDate();
            
            // Generate calendar days
            let dayCounter = 1;
            let nextMonthCounter = 1;
            
            for (let week = 0; week < 6; week++) {
                for (let dayOfWeek = 0; dayOfWeek < 7; dayOfWeek++) {
                    const cellIndex = week * 7 + dayOfWeek;
                    const dayCell = document.createElement('div');
                    dayCell.classList.add('calendar-day-cell');
                    
                    let currentDayDate;
                    
                    if (cellIndex < firstDayOfWeek) {
                        // Previous month days
                        const day = daysInPrevMonth - firstDayOfWeek + cellIndex + 1;
                        dayCell.classList.add('other-month');
                        dayCell.innerHTML = `<div class="day-number">${day}</div>`;
                        currentDayDate = new Date(year, month - 1, day);
                    } else if (dayCounter <= daysInMonth) {
                        // Current month days
                        const isToday = year === new Date().getFullYear() && 
                                       month === new Date().getMonth() && 
                                       dayCounter === new Date().getDate();
                        
                        if (isToday) {
                            dayCell.classList.add('today');
                        }
                        
                        const dayLabel = dayCounter === 1 ? `${monthNames[month].substring(0, 3)} 1` : dayCounter;
                        dayCell.innerHTML = `<div class="day-number">${dayLabel}</div>`;
                        currentDayDate = new Date(year, month, dayCounter);
                        dayCounter++;
                    } else {
                        // Next month days
                        dayCell.classList.add('other-month');
                        const dayLabel = nextMonthCounter === 1 ? `${monthNames[(month + 1) % 12].substring(0, 3)} 1` : nextMonthCounter;
                        dayCell.innerHTML = `<div class="day-number">${dayLabel}</div>`;
                        currentDayDate = new Date(year, month + 1, nextMonthCounter);
                        nextMonthCounter++;
                    }
                    
                    // Store the date on the cell for later use
                    dayCell.dataset.cellDate = currentDayDate.toISOString();
                    
                    // Add events for this day
                    if (events && events.length > 0) {
                        const dayEvents = events.filter(event => {
                            const eventStart = new Date(event.startDateTime);
                            return eventStart.toDateString() === currentDayDate.toDateString();
                        });
                        
                        dayEvents.forEach(event => {
                            const eventEl = createEventElement(event);
                            dayCell.appendChild(eventEl);
                        });
                    }
                    
                    // Add click handler for day cell
                    dayCell.addEventListener('click', function(e) {
                        if (!e.target.closest('.event-item')) {
                            // Clicked on empty space, select the day and open create event modal
                            document.querySelectorAll('.calendar-day-cell.selected').forEach(el => 
                                el.classList.remove('selected'));
                            this.classList.add('selected');
                            
                            // Open create event modal with the selected date
                            const cellDate = new Date(this.dataset.cellDate);
                            cellDate.setHours(9, 0, 0, 0); // Default to 9 AM
                            openEventModal(null, cellDate);
                        }
                    });
                    
                    gridContainer.appendChild(dayCell);
                }
            }
        }

        // Create event element for calendar
        function createEventElement(event) {
            const eventEl = document.createElement('div');
            eventEl.classList.add('event-item');
            eventEl.setAttribute('data-event-id', event.id);
            
            if (event.isAllDayEvent) {
                // All-day event - pill style
                eventEl.classList.add('event-pill', `${event.color}-pill`);
                eventEl.textContent = event.title;
            } else {
                // Timed event - dot style
                eventEl.classList.add('event-dot', event.color);
                const startTime = new Date(event.startDateTime);
                const timeFormatter = new Intl.DateTimeFormat('en-US', {
                    timeZone: userTimeZone,
                    hour: 'numeric',
                    minute: '2-digit',
                    hour12: true
                });
                const timeStr = timeFormatter.format(startTime);
                eventEl.textContent = `${timeStr} ${event.title}`;
            }
            
            // Add click handler to open event modal
            eventEl.addEventListener('click', function(e) {
                    e.stopPropagation();
                openEventModal(event.id);
            });
            
            return eventEl;
        }

        // Initialize event handlers
        function initializeEventHandlers() {
            // Month/Week/Day navigation
            document.getElementById('prevMonthBtn').addEventListener('click', function() {
                navigatePrevious();
            });

            document.getElementById('nextMonthBtn').addEventListener('click', function() {
                navigateNext();
            });

            // Create event button
            document.getElementById('createEventBtn').addEventListener('click', function(e) {
                e.preventDefault();
                openEventModal();
            });

            // Create task button
            document.getElementById('createTaskBtn').addEventListener('click', function(e) {
                e.preventDefault();
                // Redirect to Tasks page with create modal open
                window.location.href = `/Client/${orgId}/Tasks`;
            });

            // Listen for calendar filter changes
            window.addEventListener('calendarFiltersChanged', async function(event) {
                const selectedCalendars = event.detail.selectedCalendars;
                console.log('Calendar filters changed:', selectedCalendars);
                // TODO: Implement filtering based on selected calendars
                await refreshCurrentView();
            });
        }

        // Navigate to previous period based on current view
        function navigatePrevious() {
            if (currentView === 'month') {
                currentDate.setMonth(currentDate.getMonth() - 1);
                fetchAndRenderCalendar();
            } else if (currentView === 'week') {
                currentViewDate.setDate(currentViewDate.getDate() - 7);
                renderPlannerView();
            } else if (currentView === 'day') {
                currentViewDate.setDate(currentViewDate.getDate() - 1);
                renderPlannerView();
            }
        }

        // Navigate to next period based on current view
        function navigateNext() {
            if (currentView === 'month') {
                currentDate.setMonth(currentDate.getMonth() + 1);
                fetchAndRenderCalendar();
            } else if (currentView === 'week') {
                currentViewDate.setDate(currentViewDate.getDate() + 7);
                renderPlannerView();
            } else if (currentView === 'day') {
                currentViewDate.setDate(currentViewDate.getDate() + 1);
                renderPlannerView();
            }
        }

        // Refresh current view with latest events
        async function refreshCurrentView() {
            if (currentView === 'month') {
                await fetchAndRenderCalendar();
            } else {
                await fetchPlannerEvents();
                renderPlannerView();
            }
        }

        // Initialize view toggle functionality
        function initializeViewToggle() {
            const viewOptions = document.querySelectorAll('.view-option');
            
            viewOptions.forEach(option => {
                option.addEventListener('click', function(e) {
                    e.preventDefault();
                    const newView = this.dataset.view;
                    
                    // Update active state
                    viewOptions.forEach(opt => opt.classList.remove('active'));
                    this.classList.add('active');
                    
                    // Update button label
                    const viewLabels = { 'day': 'Day', 'week': 'Week', 'month': 'Month' };
                    document.getElementById('viewToggleLabel').textContent = viewLabels[newView];
                    
                    // Switch view
                    switchView(newView);
                });
            });
        }

        // Switch between month and planner views
        function switchView(view) {
            currentView = view;
            const monthGrid = document.getElementById('calendarGrid');
            const plannerContainer = document.getElementById('plannerViewContainer');
            
            if (view === 'month') {
                monthGrid.style.display = 'grid';
                plannerContainer.style.display = 'none';
                fetchAndRenderCalendar();
            } else {
                monthGrid.style.display = 'none';
                plannerContainer.style.display = 'flex';
                
                // Set view class
                plannerContainer.classList.remove('day-view', 'week-view');
                plannerContainer.classList.add(view + '-view');
                
                // Sync current view date with current date
                currentViewDate = new Date(currentDate);
                
                // Initialize planner
                initializePlannerColumns();
                fetchPlannerEvents().then(() => {
                    renderPlannerView();
                });
            }
        }

        // Initialize planner columns based on view type
        function initializePlannerColumns() {
            const columnsContainer = document.getElementById('plannerColumns');
            columnsContainer.innerHTML = '';
            
            const numColumns = currentView === 'day' ? 1 : 7;
            
            for (let i = 0; i < numColumns; i++) {
                const column = document.createElement('div');
                column.className = 'calendar-column';
                column.dataset.day = i;
                
                // Add 24 time cells (one for each hour)
                for (let hour = 0; hour < 24; hour++) {
                    const cell = document.createElement('div');
                    cell.className = 'time-cell';
                    cell.dataset.hour = hour;
                    cell.dataset.day = i;
                    
                    // Click to create event at this time
                    cell.addEventListener('click', function() {
                        const date = getDateForColumn(i);
                        const startTime = new Date(date);
                        startTime.setHours(hour, 0, 0, 0);
                        openEventModal(null, startTime);
                    });
                    
                    column.appendChild(cell);
                }
                
                columnsContainer.appendChild(column);
            }
        }

        // Get date for a column index
        function getDateForColumn(columnIndex) {
            if (currentView === 'day') {
                return new Date(currentViewDate);
            } else {
                // Week view - get start of week (Sunday)
                const weekStart = getWeekStart(currentViewDate);
                const date = new Date(weekStart);
                date.setDate(date.getDate() + columnIndex);
                return date;
            }
        }

        // Get start of week (Sunday)
        function getWeekStart(date) {
            const d = new Date(date);
            const day = d.getDay();
            d.setDate(d.getDate() - day);
            d.setHours(0, 0, 0, 0);
            return d;
        }

        // Fetch events for planner view
        async function fetchPlannerEvents() {
            let startDate, endDate;
            
            if (currentView === 'day') {
                startDate = new Date(currentViewDate);
                startDate.setHours(0, 0, 0, 0);
                endDate = new Date(currentViewDate);
                endDate.setHours(23, 59, 59, 999);
            } else {
                // Week view
                startDate = getWeekStart(currentViewDate);
                endDate = new Date(startDate);
                endDate.setDate(endDate.getDate() + 7);
            }
            
            try {
                const response = await fetch(
                    `/Client/${orgId}/Calendar/Events?start=${startDate.toISOString()}&end=${endDate.toISOString()}`,
                    { credentials: 'include' }
                );
                const result = await response.json();
                
                if (result.success) {
                    allEvents = result.events;
                }
            } catch (error) {
                console.error('Error fetching events:', error);
            }
            
            // Also fetch tasks
            await fetchPlannerTasks();
        }

        // Fetch tasks for planner view
        async function fetchPlannerTasks() {
            try {
                const response = await fetch(`/Client/${orgId}/Tasks/GetAllTasks`, {
                    credentials: 'include'
                });
                
                if (response.ok) {
                    const result = await response.json();
                    if (result.success && result.tasks) {
                        allTasks = result.tasks;
                    }
                }
            } catch (error) {
                console.error('Error fetching tasks:', error);
                allTasks = [];
            }
        }

        // Render planner view with events
        function renderPlannerView() {
            updatePlannerHeader();
            renderPlannerEvents();
            updateCurrentTimeIndicator();
            scrollToCurrentTime();
        }

        // Scroll planner to current time or 8am
        function scrollToCurrentTime() {
            const timeGrid = document.getElementById('plannerTimeGrid');
            if (!timeGrid) return;
            
            const now = new Date();
            let scrollToHour;
            
            // If today is visible, scroll to current time minus 1 hour
            if (currentView === 'day' && isToday(currentViewDate)) {
                scrollToHour = Math.max(0, now.getHours() - 1);
            } else if (currentView === 'week') {
                const weekStart = getWeekStart(currentViewDate);
                let todayInView = false;
                for (let i = 0; i < 7; i++) {
                    const date = new Date(weekStart);
                    date.setDate(date.getDate() + i);
                    if (isToday(date)) {
                        todayInView = true;
                        break;
                    }
                }
                scrollToHour = todayInView ? Math.max(0, now.getHours() - 1) : 8;
            } else {
                // Default to 8am for other cases
                scrollToHour = 8;
            }
            
            // 60px per hour
            timeGrid.scrollTop = scrollToHour * 60;
        }

        // Update planner header (dates and month label)
        function updatePlannerHeader() {
            const monthLabel = document.querySelector('.calendar-month-label');
            const daysHeader = document.getElementById('plannerDaysHeader');
            const datesHeader = document.getElementById('plannerDatesHeader');
            
            const monthNames = ['January', 'February', 'March', 'April', 'May', 'June',
                              'July', 'August', 'September', 'October', 'November', 'December'];
            const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
            
            if (currentView === 'day') {
                // Day view - single day
                const dateStr = currentViewDate.toLocaleDateString('en-US', { 
                    weekday: 'long', 
                    month: 'long', 
                    day: 'numeric', 
                    year: 'numeric' 
                });
                monthLabel.textContent = dateStr;
                
                // Update headers for single day
                const dayHeaders = daysHeader.querySelectorAll('.day-header:not(.time-header)');
                const dateCells = datesHeader.querySelectorAll('.date-cell:not(.time-header)');
                
                if (dayHeaders[0]) dayHeaders[0].textContent = dayNames[currentViewDate.getDay()];
                if (dateCells[0]) {
                    dateCells[0].textContent = currentViewDate.getDate();
                    dateCells[0].classList.toggle('today', isToday(currentViewDate));
                }
            } else {
                // Week view
                const weekStart = getWeekStart(currentViewDate);
                const weekEnd = new Date(weekStart);
                weekEnd.setDate(weekEnd.getDate() + 6);
                
                if (weekStart.getMonth() === weekEnd.getMonth()) {
                    monthLabel.textContent = `${monthNames[weekStart.getMonth()]} ${weekStart.getFullYear()}`;
                } else {
                    monthLabel.textContent = `${monthNames[weekStart.getMonth()].substring(0, 3)} - ${monthNames[weekEnd.getMonth()].substring(0, 3)} ${weekEnd.getFullYear()}`;
                }
                
                // Update headers for week
                const dayHeaders = daysHeader.querySelectorAll('.day-header:not(.time-header)');
                const dateCells = datesHeader.querySelectorAll('.date-cell:not(.time-header)');
                
                for (let i = 0; i < 7; i++) {
                    const date = new Date(weekStart);
                    date.setDate(date.getDate() + i);
                    
                    if (dayHeaders[i]) dayHeaders[i].textContent = dayNames[i];
                    if (dateCells[i]) {
                        dateCells[i].textContent = date.getDate();
                        dateCells[i].classList.toggle('today', isToday(date));
                        dateCells[i].classList.toggle('active', isSameDay(date, currentViewDate));
                    }
                }
            }
        }

        // Check if date is today
        function isToday(date) {
            const today = new Date();
            return date.getFullYear() === today.getFullYear() &&
                   date.getMonth() === today.getMonth() &&
                   date.getDate() === today.getDate();
        }

        // Check if two dates are the same day
        function isSameDay(date1, date2) {
            return date1.getFullYear() === date2.getFullYear() &&
                   date1.getMonth() === date2.getMonth() &&
                   date1.getDate() === date2.getDate();
        }

        // Render events in planner view
        function renderPlannerEvents() {
            // Clear existing events and tasks
            document.querySelectorAll('.planner-event, .planner-all-day-event, .planner-task-card, .planner-all-day-task').forEach(el => el.remove());
            
            const allDayColumns = document.getElementById('allDayColumns');
            const plannerColumns = document.getElementById('plannerColumns');
            
            // Render events
            allEvents.forEach(event => {
                const eventStart = new Date(event.startDateTime);
                const eventEnd = event.endDateTime ? new Date(event.endDateTime) : new Date(eventStart.getTime() + 3600000);
                
                // Determine which column this event belongs to
                let columnIndex = -1;
                
                if (currentView === 'day') {
                    if (isSameDay(eventStart, currentViewDate)) {
                        columnIndex = 0;
                    }
                } else {
                    const weekStart = getWeekStart(currentViewDate);
                    for (let i = 0; i < 7; i++) {
                        const columnDate = new Date(weekStart);
                        columnDate.setDate(columnDate.getDate() + i);
                        if (isSameDay(eventStart, columnDate)) {
                            columnIndex = i;
                            break;
                        }
                    }
                }
                
                if (columnIndex === -1) return; // Event not in current view
                
                if (event.isAllDayEvent) {
                    // All-day event
                    const allDayCell = allDayColumns.querySelector(`.calendar-column[data-day="${columnIndex}"] .all-day-cell`);
                    if (allDayCell) {
                        const eventEl = document.createElement('div');
                        eventEl.className = `planner-all-day-event ${event.color || 'blue'}`;
                        eventEl.textContent = event.title;
                        eventEl.addEventListener('click', () => openEventModal(event.id));
                        allDayCell.appendChild(eventEl);
                    }
                } else {
                    // Timed event
                    const column = plannerColumns.querySelector(`.calendar-column[data-day="${columnIndex}"]`);
                    if (column) {
                        const eventEl = createPlannerEventElement(event, eventStart, eventEnd);
                        column.appendChild(eventEl);
                    }
                }
            });
            
            // Render tasks
            allTasks.forEach(task => {
                if (!task.dueDate) return; // Skip tasks without due dates
                
                const taskDueDate = new Date(task.dueDate);
                
                // Determine which column this task belongs to
                let columnIndex = -1;
                
                if (currentView === 'day') {
                    if (isSameDay(taskDueDate, currentViewDate)) {
                        columnIndex = 0;
                    }
                } else {
                    const weekStart = getWeekStart(currentViewDate);
                    for (let i = 0; i < 7; i++) {
                        const columnDate = new Date(weekStart);
                        columnDate.setDate(columnDate.getDate() + i);
                        if (isSameDay(taskDueDate, columnDate)) {
                            columnIndex = i;
                            break;
                        }
                    }
                }
                
                if (columnIndex === -1) return; // Task not in current view
                
                // Check if task has specific time or is all-day
                const hasTime = task.dueDate && task.dueDate.indexOf('T') !== -1;
                
                if (!hasTime || taskDueDate.getHours() === 0 && taskDueDate.getMinutes() === 0) {
                    // All-day task
                    const allDayCell = allDayColumns.querySelector(`.calendar-column[data-day="${columnIndex}"] .all-day-cell`);
                    if (allDayCell) {
                        const taskEl = document.createElement('div');
                        taskEl.className = 'planner-all-day-task';
                        taskEl.dataset.priority = task.priority || 'Medium';
                        taskEl.textContent = task.title;
                        taskEl.addEventListener('click', (e) => {
                            e.stopPropagation();
                            openTaskModal(task.id);
                        });
                        allDayCell.appendChild(taskEl);
                    }
                } else {
                    // Timed task
                    const column = plannerColumns.querySelector(`.calendar-column[data-day="${columnIndex}"]`);
                    if (column) {
                        const taskEl = createPlannerTaskCard(task, taskDueDate);
                        column.appendChild(taskEl);
                    }
                }
            });
        }

        // Create planner task card element
        function createPlannerTaskCard(task, dueDate) {
            const taskEl = document.createElement('div');
            taskEl.className = 'planner-task-card';
            taskEl.dataset.priority = task.priority || 'Medium';
            taskEl.dataset.taskId = task.id;
            
            // Calculate position based on time
            const startHour = dueDate.getHours() + dueDate.getMinutes() / 60;
            const duration = 1; // Default 1 hour for tasks
            
            const top = startHour * 60; // 60px per hour
            const height = duration * 60;
            
            taskEl.style.top = top + 'px';
            taskEl.style.height = height + 'px';
            
            // Format time
            const timeFormatter = new Intl.DateTimeFormat('en-US', {
                timeZone: userTimeZone,
                hour: 'numeric',
                minute: '2-digit',
                hour12: true
            });
            
            const priorityClass = task.priority ? `priority-${task.priority.toLowerCase()}` : 'priority-medium';
            
            taskEl.innerHTML = `
                <div class="task-time">
                    <i class="fa-solid fa-bars-progress" style="font-size: 0.7rem;"></i>
                    ${timeFormatter.format(dueDate)}
                </div>
                <div class="task-title">${task.title}</div>
                <div class="task-meta">
                    ${task.priority ? `<span class="task-priority-badge ${priorityClass}">${task.priority}</span>` : ''}
                    ${task.matterTitle ? `<span class="task-matter-badge" title="${task.matterTitle}">${task.matterTitle}</span>` : ''}
                </div>
            `;
            
            taskEl.addEventListener('click', (e) => {
                e.stopPropagation();
                openTaskModal(task.id);
            });
            
            return taskEl;
        }

        // Open task modal - redirects to tasks page with modal open
        function openTaskModal(taskId) {
            window.location.href = `/Client/${orgId}/Tasks?taskId=${taskId}`;
        }

        // Create planner event element
        function createPlannerEventElement(event, startTime, endTime) {
            const eventEl = document.createElement('div');
            eventEl.className = `planner-event ${event.color || 'blue'}`;
            
            // Calculate position based on time
            const startHour = startTime.getHours() + startTime.getMinutes() / 60;
            const endHour = endTime.getHours() + endTime.getMinutes() / 60;
            const duration = Math.max(0.5, endHour - startHour); // Minimum 30 min display
            
            const top = startHour * 60; // 60px per hour
            const height = duration * 60;
            
            eventEl.style.top = top + 'px';
            eventEl.style.height = height + 'px';
            
            // Format time
            const timeFormatter = new Intl.DateTimeFormat('en-US', {
                timeZone: userTimeZone,
                hour: 'numeric',
                minute: '2-digit',
                hour12: true
            });
            
            eventEl.innerHTML = `
                <div class="event-time">${timeFormatter.format(startTime)}</div>
                <div class="event-title">${event.title}</div>
            `;
            
            eventEl.addEventListener('click', (e) => {
                e.stopPropagation();
                openEventModal(event.id);
            });
            
            return eventEl;
        }

        // Update current time indicator
        function updateCurrentTimeIndicator() {
            // Remove existing indicator
            document.querySelectorAll('.current-time-indicator').forEach(el => el.remove());
            
            const now = new Date();
            
            // Only show if today is visible
            let showIndicator = false;
            let columnIndex = -1;
            
            if (currentView === 'day') {
                showIndicator = isToday(currentViewDate);
                columnIndex = 0;
            } else {
                const weekStart = getWeekStart(currentViewDate);
                for (let i = 0; i < 7; i++) {
                    const columnDate = new Date(weekStart);
                    columnDate.setDate(columnDate.getDate() + i);
                    if (isToday(columnDate)) {
                        showIndicator = true;
                        columnIndex = i;
                        break;
                    }
                }
            }
            
            if (showIndicator && columnIndex >= 0) {
                const plannerColumns = document.getElementById('plannerColumns');
                const column = plannerColumns.querySelector(`.calendar-column[data-day="${columnIndex}"]`);
                
                if (column) {
                    const indicator = document.createElement('div');
                    indicator.className = 'current-time-indicator';
                    
                    const currentHour = now.getHours() + now.getMinutes() / 60;
                    indicator.style.top = (currentHour * 60) + 'px';
                    
                    column.appendChild(indicator);
                }
            }
            
            // Update every minute
            setTimeout(updateCurrentTimeIndicator, 60000);
        }

        // Initialize modal handlers
        let modalHandlersInitialized = false;
        function initializeModalHandlers() {
            // Prevent multiple initializations
            if (modalHandlersInitialized) {
                return;
            }
            
            const modal = document.getElementById('calendarEventModal');
            const closeBtn = document.getElementById('closeEventModal');
            const saveBtn = document.getElementById('saveEventBtn');
            const headerDeleteBtn = document.getElementById('headerDeleteBtn');
            const addAttendeeBtn = document.getElementById('addAttendeeBtn');
            const allDayCheckbox = document.getElementById('eventAllDayCheck');

            // Close modal
            if (closeBtn) closeBtn.addEventListener('click', closeEventModal);

            // Click outside to close
            if (modal) {
            modal.addEventListener('click', function(e) {
                if (e.target === modal) {
                    closeEventModal();
                }
            });
            }

            // Save event
            if (saveBtn) saveBtn.addEventListener('click', saveEvent);
            
            modalHandlersInitialized = true;

            // Delete event
            if (headerDeleteBtn) headerDeleteBtn.addEventListener('click', deleteEvent);

            // Add attendee
            if (addAttendeeBtn) {
                addAttendeeBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    showAttendeePopup();
                });
            }

            // All-day checkbox toggle
            if (allDayCheckbox) {
            allDayCheckbox.addEventListener('change', function() {
                    const startInput = document.getElementById('eventStartInput');
                    const endInput = document.getElementById('eventEndInput');
                
                if (this.checked) {
                    // Convert to date-only inputs
                    startInput.type = 'date';
                    endInput.type = 'date';
                } else {
                    // Convert back to datetime-local
                    startInput.type = 'datetime-local';
                    endInput.type = 'datetime-local';
                }
            });
            }

            // Auto-adjust end date when start date changes
            const startInput = document.getElementById('eventStartInput');
            const endInput = document.getElementById('eventEndInput');
            if (startInput && endInput) {
                startInput.addEventListener('change', function() {
                    if (!this.value) return;
                    
                    const isAllDay = document.getElementById('eventAllDayCheck').checked;
                    const startValue = this.value;
                    
                    if (isAllDay) {
                        // For all-day events, end date is same as start date
                        endInput.value = startValue;
                    } else {
                        // For timed events, add 1 hour to start time
                        const startDate = new Date(startValue);
                        const endDate = new Date(startDate.getTime() + 60 * 60 * 1000); // Add 1 hour
                        endInput.value = toLocalISOString(endDate).slice(0, 16);
                    }
                });
            }

            // Color picker
            const colorOptions = document.querySelectorAll('.color-option');
            colorOptions.forEach(option => {
                option.addEventListener('click', function() {
                    // Remove selected from all
                    colorOptions.forEach(opt => opt.classList.remove('selected'));
                    // Add selected to this one
                    this.classList.add('selected');
                    // Update color indicator
                    const color = this.dataset.color;
                    updateEventColorIndicator(color);
                });
            });

            // Collapsible sections toggle
            const collapsibleHeaders = document.querySelectorAll('.collapsible-header');
            collapsibleHeaders.forEach(header => {
                const section = header.closest('.collapsible-section');
                const content = section.querySelector('.task-section-content');
                
                // Function to expand section permanently
                function expandSection() {
                    section.classList.add('expanded');
                    section.classList.remove('hover-disabled');
                    content.style.display = 'block';
                }
                
                // Function to collapse section
                function collapseSection() {
                    section.classList.remove('expanded');
                    section.classList.add('hover-disabled');
                    content.style.display = 'none';
                }
                
                // Click handler for actual expansion/collapse
                header.addEventListener('click', function() {
                    if (section.classList.contains('expanded')) {
                        collapseSection();
                    } else {
                        expandSection();
                    }
                });
                
                // Click handler for content - expand section when clicking inside
                content.addEventListener('click', function(e) {
                    // Only expand if this is a real user click (not programmatic)
                    if (e.isTrusted && !section.classList.contains('expanded')) {
                        expandSection();
                    }
                });
                
                // Hover handlers for preview behavior with delay
                let hoverTimeout;
                
                // Handle hover on the entire section (header and content)
                section.addEventListener('mouseenter', function() {
                    // Only show content if section is not already expanded AND hover is not disabled
                    if (!section.classList.contains('expanded') && !section.classList.contains('hover-disabled')) {
                        // Set timeout for 1 second delay
                        hoverTimeout = setTimeout(function() {
                            content.style.display = 'block';
                        }, 150);
                    }
                });
                
                section.addEventListener('mouseleave', function() {
                    // Clear the timeout if mouse leaves before delay completes
                    clearTimeout(hoverTimeout);
                    // Only hide content if section is not actually expanded
                    if (!section.classList.contains('expanded')) {
                        content.style.display = 'none';
                    }
                    // Re-enable hover effects when mouse leaves
                    section.classList.remove('hover-disabled');
                });
            });
        }

        // Update event color (only updates icon color now)
        function updateEventColorIndicator(color) {
            const colorMap = {
                blue: '#2563eb',
                purple: '#8b5cf6',
                red: '#ef4444',
                green: '#10b981',
                orange: '#f59e0b',
                gray: '#6b7280'
            };
            const icon = document.getElementById('eventTitleIcon');
            if (icon) {
                icon.style.color = colorMap[color] || colorMap.blue;
            }
        }

        // Open event modal (create or edit)
        async function openEventModal(eventId = null, startTime = null) {
            currentEventId = eventId;
            eventAttendees = [];
            let selectedColor = 'blue';
            
            const modal = document.getElementById('calendarEventModal');
            const headerDeleteBtn = document.getElementById('headerDeleteBtn');
            const titleInput = document.getElementById('eventTitleInput');
            
            // Clear form
            titleInput.textContent = '';
            document.getElementById('eventDescriptionInput').value = '';
            document.getElementById('eventTypeField').value = 'Meeting';
            document.getElementById('eventMatterSelectorBtn').dataset.selectedMatterId = '';
            document.getElementById('eventMatterSelectorText').textContent = selectMatterText;
            clearEventLocation(); // Clear location using new function
            document.getElementById('eventAllDayCheck').checked = false;
            document.getElementById('eventAttendeesList').innerHTML = '';
            
            // Reset metadata
            document.getElementById('eventCreatedDate').textContent = '--';
            document.getElementById('eventCreatedBy').textContent = '--';
            document.getElementById('eventModifiedDate').textContent = '--';
            document.getElementById('eventModifiedBy').textContent = '--';
            
            if (eventId) {
                // Edit mode - load event data
                headerDeleteBtn.style.display = 'block';
                
                try {
                    const response = await fetch(`/Client/${orgId}/Calendar/Events/${eventId}`, {
                        credentials: 'include'
                    });
                    const result = await response.json();
                    
                    if (result.success) {
                        const event = result.event;
                        titleInput.textContent = event.title;
                        document.getElementById('eventDescriptionInput').value = event.description || '';
                        document.getElementById('eventTypeField').value = event.eventType;
                        
                        // Set matter selector
                        const matterId = event.matterId || '';
                        document.getElementById('eventMatterSelectorBtn').dataset.selectedMatterId = matterId;
                        if (matterId) {
                            const selectedMatter = allMatters.find(m => m.id == matterId);
                            if (selectedMatter) {
                                document.getElementById('eventMatterSelectorText').textContent = selectedMatter.title;
                            } else {
                                document.getElementById('eventMatterSelectorText').textContent = selectMatterText;
                            }
                        } else {
                            document.getElementById('eventMatterSelectorText').textContent = selectMatterText;
                        }
                        
                        // Set location data using new function
                        if (event.location) {
                            try {
                                const locationData = JSON.parse(event.location);
                                setEventLocationData(locationData);
                            } catch (e) {
                                // If location is not JSON (old format), clear it
                                console.warn('Event location is not in JSON format:', event.location);
                                clearEventLocation();
                            }
                        } else {
                            clearEventLocation();
                        }
                        
                        document.getElementById('eventAllDayCheck').checked = event.isAllDayEvent;
                        
                        // Set color
                        selectedColor = event.color;
                        document.querySelectorAll('.color-option').forEach(opt => {
                            if (opt.dataset.color === selectedColor) {
                                opt.classList.add('selected');
                            } else {
                                opt.classList.remove('selected');
                            }
                        });
                        updateEventColorIndicator(selectedColor);
                        
                        // Set dates - convert from UTC to user's timezone
                        const startInput = document.getElementById('eventStartInput');
                        const endInput = document.getElementById('eventEndInput');
                        
                        if (event.isAllDayEvent) {
                            startInput.type = 'date';
                            endInput.type = 'date';
                            // For all-day events, use the date as-is without timezone conversion
                            startInput.value = event.startDateTime.split('T')[0];
                            endInput.value = event.endDateTime.split('T')[0];
                        } else {
                            startInput.type = 'datetime-local';
                            endInput.type = 'datetime-local';
                            // Convert UTC to user's timezone for datetime-local inputs
                            startInput.value = convertUTCToLocalInput(event.startDateTime);
                            endInput.value = convertUTCToLocalInput(event.endDateTime);
                        }
                        
                        // Load attendees - map from server format to client format
                        eventAttendees = (event.attendees || []).map(a => ({
                            userId: a.userId,
                            name: a.user ? `${a.user.firstName} ${a.user.lastName}` : 'Unknown',
                            initials: a.user ? a.user.initials : '??',
                            attendeeType: a.attendeeType
                        }));
                        renderAttendees();
                        
                        // Set metadata
                        if (event.createdAt) {
                            const createdDate = new Date(event.createdAt);
                            document.getElementById('eventCreatedDate').textContent = createdDate.toLocaleString();
                        }
                        if (event.createdBy) {
                            document.getElementById('eventCreatedBy').textContent = event.createdBy.fullName || 'Unknown';
                        }
                        if (event.modifiedAt) {
                            const modifiedDate = new Date(event.modifiedAt);
                            document.getElementById('eventModifiedDate').textContent = modifiedDate.toLocaleString();
                        }
                        if (event.modifiedBy) {
                            document.getElementById('eventModifiedBy').textContent = event.modifiedBy.fullName || 'Unknown';
                        }
                    }
                } catch (error) {
                    console.error('Error loading event:', error);
                }
            } else {
                // Create mode
                headerDeleteBtn.style.display = 'none';
                
                // Set default color to blue
                document.querySelector('.color-option[data-color="blue"]')?.classList.add('selected');
                updateEventColorIndicator('blue');
                
                // Set date/time - use provided startTime or default to now
                const eventStartTime = startTime || new Date();
                const startInput = document.getElementById('eventStartInput');
                const endInput = document.getElementById('eventEndInput');
                // Convert to user's timezone format
                startInput.value = convertUTCToLocalInput(eventStartTime.toISOString());
                const oneHourLater = new Date(eventStartTime.getTime() + 60 * 60 * 1000);
                endInput.value = convertUTCToLocalInput(oneHourLater.toISOString());
                
                // Add current user as default attendee
                const currentUser = allUsers.find(u => u.id === currentUserId);
                if (currentUser) {
                    eventAttendees = [{
                        userId: currentUser.id,
                        name: currentUser.name,
                        initials: currentUser.initials,
                        attendeeType: 'Required'
                    }];
                    renderAttendees();
                }
            }
            
            modal.style.display = 'flex';
            titleInput.focus();
        }

        // Close event modal
        function closeEventModal() {
            document.getElementById('calendarEventModal').style.display = 'none';
            currentEventId = null;
            eventAttendees = [];
            clearEventLocation(); // Clear location data
        }

        // Save event (create or update)
        let isSavingEvent = false;
        async function saveEvent() {
            // Prevent duplicate submissions
            if (isSavingEvent) {
                console.log('Event save already in progress...');
                return;
            }
            
            // Get values
            const title = document.getElementById('eventTitleInput').textContent.trim();
            const description = document.getElementById('eventDescriptionInput').value;
            const eventType = document.getElementById('eventTypeField').value;
            const matterIdValue = document.getElementById('eventMatterSelectorBtn').dataset.selectedMatterId;
            const matterId = matterIdValue ? parseInt(matterIdValue) || null : null;
            
            // Get location data using the new function
            const locationData = getEventLocationData();
            const location = locationData ? JSON.stringify(locationData) : null;
            
            const isAllDayEvent = document.getElementById('eventAllDayCheck').checked;
            const startInput = document.getElementById('eventStartInput');
            const endInput = document.getElementById('eventEndInput');
            
            // Get selected color
            const selectedColorOption = document.querySelector('.color-option.selected');
            const color = selectedColorOption ? selectedColorOption.dataset.color : 'blue';
            
            // Validation
            if (!title) {
                alert('Please enter an event title');
                document.getElementById('eventTitleInput').focus();
                return;
            }
            
            if (!startInput.value || !endInput.value) {
                alert('Please select start and end dates');
                return;
            }
            
            const eventData = {
                title: title,
                description: description,
                eventType: eventType,
                color: color,
                matterId: matterId,
                location: location,
                isAllDayEvent: isAllDayEvent,
                startDateTime: convertLocalInputToUTC(startInput.value),
                endDateTime: convertLocalInputToUTC(endInput.value),
                attendeeUserIds: eventAttendees.map(a => a.userId)
            };
            
            isSavingEvent = true;
            
            try {
                let response;
                if (currentEventId) {
                    // Update existing event
                    response = await fetch(`/Client/${orgId}/Calendar/Events/${currentEventId}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify(eventData)
                    });
                } else {
                    // Create new event
                    response = await fetch(`/Client/${orgId}/Calendar/Events`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify(eventData)
                    });
                }
                
                const result = await response.json();
                
                if (result.success) {
                    closeEventModal();
                    await fetchAndRenderCalendar();
                } else {
                    alert('Error saving event: ' + result.message);
                }
            } catch (error) {
                console.error('Error saving event:', error);
                alert('Error saving event. Please try again.');
            } finally {
                isSavingEvent = false;
            }
        }

        // Delete event
        async function deleteEvent() {
            if (!confirm('Are you sure you want to delete this event?')) {
                return;
            }
            
            try {
                const response = await fetch(`/Client/${orgId}/Calendar/Events/${currentEventId}`, {
                    method: 'DELETE',
                    credentials: 'include'
                });
                
                const result = await response.json();
                
                if (result.success) {
                    closeEventModal();
                    await fetchAndRenderCalendar();
                } else {
                    alert('Error deleting event: ' + result.message);
                }
            } catch (error) {
                console.error('Error deleting event:', error);
                alert('Error deleting event. Please try again.');
            }
        }

        // Show attendee popup (same style as Task assignment popup)
        function showAttendeePopup() {
            const addAttendeeBtn = document.getElementById('addAttendeeBtn');
            if (!addAttendeeBtn) return;
            
            // Create popup container
            const popup = document.createElement('div');
            popup.className = 'event-attendee-popup';
            
            // Get button position
            const btnRect = addAttendeeBtn.getBoundingClientRect();
            
            // Position popup to the right of the button
            popup.style.cssText = `
                position: fixed;
                top: ${btnRect.top - 200}px;
                left: ${btnRect.right + 10}px;
                background: white;
                border-radius: 0.5rem;
                padding: 1rem;
                width: 400px;
                max-height: 500px;
                overflow-y: auto;
                box-shadow: 0 4px 20px rgba(0,0,0,0.15);
                border: 1px solid #dee2e6;
                z-index: 1100;
            `;
            
            // Clone current attendees
            const selectedUsers = [...eventAttendees];
            
            // Ensure current user is always in the list
            if (!selectedUsers.some(a => a.userId === currentUserId)) {
                const currentUser = allUsers.find(u => u.id === currentUserId);
                if (currentUser) {
                    selectedUsers.push({
                        userId: currentUser.id,
                        name: currentUser.name,
                        initials: currentUser.initials,
                        attendeeType: 'Required'
                    });
                }
            }
            
            popup.innerHTML = `
                <div class="mb-2">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-search me-2" style="color: #3d1019; font-size: 1rem;"></i>
                            <div>
                                <h6 class="fw-bold text-dark mb-0" style="font-size: 0.9rem;">Find attendees</h6>
                                <p class="text-muted mb-0" style="font-size: 0.75rem;">Search and select attendees for this event.</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="mb-2">
                    <label class="form-label fw-bold text-dark mb-1" style="font-size: 0.85rem;">Search Users</label>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control" id="attendeeUserSearch" placeholder="Search by name or email..." style="font-size: 0.875rem;">
                        <button class="btn btn-outline-secondary" type="button">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
                
                <div class="mb-2">
                    <label class="form-label fw-bold text-dark mb-1" style="font-size: 0.85rem;">Selected Attendees</label>
                    <div id="selectedAttendeesList" class="border rounded p-2" style="min-height: 50px; background-color: #f8f9fa; font-size: 0.875rem;">
                        <p class="text-muted mb-0 small">No attendees selected yet.</p>
                    </div>
                </div>
                
                <div class="mb-2">
                    <label class="form-label fw-bold text-dark mb-1" style="font-size: 0.85rem;">Available Users</label>
                    <div id="availableAttendeesList" class="border rounded" style="max-height: 10rem; overflow-y: auto; padding-left: 1.75rem;">
                        <!-- Users will be loaded here -->
                    </div>
                </div>
                
                <div class="d-flex justify-content-end mt-2">
                    <button class="btn btn-secondary btn-sm" id="attendeeCancel" style="border-radius: 0.5rem;">Cancel</button>
                    <button class="btn btn-primary btn-sm" id="attendeeDone" style="border-radius: 0.5rem; margin-left: 0.5rem;">Done</button>
                </div>
            `;
            
            document.body.appendChild(popup);
            
            const availableUsersList = popup.querySelector('#availableAttendeesList');
            const selectedUsersList = popup.querySelector('#selectedAttendeesList');
            const searchInput = popup.querySelector('#attendeeUserSearch');
            
            function renderUsers(filterText = '') {
                const filtered = allUsers.filter(u => 
                    !filterText || 
                    u.name.toLowerCase().includes(filterText.toLowerCase()) || 
                    (u.email && u.email.toLowerCase().includes(filterText.toLowerCase()))
                );
                
                availableUsersList.innerHTML = filtered.map(user => `
                    <div class="form-check user-item" style="padding: 0.4rem;">
                        <input class="form-check-input user-checkbox" type="checkbox" 
                               id="attendee_user_${user.id}" value="${user.id}"
                               ${selectedUsers.some(a => a.userId === user.id) ? 'checked' : ''}
                               ${user.id === currentUserId ? 'disabled' : ''}
                               style="margin-top: 0.75rem;">
                        <label class="form-check-label" for="attendee_user_${user.id}" style="cursor: pointer; font-size: 0.875rem;">
                            <strong>${user.name}${user.id === currentUserId ? ' (You)' : ''}</strong>
                            ${user.email ? `<small class="text-muted d-block" style="font-size: 0.75rem;">${user.email}</small>` : ''}
                        </label>
                    </div>
                `).join('');
                
                // Add checkbox event listeners
                availableUsersList.querySelectorAll('.user-checkbox').forEach(checkbox => {
                    checkbox.addEventListener('change', function() {
                        const userId = parseInt(this.value);
                        const user = allUsers.find(u => u.id === userId);
                        
                        if (this.checked) {
                            if (!selectedUsers.some(a => a.userId === userId)) {
                                selectedUsers.push({
                                    userId: userId,
                                    name: user.name,
                                    initials: user.initials,
                                    attendeeType: 'Required'
                                });
                            }
                        } else {
                            // Don't allow removing current user
                            if (userId === currentUserId) {
                                this.checked = true;
                                return;
                            }
                            const index = selectedUsers.findIndex(a => a.userId === userId);
                            if (index > -1) {
                                selectedUsers.splice(index, 1);
                            }
                        }
                        updateSelectedDisplay();
                    });
                });
            }
            
            function updateSelectedDisplay() {
                if (selectedUsers.length === 0) {
                    selectedUsersList.innerHTML = '<p class="text-muted mb-0" style="font-size: 0.75rem;">No attendees selected yet.</p>';
                } else {
                    selectedUsersList.innerHTML = selectedUsers.map(attendee => `
                        <span class="badge bg-primary me-1 mb-1" style="font-size: 0.75rem;">
                            ${attendee.name}${attendee.userId === currentUserId ? ' (You)' : ''}
                            ${attendee.userId !== currentUserId ? `<i class="fas fa-times ms-1" style="cursor: pointer;" data-user-id="${attendee.userId}"></i>` : ''}
                        </span>
                    `).join('');
                    
                    // Add remove handlers (except for current user)
                    selectedUsersList.querySelectorAll('.fa-times').forEach(icon => {
                        icon.addEventListener('click', function() {
                            const userId = parseInt(this.dataset.userId);
                            if (userId === currentUserId) return; // Don't allow removing current user
                            
                            const index = selectedUsers.findIndex(a => a.userId === userId);
                            if (index > -1) {
                                selectedUsers.splice(index, 1);
                            }
                            const checkbox = availableUsersList.querySelector(`#attendee_user_${userId}`);
                            if (checkbox) checkbox.checked = false;
                            updateSelectedDisplay();
                        });
                    });
                }
            }
            
            // Initialize display
            renderUsers();
            updateSelectedDisplay();
            
            // Search functionality
            searchInput.addEventListener('input', function() {
                renderUsers(this.value);
            });
            
            // Handle Done button
            popup.querySelector('#attendeeDone').addEventListener('click', function() {
                eventAttendees = selectedUsers;
                renderAttendees();
                popup.remove();
                document.removeEventListener('click', outsideClickHandler);
            });
            
            // Handle Cancel button
            popup.querySelector('#attendeeCancel').addEventListener('click', function() {
                popup.remove();
                document.removeEventListener('click', outsideClickHandler);
            });
            
            // Close on outside click
            const outsideClickHandler = function(e) {
                if (!popup.contains(e.target) && e.target !== addAttendeeBtn) {
                    popup.remove();
                    document.removeEventListener('click', outsideClickHandler);
                }
            };
            
            // Add click handler after a short delay to avoid immediate closing
            setTimeout(() => {
                document.addEventListener('click', outsideClickHandler);
            }, 100);
        }

        // Render attendees as avatars
        function renderAttendees() {
            const container = document.getElementById('eventAttendeesList');
            
            if (eventAttendees.length === 0) {
                container.innerHTML = '';
                return;
            }
            
            container.innerHTML = '';
            eventAttendees.forEach((attendee, index) => {
                const avatarEl = document.createElement('div');
                avatarEl.classList.add('assignee-avatar');
                const isCurrentUser = attendee.userId === currentUserId;
                avatarEl.title = `${attendee.name}${isCurrentUser ? ' (You)' : ''} (${attendee.attendeeType || 'Required'})`;
                avatarEl.innerHTML = `
                    ${attendee.initials || attendee.name.substring(0, 2).toUpperCase()}
                    ${!isCurrentUser ? `<span class="remove-assignee" data-index="${index}"><i class="fas fa-times"></i></span>` : ''}
                `;
                
                // Remove attendee handler (only if not current user)
                if (!isCurrentUser) {
                    const removeBtn = avatarEl.querySelector('.remove-assignee');
                    if (removeBtn) {
                        removeBtn.addEventListener('click', function(e) {
                            e.stopPropagation();
                            eventAttendees.splice(index, 1);
                            renderAttendees();
                        });
                    }
                }
                
                container.appendChild(avatarEl);
            });
        }

        // Helper function to convert Date to local ISO string
        function toLocalISOString(date) {
            const offset = date.getTimezoneOffset();
            const localDate = new Date(date.getTime() - offset * 60 * 1000);
            return localDate.toISOString();
        }
    </script>

    @if (ViewBag.GoogleMapsEnabled == true && !string.IsNullOrEmpty(ViewBag.GoogleMapsApiKey))
    {
        <script>
            // Google Maps initialization callback must be defined before async load
            window.initGoogleMapsCalendar = function() {
                try {
                    console.log('Google Maps API loaded successfully for Calendar');
                    window.googleMapsReady = true;
                    setTimeout(function() {
                        if (typeof initializeEventLocationSearch === 'function') {
                            initializeEventLocationSearch();
                        } else {
                            console.warn('initializeEventLocationSearch function not found');
                        }
                    }, 100);
                } catch (err) {
                    console.error('Error in initGoogleMapsCalendar:', err);
                }
            }
        </script>
        <script src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey&libraries=places&callback=initGoogleMapsCalendar" async defer></script>
    }

    <script>
        // Event Location Search functionality
        let eventPlacesSessionToken = null;
        let currentEventLocationData = null;
        let eventLocationSearchInitialized = false;

        // Initialize Google Places Autocomplete for Event modal
        function initializeEventLocationSearch() {
            console.log('Initializing event location search...');
            
            // Prevent multiple initializations
            if (eventLocationSearchInitialized) {
                console.log('Event location search already initialized');
                return;
            }
            
            const searchInput = document.getElementById('eventLocationSearchInput');
            
            if (!searchInput) {
                console.error('Event location search input not found');
                return;
            }
            
            if (!window.google || !google.maps.places) {
                console.warn('Google Maps API not loaded yet for events, retrying...');
                setTimeout(initializeEventLocationSearch, 1000);
                return;
            }

            console.log('Google Maps API is ready for events, setting up location search');
            eventLocationSearchInitialized = true;
            searchInput.disabled = false;
            searchInput.placeholder = 'Start typing a location...';

            // Handle typing and show custom dropdown
            let typingTimeout = null;
            searchInput.addEventListener('input', function() {
                clearTimeout(typingTimeout);
                const query = this.value.trim();
                console.log('Event location search input:', query);
                
                if (query.length > 2) {
                    if (!eventPlacesSessionToken || query.length === 3) {
                        eventPlacesSessionToken = new google.maps.places.AutocompleteSessionToken();
                    }
                    typingTimeout = setTimeout(() => {
                        console.log('Triggering autocomplete for event:', query);
                        showEventAutocomplete(query);
                    }, 300);
                } else {
                    hideEventAutocompleteDropdown();
                }
            });

            // Handle keyboard navigation
            searchInput.addEventListener('keydown', handleEventKeyboardNavigation);

            // Click outside to close dropdown
            document.addEventListener('click', function(e) {
                if (!e.target.closest('#eventLocationSearchInput') && !e.target.closest('#eventAutocompleteDropdown')) {
                    hideEventAutocompleteDropdown();
                }
            });

            // Initialize event location action buttons
            initializeEventLocationActions();
        }

        // Show event autocomplete dropdown
        function showEventAutocomplete(query) {
            const dropdown = document.getElementById('eventAutocompleteDropdown');
            const list = document.getElementById('eventAutocompleteList');
            const loadingIndicator = document.getElementById('eventSearchLoadingIndicator');
            
            if (!dropdown || !list || !query) {
                console.warn('Missing event autocomplete elements or empty query');
                return;
            }

            loadingIndicator.style.display = 'block';

            // Use Places API to get suggestions
            const service = new google.maps.places.AutocompleteService();
            
            service.getPlacePredictions({
                input: query,
                types: ['establishment', 'geocode'],
                sessionToken: eventPlacesSessionToken
            }, function(predictions, status) {
                loadingIndicator.style.display = 'none';
                
                if (status === google.maps.places.PlacesServiceStatus.OK && predictions) {
                    populateEventAutocompleteDropdown(predictions);
                    showEventAutocompleteDropdown();
                } else if (status === google.maps.places.PlacesServiceStatus.REQUEST_DENIED) {
                    console.error('Places API request denied for events.');
                    hideEventAutocompleteDropdown();
                } else {
                    console.log('No predictions or error for events. Status:', status);
                    hideEventAutocompleteDropdown();
                }
            });
        }

        // Populate event autocomplete dropdown
        function populateEventAutocompleteDropdown(predictions) {
            const list = document.getElementById('eventAutocompleteList');
            if (!list) return;

            list.innerHTML = '';
            
            predictions.slice(0, 5).forEach((prediction) => {
                const item = document.createElement('li');
                item.className = 'autocomplete-item';
                item.dataset.placeId = prediction.place_id;
                item.dataset.prediction = prediction.description;
                
                // Extract primary and secondary text
                const description = prediction.description;
                const commaIndex = description.indexOf(', ');
                const primaryText = commaIndex > -1 ? description.substring(0, commaIndex) : description;
                const secondaryText = commaIndex > -1 ? description.substring(commaIndex + 2) : '';
                
                item.innerHTML = `
                    <div class="autocomplete-icon">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <div class="autocomplete-text">
                        <div class="autocomplete-primary-text">${primaryText}</div>
                        ${secondaryText ? `<div class="autocomplete-secondary-text">${secondaryText}</div>` : ''}
                    </div>
                `;
                
                // Handle click selection
                item.addEventListener('click', function() {
                    selectEventLocationFromDropdown(prediction);
                });
                
                // Handle keyboard navigation
                item.addEventListener('mouseenter', function() {
                    clearActiveEventAutocompleteItem();
                    this.classList.add('active');
                });
                
                list.appendChild(item);
            });
        }

        // Handle autocomplete selection from dropdown
        function selectEventLocationFromDropdown(prediction) {
            const searchInput = document.getElementById('eventLocationSearchInput');
            searchInput.value = prediction.description;
            
            // Get place details
            const service = new google.maps.places.PlacesService(document.createElement('div'));
            service.getDetails({
                placeId: prediction.place_id,
                fields: ['name', 'formatted_address', 'geometry'],
                sessionToken: eventPlacesSessionToken
            }, function(place, status) {
                hideEventAutocompleteDropdown();
                
                if (status === google.maps.places.PlacesServiceStatus.OK) {
                    displayEventLocationFromPlace(place);
                    eventPlacesSessionToken = null; // reset after successful selection
                } else {
                    console.error('Could not load event location details');
                }
            });
        }

        // Display event location from Google Place object
        function displayEventLocationFromPlace(place) {
            const locationDisplay = document.getElementById('eventLocationDisplay');
            const locationName = document.getElementById('eventLocationName');
            const locationAddress = document.getElementById('eventLocationAddress');

            // Update location info
            locationName.textContent = place.name || 'Selected Location';
            locationAddress.textContent = place.formatted_address;

            // Show location display
            locationDisplay.style.display = 'flex';

            // Store the full location data globally for saving
            currentEventLocationData = {
                name: place.name || 'Selected Location',
                address: place.formatted_address,
                formatted_address: place.formatted_address,
                place_id: place.place_id,
                geometry: {
                    location: {
                        lat: place.geometry.location.lat(),
                        lng: place.geometry.location.lng()
                    }
                }
            };

            // Load embedded map
            loadEventEmbeddedMap(place.geometry.location, place.name || 'Location', place.formatted_address);
        }

        // Load embedded Google Map for event
        function loadEventEmbeddedMap(location, name, address) {
            const mapContainer = document.getElementById('eventMapContainer');
            
            // Create map URL for embedded display
            const locationStr = location.lat() + ',' + location.lng();
            const encodedName = encodeURIComponent(name);
            const encodedAddress = encodeURIComponent(address);
            
            const mapUrl = `https://maps.google.com/maps?q=${encodedName}|${encodedAddress}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
            
            // Create iframe for embedded map
            mapContainer.innerHTML = `
                <iframe 
                    class="embedded-map loaded"
                    src="${mapUrl}"
                    frameborder="0"
                    allowfullscreen>
                </iframe>
            `;
        }

        // Load embedded map from stored location data (for existing events)
        function loadEventEmbeddedMapFromData(location, name, address) {
            const mapContainer = document.getElementById('eventMapContainer');
            
            if (!mapContainer) return;
            
            // Create map URL for embedded display
            const locationStr = location.lat + ',' + location.lng;
            const encodedName = encodeURIComponent(name);
            const encodedAddress = encodeURIComponent(address);
            
            const mapUrl = `https://maps.google.com/maps?q=${encodedName}|${encodedAddress}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
            
            // Create iframe for embedded map
            mapContainer.innerHTML = `
                <iframe 
                    class="embedded-map loaded"
                    src="${mapUrl}"
                    frameborder="0"
                    allowfullscreen>
                </iframe>
            `;
        }

        // Initialize event location action buttons
        function initializeEventLocationActions() {
            // Remove location button
            const removeLocationBtn = document.getElementById('eventRemoveLocationBtn');
            if (removeLocationBtn) {
                removeLocationBtn.addEventListener('click', function() {
                    removeEventLocation();
                });
            }

            // Get directions button
            const directionsBtn = document.getElementById('eventGetDirectionsBtn');
            if (directionsBtn) {
                directionsBtn.addEventListener('click', function() {
                    const locationName = document.getElementById('eventLocationName')?.textContent;
                    const locationAddress = document.getElementById('eventLocationAddress')?.textContent;
                    
                    if (locationName && locationAddress) {
                        const searchQuery = encodeURIComponent(`${locationName}, ${locationAddress}`);
                        window.open(`https://www.google.com/maps/dir/?api=1&destination=${searchQuery}`, '_blank');
                    }
                });
            }
        }

        // Remove event location
        function removeEventLocation() {
            const locationDisplay = document.getElementById('eventLocationDisplay');
            const mapContainer = document.getElementById('eventMapContainer');
            const searchInput = document.getElementById('eventLocationSearchInput');
            
            // Hide location display
            if (locationDisplay) locationDisplay.style.display = 'none';
            
            // Reset map container
            if (mapContainer) {
                mapContainer.innerHTML = `
                    <div class="map-placeholder">
                        <i class="fas fa-map-marked-alt" style="font-size: 3rem; color: #d1d5db;"></i>
                        <p class="text-muted mt-2">No location selected</p>
                        <small class="text-muted">Search for a location to display it on the map</small>
                    </div>
                `;
            }
            
            // Clear search input
            if (searchInput) searchInput.value = '';
            
            // Clear location data
            currentEventLocationData = null;
        }

        // Handle keyboard navigation in event autocomplete
        function handleEventKeyboardNavigation(e) {
            const dropdown = document.getElementById('eventAutocompleteDropdown');
            const list = document.getElementById('eventAutocompleteList');
            
            if (!dropdown || !list || dropdown.style.display === 'none') return;

            const items = list.querySelectorAll('.autocomplete-item');
            const activeItem = list.querySelector('.autocomplete-item.active');
            let nextActiveIndex = -1;

            switch (e.key) {
                case 'ArrowDown':
                    e.preventDefault();
                    nextActiveIndex = activeItem ? Array.from(items).indexOf(activeItem) + 1 : 0;
                    break;
                case 'ArrowUp':
                    e.preventDefault();
                    nextActiveIndex = activeItem ? Array.from(items).indexOf(activeItem) - 1 : items.length - 1;
                    break;
                case 'Enter':
                    e.preventDefault();
                    if (activeItem) {
                        activeItem.click();
                    }
                    return;
                case 'Escape':
                    e.preventDefault();
                    hideEventAutocompleteDropdown();
                    return;
                default:
                    return;
            }

            if (nextActiveIndex >= 0 && nextActiveIndex < items.length) {
                clearActiveEventAutocompleteItem();
                items[nextActiveIndex].classList.add('active');
            }
        }

        // Clear active event autocomplete item
        function clearActiveEventAutocompleteItem() {
            const activeItem = document.querySelector('#eventAutocompleteList .autocomplete-item.active');
            if (activeItem) {
                activeItem.classList.remove('active');
            }
        }

        // Show event autocomplete dropdown
        function showEventAutocompleteDropdown() {
            const dropdown = document.getElementById('eventAutocompleteDropdown');
            if (dropdown) {
                dropdown.style.display = 'block';
            }
        }

        // Hide event autocomplete dropdown
        function hideEventAutocompleteDropdown() {
            const dropdown = document.getElementById('eventAutocompleteDropdown');
            if (dropdown) {
                dropdown.style.display = 'none';
            }
            clearActiveEventAutocompleteItem();
        }

        // Get event location data for saving
        function getEventLocationData() {
            const locationDisplay = document.getElementById('eventLocationDisplay');
            const locationName = document.getElementById('eventLocationName');
            const locationAddress = document.getElementById('eventLocationAddress');
            
            // Check if location is selected
            if (locationDisplay && locationDisplay.style.display !== 'none' && locationName && locationAddress) {
                return {
                    name: locationName.textContent || '',
                    address: locationAddress.textContent || '',
                    formatted_address: locationAddress.textContent || '',
                    place_id: currentEventLocationData?.place_id || null,
                    geometry: currentEventLocationData?.geometry || null
                };
            }
            
            return null;
        }

        // Set event location data (for loading existing events)
        function setEventLocationData(locationData) {
            if (!locationData) return;
            
            const locationDisplay = document.getElementById('eventLocationDisplay');
            const locationName = document.getElementById('eventLocationName');
            const locationAddress = document.getElementById('eventLocationAddress');
            const locationInput = document.getElementById('eventLocationSearchInput');
            
            if (locationDisplay && locationName && locationAddress) {
                locationName.textContent = locationData.name || '';
                locationAddress.textContent = locationData.address || locationData.formatted_address || '';
                locationDisplay.style.display = 'flex';
                
                // Store the location data globally for map display
                currentEventLocationData = locationData;
                
                // Load the map if we have coordinates
                if (locationData.geometry && locationData.geometry.location) {
                    loadEventEmbeddedMapFromData(locationData.geometry.location, locationData.name, locationData.address || locationData.formatted_address);
                }
                
                // Update the search input
                if (locationInput) {
                    locationInput.value = locationData.name || '';
                }
            }
        }

        // Clear event location (for modal reset)
        function clearEventLocation() {
            const locationInput = document.getElementById('eventLocationSearchInput');
            const locationDisplay = document.getElementById('eventLocationDisplay');
            const mapContainer = document.getElementById('eventMapContainer');
            
            if (locationInput) locationInput.value = '';
            if (locationDisplay) locationDisplay.style.display = 'none';
            if (mapContainer) {
                mapContainer.innerHTML = `
                    <div class="map-placeholder">
                        <i class="fas fa-map-marked-alt" style="font-size: 3rem; color: #d1d5db;"></i>
                        <p class="text-muted mt-2">No location selected</p>
                        <small class="text-muted">Search for a location to display it on the map</small>
                    </div>
                `;
            }
            
            currentEventLocationData = null;
        }

        // Make functions globally available
        window.initializeEventLocationSearch = initializeEventLocationSearch;
        window.getEventLocationData = getEventLocationData;
        window.setEventLocationData = setEventLocationData;
        window.clearEventLocation = clearEventLocation;

        // Try to initialize on DOM ready if Google Maps is already loaded
        if (window.google && google.maps && google.maps.places) {
            initializeEventLocationSearch();
        }
    </script>

    <script>
        // Calendar Integration OAuth handling
        (function() {
            // Load calendar integrations status on page load
            async function loadCalendarIntegrationsStatus() {
                try {
                    const url = orgId ? `/api/calendar-oauth/status?orgId=${orgId}` : '/api/calendar-oauth/status';
                    const response = await fetch(url, {
                        credentials: 'include'
                    });
                    const result = await response.json();
                    
                    if (result.success && result.integrations) {
                        displayCalendarIntegrations(result.integrations);
                    }
                } catch (error) {
                    console.error('Error loading calendar integrations:', error);
                }
            }

            // Display calendar integration status
            function displayCalendarIntegrations(integrations) {
                const hasGoogle = integrations.some(i => i.provider === 'Google');
                const hasOutlook = integrations.some(i => i.provider === 'Outlook');
                const hasAnyConnection = hasGoogle || hasOutlook;

                const notConnectedDiv = document.getElementById('calendarIntegrationsNotConnected');
                const connectedDiv = document.getElementById('calendarIntegrationsConnected');
                const googleStatus = document.getElementById('googleCalendarStatus');
                const outlookStatus = document.getElementById('outlookCalendarStatus');
                const googleConnectBtn = document.getElementById('connectGoogleCalendarBtnConnected');
                const outlookConnectBtn = document.getElementById('connectOutlookCalendarBtnConnected');

                // Move the Calendar Integrations card to the bottom if at least one is connected
                const integrationsCard = document.getElementById('calendarIntegrationsCard');
                const upcomingEventsCard = document.getElementById('upcomingEventsCard');
                const sidebarContent = document.querySelector('.global-dashboard-content');
                
                if (hasAnyConnection && integrationsCard && upcomingEventsCard && sidebarContent) {
                    // Move integrations card after upcoming events card and add top margin
                    if (integrationsCard.nextElementSibling !== null) {
                        sidebarContent.appendChild(integrationsCard);
                        integrationsCard.style.marginTop = '1rem';
                    }
                } else if (!hasAnyConnection && integrationsCard && upcomingEventsCard && sidebarContent) {
                    // Move integrations card before upcoming events card and remove top margin
                    if (integrationsCard.nextElementSibling !== upcomingEventsCard) {
                        sidebarContent.insertBefore(integrationsCard, upcomingEventsCard);
                        integrationsCard.style.marginTop = '0';
                    }
                }

                if (hasAnyConnection) {
                    notConnectedDiv.style.display = 'none';
                    connectedDiv.style.display = 'block';

                    if (hasGoogle) {
                        const googleIntegration = integrations.find(i => i.provider === 'Google');
                        googleStatus.style.display = 'block';
                        googleConnectBtn.style.display = 'none';
                        document.getElementById('googleCalendarEmail').textContent = googleIntegration.email || '';
                    } else {
                        googleStatus.style.display = 'none';
                        googleConnectBtn.style.display = 'block';
                    }

                    if (hasOutlook) {
                        const outlookIntegration = integrations.find(i => i.provider === 'Outlook');
                        outlookStatus.style.display = 'block';
                        outlookConnectBtn.style.display = 'none';
                        document.getElementById('outlookCalendarEmail').textContent = outlookIntegration.email || '';
                    } else {
                        outlookStatus.style.display = 'none';
                        outlookConnectBtn.style.display = 'block';
                    }
                } else {
                    notConnectedDiv.style.display = 'block';
                    connectedDiv.style.display = 'none';
                }
            }

            // Handle OAuth popup
            function openOAuthPopup(provider) {
                const endpoint = provider === 'Google' 
                    ? '/api/calendar-oauth/google/authorize' 
                    : '/api/calendar-oauth/outlook/authorize';

                fetch(endpoint + `?orgId=${orgId}`, {
                    credentials: 'include'
                })
                .then(response => response.json())
                .then(result => {
                    if (result.success && result.authorizationUrl) {
                        const width = 600;
                        const height = 700;
                        const left = (screen.width / 2) - (width / 2);
                        const top = (screen.height / 2) - (height / 2);
                        
                        const popup = window.open(
                            result.authorizationUrl,
                            'CalendarOAuth',
                            `width=${width},height=${height},top=${top},left=${left},toolbar=no,menubar=no`
                        );

                        if (!popup) {
                            alert('Please allow popups for this site to connect your calendar');
                        }
                    } else {
                        alert('Error initiating OAuth: ' + (result.error || 'Unknown error'));
                    }
                })
                .catch(error => {
                    console.error('Error starting OAuth:', error);
                    alert('Error connecting calendar. Please try again.');
                });
            }

            // Handle disconnect
            async function disconnectCalendar(provider) {
                if (!confirm(`Are you sure you want to disconnect your ${provider} Calendar?`)) {
                    return;
                }

                try {
                    const url = orgId ? `/api/calendar-oauth/disconnect?orgId=${orgId}` : '/api/calendar-oauth/disconnect';
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ provider: provider })
                    });

                    const result = await response.json();

                    if (result.success) {
                        await loadCalendarIntegrationsStatus();
                        await loadUnsyncedEventsCount();
                        // Refresh the calendar to remove synced events
                        await fetchAndRenderCalendar();
                    } else {
                        alert('Error disconnecting calendar: ' + (result.error || 'Unknown error'));
                    }
                } catch (error) {
                    console.error('Error disconnecting calendar:', error);
                    alert('Error disconnecting calendar. Please try again.');
                }
            }

            // Listen for OAuth completion messages
            window.addEventListener('message', function(event) {
                if (event.data && event.data.type === 'calendar-oauth-complete') {
                    console.log('Calendar OAuth completed:', event.data);
                    
                    if (event.data.success) {
                        // Reload integrations status
                        loadCalendarIntegrationsStatus();
                        // Reload unsynced events count
                        loadUnsyncedEventsCount();
                        // Refresh the calendar to show synced events
                        fetchAndRenderCalendar();
                    }
                }
            });

            // Load unsynced events count
            async function loadUnsyncedEventsCount() {
                try {
                    const orgId = getCurrentOrganizationId();
                    const response = await fetch(`/api/calendar-sync/unsynced-count?orgId=${orgId}`, {
                        credentials: 'include'
                    });
                    const result = await response.json();

                    if (result.success && result.hasIntegrations) {
                        updateNotalizeBadge(result.count);
                    } else {
                        updateNotalizeBadge(0);
                    }
                } catch (error) {
                    console.error('Error loading unsynced events count:', error);
                    updateNotalizeBadge(0);
                }
            }

            // Update the notalize badge
            function updateNotalizeBadge(count) {
                const badge = document.getElementById('notalizeBadge');
                const badgeCount = document.getElementById('notalizeBadgeCount');
                
                if (badge && badgeCount) {
                    if (count > 0) {
                        badgeCount.textContent = count;
                        badge.style.display = 'flex';
                    } else {
                        badge.style.display = 'none';
                    }
                }
            }

            // Handle Notalize button click
            async function handleNotalizeClick() {
                const notalizeBtn = document.getElementById('notalizeBtn');
                if (!notalizeBtn) return;

                // Disable button and show loading state
                notalizeBtn.disabled = true;
                const originalContent = notalizeBtn.innerHTML;
                notalizeBtn.innerHTML = '<i class="fas fa-spinner fa-spin" style="font-size: 24px;"></i>';

                try {
                    const orgId = getCurrentOrganizationId();
                    const response = await fetch('/api/calendar-sync/sync', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        credentials: 'include',
                        body: JSON.stringify({ orgId })
                    });

                    const result = await response.json();

                    if (result.success) {
                        // Show success message
                        alert(result.message);
                        
                        // Update badge count
                        updateNotalizeBadge(0);
                        
                        // Refresh calendar to show synced events
                        await fetchAndRenderCalendar();
                    } else {
                        alert(result.error || 'Failed to sync calendar events');
                    }
                } catch (error) {
                    console.error('Error syncing calendar events:', error);
                    alert('Failed to sync calendar events. Please try again.');
                } finally {
                    // Re-enable button and restore original content
                    notalizeBtn.disabled = false;
                    notalizeBtn.innerHTML = originalContent;
                }
            }

            // Initialize event handlers
            document.addEventListener('DOMContentLoaded', function() {
                // Load integrations status
                loadCalendarIntegrationsStatus();
                
                // Load unsynced events count
                loadUnsyncedEventsCount();

                // Notalize button
                const notalizeBtn = document.getElementById('notalizeBtn');
                if (notalizeBtn) {
                    notalizeBtn.addEventListener('click', handleNotalizeClick);
                }

                // Connect buttons (not connected state)
                const connectGoogleBtn = document.getElementById('connectGoogleCalendarBtn');
                const connectOutlookBtn = document.getElementById('connectOutlookCalendarBtn');

                if (connectGoogleBtn) {
                    connectGoogleBtn.addEventListener('click', function() {
                        openOAuthPopup('Google');
                    });
                }

                if (connectOutlookBtn) {
                    connectOutlookBtn.addEventListener('click', function() {
                        openOAuthPopup('Outlook');
                    });
                }

                // Connect buttons (connected state)
                const connectGoogleBtnConnected = document.getElementById('connectGoogleCalendarBtnConnected');
                const connectOutlookBtnConnected = document.getElementById('connectOutlookCalendarBtnConnected');

                if (connectGoogleBtnConnected) {
                    connectGoogleBtnConnected.addEventListener('click', function() {
                        openOAuthPopup('Google');
                    });
                }

                if (connectOutlookBtnConnected) {
                    connectOutlookBtnConnected.addEventListener('click', function() {
                        openOAuthPopup('Outlook');
                    });
                }

                // Disconnect buttons
                const disconnectGoogleBtn = document.getElementById('disconnectGoogleCalendarBtn');
                const disconnectOutlookBtn = document.getElementById('disconnectOutlookCalendarBtn');

                if (disconnectGoogleBtn) {
                    disconnectGoogleBtn.addEventListener('click', function() {
                        disconnectCalendar('Google');
                    });
                }

                if (disconnectOutlookBtn) {
                    disconnectOutlookBtn.addEventListener('click', function() {
                        disconnectCalendar('Outlook');
                    });
                }
            });
        })();
    </script>
}

