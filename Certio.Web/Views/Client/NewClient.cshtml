@model Certio.Web.ViewModels.NewClientFormViewModel
@{
    ViewData["Title"] = "New Client";
    Layout = "_ClientLayout";
}

<div class="min-h-screen py-8">
    <div class="container-fluid">
        <div class="mb-4">
            <a href="@Url.Action("Clients", "Client", new { orgId = ViewBag.OrganizationId ?? 0 })" class="btn btn-ghost d-flex align-items-center gap-2 text-decoration-none">
                <i class="fas fa-arrow-left"></i>
                Back to Clients
            </a>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info">@TempData["Info"]</div>
        }

        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-elegant border-0">
                    <div class="card-body p-4">
                        <h1 class="display-6 fw-bold text-dark mb-2">Add New Client</h1>
                        <p class="lead text-muted mb-4" style="font-size: 1.1rem;">Create a new client organization and assign your newly established client.</p>

                        <form asp-action="NewClient" asp-controller="Client" asp-route-orgId="@ViewBag.OrganizationId" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="mb-4">
                                <label asp-for="ClientOrganizationName" class="form-label fw-bold text-dark">Client Organization Name <span class="text-danger">*</span></label>
                                <input asp-for="ClientOrganizationName" class="form-control form-control-lg" placeholder="e.g., Acme Corporation" />
                                <span asp-validation-for="ClientOrganizationName" class="text-danger"></span>
                            </div>

                            @if (Model.AvailableExternalUsers.Any())
                            {
                                <!-- Search Box -->
                                <div class="mb-4">
                                    <div class="d-flex align-items-center mb-3">
                                        <i class="fas fa-search fs-4 me-3" style="color: #3d1019;"></i>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-1">Assign Client</h5>
                                            <p class="text-muted mb-0 small">Select the primary client who will be the owner of this organization</p>
                                        </div>
                                    </div>
                                    <div class="input-group">
                                        <input type="text" class="form-control form-control-lg" id="externalUserSearch" placeholder="Search by name or email...">
                                        <button class="btn btn-outline-secondary" type="button">
                                            <i class="fas fa-search"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- Available External Users List -->
                                <div id="availableUsersContainer" class="mb-4">
                                    <label class="form-label fw-bold text-dark">Select Client <span class="text-danger">*</span></label>
                                    <div id="availableUsersList" class="border rounded" style="max-height: 300px; overflow-y: auto; padding: 0.75rem;">
                                        @foreach (var user in Model.AvailableExternalUsers)
                                        {
                                            <div class="form-check user-item py-2 ps-4 pe-2" 
                                                 data-user-id="@user.Id" 
                                                 data-user-name="@user.Name" 
                                                 data-user-email="@user.Email"
                                                 data-user-role="@user.Role"
                                                 style="border-radius: 6px;">
                                                <input class="form-check-input user-radio" 
                                                       type="radio" 
                                                       name="SelectedExternalUserId" 
                                                       id="user_@user.Id" 
                                                       value="@user.Id"
                                                       required>
                                                <label class="form-check-label ms-2" for="user_@user.Id" style="cursor: pointer; width: 100%;">
                                                    <div class="d-flex align-items-center">
                                                        <div class="flex-grow-1">
                                                            <strong>@user.Name</strong>
                                                            <small class="text-muted d-block">@user.Email</small>
                                                            <small class="text-muted">@user.Role</small>
                                                        </div>
                                                    </div>
                                                </label>
                                            </div>
                                        }
                                    </div>
                                    <span asp-validation-for="SelectedExternalUserId" class="text-danger"></span>
                                </div>
                            }
                            else
                            {
                                <div class="mb-4">
                                    <div class="alert alert-warning">
                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                        No external users are available. You must have external users to create a new client organization.
                                    </div>
                                </div>
                            }

                            <div class="d-flex justify-content-end">
                                <button type="submit" class="btn btn-primary btn-lg d-flex align-items-center gap-2">
                                    <span>Add Client</span>
                                    <i class="fas fa-building-user" style="margin-top: 0;"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Sidebar - Info Card -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-3">
                        <h5 class="fw-bold text-dark mb-2">New Client Organization</h5>
                        <p class="text-muted mb-0 small">
                            Create a new client organization for @Model.LawFirmOrganizationName. 
                            The selected primary client will become the owner of this organization once they sign up with the join code. 
                            Their user color will automatically change to the client color.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Join Code Modal - Using task-details-modal structure *@
@if (TempData["JoinCode"] != null)
{
    <div class="task-details-modal" id="joinCodeModal" style="display: none; border-radius: 12px; left: 23vw; bottom: 0;">
        <div class="modal-dialog" style="margin-bottom: 1.5rem;">
            <div class="task-details-content">
                <!-- Modal Header -->
                <div class="task-details-header" style="display: flex; justify-content: space-between; align-items: center;">
                    <div class="task-details-header-left" style="display: flex; align-items: center; gap: 0.5rem; flex: 1;">
                        <i class="fa-solid fa-key" style="color: #3d1019; font-size: 1.25rem;"></i>
                        <h2 class="task-title" style="cursor: default; margin: 0; font-size: 1.25rem; font-weight: 600; color: #3d1019;">Join Code Generated</h2>
                    </div>
                    <div class="task-details-header-right" style="margin-left: auto;">
                        <button type="button" class="btn-close" id="closeJoinCodeModal" aria-label="Close"></button>
                    </div>
                </div>

                <!-- Success Message -->
                @if (TempData["Success"] != null)
                {
                    <div class="task-details-body" style="padding: 0 1.5rem 1rem;">
                        <div class="alert alert-success" style="margin-bottom: 1rem; border-radius: 8px;">
                            <i class="fas fa-check-circle me-2"></i>
                            @TempData["Success"]
                        </div>
                    </div>
                }

                <!-- Main Content Area -->
                <div class="task-details-body">
                    <!-- Left Panel -->
                    <div class="task-details-left">
                        <!-- Join Code Section -->
                        <div class="task-section">
                            <div class="task-section-header">
                                <h6 class="task-section-title">
                                    <i class="fas fa-key"></i> Join Code
                                </h6>
                            </div>
                            <div class="task-section-content">
                                <div style="position: relative; margin-bottom: 0.75rem;">
                                    <input type="text" class="form-control form-control-lg" id="joinCodeValue" readonly value="@TempData["JoinCode"]" style="font-size: 1.25rem; font-weight: 600; letter-spacing: 0.1em; font-family: monospace; background-color: #f8f9fa; padding-right: 5.5rem;">
                                    <div style="position: absolute; right: 0.5rem; top: 50%; transform: translateY(-50%); display: flex; align-items: center; gap: 0.5rem;">
                                        <button class="join-code-action-btn" type="button" id="copyJoinCodeBtn" title="Copy">
                                            <i class="fas fa-copy"></i>
                                        </button>
                                        <button class="join-code-action-btn" type="button" id="notalizeJoinCodeBtn" title="Notalize">
                                            <img src="/images/Notal_Logo.png" alt="Notalize" style="width: 18px; height: 18px; object-fit: contain;" />
                                        </button>
                                    </div>
                                </div>
                                <small class="text-muted d-block mb-4" style="font-size: 0.875rem;">
                                    Share this code with the client via email, also handled through Communications hub. It expires in 7 days.
                                </small>
                            </div>
                        </div>

                        <!-- Instructions Section -->
                        <div class="task-section" style="margin-bottom: 0;">
                            <div class="task-section-header">
                                <h6 class="task-section-title">
                                    <i class="fas fa-info-circle"></i> Instructions
                                </h6>
                            </div>
                            <div class="task-section-content">
                                <div style="font-size: 0.875rem; color: #4a5568;">
                                    <p style="margin-bottom: 0.5rem;">
                                        <strong>1.</strong> Click Notalize <em>(recommended)</em>, <strong>or</strong> Copy the join code above.
                                    </p>
                                    <p style="margin-bottom: 0.5rem;">
                                        <strong>2.</strong> Share it with the client via email mode in the Communications hub.
                                    </p>
                                    <p style="margin-bottom: 0;">
                                        <strong>3.</strong> The client will use this code to join the organization and will be pending until usage.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="task-action-buttons" style="padding: 0 1.5rem 1.5rem; justify-content: flex-end;">
                    <button type="button" class="btn btn-primary" id="doneJoinCodeBtn" style="border-radius: 0.5rem;">
                        Done
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // External user search functionality
            const searchInput = document.getElementById('externalUserSearch');
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    const searchTerm = this.value.toLowerCase();
                    const userItems = document.querySelectorAll('.user-item');
                    
                    userItems.forEach(item => {
                        const name = item.getAttribute('data-user-name').toLowerCase();
                        const email = item.getAttribute('data-user-email').toLowerCase();
                        
                        if (name.includes(searchTerm) || email.includes(searchTerm)) {
                            item.style.display = '';
                        } else {
                            item.style.display = 'none';
                        }
                    });
                });
            }

            // Handle radio button selection styling
            const userRadios = document.querySelectorAll('.user-radio');
            userRadios.forEach(radio => {
                radio.addEventListener('change', function() {
                    // Remove selected styling from all items
                    document.querySelectorAll('.user-item').forEach(item => {
                        item.classList.remove('selected');
                    });
                    
                    // Add selected styling to the checked item
                    if (this.checked) {
                        this.closest('.user-item').classList.add('selected');
                    }
                });
                
                // Apply initial state if already checked
                if (radio.checked) {
                    radio.closest('.user-item').classList.add('selected');
                }
            });

            // Notalize join code functionality
            async function notalizeJoinCode(joinCode) {
                try {
                    // Get organization IDs
                    const lawFirmOrgId = @(ViewBag.OrganizationId ?? 0);
                    const clientOrgId = @(TempData["NewClientOrgId"] ?? 0);
                    
                    if (!lawFirmOrgId || !clientOrgId) {
                        alert('Unable to determine organization context. Please try again.');
                        return;
                    }

                    // Disable button during request
                    const notalizeBtn = document.getElementById('notalizeJoinCodeBtn');
                    if (notalizeBtn) {
                        notalizeBtn.style.opacity = '0.5';
                        notalizeBtn.style.pointerEvents = 'none';
                    }

                    // Call notalize API
                    const response = await fetch(`/api/dm/notalize-join-code?orgId=${lawFirmOrgId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            JoinCode: joinCode,
                            ClientOrgId: clientOrgId
                        })
                    });

                    const result = await response.json();

                    if (result.success && result.thread && result.messageTemplate) {
                        // Store message template in sessionStorage for Communications page
                        sessionStorage.setItem('notalizeJoinCodeMessage', result.messageTemplate);
                        sessionStorage.setItem('notalizeJoinCodeThreadId', result.thread.id);
                        sessionStorage.setItem('notalizeJoinCodeOtherUserId', result.thread.otherUserId);
                        sessionStorage.setItem('notalizeJoinCodeOtherUserName', result.thread.otherUserName);

                        // Redirect to Communications page
                        window.location.href = `/Client/${lawFirmOrgId}/Communications?notalize=true`;
                    } else {
                        alert(result.error || 'Failed to notalize join code. Please try again.');
                        if (notalizeBtn) {
                            notalizeBtn.style.opacity = '';
                            notalizeBtn.style.pointerEvents = '';
                        }
                    }
                } catch (error) {
                    console.error('Error notalizing join code:', error);
                    alert('Failed to notalize join code. Please try again.');
                    const notalizeBtn = document.getElementById('notalizeJoinCodeBtn');
                    if (notalizeBtn) {
                        notalizeBtn.style.opacity = '';
                        notalizeBtn.style.pointerEvents = '';
                    }
                }
            }

            // Join code modal
            const joinCode = '@(TempData["JoinCode"] ?? "")';
            if (joinCode && joinCode.length > 0) {
                const modalEl = document.getElementById('joinCodeModal');
                if (modalEl) {
                    // Show modal using task-details-modal style
                    modalEl.style.display = 'flex';
                    document.body.style.overflow = 'hidden';
                    
                    const copyBtn = document.getElementById('copyJoinCodeBtn');
                    const input = document.getElementById('joinCodeValue');
                    const closeBtn = document.getElementById('closeJoinCodeModal');
                    const doneBtn = document.getElementById('doneJoinCodeBtn');
                    
                    // Copy functionality
                    if (copyBtn && input) {
                        copyBtn.addEventListener('click', async (e) => {
                            e.stopPropagation();
                            try {
                                await navigator.clipboard.writeText(input.value);
                                const originalHtml = copyBtn.innerHTML;
                                copyBtn.innerHTML = '<i class="fas fa-check"></i>';
                                setTimeout(() => {
                                    copyBtn.innerHTML = originalHtml;
                                }, 1500);
                            } catch (err) {
                                console.error('Failed to copy:', err);
                            }
                        });
                    }

                    // Notalize functionality
                    const notalizeBtn = document.getElementById('notalizeJoinCodeBtn');
                    if (notalizeBtn && input) {
                        notalizeBtn.addEventListener('click', async (e) => {
                            e.stopPropagation();
                            await notalizeJoinCode(input.value);
                        });
                    }
                    
                    // Close handlers
                    function closeJoinCodeModal() {
                        modalEl.style.display = 'none';
                        document.body.style.overflow = '';
                    }
                    
                    if (closeBtn) {
                        closeBtn.addEventListener('click', closeJoinCodeModal);
                    }
                    
                    if (doneBtn) {
                        doneBtn.addEventListener('click', closeJoinCodeModal);
                    }
                    
                    // Close on backdrop click
                    modalEl.addEventListener('click', function(e) {
                        if (e.target === modalEl) {
                            closeJoinCodeModal();
                        }
                    });
                }
            }
        });
    </script>

    <link rel="stylesheet" href="~/css/tasks.css" />
    
    <style>
        .shadow-elegant {
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }
        
        /* Join Code Modal specific adjustments */
        #joinCodeModal.task-details-modal {
            position: fixed;
            top: 7vh;
            left: 23vw;
            right: 320px;
            bottom: 0;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: rgba(0, 0, 0, 0.5);
            pointer-events: auto;
        }
        
        #joinCodeModal.task-details-modal .modal-dialog {
            max-width: 90%;
            width: 45rem;
            margin: 0;
            max-height: 90%;
            border-radius: 12px;
            pointer-events: auto;
            position: relative;
            z-index: 1001;
        }
        
        /* Adjust for hidden sidebar */
        .sidebar-hidden #joinCodeModal.task-details-modal {
            left: calc(6vw + 1rem);
        }
        
        /* Adjust for hidden chat panel */
        .chat-hidden #joinCodeModal.task-details-modal {
            right: 1rem !important;
        }

        .user-item:hover {
            background-color: #f8f9fa;
        }

        .user-item {
            border-radius: 6px;
            transition: background-color 0.2s ease;
            margin-bottom: 0.25rem;
        }

        .user-item:last-child {
            margin-bottom: 0;
        }

        .form-check-input:focus {
            border-color: #6c757d;
            box-shadow: 0 0 0 0.25rem rgba(108, 117, 125, 0.25);
        }

        .user-radio:checked {
            background-color: #6c757d;
            border-color: #6c757d;
        }

        .user-radio:checked + .form-check-label {
            background-color: #f8f9fa;
        }

        .user-item.selected {
            background-color: #f8f9fa;
            box-shadow: 0 0 0 2px rgba(108, 117, 125, 0.25);
        }

        .join-code-action-btn {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
            border-radius: 50%;
            background-color: transparent;
            border: none;
            padding: 0;
            color: #4a5568;
        }

        .join-code-action-btn:hover {
            background-color: rgba(0, 0, 0, 0.08);
            opacity: 1;
        }

        .join-code-action-btn i {
            font-size: 1rem;
        }

        .join-code-action-btn img {
            width: 20px;
            height: 20px;
            object-fit: contain;
            transition: opacity 0.15s;
        }

        .user-item:has(.user-radio:checked) {
            background-color: #f8f9fa;
            box-shadow: 0 0 0 2px rgba(108, 117, 125, 0.25);
        }

        #availableUsersList {
            overflow-x: hidden;
        }
    </style>
}

