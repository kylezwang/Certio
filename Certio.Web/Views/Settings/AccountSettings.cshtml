@using Certio.Domain.Users
@{
    ViewData["Title"] = "Account Settings";
    ViewData["BodyClass"] = "settings-page";
    Layout = "_ClientLayout";
    var user = ViewBag.User as User;
    var fullName = $"{user?.FirstName ?? ""} {user?.LastName ?? ""}".Trim();
    var initials = $"{user?.FirstName?.Substring(0, 1) ?? ""}{user?.LastName?.Substring(0, 1) ?? ""}".ToUpper();
}

<div class="settings-container">
    <!-- Header with Save Button -->
    <div class="settings-header" style="display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h1 class="settings-title">Account Settings</h1>
            <p class="settings-subtitle">
                Manage your account, notifications, and preferences
            </p>
        </div>
                        <button id="saveAccountSettingsBtn" class="btn btn-success" style="display: none; border-radius: 8px; padding: 0.5rem 1.5rem; font-weight: 700;">
            <i class="fas fa-check me-2" style="font-weight: 900;"></i>
            Save Changes
        </button>
    </div>
    
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" style="margin: 0 0 1rem 0; border-radius: 8px; display: flex; align-items: center;">
            <i class="fas fa-check-circle me-2"></i>
            <span style="flex: 1;">@TempData["Success"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="margin-left: auto; align-self: center;"></button>
        </div>
    }
    
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" style="margin: 0 0 1rem 0; border-radius: 8px; display: flex; align-items: center;">
            <i class="fas fa-exclamation-circle me-2"></i>
            <span style="flex: 1;">@TempData["Error"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="margin-left: auto; align-self: center;"></button>
        </div>
    }

    <div class="settings-layout">
        <!-- Navigation Sidebar -->
        <div class="settings-sidebar">
            <nav class="settings-nav">
                <a href="#account" class="settings-nav-item active" data-tab="account">
                    <i class="fas fa-user"></i>
                    <span>Account</span>
                </a>
                <a href="#security" class="settings-nav-item" data-tab="security">
                    <i class="fas fa-shield-halved"></i>
                    <span>Security</span>
                </a>
                <a href="#notifications" class="settings-nav-item" data-tab="notifications">
                    <i class="fas fa-bell"></i>
                    <span>Notifications</span>
                </a>
                <a href="#preferences" class="settings-nav-item" data-tab="preferences">
                    <i class="fas fa-cog"></i>
                    <span>Preferences</span>
                </a>
                <a href="#joincode" class="settings-nav-item" data-tab="joincode">
                    <i class="fas fa-key"></i>
                    <span>Join Code</span>
                </a>
                <a href="#billing" class="settings-nav-item" data-tab="billing">
                    <i class="fas fa-credit-card"></i>
                    <span>Billing & Plan</span>
                </a>
            </nav>
        </div>

        <!-- Content Area -->
        <div class="settings-content">
            <!-- Search Bar -->
            <div class="settings-search-container" style="margin-right: 0.5rem; margin-top: 0.5rem; display: flex; justify-content: flex-end;">
                <div class="settings-search-wrapper" style="position: relative; width: 320px;">
                    <input type="text" id="settingsSearch" class="form-control" placeholder="Search settings..." style="padding-left: 2.5rem; border: 1px solid #e5e7eb; border-radius: 8px; background: white;">
                    <i class="fas fa-search" style="position: absolute; left: 0.875rem; top: 50%; transform: translateY(-50%); color: #9ca3af; pointer-events: none;"></i>
                    <button id="clearSearch" class="btn btn-sm" style="position: absolute; right: 0.5rem; top: 50%; transform: translateY(-50%); border: none; background: transparent; color: #9ca3af; display: none; padding: 0.25rem 0.5rem;">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
            <div class="settings-content-inner">
                <!-- Account Settings -->
                <div id="account-content" class="settings-tab-content active">
                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Profile Information</h3>
                            <p>Update your personal information</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="profile-avatar-section">
                                <div class="profile-avatar">
                                    <div class="avatar-placeholder" style="background: linear-gradient(135deg, #a32b43, #3d1019); color: white; width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: 600; border: 3px solid white; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);">
                                        <span>@initials</span>
                                    </div>
                                </div>
                                <div class="avatar-actions">
                                    <button class="btn btn-outline-secondary btn-sm">Change Avatar</button>
                                    <p class="avatar-hint">JPG, PNG up to 10MB</p>
                                </div>
                            </div>
                            <hr class="settings-divider">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="firstName" class="form-label">First Name</label>
                                    <input type="text" class="form-control settings-input" id="firstName" value="@user?.FirstName" data-original="@user?.FirstName">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="lastName" class="form-label">Last Name</label>
                                    <input type="text" class="form-control settings-input" id="lastName" value="@user?.LastName" data-original="@user?.LastName">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="email" class="form-label">Email</label>
                                    <input type="email" class="form-control settings-input" id="email" value="@user?.Email" data-original="@user?.Email">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="phone" class="form-label">Phone</label>
                                    <input type="tel" class="form-control settings-input" id="phone" value="@user?.PhoneNumber" data-original="@user?.PhoneNumber">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="timezone" class="form-label">Timezone</label>
                                    <select class="form-select settings-input" id="timezone" data-original="@user?.TimeZone">
                                        <!-- Populated by JavaScript -->
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="language" class="form-label">Language</label>
                                    <select class="form-select settings-input" id="language" data-original="@user?.Language">
                                        @{
                                            var userLang = user?.Language ?? "en";
                                        }
                                        <option value="en" selected="@(userLang == "en")">English</option>
                                        <option value="es" selected="@(userLang == "es")">Spanish</option>
                                        <option value="fr" selected="@(userLang == "fr")">French</option>
                                        <option value="de" selected="@(userLang == "de")">German</option>
                                        <option value="zh" selected="@(userLang == "zh")">Chinese</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Security Settings -->
                <div id="security-content" class="settings-tab-content">
                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Two-Factor Authentication</h3>
                            <p>Add an extra layer of security to your account</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Two-Factor Authentication</label>
                                    <p class="settings-row-description">Secure your account with 2FA</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="twoFactorEnabled">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Authentication Methods</h3>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Authenticator App</label>
                                    <p class="settings-row-description">Use TOTP apps like Google Authenticator</p>
                                </div>
                                <button class="btn btn-outline-secondary btn-sm">Setup</button>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">SMS Fallback</label>
                                    <p class="settings-row-description">Receive codes via text message</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="smsEnabled">
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">WebAuthn/Passkeys</label>
                                    <p class="settings-row-description">Use biometric or hardware keys</p>
                                </div>
                                <button class="btn btn-outline-secondary btn-sm">Add</button>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Backup Codes</label>
                                    <p class="settings-row-description">Download emergency access codes</p>
                                </div>
                                <button class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-download me-2"></i>
                                    Download
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Sessions & Devices</h3>
                            <p>Manage your active login sessions</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="session-list" id="sessionsList">
                                <div class="session-item session-placeholder">
                                    <div class="session-info">
                                        <div class="session-details">
                                            <h6 class="session-device">Loading your devices...</h6>
                                            <p class="session-location text-muted">Please wait</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Sign Out All Devices</label>
                                    <p class="settings-row-description">End all active sessions except current</p>
                                </div>
                                <button class="btn btn-outline-danger btn-sm" id="signOutAllDevicesBtn">Sign Out All</button>
                            </div>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Security Preferences</h3>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Login Alerts</label>
                                    <p class="settings-row-description">Get notified of new device logins</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="loginAlerts" checked>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Require Re-authentication</label>
                                    <p class="settings-row-description">For sensitive actions like changing password</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="reauthRequired" checked>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Notifications Settings -->
                <div id="notifications-content" class="settings-tab-content">
                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Notification Channels</h3>
                            <p>Choose how you want to receive notifications</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Email notifications</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="emailNotifications" checked>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Push notifications</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="pushNotifications" checked>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">SMS notifications</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="smsNotifications">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Event Notifications</h3>
                            <p>Get notified about important events</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">@@Mentions</label>
                                    <p class="settings-row-description">When someone mentions you</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="mentions" checked>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Document shared</label>
                                    <p class="settings-row-description">When documents are shared with you</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="documentShared" checked>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">E-sign events</label>
                                    <p class="settings-row-description">Signature requests and completions</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="esignEvents" checked>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Task due/overdue</label>
                                    <p class="settings-row-description">Deadline reminders</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="taskDue" checked>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Status changes</label>
                                    <p class="settings-row-description">Matter and case updates</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="statusChanges">
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Filing updates</label>
                                    <p class="settings-row-description">Court filing notifications</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="filingUpdates" checked>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">AI summaries</label>
                                    <p class="settings-row-description">Weekly AI-generated summaries</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="aiSummaries">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Quiet Hours</h3>
                            <p>Set times when notifications should be paused</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Enable quiet hours</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="quietHours">
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <label for="quietStart" class="form-label">Start time</label>
                                    <input type="time" class="form-control" id="quietStart" value="18:00">
                                </div>
                                <div class="col-md-6">
                                    <label for="quietEnd" class="form-label">End time</label>
                                    <input type="time" class="form-control" id="quietEnd" value="08:00">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


                <!-- Preferences Settings (duplicate of Notifications) -->
                <div id="preferences-content" class="settings-tab-content">
                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Application Preferences</h3>
                            <p>Customize your application experience</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Email notifications</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="prefEmailNotifications" checked>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Push notifications</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="prefPushNotifications" checked>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">SMS notifications</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="prefSmsNotifications">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Display Preferences</h3>
                            <p>Customize how information is displayed</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Dark Mode</label>
                                    <p class="settings-row-description">Switch between light and dark themes</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="darkModeSwitch">
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">@@Mentions</label>
                                    <p class="settings-row-description">When someone mentions you</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="prefMentions" checked>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Document shared</label>
                                    <p class="settings-row-description">When documents are shared with you</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="prefDocumentShared" checked>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">E-sign events</label>
                                    <p class="settings-row-description">Signature requests and completions</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="prefEsignEvents" checked>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Task due/overdue</label>
                                    <p class="settings-row-description">Deadline reminders</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="prefTaskDue" checked>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Status changes</label>
                                    <p class="settings-row-description">Matter and case updates</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="prefStatusChanges">
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Filing updates</label>
                                    <p class="settings-row-description">Court filing notifications</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="prefFilingUpdates" checked>
                            </div>
                        </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">AI summaries</label>
                                    <p class="settings-row-description">Weekly AI-generated summaries</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="prefAiSummaries">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Quiet Hours</h3>
                            <p>Set times when notifications should be paused</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Enable quiet hours</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="prefQuietHours">
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <label for="prefQuietStart" class="form-label">Start time</label>
                                    <input type="time" class="form-control" id="prefQuietStart" value="18:00">
                                </div>
                                <div class="col-md-6">
                                    <label for="prefQuietEnd" class="form-label">End time</label>
                                    <input type="time" class="form-control" id="prefQuietEnd" value="08:00">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Join Code Section -->
                <div id="joincode-content" class="settings-tab-content">
                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Join Organization</h3>
                            <p>Enter a code to join an existing organization</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="row">
                                <div class="col-md-8">
                                    <form id="joinCodeForm">
                                        <div class="mb-3">
                                            <label for="joinCodeInput" class="form-label">Join Code</label>
                                            <div class="input-group">
                                                <input type="text" class="form-control" id="joinCodeInput" placeholder="Enter your code" maxlength="20">
                                                <button type="submit" class="btn btn-primary" id="joinCodeButton">
                                                    Apply Code
                                                </button>
                                            </div>
                                            <div class="form-text">Ask your organization administrator for this code.</div>
                                        </div>
                                        <div class="alert" id="joinCodeMessage" style="display: none;" role="alert"></div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Billing & Plan Section -->
                <div id="billing-content" class="settings-tab-content">
                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Billing & Plan</h3>
                            <p>Manage your subscription and billing settings</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Full Billing & Plan Settings</label>
                                    <p class="settings-row-description">View and manage your subscription, payment methods, usage, and invoices</p>
                                </div>
                                <a href="/Client/@ViewBag.OrganizationId/Settings#billing" class="btn btn-primary btn-sm">
                                    Organization Settings
                                    <i class="fas fa-arrow-right ms-2"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Populate timezone dropdown with comprehensive list
            populateTimezones();
            
            // Detect user's timezone and suggest it
            detectAndSuggestTimezone();
            
            // Change detection for all settings inputs
            initializeChangeDetection();
            
            // Save button functionality
            initializeSaveButton();
            
            // Initialize MFA toggle
            initializeMfaToggle();

            // Initialize Join Code
            initializeJoinCode();

            // Load sessions and devices
            initializeSessionsAndDevices();
            
            // Tab switching functionality
            const navItems = document.querySelectorAll('.settings-nav-item');
            const tabContents = document.querySelectorAll('.settings-tab-content');

            function switchToTab(tabId) {
                navItems.forEach(nav => nav.classList.remove('active'));
                tabContents.forEach(content => content.classList.remove('active'));
                
                const navItem = document.querySelector(`.settings-nav-item[data-tab="${tabId}"]`);
                const targetContent = document.getElementById(tabId + '-content');
                
                if (navItem) navItem.classList.add('active');
                if (targetContent) targetContent.classList.add('active');
            }

            navItems.forEach(item => {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    const tabId = this.getAttribute('data-tab');
                    switchToTab(tabId);
                    window.location.hash = tabId;
                });
            });

            function handleHashChange() {
                const hash = window.location.hash.substring(1);
                if (hash && document.getElementById(hash + '-content')) {
                    switchToTab(hash);
                }
            }

            handleHashChange();
            window.addEventListener('hashchange', handleHashChange);

            // Settings Search Functionality
            const searchInput = document.getElementById('settingsSearch');
            const clearSearchBtn = document.getElementById('clearSearch');
            const settingsSections = document.querySelectorAll('.settings-section');
            const settingsRows = document.querySelectorAll('.settings-row');
            
            function performSearch(searchTerm) {
                const term = searchTerm.toLowerCase().trim();
                
                if (!term) {
                    // Show all sections and rows
                    settingsSections.forEach(section => {
                        section.style.display = 'block';
                    });
                    settingsRows.forEach(row => {
                        row.style.display = 'flex';
                    });
                    clearSearchBtn.style.display = 'none';
                    return;
                }
                
                clearSearchBtn.style.display = 'block';
                let hasResults = false;
                
                // Search through all settings sections
                settingsSections.forEach(section => {
                    const sectionHeader = section.querySelector('.settings-section-header');
                    const sectionTitle = sectionHeader ? sectionHeader.textContent.toLowerCase() : '';
                    let sectionHasMatch = sectionTitle.includes(term);
                    let visibleRowsInSection = 0;
                    
                    // Check rows within section
                    const rowsInSection = section.querySelectorAll('.settings-row');
                    rowsInSection.forEach(row => {
                        const label = row.querySelector('.settings-row-label');
                        const description = row.querySelector('.settings-row-description');
                        const labelText = label ? label.textContent.toLowerCase() : '';
                        const descText = description ? description.textContent.toLowerCase() : '';
                        
                        if (labelText.includes(term) || descText.includes(term) || sectionHasMatch) {
                            row.style.display = 'flex';
                            visibleRowsInSection++;
                            hasResults = true;
                        } else {
                            row.style.display = 'none';
                        }
                    });
                    
                    // Show section if it has matches or visible rows
                    if (sectionHasMatch || visibleRowsInSection > 0) {
                        section.style.display = 'block';
                    } else {
                        section.style.display = 'none';
                    }
                });
                
                // Show no results message if needed
                if (!hasResults) {
                    console.log('No settings found matching: ' + term);
                }
            }
            
            if (searchInput) {
                searchInput.addEventListener('input', function(e) {
                    performSearch(e.target.value);
                });
                
                searchInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') {
                        searchInput.value = '';
                        performSearch('');
                    }
                });
            }
            
            if (clearSearchBtn) {
                clearSearchBtn.addEventListener('click', function() {
                    searchInput.value = '';
                    performSearch('');
                    searchInput.focus();
                });
            }

            // Dark Mode Toggle
            const darkModeSwitch = document.getElementById('darkModeSwitch');
            const isDarkMode = localStorage.getItem('darkMode') === 'true';
            if (isDarkMode) {
                document.body.classList.add('dark-mode');
                if (darkModeSwitch) darkModeSwitch.checked = true;
            }
            
            if (darkModeSwitch) {
                darkModeSwitch.addEventListener('change', function() {
                    if (this.checked) {
                        document.body.classList.add('dark-mode');
                        localStorage.setItem('darkMode', 'true');
                    } else {
                        document.body.classList.remove('dark-mode');
                        localStorage.setItem('darkMode', 'false');
                    }
                });
            }
        });
        
        function populateTimezones() {
            const timezones = [
                { value: 'America/New_York', label: 'Eastern Time (ET)' },
                { value: 'America/Chicago', label: 'Central Time (CT)' },
                { value: 'America/Denver', label: 'Mountain Time (MT)' },
                { value: 'America/Los_Angeles', label: 'Pacific Time (PT)' },
                { value: 'America/Anchorage', label: 'Alaska Time (AKT)' },
                { value: 'Pacific/Honolulu', label: 'Hawaii Time (HST)' },
                { value: 'America/Phoenix', label: 'Arizona Time (MST)' },
                { value: 'America/Toronto', label: 'Toronto' },
                { value: 'America/Vancouver', label: 'Vancouver' },
                { value: 'Europe/London', label: 'London (GMT)' },
                { value: 'Europe/Paris', label: 'Paris (CET)' },
                { value: 'Europe/Berlin', label: 'Berlin (CET)' },
                { value: 'Europe/Madrid', label: 'Madrid (CET)' },
                { value: 'Europe/Rome', label: 'Rome (CET)' },
                { value: 'Asia/Tokyo', label: 'Tokyo (JST)' },
                { value: 'Asia/Shanghai', label: 'Shanghai (CST)' },
                { value: 'Asia/Hong_Kong', label: 'Hong Kong (HKT)' },
                { value: 'Asia/Singapore', label: 'Singapore (SGT)' },
                { value: 'Asia/Dubai', label: 'Dubai (GST)' },
                { value: 'Australia/Sydney', label: 'Sydney (AEDT)' },
                { value: 'Pacific/Auckland', label: 'Auckland (NZDT)' }
            ];
            
            const timezoneSelect = document.getElementById('timezone');
            const currentTimezone = timezoneSelect.dataset.original || 'America/New_York';
            
            timezoneSelect.innerHTML = timezones.map(tz => 
                `<option value="${tz.value}" ${tz.value === currentTimezone ? 'selected' : ''}>${tz.label}</option>`
            ).join('');
        }
        
        function detectAndSuggestTimezone() {
            try {
                const detectedTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
                const timezoneSelect = document.getElementById('timezone');
                const currentTimezone = timezoneSelect.value;
                
                // If detected timezone differs from saved, optionally suggest it
                if (detectedTimezone && detectedTimezone !== currentTimezone) {
                    console.log(`Detected timezone: ${detectedTimezone}, Saved: ${currentTimezone}`);
                }
            } catch (e) {
                console.error('Could not detect timezone:', e);
            }
        }
        
        function initializeChangeDetection() {
            const inputs = document.querySelectorAll('.settings-input');
            const saveBtn = document.getElementById('saveAccountSettingsBtn');
            
            inputs.forEach(input => {
                input.addEventListener('input', checkForChanges);
                input.addEventListener('change', checkForChanges);
            });
            
            function checkForChanges() {
                let hasChanges = false;
                inputs.forEach(input => {
                    const originalValue = input.dataset.original || '';
                    const currentValue = input.value || '';
                    if (originalValue !== currentValue) {
                        hasChanges = true;
                    }
                });
                
                if (hasChanges) {
                    saveBtn.style.display = 'block';
                } else {
                    saveBtn.style.display = 'none';
                }
            }
        }

        function initializeJoinCode() {
            const joinCodeForm = document.getElementById('joinCodeForm');
            const joinCodeInput = document.getElementById('joinCodeInput');
            const joinCodeButton = document.getElementById('joinCodeButton');
            const joinCodeMessage = document.getElementById('joinCodeMessage');

            if (!joinCodeForm) return;

            function showJoinCodeMessage(message, isError = false) {
                joinCodeMessage.textContent = message;
                joinCodeMessage.className = `alert ${isError ? 'alert-danger' : 'alert-success'}`;
                joinCodeMessage.style.display = 'block';
                
                // Hide message after 5 seconds
                setTimeout(() => {
                    joinCodeMessage.style.display = 'none';
                }, 5000);
            }

            function setJoinCodeLoading(loading) {
                joinCodeButton.disabled = loading;
                joinCodeButton.textContent = loading ? 'Applying...' : 'Apply Code';
            }

            joinCodeForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                
                const code = joinCodeInput.value.trim();
                if (!code) {
                    showJoinCodeMessage('Please enter a join code.', true);
                    return;
                }

                setJoinCodeLoading(true);
                joinCodeMessage.style.display = 'none';

                try {
                    // Get token from a hidden input if available, or try to find it in the page
                    // Since we are in a view, we might need to ensure the token is present.
                    // Usually _Layout or the form helper adds it. 
                    // Let's assume we can fetch it or it's not strictly required for this specific API if using cookie auth.
                    // However, for safety, let's try to find it.
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    
                    const response = await fetch('/Home/ApplyJoinCode', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token || ''
                        },
                        body: JSON.stringify({ 
                            joinCode: code,
                            __RequestVerificationToken: token 
                        })
                    });

                    const result = await response.json();
                    
                    if (result.success) {
                        showJoinCodeMessage(result.message || 'Successfully applied join code!');
                        joinCodeInput.value = '';
                        // Optionally refresh or redirect
                        if (result.redirectUrl) {
                            setTimeout(() => {
                                window.location.href = result.redirectUrl;
                            }, 1500);
                        }
                    } else {
                        showJoinCodeMessage(result.message || 'Failed to apply join code.', true);
                    }
                } catch (error) {
                    console.error('Error applying join code:', error);
                    showJoinCodeMessage('An error occurred while applying the join code.', true);
                } finally {
                    setJoinCodeLoading(false);
                }
            });
        }
        
        function initializeSessionsAndDevices() {
            const sessionsList = document.getElementById('sessionsList');
            const signOutAllBtn = document.getElementById('signOutAllDevicesBtn');
            if (!sessionsList) return;

            const renderLoading = (message = 'Loading your devices...') => {
                sessionsList.innerHTML = `
                    <div class="session-item session-placeholder">
                        <div class="session-info">
                            <div class="session-details">
                                <h6 class="session-device">${message}</h6>
                                <p class="session-location text-muted">Please wait</p>
                            </div>
                        </div>
                    </div>
                `;
            };

            const renderEmpty = () => {
                sessionsList.innerHTML = `
                    <div class="session-item session-placeholder">
                        <div class="session-info">
                            <div class="session-details">
                                <h6 class="session-device">No active sessions</h6>
                                <p class="session-location text-muted">Sign in from another device to see it here.</p>
                            </div>
                        </div>
                    </div>
                `;
            };

            const formatRelativeTime = (isoString) => {
                if (!isoString) return 'Unknown';
                const date = new Date(isoString);
                if (Number.isNaN(date.getTime())) return 'Unknown';

                const diffMs = Date.now() - date.getTime();
                const diffSeconds = Math.floor(diffMs / 1000);
                if (diffSeconds < 60) return 'Just now';

                const diffMinutes = Math.floor(diffSeconds / 60);
                if (diffMinutes < 60) return `${diffMinutes} minute${diffMinutes === 1 ? '' : 's'} ago`;

                const diffHours = Math.floor(diffMinutes / 60);
                if (diffHours < 24) return `${diffHours} hour${diffHours === 1 ? '' : 's'} ago`;

                const diffDays = Math.floor(diffHours / 24);
                if (diffDays < 7) return `${diffDays} day${diffDays === 1 ? '' : 's'} ago`;

                return date.toLocaleDateString(undefined, {
                    month: 'short',
                    day: 'numeric',
                    year: date.getFullYear() !== new Date().getFullYear() ? 'numeric' : undefined
                });
            };

            const getSessionIcon = (session) => {
                const type = (session.deviceType || '').toLowerCase();
                if (type.includes('mobile') || session.deviceName?.toLowerCase().includes('iphone') || session.deviceName?.toLowerCase().includes('android')) {
                    return 'fas fa-mobile-alt';
                }
                if (type.includes('tablet') || session.deviceName?.toLowerCase().includes('ipad')) {
                    return 'fas fa-tablet-alt';
                }
                if ((session.browser || '').toLowerCase().includes('chrome')) {
                    return 'fab fa-chrome';
                }
                if ((session.browser || '').toLowerCase().includes('safari')) {
                    return 'fab fa-safari';
                }
                if ((session.browser || '').toLowerCase().includes('firefox')) {
                    return 'fab fa-firefox-browser';
                }
                if ((session.browser || '').toLowerCase().includes('edge')) {
                    return 'fab fa-edge';
                }
                return 'fas fa-laptop';
            };

            const renderSessions = (sessions) => {
                if (!sessions || sessions.length === 0) {
                    renderEmpty();
                    return;
                }

                sessionsList.innerHTML = '';

                sessions.forEach(session => {
                    const iconClass = getSessionIcon(session);
                    const isCurrent = !!session.isCurrent;
                    const trustedBadge = session.isTrusted ? '<span class="badge bg-success ms-2">Trusted</span>' : '';
                    const location = session.location || 'Unknown location';
                    const lastSeen = formatRelativeTime(session.lastSeenAtUtc);
                    const createdAt = formatRelativeTime(session.createdAtUtc);
                    const revokeLabel = isCurrent ? 'Sign Out' : 'Revoke';

                    const sessionItem = document.createElement('div');
                    sessionItem.className = 'session-item';
                    sessionItem.innerHTML = `
                        <div class="session-info">
                            <div class="session-icon">
                                <i class="${iconClass}"></i>
                            </div>
                            <div class="session-details">
                                <h6 class="session-device mb-1">${session.deviceName || 'Unknown Device'}${trustedBadge}</h6>
                                <p class="session-location mb-1">${location}</p>
                                <p class="session-metadata text-muted mb-0">
                                    <span>${session.browser || 'Unknown Browser'} • ${session.operatingSystem || 'Unknown OS'}</span>
                                    <span class="d-block">Last active ${lastSeen}</span>
                                    <span class="d-block text-muted small">Signed in ${createdAt}${session.ipAddress ? ` • IP ${session.ipAddress}` : ''}</span>
                                </p>
                            </div>
                            <div class="session-actions">
                                ${isCurrent ? '<span class="badge bg-primary me-2">Current</span>' : ''}
                                <button class="btn btn-outline-secondary btn-sm revoke-session-btn" data-session-id="${session.id}">${revokeLabel}</button>
                            </div>
                        </div>
                    `;

                    sessionsList.appendChild(sessionItem);
                });

                sessionsList.querySelectorAll('.revoke-session-btn').forEach(button => {
                    button.addEventListener('click', async (e) => {
                        e.preventDefault();
                        const sessionId = button.getAttribute('data-session-id');
                        if (!sessionId) return;

                        const isCurrent = button.closest('.session-item')?.querySelector('.badge.bg-primary') !== null;
                        const confirmMessage = isCurrent
                            ? 'Signing out the current session will log you out immediately. Continue?'
                            : 'Are you sure you want to revoke this session?';
                        if (!confirm(confirmMessage)) return;

                        try {
                            const response = await fetch(`/api/account-security/sessions/${sessionId}`, {
                                method: 'DELETE',
                                credentials: 'same-origin'
                            });
                            if (response.status === 401) {
                                window.location.href = '/Home/Index';
                                return;
                            }
                            const result = await response.json();
                            if (!response.ok || !result.success) {
                                alert(result.error || 'Failed to revoke session.');
                                return;
                            }
                            if (result.current) {
                                window.location.href = '/Home/Index';
                                return;
                            }
                            await refreshSessions();
                        } catch (error) {
                            console.error('Error revoking session:', error);
                            alert('An error occurred while revoking the session.');
                        }
                    });
                });
            };

            const refreshSessions = async () => {
                try {
                    const response = await fetch('/api/account-security/sessions', {
                        credentials: 'same-origin'
                    });
                    if (response.status === 401) {
                        window.location.href = '/Home/Index';
                        return;
                    }
                    const result = await response.json();
                    if (!response.ok || !result.success) {
                        sessionsList.innerHTML = `<div class="session-item session-placeholder"><div class="session-info"><div class="session-details"><h6 class="session-device">Unable to load sessions</h6><p class="session-location text-muted">${result.error || 'Try refreshing the page.'}</p></div></div></div>`;
                        return;
                    }

                    renderSessions(result.sessions || []);
                } catch (error) {
                    console.error('Error loading sessions:', error);
                    sessionsList.innerHTML = `<div class="session-item session-placeholder"><div class="session-info"><div class="session-details"><h6 class="session-device">Unable to load sessions</h6><p class="session-location text-muted">Check your connection and try again.</p></div></div></div>`;
                }
            };

            if (signOutAllBtn) {
                signOutAllBtn.addEventListener('click', async () => {
                    if (!confirm('Are you sure you want to sign out from all devices? This will also sign you out of this session.')) {
                        return;
                    }

                    try {
                        const response = await fetch('/api/account-security/sessions/signout-all', {
                            method: 'POST',
                            credentials: 'same-origin'
                        });
                        if (response.status === 401) {
                            window.location.href = '/Home/Index';
                            return;
                        }
                        const result = await response.json();
                        if (!response.ok || !result.success) {
                            alert(result.error || 'Failed to sign out all sessions.');
                            return;
                        }

                        window.location.href = result.redirectUrl || '/Home/Index';
                    } catch (error) {
                        console.error('Error signing out all sessions:', error);
                        alert('An error occurred while signing out all sessions.');
                    }
                });
            }

            renderLoading();
            refreshSessions();
        }
        
        async function initializeMfaToggle() {
            const mfaCheckbox = document.getElementById('twoFactorEnabled');
            if (!mfaCheckbox) return;
            
            try {
                // Load current MFA status
                const response = await fetch('/api/account-security/mfa/status', {
                    credentials: 'same-origin'
                });

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                const result = await response.json();
                
                if (result.success) {
                    mfaCheckbox.checked = result.enabled;
                } else {
                    console.error('Failed to load MFA status:', result.error);
                    mfaCheckbox.checked = true;
                }
            } catch (error) {
                console.error('Error loading MFA status:', error);
                mfaCheckbox.checked = true;
            }
            
            // Handle toggle changes
            mfaCheckbox.addEventListener('change', async function() {
                const isEnabled = this.checked;
                const originalState = !isEnabled; // Store original state for rollback
                
                // If disabling MFA, show confirmation dialog
                if (!isEnabled) {
                    const confirmed = confirm(
                        'Are you sure you want to disable two-factor authentication?\n\n' +
                        'Disabling 2FA will reduce the security of your account. ' +
                        'We recommend keeping it enabled to protect your account from unauthorized access.\n\n' +
                        'Do you want to continue?'
                    );
                    
                    if (!confirmed) {
                        // User cancelled - revert checkbox
                        this.checked = originalState;
                        return;
                    }
                }
                
                // Disable checkbox during API call
                this.disabled = true;
                
                try {
                    const response = await fetch('/api/account-security/mfa/toggle', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        credentials: 'same-origin',
                        body: JSON.stringify({ enabled: isEnabled })
                    });
                    
                    if (!response.ok) {
                        // Attempt to extract error details if available
                        let errorDetail = `HTTP ${response.status}`;
                        try {
                            const result = await response.json();
                            if (result?.error) {
                                errorDetail = result.error;
                            }
                        } catch {
                            // ignore JSON parse error, keep default detail
                        }
                        throw new Error(errorDetail);
                    }

                    const result = await response.json();
                    
                    if (result.success) {
                        // Show success message
                        const message = isEnabled 
                            ? 'Two-factor authentication has been enabled'
                            : 'Two-factor authentication has been disabled';
                        
                        // Create a temporary success message
                        const alertDiv = document.createElement('div');
                        alertDiv.className = 'alert alert-success alert-dismissible fade show';
                        alertDiv.style.cssText = 'margin: 1rem 0; border-radius: 8px;';
                        alertDiv.innerHTML = `
                            <i class="fas fa-check-circle me-2"></i>
                            <span>${message}</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        `;
                        
                        const securityContent = document.getElementById('security-content');
                        if (securityContent) {
                            securityContent.insertBefore(alertDiv, securityContent.firstChild);
                            
                            // Auto-dismiss after 3 seconds
                            setTimeout(() => {
                                alertDiv.remove();
                            }, 3000);
                        }
                    } else {
                        throw new Error(result.error || 'Unknown error');
                    }
                } catch (error) {
                    // Rollback checkbox state on error
                    this.checked = originalState;
                    console.error('Error toggling MFA:', error);
                    const message = error instanceof Error ? error.message : 'Unknown error';
                    alert('Failed to update MFA setting: ' + message);
                } finally {
                    this.disabled = false;
                }
            });
        }
        
        function initializeSaveButton() {
            const saveBtn = document.getElementById('saveAccountSettingsBtn');
            
            saveBtn.addEventListener('click', async function() {
                const orgId = @ViewBag.OrganizationId;
                
                // Gather all form data
                const formData = {
                    firstName: document.getElementById('firstName').value,
                    lastName: document.getElementById('lastName').value,
                    email: document.getElementById('email').value,
                    phoneNumber: document.getElementById('phone').value,
                    timeZone: document.getElementById('timezone').value,
                    language: document.getElementById('language').value
                };
                
                // Disable button and show loading
                saveBtn.disabled = true;
                saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Saving...';
                
                try {
                    const response = await fetch(`/Client/${orgId}/AccountSettings/Save`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(formData)
                    });
                    
                    const result = await response.json();
                    
                    if (result.success && result.requiresVerification) {
                        // Redirect to verification page
                        window.location.href = result.redirectUrl;
                    } else if (result.success) {
                        // Direct save without verification (shouldn't happen with current logic)
                        updateOriginalValues();
                        showSuccessMessage();
                    } else {
                        alert('Failed to save: ' + (result.error || 'Unknown error'));
                        saveBtn.innerHTML = '<i class="fas fa-check me-2"></i>Save Changes';
                    }
                } catch (error) {
                    console.error('Error saving settings:', error);
                    alert('Failed to save settings. Please try again.');
                    saveBtn.innerHTML = '<i class="fas fa-check me-2"></i>Save Changes';
                } finally {
                    saveBtn.disabled = false;
                }
            });
        }
        
    </script>
}


