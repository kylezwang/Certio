        function detectAndSuggestTimezone() {
            try {
                const detectedTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
                const timezoneSelect = document.getElementById('timezone');
                const currentTimezone = timezoneSelect.value;
                
                // If detected timezone differs from saved, optionally suggest it
                if (detectedTimezone && detectedTimezone !== currentTimezone) {
                    console.log(`Detected timezone: ${detectedTimezone}, Saved: ${currentTimezone}`);
                }
            } catch (e) {
                console.error('Could not detect timezone:', e);
            }
        }
        
        function initializeChangeDetection() {
            const inputs = document.querySelectorAll('.settings-input');
            const saveBtn = document.getElementById('saveAccountSettingsBtn');
            
            inputs.forEach(input => {
                input.addEventListener('input', checkForChanges);
                input.addEventListener('change', checkForChanges);
            });
            
            function checkForChanges() {
                let hasChanges = false;
                inputs.forEach(input => {
                    const originalValue = input.dataset.original || '';
                    const currentValue = input.value || '';
                    if (originalValue !== currentValue) {
                        hasChanges = true;
                    }
                });
                
                if (hasChanges) {
                    saveBtn.style.display = 'block';
                } else {
                    saveBtn.style.display = 'none';
                }
            }
        }
        
        async function initializeMfaToggle() {
            const mfaCheckbox = document.getElementById('twoFactorEnabled');
            if (!mfaCheckbox) return;
            
            try {
                // Load current MFA status
                const response = await fetch('/api/account-security/mfa/status', {
                    credentials: 'same-origin'
                });

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                const result = await response.json();
                
                if (result.success) {
                    mfaCheckbox.checked = result.enabled;
                } else {
                    console.error('Failed to load MFA status:', result.error);
                    mfaCheckbox.checked = true;
                }
            } catch (error) {
                console.error('Error loading MFA status:', error);
                mfaCheckbox.checked = true;
            }
            
            // Handle toggle changes
            mfaCheckbox.addEventListener('change', async function() {
                const isEnabled = this.checked;
                const originalState = !isEnabled; // Store original state for rollback
                
                // If disabling MFA, show confirmation dialog
                if (!isEnabled) {
                    const confirmed = confirm(
                        'Are you sure you want to disable two-factor authentication?\n\n' +
                        'Disabling 2FA will reduce the security of your account. ' +
                        'We recommend keeping it enabled to protect your account from unauthorized access.\n\n' +
                        'Do you want to continue?'
                    );
                    
                    if (!confirmed) {
                        // User cancelled - revert checkbox
                        this.checked = originalState;
                        return;
                    }
                }
                
                // Disable checkbox during API call
                this.disabled = true;
                
                try {
                    const response = await fetch('/api/account-security/mfa/toggle', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        credentials: 'same-origin',
                        body: JSON.stringify({ enabled: isEnabled })
                    });
                    
                    if (!response.ok) {
                        // Attempt to extract error details if available
                        let errorDetail = `HTTP ${response.status}`;
                        try {
                            const result = await response.json();
                            if (result?.error) {
                                errorDetail = result.error;
                            }
                        } catch {
                            // ignore JSON parse error, keep default detail
                        }
                        throw new Error(errorDetail);
                    }

                    const result = await response.json();
                    
                    if (result.success) {
                        // Show success message
                        const message = isEnabled 
                            ? 'Two-factor authentication has been enabled'
                            : 'Two-factor authentication has been disabled';
                        
                        // Create a temporary success message
                        const alertDiv = document.createElement('div');
                        alertDiv.className = 'alert alert-success alert-dismissible fade show';
                        alertDiv.style.cssText = 'margin: 1rem 0; border-radius: 8px;';
                        alertDiv.innerHTML = `
                            <i class="fas fa-check-circle me-2"></i>
                            <span>${message}</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        `;
                        
                        const securityContent = document.getElementById('security-content');
                        if (securityContent) {
                            securityContent.insertBefore(alertDiv, securityContent.firstChild);
                            
                            // Auto-dismiss after 3 seconds
                            setTimeout(() => {
                                alertDiv.remove();
                            }, 3000);
                        }
                    } else {
                        throw new Error(result.error || 'Unknown error');
                    }
                } catch (error) {
                    // Rollback checkbox state on error
                    this.checked = originalState;
                    console.error('Error toggling MFA:', error);
                    const message = error instanceof Error ? error.message : 'Unknown error';
                    alert('Failed to update MFA setting: ' + message);
                } finally {
                    this.disabled = false;
                }
            });
        }
        
        function initializeSaveButton() {
            const saveBtn = document.getElementById('saveAccountSettingsBtn');
            
            saveBtn.addEventListener('click', async function() {
                const orgId = @ViewBag.OrganizationId;
                
                // Gather all form data
                const formData = {
                    firstName: document.getElementById('firstName').value,
                    lastName: document.getElementById('lastName').value,
                    email: document.getElementById('email').value,
                    phoneNumber: document.getElementById('phone').value,
                    timeZone: document.getElementById('timezone').value,
                    language: document.getElementById('language').value
                };
                
                // Disable button and show loading
                saveBtn.disabled = true;
                saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Saving...';
                
                try {
                    const response = await fetch(`/Client/${orgId}/AccountSettings/Save`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(formData)
                    });
                    
                    const result = await response.json();
                    
                    if (result.success && result.requiresVerification) {
                        // Redirect to verification page
                        window.location.href = result.redirectUrl;
                    } else if (result.success) {
                        // Direct save without verification (shouldn't happen with current logic)
                        updateOriginalValues();
                        showSuccessMessage();
                    } else {
                        alert('Failed to save: ' + (result.error || 'Unknown error'));
                        saveBtn.innerHTML = '<i class="fas fa-check me-2"></i>Save Changes';
                    }
                } catch (error) {
                    console.error('Error saving settings:', error);
                    alert('Failed to save settings. Please try again.');
                    saveBtn.innerHTML = '<i class="fas fa-check me-2"></i>Save Changes';
                } finally {
                    saveBtn.disabled = false;
                }
            });
        }
        
    </script>
}


