@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Populate timezone dropdown with comprehensive list
            populateTimezones();
            
            // Detect user's timezone and suggest it
            detectAndSuggestTimezone();
            
            // Change detection for all settings inputs
            initializeChangeDetection();
            
            // Save button functionality
            initializeSaveButton();
            
            // Initialize MFA toggle
            initializeMfaToggle();

            // Initialize Join Code
            initializeJoinCode();

            // Billing history toggle (Account Settings Billing section)
            const viewBillingHistoryLink = document.getElementById('viewBillingHistoryLink');
            const billingHistorySection = document.getElementById('billingHistorySection');
            if (viewBillingHistoryLink && billingHistorySection) {
                viewBillingHistoryLink.addEventListener('click', function(e) {
                    e.preventDefault();
                    const isVisible = billingHistorySection.style.display !== 'none';
                    if (isVisible) {
                        billingHistorySection.style.display = 'none';
                        viewBillingHistoryLink.classList.remove('active');
                    } else {
                        billingHistorySection.style.display = 'block';
                        viewBillingHistoryLink.classList.add('active');
                    }
                });
            }

            // Get organization ID for AI Usage
            const orgIdElement = document.querySelector('[data-organization-id]');
            const orgId = orgIdElement ? parseInt(orgIdElement.getAttribute('data-organization-id')) : null;

            // AI Usage Chart functionality
            let aiUsageChart = null;
            let aiUsageDataLoaded = false;

            async function loadAIUsageData() {
                const loadingEl = document.getElementById('aiUsageLoading');
                const emptyEl = document.getElementById('aiUsageEmpty');
                const chartCanvas = document.getElementById('aiUsageChart');

                if (!orgId || !chartCanvas) return;

                try {
                    const response = await fetch(`/Client/${orgId}/Settings/AIUsage?days=30`);
                    const result = await response.json();

                    if (loadingEl) loadingEl.style.display = 'none';

                    if (result.success && result.data) {
                        const data = result.data;

                        // Update summary stats
                        const totalCostEl = document.getElementById('totalCostValue');
                        const totalCallsEl = document.getElementById('totalCallsValue');
                        const totalTokensEl = document.getElementById('totalTokensValue');

                        if (totalCostEl) totalCostEl.textContent = `$${data.totalCost.toFixed(2)}`;
                        if (totalCallsEl) totalCallsEl.textContent = data.totalCalls.toLocaleString();
                        if (totalTokensEl) totalTokensEl.textContent = data.totalTokens.toLocaleString();

                        // Check if there's any data
                        if (data.totalCalls === 0) {
                            if (emptyEl) emptyEl.style.display = 'block';
                            return;
                        }

                        // Prepare chart data
                        const labels = data.dataPoints.map(dp => {
                            const date = new Date(dp.date);
                            return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                        });
                        const costs = data.dataPoints.map(dp => dp.cost);

                        // Create or update chart
                        const ctx = chartCanvas.getContext('2d');

                        if (aiUsageChart) {
                            aiUsageChart.destroy();
                        }

                        aiUsageChart = new Chart(ctx, {
                            type: 'line',
                            data: {
                                labels: labels,
                                datasets: [{
                                    label: 'Cost ($)',
                                    data: costs,
                                    borderColor: '#6366f1',
                                    backgroundColor: 'rgba(99, 102, 241, 0.1)',
                                    borderWidth: 2,
                                    fill: true,
                                    tension: 0.4,
                                    pointRadius: 2,
                                    pointHoverRadius: 6,
                                    pointBackgroundColor: '#6366f1',
                                    pointBorderColor: '#fff',
                                    pointBorderWidth: 2
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                interaction: {
                                    intersect: false,
                                    mode: 'index'
                                },
                                plugins: {
                                    legend: {
                                        display: false
                                    },
                                    tooltip: {
                                        backgroundColor: 'rgba(15, 23, 42, 0.9)',
                                        padding: 12,
                                        titleFont: { size: 13, weight: '600' },
                                        bodyFont: { size: 12 },
                                        callbacks: {
                                            label: function(context) {
                                                return `Cost: $${context.parsed.y.toFixed(4)}`;
                                            }
                                        }
                                    }
                                },
                                scales: {
                                    x: {
                                        grid: {
                                            display: false
                                        },
                                        ticks: {
                                            maxTicksLimit: 8,
                                            font: { size: 11 },
                                            color: '#64748b'
                                        }
                                    },
                                    y: {
                                        beginAtZero: true,
                                        grid: {
                                            color: 'rgba(148, 163, 184, 0.1)'
                                        },
                                        ticks: {
                                            font: { size: 11 },
                                            color: '#64748b',
                                            callback: function(value) {
                                                return '$' + value.toFixed(2);
                                            }
                                        }
                                    }
                                }
                            }
                        });

                        // Update model breakdown
                        const modelBreakdownEl = document.getElementById('modelBreakdown');
                        const modelBreakdownContent = document.getElementById('modelBreakdownContent');

                        if (data.costByModel && Object.keys(data.costByModel).length > 0 && modelBreakdownEl && modelBreakdownContent) {
                            modelBreakdownEl.style.display = 'block';

                            const modelColors = {
                                'gpt-4o-mini': '#22c55e',
                                'gpt-4o': '#6366f1',
                                'gpt-5': '#f59e0b'
                            };

                            modelBreakdownContent.innerHTML = Object.entries(data.costByModel)
                                .map(([model, cost]) => `
                                    <div style="display: flex; align-items: center; gap: 0.5rem; background: #f8fafc; padding: 0.5rem 0.75rem; border-radius: 8px;">
                                        <div style="width: 8px; height: 8px; border-radius: 50%; background: ${modelColors[model] || '#94a3b8'};"></div>
                                        <span style="font-size: 0.875rem; color: #475569;">${model}</span>
                                        <span style="font-size: 0.875rem; font-weight: 500; color: #0f172a;">$${cost.toFixed(4)}</span>
                                    </div>
                                `).join('');
                        }
                    } else {
                        if (emptyEl) emptyEl.style.display = 'block';
                    }
                } catch (error) {
                    console.error('Error loading AI usage data:', error);
                    if (loadingEl) loadingEl.style.display = 'none';
                    if (emptyEl) {
                        emptyEl.innerHTML = '<i class="fas fa-exclamation-circle" style="font-size: 2rem; margin-bottom: 0.5rem; display: block;"></i>Error loading usage data';
                        emptyEl.style.display = 'block';
                    }
                }
            }

            // Load sessions and devices
            initializeSessionsAndDevices();
            
            // Tab switching functionality
            const navItems = document.querySelectorAll('.settings-nav-item');
            const tabContents = document.querySelectorAll('.settings-tab-content');

            function switchToTab(tabId) {
                navItems.forEach(nav => nav.classList.remove('active'));
                tabContents.forEach(content => content.classList.remove('active'));
                
                const navItem = document.querySelector(`.settings-nav-item[data-tab="${tabId}"]`);
                const targetContent = document.getElementById(tabId + '-content');
                
                if (navItem) navItem.classList.add('active');
                if (targetContent) targetContent.classList.add('active');

                // Load AI usage data when billing tab is shown
                if (tabId === 'billing' && orgId && !aiUsageDataLoaded) {
                    aiUsageDataLoaded = true;
                    loadAIUsageData();
                }
            }

            navItems.forEach(item => {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    const tabId = this.getAttribute('data-tab');
                    switchToTab(tabId);
                    window.location.hash = tabId;
                });
            });

            function handleHashChange() {
                const hash = window.location.hash.substring(1);
                if (hash && document.getElementById(hash + '-content')) {
                    switchToTab(hash);
                }
            }

            handleHashChange();
            window.addEventListener('hashchange', handleHashChange);

            // Settings Search Functionality
            const searchInput = document.getElementById('settingsSearch');
            const clearSearchBtn = document.getElementById('clearSearch');
            const settingsSections = document.querySelectorAll('.settings-section');
            const settingsRows = document.querySelectorAll('.settings-row');
            
            function performSearch(searchTerm) {
                const term = searchTerm.toLowerCase().trim();
                
                if (!term) {
                    // Show all sections and rows
                    settingsSections.forEach(section => {
                        section.style.display = 'block';
                    });
                    settingsRows.forEach(row => {
                        row.style.display = 'flex';
                    });
                    clearSearchBtn.style.display = 'none';
                    return;
                }
                
                clearSearchBtn.style.display = 'block';
                let hasResults = false;
                
                // Search through all settings sections
                settingsSections.forEach(section => {
                    const sectionHeader = section.querySelector('.settings-section-header');
                    const sectionTitle = sectionHeader ? sectionHeader.textContent.toLowerCase() : '';
                    let sectionHasMatch = sectionTitle.includes(term);
                    let visibleRowsInSection = 0;
                    
                    // Check rows within section
                    const rowsInSection = section.querySelectorAll('.settings-row');
                    rowsInSection.forEach(row => {
                        const label = row.querySelector('.settings-row-label');
                        const description = row.querySelector('.settings-row-description');
                        const labelText = label ? label.textContent.toLowerCase() : '';
                        const descText = description ? description.textContent.toLowerCase() : '';
                        
                        if (labelText.includes(term) || descText.includes(term) || sectionHasMatch) {
                            row.style.display = 'flex';
                            visibleRowsInSection++;
                            hasResults = true;
                        } else {
                            row.style.display = 'none';
                        }
                    });
                    
                    // Show section if it has matches or visible rows
                    if (sectionHasMatch || visibleRowsInSection > 0) {
                        section.style.display = 'block';
                    } else {
                        section.style.display = 'none';
                    }
                });
                
                // Show no results message if needed
                if (!hasResults) {
                    console.log('No settings found matching: ' + term);
                }
            }
            
            if (searchInput) {
                searchInput.addEventListener('input', function(e) {
                    performSearch(e.target.value);
                });
                
                searchInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') {
                        searchInput.value = '';
                        performSearch('');
                    }
                });
            }
            
            if (clearSearchBtn) {
                clearSearchBtn.addEventListener('click', function() {
                    searchInput.value = '';
                    performSearch('');
                    searchInput.focus();
                });
            }

            // Dark Mode Toggle
            const darkModeSwitch = document.getElementById('darkModeSwitch');
            const isDarkMode = localStorage.getItem('darkMode') === 'true';
            if (isDarkMode) {
                document.body.classList.add('dark-mode');
                if (darkModeSwitch) darkModeSwitch.checked = true;
            }
            
            if (darkModeSwitch) {
                darkModeSwitch.addEventListener('change', function() {
                    if (this.checked) {
                        document.body.classList.add('dark-mode');
                        localStorage.setItem('darkMode', 'true');
                    } else {
                        document.body.classList.remove('dark-mode');
                        localStorage.setItem('darkMode', 'false');
                    }
                });
            }
        });
        
        function populateTimezones() {
            const timezones = [
                { value: 'America/New_York', label: 'Eastern Time (ET)' },
                { value: 'America/Chicago', label: 'Central Time (CT)' },
                { value: 'America/Denver', label: 'Mountain Time (MT)' },
                { value: 'America/Los_Angeles', label: 'Pacific Time (PT)' },
                { value: 'America/Anchorage', label: 'Alaska Time (AKT)' },
                { value: 'Pacific/Honolulu', label: 'Hawaii Time (HST)' },
                { value: 'America/Phoenix', label: 'Arizona Time (MST)' },
                { value: 'America/Toronto', label: 'Toronto' },
                { value: 'America/Vancouver', label: 'Vancouver' },
                { value: 'Europe/London', label: 'London (GMT)' },
                { value: 'Europe/Paris', label: 'Paris (CET)' },
                { value: 'Europe/Berlin', label: 'Berlin (CET)' },
                { value: 'Europe/Madrid', label: 'Madrid (CET)' },
                { value: 'Europe/Rome', label: 'Rome (CET)' },
                { value: 'Asia/Tokyo', label: 'Tokyo (JST)' },
                { value: 'Asia/Shanghai', label: 'Shanghai (CST)' },
                { value: 'Asia/Hong_Kong', label: 'Hong Kong (HKT)' },
                { value: 'Asia/Singapore', label: 'Singapore (SGT)' },
                { value: 'Asia/Dubai', label: 'Dubai (GST)' },
                { value: 'Australia/Sydney', label: 'Sydney (AEDT)' },
                { value: 'Pacific/Auckland', label: 'Auckland (NZDT)' }
            ];
            
            const timezoneSelect = document.getElementById('timezone');
            const currentTimezone = timezoneSelect.dataset.original || 'America/New_York';
            
            timezoneSelect.innerHTML = timezones.map(tz => 
                `<option value="${tz.value}" ${tz.value === currentTimezone ? 'selected' : ''}>${tz.label}</option>`
            ).join('');
        }
        
        function detectAndSuggestTimezone() {
            try {
                const detectedTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
                const timezoneSelect = document.getElementById('timezone');
                const currentTimezone = timezoneSelect.value;
                
                // If detected timezone differs from saved, optionally suggest it
                if (detectedTimezone && detectedTimezone !== currentTimezone) {
                    console.log(`Detected timezone: ${detectedTimezone}, Saved: ${currentTimezone}`);
                }
            } catch (e) {
                console.error('Could not detect timezone:', e);
            }
        }
        
        function initializeChangeDetection() {
            const inputs = document.querySelectorAll('.settings-input');
            const saveBtn = document.getElementById('saveAccountSettingsBtn');
            
            inputs.forEach(input => {
                input.addEventListener('input', checkForChanges);
                input.addEventListener('change', checkForChanges);
            });
            
            function checkForChanges() {
                let hasChanges = false;
                inputs.forEach(input => {
                    const originalValue = input.dataset.original || '';
                    const currentValue = input.value || '';
                    if (originalValue !== currentValue) {
                        hasChanges = true;
                    }
                });
                
                if (hasChanges) {
                    saveBtn.style.display = 'block';
                } else {
                    saveBtn.style.display = 'none';
                }
            }
        }

        function initializeJoinCode() {
            const joinCodeForm = document.getElementById('joinCodeForm');
            const joinCodeInput = document.getElementById('joinCodeInput');
            const joinCodeButton = document.getElementById('joinCodeButton');
            const joinCodeMessage = document.getElementById('joinCodeMessage');

            if (!joinCodeForm) return;

            function showJoinCodeMessage(message, isError = false) {
                joinCodeMessage.textContent = message;
                joinCodeMessage.className = `alert ${isError ? 'alert-danger' : 'alert-success'}`;
                joinCodeMessage.style.display = 'block';
                
                // Hide message after 5 seconds
                setTimeout(() => {
                    joinCodeMessage.style.display = 'none';
                }, 5000);
            }

            function setJoinCodeLoading(loading) {
                joinCodeButton.disabled = loading;
                joinCodeButton.textContent = loading ? 'Applying...' : 'Apply Code';
            }

            joinCodeForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                
                const code = joinCodeInput.value.trim();
                if (!code) {
                    showJoinCodeMessage('Please enter a join code.', true);
                    return;
                }

                setJoinCodeLoading(true);
                joinCodeMessage.style.display = 'none';

                try {
                    // Get token from a hidden input if available, or try to find it in the page
                    // Since we are in a view, we might need to ensure the token is present.
                    // Usually _Layout or the form helper adds it. 
                    // Let's assume we can fetch it or it's not strictly required for this specific API if using cookie auth.
                    // However, for safety, let's try to find it.
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    
                    const response = await fetch('/Home/ApplyJoinCode', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token || ''
                        },
                        body: JSON.stringify({ 
                            joinCode: code,
                            __RequestVerificationToken: token 
                        })
                    });

                    const result = await response.json();
                    
                    if (result.success) {
                        showJoinCodeMessage(result.message || 'Successfully applied join code!');
                        joinCodeInput.value = '';
                        // Optionally refresh or redirect
                        if (result.redirectUrl) {
                            setTimeout(() => {
                                window.location.href = result.redirectUrl;
                            }, 1500);
                        }
                    } else {
                        showJoinCodeMessage(result.message || 'Failed to apply join code.', true);
                    }
                } catch (error) {
                    console.error('Error applying join code:', error);
                    showJoinCodeMessage('An error occurred while applying the join code.', true);
                } finally {
                    setJoinCodeLoading(false);
                }
            });
        }
        
        function initializeSessionsAndDevices() {
            const sessionsList = document.getElementById('sessionsList');
            const signOutAllBtn = document.getElementById('signOutAllDevicesBtn');
            if (!sessionsList) return;

            const renderLoading = (message = 'Loading your devices...') => {
                sessionsList.innerHTML = `
                    <div class="session-item session-placeholder">
                        <div class="session-info">
                            <div class="session-details">
                                <h6 class="session-device">${message}</h6>
                                <p class="session-location text-muted">Please wait</p>
                            </div>
                        </div>
                    </div>
                `;
            };

            const renderEmpty = () => {
                sessionsList.innerHTML = `
                    <div class="session-item session-placeholder">
                        <div class="session-info">
                            <div class="session-details">
                                <h6 class="session-device">No active sessions</h6>
                                <p class="session-location text-muted">Sign in from another device to see it here.</p>
                            </div>
                        </div>
                    </div>
                `;
            };

            const formatRelativeTime = (isoString) => {
                if (!isoString) return 'Unknown';
                const date = new Date(isoString);
                if (Number.isNaN(date.getTime())) return 'Unknown';

                const diffMs = Date.now() - date.getTime();
                const diffSeconds = Math.floor(diffMs / 1000);
                if (diffSeconds < 60) return 'Just now';

                const diffMinutes = Math.floor(diffSeconds / 60);
                if (diffMinutes < 60) return `${diffMinutes} minute${diffMinutes === 1 ? '' : 's'} ago`;

                const diffHours = Math.floor(diffMinutes / 60);
                if (diffHours < 24) return `${diffHours} hour${diffHours === 1 ? '' : 's'} ago`;

                const diffDays = Math.floor(diffHours / 24);
                if (diffDays < 7) return `${diffDays} day${diffDays === 1 ? '' : 's'} ago`;

                return date.toLocaleDateString(undefined, {
                    month: 'short',
                    day: 'numeric',
                    year: date.getFullYear() !== new Date().getFullYear() ? 'numeric' : undefined
                });
            };

            const getSessionIcon = (session) => {
                const type = (session.deviceType || '').toLowerCase();
                if (type.includes('mobile') || session.deviceName?.toLowerCase().includes('iphone') || session.deviceName?.toLowerCase().includes('android')) {
                    return 'fas fa-mobile-alt';
                }
                if (type.includes('tablet') || session.deviceName?.toLowerCase().includes('ipad')) {
                    return 'fas fa-tablet-alt';
                }
                if ((session.browser || '').toLowerCase().includes('chrome')) {
                    return 'fab fa-chrome';
                }
                if ((session.browser || '').toLowerCase().includes('safari')) {
                    return 'fab fa-safari';
                }
                if ((session.browser || '').toLowerCase().includes('firefox')) {
                    return 'fab fa-firefox-browser';
                }
                if ((session.browser || '').toLowerCase().includes('edge')) {
                    return 'fab fa-edge';
                }
                return 'fas fa-laptop';
            };

            const renderSessions = (sessions) => {
                if (!sessions || sessions.length === 0) {
                    renderEmpty();
                    return;
                }

                sessionsList.innerHTML = '';

                sessions.forEach(session => {
                    const iconClass = getSessionIcon(session);
                    const isCurrent = !!session.isCurrent;
                    const trustedBadge = session.isTrusted ? '<span class="badge bg-success ms-2">Trusted</span>' : '';
                    const location = session.location || 'Unknown location';
                    const lastSeen = formatRelativeTime(session.lastSeenAtUtc);
                    const createdAt = formatRelativeTime(session.createdAtUtc);
                    const revokeLabel = isCurrent ? 'Sign Out' : 'Revoke';

                    const sessionItem = document.createElement('div');
                    sessionItem.className = 'session-item';
                    sessionItem.innerHTML = `
                        <div class="session-info">
                            <div class="session-icon">
                                <i class="${iconClass}"></i>
                            </div>
                            <div class="session-details">
                                <h6 class="session-device mb-1">${session.deviceName || 'Unknown Device'}${trustedBadge}</h6>
                                <p class="session-location mb-1">${location}</p>
                                <p class="session-metadata text-muted mb-0">
                                    <span>${session.browser || 'Unknown Browser'} • ${session.operatingSystem || 'Unknown OS'}</span>
                                    <span class="d-block">Last active ${lastSeen}</span>
                                    <span class="d-block text-muted small">Signed in ${createdAt}${session.ipAddress ? ` • IP ${session.ipAddress}` : ''}</span>
                                </p>
                            </div>
                            <div class="session-actions">
                                ${isCurrent ? '<span class="badge bg-primary me-2">Current</span>' : ''}
                                <button class="btn btn-outline-secondary btn-sm revoke-session-btn" data-session-id="${session.id}">${revokeLabel}</button>
                            </div>
                        </div>
                    `;

                    sessionsList.appendChild(sessionItem);
                });

                sessionsList.querySelectorAll('.revoke-session-btn').forEach(button => {
                    button.addEventListener('click', async (e) => {
                        e.preventDefault();
                        const sessionId = button.getAttribute('data-session-id');
                        if (!sessionId) return;

                        const isCurrent = button.closest('.session-item')?.querySelector('.badge.bg-primary') !== null;
                        const confirmMessage = isCurrent
                            ? 'Signing out the current session will log you out immediately. Continue?'
                            : 'Are you sure you want to revoke this session?';
                        if (!confirm(confirmMessage)) return;

                        try {
                            const response = await fetch(`/api/account-security/sessions/${sessionId}`, {
                                method: 'DELETE',
                                credentials: 'same-origin'
                            });
                            if (response.status === 401) {
                                window.location.href = '/Home/Index';
                                return;
                            }
                            const result = await response.json();
                            if (!response.ok || !result.success) {
                                alert(result.error || 'Failed to revoke session.');
                                return;
                            }
                            if (result.current) {
                                window.location.href = '/Home/Index';
                                return;
                            }
                            await refreshSessions();
                        } catch (error) {
                            console.error('Error revoking session:', error);
                            alert('An error occurred while revoking the session.');
                        }
                    });
                });
            };

            const refreshSessions = async () => {
                try {
                    const response = await fetch('/api/account-security/sessions', {
                        credentials: 'same-origin'
                    });
                    if (response.status === 401) {
                        window.location.href = '/Home/Index';
                        return;
                    }
                    const result = await response.json();
                    if (!response.ok || !result.success) {
                        sessionsList.innerHTML = `<div class="session-item session-placeholder"><div class="session-info"><div class="session-details"><h6 class="session-device">Unable to load sessions</h6><p class="session-location text-muted">${result.error || 'Try refreshing the page.'}</p></div></div></div>`;
                        return;
                    }

                    renderSessions(result.sessions || []);
                } catch (error) {
                    console.error('Error loading sessions:', error);
                    sessionsList.innerHTML = `<div class="session-item session-placeholder"><div class="session-info"><div class="session-details"><h6 class="session-device">Unable to load sessions</h6><p class="session-location text-muted">Check your connection and try again.</p></div></div></div>`;
                }
            };

            if (signOutAllBtn) {
                signOutAllBtn.addEventListener('click', async () => {
                    if (!confirm('Are you sure you want to sign out from all devices? This will also sign you out of this session.')) {
                        return;
                    }

                    try {
                        const response = await fetch('/api/account-security/sessions/signout-all', {
                            method: 'POST',
                            credentials: 'same-origin'
                        });
                        if (response.status === 401) {
                            window.location.href = '/Home/Index';
                            return;
                        }
                        const result = await response.json();
                        if (!response.ok || !result.success) {
                            alert(result.error || 'Failed to sign out all sessions.');
                            return;
                        }

                        window.location.href = result.redirectUrl || '/Home/Index';
                    } catch (error) {
                        console.error('Error signing out all sessions:', error);
                        alert('An error occurred while signing out all sessions.');
                    }
                });
            }

            renderLoading();
            refreshSessions();
        }
        
        async function initializeMfaToggle() {
            const mfaCheckbox = document.getElementById('twoFactorEnabled');
            if (!mfaCheckbox) return;
            
            try {
                // Load current MFA status
                const response = await fetch('/api/account-security/mfa/status', {
                    credentials: 'same-origin'
                });

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                const result = await response.json();
                
                if (result.success) {
                    mfaCheckbox.checked = result.enabled;
                } else {
                    console.error('Failed to load MFA status:', result.error);
                    mfaCheckbox.checked = true;
                }
            } catch (error) {
                console.error('Error loading MFA status:', error);
                mfaCheckbox.checked = true;
            }
            
            // Handle toggle changes
            mfaCheckbox.addEventListener('change', async function() {
                const isEnabled = this.checked;
                const originalState = !isEnabled; // Store original state for rollback
                
                // If disabling MFA, show confirmation dialog
                if (!isEnabled) {
                    const confirmed = confirm(
                        'Are you sure you want to disable two-factor authentication?\n\n' +
                        'Disabling 2FA will reduce the security of your account. ' +
                        'We recommend keeping it enabled to protect your account from unauthorized access.\n\n' +
                        'Do you want to continue?'
                    );
                    
                    if (!confirmed) {
                        // User cancelled - revert checkbox
                        this.checked = originalState;
                        return;
                    }
                }
                
                // Disable checkbox during API call
                this.disabled = true;
                
                try {
                    const response = await fetch('/api/account-security/mfa/toggle', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        credentials: 'same-origin',
                        body: JSON.stringify({ enabled: isEnabled })
                    });
                    
                    if (!response.ok) {
                        // Attempt to extract error details if available
                        let errorDetail = `HTTP ${response.status}`;
                        try {
                            const result = await response.json();
                            if (result?.error) {
                                errorDetail = result.error;
                            }
                        } catch {
                            // ignore JSON parse error, keep default detail
                        }
                        throw new Error(errorDetail);
                    }

                    const result = await response.json();
                    
                    if (result.success) {
                        // Show success message
                        const message = isEnabled 
                            ? 'Two-factor authentication has been enabled'
                            : 'Two-factor authentication has been disabled';
                        
                        // Create a temporary success message
                        const alertDiv = document.createElement('div');
                        alertDiv.className = 'alert alert-success alert-dismissible fade show';
                        alertDiv.style.cssText = 'margin: 1rem 0; border-radius: 8px;';
                        alertDiv.innerHTML = `
                            <i class="fas fa-check-circle me-2"></i>
                            <span>${message}</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        `;
                        
                        const securityContent = document.getElementById('security-content');
                        if (securityContent) {
                            securityContent.insertBefore(alertDiv, securityContent.firstChild);
                            
                            // Auto-dismiss after 3 seconds
                            setTimeout(() => {
                                alertDiv.remove();
                            }, 3000);
                        }
                    } else {
                        throw new Error(result.error || 'Unknown error');
                    }
                } catch (error) {
                    // Rollback checkbox state on error
                    this.checked = originalState;
                    console.error('Error toggling MFA:', error);
                    const message = error instanceof Error ? error.message : 'Unknown error';
                    alert('Failed to update MFA setting: ' + message);
                } finally {
                    this.disabled = false;
                }
            });
        }
        
        function initializeSaveButton() {
            const saveBtn = document.getElementById('saveAccountSettingsBtn');
            
            saveBtn.addEventListener('click', async function() {
                const orgId = @ViewBag.OrganizationId;
                
                // Gather all form data
                const formData = {
                    firstName: document.getElementById('firstName').value,
                    lastName: document.getElementById('lastName').value,
                    email: document.getElementById('email').value,
                    phoneNumber: document.getElementById('phone').value,
                    timeZone: document.getElementById('timezone').value,
                    language: document.getElementById('language').value
                };
                
                // Disable button and show loading
                saveBtn.disabled = true;
                saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Saving...';
                
                try {
                    const response = await fetch(`/Client/${orgId}/AccountSettings/Save`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(formData)
                    });
                    
                    const result = await response.json();
                    
                    if (result.success && result.requiresVerification) {
                        // Redirect to verification page
                        window.location.href = result.redirectUrl;
                    } else if (result.success) {
                        // Direct save without verification (shouldn't happen with current logic)
                        updateOriginalValues();
                        showSuccessMessage();
                    } else {
                        alert('Failed to save: ' + (result.error || 'Unknown error'));
                        saveBtn.innerHTML = '<i class="fas fa-check me-2"></i>Save Changes';
                    }
                } catch (error) {
                    console.error('Error saving settings:', error);
                    alert('Failed to save settings. Please try again.');
                    saveBtn.innerHTML = '<i class="fas fa-check me-2"></i>Save Changes';
                } finally {
                    saveBtn.disabled = false;
                }
            });
        }
        
    </script>
}


