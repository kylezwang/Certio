@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Tab switching functionality
            const navItems = document.querySelectorAll('.settings-nav-item');
            const tabContents = document.querySelectorAll('.settings-tab-content');

            function switchToTab(tabId) {
                // Remove active class from all nav items and tab contents
                navItems.forEach(nav => nav.classList.remove('active'));
                tabContents.forEach(content => content.classList.remove('active'));
                
                // Find and activate the corresponding nav item and content
                const navItem = document.querySelector(`.settings-nav-item[data-tab="${tabId}"]`);
                const targetContent = document.getElementById(tabId + '-content');
                
                if (navItem) navItem.classList.add('active');
                if (targetContent) targetContent.classList.add('active');
            }

            navItems.forEach(item => {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    const tabId = this.getAttribute('data-tab');
                    switchToTab(tabId);
                    // Update URL hash
                    window.location.hash = tabId;
                });
            });

            // Handle initial hash or hash changes
            function handleHashChange() {
                const hash = window.location.hash.substring(1); // Remove the '#'
                if (hash && document.getElementById(hash + '-content')) {
                    switchToTab(hash);
                }
            }

            // Check hash on load
            handleHashChange();

            // Listen for hash changes
            window.addEventListener('hashchange', handleHashChange);

            // Settings Search Functionality
            const searchInput = document.getElementById('settingsSearch');
            const clearSearchBtn = document.getElementById('clearSearch');
            const settingsSections = document.querySelectorAll('.settings-section');
            const settingsRows = document.querySelectorAll('.settings-row');
            
            function performSearch(searchTerm) {
                const term = searchTerm.toLowerCase().trim();
                
                if (!term) {
                    // Show all sections and rows
                    settingsSections.forEach(section => {
                        section.style.display = 'block';
                    });
                    settingsRows.forEach(row => {
                        row.style.display = 'flex';
                    });
                    clearSearchBtn.style.display = 'none';
                    return;
                }
                
                clearSearchBtn.style.display = 'block';
                let hasResults = false;
                
                // Search through all settings sections
                settingsSections.forEach(section => {
                    const sectionHeader = section.querySelector('.settings-section-header');
                    const sectionTitle = sectionHeader ? sectionHeader.textContent.toLowerCase() : '';
                    let sectionHasMatch = sectionTitle.includes(term);
                    let visibleRowsInSection = 0;
                    
                    // Check rows within section
                    const rowsInSection = section.querySelectorAll('.settings-row');
                    rowsInSection.forEach(row => {
                        const label = row.querySelector('.settings-row-label');
                        const description = row.querySelector('.settings-row-description');
                        const labelText = label ? label.textContent.toLowerCase() : '';
                        const descText = description ? description.textContent.toLowerCase() : '';
                        
                        if (labelText.includes(term) || descText.includes(term) || sectionHasMatch) {
                            row.style.display = 'flex';
                            visibleRowsInSection++;
                            hasResults = true;
                        } else {
                            row.style.display = 'none';
                        }
                    });
                    
                    // Show section if it has matches or visible rows
                    if (sectionHasMatch || visibleRowsInSection > 0) {
                        section.style.display = 'block';
                    } else {
                        section.style.display = 'none';
                    }
                });
                
                // Show no results message if needed
                if (!hasResults) {
                    console.log('No settings found matching: ' + term);
                }
            }
            
            if (searchInput) {
                searchInput.addEventListener('input', function(e) {
                    performSearch(e.target.value);
                });
                
                searchInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') {
                        searchInput.value = '';
                        performSearch('');
                    }
                });
            }
            
            if (clearSearchBtn) {
                clearSearchBtn.addEventListener('click', function() {
                    searchInput.value = '';
                    performSearch('');
                    searchInput.focus();
                });
            }

            // Integration buttons - Load connection status
            loadIntegrationStatus();
            setupIntegrationListeners();

            // Listen for OAuth callback messages
            window.addEventListener('message', handleOAuthMessage);

            // Join Code Template functionality
            const joinCodeTemplate = document.getElementById('joinCodeTemplate');
            const saveJoinCodeTemplate = document.getElementById('saveJoinCodeTemplate');
            const resetJoinCodeTemplate = document.getElementById('resetJoinCodeTemplate');
            const joinCodeTemplateStatus = document.getElementById('joinCodeTemplateStatus');
            
            // Get organization ID from page
            const orgIdElement = document.querySelector('[data-organization-id]');
            const orgId = orgIdElement ? parseInt(orgIdElement.getAttribute('data-organization-id')) : null;
            
            // Matter Terminology Functionality
            const matterSingularInput = document.getElementById('matterSingular');
            const matterPluralInput = document.getElementById('matterPlural');
            const saveMatterTerminologyBtn = document.getElementById('saveMatterTerminology');
            const resetMatterTerminologyBtn = document.getElementById('resetMatterTerminology');

            // Load current terminology
            if (orgId && matterSingularInput && matterPluralInput) {
                fetch(`/Client/${orgId}/Settings/GetMatterTerminology`)
                    .then(response => response.json())
                    .then(result => {
                        if (result.success && result.data) {
                            matterSingularInput.value = result.data.singular;
                            matterPluralInput.value = result.data.plural;
                        }
                    })
                    .catch(error => console.error('Error loading matter terminology:', error));
            }

            // Save terminology
            if (saveMatterTerminologyBtn && orgId) {
                saveMatterTerminologyBtn.addEventListener('click', async function() {
                    const singular = matterSingularInput.value.trim();
                    const plural = matterPluralInput.value.trim();

                    if (!singular || !plural) {
                        alert('Please enter both singular and plural terms');
                        return;
                    }

                    try {
                        const response = await fetch(`/Client/${orgId}/Settings/UpdateMatterTerminology`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ singular, plural })
                        });

                        const result = await response.json();
                        if (result.success) {
                            const successMsg = document.createElement('div');
                            successMsg.className = 'alert alert-success alert-dismissible fade show mt-2';
                            successMsg.style.position = 'fixed';
                            successMsg.style.top = '20px';
                            successMsg.style.right = '20px';
                            successMsg.style.zIndex = '9999';
                            successMsg.innerHTML = '<i class="fas fa-check-circle me-2" style="font-weight:500;"></i>Matter terminology updated! Please refresh the page to see changes.<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
                            document.body.appendChild(successMsg);
                            setTimeout(() => {
                                successMsg.remove();
                                window.location.reload();
                            }, 2000);
                        } else {
                            alert(result.error || 'Failed to update matter terminology');
                        }
                    } catch (error) {
                        console.error('Error saving matter terminology:', error);
                        alert('Failed to update matter terminology. Please try again.');
                    }
                });
            }

            // Reset terminology
            if (resetMatterTerminologyBtn && orgId) {
                resetMatterTerminologyBtn.addEventListener('click', async function() {
                    if (!confirm('Are you sure you want to reset to the default terminology?')) {
                        return;
                    }

                    // Reset to default based on org type (Matter/Matters)
                    matterSingularInput.value = 'Matter';
                    matterPluralInput.value = 'Matters';
                });
            }
            
            // AI Model Tier functionality
            const aiModelTierSelect = document.getElementById('aiModelTier');
            if (aiModelTierSelect && orgId) {
                const originalTier = aiModelTierSelect.getAttribute('data-original');
                
                aiModelTierSelect.addEventListener('change', async function() {
                    const selectedTier = this.value;
                    
                    // Only save if changed
                    if (selectedTier === originalTier) return;
                    
                    try {
                        const response = await fetch(`/Client/${orgId}/Settings/UpdateAIModelTier`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ tier: selectedTier })
                        });
                        
                        const result = await response.json();
                        if (result.success) {
                            // Update original value
                            aiModelTierSelect.setAttribute('data-original', selectedTier);
                            // Show success message briefly
                            const successMsg = document.createElement('div');
                            successMsg.className = 'alert alert-success alert-dismissible fade show mt-2';
                            successMsg.style.position = 'fixed';
                            successMsg.style.top = '20px';
                            successMsg.style.right = '20px';
                            successMsg.style.zIndex = '9999';
                            successMsg.innerHTML = '<i class="fas fa-check-circle me-2"></i>AI model tier updated successfully<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
                            document.body.appendChild(successMsg);
                            setTimeout(() => successMsg.remove(), 3000);
                        } else {
                            // Revert selection on error
                            this.value = originalTier;
                            alert(result.error || 'Failed to update AI model tier');
                        }
                    } catch (error) {
                        console.error('Error saving AI model tier:', error);
                        // Revert selection on error
                        this.value = originalTier;
                        alert('Failed to update AI model tier. Please try again.');
                    }
                });
            }
            
            // AI Usage Chart functionality
            let aiUsageChart = null;
            
            async function loadAIUsageData() {
                const loadingEl = document.getElementById('aiUsageLoading');
                const emptyEl = document.getElementById('aiUsageEmpty');
                const chartCanvas = document.getElementById('aiUsageChart');
                
                if (!orgId || !chartCanvas) return;
                
                try {
                    const response = await fetch(`/Client/${orgId}/Settings/AIUsage?days=30`);
                    const result = await response.json();
                    
                    if (loadingEl) loadingEl.style.display = 'none';
                    
                    if (result.success && result.data) {
                        const data = result.data;
                        
                        // Update summary stats
                        const totalCostEl = document.getElementById('totalCostValue');
                        const totalCallsEl = document.getElementById('totalCallsValue');
                        const totalTokensEl = document.getElementById('totalTokensValue');
                        
                        if (totalCostEl) totalCostEl.textContent = `$${data.totalCost.toFixed(2)}`;
                        if (totalCallsEl) totalCallsEl.textContent = data.totalCalls.toLocaleString();
                        if (totalTokensEl) totalTokensEl.textContent = data.totalTokens.toLocaleString();
                        
                        // Check if there's any data
                        if (data.totalCalls === 0) {
                            if (emptyEl) emptyEl.style.display = 'block';
                            return;
                        }
                        
                        // Prepare chart data
                        const labels = data.dataPoints.map(dp => {
                            const date = new Date(dp.date);
                            return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                        });
                        const costs = data.dataPoints.map(dp => dp.cost);
                        
                        // Create or update chart
                        const ctx = chartCanvas.getContext('2d');
                        
                        if (aiUsageChart) {
                            aiUsageChart.destroy();
                        }
                        
                        aiUsageChart = new Chart(ctx, {
                            type: 'line',
                            data: {
                                labels: labels,
                                datasets: [{
                                    label: 'Cost ($)',
                                    data: costs,
                                    borderColor: '#6366f1',
                                    backgroundColor: 'rgba(99, 102, 241, 0.1)',
                                    borderWidth: 2,
                                    fill: true,
                                    tension: 0.4,
                                    pointRadius: 2,
                                    pointHoverRadius: 6,
                                    pointBackgroundColor: '#6366f1',
                                    pointBorderColor: '#fff',
                                    pointBorderWidth: 2
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                interaction: {
                                    intersect: false,
                                    mode: 'index'
                                },
                                plugins: {
                                    legend: {
                                        display: false
                                    },
                                    tooltip: {
                                        backgroundColor: 'rgba(15, 23, 42, 0.9)',
                                        padding: 12,
                                        titleFont: { size: 13, weight: '600' },
                                        bodyFont: { size: 12 },
                                        callbacks: {
                                            label: function(context) {
                                                return `Cost: $${context.parsed.y.toFixed(4)}`;
                                            }
                                        }
                                    }
                                },
                                scales: {
                                    x: {
                                        grid: {
                                            display: false
                                        },
                                        ticks: {
                                            maxTicksLimit: 8,
                                            font: { size: 11 },
                                            color: '#64748b'
                                        }
                                    },
                                    y: {
                                        beginAtZero: true,
                                        grid: {
                                            color: 'rgba(148, 163, 184, 0.1)'
                                        },
                                        ticks: {
                                            font: { size: 11 },
                                            color: '#64748b',
                                            callback: function(value) {
                                                return '$' + value.toFixed(2);
                                            }
                                        }
                                    }
                                }
                            }
                        });
                        
                        // Update model breakdown
                        const modelBreakdownEl = document.getElementById('modelBreakdown');
                        const modelBreakdownContent = document.getElementById('modelBreakdownContent');
                        
                        if (data.costByModel && Object.keys(data.costByModel).length > 0 && modelBreakdownEl && modelBreakdownContent) {
                            modelBreakdownEl.style.display = 'block';
                            
                            const modelColors = {
                                'gpt-4o-mini': '#22c55e',
                                'gpt-4o': '#6366f1',
                                'gpt-5': '#f59e0b'
                            };
                            
                            modelBreakdownContent.innerHTML = Object.entries(data.costByModel)
                                .map(([model, cost]) => `
                                    <div style="display: flex; align-items: center; gap: 0.5rem; background: #f8fafc; padding: 0.5rem 0.75rem; border-radius: 8px;">
                                        <div style="width: 8px; height: 8px; border-radius: 50%; background: ${modelColors[model] || '#94a3b8'};"></div>
                                        <span style="font-size: 0.875rem; color: #475569;">${model}</span>
                                        <span style="font-size: 0.875rem; font-weight: 500; color: #0f172a;">$${cost.toFixed(4)}</span>
                                    </div>
                                `).join('');
                        }
                    } else {
                        if (emptyEl) emptyEl.style.display = 'block';
                    }
                } catch (error) {
                    console.error('Error loading AI usage data:', error);
                    if (loadingEl) loadingEl.style.display = 'none';
                    if (emptyEl) {
                        emptyEl.innerHTML = '<i class="fas fa-exclamation-circle" style="font-size: 2rem; margin-bottom: 0.5rem; display: block;"></i>Error loading usage data';
                        emptyEl.style.display = 'block';
                    }
                }
            }
            
            // Load AI usage data
            if (orgId) {
                loadAIUsageData();
            }
            
            if (joinCodeTemplate && saveJoinCodeTemplate && orgId) {
                // Load template on page load
                loadJoinCodeTemplate();
                
                // Save template
                saveJoinCodeTemplate.addEventListener('click', async function() {
                    const template = joinCodeTemplate.value.trim();
                    if (!template) {
                        showTemplateStatus('Template cannot be empty', 'error');
                        return;
                    }
                    
                    try {
                        const response = await fetch(`/api/dm/settings/join-code-template?orgId=${orgId}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ template: template })
                        });
                        
                        const result = await response.json();
                        if (result.success) {
                            showTemplateStatus('Template saved successfully', 'success');
                        } else {
                            showTemplateStatus(result.error || 'Failed to save template', 'error');
                        }
                    } catch (error) {
                        console.error('Error saving template:', error);
                        showTemplateStatus('Failed to save template. Please try again.', 'error');
                    }
                });
                
                // Reset to default
                resetJoinCodeTemplate.addEventListener('click', function() {
                    const defaultTemplate = `Hello (Client Name), 

Here's the join code you need to use when creating your Notal account: 

{join code}

Thanks,

(Current user's first and last name)`;
                    joinCodeTemplate.value = defaultTemplate;
                    showTemplateStatus('Template reset to default. Click Save to apply.', 'info');
                });
            }
            
            async function loadJoinCodeTemplate() {
                if (!orgId) return;
                
                try {
                    const response = await fetch(`/api/dm/settings/join-code-template?orgId=${orgId}`);
                    const result = await response.json();
                    if (result.success && result.template) {
                        joinCodeTemplate.value = result.template;
                    }
                } catch (error) {
                    console.error('Error loading template:', error);
                }
            }
            
            function showTemplateStatus(message, type) {
                if (!joinCodeTemplateStatus) return;
                
                joinCodeTemplateStatus.style.display = 'block';
                joinCodeTemplateStatus.className = `mt-2 alert alert-${type === 'success' ? 'success' : type === 'error' ? 'danger' : 'info'}`;
                joinCodeTemplateStatus.textContent = message;
                
                if (type === 'success') {
                    setTimeout(() => {
                        joinCodeTemplateStatus.style.display = 'none';
                    }, 3000);
                }
            }

            // Integration functionality
            let emailAccountStatus = null; // Store email account status for disconnect

            function getCurrentOrganizationId() {
                const orgIdElement = document.querySelector('[data-organization-id]');
                return orgIdElement ? parseInt(orgIdElement.getAttribute('data-organization-id')) : null;
            }

            async function loadIntegrationStatus() {
                const orgId = getCurrentOrganizationId();
                if (!orgId) return;

                try {
                    // Load document integration status (Drive/OneDrive)
                    const docResponse = await fetch(`/api/drive-oauth/status?orgId=${orgId}`);
                    if (docResponse.ok) {
                        const docStatus = await docResponse.json();
                        if (docStatus.success) {
                            updateDocumentIntegrationUI(docStatus);
                        }
                    }

                    // Load email integration status (Gmail/Outlook)
                    const emailResponse = await fetch(`/api/email-oauth/status`);
                    if (emailResponse.ok) {
                        const emailStatus = await emailResponse.json();
                        if (emailStatus.success) {
                            emailAccountStatus = emailStatus.connected ? emailStatus.emailAccount : null;
                            updateEmailIntegrationUI(emailStatus);
                        }
                    }
                } catch (error) {
                    console.error('Error loading integration status:', error);
                }
            }

            function updateDocumentIntegrationUI(status) {
                // Google Drive
                const googleConnected = status.googleDrive?.connected || false;
                const googleEmail = status.googleDrive?.email || '';
                
                document.getElementById('connectGoogleDriveSettingsBtn').style.display = googleConnected ? 'none' : 'flex';
                document.getElementById('disconnectGoogleDriveSettingsBtn').style.display = googleConnected ? 'block' : 'none';
                document.getElementById('googleDriveEmail').textContent = googleConnected && googleEmail ? googleEmail : '';

                // OneDrive
                const onedriveConnected = status.oneDrive?.connected || false;
                const onedriveEmail = status.oneDrive?.email || '';
                
                document.getElementById('connectOneDriveSettingsBtn').style.display = onedriveConnected ? 'none' : 'flex';
                document.getElementById('disconnectOneDriveSettingsBtn').style.display = onedriveConnected ? 'block' : 'none';
                document.getElementById('oneDriveEmail').textContent = onedriveConnected && onedriveEmail ? onedriveEmail : '';
            }

            function updateEmailIntegrationUI(status) {
                // Check if email account is connected
                const emailConnected = status.connected || false;
                const emailAccount = status.emailAccount;
                
                if (emailConnected && emailAccount) {
                    const provider = emailAccount.provider || '';
                    const emailAddress = emailAccount.emailAddress || '';
                    
                    // Update Gmail UI
                    if (provider === 'Gmail') {
                        document.getElementById('connectGmailSettingsBtn').style.display = 'none';
                        document.getElementById('disconnectGmailSettingsBtn').style.display = 'block';
                        document.getElementById('gmailEmail').textContent = emailAddress;
                    } else {
                        // Gmail not connected
                        document.getElementById('connectGmailSettingsBtn').style.display = 'flex';
                        document.getElementById('disconnectGmailSettingsBtn').style.display = 'none';
                        document.getElementById('gmailEmail').textContent = '';
                    }
                    
                    // Update Outlook UI
                    if (provider === 'Outlook') {
                        document.getElementById('connectOutlookSettingsBtn').style.display = 'none';
                        document.getElementById('disconnectOutlookSettingsBtn').style.display = 'block';
                        document.getElementById('outlookEmail').textContent = emailAddress;
                    } else {
                        // Outlook not connected
                        document.getElementById('connectOutlookSettingsBtn').style.display = 'flex';
                        document.getElementById('disconnectOutlookSettingsBtn').style.display = 'none';
                        document.getElementById('outlookEmail').textContent = '';
                    }
                } else {
                    // No email account connected - show connect buttons for both
                    document.getElementById('connectGmailSettingsBtn').style.display = 'flex';
                    document.getElementById('disconnectGmailSettingsBtn').style.display = 'none';
                    document.getElementById('gmailEmail').textContent = '';
                    
                    document.getElementById('connectOutlookSettingsBtn').style.display = 'flex';
                    document.getElementById('disconnectOutlookSettingsBtn').style.display = 'none';
                    document.getElementById('outlookEmail').textContent = '';
                }
            }

            function setupIntegrationListeners() {
                // Google Drive
                document.getElementById('connectGoogleDriveSettingsBtn')?.addEventListener('click', () => connectProvider('google', 'document'));
                document.getElementById('disconnectGoogleDriveSettingsBtn')?.addEventListener('click', () => disconnectProvider('google', 'document'));

                // OneDrive
                document.getElementById('connectOneDriveSettingsBtn')?.addEventListener('click', () => connectProvider('onedrive', 'document'));
                document.getElementById('disconnectOneDriveSettingsBtn')?.addEventListener('click', () => disconnectProvider('onedrive', 'document'));

                // Gmail
                document.getElementById('connectGmailSettingsBtn')?.addEventListener('click', () => connectProvider('gmail', 'email'));
                document.getElementById('disconnectGmailSettingsBtn')?.addEventListener('click', () => disconnectProvider('gmail', 'email'));

                // Outlook
                document.getElementById('connectOutlookSettingsBtn')?.addEventListener('click', () => connectProvider('outlook', 'email'));
                document.getElementById('disconnectOutlookSettingsBtn')?.addEventListener('click', () => disconnectProvider('outlook', 'email'));
            }

            async function connectProvider(provider, type) {
                const orgId = getCurrentOrganizationId();
                if (!orgId) {
                    alert('Organization ID not found');
                    return;
                }

                try {
                    let authorizeUrl;
                    if (type === 'document') {
                        authorizeUrl = `/api/drive-oauth/${provider === 'google' ? 'google' : 'onedrive'}/authorize?orgId=${orgId}`;
                    } else if (type === 'email') {
                        authorizeUrl = `/api/email-oauth/${provider}/authorize?orgId=${orgId}`;
                    }

                    const response = await fetch(authorizeUrl);
                    const result = await response.json();

                    if (result.success && result.authorizationUrl) {
                        const width = 600;
                        const height = 700;
                        const left = (screen.width / 2) - (width / 2);
                        const top = (screen.height / 2) - (height / 2);
                        
                        window.open(
                            result.authorizationUrl,
                            'oauth_window',
                            `width=${width},height=${height},left=${left},top=${top},toolbar=no,menubar=no,scrollbars=yes,resizable=yes`
                        );
                    } else {
                        alert(result.message || 'Failed to get authorization URL');
                    }
                } catch (error) {
                    console.error('Error connecting provider:', error);
                    alert('Failed to connect. Please try again.');
                }
            }

            async function disconnectProvider(provider, type) {
                if (!confirm(`Are you sure you want to disconnect ${provider}?`)) {
                    return;
                }

                const orgId = getCurrentOrganizationId();
                if (!orgId) return;

                try {
                    let disconnectUrl;
                    if (type === 'document') {
                        disconnectUrl = `/api/documents/disconnect?provider=${provider}&orgId=${orgId}`;
                    } else if (type === 'email') {
                        // For email, we need the accountId from emailAccountStatus
                        if (!emailAccountStatus || !emailAccountStatus.id) {
                            alert('Email account not found. Please refresh the page.');
                            return;
                        }
                        disconnectUrl = `/api/email-oauth/${emailAccountStatus.id}`;
                    }

                    const response = await fetch(disconnectUrl, { 
                        method: type === 'email' ? 'DELETE' : 'POST' 
                    });
                    const result = await response.json();

                    if (result.success) {
                        if (type === 'email') {
                            emailAccountStatus = null; // Clear stored status
                        }
                        loadIntegrationStatus();
                    } else {
                        alert(result.message || 'Failed to disconnect');
                    }
                } catch (error) {
                    console.error('Error disconnecting provider:', error);
                    alert('Failed to disconnect. Please try again.');
                }
            }

            function handleOAuthMessage(event) {
                if (event.data.type === 'document-oauth-success' || event.data.type === 'email-oauth-success') {
                    console.log(`OAuth success: ${event.data.provider}`);
                    loadIntegrationStatus();
                }
            }
        });
    </script>
}
