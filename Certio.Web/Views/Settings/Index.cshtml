@{
    ViewData["Title"] = "Firm Settings";
    ViewData["BodyClass"] = "settings-page";
    Layout = "_ClientLayout";
    var isLawFirm = ViewBag.OrganizationType != null && ViewBag.OrganizationType.ToString() == "LawFirm";
    var organizationId = ViewBag.OrganizationId ?? ViewContext.HttpContext.Items["CurrentOrganizationId"];
}

<!-- Organization ID for JavaScript access -->
<div class="d-none" data-organization-id="@organizationId"></div>

<div class="settings-container">
    <!-- Header -->
    <div class="settings-header">
        <div>
            <h1 class="settings-title">Firm Settings</h1>
            <p class="settings-subtitle">
                Manage your organization and application preferences
            </p>
        </div>
    </div>

    <div class="settings-layout">
        <!-- Navigation Sidebar -->
        <div class="settings-sidebar">
            <nav class="settings-nav">
                <a href="#organization" class="settings-nav-item active" data-tab="organization">
                    @if (isLawFirm)
                    {
                        <i class="fa-solid fa-building-columns"></i>
                        <span>My Firm</span>
                    }
                    else
                    {
                        <i class="fas fa-building"></i>
                        <span>Organization</span>
                    }
                </a>
                <a href="#security" class="settings-nav-item" data-tab="security">
                    <i class="fas fa-shield-halved"></i>
                    <span>Security</span>
                </a>
                <a href="#matters" class="settings-nav-item" data-tab="matters">
                    <i class="fas fa-folder"></i>
                    <span>Matters & Services</span>
                </a>
                <a href="#documents" class="settings-nav-item" data-tab="documents">
                    <i class="fas fa-file-alt"></i>
                    <span>Documents</span>
                </a>
                <a href="#integrations" class="settings-nav-item" data-tab="integrations">
                    <i class="fas fa-link"></i>
                    <span>Integrations</span>
                </a>
                <a href="#privacy" class="settings-nav-item" data-tab="privacy">
                    <i class="fas fa-eye"></i>
                    <span>Privacy & Compliance</span>
                </a>
                <a href="#billing" class="settings-nav-item" data-tab="billing">
                    <i class="fas fa-credit-card"></i>
                    <span>Billing & Plan</span>
                </a>
                <a href="#ai" class="settings-nav-item" data-tab="ai">
                    <i class="fas fa-brain"></i>
                    <span>AI Settings</span>
                </a>
            </nav>
        </div>

        <!-- Content Area -->
        <div class="settings-content">
            <div class="settings-content-inner">
                <!-- Organization Settings -->
                <div id="organization-content" class="settings-tab-content active">
                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Organization Profile</h3>
                            <p>Manage your organization information</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="orgName" class="form-label">Organization Name</label>
                                    <input type="text" class="form-control" id="orgName" value="Acme Legal Group">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="subdomain" class="form-label">Subdomain</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="subdomain" value="acme-legal">
                                        <span class="input-group-text">.legaltech.com</span>
                                    </div>
                                </div>
                            </div>
                            <hr class="settings-divider">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Organization Logo</label>
                                    <p class="settings-row-description">Upload your company logo</p>
                                </div>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="org-logo-placeholder">
                                        <i class="fas fa-building"></i>
                                    </div>
                                    <button class="btn btn-outline-secondary btn-sm">Upload Logo</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Security Settings -->
                <div id="security-content" class="settings-tab-content">
                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Team Management</h3>
                            <p>Control who can invite and access your organization</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Who can invite team members</label>
                                </div>
                                <select class="form-select" style="width: 200px;">
                                    <option value="legal-only" selected>Legal team only</option>
                                    <option value="client-legal">Client & legal teams</option>
                                    <option value="everyone">Everyone</option>
                                </select>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">External sharing defaults</label>
                                </div>
                                <select class="form-select" style="width: 200px;">
                                    <option value="client-only" selected>Client only</option>
                                    <option value="participants">All participants</option>
                                    <option value="restricted">Restricted</option>
                                </select>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Counterparty label</label>
                                    <p class="settings-row-description">How to refer to external parties</p>
                                </div>
                                <input type="text" class="form-control" value="Other Party" style="width: 200px;">
                            </div>
                        </div>
                    </div>


                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Two-Factor Authentication</h3>
                            <p>Add an extra layer of security to your account</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Two-Factor Authentication</label>
                                    <p class="settings-row-description">Secure your account with 2FA</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="twoFactorEnabled">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Authentication Methods</h3>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Authenticator App</label>
                                    <p class="settings-row-description">Use TOTP apps like Google Authenticator</p>
                                </div>
                                <button class="btn btn-outline-secondary btn-sm">Setup</button>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">SMS Fallback</label>
                                    <p class="settings-row-description">Receive codes via text message</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="smsEnabled">
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">WebAuthn/Passkeys</label>
                                    <p class="settings-row-description">Use biometric or hardware keys</p>
                                </div>
                                <button class="btn btn-outline-secondary btn-sm">Add</button>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Backup Codes</label>
                                    <p class="settings-row-description">Download emergency access codes</p>
                                </div>
                                <button class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-download me-2"></i>
                                    Download
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Sessions & Devices</h3>
                            <p>Manage your active login sessions</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="session-list">
                                <div class="session-item">
                                    <div class="session-info">
                                        <div class="session-icon">
                                            <i class="fas fa-laptop"></i>
                                        </div>
                                        <div class="session-details">
                                            <h6 class="session-device">MacBook Pro</h6>
                                            <p class="session-location">New York, US</p>
                                        </div>
                                        <span class="badge bg-primary">Current</span>
                                    </div>
                                </div>
                                <div class="session-item">
                                    <div class="session-info">
                                        <div class="session-icon">
                                            <i class="fas fa-mobile-alt"></i>
                                        </div>
                                        <div class="session-details">
                                            <h6 class="session-device">iPhone 15</h6>
                                            <p class="session-location">New York, US</p>
                                        </div>
                                        <button class="btn btn-outline-secondary btn-sm">Revoke</button>
                                    </div>
                                </div>
                                <div class="session-item">
                                    <div class="session-info">
                                        <div class="session-icon">
                                            <i class="fas fa-desktop"></i>
                                        </div>
                                        <div class="session-details">
                                            <h6 class="session-device">Chrome Browser</h6>
                                            <p class="session-location">Chicago, IL</p>
                                        </div>
                                        <button class="btn btn-outline-secondary btn-sm">Revoke</button>
                                    </div>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Sign Out All Devices</label>
                                    <p class="settings-row-description">End all active sessions except current</p>
                                </div>
                                <button class="btn btn-outline-danger btn-sm">Sign Out All</button>
                            </div>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Security Preferences</h3>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Login Alerts</label>
                                    <p class="settings-row-description">Get notified of new device logins</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="loginAlerts" checked>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Require Re-authentication</label>
                                    <p class="settings-row-description">For sensitive actions like changing password</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="reauthRequired" checked>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Matters Settings -->
                <div id="matters-content" class="settings-tab-content">
                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Default Templates</h3>
                            <p>Set up templates for different practice areas</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Real Estate template</label>
                                </div>
                                <button class="btn btn-outline-secondary btn-sm">Configure</button>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Corporate template</label>
                                </div>
                                <button class="btn btn-outline-secondary btn-sm">Configure</button>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Litigation template</label>
                                </div>
                                <button class="btn btn-outline-secondary btn-sm">Configure</button>
                            </div>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Required Metadata</h3>
                            <p>Define mandatory fields for new matters</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Matter number required</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="matterNumberRequired" checked>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Client reference required</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="clientReferenceRequired" checked>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Jurisdiction required</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="jurisdictionRequired">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>SLA & Reminder Defaults</h3>
                            <p>Set default reminder schedules</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">7-day reminder</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="reminder7day" checked>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">3-day reminder</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="reminder3day" checked>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">1-day reminder</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="reminder1day" checked>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Documents Settings -->
                <div id="documents-content" class="settings-tab-content">
                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Document Versioning</h3>
                            <p>Control how document versions are handled</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Enable versioning</label>
                                    <p class="settings-row-description">Track changes and maintain version history</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="versioningEnabled" checked>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Redline defaults</label>
                                    <p class="settings-row-description">Show tracked changes by default</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="redlineDefaults">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Download & Sharing Permissions</h3>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Default download permission</label>
                                </div>
                                <select class="form-select" style="width: 200px;">
                                    <option value="view-only">View only</option>
                                    <option value="watermark" selected>Watermark downloads</option>
                                    <option value="allow">Allow downloads</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Retention & Legal Hold</h3>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Default retention period</label>
                                </div>
                                <select class="form-select" style="width: 200px;">
                                    <option value="3-years">3 years</option>
                                    <option value="5-years">5 years</option>
                                    <option value="7-years" selected>7 years</option>
                                    <option value="permanent">Permanent</option>
                                </select>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Legal hold toggle</label>
                                    <p class="settings-row-description">Enable legal hold for litigation</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="legalHoldToggle">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>File Naming Convention</h3>
                        </div>
                        <div class="settings-section-content">
                            <div class="mb-3">
                                <label for="namingTemplate" class="form-label">Naming template</label>
                                <input type="text" class="form-control" id="namingTemplate" value="{client}-{matter}-{date}" placeholder="Use tokens like {client}, {matter}, {date}">
                            </div>
                            <p class="text-muted small">
                                Available tokens: <code>{client}</code>, <code>{matter}</code>, <code>{date}</code>, <code>{type}</code>, <code>{version}</code>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Integrations Settings -->
                <div id="integrations-content" class="settings-tab-content">
                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Calendar Integration</h3>
                            <p>Connect your calendar applications</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Google Calendar</label>
                                </div>
                                <span class="badge bg-secondary">Coming Soon</span>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Microsoft Outlook</label>
                                </div>
                                <span class="badge bg-secondary">Coming Soon</span>
                            </div>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Cloud Storage</h3>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Google Drive</label>
                                </div>
                                <span class="badge bg-secondary">Coming Soon</span>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Microsoft OneDrive</label>
                                </div>
                                <span class="badge bg-secondary">Coming Soon</span>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Box</label>
                                </div>
                                <span class="badge bg-secondary">Coming Soon</span>
                            </div>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>E-Signature</h3>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">DocuSign</label>
                                </div>
                                <span class="badge bg-secondary">Coming Soon</span>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Adobe Sign</label>
                                </div>
                                <span class="badge bg-secondary">Coming Soon</span>
                            </div>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Email Integration</h3>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Gmail</label>
                                </div>
                                <span class="badge bg-secondary">Coming Soon</span>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Outlook</label>
                                </div>
                                <span class="badge bg-secondary">Coming Soon</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Privacy Settings -->
                <div id="privacy-content" class="settings-tab-content">
                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Data Export</h3>
                            <p>Download your data</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Export my data</label>
                                    <p class="settings-row-description">Download all personal data</p>
                                </div>
                                <button class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-download me-2"></i>
                                    Export
                                </button>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Export matter data</label>
                                    <p class="settings-row-description">Download specific matter information</p>
                                </div>
                                <button class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-download me-2"></i>
                                    Export
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Audit Log</h3>
                            <p>View system activity and changes</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">View Audit Log</label>
                                    <p class="settings-row-description">Review system activity and changes</p>
                                </div>
                                <button class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-eye me-2"></i>
                                    View Log
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>PII/DLP Guardrails</h3>
                            <p>Protect sensitive information</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Mask SSN/EIN in UI</label>
                                    <p class="settings-row-description">Hide sensitive ID numbers</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="maskSSNUI" checked>
                                </div>
                            </div>
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Mask SSN/EIN in exports</label>
                                    <p class="settings-row-description">Redact from downloaded files</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="maskSSNExport" checked>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="settings-section-header">
                            <h3>Legal Hold</h3>
                            <p>Litigation hold management</p>
                        </div>
                        <div class="settings-section-content">
                            <div class="settings-row">
                                <div class="settings-row-content">
                                    <label class="settings-row-label">Enable legal hold per matter</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="legalHoldPerMatter">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Billing Settings -->
